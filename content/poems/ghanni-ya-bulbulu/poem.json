{
  "id": "ghanni-ya-bulbulu",
  "poet": "badawi-al-jabal",
  "title": "دُموعٌ وَدُموعٌ",
  "meter": "ramal",
  "themes": ["ghazal", "shakwa"],
  "abyat_in_full": 35,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1, "sadr": "غَنِّ يا بُلبُلُ فَوقَ الدَّوحِ غَنِّ", "ajuz": "أَنتَ أَولى بِالهَوى وَالشِّعرِ مِنّي" },
    { "n": 2, "sadr": "لَكَ سِحرٌ مِثلَ سِحري عَجَبٌ", "ajuz": "أَتَرى عِندَكَ حُزناً مِثلَ حُزني" },
    { "n": 3, "sadr": "فَتَرَنَّم بِأَناشيدِ الهَوى", "ajuz": "ناعِماً ما شِئتَ مِن غُصنٍ لِغُصنِ" },
    { "n": 4, "sadr": "وَتَعَلَّم كَيفَ يَبكي شاعِرٌ", "ajuz": "ضاعَ ما بَينَ صُدودٍ وَتَجَنِّ" },
    { "n": 5, "sadr": "إِنَّما الدُّنيا وَفي أَمثالِها", "ajuz": "عِبَرُ الدُّنيا وَأَصداءُ التَّمَنّي" },
    { "n": 6, "sadr": "غارَةٌ لَم أَتَهَيَّب جَمرَها", "ajuz": "فَنَبا سَيفي وَلَم يَسلَم مِجَنّي" },
    { "n": 7, "sadr": "رُبَّ دَهياءَ أَناخَت بِالحِمى", "ajuz": "غابَ حاميهِ وَخَطبٍ مُرجَحِنِّ" },
    { "n": 8, "sadr": "بَينَ سَمعٍ وَعِيانٍ لَيتَني", "ajuz": "لا تَرى عَيني وَلا تَسمَعُ أُذني" },
    { "n": 9, "sadr": "ما عَلى لَحني وَقَد أَرسَلتُهُ", "ajuz": "يُلهِبُ الدُّنيا عَلى الغاصِبِ لَحني" },
    { "n": 10, "sadr": "فَإِذا لَم أَستَثِرها هِمَماً", "ajuz": "لا وَرى زَندي وَلا ظَلَّلَ رُكني" },
    { "n": 11, "sadr": "لَستَ تَدري الهَمَّ بِالدُّنيا فَخُذ", "ajuz": "أَيُّها الطَّيرُ دُروسَ الهَمِّ عَنّي" },
    { "n": 12, "sadr": "تاجُ هارونَ خَبا لَألاؤُهُ", "ajuz": "فَبَكَت دِجلَةُ حُزناً وَالفُرات" },
    { "n": 13, "sadr": "وَذُرى الزَّهراءِ خَرَّت بَعدَما", "ajuz": "طاوَلَت زُهرَ النُّجومِ النَّيِّرات" },
    { "n": 14, "sadr": "وَبَنو مَروانَ وَلَّوا وَانطَوَوا", "ajuz": "وَتَخَلَّوا عَن مُتونِ الصّافِنات" },
    { "n": 15, "sadr": "قُل لِجَيشِ الرّومِ ماذا تَتَّقي", "ajuz": "طاحَ رَيبُ الدَّهرِ غَدراً بِالغُزاة" },
    { "n": 16, "sadr": "لا بَنو العَبّاسِ في زَخمِ الوَغى", "ajuz": "لا وَلا أَبناءُ حَمدانَ الأُباة" },
    { "n": 17, "sadr": "عَقِلَت بَينَ خِيامِ المُنحَنى", "ajuz": "وَالفُراتَينِ عِتاقُ السّابِقات" },
    { "n": 18, "sadr": "وَهِيَ الأَسيافُ في أَغمادِها", "ajuz": "صَدِئَت يا وَيلَتي لِلمُرهَفات" },
    { "n": 19, "sadr": "قِف عَلى اليَرموكِ وَاخشَع باكِياً", "ajuz": "وَتَيَمَّم مِن صَعيدِ القادِسِيَّة" },
    { "n": 20, "sadr": "تُربَةٌ طَيِّبَةٌ طاهِرَةٌ", "ajuz": "وَقُبورٌ مِن حَيا الدَّمعِ رَوِيَّة" },
    { "n": 21, "sadr": "ها هُنا مَثوى الصَّناديدِ الأُلى", "ajuz": "قَد لَوَوا قَسراً عِنانَ الجاهِلِيَّة" },
    { "n": 22, "sadr": "دَوَّخوا الرّومَ وَثَلّوا عَرشَها", "ajuz": "وَطَوَوا حُمرَ البُنودِ الفارِسِيَّة" },
    { "n": 23, "sadr": "يا قُبوراً مُحِيَت وَاندَثَرَت", "ajuz": "أَنتِ نِبراسُ الهُدى وَالوَطَنِيَّة" },
    { "n": 24, "sadr": "لَكِ مِن دَمعي إِذا ضَنَّ الحَيا", "ajuz": "ديمَةٌ تَبكي وَوَطفاءُ رَوِيَّة" },
    { "n": 25, "sadr": "قَد رَأَوا لَيلايَ تُذري دَمعَها", "ajuz": "كَرَّمَ اللَّهُ الدُّموعَ الطّاهِرَة" },
    { "n": 26, "sadr": "حَرَسَ اللَّهُ جُفوناً عَطَّرَت", "ajuz": "بِالنَّدى تِلكَ الخُدودَ النّاضِرَة" },
    { "n": 27, "sadr": "كَفكِفي دَمعَكِ لا يَشهَدُهُ", "ajuz": "ناظِرٌ حَتّى النُّجومُ الزّاهِرَة" },
    { "n": 28, "sadr": "إِنَّ لي يا اِبنَةَ وُدّي هِمَّةً", "ajuz": "تَخضِدُ الخَطبَ وَنَفساً ثائِرَة" },
    { "n": 29, "sadr": "وَأَراني في غَدٍ مُقتَحِماً", "ajuz": "مُستَظِلّاً بِالسُّيوفِ الباتِرَة" },
    { "n": 30, "sadr": "مُلقِياً نَفسِيَ في غَمرَتِها", "ajuz": "كَيفَما دارَت هُناكَ الدّائِرَة" },
    { "n": 31, "sadr": "فَإِذا مِتُّ غَريباً نائِياً", "ajuz": "وَأَنا في التِّسعِ بَعدَ العاشِرَة" },
    { "n": 32, "sadr": "اُذكُريني وَاحفَظي عَهدَ الهَوى", "ajuz": "وَاندُبي شُؤمَ الجُدودِ العاثِرَة" },
    { "n": 33, "sadr": "لَستُ تَاللَّهِ مُحِبّاً غادِراً", "ajuz": "لا تَكوني بَعدَ مَوتي غادِرَة" }
  ]
}
