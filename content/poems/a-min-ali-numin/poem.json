{
  "id": "a-min-ali-numin",
  "poet": "umar-ibn-abi-rabia",
  "title": "أَمِن آلِ نُعمٍ أَنتَ غادٍ فَمُبكِرُ",
  "meter": "tawil",
  "rawiy": "ر",
  "abyat_in_full": 75,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَمِن آلِ نُعمٍ أَنتَ غادٍ فَمُبكِرُ",
      "ajuz": "غَداةَ غَدٍ أَم رائِحٌ فَمُهَجِّرُ"
    },
    {
      "n": 2,
      "sadr": "لِحاجَةِ نَفسٍ لَم تَقُل في جَوابِها",
      "ajuz": "فَتُبلِغَ عُذراً وَالمَقالَةُ تُعذِرُ"
    },
    {
      "n": 3,
      "sadr": "تَهيمُ إِلى نُعمٍ فَلا الشَّملُ جامِعٌ",
      "ajuz": "وَلا الحَبلُ مَوصولٌ وَلا القَلبُ مُقصِرُ"
    },
    {
      "n": 4,
      "sadr": "وَلا قُربُ نُعمٍ إِن دَنَت لَكَ نافِعٌ",
      "ajuz": "وَلا نَأيُها يُسلي وَلا أَنتَ تَصبِرُ"
    },
    {
      "n": 5,
      "sadr": "وَأُخرى أَتَت مِن دونِ نُعمٍ وَمِثلُها",
      "ajuz": "نَهى ذا النُّهى لَو تَرعَوي أَو تُفَكِّرُ"
    },
    {
      "n": 6,
      "sadr": "إِذا زُرتُ نُعماً لَم يَزَل ذو قَرابَةٍ",
      "ajuz": "لَها كُلَّما لاقَيتُها يَتَنَمَّرُ"
    },
    {
      "n": 7,
      "sadr": "عَزيزٌ عَلَيهِ أَن أُلِمَّ بِبَيتِها",
      "ajuz": "يُسِرُّ لِيَ الشَّحناءَ وَالبُغضَ يُظهِرُ"
    },
    {
      "n": 8,
      "sadr": "أَلِكني إِلَيها بِالسَّلامِ فَإِنَّهُ",
      "ajuz": "يُشَهَّرُ إِلمامي بِها وَيُنَكَّرُ"
    },
    {
      "n": 9,
      "sadr": "بِآيَةِ ما قالَت غَداةَ لَقيتُها",
      "ajuz": "بِمَدفَعِ أَكنانٍ أَهَذا المُشَهَّرُ"
    },
    {
      "n": 10,
      "sadr": "قِفي فَاِنظُري أَسماءُ هَل تَعرِفينَهُ",
      "ajuz": "أَهَذا المُغيريُّ الَّذي كانَ يُذكَرُ"
    },
    {
      "n": 11,
      "sadr": "أَهَذا الَّذي أَطرَيتِ نَعتاً فَلَم أَكُن",
      "ajuz": "وَعَيشِكِ أَنساهُ إِلى يَومِ أُقبَرُ"
    },
    {
      "n": 12,
      "sadr": "فَقالَت نَعَم لا شَكَّ غَيَّرَ لَونَهُ",
      "ajuz": "سُرى اللَّيلِ يُحيي نَصَّهُ وَالتَّهَجُّرُ"
    },
    {
      "n": 13,
      "sadr": "لَئِن كانَ إِيّاهُ لَقَد حالَ بَعدَنا",
      "ajuz": "عَنِ العَهدِ وَالإِنسانُ قَد يَتَغَيَّرُ"
    },
    {
      "n": 14,
      "sadr": "رَأَت رَجُلاً أَمّا إِذا الشَّمسُ عارَضَت",
      "ajuz": "فَيَضحى وَأَمّا بِالعَشيِّ فَيَخصَرُ"
    },
    {
      "n": 15,
      "sadr": "أَخا سَفَرٍ جَوّابَ أَرضٍ تَقاذَفَت",
      "ajuz": "بِهِ فَلَواتٌ فَهوَ أَشعَثُ أَغبَرُ"
    },
    {
      "n": 16,
      "sadr": "قَليلاً عَلى ظَهرِ المَطِيَّةِ ظِلُّهُ",
      "ajuz": "سِوى ما نَفى عَنهُ الرِّداءُ المُحَبَّرُ"
    },
    {
      "n": 17,
      "sadr": "وَأَعجَبَها مِن عَيشِها ظِلُّ غُرفَةٍ",
      "ajuz": "وَرَيّانُ مُلتَفُّ الحَدائِقِ أَخضَرُ"
    },
    {
      "n": 18,
      "sadr": "وَوالٍ كَفاها كُلَّ شَيءٍ يَهُمُّها",
      "ajuz": "فَلَيسَت لِشَيءٍ آخِرَ اللَّيلِ تَسهَرُ"
    },
    {
      "n": 19,
      "sadr": "وَلَيلَةَ ذي دَورانَ جَشَّمَني السُّرى",
      "ajuz": "وَقَد يَجشَمُ الهَولَ المُحِبُّ المُغَرِّرُ"
    },
    {
      "n": 20,
      "sadr": "فَبِتُّ رَقيباً لِلرِّفاقِ عَلى شَفا",
      "ajuz": "أُحاذِرُ مِنهُم مَن يَطوفُ وَأَنظُرُ"
    },
    {
      "n": 21,
      "sadr": "إِلَيهِم مَتى يَستَمكِنُ النَّومُ مِنهُمُ",
      "ajuz": "وَلي مَجلِسٌ لَولا اللُّبانَةُ أَوعَرُ"
    },
    {
      "n": 22,
      "sadr": "وَباتَت قَلوصي بِالعَراءِ وَرَحلُها",
      "ajuz": "لِطارِقِ لَيلٍ أَو لِمَن جاءَ مُعوِرُ"
    },
    {
      "n": 23,
      "sadr": "وَبِتُّ أُناجي النَّفسَ أَينَ خِباؤُها",
      "ajuz": "وَكَيفَ لِما آتي مِنَ الأَمرِ مَصدَرُ"
    },
    {
      "n": 24,
      "sadr": "فَدَلَّ عَلَيها القَلبُ رَيّا عَرَفتُها",
      "ajuz": "لَها وَهَوى النَّفسِ الَّذي كادَ يَظهَرُ"
    },
    {
      "n": 25,
      "sadr": "فَلَمّا فَقَدتُ الصَّوتَ مِنهُم وَأُطفِئَت",
      "ajuz": "مَصابيحُ شُبَّت في العِشاءِ وَأَنؤُرُ"
    },
    {
      "n": 26,
      "sadr": "وَغابَ قُمَيرٌ كُنتُ أَهوى غُيوبَهُ",
      "ajuz": "وَرَوَّحَ رُعيانُ وَنَوَّمَ سُمَّرُ"
    },
    {
      "n": 27,
      "sadr": "وَخُفِّضَ عَنّي الصَّوتُ أَقبَلتُ مِشيَةَ",
      "ajuz": "الحُبابِ وَشَخصي خَشيَةَ الحَيِّ أَزوَرُ"
    },
    {
      "n": 28,
      "sadr": "فَحَيَّيتُ إِذ فاجَأتُها فَتَوَلَّهَت",
      "ajuz": "وَكادَت بِمَخفوضِ التَّحِيَّةِ تَجهَرُ"
    },
    {
      "n": 29,
      "sadr": "وَقالَت وَعَضَّت بِالبَنانِ فَضَحتَني",
      "ajuz": "وَأَنتَ اِمرُؤٌ مَيسورُ أَمرِكَ أَعسَرُ"
    },
    {
      "n": 30,
      "sadr": "أَرَيتَكَ إِن هُنّا عَلَيكَ أَلَم تَخَف",
      "ajuz": "وُقيتَ وَحَولي مِن عَدُوِّكَ حُضَّرُ"
    },
    {
      "n": 31,
      "sadr": "فَوَاللَّهِ ما أَدري أَتَعجيلُ حاجَةٍ",
      "ajuz": "سَرَت بِكَ أَم قَد نامَ مَن كُنتَ تَحذَرُ"
    },
    {
      "n": 32,
      "sadr": "فَقُلتُ لَها بَل قادَني الشَّوقُ وَالهَوى",
      "ajuz": "إِلَيكِ وَما نَفسٌ مِنَ النّاسِ تَشعُرُ"
    },
    {
      "n": 33,
      "sadr": "فَقالَت وَقَد لانَت وَأَفرَخَ رَوعُها",
      "ajuz": "كَلاكَ بِحِفظٍ رَبُّكَ المُتَكَبِّرُ"
    },
    {
      "n": 34,
      "sadr": "فَأَنتَ أَبا الخَطّابِ غَيرُ مُدافَعٍ",
      "ajuz": "عَلَيَّ أَميرٌ ما مَكَثتَ مُؤَمَّرُ"
    },
    {
      "n": 35,
      "sadr": "فَيا لَكَ مِن لَيلٍ تَقاصَرَ طولُهُ",
      "ajuz": "وَما كانَ لَيلي قَبلَ ذَلِكَ يَقصُرُ"
    },
    {
      "n": 36,
      "sadr": "وَيا لَكَ مِن مَلهىً هُناكَ وَمَجلِسٍ",
      "ajuz": "لَنا لَم يُكَدِّرهُ عَلَينا مُكَدِّرُ"
    },
    {
      "n": 37,
      "sadr": "يَمُجُّ ذَكِيَّ المِسكِ مِنها مُقَبَّلٌ",
      "ajuz": "نَقِيُّ الثَّنايا ذو غُروبٍ مُؤَشَّرُ"
    },
    {
      "n": 38,
      "sadr": "تَراهُ إِذا ما اِفتَرَّ عَنهُ كَأَنَّهُ",
      "ajuz": "حَصى بَرَدٍ أَو أُقحُوانٌ مُنَوِّرُ"
    },
    {
      "n": 39,
      "sadr": "وَتَرنو بِعَينَيها إِلَيَّ كَما رَنا",
      "ajuz": "إِلى ظَبيَةٍ وَسطَ الخَميلَةِ جُؤذَرُ"
    },
    {
      "n": 40,
      "sadr": "فَلَمّا تَقَضّى اللَّيلُ إِلّا أَقَلَّهُ",
      "ajuz": "وَكادَت تَوالي نَجمِهِ تَتَغَوَّرُ"
    },
    {
      "n": 41,
      "sadr": "أَشارَت بِأَنَّ الحَيَّ قَد حانَ مِنهُمُ",
      "ajuz": "هُبوبٌ وَلَكِن مَوعِدٌ مِنكَ عَزوَرُ"
    },
    {
      "n": 42,
      "sadr": "فَما راعَني إِلّا مُنادٍ تَرَحَّلوا",
      "ajuz": "وَقَد لاحَ مَعروفٌ مِنَ الصُّبحِ أَشقَرُ"
    },
    {
      "n": 43,
      "sadr": "فَلَمّا رَأَت مَن قَد تَنَبَّهَ مِنهُمُ",
      "ajuz": "وَأَيقاظَهُم قالَت أَشِر كَيفَ تَأمُرُ"
    },
    {
      "n": 44,
      "sadr": "فَقُلتُ أُباديهِم فَإِمّا أَفوتُهُم",
      "ajuz": "وَإِمّا يَنالُ السَّيفُ ثَأراً فَيَثأَرُ"
    },
    {
      "n": 45,
      "sadr": "فَقالَت أَتَحقيقاً لِما قالَ كاشِحٌ",
      "ajuz": "عَلَينا وَتَصديقاً لِما كانَ يُؤثَرُ"
    },
    {
      "n": 46,
      "sadr": "فَإِن كانَ ما لا بُدَّ مِنهُ فَغَيرُهُ",
      "ajuz": "مِنَ الأَمرِ أَدنى لِلخَفاءِ وَأَستَرُ"
    },
    {
      "n": 47,
      "sadr": "أَقُصُّ عَلى أُختَيَّ بِدءَ حَديثِنا",
      "ajuz": "وَما لِيَ مِن أَن تَعلَما مُتَأَخَّرُ"
    },
    {
      "n": 48,
      "sadr": "لَعَلَّهُما أَن تَطلُبا لَكَ مَخرَجاً",
      "ajuz": "وَأَن تَرحُبا صَدراً بِما كُنتُ أَحصُرُ"
    },
    {
      "n": 49,
      "sadr": "فَقامَت كَئيباً لَيسَ في وَجهِها دَمٌ",
      "ajuz": "مِنَ الحُزنِ تُذري عَبرَةً تَتَحَدَّرُ"
    },
    {
      "n": 50,
      "sadr": "فَقامَت إِلَيها حُرَّتانِ عَلَيهِما",
      "ajuz": "كِساءانِ مِن خَزٍّ دِمَقسٌ وَأَخضَرُ"
    },
    {
      "n": 51,
      "sadr": "فَقالَت لِأُختَيها أَعينا عَلى فَتىً",
      "ajuz": "أَتى زائِراً وَالأَمرُ لِلأَمرِ يُقدَرُ"
    },
    {
      "n": 52,
      "sadr": "فَأَقبَلَتا فَاِرتاعَتا ثُمَّ قالَتا",
      "ajuz": "أَقِلّي عَلَيكِ اللَّومَ فَالخَطبُ أَيسَرُ"
    },
    {
      "n": 53,
      "sadr": "فَقالَت لَها الصُّغرى سَأُعطيهِ مِطرَفي",
      "ajuz": "وَدِرعي وَهَذا البُردُ إِن كانَ يَحذَرُ"
    },
    {
      "n": 54,
      "sadr": "يَقومُ فَيَمشي بَينَنا مُتَنَكِّراً",
      "ajuz": "فَلا سِرُّنا يَفشو وَلا هُوَ يَظهَرُ"
    },
    {
      "n": 55,
      "sadr": "فَكانَ مِجَنّي دونَ مَن كُنتُ أَتَّقي",
      "ajuz": "ثَلاثُ شُخوصٍ كاعِبانِ وَمُعصِرُ"
    },
    {
      "n": 56,
      "sadr": "فَلَمّا أَجَزنا ساحَةَ الحَيِّ قُلنَ لي",
      "ajuz": "أَما تَتَّقي الأَعداءَ وَاللَّيلُ مُقمِرُ"
    },
    {
      "n": 57,
      "sadr": "وَقُلنَ أَهَذا دَأبُكَ الدَّهرَ سادِراً",
      "ajuz": "أَما تَستَحي أَو تَرعَوي أَو تُفَكِّرُ"
    },
    {
      "n": 58,
      "sadr": "إِذا جِئتَ فَامنَح طَرفَ عَينَيكَ غَيرَنا",
      "ajuz": "لِكَي يَحسِبوا أَنَّ الهَوى حَيثُ تَنظُرُ"
    },
    {
      "n": 59,
      "sadr": "فَآخِرُ عَهدٍ لي بِها حينَ أَعرَضَت",
      "ajuz": "وَلاحَ لَها خَدٌّ نَقِيٌّ وَمَحجَرُ"
    },
    {
      "n": 60,
      "sadr": "سِوى أَنَّني قَد قُلتُ يا نُعمُ قَولَةً",
      "ajuz": "لَها وَالعِتاقُ الأَرحَبيّاتُ تُزجَرُ"
    },
    {
      "n": 61,
      "sadr": "هَنيئاً لِأَهلِ العامِرِيَّةِ نَشرُها",
      "ajuz": "اللَّذيذُ وَرَيّاها الَّذي أَتَذَكَّرُ"
    },
    {
      "n": 62,
      "sadr": "وَقُمتُ إِلى عَنسٍ تَخَوَّنَ نَيَّها",
      "ajuz": "سُرى اللَّيلِ حَتّى لَحمُها مُتَحَسِّرُ"
    },
    {
      "n": 63,
      "sadr": "وَحَبسي عَلى الحاجاتِ حَتّى كَأَنَّها",
      "ajuz": "بَقِيَّةُ لَوحٍ أَو شِجارٌ مُؤَسَّرُ"
    },
    {
      "n": 64,
      "sadr": "وَماءٍ بِمَوماةٍ قَليلٍ أَنيسُهُ",
      "ajuz": "بَسابِسَ لَم يَحدُث بِهِ الصَّيفَ مَحضَرُ"
    },
    {
      "n": 65,
      "sadr": "بِهِ مُبتَنىً لِلعَنكَبوتِ كَأَنَّهُ",
      "ajuz": "عَلى طَرَفِ الأَرجاءِ خامٌ مُنَشَّرُ"
    },
    {
      "n": 66,
      "sadr": "وَرِدتُ وَما أَدري أَما بَعدَ مَورِدي",
      "ajuz": "مِنَ اللَّيلِ أَم ما قَد مَضى مِنهُ أَكثَرُ"
    },
    {
      "n": 67,
      "sadr": "فَقُمتُ إِلى مِغلاةِ أَرضٍ كَأَنَّها",
      "ajuz": "إِذا اِلتَفَتَت مَجنونَةٌ حينَ تَنظُرُ"
    },
    {
      "n": 68,
      "sadr": "تُنازِعُني حِرصاً عَلى الماءِ رَأسَها",
      "ajuz": "وَمِن دونِ ما تَهوى قَليبٌ مُعَوَّرُ"
    },
    {
      "n": 69,
      "sadr": "مُحاوِلَةً لِلماءِ لَولا زِمامُها",
      "ajuz": "وَجَذبي لَها كادَت مِراراً تَكَسَّرُ"
    },
    {
      "n": 70,
      "sadr": "فَلَمّا رَأَيتُ الضَّرَّ مِنها وَأَنَّني",
      "ajuz": "بِبَلدَةِ أَرضٍ لَيسَ فيها مُعَصَّرُ"
    },
    {
      "n": 71,
      "sadr": "قَصَرتُ لَها مِن جانِبِ الحَوضِ مُنشَأً",
      "ajuz": "جَديداً كَقابِ الشِّبرِ أَو هُوَ أَصغَرُ"
    },
    {
      "n": 72,
      "sadr": "إِذا شَرَعَت فيهِ فَلَيسَ لِمُلتَقى",
      "ajuz": "مَشافِرِها مِنهُ قِدى الكَفِّ مُسأَرُ"
    },
    {
      "n": 73,
      "sadr": "وَلا دَلوَ إِلّا القَعبُ كانَ رِشاءَهُ",
      "ajuz": "إِلى الماءِ نِسعٌ وَالأَديمُ المُضَفَّرُ"
    },
    {
      "n": 74,
      "sadr": "فَسافَت وَما عافَت وَما رَدَّ شُربَها",
