{
  "id": "nuniyyat-urwa-ibn-hizam",
  "poet": "urwa-ibn-hizam",
  "title": "نونِيَّةُ عُروَةَ بنِ حِزامٍ",
  "meter": "tawil",
  "rawiy": "ن",
  "abyat_in_full": 82,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "خَليلَيَّ مِن عُليا هِلالِ اِبنِ عامِرٍ",
      "ajuz": "بِصَنعاءَ عوجا اليَومَ وَانتَظِراني"
    },
    {
      "n": 2,
      "sadr": "وَلا تَزهَدا في الأَجرِ عِندي وَأَجمِلا",
      "ajuz": "فَإِنَّكُما بِيَ اليَومَ مُبتَلَيانِ"
    },
    {
      "n": 3,
      "sadr": "أَلَم تَعلَما أَن لَيسَ بِالمَرخِ كُلِّهِ",
      "ajuz": "أَخٌ وَصَديقٌ صالِحٌ فَذَراني"
    },
    {
      "n": 4,
      "sadr": "أَفي كُلِّ يَومٍ أَنتَ رامٍ بِلادَها",
      "ajuz": "بِعَينَينِ إِنساناهُما غَرِقانِ"
    },
    {
      "n": 5,
      "sadr": "أَلا فَاحمِلاني بارَكَ اللَّهُ فيكُما",
      "ajuz": "إِلى حاضِرِ الرَّوحاءِ ثُمَّ دَعاني"
    },
    {
      "n": 6,
      "sadr": "عَلى جَسرَةِ الأَصلابِ ناجِيَةِ السُّرى",
      "ajuz": "تُقَطِّعُ عَرضَ البيدِ بِالوَخَدانِ"
    },
    {
      "n": 7,
      "sadr": "أَلِمّا عَلى عَفراءَ إِنَّكُما غَداً",
      "ajuz": "بِشَحطِ النَّوى وَالبَينِ مُعتَرِفانِ"
    },
    {
      "n": 8,
      "sadr": "فَيا واشِيَي عَفرا دَعاني وَنَظرَةً",
      "ajuz": "تَقَرُّ بِها عَينايَ ثُمَّ كِلاني"
    },
    {
      "n": 9,
      "sadr": "أَغَرَّكُما مِنّي قَميصٌ لَبِستُهُ",
      "ajuz": "جَديدٌ وَبُردا يَمنَةٍ زَهِيانِ"
    },
    {
      "n": 10,
      "sadr": "مَتى تَرفَعا عَنّي القَميصَ تَبَيَّنا",
      "ajuz": "بِيَ الضُّرَّ مِن عَفراءَ يا فَتَيانِ"
    },
    {
      "n": 11,
      "sadr": "وَتَعتَرِفا لَحماً قَليلاً وَأَعظُماً",
      "ajuz": "رِقاقاً وَقَلباً دائِمَ الخَفَقانِ"
    },
    {
      "n": 12,
      "sadr": "عَلى كَبِدي مِن حُبِّ عَفراءَ قُرحَةٌ",
      "ajuz": "وَعَينايَ مِن وَجدٍ بِها تَكِفانِ"
    },
    {
      "n": 13,
      "sadr": "فَعَفراءُ أَرجى النّاسِ عِندي مَوَدَّةً",
      "ajuz": "وَعَفراءُ عَنّي المُعرِضُ المُتَواني"
    },
    {
      "n": 14,
      "sadr": "فَيا لَيتَ كُلَّ اِثنَينِ بَينَهُما هَوىً",
      "ajuz": "مِنَ النّاسِ وَالأَنعامِ يَلتَقِيانِ"
    },
    {
      "n": 15,
      "sadr": "فَيَقضِيَ حَبيبٌ مِن حَبيبٍ لُبانَةً",
      "ajuz": "وَيَرعاهُما رَبّي فَلا يُرَيانِ"
    },
    {
      "n": 16,
      "sadr": "هَوى ناقَتي خَلفي وَقُدّاميَ الهَوى",
      "ajuz": "وَإِنّي وَإِيّاها لَمُختَلِفانِ"
    },
    {
      "n": 17,
      "sadr": "هَوايَ أَمامي لَيسَ خَلفي مُعَرَّجٌ",
      "ajuz": "وَشَوقُ قَلوصي في الغُدُوِّ يَمانِ"
    },
    {
      "n": 18,
      "sadr": "هَوايَ عِراقِيٌّ وَتَثني زِمامَها",
      "ajuz": "لِبَرقٍ إِذا لاحَ النُّجومُ يَمانِ"
    },
    {
      "n": 19,
      "sadr": "مَتى تَجمَعي شَوقي وَشَوقَكِ تَظلَعي",
      "ajuz": "وَما لَكِ بِالعِبءِ الثَّقيلِ يَدانِ"
    },
    {
      "n": 20,
      "sadr": "فَيا كَبِدَينا مِن مَخافَةِ لَوعَةِ ال",
      "ajuz": "فِراقِ وَمِن صَرفِ النَّوى تَجِفانِ"
    },
    {
      "n": 21,
      "sadr": "وَإِذ نَحنُ مِن أَن تَشحَطَ الدّارُ غُربَةً",
      "ajuz": "وَأَن شُقَّ لِلبَينِ العَصا وَجِلانِ"
    },
    {
      "n": 22,
      "sadr": "يَقولُ لِيَ الأَصحابُ إِذ يَعذُلونَني",
      "ajuz": "أَشَوقٌ عِراقِيٌّ وَأَنتَ يَمانِ"
    },
    {
      "n": 23,
      "sadr": "وَلَيسَ يَمانٍ لِلعِراقِ بِصاحِبٍ",
      "ajuz": "عَسى في صُروفِ الدَّهرِ يَلتَقِيانِ"
    },
    {
      "n": 24,
      "sadr": "تَحَمَّلتُ مِن عَفراءَ ما لَيسَ لي بِهِ",
      "ajuz": "وَلا لِلجِبالِ الرّاسِياتِ يَدانِ"
    },
    {
      "n": 25,
      "sadr": "كَأَنَّ قَطاةً عُلِّقَت بِجَناحِها",
      "ajuz": "عَلى كَبِدي مِن شِدَّةِ الخَفَقانِ"
    },
    {
      "n": 26,
      "sadr": "جَعَلتُ لِعَرّافِ اليَمامَةِ حُكمَهُ",
      "ajuz": "وَعَرّافِ نَجدٍ إِن هُما شَفَياني"
    },
    {
      "n": 27,
      "sadr": "فَقالا نَعَم نَشفي مِنَ الدّاءِ كُلِّهِ",
      "ajuz": "وَقاما مَعَ العُوّادِ يَبتَدِرانِ"
    },
    {
      "n": 28,
      "sadr": "فَما تَرَكا مِن رُقيَةٍ يَعلَمانِها",
      "ajuz": "وَلا سَلوَةٍ إِلّا وَقَد سَقَياني"
    },
    {
      "n": 29,
      "sadr": "وَما شَفَيا الدّاءَ الَّذي بي كُلَّهُ",
      "ajuz": "وَلا ذَخَرا نُصحاً وَلا أَلَواني"
    },
    {
      "n": 30,
      "sadr": "فَقالا شَفاكَ اللَّهُ وَاللَّهِ ما لَنا",
      "ajuz": "بِما ضُمِّنَت مِنكَ الضُّلوعُ يَدانِ"
    },
    {
      "n": 31,
      "sadr": "فَرُحتُ مِنَ العَرّافِ تَسقُطُ عِمَّتي",
      "ajuz": "عَنِ الرَّأسِ ما أَلتاثُها بِبَناني"
    },
    {
      "n": 32,
      "sadr": "مَعي صاحِبا صِدقٍ إِذا مِلتُ مَيلَةً",
      "ajuz": "وَكانَ بِدَفَّي نِضوَتي عِدلاني"
    },
    {
      "n": 33,
      "sadr": "فَيا عَمِّ يا ذا الغَدرِ لا زِلتَ مُبتَلىً",
      "ajuz": "حَليفاً لِهَمٍّ لازِمٍ وَهَوانِ"
    },
    {
      "n": 34,
      "sadr": "غَدَرتَ وَكانَ الغَدرُ مِنكَ سَجِيَّةً",
      "ajuz": "فَأَلزَمتَ قَلبي دائِمَ الخَفَقانِ"
    },
    {
      "n": 35,
      "sadr": "وَأَورَثتَني غَمّاً وَكَرباً وَحَسرَةً",
      "ajuz": "وَأَورَثتَ عَيني دائِمَ الهَمَلانِ"
    },
    {
      "n": 36,
      "sadr": "فَلا زِلتَ ذا شَوقٍ إِلى مَن هَويتَهُ",
      "ajuz": "وَقَلبُكَ مَقسومٌ بِكُلِّ مَكانِ"
    },
    {
      "n": 37,
      "sadr": "وَإِنّي لَأَهوى الحَشرَ إِذ قيلَ إِنَّني",
      "ajuz": "وَعَفراءَ يَومَ الحَشرِ مُلتَقِيانِ"
    },
    {
      "n": 38,
      "sadr": "أَلا يا غُرابَي دِمنَةِ الدّارِ بَيِّنا",
      "ajuz": "أَبِالهَجرِ مِن عَفراءَ تَنتَحِبانِ"
    },
    {
      "n": 39,
      "sadr": "فَإِن كانَ حَقّاً ما تَقولانِ فَاذهَبا",
      "ajuz": "بِلَحمي إِلى وَكرَيكُما فَكُلاني"
    },
    {
      "n": 40,
      "sadr": "كُلاني أَكلاً لَم يَرَ النّاسُ مِثلَهُ",
      "ajuz": "وَلا تَهضِما جَنبَيَّ وَازدَرِداني"
    },
    {
      "n": 41,
      "sadr": "وَلا يَعلَمَنَّ النّاسُ ما كانَ قِصَّتي",
      "ajuz": "وَلا يَطعَمَنَّ الطَّيرُ ما تَذَرانِ"
    },
    {
      "n": 42,
      "sadr": "أَناسِيَةٌ عَفراءُ ذِكري بَعدَما",
      "ajuz": "تَرَكتُ لَها ذِكراً بِكُلِّ مَكانِ"
    },
    {
      "n": 43,
      "sadr": "أَلا لَعَنَ اللَّهُ الوُشاةَ وَقَولَهُم",
      "ajuz": "فُلانَةُ أَضحَت خُلَّةً لِفُلانِ"
    },
    {
      "n": 44,
      "sadr": "إِذا ما جَلَسنا مَجلِساً نَستَلِذُّهُ",
      "ajuz": "تَواشَوا بِنا حَتّى أَمَلَّ مَكاني"
    },
    {
      "n": 45,
      "sadr": "تَكَنَّفَني الواشونَ مِن كُلِّ جانِبٍ",
      "ajuz": "وَلَو كانَ واشٍ واحِدٌ لَكَفاني"
    },
    {
      "n": 46,
      "sadr": "وَلَو كانَ واشٍ بِاليَمامَةِ أَرضُهُ",
      "ajuz": "أُحاذِرُهُ مِن شُؤمِهِ لَأَتاني"
    },
    {
      "n": 47,
      "sadr": "يُكَلِّفُني عَمّي ثَمانينَ بَكرَةً",
      "ajuz": "وَما لي يا عَفراءُ غَيرُ ثَمانِ"
    },
    {
      "n": 48,
      "sadr": "فَيا لَيتَ مَحيانا جَميعاً وَلَيتَنا",
      "ajuz": "إِذا نَحنُ مِتنا ضَمَّنا كَفَنانِ"
    },
    {
      "n": 49,
      "sadr": "وَيا لَيتَ أَنّا الدَّهرَ في غَيرِ ريبَةٍ",
      "ajuz": "خَلِيّانِ نَرعى القَفرَ مُؤتَلِفانِ"
    },
    {
      "n": 50,
      "sadr": "إِذا ما وَرَدنا مَنهَلاً صاحَ أَهلُهُ",
      "ajuz": "وَقالوا بَعيرا عُرَّةٍ جَرِبانِ"
    },
    {
      "n": 51,
      "sadr": "فَوَاللَّهِ ما حَدَّثتُ سِرَّكِ صاحِباً",
      "ajuz": "أَخاً لي وَلا فاهَت بِهِ الشَّفَتانِ"
    },
    {
      "n": 52,
      "sadr": "سِوى أَنَّني قَد قُلتُ يَوماً لِصاحِبي",
      "ajuz": "ضُحىً وَقَلوصانا بِنا تَخِدانِ"
    },
    {
      "n": 53,
      "sadr": "ضُحَيّاً وَمَسَّتنا جَنوبٌ ضَعيفَةٌ",
      "ajuz": "نَسيمٌ لِرَيّاها بِنا خَفَقانِ"
    },
    {
      "n": 54,
      "sadr": "تَحَمَّلتُ زَفراتِ الضُّحى فَأَطَقتُها",
      "ajuz": "وَما لي بِزَفراتِ العَشِيِّ يَدانِ"
    },
    {
      "n": 55,
      "sadr": "فَيا عَمِّ لا أُسقيتَ مِن ذي قَرابَةٍ",
      "ajuz": "بِلالاً فَقَد زَلَّت بِكَ القَدَمانِ"
    },
    {
      "n": 56,
      "sadr": "وَمَنَّيتَني عَفراءَ حَتّى رَجَوتُها",
      "ajuz": "وَشاعَ الَّذي مَنَّيتَ كُلَّ مَكانِ"
    },
    {
      "n": 57,
      "sadr": "بُنَيَّةُ عَمّي حيلَ بَيني وَبَينَها",
      "ajuz": "وَصاحَ لِوَشكِ الفُرقَةِ الصُّرَدانِ"
    },
    {
      "n": 58,
      "sadr": "فَيا حَبَّذا مَن دونَهُ يَعذُلونَني",
      "ajuz": "وَمَن حَلِيَت عَيني بِهِ وَلِساني"
    },
    {
      "n": 59,
      "sadr": "وَمَن لَو أَراهُ في العَدُوِّ أَتَيتُهُ",
      "ajuz": "وَمَن لَو يَراني في العَدُوِّ أَتاني"
    },
    {
      "n": 60,
      "sadr": "وَمَن هابَني في كُلِّ أَمرٍ وَهِبتُهُ",
      "ajuz": "وَلَو كُنتُ أَمضى مِن شَباةِ سِناني"
    },
    {
      "n": 61,
      "sadr": "فَوَاللَّهِ لَولا حُبُّ عَفراءَ ما اِلتَقى",
      "ajuz": "عَلَيَّ رِواقا بَيتِكَ الخَلَقانِ"
    },
    {
      "n": 62,
      "sadr": "خُلَيقانِ هَلهالانِ لا خَيرَ فيهِما",
      "ajuz": "قَبيحانِ يَجري فيهِما اليَرَقانِ"
    },
    {
      "n": 63,
      "sadr": "رِواقانِ هَفّافانِ لا خَيرَ فيهِما",
      "ajuz": "إِذا هَبَّتِ الأَرواحُ يَصطَفِقانِ"
    },
    {
      "n": 64,
      "sadr": "وَلَم أَتبَعِ الأَظعانَ في رَونَقِ الضُّحى",
      "ajuz": "وَرَحلي عَلى نَهّاضَةِ الخَدَيانِ"
    },
    {
      "n": 65,
      "sadr": "لِعَفراءَ إِذ في الدَّهرِ وَالنّاسِ غِرَّةٌ",
      "ajuz": "وَإِذ خُلُقانا بِالصِّبا يَسَرانِ"
    },
    {
      "n": 66,
      "sadr": "لَأَدنو مِن بَيضاءَ خَفّاقَةِ الحَشا",
      "ajuz": "بُنَيَّةِ ذي قاذورَةٍ شَنَآنِ"
    },
    {
      "n": 67,
      "sadr": "كَأَنَّ وِشاحَيها إِذا ما اِرتَدَتهُما",
      "ajuz": "وَقامَت عِنانا مُهرَةٍ سَلِسانِ"
    },
    {
      "n": 68,
      "sadr": "يَعَضُّ بِأَبدانٍ لَها مُلتَقاهُما",
      "ajuz": "وَمَثناهُما رَخوانِ يَضطَرِبانِ"
    },
    {
      "n": 69,
      "sadr": "وَتَحتَهُما حِقفانِ قَد ضَرَبَتهُما",
      "ajuz": "قِطارٌ مِنَ الجَوزاءِ مُلتَبِدانِ"
    },
    {
      "n": 70,
      "sadr": "أَعَفراءُ كَم مِن زَفرَةٍ قَد أَذَقتِني",
      "ajuz": "وَحُزنٍ أَلَجَّ العَينَ بِالهَمَلانِ"
    },
    {
      "n": 71,
      "sadr": "وَعَينايَ ما أَوفَيتُ نَشزاً فَتَنظُرا",
      "ajuz": "بِمَأقَيهِما إِلّا هُما تَكِفانِ"
    },
    {
      "n": 72,
      "sadr": "فَلَو أَنَّ عَينَي ذي هَوىً فاضَتا دَماً",
      "ajuz": "لَفاضَت دَماً عَينايَ تَبتَدِرانِ"
    },
    {
      "n": 73,
      "sadr": "فَهَل حادِيا عَفراءَ إِن خِفتُ فَوتَها",
      "ajuz": "عَلَيَّ إِذا نادَيتُ مُرعَوِيانِ"
    },
    {
      "n": 74,
      "sadr": "ضَروبانِ لِلتّالي القَطوفِ إِذا وَنى",
      "ajuz": "مُشيحانِ مِن بَغضائِنا حَذِرانِ"
    },
    {
      "n": 75,
      "sadr": "فَما لَكُما مِن حادِيَينِ رُميتُما",
      "ajuz": "بِحُمّى وَطاعونٍ أَلا تَقِفانِ"
    },
    {
      "n": 76,
      "sadr": "وَما لَكُما مِن حادِيَينِ كُسيتُما",
      "ajuz": "سَرابيلَ مُغلاةً مِنَ القَطِرانِ"
    },
    {
      "n": 77,
      "sadr": "فَوَيلي عَلى عَفراءَ وَيلٌ كَأَنَّهُ",
      "ajuz": "عَلى الكَبِدِ وَالأَحشاءِ حَدُّ سِنانِ"
    },
    {
      "n": 78,
      "sadr": "أَلا حَبَّذا مِن حُبِّ عَفراءَ مُلتَقى",
      "ajuz": "نَعامٍ وَبِركٍ حَيثُ يَلتَقِيانِ"
    },
