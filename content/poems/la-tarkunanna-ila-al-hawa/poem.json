{
  "id": "la-tarkunanna-ila-al-hawa",
  "poet": "ibn-durayd",
  "title": "المقصور والممدود",
  "meter": "kamil",
  "themes": ["didactic"],
  "rawiy": "ء",
  "abyat_in_full": 58,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "لا تَركَنَنَّ إِلى الهَوى",
      "ajuz": "وَاحذَر مُفارَقَةَ الهَواءِ"
    },
    {
      "n": 2,
      "sadr": "يَوماً تَصيرُ إِلى الثَّرى",
      "ajuz": "وَيَفوزُ غَيرُكَ بِالثَّراءِ"
    },
    {
      "n": 3,
      "sadr": "كَم مِن حَفيرٍ في رَجا",
      "ajuz": "بِئرٍ لِمُنقَطِعِ الرَّجاءِ"
    },
    {
      "n": 4,
      "sadr": "غَطّى عَلَيهِ بِالصَّفا",
      "ajuz": "أَهلُ المَوَدَّةِ وَالصَّفاءِ"
    },
    {
      "n": 5,
      "sadr": "ذَهَبَ الفَتى عَن أَهلِهِ",
      "ajuz": "أَينَ الفَتِيُّ مِنَ الفَتاءِ"
    },
    {
      "n": 6,
      "sadr": "زالَ السَّنا عَن ناظِرَي",
      "ajuz": "هِ وَزالَ عَن شَرَفِ السَّناءِ"
    },
    {
      "n": 7,
      "sadr": "ما زالَ يَلتَمِسُ الخَلى",
      "ajuz": "حَتّى تَوَحَّدَ في الخَلاءِ"
    },
    {
      "n": 8,
      "sadr": "قَطَعَ النَّسا مِنهُ الزَّما",
      "ajuz": "نُ فَلَم يُمَتَّع بِالنَّساءِ"
    },
    {
      "n": 9,
      "sadr": "وَأَرى العَشا في العَينِ أَك",
      "ajuz": "ثَرَ ما يَكونُ مِنَ العَشاءِ"
    },
    {
      "n": 10,
      "sadr": "وَأَرى الخَوى يُذكي عُقو",
      "ajuz": "لَ ذَوي التَّفَكُّرِ في الخَواءِ"
    },
    {
      "n": 11,
      "sadr": "وَلَرُبَّ مَمنوعِ العَرا",
      "ajuz": "وَلَسَوفَ يُنبَذُ بِالعَراءِ"
    },
    {
      "n": 12,
      "sadr": "مَن خافَ مِن أَلَمِ الحَفا",
      "ajuz": "فَليَجتَنِب مَشيَ الحَفاءِ"
    },
    {
      "n": 13,
      "sadr": "كَم مَن تَوارى بِالنَّقا",
      "ajuz": "بَعدَ النَّظافَةِ وَالنَّقاءِ"
    },
    {
      "n": 14,
      "sadr": "وَأَخو الغَرا مَن لا يَزا",
      "ajuz": "لُ بِما يَضُرُّكَ ذا غَراءِ"
    },
    {
      "n": 15,
      "sadr": "إِنَّ الحَياةَ مَعَ الحَيا",
      "ajuz": "وَأَرى البَهاءَ مَعَ الحَياءِ"
    },
    {
      "n": 16,
      "sadr": "عَقلُ الكَبيرِ مِنَ الوَرى",
      "ajuz": "في الصّالِحاتِ مِنَ الوَراءِ"
    },
    {
      "n": 17,
      "sadr": "لَو تَعلَمُ الشّاةُ النَّجا",
      "ajuz": "مِنها لَجَدَّت في النَّجاءِ"
    },
    {
      "n": 18,
      "sadr": "وَأَرى الدَّوى طولَ السَّقا",
      "ajuz": "مِ فَلا تُفَرِّط في الدَّواءِ"
    },
    {
      "n": 19,
      "sadr": "وَإِذا سَمِعتَ وَحى الزَّما",
      "ajuz": "نِ فَلا تُقَصِّر في الوَحاءِ"
    },
    {
      "n": 20,
      "sadr": "فَلَرُبَّما ساقَ السَّفا",
      "ajuz": "نَحوَ السَّفا أَهلُ السَّفاءِ"
    },
    {
      "n": 21,
      "sadr": "يا اِبنَ البَرى إِنَّ البَرِ",
      "ajuz": "يَّةَ يُؤذِنونَكَ بِالبَراءِ"
    },
    {
      "n": 22,
      "sadr": "وَأَراكَ قَد حالَ العَمى",
      "ajuz": "ما بَينَ عَينِكَ وَالعَماءِ"
    },
    {
      "n": 23,
      "sadr": "فَانظُر لِعَينِكَ في الجَلا",
      "ajuz": "إِن خِفتَ مِن يَومِ الجَلاءِ"
    },
    {
      "n": 24,
      "sadr": "وَكُلِ الفَنا إِن لَم تَجِد",
      "ajuz": "حِلّاً فَإِنَّكَ لِلفَناءِ"
    },
    {
      "n": 25,
      "sadr": "فَلَرُبَّما أَدّى الفَضى",
      "ajuz": "مُتَزَوِّديهِ إِلى الفَضاءِ"
    },
    {
      "n": 26,
      "sadr": "فَاهرُب هُديتَ مِنَ الذَّكا",
      "ajuz": "إِن كُنتَ مِن أَهلِ الذَّكاءِ"
    },
    {
      "n": 27,
      "sadr": "فَالمَرءُ أَشبَهُ بِالعَفا",
      "ajuz": "إِن لَم يُفَكِّر بِالعَفاءِ"
    },
    {
      "n": 28,
      "sadr": "سَيَضيقُ مُتَّسَعُ المَلا",
      "ajuz": "بِالمُخرَجينَ مِنَ المَلاءِ"
    },
    {
      "n": 29,
      "sadr": "فَارغَب لِرَبِّكَ في الجَدا",
      "ajuz": "ما أَنتَ عَنهُ ذو جَداءِ"
    },
    {
      "n": 30,
      "sadr": "توصي وَعَقلُكَ في بَدا",
      "ajuz": "فَلِذاكَ رَأيُكَ في بَداءِ"
    },
    {
      "n": 31,
      "sadr": "وَكَأَنَّما ريحُ الصَّبا",
      "ajuz": "تَجري لِطُلّابِ الصَّباءِ"
    },
    {
      "n": 32,
      "sadr": "باعوا التَّيَقُّظَ بِالكَرى",
      "ajuz": "فَعُقولُهُم بِذُرى كَراءِ"
    },
    {
      "n": 33,
      "sadr": "وَكَأَنَّهُم مَعزُ الأَبا",
      "ajuz": "أَو كَالحُطامِ مِنَ الأَباءِ"
    },
    {
      "n": 34,
      "sadr": "كَم مِن عِظامٍ بِاللِّوى",
      "ajuz": "قَد فارَقَت خَفقَ اللِّواءِ"
    },
    {
      "n": 35,
      "sadr": "وَأَرى الغِنى يَدعو الغَني",
      "ajuz": "يَ إِلى المَلاهي وَالغِناءِ"
    },
    {
      "n": 36,
      "sadr": "يَمضي الإِنا بَعدَ الإِنا",
      "ajuz": "وَمُناهُ في ماءِ الإِناءِ"
    },
    {
      "n": 37,
      "sadr": "وَلَرُبَّما فَضَحَ الرِّجا",
      "ajuz": "لَ ذَوي اللِّحى كَشفُ اللِّحاءِ"
    },
    {
      "n": 38,
      "sadr": "وَلَرُبَّما صادَ العِدا",
      "ajuz": "ذا السَّبقِ في صَيدِ العِداءِ"
    },
    {
      "n": 39,
      "sadr": "وَلَرُبَّ مَهجورِ البِنى",
      "ajuz": "بَعدَ التَّأَنُّقِ في البِناءِ"
    },
    {
      "n": 40,
      "sadr": "وَسَيَستَوي أَهلُ الكِبى",
      "ajuz": "وَذَوو التَّعَطُّرِ بِالكِباءِ"
    },
    {
      "n": 41,
      "sadr": "وَلَرُبَّ ماءٍ ذي رِوىً",
      "ajuz": "يُحتاجُ فيهِ إِلى الرِّواءِ"
    },
    {
      "n": 42,
      "sadr": "وَأَرى البِلى يُبلي الجَدي",
      "ajuz": "دَ وَكُلُّ شَيءٍ لِلبَلاءِ"
    },
    {
      "n": 43,
      "sadr": "كَم مِن إِنا يُفني اللَّيا",
      "ajuz": "لي ثُمَّ تَفنى بِالأَناءِ"
    },
    {
      "n": 44,
      "sadr": "وَأَرى القِرى ما لا يَدو",
      "ajuz": "مُ مَعَ الزَّمانِ لِذي قَراءِ"
    },
    {
      "n": 45,
      "sadr": "وَسِوى الفَتى يَرِثُ الفَتى",
      "ajuz": "وَلَيُنزَعَنَّ مِنَ السَّواءِ"
    },
    {
      "n": 46,
      "sadr": "حُبُّ الفَسادِ إِلى قِلىً",
      "ajuz": "وَأَرى الصَّلاحَ بِلا قَلاءِ"
    },
    {
      "n": 47,
      "sadr": "ماءُ الحَياةِ رِوىً وَأَن",
      "ajuz": "نى لِلمُحَلَّإِ بِالرَّواءِ"
    },
    {
      "n": 48,
      "sadr": "كَم مِن إِيا شَمسٍ رَأَي",
      "ajuz": "تَ وَلا تَرى مِثلَ الأَياءِ"
    },
    {
      "n": 49,
      "sadr": "تَهوى لُقى ما لا يَحِل",
      "ajuz": "لُ وَبَعدَهُ يَومُ اللِّقاءِ"
    },
    {
      "n": 50,
      "sadr": "فَسَكَنتَ بَيتاً ذا غَمى",
      "ajuz": "وَلَتَخرُجَنَّ مِنَ الغِماءِ"
    },
    {
      "n": 51,
      "sadr": "فَانظُر لِسَهمِكَ في غَراً",
      "ajuz": "لا تَستَقيمُ بِلا غِراءِ"
    },
    {
      "n": 52,
      "sadr": "وَاحذَر صَلى نارِ الجَحي",
      "ajuz": "مِ فَإِنَّهُ شَرُّ الصِّلاءِ"
    },
    {
      "n": 53,
      "sadr": "فَجَرى الشَّبابِ يَزولُ عَن",
      "ajuz": "كَ وَقَلَّ ما أَغنى الجِراءِ"
    },
    {
      "n": 54,
      "sadr": "وَأَرى الفَدى لا يُستَطا",
      "ajuz": "عُ فَمَن لِنَفسِكَ بِالفِداءِ"
    },
    {
      "n": 55,
      "sadr": "كَم قَد وَرَدتَ إِلى أَضا",
      "ajuz": "وَصَدَرتَ عَن ذاكَ الإِضاءِ"
    },
    {
      "n": 56,
      "sadr": "وَأَراكَ تَنظُرُ في السَّحى",
      "ajuz": "لا خَيرَ في نَظَرِ السِّحاءِ"
    },
    {
      "n": 57,
      "sadr": "شَمسُ الضُّحى طَلَعَت عَلَي",
      "ajuz": "كَ وَلا تَرى شَمسَ الضَّحاءِ"
    },
    {
      "n": 58,
      "sadr": "وَلَرُبَّما بَطَلَت رُؤى",
      "ajuz": "ذي مَنظَرٍ حَسَنِ الرُّواءِ"
    }
  ]
}
