{
  "id": "li-ghazzata-mudma-damatin",
  "poet": "ihab-al-shabatat",
  "title": "لِغَزَّةَ مُدمى دَمعَةٍ في المَآقي",
  "meter": "tawil",
  "rawiy": "ق",
  "abyat_in_full": 20,
  "added": "2026-11-19",
  "abyat": [
    {"n": 1, "sadr": "لِغَزَّةَ مُدمى دَمعَةٍ في المَآقي", "ajuz": "وَما الطِّبُّ كاوٍ ما الشُّيوخُ رَواقِ"},
    {"n": 2, "sadr": "تَسيلُ إِذا ماتَت بِغَزَّةَ طِفلَةٌ", "ajuz": "أَبوها رَآها في أَخيرِ رِماقِ"},
    {"n": 3, "sadr": "تَسيلُ إِذا أُمٌّ بِغَزَّةَ بُعثِرَت", "ajuz": "وَطِفلٌ يَلُمُّ الأُمَّ بَعضَ بَواقِ"},
    {"n": 4, "sadr": "وَصَوتُ نَحيبِ الطِّفلِ مِلءَ مَسامِعي", "ajuz": "يَهُزُّ مِنَ العَلياءِ سَبعَ طِباقِ"},
    {"n": 5, "sadr": "وَشَقَّ فُؤادي حَملُ أُمٍّ لِطِفلِها", "ajuz": "وَقَد عَلِمَت أَن لا قَريبَ تَلاقِ"},
    {"n": 6, "sadr": "خَليلَيَّ لَم تَعدِل بِعَيني مَلامَةٌ", "ajuz": "فَلَم تَشتَهي دَمعاً وَلا دَمَ ساقِ"},
    {"n": 7, "sadr": "لَقَد كُنتُ بِكرَ العَينِ حَتّى تَوافَدَت", "ajuz": "مَآسٍ عَرايا في مَضيقِ زُقاقِ"},
    {"n": 8, "sadr": "وَما كَفَّها زَجري لَها وَتَمَنُّعي", "ajuz": "لِدَيدَنِ إِغواءٍ بِبَدءِ عِناقِ"},
    {"n": 9, "sadr": "فَعَيني غَصيبُ الدَّمعِ كُلَّ سُوَيعَةٍ", "ajuz": "وَلَم تَفدِها روحي بِفَكِّ وِثاقي"},
    {"n": 10, "sadr": "وَطارَ مِنَ القَلبِ التَّعيسِ سَعيدُهُ", "ajuz": "وَبانَ مِنَ الغِربانِ شَرُّ نُعاقِ"},
    {"n": 11, "sadr": "فَوَاللَّهِ لَولا اللَّهُ نَفسي تَحايَلَت", "ajuz": "وَصُنتُ حِمى عَيني بِقَطعِ تَراقِ"},
    {"n": 12, "sadr": "خَليلَيَّ إِن تُشفِق عَلَيَّ حُشاشَتي", "ajuz": "فَهَل لِدِما أَطفالِ غَزَّةَ واقِ"},
    {"n": 13, "sadr": "وَإِن تَمسَحا عَيني خَليلَيَّ دَمعَةً", "ajuz": "فَمَن ذا لِأَيتامٍ بِغَيرِ رِفاقِ"},
    {"n": 14, "sadr": "خَليلَيَّ إِن غَصَّت بِصَدري هَباءَةٌ", "ajuz": "فَكَيفَ لِمَخدوجٍ بِضيقِ خِناقِ"},
    {"n": 15, "sadr": "خَليلَيَّ بانَ اليَومَ سُخفُ تَجَلُّدي", "ajuz": "فَما جُبِلَت طيني بِغَيرِ رِقاقِ"},
    {"n": 16, "sadr": "وَإِن غَرُبَت ناساً طِباعُ مَشاعِري", "ajuz": "فَفي عالَمِ العُشّاقِ شَمسُ حِداقِ"},
    {"n": 17, "sadr": "وَإِن لَم يَبِن حيناً أَصيلُ سَجِيَّةٍ", "ajuz": "فَقَد لا يُرى بَدرٌ بِوَقتِ مُحاقِ"},
    {"n": 18, "sadr": "أَلا إِنَّ مِن قَهرِ الرِّجالِ صَبابَتي", "ajuz": "وَما خِلتُ أَبياتي تَرومُ فِراقي"},
    {"n": 19, "sadr": "وَكُنتُ عَزيزَ السِّرِّ حَتّى تَمَرَّدَت", "ajuz": "تَسيرُ بِذَيعِ الدَّمعِ سَيرَ سِباقِ"},
    {"n": 20, "sadr": "تَسيرُ ثِقالَ الحِملِ بَعدَ حَنينِها", "ajuz": "لِغَزَّةَ قَد حَنَّت حَنينَ نِياقِ"}
  ]
}
