{
  "id": "man-sarrahu-al-mawtu",
  "poet": "hassan-ibn-thabit",
  "title": "مَن سَرَّهُ المَوتُ صِرفاً لا مِزاجَ لَهُ",
  "meter": "basit",
  "rawiy": "ن",
  "abyat_in_full": 10,
  "added": "2026-11-24",
  "abyat": [
    {"n": 1, "sadr": "مَن سَرَّهُ المَوتُ صِرفاً لا مِزاجَ لَهُ", "ajuz": "فَليَأتِ مَأسَدَةً في دارِ عُثمانا"},
    {"n": 2, "sadr": "مُستَحقِبي حَلَقِ الماذِيِّ قَد شَفَعَت", "ajuz": "فَوقَ المَخاطِمِ بيضاً زانَ أَبدانا"},
    {"n": 3, "sadr": "بَل لَيتَ شِعري وَلَيتَ الطَّيرَ تُخبِرُني", "ajuz": "ما كانَ شَأنُ عَلِيٍّ وَابنِ عَفّانا"},
    {"n": 4, "sadr": "ضَحَّوا بِأَشمَطَ عُنوانُ السُّجودِ بِهِ", "ajuz": "يُقَطِّعُ اللَّيلَ تَسبيحاً وَقُرآنا"},
    {"n": 5, "sadr": "لَتَسمَعُنَّ وَشيكاً في دِيارِكُمُ", "ajuz": "اللَّهُ أَكبَرُ يا ثاراتِ عُثمانا"},
    {"n": 6, "sadr": "وَقَد رَضيتُ بِأَهلِ الشّامِ زافِرَةً", "ajuz": "وَبِالأَميرِ وَبِالإِخوانِ إِخوانا"},
    {"n": 7, "sadr": "إِنّي لَمِنهُم وَإِن غابوا وَإِن شَهِدوا", "ajuz": "حَتّى المَماتِ وَما سُمّيتُ حَسّانا"},
    {"n": 8, "sadr": "وَيهاً فِدىً لَكُمُ أُمّي وَما وَلَدَت", "ajuz": "قَد يَنفَعُ الصَّبرُ في المَكروهِ أَحيانا"},
    {"n": 9, "sadr": "شُدّوا السُّيوفَ بِثِنيٍ في مَناطِقِكُم", "ajuz": "حَتّى يَحينَ بِها في المَوتِ مَن حانا"},
    {"n": 10, "sadr": "لَعَلَّكُم أَن تَرَوا يَوماً بِمَغبَطَةٍ", "ajuz": "خَليفَةَ اللَّهِ فيكُم كَالَّذي كانا"}
  ]
}
