{
  "id": "ala-qul-li-sinhaja",
  "poet": "abu-ishaq-al-ilbiri",
  "title": "أَلا قُل لِصِنهاجَةٍ أَجمَعين",
  "meter": "mutaqarib",
  "themes": ["politics", "hija"],
  "rawiy": "ن",
  "abyat_in_full": 47,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "أَلا قُل لِصِنهاجَةٍ أَجمَعين", "ajuz": "بُدورِ النَّدِيِّ وَأُسدِ العَرين" },
    { "n": 2,  "sadr": "لَقَد زَلَّ سَيِّدُكُم زَلَّةً", "ajuz": "تَقِرُّ بِها أَعيُنُ الشّامِتين" },
    { "n": 3,  "sadr": "تَخَيَّرَ كاتِبَهُ كافِراً", "ajuz": "وَلَو شاءَ كانَ مِنَ المُسلِمين" },
    { "n": 4,  "sadr": "فَعَزَّ اليَهودُ بِهِ وَانتَخَوا", "ajuz": "وَتاهوا وَكانوا مِنَ الأَرذَلين" },
    { "n": 5,  "sadr": "وَنالوا مُناهُم وَجازوا المَدى", "ajuz": "فَحانَ الهَلاكُ وَما يَشعُرون" },
    { "n": 6,  "sadr": "فَكَم مُسلِمٍ فاضِلٍ قانِتٍ", "ajuz": "لِأَرذَلِ قِردٍ مِنَ المُشرِكين" },
    { "n": 7,  "sadr": "وَما كانَ ذَلِكَ مِن سَعيِهِم", "ajuz": "وَلَكِنَّ مِنّا يَقومُ المُعين" },
    { "n": 8,  "sadr": "فَهَلّا اِقتَدى فيهِمُ بِالأُلى", "ajuz": "مِنَ القادَةِ الخيرَةِ المُتَّقين" },
    { "n": 9,  "sadr": "وَأَنزَلَهُم حَيثُ يَستاهِلون", "ajuz": "وَرَدَّهُمُ أَسفَلَ السّافِلين" },
    { "n": 10, "sadr": "وَطافوا لَدَينا بِأَخراجِهِم", "ajuz": "عَلَيهِم صَغارٌ وَذُلٌّ وَهون" },
    { "n": 11, "sadr": "وَقَمّوا المَزابِلَ عَن خِرقَةٍ", "ajuz": "مُلَوَّنَةٍ لِدِثارِ الدَّفين" },
    { "n": 12, "sadr": "وَلَم يَستَخِفّوا بِأَعلامِنا", "ajuz": "وَلَم يَستَطيلوا عَلى الصّالِحين" },
    { "n": 13, "sadr": "وَلا جالَسوهُم وَهُم هُجنَةٌ", "ajuz": "وَلا واكَبوهُم مَعَ الأَقرَبين" },
    { "n": 14, "sadr": "أَباديسُ أَنتَ اِمرُؤٌ حاذِقٌ", "ajuz": "تُصيبُ بِظَنِّكَ نَفسَ اليَقين" },
    { "n": 15, "sadr": "فَكَيفَ اِختَفَت عَنكَ أَعيانُهُم", "ajuz": "وَفي الأَرضِ تُضرَبُ مِنها القُرون" },
    { "n": 16, "sadr": "وَكَيفَ تُحِبُّ فِراخَ الزِّنا", "ajuz": "وَهُم بَغَّضوكَ إِلى العالَمين" },
    { "n": 17, "sadr": "وَكَيفَ يَتِمُّ لَكَ المُرتَقى", "ajuz": "إِذا كُنتَ تَبني وَهُم يَهدِمون" },
    { "n": 18, "sadr": "وَكَيفَ اِستَنَمتَ إِلى فاسِقٍ", "ajuz": "وَقارَنتَهُ وَهوَ بِئسَ القَرين" },
    { "n": 19, "sadr": "وَقَد أَنزَلَ اللَّهُ في وَحيِهِ", "ajuz": "يُحَذِّرُ عَن صُحبَةِ الفاسِقين" },
    { "n": 20, "sadr": "فَلا تَتَّخِذ مِنهُمُ خادِماً", "ajuz": "وَذَرهُم إِلى لَعنَةِ اللّاعِنين" },
    { "n": 21, "sadr": "فَقَد ضَجَّتِ الأَرضُ مِن فِسقِهِم", "ajuz": "وَكادَت تَميدُ بِنا أَجمَعين" },
    { "n": 22, "sadr": "تَأَمَّل بِعَينَيكَ أَقطارَها", "ajuz": "تَجِدهُم كِلاباً بِها خاسِئين" },
    { "n": 23, "sadr": "وَكَيفَ اِنفَرَدتَ بِتَقريبِهِم", "ajuz": "وَهُم في البِلادِ مِنَ المُبعَدين" },
    { "n": 24, "sadr": "عَلى أَنَّكَ المَلِكُ المُرتَضى", "ajuz": "سَليلُ المُلوكِ مِنَ الماجِدين" },
    { "n": 25, "sadr": "وَأَنَّ لَكَ السَّبقَ بَينَ الوَرى", "ajuz": "كَما أَنتَ مِن جِلَّةِ السّابِقين" },
    { "n": 26, "sadr": "وَإِنّي اِحتَلَلتُ بِغَرناطَةٍ", "ajuz": "فَكُنتُ أَراهُم بِها عابِثين" },
    { "n": 27, "sadr": "وَقَد قَسَّموها وَأَعمالَها", "ajuz": "فَمِنهُم بِكُلِّ مَكانٍ لَعين" },
    { "n": 28, "sadr": "وَهُم يَقبِضونَ جِباياتِها", "ajuz": "وَهُم يَخضِمونَ وَهُم يَقضِمون" },
    { "n": 29, "sadr": "وَهُم يَلبَسونَ رَفيعَ الكُسا", "ajuz": "وَأَنتُم لِأَوضَعِها لابِسون" },
    { "n": 30, "sadr": "وَهُم أُمَناكُم عَلى سِرِّكُم", "ajuz": "وَكَيفَ يَكونُ خَؤونٌ أَمين" },
    { "n": 31, "sadr": "وَيَأكُلُ غَيرُهُمُ دِرهَماً", "ajuz": "فَيُقصى وَيُدنَونَ إِذ يَأكُلون" },
    { "n": 32, "sadr": "وَقَد ناهَضوكُم إِلى رَبِّكُم", "ajuz": "فَما تَمنَعونَ وَلا تُنكِرون" },
    { "n": 33, "sadr": "وَقَد لابَسوكُم بِأَسحارِهِم", "ajuz": "فَما تَسمَعونَ وَلا تُبصِرون" },
    { "n": 34, "sadr": "وَهُم يَذبَحونَ بِأَسواقِها", "ajuz": "وَأَنتُم لِأَطرافِها آكِلون" },
    { "n": 35, "sadr": "وَرَخَّمَ قِردُهُمُ دارَهُ", "ajuz": "وَأَجرى إِلَيها نَميرَ العُيون" },
    { "n": 36, "sadr": "فَصارَت حَوائِجُنا عِندَهُ", "ajuz": "وَنَحنُ عَلى بابِهِ قائِمون" },
    { "n": 37, "sadr": "وَيَضحَكُ مِنّا وَمِن دينِنا", "ajuz": "فَإِنّا إِلى رَبِّنا راجِعون" },
    { "n": 38, "sadr": "وَلَو قُلتَ في مالِهِ إِنَّهُ", "ajuz": "كَمالِكَ كُنتَ مِنَ الصّادِقين" },
    { "n": 39, "sadr": "فَبادِر إِلى ذَبحِهِ قُربَةً", "ajuz": "وَضَحِّ بِهِ فَهوَ كَبشٌ سَمين" },
    { "n": 40, "sadr": "وَلا تَرفَعِ الضَّغطَ عَن رَهطِهِ", "ajuz": "فَقَد كَنَزوا كُلَّ عِلقٍ ثَمين" },
    { "n": 41, "sadr": "وَفَرِّق عِداهُم وَخُذ مالَهُم", "ajuz": "فَأَنتَ أَحَقُّ بِما يَجمَعون" },
    { "n": 42, "sadr": "وَلا تَحسَبَن قَتلَهُم غَدرَةً", "ajuz": "بَلِ الغَدرُ في تَركِهِم يَعبَثون" },
    { "n": 43, "sadr": "وَقَد نَكَثوا عَهدَنا عِندَهُم", "ajuz": "فَكَيفَ تُلامُ عَلى النّاكِثين" },
    { "n": 44, "sadr": "وَكَيفَ تَكونُ لَهُم ذِمَّةٌ", "ajuz": "وَنَحنُ خُمولٌ وَهُم ظاهِرون" },
    { "n": 45, "sadr": "وَنَحنُ الأَذِلَّةُ مِن بَينِهِم", "ajuz": "كَأَنّا أَسَأنا وَهُم مُحسِنون" },
    { "n": 46, "sadr": "فَلا تَرضَ فينا بِأَفعالِهِم", "ajuz": "فَأَنتَ رَهينٌ بِما يَفعَلون" },
    { "n": 47, "sadr": "وَراقِب إِلَهَكَ في حِزبِهِ", "ajuz": "فَحِزبُ الإِلَهِ هُمُ الغالِبون" }
  ]
}
