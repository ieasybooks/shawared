{
  "id": "la-talum-qalban",
  "poet": "ihab-al-shabatat",
  "title": "لا تَلُم قَلباً رَقَّ أَو سيقَ رِقّا",
  "meter": "khafif",
  "themes": ["watani", "ritha"],
  "rawiy": "ق",
  "abyat_in_full": 61,
  "added": "2026-11-19",
  "abyat": [
    {"n": 1, "sadr": "لا تَلُم قَلباً رَقَّ أَو سيقَ رِقّا", "ajuz": "روحُهُ شاهَدَت وَشَمَّت دِمَشقا"},
    {"n": 2, "sadr": "لِمَ لَم تَعذِل مَن سِواهُ وَكُلٌّ", "ajuz": "قَد لَقوا قَبلَهُ كَما صارَ يَلقى"},
    {"n": 3, "sadr": "ما مَضَت عَنها قَطُّ نَفسٌ وَإِلّا", "ajuz": "جيدُها يَزهو بِالصَّبابَةِ طَوقا"},
    {"n": 4, "sadr": "فَعَلامَ المَلامُ لَو يَنتَشي في", "ajuz": "قَيدِ شامٍ لا يَرتَضي عَنهُ عِتقا"},
    {"n": 5, "sadr": "مَألَفُ الإِنسِ أَصلُهُ في دِمَشقٍ", "ajuz": "وَفُروعٌ تَلوحُ غَرباً وَشَرقا"},
    {"n": 6, "sadr": "ياسَميناً تَفوحُ وَالعِشقُ يَروي", "ajuz": "ريقَها دَلّاً صُبَّ زِقّاً فَزِقّا"},
    {"n": 7, "sadr": "قَبَّلَ الصُّبحُ ثَغرَها إِن عَلاهُ", "ajuz": "قاسَمَ اللَّيلَ فيهِ شِدقاً فَشِدقا"},
    {"n": 8, "sadr": "وَلَنا مِنهُما دُجىً وَضِياءٌ", "ajuz": "كَعَشيقَينِ لا يُطيقانِ فِرقا"},
    {"n": 9, "sadr": "فَلَقَ اللَّهُ الصُّبحَ لِليَومِ أَمراً", "ajuz": "وَقَضاها عَن ساحِرِ الشَّرقِ فَرقا"},
    {"n": 10, "sadr": "وَحَضاراتٍ قَد تَوالَت عَلَيها", "ajuz": "كَتَوالي غَيمٍ عَلى صَفوِ مَسقى"},
    {"n": 11, "sadr": "وَكَأَنَّ الزَّمانَ مِن عاشِقيها", "ajuz": "تَكبَرُ الدُّنيا وَهيَ تَثبُتُ رَوقا"},
    {"n": 12, "sadr": "في صِباها وَإِن تَشِب بِلَيالٍ", "ajuz": "أَمرُ رَبّي قَد يُرجِعُ التَّحتَ فَوقا"},
    {"n": 13, "sadr": "إِن رَثاها قَومٌ بِلاهِبِ قَولٍ", "ajuz": "خَرَجَت مِن رَمادِهِ كَالعَنقا"},
    {"n": 14, "sadr": "وَسُيوفٍ تَدَمشَقَت لِصَفا اِسمٍ", "ajuz": "لا تُبالي إِن زادَ ناراً وَطَرقا"},
    {"n": 15, "sadr": "وَهيَ لِلسَّيفِ أَهلُ قافِيَةٍ إِن", "ajuz": "حَنَّ وافى الهَوى مِنَ الغِمدِ مَشقا"},
    {"n": 16, "sadr": "وَدِمَشقٌ عُنقودُ دالِيَةٍ أَح", "ajuz": "مِلُهُ في قَلبي وَأَسكَرُ شَوقا"},
    {"n": 17, "sadr": "أَو بُشَيرى حَمامَةٍ بَعدَ غَيبٍ", "ajuz": "بِجَناحَيها فَجرُ مَن عاشَ غَسقا"},
    {"n": 18, "sadr": "كِبرِياءُ الزَّبّاءِ في مَفرِقَيها", "ajuz": "وَدِماءُ السّاروتِ توهِجُ أُفُقا"},
    {"n": 19, "sadr": "لَهفَ نَفسي عَلى زُهورِ شَبابٍ", "ajuz": "شَمَّها المَوتُ لَيتَهُ عَفَّ نَشقا"},
    {"n": 20, "sadr": "صَبرَ وَجدي إِذ يَقطِفُ المَوتُ روحاً", "ajuz": "بَعدَ روحٍ رَحيقُها سالَ دَفقا"},
    {"n": 21, "sadr": "ما اِقشَعَرَّت نَفسي بِريحِ زُهورٍ", "ajuz": "بِسِوى فَقدِكُم أَشُمُّ فَأَشقى"},
    {"n": 22, "sadr": "وَكَأَنّي لَمّا أَشُمُّ زُهوراً", "ajuz": "أُمُّ مَشنوقٍ إِن تَرَ الحَبلَ حَدقا"},
    {"n": 23, "sadr": "وَبَدا المَجدُ نَحلَةً صَوبَكُم تَع", "ajuz": "لو وَتَرقَونَ في السَّماءِ فَتَرقى"},
    {"n": 24, "sadr": "كانَ يَكفيهِ نَومُهُ في قُبورٍ", "ajuz": "وَسِعَتكُم فَكَيفَ تَزويهِ ضَيقا"},
    {"n": 25, "sadr": "فَسَلامُ اللَّهِ الرَّحيمِ بِصَحبٍ", "ajuz": "وَالأُلى مِن أَسمى المَلائِكِ رِفقا"},
    {"n": 26, "sadr": "وَجَزاكُم لُقيا جِنانٍ مَطيباً", "ajuz": "حينَ كُنتُم أَطايِبَ النّاسِ عِذقا"},
    {"n": 27, "sadr": "لَيتَني مَع أَرواحِكُم في جِنانٍ", "ajuz": "كَحَمامٍ في دَوحَةٍ تَحتَ وَرقا"},
    {"n": 28, "sadr": "لَم تَكُن كَفُّ المُجرِمينَ بِبَسطٍ", "ajuz": "وَأَكُفُّ النِّفاقِ تَقبِضُ صَفقا"},
    {"n": 29, "sadr": "فَغَداً كَفُّ اللَّهِ حُكمُ أَكُفٍّ", "ajuz": "وَكَأَنَّ العُيونَ لَم تَرَ بَوقا"},
    {"n": 30, "sadr": "هَذِهِ دَمعٌ في العُيونِ مَكينٌ", "ajuz": "غَيرَ أَنَّ اللِّسانَ مِنها اِستَسقى"},
    {"n": 31, "sadr": "وَكَأَنَّ العُيونَ غَيمُ سَماءٍ", "ajuz": "وَتُغيثُ اللِّسانَ إِن جَفَّ وَدقا"},
    {"n": 32, "sadr": "رُبَّما النَّفسُ نَفسُها بابُ بابٍ", "ajuz": "لِجِدارٍ ظَلَّت تُحاوِلُ خَرقا"},
    {"n": 33, "sadr": "وَدَخَلتُ الأَبوابَ سَبعاً دِمَشقاً", "ajuz": "حامِداً بِالسَّبعِ المَثاني لِمَلقى"},
    {"n": 34, "sadr": "فَتَحَت بَعدَها مِنَ الشِّعرِ باباً", "ajuz": "وَأَرَتني الظِّباءَ تَدفَعُ غَلقا"},
    {"n": 35, "sadr": "فَابتَدَرتُ السَّهمَ القَويمَ مُصيباً", "ajuz": "ما يُطيبُ الآذانَ رَهفاً وَذَوقا"},
    {"n": 36, "sadr": "أَخَليلَيَّ عَجِّلا بِمَسيري", "ajuz": "فَفُؤادُ المَشوقِ أَعجَلُ سَوقا"},
    {"n": 37, "sadr": "خَطوُ ساقي لِنَظمِ قَلبي مُواتٍ", "ajuz": "وَكَأَنَّ الفُؤادَ يوزِنُ خَفقا"},
    {"n": 38, "sadr": "لا كَأَقمارِ القيمَرِيَّةِ بَدرٌ", "ajuz": "أَسِوى الشّامِ تَلمَحُ البَدرَ صِدقا"},
    {"n": 39, "sadr": "وَبِسيماهُم أَهلُها عُرِفوا أَب", "ajuz": "هى وُجوهاً وَأَجمَلَ القَومِ نُطقا"},
    {"n": 40, "sadr": "نَظَرُ العَينِ يَستَثيرُكَ رَأياً", "ajuz": "وَرُؤى الرّوحِ تَستَبينُكَ حَقّا"},
    {"n": 41, "sadr": "فَهَوى القَلبِ لِلجُسومِ لَنَزوٌ", "ajuz": "وَهَواهُ القُلوبَ أَبيَنُ عِشقا"},
    {"n": 42, "sadr": "وَعَلِقتُ الشَّآمَ داراً وَأَهلاً", "ajuz": "حوتَ ماءٍ بِغَيرِهِ ماتَ خَنقا"},
    {"n": 43, "sadr": "ضَيفُهُم ظَنَّهُم بِغِلمانِ خُلدٍ", "ajuz": "وَالعِدى خالَتهُم مِنَ الجِنِّ زُرقا"},
    {"n": 44, "sadr": "كِبرُ إِبليسَ كِبرُهُم عَن مَخازٍ", "ajuz": "وَبِساحِ الوَغى يُسابِقُ بَرقا"},
    {"n": 45, "sadr": "أَفَلَستُم مَن إِن فَسَدتُم نَبِيٌّ", "ajuz": "قالَ لا خَيرٌ بَعدَها عادَ خَلقا"},
    {"n": 46, "sadr": "لَيتَ شِعري لِزائِرٍ وَمَزورٍ", "ajuz": "هَل ذَوى غُصنٌ جَذرُهُ غارَ عُمقا"},
    {"n": 47, "sadr": "ما ضَمَمتُ الفَيحاءَ إِلّا غَشَتني", "ajuz": "بِنَسيمِ الأُردُنِّ نَسقاً وَطِبقا"},
    {"n": 48, "sadr": "وَجِفانُ العُيونِ مَلأى بِدَمعٍ", "ajuz": "لِجُوَيراتٍ مِتنَ نَأياً وَحَرقا"},
    {"n": 49, "sadr": "فَشَكَرتُ النَّعماءَ نُعمى دِمَشقٍ", "ajuz": "أَوَبَعدَ الحُرِّيَّةِ اليَومَ رِزقا"},
    {"n": 50, "sadr": "لا أَرى الرّوسَ راسِياً رَوسُها أَو", "ajuz": "أَسمَعُ الفُرسَ تُتبِعُ اللَّطمَ نَهقا"},
    {"n": 51, "sadr": "لا يُلامُ السِّنانُ روماً وَفُرساً", "ajuz": "وَأَسُنُّ العُربِ الجَميعُ بِفَرقا"},
    {"n": 52, "sadr": "رُبَّ بَومٍ مَضَت وَأَبقَت فِراخاً", "ajuz": "ذاعَ عيدٌ فَعايَدوا النّاسَ نَعقا"},
    {"n": 53, "sadr": "ما عَلَيها لَو أَنَّها سَكَتَت إِن", "ajuz": "زَغرَدَت سُعدى في الزِّيارَةِ رَمقا"},
    {"n": 54, "sadr": "لَدِيارٌ أُمَيَّةٌ أَهلُها أَم", "ajuz": "تَنُ عُرواتٍ بِالعُروبَةِ وُثقى"},
    {"n": 55, "sadr": "مَن يُسَوّي مَن أَرضَعَت حاقِداً مَع", "ajuz": "مَن يَداها لَفَّت مِنَ الجودِ عُنقا"},
    {"n": 56, "sadr": "وَأَيادي أُمَيَّةٍ دونَ سَيفٍ", "ajuz": "أَوشَكَت أَن تَشُقَّ بِالحَربِ حَلقا"},
    {"n": 57, "sadr": "وَالعُلا مَع أُمَيَّةٍ كانَتا رَت", "ajuz": "قاً وَلَم يَقضِ فيهِما الرَّبُّ فَتقا"},
    {"n": 58, "sadr": "مَن رَمى في أُمَيَّةٍ بِدَنايا", "ajuz": "أَرجَعَت صَوبَ رَأسِهِ القَوسُ حُمقا"},
    {"n": 59, "sadr": "بَيَّضَ اللَّهُ عَينَ مَن أَنكَرَت مَن", "ajuz": "مَدَّ رُقعَ الخَضراءِ وَحداً وَغَمقا"},
    {"n": 60, "sadr": "مِن دِمَشقٍ راياتُها حَمَلَت أَن", "ajuz": "دَلُساً شِقَّ المَشرِقَينِ اِستَشَقّا"},
    {"n": 61, "sadr": "سَيَرى المَشرِقانِ أَنَّ دِمَشقاً", "ajuz": "خَيرُهُم أَرضاً فَوقَها الخَيرُ عِرقا"}
  ]
}
