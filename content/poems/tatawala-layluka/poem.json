{
  "id": "tatawala-layluka",
  "poet": "imru-al-qays",
  "title": "تَطاوَلَ لَيلُكَ بِالأَثمُدِ",
  "meter": "mutaqarib",
  "rawiy": "د",
  "abyat_in_full": 16,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "تَطاوَلَ لَيلُكَ بِالأَثمُدِ", "ajuz": "وَنامَ الخَلِيُّ وَلَم تَرقُدِ" },
    { "n": 2,  "sadr": "وَباتَ وَباتَت لَهُ لَيلَةٌ", "ajuz": "كَلَيلَةِ ذي العائِرِ الأَرمَدِ" },
    { "n": 3,  "sadr": "وَذَلِكَ مِن نَبَأٍ جاءَني", "ajuz": "وَخُبِّرتُهُ عَن أَبي الأَسوَدِ" },
    { "n": 4,  "sadr": "وَلَو عَن نَثا غَيرِهِ جاءَني", "ajuz": "وَجُرحُ اللِّسانِ كَجُرحِ اليَدِ" },
    { "n": 5,  "sadr": "لَقُلتُ مِنَ القَولِ ما لا يَزا", "ajuz": "لُ يُؤثَرُ عَنّي يَدَ المُسنَدِ" },
    { "n": 6,  "sadr": "بِأَيِّ عَلاقَتِنا تَرغَبونَ", "ajuz": "أَعَن دَمِ عَمرٍو عَلى مَرثَدِ" },
    { "n": 7,  "sadr": "فَإِن تَدفِنوا الدّاءَ لا نَخفِهِ", "ajuz": "وَإِن تَبعَثوا الحَربَ لا نَقعُدِ" },
    { "n": 8,  "sadr": "وَإِن تَقتُلونا نُقَتِّلكُمُ", "ajuz": "وَإِن تَقصِدوا لِدَمٍ نَقصِدِ" },
    { "n": 9,  "sadr": "مَتى عَهدُنا بِطِعانِ الكُما", "ajuz": "ةِ وَالحَمدِ وَالمَجدِ وَالسُّؤدَدِ" },
    { "n": 10, "sadr": "وَبَنيِ القِبابِ وَمِلءِ الجِفا", "ajuz": "نِ وَالنّارِ وَالحَطَبِ المُفأَدِ" },
    { "n": 11, "sadr": "وَأَعدَدتُ لِلحَربِ وَثّابَةً", "ajuz": "جَوادَ المَحَثَّةِ وَالمَروَدِ" },
    { "n": 12, "sadr": "سَبوحاً جَموحاً وَإِحضارُها", "ajuz": "كَمَعمَعَةِ السَّعَفِ الموقَدِ" },
    { "n": 13, "sadr": "وَمَشدودَةَ السَّكِّ مَوضونَةً", "ajuz": "تَضاءَلُ في الطَّيِّ كَالمِبرَدِ" },
    { "n": 14, "sadr": "تَفيضُ عَلى المَرءِ أَردانُها", "ajuz": "كَفَيضِ الأَتِيِّ عَلى الجَدجَدِ" },
    { "n": 15, "sadr": "وَمُطَّرِداً كَرِشاءِ الجَرو", "ajuz": "رِ مِن خُلُبِ النَّخلَةِ الأَجرَدِ" },
    { "n": 16, "sadr": "وَذا شُطَبٍ غامِضاً كَلمُهُ", "ajuz": "إِذا صابَ بِالعَظمِ لَم يَنأَدِ" }
  ]
}
