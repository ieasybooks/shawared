{
  "id": "daw-al-wushata",
  "poet": "baha-al-din-zuhayr",
  "title": "دَعوا الوُشاةَ وَما قالوا وَما نَقَلوا",
  "meter": "basit",
  "themes": ["ghazal", "hikma"],
  "rawiy": "ل",
  "abyat_in_full": 32,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1,  "sadr": "دَعوا الوُشاةَ وَما قالوا وَما نَقَلوا", "ajuz": "بَيني وَبَينَكُمُ ما لَيسَ يَنفَصِلُ" },
    { "n": 2,  "sadr": "لَكُم سَرائِرُ في قَلبي مُخَبَّأَةٌ", "ajuz": "لا الكُتبُ تَنفَعُني فيها وَلا الرُّسُلُ" },
    { "n": 3,  "sadr": "رَسائِلُ الشَّوقِ عِندي لَو بَعَثتُ بِها", "ajuz": "إِلَيكُمُ لَم تَسَعها الطُّرقُ وَالسُّبُلُ" },
    { "n": 4,  "sadr": "أُمسي وَأُصبِحُ وَالأَشواقُ تَلعَبُ بي", "ajuz": "كَأَنَّما أَنا مِنها شارِبٌ ثَمِلُ" },
    { "n": 5,  "sadr": "وَأَستَلِذُّ نَسيماً مِن دِيارِكُمُ", "ajuz": "كَأَنَّ أَنفاسَهُ مِن نَشرِكُم قُبَلُ" },
    { "n": 6,  "sadr": "وَكَم أُحَمِّلُ قَلبي في مَحَبَّتِكُم", "ajuz": "ما لَيسَ يَحمِلُهُ قَلبٌ فَيَحتَمِلُ" },
    { "n": 7,  "sadr": "وَكَم أُصَبِّرُهُ عَنكُم وَأَعذِلُهُ", "ajuz": "وَلَيسَ يَنفَعُ عِندَ العاشِقِ العَذَلُ" },
    { "n": 8,  "sadr": "وا رَحمَتاهُ لِصَبٍّ قَلَّ ناصِرُهُ", "ajuz": "فيكُم وَضاقَ عَلَيهِ السَّهلُ وَالجَبَلُ" },
    { "n": 9,  "sadr": "قَضِيَّتي في الهَوى وَاللَّهِ مُشكِلَةٌ", "ajuz": "ما القَولُ ما الرَّأيُ ما التَّدبيرُ ما العَمَلُ" },
    { "n": 10, "sadr": "يَزدادُ شِعرِيَ حُسناً حينَ أَذكُرُكُم", "ajuz": "إِنَّ المَليحَةَ فيها يَحسُنُ الغَزَلُ" },
    { "n": 11, "sadr": "يا غائِبينَ وَفي قَلبي أُشاهِدُهُم", "ajuz": "وَكُلَّما اِنفَصَلوا عَن ناظِري اِتَّصَلوا" },
    { "n": 12, "sadr": "قَد جَدَّدَ البُعدُ قُرباً في الفُؤادِ لَهُم", "ajuz": "حَتّى كَأَنَّهُمُ يَومَ النَّوى وَصَلوا" },
    { "n": 13, "sadr": "أَنا الوَفِيُّ لِأَحبابي وَإِن غَدَروا", "ajuz": "أَنا المُقيمُ عَلى عَهدي وَإِن رَحَلوا" },
    { "n": 14, "sadr": "أَنا المُحِبُّ الَّذي ما الغَدرُ مِن شِيَمي", "ajuz": "هَيهاتَ خُلقِيَ عَنهُ لَستُ أَنتَقِلُ" },
    { "n": 15, "sadr": "فَيا رَسولي إِلى مَن لا أَبوحُ بِهِ", "ajuz": "إِنَّ المُهِمّاتِ فيها يُعرَفُ الرَّجُلُ" },
    { "n": 16, "sadr": "بَلِّغ سَلامي وَبالِغ في الخِطابِ لَهُ", "ajuz": "وَقَبِّلِ الأَرضَ عَنّي عِندَما تَصِلُ" },
    { "n": 17, "sadr": "بِاللَّهِ عَرِّفهُ حالي إِن خَلَوتَ بِهِ", "ajuz": "وَلا تُطِل فَحَبيبي عِندَهُ مَلَلُ" },
    { "n": 18, "sadr": "وَتِلكَ أَعظَمُ حاجاتي إِلَيكَ فَإِن", "ajuz": "تَنجَح فَما خابَ فيكَ القَصدُ وَالأَمَلُ" },
    { "n": 19, "sadr": "وَلَم أَزَل في أُموري كُلَّما عَرَضَت", "ajuz": "عَلى اِهتِمامِكَ بَعدَ اللَّهِ أَتَّكِلُ" },
    { "n": 20, "sadr": "وَلَيسَ عِندَكَ في أَمرٍ تُحاوِلُهُ", "ajuz": "وَالحَمدُ لِلَّهِ لا عَجزٌ وَلا كَسَلُ" },
    { "n": 21, "sadr": "فَالنّاسُ بِالنّاسِ وَالدُّنيا مُكافَأَةٌ", "ajuz": "وَالخَيرُ يُذكَرُ وَالأَخبارُ تَنتَقِلُ" },
    { "n": 22, "sadr": "وَالمَرءُ يَحتالُ إِن عَزَّت مَطالِبُهُ", "ajuz": "وَرُبَّما نَفَعَت أَربابَها الحِيَلُ" },
    { "n": 23, "sadr": "يا مَن كَلامي لَهُ إِن كانَ يَسمَعُهُ", "ajuz": "يَجِد كَلاماً عَلى ما شاءَ يَشتَمِلُ" },
    { "n": 24, "sadr": "تَغَزُّلاً تَخلُبُ الأَلبابَ رِقَّتُهُ", "ajuz": "مَضمونُهُ حِكمَةٌ غَرّاءُ أَو مَثَلُ" },
    { "n": 25, "sadr": "إِنَّ المَليحَةَ تُغنيها مَلاحَتُها", "ajuz": "لا سِيَّما وَعَلَيها الحَليُ وَالحُلَلُ" },
    { "n": 26, "sadr": "دَعِ التَّوانِيَ في أَمرٍ تَهُمُّ بِهِ", "ajuz": "فَإِنَّ صَرفَ اللَّيالي سابِقٌ عَجِلُ" },
    { "n": 27, "sadr": "ضَيَّعتَ عُمرَكَ فَاحزَن إِن فَطِنتَ لَهُ", "ajuz": "فَالعُمرُ لا عِوَضٌ عَنهُ وَلا بَدَلُ" },
    { "n": 28, "sadr": "سابِق زَمانَكَ خَوفاً مِن تَقَلُّبِهِ", "ajuz": "فَكَم تَقَلَّبَتِ الأَيّامُ وَالدُّوَلُ" },
    { "n": 29, "sadr": "وَاعزِم مَتى شِئتَ فَالأَوقاتُ واحِدَةٌ", "ajuz": "لا الرَّيثُ يَدفَعُ مَقدوراً وَلا العَجَلُ" },
    { "n": 30, "sadr": "لا تَرقُبِ النَّجمَ في أَمرٍ تُحاوِلُهُ", "ajuz": "فَاللَّهُ يَفعَلُ لا جَديٌ وَلا حَمَلُ" },
    { "n": 31, "sadr": "مَعَ السَّعادَةِ ما لِلنَّجمِ مِن أَثَرٍ", "ajuz": "فَلا يَغُرُّكَ مِرّيخٌ وَلا زُحَلُ" },
    { "n": 32, "sadr": "الأَمرُ أَعظَمُ وَالأَفكارُ حائِرَةٌ", "ajuz": "وَالشَّرعُ يَصدُقُ وَالإِنسانُ يَمتَثِلُ" }
  ]
}
