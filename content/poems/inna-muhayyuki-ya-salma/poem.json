{
  "id": "inna-muhayyuki-ya-salma",
  "poet": "bashama-ibn-hazn",
  "title": "إِنّا مُحَيّوكِ يا سَلمى فَحَيّينا",
  "meter": "basit",
  "themes": ["fakhr", "hamasa"],
  "rawiy": "ن",
  "abyat_in_full": 12,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1,  "sadr": "إِنّا مُحَيّوكِ يا سَلمى فَحَيّينا", "ajuz": "وَإِن سَقَيتِ كِرامَ النّاسِ فَاسقينا" },
    { "n": 2,  "sadr": "وَإِن دَعَوتِ إِلى جُلّى وَمَكرُمَةٍ", "ajuz": "يَوماً سَراةَ كِرامِ النّاسِ فَادعينا" },
    { "n": 3,  "sadr": "إِنّا بَني نَهشَلٍ لا نَدَّعي لِأَبٍ", "ajuz": "عَنهُ وَلا هُوَ بِالأَبناءِ يَشرينا" },
    { "n": 4,  "sadr": "إِن تُبتَدَر غايَةٌ يَوماً لِمَكرُمَةٍ", "ajuz": "تَلقَ السَّوابِقَ مِنّا وَالمُصَلّينا" },
    { "n": 5,  "sadr": "وَلَيسَ يَهلِكُ مِنّا سَيِّدٌ أَبَداً", "ajuz": "إِلّا اِفتَلَينا غُلاماً سَيِّداً فينا" },
    { "n": 6,  "sadr": "إِنّا لَنُرخِصُ يَومَ الرَّوعِ أَنفُسَنا", "ajuz": "وَلَو نُسامُ بِها في الأَمنِ أُغلينا" },
    { "n": 7,  "sadr": "بيضٌ مَفارِقُنا تَغلي مَراجِلُنا", "ajuz": "نَأسو بِأَموالِنا آثارَ أَيدينا" },
    { "n": 8,  "sadr": "لَو كانَ في الأَلفِ مِنّا واحِدٌ فَدَعَوا", "ajuz": "مَن فارِسٌ خالَهُم إِيّاهُ يَعنونا" },
    { "n": 9,  "sadr": "إِذا الكُماةُ تَنَحَّوا أَن يُصيبَهُمُ", "ajuz": "حَدُّ الظُّباتِ وَصَلناها بِأَيدينا" },
    { "n": 10, "sadr": "وَلا تَراهُم وَإِن جَلَّت مُصيبَتُهُم", "ajuz": "مَعَ البُكاةِ عَلى مَن ماتَ يَبكونا" },
    { "n": 11, "sadr": "وَنَركَبُ الكُرهَ أَحياناً فَيَفرُجُهُ", "ajuz": "عَنّا الحِفاظُ وَأَسيافٌ تُواتينا" }
  ]
}
