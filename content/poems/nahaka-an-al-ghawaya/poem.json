{
  "id": "nahaka-an-al-ghawaya",
  "poet": "baha-al-din-zuhayr",
  "title": "نَهاكَ عَنِ الغَوايَةِ ما نَهاكا",
  "meter": "wafir",
  "themes": ["ritha"],
  "rawiy": "ك",
  "abyat_in_full": 32,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "نَهاكَ عَنِ الغَوايَةِ ما نَهاكا", "ajuz": "وَذُقتَ مِنَ الصَّبابَةِ ما كَفاكا" },
    { "n": 2,  "sadr": "وَطالَ سُراكَ في لَيلِ التَّصابي", "ajuz": "وَقَد أَصبَحتَ لَم تَحمَد سُراكا" },
    { "n": 3,  "sadr": "فَلا تَجزَع لِحادِثَةِ اللَّيالي", "ajuz": "وَقُل لي إِن جَزِعتَ فَما عَساكا" },
    { "n": 4,  "sadr": "وَكَيفَ تَلومُ حادِثَةً وَفيها", "ajuz": "تَبَيَّنَ مَن أَحَبَّكَ أَو قَلاكا" },
    { "n": 5,  "sadr": "بِروحي مَن تَذوبُ عَلَيهِ روحي", "ajuz": "وَذُق يا قَلبُ ما صَنَعَت يَداكا" },
    { "n": 6,  "sadr": "لَعَمري كُنتَ عَن هَذا غَنِيّاً", "ajuz": "وَلَم تَعرِف ضَلالَكَ مِن هُداكا" },
    { "n": 7,  "sadr": "ضَنيتُ مِنَ الهَوى وَشَقيتُ مِنهُ", "ajuz": "وَأَنتَ تُجيبُ كُلَّ هَوىً دَعاكا" },
    { "n": 8,  "sadr": "فَدَع يا قَلبُ ما قَد كُنتَ فيهِ", "ajuz": "أَلَستَ تَرى حَبيبَكَ قَد جَفاكا" },
    { "n": 9,  "sadr": "لَقَد بَلَغَت بِهِ روحي التَّراقي", "ajuz": "وَقَد نَظَرَت بِهِ عَيني الهَلاكا" },
    { "n": 10, "sadr": "فَيا مَن غابَ عَنّي وَهوَ روحي", "ajuz": "وَكَيفَ أُطيقُ مِن روحي اِنفِكاكا" },
    { "n": 11, "sadr": "حَبيبي كَيفَ حَتّى غِبتَ عَنّي", "ajuz": "أَتَعلَمُ أَنَّ لي أَحَداً سِواكا" },
    { "n": 12, "sadr": "أَراكَ هَجَرتَني هَجراً طَويلاً", "ajuz": "وَما عَوَّدتَني مِن قَبلُ ذاكا" },
    { "n": 13, "sadr": "عَهِدتُكَ لا تُطيقُ الصَّبرَ عَنّي", "ajuz": "وَتَعصي في وِدادي مَن نَهاكا" },
    { "n": 14, "sadr": "فَكَيفَ تَغَيَّرَت تِلكَ السَّجايا", "ajuz": "وَمَن هَذا الَّذي عَنّي ثَناكا" },
    { "n": 15, "sadr": "فَلا وَاللَّهِ ما حاوَلتَ عُذراً", "ajuz": "فَكُلُّ النّاسِ يُعذَرُ ما خَلاكا" },
    { "n": 16, "sadr": "وَما فارَقتَني طَوعاً وَلَكِن", "ajuz": "دَهاكَ مِنَ المَنِيَّةِ ما دَهاكا" },
    { "n": 17, "sadr": "فَلَيتَكَ لَو بَقيتَ لِضُعفِ حالي", "ajuz": "وَكانَ النّاسُ كُلُّهُمُ فِداكا" },
    { "n": 18, "sadr": "يَعِزُّ عَلَيَّ حينَ أُديرُ عَيني", "ajuz": "أُفَتِّشُ عَن مَكانِكَ لا أَراكا" },
    { "n": 19, "sadr": "وَلَم أَرَ في سِواكَ وَلا أَراهُ", "ajuz": "شَمائِلَكَ المَليحَةَ أَو حُلاكا" },
    { "n": 20, "sadr": "خَتَمتُ عَلى وِدادِكَ في ضَميري", "ajuz": "وَلَيسَ يَزالُ مَختوماً هُناكا" },
    { "n": 21, "sadr": "فَوا أَسَفي لِجِسمِكَ كَيفَ يَبلى", "ajuz": "وَيَذهَبُ بَعدَ بَهجَتِهِ سَناكا" },
    { "n": 22, "sadr": "وَما لي أَدَّعي أَنّي وَفِيٌّ", "ajuz": "وَلَستُ مُشارِكاً لَكَ في بَلاكا" },
    { "n": 23, "sadr": "تَموتُ وَما أَموتُ عَلَيكَ حُزناً", "ajuz": "وَحَقِّ اللَّهِ خُنتُكَ في هَواكا" },
    { "n": 24, "sadr": "وَيا خَجَلي إِذا قالوا مُحِبٌّ", "ajuz": "وَلَم أَنفَعكَ في خَطبٍ أَتاكا" },
    { "n": 25, "sadr": "أَرى الباكينَ فيكَ مَعي كَثيراً", "ajuz": "وَلَيسَ كَمَن بَكى مَن قَد تَباكى" },
    { "n": 26, "sadr": "فَيا مَن قَد نَوى سَفَراً بَعيداً", "ajuz": "مَتى قُل لي رُجوعُكَ مِن نَواكا" },
    { "n": 27, "sadr": "جَزاكَ اللَّهُ عَنّي كُلَّ خَيرٍ", "ajuz": "وَأَعلَمُ أَنَّهُ عَنّي جَزاكا" },
    { "n": 28, "sadr": "فَيا قَبرَ الحَبيبِ وَدِدتُ أَنّي", "ajuz": "حَمَلتُ وَلَو عَلى عَيني ثَراكا" },
    { "n": 29, "sadr": "سَقاكَ الغَيثُ هَتّاناً وَإِلّا", "ajuz": "فَحَسبُكَ مِن دُموعي ما سَقاكا" },
    { "n": 30, "sadr": "وَلا زالَ السَّلامُ عَلَيكَ مِنّي", "ajuz": "يَرِفُّ مَعَ النَّسيمِ عَلى ذُراكا" }
  ]
}
