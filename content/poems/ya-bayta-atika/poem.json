{
  "id": "ya-bayta-atika",
  "poet": "al-ahwas",
  "title": "يا بَيتَ عاتِكَةَ الَّذي أَتَعَزَّلُ",
  "meter": "kamil",
  "themes": ["madh", "itab"],
  "rawiy": "ل",
  "abyat_in_full": 45,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "يا بَيتَ عاتِكَةَ الَّذي أَتَعَزَّلُ", "ajuz": "حَذَرَ العِدى وَبِهِ الفُؤادُ مُوَكَّلُ" },
    { "n": 2,  "sadr": "أَصبَحتُ أَمنَحُكَ الصُّدودَ وَإِنَّني", "ajuz": "قَسَماً إِلَيكَ مَعَ الصُّدودِ لَأَميَلُ" },
    { "n": 3,  "sadr": "وَلَقَد نَزَلتَ مِنَ الفُؤادِ بِمَنزِلٍ", "ajuz": "ما كانَ غَيرُكَ فيهِ يَوماً يَنزِلُ" },
    { "n": 4,  "sadr": "وَلَقَد شَكَوتُ إِلَيكَ بَعضَ صَبابَتي", "ajuz": "وَلَما كَتَمتُ مِنَ الصَّبابَةِ أَطوَلُ" },
    { "n": 5,  "sadr": "فَصَدَدتُ عَنكَ وَما صَدَدتُ لِبِغضَةٍ", "ajuz": "أَخشى مَقالَةَ كاشِحٍ لا يَعقِلُ" },
    { "n": 6,  "sadr": "هَل عَيشُنا بِكَ في زَمانِكَ راجِعٌ", "ajuz": "فَلَقَد تَقاعَسَ بَعدَكَ المُتَعَلِّلُ" },
    { "n": 7,  "sadr": "إِنّي إِذا قُلتُ اِستَقامَ يَحُطُّهُ", "ajuz": "خُلفٌ كَما نَظَرَ الخِلافَ الأَقبَلُ" },
    { "n": 8,  "sadr": "لَو بِالَّذي عالَجتُ لينَ فُؤادِهِ", "ajuz": "فَأَبى يَلينُ بِهِ لَلانَ الجَندَلُ" },
    { "n": 9,  "sadr": "وَتَجَنُّبي بَيتَ الحَبيبِ أَوَدُّهُ", "ajuz": "أُرضي البَغيضَ بِهِ حَديثٌ مُعضِلُ" },
    { "n": 10, "sadr": "وَلَئِن صَدَدتُ لَأَنتَ لَولا رِقبَتي", "ajuz": "أَهوى مِنَ اللّائي أَزورُ وَأَدخُلُ" },
    { "n": 11, "sadr": "إِنَّ الشَّبابَ وَعَيشَنا اللَّذَّ الَّذي", "ajuz": "كُنّا بِهِ زَمَناً نُسَرُّ وَنَجذَلُ" },
    { "n": 12, "sadr": "ذَهَبَت بَشاشَتُهُ وَأَصبَحَ ذِكرُهُ", "ajuz": "حَزَناً يُعَلُّ بِهِ الفُؤادُ وَيُنهَلُ" },
    { "n": 13, "sadr": "إِلّا تَذَكُّرَ ما مَضى وَصَبابَةً", "ajuz": "مُنِيَت لِقَلبِ مُتَيَّمٍ لا يَذهَلُ" },
    { "n": 14, "sadr": "أَودى الشَّبابُ وَأَخلَقَت لَذّاتُهُ", "ajuz": "وَأَنا الحَزينُ عَلى الشَّبابِ المُعوِلُ" },
    { "n": 15, "sadr": "يَبكي لِما قَلَبَ الزَّمانُ جَديدَهُ", "ajuz": "خَلَقاً وَلَيسَ عَلى الزَّمانِ مُعَوَّلُ" },
    { "n": 16, "sadr": "وَالرَّأسُ شامِلُهُ البَياضُ كَأَنَّهُ", "ajuz": "بَعدَ السَّوادِ بِهِ الثَّغامُ المُحوِلُ" },
    { "n": 17, "sadr": "وَسَفيهَةٍ هَبَّت عَلَيَّ بِسُحرَةٍ", "ajuz": "جَهلاً تَلومُ عَلى الثَّواءِ وَتَعذِلُ" },
    { "n": 18, "sadr": "فَأَجَبتُها أَن قُلتُ لَستِ مُطاعَةً", "ajuz": "فَذَري تَنَصُّحَكِ الَّذي لا يُقبَلُ" },
    { "n": 19, "sadr": "إِنّي كَفانِيَ أَن أُعالِجَ رِحلَةً", "ajuz": "عُمَرٌ وَنَبوَةَ مَن يَضَنُّ وَيَبخَلُ" },
    { "n": 20, "sadr": "بِنَوالِ ذي فَجَرٍ تَكونُ سِجالُهُ", "ajuz": "عَمَماً إِذا نَزَلَ الزَّمانُ المُمحِلُ" },
    { "n": 21, "sadr": "ماضٍ عَلى حَدَثِ الأُمورِ كَأَنَّهُ", "ajuz": "ذو رَونَقٍ عَضبٌ جَلاهُ الصَّيقَلُ" },
    { "n": 22, "sadr": "تُبدي الرِّجالُ إِذا بَدا إِعظامَهُ", "ajuz": "حَذَرَ البُغاثِ هَوى لَهُنَّ الأَجدَلُ" },
    { "n": 23, "sadr": "فَيَرَونَ أَنَّ لَهُ عَلَيهِم سَورَةً", "ajuz": "وَفَضيلَةً سَبَقَت لَهُ لا تُجهَلُ" },
    { "n": 24, "sadr": "مُتَحَمِّلٌ ثِقَلَ الأُمورِ حَوى لَهُ", "ajuz": "سَبقَ المَكارِمِ سابِقٌ مُتَمَهِّلُ" },
    { "n": 25, "sadr": "وَلَهُ إِذا نُسِبَت قُرَيشٌ مِنهُمُ", "ajuz": "مَجدُ الأَرومَةِ وَالفَعالُ الأَفضَلُ" },
    { "n": 26, "sadr": "وَلَقَد بَدَأتُ أُريدُ وُدَّ مَعاشِرٍ", "ajuz": "وَعَدوا مَواعِدَ أُخلِفَت إِذ حُصِّلوا" },
    { "n": 27, "sadr": "حَتّى إِذا رَجَعَ اليَقينُ مَطامِعي", "ajuz": "يَأساً وَأَخلَفَني الَّذينَ أُؤَمِّلُ" },
    { "n": 28, "sadr": "زايَلتُ ما صَنَعوا إِلَيكَ بِرِحلَةٍ", "ajuz": "عَجلى وَعِندَكَ عَنهُمُ مُتَحَوَّلُ" },
    { "n": 29, "sadr": "وَوَعَدتَني في حاجَتي فَصَدَقتَني", "ajuz": "وَوَفَيتَ إِذ كَذَبوا الحَديثَ وَبَدَّلوا" },
    { "n": 30, "sadr": "فَلَأَشكُرَنَّ لَكَ الَّذي أَولَيتَني", "ajuz": "شُكراً تَحُلُّ بِهِ المَطِيُّ وَتَرحَلُ" },
    { "n": 31, "sadr": "مِدَحاً تَكونُ لَكُم غَرائِبُ شِعرِها", "ajuz": "مَبذولَةً وَلِغَيرِكُم لا تُبذَلُ" },
    { "n": 32, "sadr": "فَإِذا تَنَخَّلتُ القَريضَ فَإِنَّهُ", "ajuz": "لَكُمُ يَكونُ خِيارُ ما أَتَنَخَّلُ" },
    { "n": 33, "sadr": "أُثني عَلَيكُم ما بَقيتُ فَإِن أَمُت", "ajuz": "تَخلُد غَرائِبُها لَكُم تُتَمَثَّلُ" },
    { "n": 34, "sadr": "وَلَعَمرُ مَن حَجَّ الحَجيجُ لِبَيتِهِ", "ajuz": "تَهوي بِهِم قُلُصُ المَطِيِّ الذُّمَّلُ" },
    { "n": 35, "sadr": "إِنَّ اِمرَأً قَد نالَ مِنكَ قَرابَةً", "ajuz": "يَبغي مَنافِعَ غَيرِها لَمُضَلَّلُ" },
    { "n": 36, "sadr": "تَعفو إِذا جَهِلوا بِحِلمِكَ عَنهُمُ", "ajuz": "وَتُنيلُ إِن طَلَبوا النَّوالَ فَتُجزِلُ" },
    { "n": 37, "sadr": "وَتَكونُ مَعقِلَهُم إِذا لَم يُنجِهِم", "ajuz": "مِن شَرِّ ما يَخشَونَ إِلّا المَعقِلُ" },
    { "n": 38, "sadr": "حَتّى كَأَنَّكَ يُتَّقى بِكَ دونَهُم", "ajuz": "مِن أُسدِ بيشَةَ خادِرٌ مُتَبَسِّلُ" },
    { "n": 39, "sadr": "وَأَراكَ تَفعَلُ ما تَقولُ وَبَعضُهُم", "ajuz": "مَذِقُ اللِّسانِ يَقولُ ما لا يَفعَلُ" }
  ]
}
