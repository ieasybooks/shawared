{
  "id": "nuniyyat-al-busti",
  "poet": "abu-al-fath-al-busti",
  "title": "نونِيَّةُ البُستِيِّ",
  "meter": "basit",
  "rawiy": "ن",
  "abyat_in_full": 63,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "زِيادَةُ المَرءِ في دُنياهُ نُقصانُ", "ajuz": "وَرِبحُهُ غَيرَ مَحضِ الخَيرِ خُسرانُ" },
    { "n": 2,  "sadr": "وَكُلُّ وِجدانِ حَظٍّ لا ثَباتَ لَهُ", "ajuz": "فَإِنَّ مَعناهُ في التَّحقيقِ فِقدانُ" },
    { "n": 3,  "sadr": "يا عامِراً لِخَرابِ الدّارِ مُجتَهِداً", "ajuz": "بِاللَّهِ هَل لِخَرابِ العُمرِ عُمرانُ" },
    { "n": 4,  "sadr": "وَيا حَريصاً عَلى الأَموالِ تَجمَعُها", "ajuz": "أُنسيتَ أَنَّ سُرورَ المالِ أَحزانُ" },
    { "n": 5,  "sadr": "زَعِ الفُؤادَ عَنِ الدُّنيا وَزينَتِها", "ajuz": "فَصَفوُها كَدَرٌ وَالوَصلُ هِجرانُ" },
    { "n": 6,  "sadr": "وَأَرعِ سَمعَكَ أَمثالاً أُفَصِّلُها", "ajuz": "كَما يُفَصَّلُ ياقوتٌ وَمَرجانُ" },
    { "n": 7,  "sadr": "أَحسِن إِلى النّاسِ تَستَعبِد قُلوبَهُمُ", "ajuz": "فَطالَما اِستَعبَدَ الإِنسانَ إِحسانُ" },
    { "n": 8,  "sadr": "وَإِن أَساءَ مُسيءٌ فَليَكُن لَكَ في", "ajuz": "عُروضِ زَلَّتِهِ صَفحٌ وَغُفرانُ" },
    { "n": 9,  "sadr": "يا خادِمَ الجِسمِ كَم تَشقى بِخِدمَتِهِ", "ajuz": "أَتَطلُبُ الرِّبحَ فيما فيهِ خُسرانُ" },
    { "n": 10, "sadr": "أَقبِل عَلى النَّفسِ وَاستَكمِل فَضائِلَها", "ajuz": "فَأَنتَ بِالنَّفسِ لا بِالجِسمِ إِنسانُ" },
    { "n": 11, "sadr": "وَكُن عَلى الدَّهرِ مِعواناً لِذي أَمَلٍ", "ajuz": "يَرجو نَداكَ فَإِنَّ الحُرَّ مِعوانُ" },
    { "n": 12, "sadr": "وَاشدُد يَدَيكَ بِحَبلِ اللَّهِ مُعتَصِماً", "ajuz": "فَإِنَّهُ الرُّكنُ إِن خانَتكَ أَركانُ" },
    { "n": 13, "sadr": "مَن يَتَّقِ اللَّهَ يُحمَد في عَواقِبِهِ", "ajuz": "وَيَكفِهِ شَرَّ مَن عَزّوا وَمَن هانوا" },
    { "n": 14, "sadr": "مَنِ اِستَعانَ بِغَيرِ اللَّهِ في طَلَبٍ", "ajuz": "فَإِنَّ ناصِرَهُ عَجزٌ وَخِذلانُ" },
    { "n": 15, "sadr": "مَن كانَ لِلخَيرِ مَنّاعاً فَلَيسَ لَهُ", "ajuz": "عَلى الحَقيقَةِ إِخوانٌ وَأَخدانُ" },
    { "n": 16, "sadr": "مَن جادَ بِالمالِ مالَ النّاسُ قاطِبَةً", "ajuz": "إِلَيهِ وَالمالُ لِلإِنسانِ فَتّانُ" },
    { "n": 17, "sadr": "مَن سالَمَ النّاسَ يَسلَم مِن غَوائِلِهِم", "ajuz": "وَعاشَ وَهوَ قَريرُ العَينِ جَذلانُ" },
    { "n": 18, "sadr": "مَن كانَ لِلعَقلِ سُلطانٌ عَلَيهِ غَدا", "ajuz": "وَما عَلى نَفسِهِ لِلحِرصِ سُلطانُ" },
    { "n": 19, "sadr": "مَن مَدَّ طَرفاً لِفَرطِ الجَهلِ نَحوَ هَوىً", "ajuz": "أَغضى عَلى الحَقِّ يَوماً وَهوَ خَزيانُ" },
    { "n": 20, "sadr": "مَن عاشَرَ النّاسَ لاقى مِنهُمُ نَصَباً", "ajuz": "لِأَنَّ سوسَهُمُ بَغيٌ وَعُدوانُ" },
    { "n": 21, "sadr": "وَمَن يُفَتِّش عَنِ الإِخوانِ يَقلِهِمُ", "ajuz": "فَجُلُّ إِخوانِ هَذا العَصرِ خَوّانُ" },
    { "n": 22, "sadr": "مَنِ اِستَشارَ صُروفَ الدَّهرِ قامَ لَهُ", "ajuz": "عَلى حَقيقَةِ طَبعِ الدَّهرِ بُرهانُ" },
    { "n": 23, "sadr": "مَن يَزرَعِ الشَّرَّ يَحصُد في عَواقِبِهِ", "ajuz": "نَدامَةً وَلِحَصدِ الزَّرعِ إِبّانُ" },
    { "n": 24, "sadr": "مَنِ اِستَنامَ إِلى الأَشرارِ نامَ وَفي", "ajuz": "قَميصِهِ مِنهُمُ صِلٌّ وَثُعبانُ" },
    { "n": 25, "sadr": "كُن رَيِّقَ البِشرِ إِنَّ الحُرَّ هِمَّتُهُ", "ajuz": "صَحيفَةٌ وَعَلَيها البِشرُ عُنوانُ" },
    { "n": 26, "sadr": "وَرافِقِ الرِّفقَ في كُلِّ الأُمورِ فَلَم", "ajuz": "يَندَم رَفيقٌ وَلَم يَذمُمهُ إِنسانُ" },
    { "n": 27, "sadr": "وَلا يَغُرَّنكَ حَظٌّ جَرَّهُ خَرَقٌ", "ajuz": "فَالخُرقُ هَدمٌ وَرِفقُ المَرءِ بُنيانُ" },
    { "n": 28, "sadr": "أَحسِن إِذا كانَ إِمكانٌ وَمَقدُرَةٌ", "ajuz": "فَلَن يَدومَ عَلى الإِحسانِ إِمكانُ" },
    { "n": 29, "sadr": "فَالرَّوضُ يَزدانُ بِالأَنوارِ فاغِمَةً", "ajuz": "وَالحُرُّ بِالفَضلِ وَالإِحسانِ يَزدانُ" },
    { "n": 30, "sadr": "صُن حُرَّ وَجهِكَ لا تَهتِك غِلالَتَهُ", "ajuz": "فَكُلُّ حُرٍّ لِحُرِّ الوَجهِ صَوّانُ" },
    { "n": 31, "sadr": "فَإِن لَقيتَ عَدُوّاً فَالقَهُ أَبَداً", "ajuz": "وَالوَجهُ بِالبِشرِ وَالإِشراقِ غَضّانُ" },
    { "n": 32, "sadr": "دَعِ التَّكاسُلَ في الخَيراتِ تَطلُبُها", "ajuz": "فَلَيسَ يَسعَدُ بِالخَيراتِ كَسلانُ" },
    { "n": 33, "sadr": "لا ظِلَّ لِلمَرءِ يَعرى مِن تُقىً وَنُهىً", "ajuz": "وَإِن أَظَلَّتهُ أَوراقٌ وَأَفنانُ" },
    { "n": 34, "sadr": "وَالنّاسُ أَعوانُ مَن والَتهُ دَولَتُهُ", "ajuz": "وَهُم عَلَيهِ إِذا عادَتهُ أَعوانُ" },
    { "n": 35, "sadr": "سَحبانُ مِن غَيرِ مالٍ باقِلٌ حَصِرٌ", "ajuz": "وَباقِلٌ في ثَراءِ المالِ سَحبانُ" },
    { "n": 36, "sadr": "لا تودِعِ السِّرَّ وَشّاءً بِهِ مَذِلاً", "ajuz": "فَما رَعى غَنَماً في الدَّوِّ سِرحانُ" },
    { "n": 37, "sadr": "لا تَحسَبِ النّاسَ طَبعاً واحِداً فَلَهُم", "ajuz": "غَرائِزٌ لَستَ تُحصيها وَأَلوانُ" },
    { "n": 38, "sadr": "ما كُلُّ ماءٍ كَصَدّاءٍ لِوارِدِهِ", "ajuz": "نَعَم وَلا كُلُّ نَبتٍ فَهوَ سَعدانُ" },
    { "n": 39, "sadr": "لا تَخدِشَنَّ بِمَطلٍ وَجهَ عارِفَةٍ", "ajuz": "فَالبِرُّ يَخدِشُهُ مَطلٌ وَلَيّانُ" },
    { "n": 40, "sadr": "لا تَستَشِر غَيرَ نَدبٍ حازِمٍ يَقِظٍ", "ajuz": "قَدِ اِستَوى فيهِ إِسرارٌ وَإِعلانُ" },
    { "n": 41, "sadr": "فَلِلتَّدابيرِ فُرسانٌ إِذا رَكَضوا", "ajuz": "فيها أَبَرّوا كَما لِلحَربِ فُرسانُ" },
    { "n": 42, "sadr": "وَلِلأُمورِ مَواقيتٌ مُقَدَّرَةٌ", "ajuz": "وَكُلُّ أَمرٍ لَهُ حَدٌّ وَميزانُ" },
    { "n": 43, "sadr": "فَلا تَكُن عَجِلاً في الأَمرِ تَطلُبُهُ", "ajuz": "فَلَيسَ يُحمَدُ قَبلَ النُّضجِ بُحرانُ" },
    { "n": 44, "sadr": "كَفى مِنَ العَيشِ ما قَد سَدَّ مِن عَوَزٍ", "ajuz": "فَفيهِ لِلحُرِّ قُنيانٌ وَغُنيانُ" },
    { "n": 45, "sadr": "وَذو القَناعَةِ راضٍ مِن مَعيشَتِهِ", "ajuz": "وَصاحِبُ الحِرصِ إِن أَثرى فَغَضبانُ" },
    { "n": 46, "sadr": "حَسبُ الفَتى عَقلُهُ خِلّاً يُعاشِرُهُ", "ajuz": "إِذا تَحاماهُ إِخوانٌ وَخُلّانُ" },
    { "n": 47, "sadr": "هُما رَضيعا لِبانٍ حِكمَةٌ وَتُقىً", "ajuz": "وَساكِنا وَطَنٍ مالٌ وَطُغيانُ" },
    { "n": 48, "sadr": "إِذا نَبا بِكَريمٍ مَوطِنٌ فَلَهُ", "ajuz": "وَراءَهُ في بَسيطِ الأَرضِ أَوطانُ" },
    { "n": 49, "sadr": "يا ظالِماً فَرِحاً بِالعِزِّ ساعَدَهُ", "ajuz": "إِن كُنتَ في سِنَةٍ فَالدَّهرُ يَقظانُ" },
    { "n": 50, "sadr": "ما اِستَمرَأَ الظُّلمَ لَو أَنصَفتَ آكِلُهُ", "ajuz": "وَهَل يَلَذُّ مَذاقَ المَرءِ خُطبانُ" },
    { "n": 51, "sadr": "يا أَيُّها العالِمُ المَرضِيُّ سيرَتُهُ", "ajuz": "أَبشِر فَأَنتَ بِغَيرِ الماءِ رَيّانُ" },
    { "n": 52, "sadr": "وَيا أَخا الجَهلِ لَو أَصبَحتَ في لُجَجٍ", "ajuz": "فَأَنتَ ما بَينَها لا شَكَّ ظَمآنُ" },
    { "n": 53, "sadr": "لا تَحسَبَنَّ سُروراً دائِماً أَبَداً", "ajuz": "مَن سَرَّهُ زَمَنٌ ساءَتهُ أَزمانُ" },
    { "n": 54, "sadr": "إِذا جَفاكَ خَليلٌ كُنتَ تَألَفُهُ", "ajuz": "فَاطلُب سِواهُ فَكُلُّ النّاسِ إِخوانُ" },
    { "n": 55, "sadr": "وَإِن نَبَت بِكَ أَوطانٌ نَشَأتَ بِها", "ajuz": "فَارحَل فَكُلُّ بِلادِ اللَّهِ أَوطانُ" },
    { "n": 56, "sadr": "يا رافِلاً في الشَّبابِ الرَّحلِ مُنتَشِياً", "ajuz": "مِن كَأسِهِ هَل أَصابَ الرُّشدَ نَشوانُ" },
    { "n": 57, "sadr": "لا تَغتَرِر بِشَبابٍ رائِقٍ نَضِرٍ", "ajuz": "فَكَم تَقَدَّمَ قَبلَ الشّيبِ شُبّانُ" },
    { "n": 58, "sadr": "وَيا أَخا الشَّيبِ لَو ناصَحتَ نَفسَكَ لَم", "ajuz": "يَكُن لِمِثلِكَ في الإِسرافِ إِمعانُ" },
    { "n": 59, "sadr": "هَبِ الشَّبيبَةَ تُبدي عُذرَ صاحِبِها", "ajuz": "ما عُذرُ أَشيَبَ يَستَهويهِ شَيطانُ" },
    { "n": 60, "sadr": "كُلُّ الذُّنوبِ فَإِنَّ اللَّهَ يَغفِرُها", "ajuz": "إِن شَيَّعَ المَرءَ إِخلاصٌ وَإيمانُ" },
    { "n": 61, "sadr": "وَكُلُّ كَسرٍ فَإِنَّ الدّينَ يَجبُرُهُ", "ajuz": "وَما لِكَسرِ قَناةِ الدّينِ جُبرانُ" },
    { "n": 62, "sadr": "خُذها سَوائِرَ أَمثالٍ مُهَذَّبَةٍ", "ajuz": "فيها لِمَن يَبتَغي التِّبيانَ تِبيانُ" },
    { "n": 63, "sadr": "ما ضَرَّ حَسّانَها وَالطَّبعُ صائِغُها", "ajuz": "إِن لَم يَصُغها قَريعُ الشِّعرِ حَسّانُ" }
  ]
}
