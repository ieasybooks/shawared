{
  "id": "a-manzilatay-mayyin",
  "poet": "dhu-al-rumma",
  "title": "أَمَنزِلَتَي مَيٍّ سَلامٌ عَلَيكُما",
  "meter": "tawil",
  "rawiy": "ح",
  "abyat_in_full": 66,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَمَنزِلَتَي مَيٍّ سَلامٌ عَلَيكُما",
      "ajuz": "عَلى النَّأيِ وَالنّائي يَوَدُّ وَيَنصَحُ"
    },
    {
      "n": 2,
      "sadr": "وَلا زالَ مِن نَوءِ السِّماكِ عَلَيكُما",
      "ajuz": "وَنَوءِ الثُّرَيّا وابِلٌ مُتَبَطِّحُ"
    },
    {
      "n": 3,
      "sadr": "وَإِن كُنتُما قَد هِجتُما راجِعَ الهَوى",
      "ajuz": "لِذي الشَّوقِ حَتّى ظَلَّتِ العَينُ تَسفَحُ"
    },
    {
      "n": 4,
      "sadr": "أَجَل عَبرَةً كادَت لِعِرفانِ مَنزِلٍ",
      "ajuz": "لِمَيَّةَ لَو لَم تُسهِلِ الدَّمعَ تَذبَحُ"
    },
    {
      "n": 5,
      "sadr": "عَلى حينِ راهَقتُ الثَّلاثينَ وَارعَوَت",
      "ajuz": "لِداتي وَكادَ الحِلمُ بِالجَهلِ يَرجَحُ"
    },
    {
      "n": 6,
      "sadr": "إِذا غَيَّرَ النَّأيُ المُحِبّينَ لَم يَكَد",
      "ajuz": "رَسيسُ الهَوى مِن حُبِّ مَيَّةَ يَبرَحُ"
    },
    {
      "n": 7,
      "sadr": "فَلا القُربُ يُدني مِن هَواها مَلالَةً",
      "ajuz": "وَلا حُبُّها إِن تَنزَحِ الدّارُ يَنزَحُ"
    },
    {
      "n": 8,
      "sadr": "أَتَقرَحُ أَكبادُ المُحِبّينَ كُلِّهِم",
      "ajuz": "كَما كَبِدي مِن ذِكرِ مَيَّةَ تَقرَحُ"
    },
    {
      "n": 9,
      "sadr": "إِذا خَطَرَت مِن ذِكرِ مَيَّةَ خَطرَةٌ",
      "ajuz": "عَلى النَّفسِ كادَت في فُؤادِكَ تَجرَحُ"
    },
    {
      "n": 10,
      "sadr": "تَصَرَّفُ أَهواءُ القُلوبِ وَلا أَرى",
      "ajuz": "نَصيبَكِ مِن قَلبي لِغَيرِكِ يُمنَحُ"
    },
    {
      "n": 11,
      "sadr": "أَلَم تَعلَمي يا مَيُّ أَنّا وَبَينَنا",
      "ajuz": "فَيافٍ لِطَرفِ العَينِ فيهِنَّ مَطرَحُ"
    },
    {
      "n": 12,
      "sadr": "أُطَوِّحُ عَيني بِالفَلاةِ لَعَلَّني",
      "ajuz": "أَراكِ وَعَيني مِن هَوى الوَجدِ تَسفَحُ"
    },
    {
      "n": 13,
      "sadr": "أَنينٌ وَشَكوى بِالنَّهارِ شَديدَةٌ",
      "ajuz": "إِلَيها وَما يَأتي بِهِ اللَّيلُ أَبرَحُ"
    },
    {
      "n": 14,
      "sadr": "وَبَعضُ الهَوى بِالهَجرِ يُمحى فَيَمَّحي",
      "ajuz": "وَحُبُّكِ عِندي يَستَجِدُّ وَيَربَحُ"
    },
    {
      "n": 15,
      "sadr": "ذَكَرتُكِ إِذ مَرَّت بِنا أُمُّ شادِنٍ",
      "ajuz": "أَمامَ المَطايا تَشرَئِبُّ وَتَسنَحُ"
    },
    {
      "n": 16,
      "sadr": "مِنَ المُؤلِفاتِ الرَّملَ أَدماءُ حُرَّةٌ",
      "ajuz": "شُعاعُ الضُّحى في مَتنِها يَتَوَضَّحُ"
    },
    {
      "n": 17,
      "sadr": "تُغادِرُ بِالوَعساءِ وَعساءِ مُشرِفٍ",
      "ajuz": "طَلاً طَرفُ عَينَيها حَوالَيهِ يَلمَحُ"
    },
    {
      "n": 18,
      "sadr": "رَأَتنا كَأَنّا قاصِدونَ لِعَهدِها",
      "ajuz": "بِهِ فَهيَ تَدنو تارَةً وَتَزَحزَحُ"
    },
    {
      "n": 19,
      "sadr": "هِيَ الشِّبهُ أَعطافاً وَجيداً وَمُقلَةً",
      "ajuz": "وَمَيَّةُ أَبهى بَعدُ مِنها وَأَملَحُ"
    },
    {
      "n": 20,
      "sadr": "أَناةٌ يَطيبُ البَيتُ مِن طيبِ نَشرِها",
      "ajuz": "بُعَيدَ الكَرى زَينٌ لَهُ حينَ تُصبِحُ"
    },
    {
      "n": 21,
      "sadr": "كَأَنَّ البُرى وَالعاجَ عيجَت مُتونُهُ",
      "ajuz": "عَلى عُشَرٍ نَهّى بِهِ السَّيلَ أَبطَحُ"
    },
    {
      "n": 22,
      "sadr": "لَها كَفَلٌ كَالعانِكِ اِستَنَّ فَوقَهُ",
      "ajuz": "أَهاضيبُ لَبَّدنَ الهَذاليلَ نُضَّحُ"
    },
    {
      "n": 23,
      "sadr": "وَذو عُذَرٍ فَوقَ الذَّنوبَينِ مُسبَلٌ",
      "ajuz": "عَلى البانِ يُطوى بِالمَداري وَيُسرَحُ"
    },
    {
      "n": 24,
      "sadr": "أَسيلَةُ مُستَنِّ الدُّموعِ وَما جَرى",
      "ajuz": "عَلَيهِ المِجَنُّ الجائِلُ المُتَوَشَّحُ"
    },
    {
      "n": 25,
      "sadr": "تَرى قُرطَها في واضِحِ اللّيتِ مُشرِفاً",
      "ajuz": "عَلى هَلَكٍ في نَفنَفٍ يَتَطَوَّحُ"
    },
    {
      "n": 26,
      "sadr": "وَتَجلو بِفَرعٍ مِن أَراكٍ كَأَنَّهُ",
      "ajuz": "مِنَ العَنبَرِ الهِندِيِّ وَالمِسكِ يُصبَحُ"
    },
    {
      "n": 27,
      "sadr": "ذُرى أُقحُوانٍ واجَهَ اللَّيلَ وَارتَقى",
      "ajuz": "إِلَيهِ النَّدى مِن رامَةَ المُتَرَوِّحُ"
    },
    {
      "n": 28,
      "sadr": "هِجانَ الثَّنايا مُغرَباً لَو تَبَسَّمَت",
      "ajuz": "لِأَخرَسَ عَنهُ كادَ بِالقَولِ يُفصِحُ"
    },
    {
      "n": 29,
      "sadr": "هِيَ البُرءُ وَالأَسقامُ وَالهَمُّ ذِكرُها",
      "ajuz": "وَمَوتُ الهَوى لَولا التَّنائي المُبَرِّحُ"
    },
    {
      "n": 30,
      "sadr": "وَلَكِنَّها مَطروحَةٌ دونَ أَهلِها",
      "ajuz": "أَوارِنُ يَجرَحنَ الأَجالِدَ بُرَّحُ"
    },
    {
      "n": 31,
      "sadr": "وَمُستَشحِجاتٍ بِالفِراقِ كَأَنَّها",
      "ajuz": "مَثاكيلُ مِن صَيّابَةِ النّوبِ نُوَّحُ"
    },
    {
      "n": 32,
      "sadr": "يُحَقِّقنَ ما حاذَرتُ مِن صَرفِ نِيَّةٍ",
      "ajuz": "لِمَيَّةَ أَمسَت في عَصا البَينِ تَقدَحُ"
    },
    {
      "n": 33,
      "sadr": "بَكى زَوجُ مَيٍّ أَن أُنيخَت قَلائِصي",
      "ajuz": "إِلى بَيتِ مَيٍّ آخِرَ اللَّيلِ طُلَّحُ"
    },
    {
      "n": 34,
      "sadr": "فَمُت كَمَداً يا بَعلَ مَيٍّ فَإِنَّها",
      "ajuz": "قُلوبٌ لِمَيٍّ أُمَّنُ الغَيبِ نُصَّحُ"
    },
    {
      "n": 35,
      "sadr": "فَلَو تَرَكوها وَالخِيارَ تَخَيَّرَت",
      "ajuz": "فَما مِثلُ مَيٍّ عِندَ مِثلِكَ يَصلُحُ"
    },
    {
      "n": 36,
      "sadr": "إِذا قُلتُ تَدنو مَيَّةُ اِغبَرَّ دونَها",
      "ajuz": "فَيافٍ لِطَرفِ العَينِ فيهِنَّ مَطرَحُ"
    },
    {
      "n": 37,
      "sadr": "قَدِ اِحتَمَلَت مَيٌّ فَهاتيكَ دارُها",
      "ajuz": "بِها السُّحمُ تَردي وَالحَمامُ المُوَشَّحُ"
    },
    {
      "n": 38,
      "sadr": "وَلَمّا شَكَوتُ الحُبَّ كَيما تُثيبَني",
      "ajuz": "بِوَجدي قالَت إِنَّما أَنتَ تَمزَحُ"
    },
    {
      "n": 39,
      "sadr": "بِعاداً وَإِدلالاً عَلَيَّ وَقَد رَأَت",
      "ajuz": "ضَميرَ الهَوى قَد كادَ بِالجِسمِ يَبرَحُ"
    },
    {
      "n": 40,
      "sadr": "أَبيتُ عَلى مَيٍّ حَزيناً وَبَعلُها",
      "ajuz": "يَبيتُ عَلى مِثلِ النَّقا يَتَبَطَّحُ"
    },
    {
      "n": 41,
      "sadr": "وَهاجِرَةٍ شَهباءَ ذاتِ وَديقَةٍ",
      "ajuz": "يَكادُ الحَصى مِن حَرِّها يَتَصَيَّحُ"
    },
    {
      "n": 42,
      "sadr": "نَصَبتُ لَها وَجهي وَأَطلالَ بَعدَما",
      "ajuz": "أَزى الظِّلُّ وَاكتَنَّ الفَريدُ المُوَشَّحُ"
    },
    {
      "n": 43,
      "sadr": "لَئِن كانَتِ الدُّنيا عَلَيَّ كَما أَرى",
      "ajuz": "تَباريحَ مِن مَيٍّ فَلَلمَوتُ أَروَحُ"
    },
    {
      "n": 44,
      "sadr": "وَهاجِرَةٍ مِن دونِ مَيَّةَ لَم تَقِل",
      "ajuz": "قَلوصي بِها وَالجُندَبُ الجَونُ يَرمَحُ"
    },
    {
      "n": 45,
      "sadr": "بِتَيهاءَ مِقفارٍ يَكادُ اِرتِكاضُها",
      "ajuz": "بِآلِ الضُّحى وَالهَجرِ بِالطَّرفِ يَمصَحُ"
    },
    {
      "n": 46,
      "sadr": "كَأَنَّ الفِرِندَ المَحضَ مَعصوبَةٌ بِهِ",
      "ajuz": "ذُرى قورِها يَنقَدُّ عَنها وَيُنصَحُ"
    },
    {
      "n": 47,
      "sadr": "إِذا جَعَلَ الحِرباءُ مِمّا أَصابَهُ",
      "ajuz": "مِنَ الحَرِّ يَلوي رَأسَهُ وَيُرَنَّحُ"
    },
    {
      "n": 48,
      "sadr": "وَنَشوانَ مِن طولِ النُّعاسِ كَأَنَّهُ",
      "ajuz": "بِحَبلَينِ في مَشطونَةٍ يَتَرَجَّحُ"
    },
    {
      "n": 49,
      "sadr": "أَطَرتُ الكَرى عَنهُ وَقَد مالَ رَأسُهُ",
      "ajuz": "كَما مالَ رَشّافُ الفِضالِ المُرَنَّحُ"
    },
    {
      "n": 50,
      "sadr": "إِذا ماتَ فَوقَ الرَّحلِ أَحيَيتُ روحَهُ",
      "ajuz": "بِذِكراكِ وَالعيسُ المَراسيلُ جُنَّحُ"
    },
    {
      "n": 51,
      "sadr": "إِذا اِرفَضَّ أَطرافُ السِّياطِ وَهَلَّلَت",
      "ajuz": "جُرومُ المَطايا عَذَّبَتهُنَّ صَيدَحُ"
    },
    {
      "n": 52,
      "sadr": "لَها أُذُنٌ حَشرٌ وَذِفرى أَسيلَةٌ",
      "ajuz": "وَخَدٌّ كَمِرآةِ الغَريبَةِ أَسجَحُ"
    },
    {
      "n": 53,
      "sadr": "وَعَينا أَحَمِّ الرَّوقِ فَردٍ وَمِشفَرٌ",
      "ajuz": "كَسِبتِ اليَماني جاهِلٌ حينَ تَمرَحُ"
    },
    {
      "n": 54,
      "sadr": "وَرِجلٌ كَظِلِّ الذِّئبِ أَلحَقَ سَدوَها",
      "ajuz": "وَظيفٌ أَمَرَّتهُ عَصا السّاقِ أَروَحُ"
    },
    {
      "n": 55,
      "sadr": "وَسوجٌ إِذا اللَّيلُ الخُدارِيُّ شَقَّهُ",
      "ajuz": "عَنِ الرَّكبِ مَعروفُ السَّماوَةِ أَقرَحُ"
    },
    {
      "n": 56,
      "sadr": "إِذا قُلتُ عاجِ أَو تَغَنَّيتُ أَبرَقَت",
      "ajuz": "بِمِثلِ الخَوافي لاقِحاً أَو تَلَقَّحُ"
    },
    {
      "n": 57,
      "sadr": "تَراها وَقَد كَلَّفتُها كُلَّ شُقَّةٍ",
      "ajuz": "لِأَيدي المَهارى دونَها مُتَمَتَّحُ"
    },
    {
      "n": 58,
      "sadr": "تَموجُ ذِراعاها وَتَرمي بِجَوزِها",
      "ajuz": "حِذاراً مِنَ الإيعادِ وَالرَّأسُ مُكفَحُ"
    },
    {
      "n": 59,
      "sadr": "صُهابِيَّةٌ جَلسٌ كَأَنّي وَرَحلَها",
      "ajuz": "يَجوبُ بِنا المَوماةَ جَأبٌ مُكَدَّحُ"
    },
    {
      "n": 60,
      "sadr": "يُقَلِّبُ أَشباهاً كَأَنَّ مُتونَها",
      "ajuz": "بِمُستَرشَحِ البُهمى مِنَ الصَّخرِ صَردَحُ"
    },
    {
      "n": 61,
      "sadr": "رَعَت في فَلاةِ الأَرضِ حَتّى كَأَنَّها",
      "ajuz": "مِنَ الضُّمرِ خَطِّيٌّ مِنَ السُّمرِ مُصلَحُ"
    },
    {
      "n": 62,
      "sadr": "وَحَتّى أَتى يَومٌ يَكادُ مِنَ اللَّظى",
      "ajuz": "بِهِ التَّومُ في أُفحوصِهِ يَتَصَيَّحُ"
    },
    {
      "n": 63,
      "sadr": "فَظَلَّ يُصاديها وَظَلَّت كَأَنَّها",
      "ajuz": "عَلى هامِها سِربٌ مِنَ الطَّيرِ لُوَّحُ"
    },
    {
      "n": 64,
      "sadr": "عَلى مَرقَبٍ في ساعَةٍ ذاتِ هَبوَةٍ",
      "ajuz": "جَنادِبُها مِن شِدَّةِ الحَرِّ تَمصَحُ"
    },
    {
      "n": 65,
      "sadr": "تَرى حَيثُ تُمسي تَلعَبُ الرّيحُ بَينَها",
      "ajuz": "وَبَينَ الَّذي تَلقى بِهِ حينَ تُصبِحُ"
    },
    {
      "n": 66,
      "sadr": "كَأَنَّ مَطايانا بِكُلِّ مَفازَةٍ",
      "ajuz": "قَراقيرُ في صَحراءِ دِجلَةَ تَسبَحُ"
    }
  ]
}
