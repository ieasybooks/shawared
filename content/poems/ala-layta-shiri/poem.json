{
  "id": "ala-layta-shiri",
  "poet": "abu-qatifa",
  "title": "أَلا لَيتَ شِعري هَل تَغَيَّرَ بَعدَنا",
  "meter": "tawil",
  "rawiy": "ن",
  "abyat_in_full": 9,
  "added": "2026-11-19",
  "abyat": [
    { "n": 1, "sadr": "أَلا لَيتَ شِعري هَل تَغَيَّرَ بَعدَنا", "ajuz": "جَبوبُ المُصَلّى أَم كَعَهدي القَرائِنُ" },
    { "n": 2, "sadr": "أَمِ الدّورُ أَكنافَ البَلاطِ عَوامِرٌ", "ajuz": "كَما كُنَّ أَم هَل بِالمَدينَةِ ساكِنُ" },
    { "n": 3, "sadr": "أَحِنُّ إِلى تِلكَ البِلادِ صَبابَةً", "ajuz": "كَأَنّي أَسيرٌ في السَّلاسِلِ راهِنُ" },
    { "n": 4, "sadr": "إِذا بَرَقَت نَحوَ الحِجازِ غَمامَةٌ", "ajuz": "دَعا الشَّوقَ مِنّي بَرقُها المُتَيامِنُ" },
    { "n": 5, "sadr": "وَما أَخرَجَتنا رَغبَةٌ عَن بِلادِنا", "ajuz": "وَلَكِنَّهُ ما قَدَّرَ اللَّهُ كائِنُ" },
    { "n": 6, "sadr": "وَلَكِن دَعا لِلحَربِ داعٍ وَعاقَنا", "ajuz": "مَعائِبُ كانَت بَينَنا وَضَغائِنُ" },
    { "n": 7, "sadr": "لَعَلَّ قُرَيشاً أَن تَؤوبَ حُلومُها", "ajuz": "وَيُزجَرَ بَعدَ الشُّؤمِ طَيرٌ أَيامِنُ" },
    { "n": 8, "sadr": "وَتُطفَأَ نارُ الحَربِ بَعدَ وُقودِها", "ajuz": "وَيَرجِعَ ناءٍ في المَحَلَّةِ شاطِنُ" },
    { "n": 9, "sadr": "فَما يَستَوي مَن بِالجَزيرَةِ دارُهُ", "ajuz": "وَمَن هُوَ مَسرورٌ بِطَيبَةَ قاطِنُ" }
  ]
}
