{
  "id": "atazanu-ya-qalbu",
  "poet": "al-mutanabbi",
  "title": "أَتَظعَنُ يا قَلبُ مَع مَن ظَعَن",
  "meter": "mutaqarib",
  "themes": ["madh", "ghazal"],
  "rawiy": "ن",
  "abyat_in_full": 14,
  "added": "2026-11-19",
  "abyat": [
    { "n": 1, "sadr": "أَتَظعَنُ يا قَلبُ مَع مَن ظَعَن", "ajuz": "حَبيبَينِ أَندُبُ نَفسي إِذَن" },
    { "n": 2, "sadr": "وَلِمَ لا أُصابُ وَحَربُ البَسو", "ajuz": "سِ بَينَ جُفوني وَبَينَ الوَسَن" },
    { "n": 3, "sadr": "وَهَل أَنا بَعدَكُم عائِشٌ", "ajuz": "وَقَد بِنتَ عَنّي وَبانَ السَّكَن" },
    { "n": 4, "sadr": "فِدى ذَلِكَ الوَجهِ بَدرُ الدُّجى", "ajuz": "وَذاكَ التَّثَنّي تَثَنّي الغُصُن" },
    { "n": 5, "sadr": "فَما لِلفِراقِ وَما لِلجَميعِ", "ajuz": "وَما لِلرِّياحِ وَما لِلدِّمَن" },
    { "n": 6, "sadr": "كَأَن لَم يَكُن بَعدَ أَن كانَ لي", "ajuz": "كَما كانَ لي بَعدَ أَن لَم يَكُن" },
    { "n": 7, "sadr": "وَلَم يَسقِني الرّاحَ مَمزوجَةً", "ajuz": "بِماءِ اللِّثى لا بِماءِ المُزَن" },
    { "n": 8, "sadr": "لَها لَونُ خَدَّيهِ في كَفِّهِ", "ajuz": "وَريحُكَ يا أَحمَدَ بنَ الحَسَن" },
    { "n": 9, "sadr": "أَلَم يُلفِكَ الشَّرَفُ اليَعرُبِيُّ", "ajuz": "وَأَنتَ غَريبَةُ أَهلِ الزَّمَن" },
    { "n": 10, "sadr": "كَأَنَّ المَحاسِنَ غارَت عَلَيكَ", "ajuz": "فَسَلَّت لَدَيكَ سُيوفَ الفِتَن" },
    { "n": 11, "sadr": "لَذِكرُكَ أَطيَبُ مِن نَشرِها", "ajuz": "وَمَدحُكَ أَحلى سَماعِ الأُذُن" },
    { "n": 12, "sadr": "فَلَم يَرَكَ النّاسُ إِلّا غَنوا", "ajuz": "بِرُؤياكَ عَن قَولِ هَذا اِبنُ مَن" },
    { "n": 13, "sadr": "وَلَو قُصِدَ الطِّفلُ مِن طَيِّئٍ", "ajuz": "لَشارَكَ قاصِدَهُ في اللَّبَن" },
    { "n": 14, "sadr": "فَما البَحرُ في البَرِّ إِلّا نَداكَ", "ajuz": "وَما النّاسُ في الباسِ إِلّا اليَمَن" }
  ]
}
