{
  "id": "al-yawma-nasudu",
  "poet": "ahmad-shawqi",
  "title": "اليَومَ نَسودُ بِوادينا",
  "meter": "mutadarik",
  "themes": ["watani", "hamasa"],
  "rawiy": "ن",
  "abyat_in_full": 12,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "اليَومَ نَسودُ بِوادينا",
      "ajuz": "وَنُعيدُ مَحاسِنَ ماضينا"
    },
    {
      "n": 2,
      "sadr": "وَيُشيدُ العِزَّ بِأَيدينا",
      "ajuz": "وَطَنٌ نَفديهِ وَيَفدينا"
    },
    {
      "n": 3,
      "sadr": "وَطَنٌ بِالحَقِّ نُؤَيِّدُهُ",
      "ajuz": "وَبِعَينِ اللَّهِ نُشَيِّدُهُ"
    },
    {
      "n": 4,
      "sadr": "وَنُحَسِّنُهُ وَنُزَيِّنُهُ",
      "ajuz": "بِمَآثِرِنا وَمَساعينا"
    },
    {
      "n": 5,
      "sadr": "سِرُّ التّاريخِ وَعُنصُرُهُ",
      "ajuz": "وَسَريرُ الدَّهرِ وَمِنبَرُهُ"
    },
    {
      "n": 6,
      "sadr": "وَجِنانُ الخُلدِ وَكَوثَرُهُ",
      "ajuz": "وَكَفى الآباءُ رَياحينا"
    },
    {
      "n": 7,
      "sadr": "نَتَّخِذُ الشَّمسَ لَهُ تاجا",
      "ajuz": "وَضُحاها عَرشاً وَهّاجا"
    },
    {
      "n": 8,
      "sadr": "وَسَماءَ السُّؤدُدِ أَبراجا",
      "ajuz": "وَكَذَلِكَ كانَ أَوالينا"
    },
    {
      "n": 9,
      "sadr": "العَصرُ يَراكُم وَالأُمَمُ",
      "ajuz": "وَالكَرنَكُ يَلحَظُ وَالهَرَمُ"
    },
    {
      "n": 10,
      "sadr": "أَبَني الأَوطانِ أَلا هِمَمٌ",
      "ajuz": "كَبِناءِ الأَوَّلِ يَبنينا"
    },
    {
      "n": 11,
      "sadr": "سَعياً أَبَداً سَعياً سَعيا",
      "ajuz": "لِأَثيلِ المَجدِ وَلِلعَليا"
    },
    {
      "n": 12,
      "sadr": "وَلنَجعَل مِصرَ هِيَ الدُّنيا",
      "ajuz": "وَلنَجعَل مِصرَ هِيَ الدُّنيا"
    }
  ]
}
