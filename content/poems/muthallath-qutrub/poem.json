    { "n": 116, "sadr": "وَجيدُهُ مِنَ الطُّلى", "ajuz": "أَغيَدُ لَم يَحتَجِبِ" },
    { "n": 117, "sadr": "بِالفَتحِ أَولادُ الظِّبا", "ajuz": "وَالكَسرِ خَمرٌ شُرِبا" },
    { "n": 118, "sadr": "وَالضَّمِّ جيدٌ ضُرِبا", "ajuz": "في حُسنِهِ جيدُ الظَّبي" },
    { "n": 119, "sadr": "أَتَيتُهُ وَهوَ لَقى", "ajuz": "فَبَشَّ لي عِندَ اللِّقا" },
    { "n": 120, "sadr": "وَقالَ أَطعِمني لُقى", "ajuz": "فَذاكَ أَقصى أَرَبي" },
    { "n": 121, "sadr": "بِالفَتحِ كَنسُ المَنزِلِ", "ajuz": "وَالكَسرِ لِلحَربِ قُلِ" },
    { "n": 122, "sadr": "وَالضَّمِّ ماءُ العَسَلِ", "ajuz": "عَقَّدتَهُ بِاللَّهَبِ" },
    { "n": 123, "sadr": "صاحَبَني وَهوَ رَشا", "ajuz": "كَصُحبَةِ الدَّلوِ الرِّشا" },
    { "n": 124, "sadr": "حاشاهُ مِن أَخذِ الرُّشى", "ajuz": "في الحُكمِ أَو مِن رِيَبِ" },
    { "n": 125, "sadr": "بِالفَتحِ لِلغَزالِ", "ajuz": "وَالكَسرِ لِلحِبالِ" },
    { "n": 126, "sadr": "وَالضَّمِّ بَذلُ المالِ", "ajuz": "لِلحاكِمِ المُستَكلِبِ" },
    { "n": 127, "sadr": "الرّيقُ مِنهُ كَالزَّجاج", "ajuz": "وَلَحظُهُ يَحكي الزِّجاج" },
    { "n": 128, "sadr": "وَالقَلبُ مِنهُ كَالزُّجاج", "ajuz": "وادٍ سَريعِ العَطَبِ" },
    { "n": 129, "sadr": "بِالفَتحِ لِلقَرَنفُلِ", "ajuz": "وَالكَسرِ زَجُّ الأَسَلِ" },
    { "n": 130, "sadr": "وَالضَّمِّ ذاتُ الشُّغُلِ", "ajuz": "مِنَ الزُّجاجِ الحَلَبي" },
    { "n": 131, "sadr": "لَلَدغُ أَلفِ مَنَّة", "ajuz": "وَلا اِحتِمالُ مِنَّة" },
    { "n": 132, "sadr": "مَن كانَ فيهِ مُنَّة", "ajuz": "فَليَستَرِح بِالهَرَبِ" },
    { "n": 133, "sadr": "بِفَتحِها لِلحَيَّةِ", "ajuz": "وَكَسرِها لِلهِبَةِ" },
    { "n": 134, "sadr": "وَضَمِّها لِلقُوَّةِ", "ajuz": "وَهوَ دَليلُ الغَلَبِ" },
    { "n": 135, "sadr": "فَأَمَّ قَلبي أَمَّة", "ajuz": "عِندَ زَوالِ الإِمَّة" },
    { "n": 136, "sadr": "فَاستَمِعوا يا أُمَّة", "ajuz": "بِرَبِّكُم ما حَلَّ بي" },
    { "n": 137, "sadr": "بِالفَتحِ شَجُّ الرّاسِ", "ajuz": "وَالكَسرِ ضِدُّ الباسِ" },
    { "n": 138, "sadr": "وَالضَّمِّ جَمعُ النّاسِ", "ajuz": "مِن عَجَمٍ أَو عَرَبِ" },
    { "n": 139, "sadr": "وَرَّثَ ضَعفي بِالقَرا", "ajuz": "مِنها مَعانٍ بِالقِرى" },
    { "n": 140, "sadr": "وَذاكَ في غَيرِ القُرى", "ajuz": "فَكَيفَ عِندَ العَرَبِ" },
    { "n": 141, "sadr": "بِالفَتحِ ظَهرُ الوَهدِ", "ajuz": "وَالكَسرِ طَعمُ الوَفدِ" },
    { "n": 142, "sadr": "وَالضَّمِّ جَمعُ البَلَدِ", "ajuz": "كَمَكَّةٍ أَو يَثرِبِ" },
    { "n": 143, "sadr": "مَن لي بِرَشفِ الظَّلمِ", "ajuz": "أَوِ اِصطِيادِ الظِّلمِ" },
    { "n": 144, "sadr": "ما عِندَهُ مِن ظُلمِ", "ajuz": "وَلا مَقالِ الكَذِبِ" },
    { "n": 145, "sadr": "بِالفَتحِ ما الأَسنانِ", "ajuz": "وَلِلنَّعامِ الثّاني" },
    { "n": 146, "sadr": "وَالظُّلمُ لِلإِنسانِ", "ajuz": "مَجلَبَةٌ لِلغَضَبِ" },
    { "n": 147, "sadr": "القَطرُ جودُ كَفِّهِ", "ajuz": "وَالقِطرُ سَيلُ حَتفِهِ" },
    { "n": 148, "sadr": "وَالقُطرُ ماءُ أَنفِهِ", "ajuz": "وَخَدُّهُ مِن ذَهَبِ" },
    { "n": 149, "sadr": "بِالفَتحِ غَيثٌ سُكِبا", "ajuz": "وَالكَسرِ صُفرٌ ذُوِّبا" },
    { "n": 150, "sadr": "وَالضَّمِّ عودٌ جُلِبا", "ajuz": "مِن عَدَنٍ في المَركَبِ" },
    { "n": 151, "sadr": "لَمّا رَأَيتُ دَلَّهُ", "ajuz": "وَهَجرَهُ وَمَطلَهُ" },
    { "n": 152, "sadr": "رَثَيتُ مِن حُبّي لَهُ", "ajuz": "مُثَلَّثاً لِقُطرُبِ" },
    { "n": 153, "sadr": "وَابنُ زُرَيقٍ نَظَما", "ajuz": "شَرحاً لِما تَقَدَّما" },
    { "n": 154, "sadr": "فَرُبَّما تَرَحَّما", "ajuz": "عَلَيهِ أَهلُ الأَدَبِ" },
    { "n": 155, "sadr": "أَدَّيتُ فيهِ واجِبي", "ajuz": "في خِدمَةِ المُخالِبي" },
    { "n": 156, "sadr": "أَحمَدَ ذي المَواهِبِ", "ajuz": "وَذي النِّجارِ الطَّيِّبِ" },
    { "n": 157, "sadr": "مَن جاءَهُ وَأَمَّلَه", "ajuz": "يَنالُ مِنهُ أَمَلَه" },
    { "n": 158, "sadr": "يَسعَدُ مَن قَد وَصَلَه", "ajuz": "مِن أَهلِ عِلمِ الأَدَبِ" },
    { "n": 159, "sadr": "إِمّا بِبَحثٍ بَحَثَه", "ajuz": "أَوِ اِختِراعٍ أَحدَثَه" },
    { "n": 160, "sadr": "في شَرحِ ذي المُثَلَّثَة", "ajuz": "بِنَظمِهِ المُهَذَّبِ" },
    { "n": 161, "sadr": "مُصَلِّياً مُسَلِّماً", "ajuz": "عَلى النَّبِيِّ كُلَّما" },
    { "n": 162, "sadr": "رَقرَقَ بَرقٌ أَو هَمى", "ajuz": "بِالوَدقِ مُزنُ السُّحُبِ" }
  ]
}
