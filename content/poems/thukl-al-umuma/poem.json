{
  "id": "thukl-al-umuma",
  "poet": "badawi-al-jabal",
  "title": "ثُكلُ الأُمومَةِ",
  "meter": "basit",
  "themes": ["ritha", "watani"],
  "rawiy": "د",
  "abyat_in_full": 91,
  "added": "2026-11-19",
  "abyat": [
    {"n": 1, "sadr": "ما لِلمَنِيَّةِ أَدعوها وَتَبتَعِدُ", "ajuz": "أَمَرُّ مِن كُلِّ حَتفٍ بَعضُ ما أَجِدُ"},
    {"n": 2, "sadr": "ظَمآنُ أَشهَدُ وِردَ المَوتِ عَن كَثَبٍ", "ajuz": "والوارِدونَ أَحِبّائي وَلا أَرِدُ"},
    {"n": 3, "sadr": "عَلَّلتُ بِالصَّبرِ أَحزاني فَيا لَأَسىً", "ajuz": "بِالجَمرِ مِن نَفَحاتِ الجَمرِ يَبتَرِدُ"},
    {"n": 4, "sadr": "دَعَوتُ خِدنَيَّ مِن دَمعٍ وَمِن جَلَدٍ", "ajuz": "فَأَسعَفَ الدَّمعُ لَكِن خانَني الجَلَدُ"},
    {"n": 5, "sadr": "أَصبَحتُ أَعزَلَ وَالهَيجاءُ دائِرَةٌ", "ajuz": "لا السَّيفُ رَدَّ الأَذى عَنّي وَلا الزَّرَدُ"},
    {"n": 6, "sadr": "أَرُدُّ رَشقَ الظُّبى عَن مُهجَتي بِيَدٍ", "ajuz": "وَتَمسَحُ الدَّمعَ مِن نَزفِ الجِراحِ يَدُ"},
    {"n": 7, "sadr": "وَالعَبقَرِيُّ غَريبٌ في مَواطِنِهِ", "ajuz": "يَدورُ حَيثُ يَدورُ الحِقدُ وَالحَسَدُ"},
    {"n": 8, "sadr": "وَحامِلينَ رِسالاتٍ مُقَدَّسَةً", "ajuz": "تَوَحَّدوا بِالجِهادِ السَّمحِ وَانفَرَدوا"},
    {"n": 9, "sadr": "مُشَتَّتينَ بِعَصفِ الرّيحِ لا وَطَنٌ", "ajuz": "يَلُمُّ أَشتاتَ بَلواهُم وَلا بَلَدُ"},
    {"n": 10, "sadr": "مَعارِكُ الحَقِّ مِن أَجسادِهِم مِزَقٌ", "ajuz": "عَلى ثَراها وَمِن مُرّانِهِم قِصَدُ"},
    {"n": 11, "sadr": "وَرُبَّ شاكٍ فَسادَ العَصرِ يَظلِمُهُ", "ajuz": "لَم يَفسُدِ العَصرُ لَكِن أَهلُهُ فَسَدوا"},
    {"n": 12, "sadr": "يا مُبدِعَ السِّحرِ إِلّا أَنَّهُ كَلِمٌ", "ajuz": "وَساقِيَ الرَّأيِ إِلّا أَنَّهُ شَهَدُ"},
    {"n": 13, "sadr": "يا ناقِداً حُبُّهُ يُملي فَرائِدَهُ", "ajuz": "حَتّى لَيَندى حَناناً حينَ يَنتَقِدُ"},
    {"n": 14, "sadr": "لَن يَعدَمَ القَبرُ لا رِيّاً وَلا عَبَقاً", "ajuz": "فَلي جُفونٌ نَدِيّاتٌ وَلي كَبِدُ"},
    {"n": 15, "sadr": "أَحنو عَلى دَمِكَ المَطلولِ أَلثُمُهُ", "ajuz": "أَزكى مِنَ الوَردِ ما جادَت بِهِ الوُرُدُ"},
    {"n": 16, "sadr": "دِماءُ قَلبِكَ ما مِن قَطرَةٍ نَزَفَت", "ajuz": "إِلّا تَمَنَّت سَناها نَجمَةٌ تَقِدُ"},
    {"n": 17, "sadr": "سَهِرتُ في زَحمَةِ الجُلّى وَمَزَّقَني", "ajuz": "أَنّي شَهِدتُهُمُ أَغفَوا وَما سَهِدوا"},
    {"n": 18, "sadr": "وَفي ضَنايَ وَفي أَحزانِيَ اِزدَلَفوا", "ajuz": "يُحَرِّضونَ عَلَيَّ الدَّهرَ وَاتَّحَدوا"},
    {"n": 19, "sadr": "أُمّاهُ دَمعُكِ تَبكي مِن مَواجِعِهِ", "ajuz": "شُمُّ البَواذِخِ وَالأَفلاكُ تَرتَعِدُ"},
    {"n": 20, "sadr": "أُمّاهُ لَم يَبقَ لي روحٌ فَأُغدِقَهُ", "ajuz": "عَلى أَساكِ وَلا دَمعٌ وَلا كَبِدُ"},
    {"n": 21, "sadr": "تَطوفُ عَينُكِ في الزُّوّارِ سائِلَةً", "ajuz": "عَنِ الحَبيبِ الَّذي وَلّى وَتَفتَقِدُ"},
    {"n": 22, "sadr": "أَحبابُنا في جِنانِ اللَّهِ قَد نَعِموا", "ajuz": "لَقَد شَقينا بِهِم لَكِنَّهُم سَعِدوا"},
    {"n": 23, "sadr": "أُلِمُّ بِالقَبرِ أُغليهِ وَأَلثُمُهُ", "ajuz": "وَحَولِيَ السّاخِرانِ الغَيبُ وَالأَبَدُ"},
    {"n": 24, "sadr": "أَحِبَّتي كُلَّما غامَت طُيوفُهُمُ", "ajuz": "هَتَفتُ لا تَبعُدوا عَنّي وَقَد بَعُدوا"},
    {"n": 25, "sadr": "روحُ الشَّهيدِ بِنورِ اللَّهِ ما هَمَدَت", "ajuz": "لَبِّث قَليلاً تَرَ الظُّلّامَ قَد هَمَدوا"},
    {"n": 26, "sadr": "حَربٌ عَلى الكُفرِ وَالطُّغيانِ يُضرِمُها", "ajuz": "رَأيٌ عَلى الحُجَّةِ الزَّهراءِ يَعتَمِدُ"},
    {"n": 27, "sadr": "رَمَوكَ غَدراً وَلَو صالوا مُجابَهَةً", "ajuz": "لَمَزَّقَ الصّائِدينَ الضَّيغَمُ الحَرِدُ"},
    {"n": 28, "sadr": "سِلاحُكَ النّورُ وَالإِسلامُ وَحدَهُما", "ajuz": "وَمِنهُما العَونُ عِندَ الفَتحِ وَالمَدَدُ"},
    {"n": 29, "sadr": "رِسالَةٌ مِن أَبي الزَّهراءِ خالِدَةٌ", "ajuz": "عَديدُكَ الفاتِحُ المَنصورُ وَالعُدَدُ"},
    {"n": 30, "sadr": "حَتّى إِذا اِنهَزَمَت شَتّى فُلولُهُمُ", "ajuz": "وَمَرَّغَ الجُبنَ زَهوُ الحَقِّ وَالصَّيَدُ"},
    {"n": 31, "sadr": "أَشرَفتَ وَالدَّمُ شَمسٌ راحَ يَحجُبُها", "ajuz": "بِكَفِّهِ وَيُواري وَهجَها الرَّمِدُ"},
    {"n": 32, "sadr": "لا يَخدَعَنَّكَ زَهوُ الظّالِمينَ وَإِن", "ajuz": "تاهَت عَلى الفَلَكِ الأَبراجُ وَالعَمَدُ"},
    {"n": 33, "sadr": "شَمائِلُ الصّيدِ مِن قَومي مُعَطَّرَةٌ", "ajuz": "بِمُترَفِ الحَقِّ لا غالَوا وَلا جَحَدوا"},
    {"n": 34, "sadr": "سَمحاءُ لَم تَدرِ تَهريجاً وَلا عُقَداً", "ajuz": "فَكَيفَ شَوَّهَها التَّهريجُ وَالعُقَدُ"},
    {"n": 35, "sadr": "تَنَكَّروا لِقَديمِ المَجدِ وَهوَ ضُحىً", "ajuz": "يُؤذي العُيونَ وَلا يُؤذي الضُّحى الرَّمَدُ"},
    {"n": 36, "sadr": "الهانِئونَ بِسِلمٍ لا حُماةَ لَهُ", "ajuz": "فِداءُ مَن زاحَموا الجُلّى وَمَن نَهَدوا"},
    {"n": 37, "sadr": "القُدسُ مَلحَمَةٌ مَيدانُها اِزدَحَمَت", "ajuz": "بِهِ الكُماةُ وَخَيلُ الحَقِّ تَطَّرِدُ"},
    {"n": 38, "sadr": "وَرَملُ سَيناءَ لَحدٌ هَبَّ مُنتَفِضاً", "ajuz": "بِكُلِّ مَن سَقَطوا غَدراً وَما لُحِدوا"},
    {"n": 39, "sadr": "يَصيحُ أَلفُ صَدىً في الرَّملِ مُنتَظِراً", "ajuz": "أَن يَستَثيرَ الصَّحارى فارِسٌ نَجِدُ"},
    {"n": 40, "sadr": "أَرى الأَذِلّاءَ وَالهَيجاءُ ساخِرَةٌ", "ajuz": "تَوَعَّدوا بِالوَغى لَكِنَّهُم وَعَدوا"},
    {"n": 41, "sadr": "حَتّى إِذا راعَ قَصفُ الرَّعدِ مَن سَمِعوا", "ajuz": "وَراعَ بَرقُ الدُّجى أَحلامَ مَن شَهِدوا"},
    {"n": 42, "sadr": "تَكَشَّفَ النَّقعُ عَن أَشلاءِ طاغِيَةٍ", "ajuz": "وَراحَ يَخطُرُ في غاباتِهِ الأَسَدُ"},
    {"n": 43, "sadr": "فَسَلَّمَ الفَلَكُ الأَسمى عَلى فَلَكٍ", "ajuz": "فيهِ الكَواكِبُ وَالأَسحارُ وَالرَّأَدُ"},
    {"n": 44, "sadr": "هَذي السَّماءُ كِتابٌ مِن شَتيتِ رُؤىً", "ajuz": "فَكُلُّ نَجمٍ بِها رَأيٌ وَمُعتَقَدُ"},
    {"n": 45, "sadr": "لي عالَمٌ يَغمُرُ الدُّنيا وَتَغمُرُهُ", "ajuz": "وَعالَمٌ عَطِرُ الأَسرارِ مُنفَرِدُ"},
    {"n": 46, "sadr": "تَخِفُّ روحي لَحاقاً في حُتوفِكُمُ", "ajuz": "وَيَحكُمُ القَدَرُ العاتي فَتَتَّئِدُ"},
    {"n": 47, "sadr": "العَيشُ بَعدَكُمُ لَغوٌ فَلا طَرَبٌ", "ajuz": "فيهِ وَلا أَمَلٌ هانٍ وَلا كَمَدُ"},
    {"n": 48, "sadr": "فَيا شَقاءَ فَتىً آمالُهُ رَجَعَت", "ajuz": "لِأَمسِهِ وَانطَوى يَومٌ وَماتَ غَدُ"}
  ]
}
