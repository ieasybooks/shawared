{
  "id": "afa-dhu-hisan",
  "poet": "al-nabigha-al-dhubyani",
  "title": "عَفا ذو حُسىً مِن فَرتَنى فَالفَوارِعُ",
  "meter": "tawil",
  "themes": ["apology", "madh"],
  "rawiy": "ع",
  "abyat_in_full": 33,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "عَفا ذو حُسىً مِن فَرتَنى فَالفَوارِعُ",
      "ajuz": "فَجَنبا أَريكٍ فَالتِّلاعُ الدَّوافِعُ"
    },
    {
      "n": 2,
      "sadr": "فَمُجتَمَعُ الأَشراجِ غَيَّرَ رَسمَها",
      "ajuz": "مَصايِفُ مَرَّت بَعدَنا وَمَرابِعُ"
    },
    {
      "n": 3,
      "sadr": "تَوَهَّمتُ آياتٍ لَها فَعَرَفتُها",
      "ajuz": "لِسِتَّةِ أَعوامٍ وَذا العامُ سابِعُ"
    },
    {
      "n": 4,
      "sadr": "رَمادٌ كَكُحلِ العَينِ لَأياً أُبينُهُ",
      "ajuz": "وَنُؤيٌ كَجِذمِ الحَوضِ أَثلَمُ خاشِعُ"
    },
    {
      "n": 5,
      "sadr": "كَأَنَّ مَجَرَّ الرّامِساتِ ذُيولَها",
      "ajuz": "عَلَيهِ حَصيرٌ نَمَّقَتهُ الصَّوانِعُ"
    },
    {
      "n": 6,
      "sadr": "عَلى ظَهرِ مِبناةٍ جَديدٍ سُيورُها",
      "ajuz": "يَطوفُ بِها وَسطَ اللَّطيمَةِ بائِعُ"
    },
    {
      "n": 7,
      "sadr": "فَكَفكَفتُ مِنّي عَبرَةً فَرَدَدتُها",
      "ajuz": "عَلى النَّحرِ مِنها مُستَهِلٌّ وَدامِعُ"
    },
    {
      "n": 8,
      "sadr": "عَلى حينَ عاتَبتُ المَشيبَ عَلى الصِّبا",
      "ajuz": "وَقُلتُ أَلَمّا أَصحُ وَالشَّيبُ وازِعُ"
    },
    {
      "n": 9,
      "sadr": "وَقَد حالَ هَمٌّ دونَ ذَلِكَ شاغِلٌ",
      "ajuz": "مَكانَ الشِّغافِ تَبتَغيهِ الأَصابِعُ"
    },
    {
      "n": 10,
      "sadr": "وَعيدُ أَبي قابوسَ في غَيرِ كُنهِهِ",
      "ajuz": "أَتاني وَدوني راكِسٌ فَالضَّواجِعُ"
    },
    {
      "n": 11,
      "sadr": "فَبِتُّ كَأَنّي ساوَرَتني ضَئيلَةٌ",
      "ajuz": "مِنَ الرُّقشِ في أَنيابِها السُّمُّ ناقِعُ"
    },
    {
      "n": 12,
      "sadr": "يُسَهَّدُ مِن لَيلِ التَّمامِ سَليمُها",
      "ajuz": "لِحَليِ النِّساءِ في يَدَيهِ قَعاقِعُ"
    },
    {
      "n": 13,
      "sadr": "تَناذَرَها الرّاقونَ مِن سوءِ سُمِّها",
      "ajuz": "تُطَلِّقُهُ طَوراً وَطَوراً تُراجِعُ"
    },
    {
      "n": 14,
      "sadr": "أَتاني أَبَيتَ اللَّعنَ أَنَّكَ لُمتَني",
      "ajuz": "وَتِلكَ الَّتي تَستَكُّ مِنها المَسامِعُ"
    },
    {
      "n": 15,
      "sadr": "مَقالَةَ أَن قَد قُلتَ سَوفَ أَنالُهُ",
      "ajuz": "وَذَلِكَ مِن تِلقاءِ مِثلِكَ رائِعُ"
    },
    {
      "n": 16,
      "sadr": "لَعَمري وَما عَمري عَلَيَّ بِهَيِّنٍ",
      "ajuz": "لَقَد نَطَقَت بُطلاً عَلَيَّ الأَقارِعُ"
    },
    {
      "n": 17,
      "sadr": "أَقارِعُ عَوفٍ لا أُحاوِلُ غَيرَها",
      "ajuz": "وُجوهُ قُرودٍ تَبتَغي مَن تُجادِعُ"
    },
    {
      "n": 18,
      "sadr": "أَتاكَ اِمرُؤٌ مُستَبطِنٌ لِيَ بِغضَةً",
      "ajuz": "لَهُ مِن عَدُوٍّ مِثلُ ذَلِكَ شافِعُ"
    },
    {
      "n": 19,
      "sadr": "أَتاكَ بِقَولٍ هَلهَلِ النَّسجِ كاذِبٍ",
      "ajuz": "وَلَم يَأتِ بِالحَقِّ الَّذي هُوَ ناصِعُ"
    },
    {
      "n": 20,
      "sadr": "أَتاكَ بِقَولٍ لَم أَكُن لِأَقولَهُ",
      "ajuz": "وَلَو كُبِلَت في ساعِدَيَّ الجَوامِعُ"
    },
    {
      "n": 21,
      "sadr": "حَلَفتُ فَلَم أَترُك لِنَفسِكَ ريبَةً",
      "ajuz": "وَهَل يَأثَمَن ذو إِمَّةٍ وَهوَ طائِعُ"
    },
    {
      "n": 22,
      "sadr": "بِمُصطَحِباتٍ مِن لَصافٍ وَثَبرَةٍ",
      "ajuz": "يَزُرنَ إِلالاً سَيرُهُنَّ التَّدافُعُ"
    },
    {
      "n": 23,
      "sadr": "سَماماً تُباري الرّيحَ خوصاً عُيونُها",
      "ajuz": "لَهُنَّ رَذايا بِالطَّريقِ وَدائِعُ"
    },
    {
      "n": 24,
      "sadr": "عَلَيهِنَّ شُعثٌ عامِدونَ لِحَجِّهِم",
      "ajuz": "فَهُنَّ كَأَطرافِ الحَنِيِّ خَواضِعُ"
    },
    {
      "n": 25,
      "sadr": "لَكَلَّفتَني ذَنبَ اِمرِئٍ وَتَرَكتَهُ",
      "ajuz": "كَذي العُرِّ يُكوى غَيرُهُ وَهوَ راتِعُ"
    },
    {
      "n": 26,
      "sadr": "فَإِن كُنتُ لا ذو الضِّغنِ عَنّي مُكَذَّبٌ",
      "ajuz": "وَلا حَلِفي عَلى البَراءَةِ نافِعُ"
    },
    {
      "n": 27,
      "sadr": "وَلا أَنا مَأمونٌ بِشَيءٍ أَقولُهُ",
      "ajuz": "وَأَنتَ بِأَمرٍ لا مَحالَةَ واقِعُ"
    },
    {
      "n": 28,
      "sadr": "فَإِنَّكَ كَاللَّيلِ الَّذي هُوَ مُدرِكي",
      "ajuz": "وَإِن خِلتُ أَنَّ المُنتَأى عَنكَ واسِعُ"
    },
    {
      "n": 29,
      "sadr": "خَطاطيفُ حُجنٌ في حِبالٍ مَتينَةٍ",
      "ajuz": "تَمُدُّ بِها أَيدٍ إِلَيكَ نَوازِعُ"
    },
    {
      "n": 30,
      "sadr": "أَتوعِدُ عَبداً لَم يَخُنكَ أَمانَةً",
      "ajuz": "وَتَترُكُ عَبداً ظالِماً وَهوَ ظالِعُ"
    },
    {
      "n": 31,
      "sadr": "وَأَنتَ رَبيعٌ يُنعِشُ النّاسَ سَيبُهُ",
      "ajuz": "وَسَيفٌ أُعيرَتهُ المَنِيَّةُ قاطِعُ"
    },
    {
      "n": 32,
      "sadr": "أَبى اللَّهُ إِلّا عَدلَهُ وَوَفاءَهُ",
      "ajuz": "فَلا النُّكرُ مَعروفٌ وَلا العُرفُ ضائِعُ"
    },
    {
      "n": 33,
      "sadr": "وَتُسقى إِذا ما شِئتَ غَيرَ مُصَرَّدٍ",
      "ajuz": "بِزَوراءَ في حافاتِها المِسكُ كانِعُ"
    }
  ]
}
