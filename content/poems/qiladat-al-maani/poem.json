{
  "id": "qiladat-al-maani",
  "poet": "fawwaz-ibn-jurays",
  "title": "قِلادَةُ المَعاني",
  "meter": "rajaz",
  "themes": ["didactic", "religion"],
  "abyat_in_full": 107,
  "added": "2026-11-19",
  "abyat": [
    {"n": 1, "sadr": "الحَمدُ لِلَّهِ عَلى الإِسلامِ", "ajuz": "عَلَّمَنا مَآخِذَ الأَحكامِ"},
    {"n": 2, "sadr": "فَهَذِهِ مَنظومَةٌ تُخَرِّجُ", "ajuz": "فَرعاً عَلى أَصلٍ فَمِنها تَعرُجُ"},
    {"n": 3, "sadr": "إِلى أَبي المَناقِبِ الزَّنجاني", "ajuz": "سَمَّيتُها قِلادَةَ المَعاني"},
    {"n": 4, "sadr": "الأَصلُ في أَحكامِنا التَّعَبُّدُ", "ajuz": "وَقيلَ بِالتَّعليلِ بانَ المَقصِدُ"},
    {"n": 5, "sadr": "وَعِلَّةٌ قاصِرَةٌ صَحيحَه", "ajuz": "وَقيلَ بَل باطِلَةٌ قَبيحَه"},
    {"n": 6, "sadr": "زِيادَةٌ في النَّصِّ قَيدٌ يَرسَخُ", "ajuz": "وَقيلَ ما قَد زيدَ فيهِ يُنسَخُ"},
    {"n": 7, "sadr": "وَواوٌ لِلتَّرتيبِ مَقصِدٌ وَقي", "ajuz": "لَ مَقصِدٌ لِلاِشتِراكِ المُطلَقِ"},
    {"n": 8, "sadr": "أَقَلُّ فِعلٍ مُجزِئٌ بِالأَمرِ", "ajuz": "وَقيلَ بَل فِعلٌ لِكُلِّ قَدرِ"},
    {"n": 9, "sadr": "مَقبولٌ ما يُخبِرُ فيهِ الواحِدُ", "ajuz": "إِن عَمَّتِ البَلوى وَقيلَ فاسِدُ"},
    {"n": 10, "sadr": "يَحتَمِلُ اللَّفظُ مَجازاً وَحَقي", "ajuz": "قَةً وَقيلَ عَكسُ ذا في المَنطِقِ"},
    {"n": 11, "sadr": "وَمِن لِتَبعيضٍ وَقيلَ لِابتِدا", "ajuz": "ءِ غايَةٍ فَاتَّبِع مَناراتِ الهُدى"},
    {"n": 12, "sadr": "وَاستَصحِبِ الحالَ مَعَ الإِجماعِ", "ajuz": "وَقيلَ لَيسَ حُجَّةً يا واعي"},
    {"n": 13, "sadr": "إِذا أُمِرتَ فَافهَمِ التَّكرارا", "ajuz": "وَقيلَ بَل مَرَّةً لا مِرارا"},
    {"n": 14, "sadr": "يُصيبُ حَقّاً واحِدٌ إِذا اِجتَهَد", "ajuz": "وَقيلَ بَل مُصيبٌ كُلُّ مُجتَهِد"},
    {"n": 15, "sadr": "وَواجِبٌ مُوَسَّعٌ مُضَيَّقُ", "ajuz": "وَقيلَ في الوَقتِ الأَخيرِ يَصدُقُ"},
    {"n": 16, "sadr": "وَفِعلُ غافِلٍ وَناسٍ مُهمَلُ", "ajuz": "وَقيلَ بَل مُكَلَّفٌ وَيَعقِلُ"},
    {"n": 17, "sadr": "مُخاطَبٌ بِكُلِّ فَرعٍ مَن كَفَر", "ajuz": "في دينِنا وَقيلَ عَكسُ ما ذُكِر"},
    {"n": 18, "sadr": "لا يَتبَعُ المَأمومُ بِالأَداءِ", "ajuz": "إِمامَهُ في سائِرِ الأَجزاءِ"},
    {"n": 19, "sadr": "وَقيلَ بِالصِّحَّةِ وَالفَسادِ", "ajuz": "يَكونُ حُكمُ الشَّرعِ بِاجتِهادِ"},
    {"n": 20, "sadr": "تَناوُلُ النِّكاحِ لِلزَّوجَينِ", "ajuz": "وَقيلَ لِلزَّوجَةِ بِالتَّعيينِ"},
    {"n": 21, "sadr": "وَالأَمرُ لِلفَورِ وَقيلَ يَقتَضي", "ajuz": "تَراخِياً فَأَيَّ مِنهُم تَرتَضي"},
    {"n": 22, "sadr": "قَصدُ الزَّكاةِ عَونٌ لا تَعَبُّدُ", "ajuz": "بَل تابِعٌ وَقيلَ هَذا المَقصِدُ"},
    {"n": 23, "sadr": "إِضافَةُ النَّفيِ لِجِنسِ الفِعلِ", "ajuz": "لا يُجمِلُ وَقيلَ عَكسُ القَولِ"},
    {"n": 24, "sadr": "وَيَنتَفي الوُجوبُ عَن حُكمٍ سُكِت", "ajuz": "عَن بَعضِهِ وَقيلَ عَنهُ فَالتَفِت"},
    {"n": 25, "sadr": "حَقيقَةُ الخِطابِ في التَّكليفِ", "ajuz": "فِعلٌ وَتَركٌ جاءَ بِالتَّصنيفِ"},
    {"n": 26, "sadr": "وَقيلَ قِسمانِ وُجوبُ ذِمَّةِ", "ajuz": "وُجوبُ أَداءٍ مَناطُ القِسمَةِ"},
    {"n": 27, "sadr": "وَقِس عَلى كَفّارَةٍ وَقيلَ", "ajuz": "وَقفِيَّةٌ لا تَقبَلُ التَّعليلَ"},
    {"n": 28, "sadr": "وَيَثبُتُ الفِعلُ بِأَمرٍ قَولُ", "ajuz": "وَقيلَ لا حَتّى يَسَعَهُ الفِعلُ"},
    {"n": 29, "sadr": "إِذا قَطَعتَ غَيرَ واجِبٍ فَلا", "ajuz": "يَلزَمُ إِتمامٌ وَقَد قيلَ بَلى"},
    {"n": 30, "sadr": "إِذا أَنَبتَ في تَكاليفِ البَدَن", "ajuz": "صَحَّت وَقيلَ لا تَصِحُّ فَافهَمَن"},
    {"n": 31, "sadr": "رِضا الجَميعِ في الشِّرا دَليلُ", "ajuz": "مَناطُهُ الإيجابُ وَالقَبولُ"},
    {"n": 32, "sadr": "وَقيلَ بِالعَطاءِ صَمتاً يَنعَقِد", "ajuz": "بَيعٌ فَفي الرَّأيَينِ كُلٌّ مُجتَهِد"},
    {"n": 33, "sadr": "إِن غابَتِ العَينُ فَذا بَيعُ الغَرَر", "ajuz": "فَباطِلٌ وَقيلَ صَحَّ إِن حَضَر"},
    {"n": 34, "sadr": "لَكَ الخِيارُ قَبلَ فُرقَةِ البَدَن", "ajuz": "في مَجلِسٍ وَقيلَ بَل لا يَثبُتَن"},
    {"n": 35, "sadr": "وَالشَّرطُ مَقبولٌ بِتَأخيرِ السَّبَب", "ajuz": "وَقيلَ بَل يُبطِلُ فيهِ ما وَجَب"},
    {"n": 36, "sadr": "ما بَعدَ إِلّا مُخرِجٌ لِلنّاظِرِ", "ajuz": "وَقيلَ بَل ما قَبلَها لَم يُذكَرِ"},
    {"n": 37, "sadr": "وَعِلَّةُ الرِّبا طَعامٌ مُدَّخَر", "ajuz": "وَقيلَ بِالجِنسِ مَعَ الكَيلِ اِعتَبِر"},
    {"n": 38, "sadr": "أَثبِت لِوَصفِ الحُكمِ مَفهومَ الصِّفَه", "ajuz": "وَقيلَ لا يَصِحُّ فَهِيَ كاشِفَه"},
    {"n": 39, "sadr": "صَحيحٌ أَو باطِلٌ حُكمانِ فَقَط", "ajuz": "وَقيلَ حُكمٌ فاسِدٌ كَيفَ سَقَط"},
    {"n": 40, "sadr": "إِن عُدِمَ الدَّليلُ فَاصحَب ما بَقي", "ajuz": "وَقيلَ لَيسَ الحُكمُ فيهِ يَرتَقي"},
    {"n": 41, "sadr": "قَولُ الصَّحابِيِّ إِذا ما اِنفَرَدا", "ajuz": "لا يَلزَمُ وَقيلَ أَكرِم سَنَدا"},
    {"n": 42, "sadr": "وَخارِجٌ عَن أَصلِهِ إِن فُهِما", "ajuz": "فَقِس بِهِ وَقيلَ لَيسَ مُلزِما"},
    {"n": 43, "sadr": "العَقدُ ما لَم يَلزَمِ المِلكُ اِنتَفى", "ajuz": "وَقيلَ مِن أَهلِ العُقودِ يُكتَفى"},
    {"n": 44, "sadr": "طَهارَةٌ في العَينِ شَرطُ البَيعِ", "ajuz": "وَقيلَ بَل مَناطُهُ في النَّفعِ"},
    {"n": 45, "sadr": "مَنافِعٌ مَناطُ عَقدِ الأَنكِحَه", "ajuz": "وَقيلَ في العَينِ إِمامٌ رَجَّحَه"},
    {"n": 46, "sadr": "رُكنانِ في البَيعِ مَبيعٌ وَثَمَن", "ajuz": "وَقيلَ رُكنُ العَقدِ مُثمَنٌ زُكِن"},
    {"n": 47, "sadr": "تَعَلُّقُ الرَّهنِ بِدَينٍ شَرعي", "ajuz": "وَقيلَ حَبسُ العَينِ مَعنىً حِسّي"},
    {"n": 48, "sadr": "وَالأَمرُ بِالكُلِّيِّ لا يَعُمُّ", "ajuz": "أَجزاءَهُ وَقيلَ بَل يَضُمُّ"},
    {"n": 49, "sadr": "اِقبَل بِفِعلٍ ظاهِرٍ في الشَّرعِ", "ajuz": "وَقيلَ بِالتُّهمَةِ حُكمُ المَنعِ"},
    {"n": 50, "sadr": "وَالعَينُ لا تُملَكُ بِالضَّمانِ", "ajuz": "وَقيلَ بَل تُمَلَّكُ بِالأَوانِ"},
    {"n": 51, "sadr": "يَدُ التَّعَدّي في الضَّمانِ تَكفي", "ajuz": "وَقيلَ بَل ناقِلَةُ التَّعَدّي"},
    {"n": 52, "sadr": "مَنافِعُ الأَعيانِ مالٌ مُعتَبَر", "ajuz": "وَقيلَ أَفعالٌ تَزولُ فَافتَكِر"},
    {"n": 53, "sadr": "وَمِلكُها يَكونُ بِالعَقدِ وَقي", "ajuz": "لَ تَدخُلُ في المِلكِ بِالتَّحَقُّقِ"},
    {"n": 54, "sadr": "وَالشُّفعَةُ مَناطُها اِختِلاطُ", "ajuz": "وَقيلَ في الأَصلِ لَهُ اِرتِباطُ"},
    {"n": 55, "sadr": "وَالعَبدُ بِالإِذنِ يَنوبُ سَيِّدَه", "ajuz": "وَقيلَ بَل يَملِكُ ما قَد قَصَدَه"},
    {"n": 56, "sadr": "حُسنٌ وَقُبحٌ شَرعُنا فيهِ حَكَم", "ajuz": "وَقيلَ قاضي العَقلِ فَصلٌ فَاحتَكِم"},
    {"n": 57, "sadr": "وَالأَمرُ لا يَلزَمُ نَهيَ الضِّدِّ", "ajuz": "وَقيلَ بَل أَضدادَهُ بِالقَصدِ"},
    {"n": 58, "sadr": "تَوَقُّفُ الأَشياخِ يُعمِلُ الخَبَر", "ajuz": "وَقيلَ لا يُقبَلُ عَنهُ ما ذُكِر"},
    {"n": 59, "sadr": "بَكارَةٌ مَناطٌ لِلإِجبارِ", "ajuz": "وَقيلَ بَل يُناطُ بِالأَعمارِ"},
    {"n": 60, "sadr": "قُربُ الوَلِيِّ في النِّكاحِ غايَه", "ajuz": "وَقيلَ بَل أَهلِيَّةُ الوِلايَه"},
    {"n": 61, "sadr": "اِحمِل عَلى تَقييدِ حُكمٍ مُطلَقا", "ajuz": "وَقيلَ دَع إِطلاقَهُ مُحَقَّقا"},
    {"n": 62, "sadr": "شَهادَةُ النِّساءِ لِلضَّرورَةِ", "ajuz": "وَقيلَ بَل أَصلٌ بِنَصِّ الشِّرعَةِ"},
    {"n": 63, "sadr": "وَتَتَبُّعُ الآثارِ حُكمَ الحِسِّ", "ajuz": "وَقيلَ بَل يَثبُتُ حُكمُ العَكسِ"},
    {"n": 64, "sadr": "وَرَجِّحِ الشَّرعَ إِذا اللَّفظُ اِحتَمَل", "ajuz": "وَقيلَ بَل وَضعُ اللِّسانِ فَامتَثِل"},
    {"n": 65, "sadr": "مَهرُ النِّساءِ حَقُّهُنَّ مُستَقِر", "ajuz": "وَقيلَ حَقٌّ لِلإِلَهِ مُعتَبَر"},
    {"n": 66, "sadr": "إِنَّ اِختِلافَ الدّارِ لا يَستَبدِلُ", "ajuz": "حُكماً وَقيلَ الفَرقُ فيهِم يُقبَلُ"},
    {"n": 67, "sadr": "وَما اِقتَضاهُ اللَّفظُ كَالمَذكورِ", "ajuz": "وَقيلَ بَل يُحكَمُ بِالمَحصورِ"},
    {"n": 68, "sadr": "وَالرَّجعَةُ مَشروطَةً لا تُقطَعُ", "ajuz": "وَقيلَ بِالشَّرطِ الصَّحيحِ تُمنَعُ"},
    {"n": 69, "sadr": "وَمَورِدُ النِّكاحِ في الذَّواتِ", "ajuz": "وَقيلَ بَل في جَوهَرِ الصِّفاتِ"},
    {"n": 70, "sadr": "وَيَرفَعُ الإِكراهُ حُكمَ الشَّرعِ", "ajuz": "وَقيلَ بَل مُجمَلٌ لَيسَ قَطعي"},
    {"n": 71, "sadr": "وَاحكُم بِحَتّى لِانتِهاءِ الغايَه", "ajuz": "وَقيلَ لِلرَّفعِ وَقَطعٍ آيَه"},
    {"n": 72, "sadr": "حِلُّ النِّكاحِ ثابِتٌ لِلأَمَةِ", "ajuz": "كَحُرَّةٍ وَقيلَ دونَ الرُّتبَةِ"},
    {"n": 73, "sadr": "يُزيلُ مِن وَجهٍ طَلاقُ الرَّجعَه", "ajuz": "وَقيلَ بَل نَفيُ الزَّوالِ شِرعَه"},
    {"n": 74, "sadr": "وَالنَّفَقاتُ حَقُّ حَبسٍ بِالعِوَض", "ajuz": "وَقيلَ بَل لِلصِّلَةِ جاءَ الغَرَض"},
    {"n": 75, "sadr": "وَالحُكمُ في الأَسبابِ لِلمَعنى اِعتَبِر", "ajuz": "وَقيلَ بَل في صورَةِ الحُكمِ اِستَقَر"},
    {"n": 76, "sadr": "نَفيُ التَّساوي يَقتَضي العُموما", "ajuz": "وَقيلَ لا وَكُن بِذا عَليما"},
    {"n": 77, "sadr": "وَفِعلُ كُلِّ النّاسِ كَسبٌ لا أَثَر", "ajuz": "وَقيلَ بَل يَخلُقُهُ مَن قَد قَدَر"},
    {"n": 78, "sadr": "وَالحَقُّ خَلقُ اللَّهِ في نَصِّ الهُدى", "ajuz": "وَالعَبدُ صارَ فاعِلاً مُجتَهِدا"},
    {"n": 79, "sadr": "وَالسَّبَبُ يَجري بِهِ القِياسُ", "ajuz": "وَقيلَ في قِياسِهِ اِلتِباسُ"},
    {"n": 80, "sadr": "مُشتَرَكٌ عَلى الجَميعِ يُحمَلُ", "ajuz": "وَقيلَ لا يَصِحُّ فَهوَ بَدَلُ"},
    {"n": 81, "sadr": "مَعنى القِصاصِ جَبرُ فَوتٍ في المَحَل", "ajuz": "وَقيلَ لِلفِعلِ وَزَجرِ مَن قَتَل"},
    {"n": 82, "sadr": "يَجوزُ رَدُّ الحُكمِ لِلكُلِّيَّه", "ajuz": "وَقيلَ بَل تَتَبَّعِ الجُزئِيَّه"},
    {"n": 83, "sadr": "وَيوجِبُ لَفظُ العُمومِ ظَنّا", "ajuz": "وَقيلَ نَصٌّ قاطِعٌ في المَبنى"},
    {"n": 84, "sadr": "يُخَصَّصُ الكِتابُ بِالقِياسِ", "ajuz": "وَقيلَ هَذا ناسِخُ الأَساسِ"},
    {"n": 85, "sadr": "وَفِعلُ مَأذونٍ مِنَ الشَّرعِ اُعتُبِر", "ajuz": "كَإِذنِ ذي الحَقِّ وَقيلَ إِن أُمِر"},
    {"n": 86, "sadr": "مَن شَرطُها يَعُمُّ جِنسَ البَشَرِ", "ajuz": "وَقيلَ يَختَصُّ بِجِنسِ الذَّكَرِ"},
    {"n": 87, "sadr": "يُخاطَبُ الكافِرُ بِالعُمومِ", "ajuz": "وَقيلَ لا يَدخُلُ في التَّعميمِ"},
    {"n": 88, "sadr": "وَالحُكمُ في الأَفرادِ لا يَعُمُّ", "ajuz": "وَقيلَ مَن شارَكَهُ يُضَمُّ"},
    {"n": 89, "sadr": "اِسمُ الزِّنى يَشمَلُ كُلَّ البَشَرِ", "ajuz": "وَقيلَ في الأُنثى مَجازُ الأَثَرِ"},
    {"n": 90, "sadr": "وَقِس عَلى المُشتَقِّ في اللِّسانِ", "ajuz": "وَقيلَ لا لِجَهلِنا المَعاني"},
    {"n": 91, "sadr": "وَاستَصحِبِ العُمومَ ذاكَ نَصُّ", "ajuz": "وَقيلَ في الشُّبهَةِ ما يَخُصُّ"},
    {"n": 92, "sadr": "وَالعِلَّةُ بِلا شُروطٍ توجِبُ", "ajuz": "حُكماً وَعَكسُ ما ذَكَرنا السَّبَبُ"},
    {"n": 93, "sadr": "إِن يَجتَمِع وَصفانِ قَدِّم ما قَرُب", "ajuz": "وَالحُكمُ لِلظّاهِرِ دَوماً يَنتَسِب"},
    {"n": 94, "sadr": "وَاتَّفَقوا في مَنهَجِ الطَّريقِ", "ajuz": "وَاختَلَفوا في نَظرَةِ التَّحقيقِ"},
    {"n": 95, "sadr": "لا يُشرَطُ حِرزٌ لِمِلكِ الغُنمِ", "ajuz": "وَقيلَ بَل يُشرَطُ قَبلَ القَسمِ"},
    {"n": 96, "sadr": "وُرودُ عامٍّ في الخُصوصِ يُقصَرُ", "ajuz": "وَقيلَ بَل عُمومُ ذا لا يُنكَرُ"},
    {"n": 97, "sadr": "قَدِّم عَلى القِياسِ آحادَ الخَبَر", "ajuz": "وَقيلَ لا إِنَّ اليَقينَ مُعتَبَر"},
    {"n": 98, "sadr": "كَفّارَةٌ جَبرٌ لِحَقِّ المَولى", "ajuz": "وَقيلَ بَل جَزاءُ فِعلِ المَولى"},
    {"n": 99, "sadr": "وَشِرعَةُ مَن قَبلَنا لا تَلزَمُ", "ajuz": "وَقيلَ ما في الذِّكرِ مِنها يَحكُمُ"},
    {"n": 100, "sadr": "إِظهارُ حُكمِ الشّارِعِ القَضاءُ", "ajuz": "وَقيلَ إِثباتٌ لَهُ إِنشاءُ"},
    {"n": 101, "sadr": "وَرَجِّحِ الكَثرَةَ في الأَدِلَّةِ", "ajuz": "وَقيلَ بِالوُضوحِ لا بِالكَثرَةِ"},
    {"n": 102, "sadr": "يَعودُ الاِستِثناءُ في كُلِّ الجُمَل", "ajuz": "وَقيلَ في الأَخيرِ مِنهُم فَامتَثِل"},
    {"n": 103, "sadr": "وَيَخلُفُ المَجازُ عَن حَقيقَةِ", "ajuz": "وَقيلَ بَل أَصلٌ لِحُكمِ الشِّرعَةِ"},
    {"n": 104, "sadr": "وَمَورِدُ الكِتابَةِ الرِّقابُ", "ajuz": "وَقيلَ بَل مَورِدُهُ اِكتِسابُ"},
    {"n": 105, "sadr": "وَالحَمدُ لِلَّذي عَلَيَّ أَنعَما", "ajuz": "مَنَّ فَكانَ اِبنُ جُرَيسٍ ناظِما"},
    {"n": 106, "sadr": "فَامنُن بِنَفعِ القارِئِ وَالكاتِبِ", "ajuz": "وَارزُق بِها فِقهاً لِكُلِّ طالِبِ"},
    {"n": 107, "sadr": "وَصَلِّ يا رَبِّ عَلى المُختارِ", "ajuz": "وَآلِهِ وَصَحبِهِ الأَخيارِ"}
  ]
}
