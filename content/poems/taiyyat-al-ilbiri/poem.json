    { "n": 110, "sadr": "وَطَوَّلتُ العِتابَ وَزِدتُ فيهِ",       "ajuz": "لِأَنَّكَ في البَطالَةِ قَد أَطَلتا" },
    { "n": 111, "sadr": "فَلا تَأخُذ بِتَقصيري وَسَهوي",      "ajuz": "وَخُذ بِوَصِيَّتي لَكَ إِن رَشَدتا" },
