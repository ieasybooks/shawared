{
  "id": "sabartu-wa-mithli",
  "poet": "ali-ibn-al-jahm",
  "title": "صَبَرتُ وَمِثلي صَبرُهُ لَيسَ يُنكَرُ",
  "meter": "tawil",
  "themes": ["fakhr", "hamasa"],
  "rawiy": "ر",
  "abyat_in_full": 17,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "صَبَرتُ وَمِثلي صَبرُهُ لَيسَ يُنكَرُ",
      "ajuz": "وَلَيسَ عَلى تَركِ التَّقَحُّمِ يُعذَرُ"
    },
    {
      "n": 2,
      "sadr": "غَريزَةُ حُرٍّ لا اِختِلاقُ تَكَلُّفٍ",
      "ajuz": "إِذا خامَ في يَومِ الوَغى المُتَصَبِّرُ"
    },
    {
      "n": 3,
      "sadr": "وَلَمّا رَأَيتُ المَوتَ تَهفو بُنودُهُ",
      "ajuz": "وَبانَت عَلاماتٌ لَهُ لَيسَ تُنكَرُ"
    },
    {
      "n": 4,
      "sadr": "وَأَقبَلَتِ الأَعرابُ مِن كُلِّ جانِبٍ",
      "ajuz": "وَثارَ عَجاجٌ أَسوَدُ اللَّونِ أَكدَرُ"
    },
    {
      "n": 5,
      "sadr": "بِكُلِّ مُشيحٍ مُستَميتٍ مُشَمِّرٍ",
      "ajuz": "يَجولُ بِهِ طِرفٌ أَقَبُّ مُشَمَّرُ"
    },
    {
      "n": 6,
      "sadr": "بِأَرضِ خُسافٍ حينَ لَم يَكُ دافِعٌ",
      "ajuz": "وَلا مانِعٌ إِلّا الصَّفيحُ المُذَكَّرُ"
    },
    {
      "n": 7,
      "sadr": "فَقَلَّلَ في عَينَيَّ عُظمَ جُموعِهِم",
      "ajuz": "عَزيمَةُ قَلبٍ فيهِ ما جَلَّ يَصغُرُ"
    },
    {
      "n": 8,
      "sadr": "بِمُعتَرَكٍ فيهِ المَنايا حَواسِرٌ",
      "ajuz": "وَنارُ الوَغى بِالمَشرَفِيَّةِ تُسعَرُ"
    },
    {
      "n": 9,
      "sadr": "فَما صُنتُ وَجهي عَن ظُباتِ سُيوفِهِم",
      "ajuz": "وَلا اِنحَزتُ عَنهُم وَالقَنا تَتَكَسَّرُ"
    },
    {
      "n": 10,
      "sadr": "وَلَم أَكُ في حَرِّ الكَريهَةِ مُحجِماً",
      "ajuz": "إِذا لَم يَكُن في الحَربِ لِلوِردِ مَصدَرُ"
    },
    {
      "n": 11,
      "sadr": "إِذا ساعَدَ الطِّرفُ الفَتى وَجَنانُهُ",
      "ajuz": "وَأَسمَرُ خَطِّيٌّ وَأَبيَضُ مِبتَرُ"
    },
    {
      "n": 12,
      "sadr": "فَذاكَ وَإِن كانَ الكَريمُ بِنَفسِهِ",
      "ajuz": "إِذا اِصطَكَّتِ الأَبطالُ في النَّقعِ عَسكَرُ"
    },
    {
      "n": 13,
      "sadr": "مَنَعتُهُمُ مِن أَن يَنالوا قُلامَةً",
      "ajuz": "وَكُنتُ شَجاهُم وَالأَسِنَّةُ تَقطُرُ"
    },
    {
      "n": 14,
      "sadr": "وَتِلكَ سَجايانا قَديماً وَحادِثاً",
      "ajuz": "بِها عُرِفَ الماضي وَعَزَّ المُؤَخَّرُ"
    },
    {
      "n": 15,
      "sadr": "أَبَت لي قُرومٌ أَنجَبَتنِيَ أَن أُرى",
      "ajuz": "وَإِن جَلَّ خَطبٌ خاشِعاً أَتَضَجَّرُ"
    },
    {
      "n": 16,
      "sadr": "أُولَئِكَ آلُ اللَّهِ فِهرُ بنُ مالِكٍ",
      "ajuz": "بِهِم يُجبَرُ العَظمُ الكَسيرُ وَيُكسَرُ"
    },
    {
      "n": 17,
      "sadr": "هُمُ المَنكِبُ العالي عَلى كُلِّ مَنكِبٍ",
      "ajuz": "سُيوفُهُمُ تُفني وَتُغني وَتُفقِرُ"
    }
  ]
}
