{
  "id": "khalilayya-uja",
  "poet": "al-simma-al-qushayri",
  "title": "خَليلَيَّ عوجا مِنكُما اليَومَ أَو دَعا",
  "meter": "tawil",
  "themes": ["shawq", "ghazal", "wasf"],
  "rawiy": "ع",
  "abyat_in_full": 63,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "خَليلَيَّ عوجا مِنكُما اليَومَ أَو دَعا",
      "ajuz": "نُحَيّي رُسوماً بِالقُبَيبَةِ بَلقَعا"
    },
    {
      "n": 2,
      "sadr": "أَرَبَّت بِها الأَرواحُ حَتّى تَنَسَّفَت",
      "ajuz": "مَعارِفَها إِلّا الصَّفيحَ المُوَضَّعا"
    },
    {
      "n": 3,
      "sadr": "وَغَيرَ ثَلاثٍ في الدِّيارِ كَأَنَّها",
      "ajuz": "ثَلاثُ حَماماتٍ تَقابَلنَ وُقَّعا"
    },
    {
      "n": 4,
      "sadr": "أَمِن أَجلِ دارٍ بِالرَّقاشَينِ أَعصَفَت",
      "ajuz": "عَلَيها رِياحُ الصَّيفِ بَدءاً وَرُجَّعا"
    },
    {
      "n": 5,
      "sadr": "بَكَت عَينُكَ اليُسرى فَلَمّا زَجَرتَها",
      "ajuz": "عَنِ الجَهلِ بَعدَ الحِلمِ أَسبَلَتا مَعا"
    },
    {
      "n": 6,
      "sadr": "وَلَم أَرَ مِثلَ العامِرِيَّةِ قَبلَها",
      "ajuz": "وَلا بَعدَها يَومَ اِرتَحَلنا مُوَدِّعا"
    },
    {
      "n": 7,
      "sadr": "تُريكَ غَداةَ البَينِ مُقلَةَ شادِنٍ",
      "ajuz": "وَجيدَ غَزالٍ في القَلائِدِ أَتلَعا"
    },
    {
      "n": 8,
      "sadr": "وَما أُمُّ أَحوى الجُدَّتَينِ خِلالُها",
      "ajuz": "أَراكٌ مِنَ الأَعرافِ أَدنى وَأَينَعا"
    },
    {
      "n": 9,
      "sadr": "غَدَت مِن عَلَيهِ تَنفُضُ الطَّلَّ بَعدَما",
      "ajuz": "رَأَت حاجِبَ الشَّمسِ اِستَوى وَتَرَفَّعا"
    },
    {
      "n": 10,
      "sadr": "بِأَحسَنَ مِن أُمِّ المُحَيّا فُجاءَةً",
      "ajuz": "إِذا جيدُها مِن كِفَّةِ السِّترِ أَطلَعا"
    },
    {
      "n": 11,
      "sadr": "وَلَمّا تَناهَبنا سِقاطَ حَديثِها",
      "ajuz": "غِشاشاً وَلانَ الطَّرفُ مِنها فَأَطمَعا"
    },
    {
      "n": 12,
      "sadr": "فَرَشَّت بِقَولٍ كادَ يَشفي مِنَ الجَوى",
      "ajuz": "تَلُمُّ بِهِ أَكبادَنا أَن تَصَدَّعا"
    },
    {
      "n": 13,
      "sadr": "كَما رَشَفَ الصّادي وَقائِعَ مُزنَةٍ",
      "ajuz": "رَشاشٍ تَوَلّى صَوبُها حينَ أَقلَعا"
    },
    {
      "n": 14,
      "sadr": "شَكَوتُ إِلَيها ضَبثَةَ الحَيِّ بِالحَشا",
      "ajuz": "وَخَشيَةَ شَعبِ الحَيِّ أَن يَتَوَزَّعا"
    },
    {
      "n": 15,
      "sadr": "فَما كَلَّمَتني غَيرَ رَجعٍ وَإِنَّما",
      "ajuz": "تَرَقرَقَتِ العَينانِ مِنها لِتَدمَعا"
    },
    {
      "n": 16,
      "sadr": "كَأَنَّكَ بِدعٌ لَم تَرَ البَينَ قَبلَها",
      "ajuz": "وَلَم تَكُ بِالأُلّافِ قَبلُ مُفَجَّعا"
    },
    {
      "n": 17,
      "sadr": "فَلَيتَ جِمالَ الحَيِّ يَومَ تَرَحَّلوا",
      "ajuz": "بِذي سَلَمٍ أَمسَت مَزاحيفَ ظُلَّعا"
    },
    {
      "n": 18,
      "sadr": "فَيُصبِحنَ لا يُحسِنَّ مَشياً بِراكِبٍ",
      "ajuz": "وَلا السَّيرَ في نَجدٍ وَإِن كانَ مَهيَعا"
    },
    {
      "n": 19,
      "sadr": "أَتَجزَعُ وَالحَيّانِ لَم يَتَفَرَّقا",
      "ajuz": "فَكَيفَ إِذا داعي التَّفَرُّقِ أَسمَعا"
    },
    {
      "n": 20,
      "sadr": "فَرُحتُ وَلَو أَسمَعتُ ما بي مِنَ الجَوى",
      "ajuz": "رَذِيَّ قِطارٍ حَنَّ شَوقاً وَرَجَّعا"
    },
    {
      "n": 21,
      "sadr": "أَلا يا غُرابَي بَيتِها لا تَرَفَّعا",
      "ajuz": "وَطيرا جَميعاً بِالهَوى وَقَعا مَعا"
    },
    {
      "n": 22,
      "sadr": "أَتَبكي عَلى رَيّا وَنَفسُكَ باعَدَت",
      "ajuz": "مَزارَكَ مِن رَيّا وَشَعباكُما مَعا"
    },
    {
      "n": 23,
      "sadr": "فَما حَسَنٌ أَن تَأتِيَ الأَمرَ طائِعاً",
      "ajuz": "وَتَجزَعَ أَن داعي الصَّبابَةِ أَسمَعا"
    },
    {
      "n": 24,
      "sadr": "كَأَنَّكَ لَم تَشهَد وَداعَ مُفارِقٍ",
      "ajuz": "وَلَم تَرَ شَعبَي صاحِبَينِ تَقَطَّعا"
    },
    {
      "n": 25,
      "sadr": "تَحَمَّلَ أَهلي مِن قَنينٍ وَغادَروا",
      "ajuz": "بِهِ أَهلَ لَيلى حينَ جيدَ وَأَمرَعا"
    },
    {
      "n": 26,
      "sadr": "أَلا يا خَليلَيَّ اللَّذَينِ تَواصَيا",
      "ajuz": "بِلَومي إِلّا أَن أُطيعَ وَأَضرَعا"
    },
    {
      "n": 27,
      "sadr": "قِفا إِنَّهُ لا بُدَّ مِن رَجعِ نَظرَةٍ",
      "ajuz": "مُصَعَّدَةٍ شَتّى بِها القَومُ أَو مَعا"
    },
    {
      "n": 28,
      "sadr": "فَإِنّي وَجَدتُ اللَّومَ لا يُذهِبُ الهَوى",
      "ajuz": "وَلَكِن وَجَدتُ اليَأسَ أَجدى وَأَنفَعا"
    },
    {
      "n": 29,
      "sadr": "لِمُغتَصَبٍ قَد عَزَّهُ القَومُ أَمرَهُ",
      "ajuz": "يُسِرُّ حَياءً عَبرَةً أَن تَطَلَّعا"
    },
    {
      "n": 30,
      "sadr": "تَهيجُ لَهُ الأَحزانُ وَالذِّكرُ كُلَّما",
      "ajuz": "تَرَنَّمَ أَو أَوفى مِنَ الأَرضِ مَيفَعا"
    },
    {
      "n": 31,
      "sadr": "قِفا وَدِّعا نَجداً وَمَن حَلَّ بِالحِمى",
      "ajuz": "وَقَلَّ لِنَجدٍ عِندَنا أَن يُوَدَّعا"
    },
    {
      "n": 32,
      "sadr": "بِنَفسِيَ تِلكَ الأَرضُ ما أَطيَبَ الرُّبا",
      "ajuz": "وَما أَحسَنَ المُصطافَ وَالمُتَرَبَّعا"
    },
    {
      "n": 33,
      "sadr": "وَأَذكُرُ أَيّامَ الحِمى ثُمَّ أَنثَني",
      "ajuz": "عَلى كَبِدي مِن خَشيَةٍ أَن تَصَدَّعا"
    },
    {
      "n": 34,
      "sadr": "فَلَيسَت عَشِيّاتُ الحِمى بِرَواجِعٍ",
      "ajuz": "عَلَيكَ وَلَكِن خَلِّ عَينَيكَ تَدمَعا"
    },
    {
      "n": 35,
      "sadr": "مَعي كُلُّ غِرٍّ قَد عَصى عاذِلاتِهِ",
      "ajuz": "بِوَصلِ الغَواني مُذ لَدُن أَن تَرَعرَعا"
    },
    {
      "n": 36,
      "sadr": "إِذا راحَ يَمشي في الرِّداءَينِ أَسرَعَت",
      "ajuz": "إِلَيهِ العُيونُ النّاظِراتُ التَّطَلُّعا"
    },
    {
      "n": 37,
      "sadr": "وَسِربٍ بَدَت لي فيهِ بيضٌ نَواهِدُ",
      "ajuz": "إِذا سُمتُهُنَّ الوَصلَ أَمسَينَ قُطَّعا"
    },
    {
      "n": 38,
      "sadr": "مَشَينَ اِطِّرادَ السَّيلِ هَوناً كَأَنَّما",
      "ajuz": "تَراهُنَّ بِالأَقدامِ إِذ مِسنَ ظُلَّعا"
    },
    {
      "n": 39,
      "sadr": "فَقُلتُ سَقى اللَّهُ الحِمى دِيَمَ الحَيا",
      "ajuz": "فَقُلنَ سَقاكَ اللَّهُ بِالسُّمِّ مُنقَعا"
    },
    {
      "n": 40,
      "sadr": "وَقُلتُ عَلَيكُنَّ السَّلامُ فَلا أَرى",
      "ajuz": "لِنَفسِيَ مِن دونِ الحِمى اليَومَ مَقنَعا"
    },
    {
      "n": 41,
      "sadr": "فَقُلنَ أَراكَ اللَّهُ إِن كُنتَ كاذِباً",
      "ajuz": "بَنانَكَ مِن يُمنى ذِراعَيكَ أَقطَعا"
    },
    {
      "n": 42,
      "sadr": "وَلَمّا رَأَيتُ البِشرَ أَعرَضَ دونَنا",
      "ajuz": "وَجالَت بَناتُ الشَّوقِ يَحنِنَّ نُزَّعا"
    },
    {
      "n": 43,
      "sadr": "تَلَفَّتُّ نَحوَ الحَيِّ حَتّى وَجَدتُني",
      "ajuz": "وَجِعتُ مِنَ الإِصغاءِ ليتاً وَأَخدَعا"
    },
    {
      "n": 44,
      "sadr": "فَإِن كُنتُمُ تَرجونَ أَن يَذهَبَ الهَوى",
      "ajuz": "يَقيناً وَنَروى بِالشَّرابِ فَنَنقَعا"
    },
    {
      "n": 45,
      "sadr": "فَرُدّوا هُبوبَ الرّيحِ أَو غَيِّروا الجَوى",
      "ajuz": "إِذا حَلَّ أَلواذَ الحَشا فَتَمَنَّعا"
    },
    {
      "n": 46,
      "sadr": "أَما وَجَلالِ اللَّهِ لَو تَذكُرينَني",
      "ajuz": "كَذِكريكِ ما كَفكَفتِ لِلعَينِ أَدمُعا"
    },
    {
      "n": 47,
      "sadr": "فَقالَت بَلى وَاللَّهِ ذِكراً لَو أَنَّهُ",
      "ajuz": "يُصَبُّ عَلى الصَّخرِ الأَصَمِّ تَصَدَّعا"
    },
    {
      "n": 48,
      "sadr": "فَما وَجدُ عِلوِيِّ الهَوى حَنَّ وَاجتَوى",
      "ajuz": "بِوادي الشَّرى وَالغَورِ ماءً وَمَرتَعا"
    },
    {
      "n": 49,
      "sadr": "رَأى وَهوَ في رَأسِ الشَّرى مُتَمَنِّعاً",
      "ajuz": "مَصادِرَ نَجدٍ وَالفَضاءَ فَرَجَّعا"
    },
    {
      "n": 50,
      "sadr": "تَشَوَّقَ لَمّا عَضَّهُ القَيدُ وَاجتَوى",
      "ajuz": "مَراتِعَهُ مِن بَينِ قُفٍّ وَأَجرَعا"
    },
    {
      "n": 51,
      "sadr": "وَرامَ بِعَينَيهِ جِبالاً مُنيفَةً",
      "ajuz": "وَما لا يَرى فيهِ أَخو القَيدِ مَطمَعا"
    },
    {
      "n": 52,
      "sadr": "إِذا رامَ مِنها مَطلَعاً رَدَّ شَأوَهُ",
      "ajuz": "أَمينُ القُوى عَضَّ اليَدَينِ فَأَوجَعا"
    },
    {
      "n": 53,
      "sadr": "بِأَكبَرَ مِن وَجدٍ بِرَيّا وَجَدتُهُ",
      "ajuz": "غَداةَ دَعا داعي الفِراقِ فَأَسمَعا"
    },
    {
      "n": 54,
      "sadr": "وَلا بَكرَةٍ بِكرٍ رَأَت مِن حُوارِها",
      "ajuz": "مَجَرّاً حَديثاً مُستَبيناً وَمَصرَعا"
    },
    {
      "n": 55,
      "sadr": "إِذا رَجَّعَت في آخِرِ اللَّيلِ حَنَّةً",
      "ajuz": "لِذِكرِ حَديثٍ أَبكَتِ البُزلَ أَجمَعا"
    },
    {
      "n": 56,
      "sadr": "لَقَد خِفتُ أَن لا تَقنَعَ النَّفسُ بَعدَها",
      "ajuz": "بِشَيءٍ مِنَ الدُّنيا وَإِن كانَ مَقنَعا"
    },
    {
      "n": 57,
      "sadr": "وَأَعذُلُ فيها النَّفسَ إِذ حيلَ دونَها",
      "ajuz": "وَتَأبى إِلَيهِ النَّفسُ إِلّا تَطَلُّعا"
    },
    {
      "n": 58,
      "sadr": "سَلامٌ عَلى الدُّنيا فَما هِيَ راحَةٌ",
      "ajuz": "إِذا لَم يَكُن شَملي وَشَملُكُمُ مَعا"
    },
    {
      "n": 59,
      "sadr": "وَلا مَرحَباً بِالرَّبعِ لَستُم حُلولَهُ",
      "ajuz": "وَلَو كانَ مُخضَلَّ الجَوانِبِ مُمرِعا"
    },
    {
      "n": 60,
      "sadr": "فَماءٌ بِلا مَرعىً وَمَرعىً بِغَيرِ ما",
      "ajuz": "وَحَيثُ أَرى ماءً وَمَرعىً فَمَسبَعا"
    },
    {
      "n": 61,
      "sadr": "لَعَمري لَقَد نادى مُنادي فِراقِنا",
      "ajuz": "بِتَشتيتِنا في كُلِّ وادٍ فَأَسمَعا"
    },
    {
      "n": 62,
      "sadr": "كَأَنّا خُلِقنا لِلنَّوى وَكَأَنَّما",
      "ajuz": "حَرامٌ عَلى الأَيّامِ أَن نَتَجَمَّعا"
    }
  ]
}
