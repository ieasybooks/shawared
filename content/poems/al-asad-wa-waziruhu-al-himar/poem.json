{
  "id": "al-asad-wa-waziruhu-al-himar",
  "poet": "ahmad-shawqi",
  "title": "الأَسَدُ وَوَزيرُهُ الحِمارُ",
  "meter": "mujtath",
  "themes": ["fables", "politics"],
  "rawiy": "ر",
  "abyat_in_full": 16,
  "added": "2026-11-24",
  "abyat": [
    {"n": 1, "sadr": "اللَّيثُ مَلكُ القِفارِ", "ajuz": "وَما تَضُمُّ الصَّحاري"},
    {"n": 2, "sadr": "سَعَت إِلَيهِ الرَّعايا", "ajuz": "يَوماً بِكُلِّ اِنكِسارِ"},
    {"n": 3, "sadr": "قالَت تَعيشُ وَتَبقى", "ajuz": "يا دامِيَ الأَظفارِ"},
    {"n": 4, "sadr": "ماتَ الوَزيرُ فَمَن ذا", "ajuz": "يَسوسُ أَمرَ الضَّواري"},
    {"n": 5, "sadr": "قالَ الحِمارُ وَزيري", "ajuz": "قَضى بِهَذا اِختِياري"},
    {"n": 6, "sadr": "فَاستَضحَكَت ثُمَّ قالَت", "ajuz": "ماذا رَأى في الحِمارِ"},
    {"n": 7, "sadr": "وَخَلَّفَتهُ وَطارَت", "ajuz": "بِمُضحِكِ الأَخبارِ"},
    {"n": 8, "sadr": "حَتّى إِذا الشَّهرُ وَلّى", "ajuz": "كَلَيلَةٍ أَو نَهارِ"},
    {"n": 9, "sadr": "لَم يَشعُرِ اللَّيثُ إِلّا", "ajuz": "وَمُلكُهُ في دَمارِ"},
    {"n": 10, "sadr": "القِردُ عِندَ اليَمينِ", "ajuz": "وَالكَلبُ عِندَ اليَسارِ"},
    {"n": 11, "sadr": "وَالقِطُّ بَينَ يَدَيهِ", "ajuz": "يَلهو بِعَظمَةِ فارِ"},
    {"n": 12, "sadr": "فَقالَ مَن في جُدودي", "ajuz": "مِثلي عَديمُ الوَقارِ"},
    {"n": 13, "sadr": "أَينَ اِقتِداري وَبَطشي", "ajuz": "وَهَيبَتي وَاعتِباري"},
    {"n": 14, "sadr": "فَجاءَهُ القِردُ سِرّاً", "ajuz": "وَقالَ بَعدَ اِعتِذارِ"},
    {"n": 15, "sadr": "يا عالِيَ الجاهِ فينا", "ajuz": "كُن عالِيَ الأَنظارِ"},
    {"n": 16, "sadr": "رَأيُ الرَّعِيَّةِ فيكُم", "ajuz": "مِن رَأيِكُم في الحِمارِ"}
  ]
}
