{
  "id": "ya-daru-ma-faalat",
  "poet": "abu-nuwas",
  "title": "يا دارُ ما فَعَلَت بِكِ الأَيّامُ",
  "meter": "kamil",
  "rawiy": "م",
  "abyat_in_full": 20,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "يا دارُ ما فَعَلَت بِكِ الأَيّامُ",
      "ajuz": "ضامَتكِ وَالأَيّامُ لَيسَ تُضامُ"
    },
    {
      "n": 2,
      "sadr": "عَرَمَ الزَّمانُ عَلى الَّذينَ عَهِدتُهُم",
      "ajuz": "بِكِ قاطِنينَ وَلِلزَّمانِ عُرامُ"
    },
    {
      "n": 3,
      "sadr": "أَيّامَ لا أَغشى لِأَهلِكِ مَنزِلاً",
      "ajuz": "إِلّا مُراقَبَةً عَلَيَّ ظَلامُ"
    },
    {
      "n": 4,
      "sadr": "وَلَقَد نَهَزتُ مَعَ الغُواةِ بِدَلوِهِم",
      "ajuz": "وَأَسَمتُ سَرحَ اللَّهوِ حَيثُ أَساموا"
    },
    {
      "n": 5,
      "sadr": "وَبَلَغتُ ما بَلَغَ اِمرُؤٌ بِشَبابِهِ",
      "ajuz": "فَإِذا عُصارَةُ كُلِّ ذاكَ أَثامُ"
    },
    {
      "n": 6,
      "sadr": "وَتَجَشَّمَت بي هَولَ كُلِّ تَنوفَةٍ",
      "ajuz": "هَوجاءُ فيها جُرأَةٌ إِقدامُ"
    },
    {
      "n": 7,
      "sadr": "تَذَرُ المَطِيَّ وَراءَها فَكَأَنَّها",
      "ajuz": "صَفٌّ تَقَدَّمُهُنَّ وَهيَ إِمامُ"
    },
    {
      "n": 8,
      "sadr": "وَإِذا المَطِيُّ بِنا بَلَغنَ مُحَمَّداً",
      "ajuz": "فَظُهورُهُنَّ عَلى الرِّجالِ حَرامُ"
    },
    {
      "n": 9,
      "sadr": "قَرَّبنَنا مِن خَيرِ مَن وَطِئَ الحَصى",
      "ajuz": "فَلَها عَلَينا حُرمَةٌ وَذِمامُ"
    },
    {
      "n": 10,
      "sadr": "رُفِعَ الحِجابُ لَنا فَلاحَ لِناظِرٍ",
      "ajuz": "قَمَرٌ تَقَطَّعُ دونَهُ الأَوهامُ"
    },
    {
      "n": 11,
      "sadr": "مَلِكٌ إِذا عَلِقَت يَداكَ بِحَبلِهِ",
      "ajuz": "لا يَعتَريكَ البُؤسُ وَالإِعدامُ"
    },
    {
      "n": 12,
      "sadr": "مَلِكٌ تَوَحَّدَ بِالمَكارِمِ وَالعُلى",
      "ajuz": "فَردٌ فَقيدُ النِّدِّ فيهِ هُمامُ"
    },
    {
      "n": 13,
      "sadr": "مَلِكٌ أَغَرُّ إِذا شَرِبتَ بِوَجهِهِ",
      "ajuz": "لَم يَعدُكَ التَّبجيلُ وَالإِعظامُ"
    },
    {
      "n": 14,
      "sadr": "فَالبَهوُ مُشتَمِلٌ بِبَدرِ خِلافَةٍ",
      "ajuz": "لَبِسَ الشَّبابَ بِنورِهِ الإِسلامُ"
    },
    {
      "n": 15,
      "sadr": "سَبطُ البَنانِ إِذا اِحتَبى بِنِجادِهِ",
      "ajuz": "فَرَعَ الجَماجِمَ وَالسِّماطُ قِيامُ"
    },
    {
      "n": 16,
      "sadr": "إِنَّ الَّذي يَرضى الإِلَهُ بِهَديِهِ",
      "ajuz": "مَلِكٌ تَرَدّى المُلكَ وَهوَ غُلامُ"
    },
    {
      "n": 17,
      "sadr": "مَلِكٌ إِذا اِعتَسَرَ الأُمورَ مَضى بِهِ",
      "ajuz": "رَأيٌ يَفُلُّ السَّيفَ وَهوَ حُسامُ"
    },
    {
      "n": 18,
      "sadr": "داوى بِهِ اللَّهُ القُلوبَ مِنَ العَمى",
      "ajuz": "حَتّى أَفَقنَ وَما بِهِنَّ سَقامُ"
    },
    {
      "n": 19,
      "sadr": "أَصبَحتَ يا اِبنَ زُبَيدَةَ اِبنَةِ جَعفَرٍ",
      "ajuz": "أَمَلاً لِعَقدِ حِبالِهِ اِستِحكامُ"
    },
    {
      "n": 20,
      "sadr": "فَسَلِمتَ لِلأَمرِ الَّذي تُرجى لَهُ",
      "ajuz": "وَتَقاعَسَت عَن يَومِكَ الأَيّامُ"
    }
  ]
}
