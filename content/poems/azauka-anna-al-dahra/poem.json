{
  "id": "azauka-anna-al-dahra",
  "poet": "ibn-al-rumi",
  "title": "عَزاؤُكَ أَنَّ الدَّهرَ ذو فَجَعاتِ",
  "meter": "tawil",
  "themes": ["ritha", "hikma"],
  "rawiy": "ت",
  "abyat_in_full": 61,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "عَزاؤُكَ أَنَّ الدَّهرَ ذو فَجَعاتِ",
      "ajuz": "وَكُلُّ جَميعٍ صائِرٌ لِشَتاتِ"
    },
    {
      "n": 2,
      "sadr": "لَكَ الخَيرُ كَم أَبصَرتَهُ وَسَمِعتَهُ",
      "ajuz": "قَرائِنَ حَيٍّ غَيرَ مُختَلَجاتِ"
    },
    {
      "n": 3,
      "sadr": "هَلِ النّاسُ إِلّا مَعشَرٌ مِن سُلالَةٍ",
      "ajuz": "تَعودُ رُفاتاً ثُمَّ أَيَّ رُفاتِ"
    },
    {
      "n": 4,
      "sadr": "مِياهٌ مَهيناتٌ يَؤولُ مَآلُها",
      "ajuz": "إِلى رِمَمٍ مِن أَعظُمٍ نَخِراتِ"
    },
    {
      "n": 5,
      "sadr": "أَرى الدَّهرَ ظَهراً لا يَزالُ بِراكِبٍ",
      "ajuz": "وَإِن زَلَّ لَم يُؤمَن مِنَ العَثَراتِ"
    },
    {
      "n": 6,
      "sadr": "وَمِن عَجَبٍ أَن كُلَّما جَدَّ رَكضُنا",
      "ajuz": "عَلَيهِ تَباعَدنا مِنَ الطَّلِباتِ"
    },
    {
      "n": 7,
      "sadr": "وَأَعجَبُ مِنهُ حِرصُنا كُلَّما خَلَت",
      "ajuz": "سِنونا كَأَنّا مِن بَني العَشَراتِ"
    },
    {
      "n": 8,
      "sadr": "نُخَلِّفُ مَأمولاتِنا وَكَأَنَّنا",
      "ajuz": "نَسيرُ إِلَيها لا إِلى الغَمَراتِ"
    },
    {
      "n": 9,
      "sadr": "غُرِرنا وَأُنذِرنا بِدَهرٍ أَمَلَّنا",
      "ajuz": "غُروراً وَإِنذاراً بِهاكَ وَهاتِ"
    },
    {
      "n": 10,
      "sadr": "إِذا مَجَّ مَجّاتٍ مِنَ الأَريِ أَعقَبَت",
      "ajuz": "بِأَقصى سِهامٍ في أَحَدِّ حُماتِ"
    },
    {
      "n": 11,
      "sadr": "أَميري وَأَنتَ المَرءُ يَنجُمُ رَأيُهُ",
      "ajuz": "فَيَسري بِهِ السّارونَ في الظُّلُماتِ"
    },
    {
      "n": 12,
      "sadr": "وَتَعصِفُ ريحُ الخَطبِ عِندَ هُبوبِها",
      "ajuz": "وَأَنتَ كَرُكنِ الطَّودِ ذي الهَضَباتِ"
    },
    {
      "n": 13,
      "sadr": "عَلَيكَ بِتَقوى اللَّهِ وَالصَّبرِ إِنَّهُ",
      "ajuz": "مَعاذٌ وَإِنَّ الدَّهرَ ذو سَطَواتِ"
    },
    {
      "n": 14,
      "sadr": "وَلَيسَ حَكيمُ القَومِ بِالرَّجُلِ الَّذي",
      "ajuz": "تَكونُ الرَّزايا عِندَهُ نَقِماتِ"
    },
    {
      "n": 15,
      "sadr": "فُجِعتَ فَلا عادَت إِلَيكَ فَجيعَةٌ",
      "ajuz": "كَما يُفجَعُ الأَملاكُ بِالمَلِكاتِ"
    },
    {
      "n": 16,
      "sadr": "أُصِبتَ وَكُلٌّ قَد أُصيبَ بِنَكبَةٍ",
      "ajuz": "يُهاضُ بِها الماضي مِنَ النَّكَباتِ"
    },
    {
      "n": 17,
      "sadr": "فَلا تَجزَعَن مِنها وَإِن كانَ مِثلُها",
      "ajuz": "زَعيماً بِنَفرِ الجَأشِ ذي السَّكَناتِ"
    },
    {
      "n": 18,
      "sadr": "وَما نَفرُ نَفسٍ مِن حُلولِ مُصيبَةٍ",
      "ajuz": "وَقَد أَيقَنَت قِدماً بِما هُوَ آتِ"
    },
    {
      "n": 19,
      "sadr": "أَتوقِنُ بِالمَقدورِ قَبلَ وُقوعِهِ",
      "ajuz": "وَتَنفِرُ نَفرَ الغِرِّ ذي الغَفَلاتِ"
    },
    {
      "n": 20,
      "sadr": "لَقَد أونِسَت حَتّى لَقَد حانَ أُنسُها",
      "ajuz": "بِما شاهَدَت لِلدَّهرِ مِن وَقَعاتِ"
    },
    {
      "n": 21,
      "sadr": "فَما بالُها نَفرُ الأَغِرّاءِ نَفرُها",
      "ajuz": "وَقَد أُنذِرَت مِن قَبلُ بِالمَثُلاتِ"
    },
    {
      "n": 22,
      "sadr": "مَنِ اِحتَسَبَ الأَقدارَ أَيقَنَ فَاستَوَت",
      "ajuz": "لَدَيهِ مُنيخاتٍ وَمُنتَظَراتِ"
    },
    {
      "n": 23,
      "sadr": "هَلِ المَرءُ في الدُّنيا الدَّنِيَّةِ ناظِرٌ",
      "ajuz": "سِوى فَقدِ حِبٍّ أَو لِقاءِ مَماتِ"
    },
    {
      "n": 24,
      "sadr": "أَلَم تَرَ غاراتِ الخُطوبِ مُلِحَّةً",
      "ajuz": "فَبَينَ مُغاداةٍ وَبَينَ ثَباتِ"
    },
    {
      "n": 25,
      "sadr": "تَروحُ وَتَغدو غَيرَ ذاتِ وَنِيَّةٍ",
      "ajuz": "عَلى حَيَوانٍ مَرَّةً وَمَواتِ"
    },
    {
      "n": 26,
      "sadr": "وَما حَرَكاتُ الدَّهرِ في كُلِّ طَرفَةٍ",
      "ajuz": "بِلاهِيَةٍ عَن هَذِهِ الحَرَكاتِ"
    },
    {
      "n": 27,
      "sadr": "سَيَسقي بَني الدُّنيا كُؤوسَ حُتوفِهِم",
      "ajuz": "إِلى أَن يَناموا لا مَنامَ سُباتِ"
    },
    {
      "n": 28,
      "sadr": "وَفاءٌ مِنَ الأَيّامِ لا شَكَّ غَدرُها",
      "ajuz": "وَهَل هُنَّ إِلّا مُنجِزاتُ عِداتِ"
    },
    {
      "n": 29,
      "sadr": "يَعِدنَ بِغَدرٍ لَيسَ بِالمُخلِفاتِهِ",
      "ajuz": "فَقُل في وَفاءٍ مِن أَخي غَدَراتِ"
    },
    {
      "n": 30,
      "sadr": "تَعَزَّ بِمَوتِ الصّيدِ مِن آلِ مُصعَبٍ",
      "ajuz": "تَجِدهُم أُسىً إِن شِئتَ أَو قُدُواتِ"
    },
    {
      "n": 31,
      "sadr": "تَعَزَّوا وَقَد نابَتهُمُ كُلُّ نَوبَةٍ",
      "ajuz": "وَماتوا فَعَزَّوا كُلَّ ذي حَسَراتِ"
    },
    {
      "n": 32,
      "sadr": "وَمِن سُنَنِ اللَّهِ الَّتي سَنَّ في الوَرى",
      "ajuz": "إِذا جالَتِ الآراءُ مُعتَبِراتِ"
    },
    {
      "n": 33,
      "sadr": "زَوالُ أُصولِ النّاسِ قَبلَ فُروعِهِم",
      "ajuz": "وَتِلكَ وَهَذي غَيرُ ذاتِ ثَباتِ"
    },
    {
      "n": 34,
      "sadr": "لِيَبقى جَديدٌ بَعدَ بالٍ وَكُلُّهُم",
      "ajuz": "سَيَبلى عَلى الصَّيفاتِ وَالشَّتَواتِ"
    },
    {
      "n": 35,
      "sadr": "وَإِن زالَ فَرعٌ قَبلَ أَصلٍ فَإِنَّما",
      "ajuz": "تُعَدُّ مِنَ الأَحداثِ وَالفَلَتاتِ"
    },
    {
      "n": 36,
      "sadr": "وَتِلكَ قَضايا اللَّهِ جَلَّ ثَناؤُهُ",
      "ajuz": "وَلَيسَت قَضايا اللَّهِ بِالهَفَواتِ"
    },
    {
      "n": 37,
      "sadr": "لِيُعلَمَ أَلّا مَوتَ مَيتٍ لِكِبرَةٍ",
      "ajuz": "وَلا عَيشَ حَيٍّ لِاقتِبالِ نَباتِ"
    },
    {
      "n": 38,
      "sadr": "وَتَقديمُ مَن قَدَّمتَ شَيءٌ بِحَقِّهِ",
      "ajuz": "فَدَع عَنكَ سَحَّ الدَّمعِ وَالزَّفَراتِ"
    },
    {
      "n": 39,
      "sadr": "وَلا تَسخَطِ الحَقَّ الَّذي وافَقَ الهُدى",
      "ajuz": "هَوى مَن لَهُ أَمسَيتَ في كُرُباتِ"
    },
    {
      "n": 40,
      "sadr": "رُزِئتَ الَّتي وَدَّت بَقاءَكَ بَعدَها",
      "ajuz": "وَأَحيَت بِهِ في لَيلِها الدَّعَواتِ"
    },
    {
      "n": 41,
      "sadr": "وَكانَت تَمَنّى أَن تُرَدّى سَريرَها",
      "ajuz": "وَبَعضُ أَمانِيِّ النُّفوسِ مُواتي"
    },
    {
      "n": 42,
      "sadr": "فَلا تَكرَهَن أَن أوتِيَت ما تَوَدُّهُ",
      "ajuz": "فَكُرهُكَ ما وَدَّت مِنَ النُّكُراتِ"
    },
    {
      "n": 43,
      "sadr": "أَلَم تَرَ رُزءَ الدَّهرِ مِن قَبلِ كَونِهِ",
      "ajuz": "كِفاحاً إِذا فَكَّرتَ في الخَلَواتِ"
    },
    {
      "n": 44,
      "sadr": "بَلى كُنتَ تَلقاهُ وَإِن كانَ غائِباً",
      "ajuz": "بِفِكرِكَ إِنَّ الفِكرَ ذو غَزَواتِ"
    },
    {
      "n": 45,
      "sadr": "فَما لَكَ كَالمَرمِيِّ مِن مَأمَنٍ لَهُ",
      "ajuz": "بِنَبلٍ أَبَتهُ غَيرَ مُرتَقَباتِ"
    },
    {
      "n": 46,
      "sadr": "زَعِ القَلبَ إِنَّ الفاجِعاتِ مَصائِبٌ",
      "ajuz": "أَصابَت وَكانَت قَبلُ مُحتَسَباتِ"
    },
    {
      "n": 47,
      "sadr": "فَإِن قُلتَ مَكروهٌ أَلَمَّت فُجاءَةً",
      "ajuz": "فَما فوجِئَت نَفسٌ مَعَ الخَطَراتِ"
    },
    {
      "n": 48,
      "sadr": "وَلا غوفِصَت نَفسٌ بِبَلوى وَقَد رَأَت",
      "ajuz": "عِظاتٍ مِنَ الأَيّامِ بَعدَ عِظاتِ"
    },
    {
      "n": 49,
      "sadr": "إِذا بَغَتَت أَشياءُ قَد كانَ مِثلُها",
      "ajuz": "قَديماً فَلا تَعتَدَّها بَغَتاتِ"
    },
    {
      "n": 50,
      "sadr": "جَزِعتَ وَأَنتَ المَرءُ يوصَفُ حَزمُهُ",
      "ajuz": "وَلا بُدَّ لِلأَيقاظِ مِن رَقَداتِ"
    },
    {
      "n": 51,
      "sadr": "فَأَعقِب مِنَ النَّومِ التَّنَبُّهَ راشِداً",
      "ajuz": "فَلا بُدَّ لِلنُّوّامِ مِن يَقَظاتِ"
    },
    {
      "n": 52,
      "sadr": "وَمَن راغَمَ الشَّيطانَ مِثلَكَ لَم يُجِب",
      "ajuz": "رُقاهُ وَلَم يَتبَع لَهُ خُطُواتِ"
    },
    {
      "n": 53,
      "sadr": "وَمِمّا يُنَسّيكَ الأَسى حَسَناتُها",
      "ajuz": "وَإِن كُنتَ مِنها يا أَخا الحَسَناتِ"
    },
    {
      "n": 54,
      "sadr": "فَإِنَّ ثَوابَ اللَّهِ في رُزءِ مِثلِها",
      "ajuz": "لِقاؤُكَها في أَرفَعِ الدَّرَجاتِ"
    },
    {
      "n": 55,
      "sadr": "وَذاكَ إِذا قَضَّيتَ كُلَّ لُبانَةٍ",
      "ajuz": "مِنَ المَجدِ وَاستَمتَعتَ بِالمُتُعاتِ"
    },
    {
      "n": 56,
      "sadr": "مَضَت بَعدَما مُدَّت عَلى الأَرضِ بُرهَةً",
      "ajuz": "لِتُمجِدَ مَن فيها مِنَ البَرَكاتِ"
    },
    {
      "n": 57,
      "sadr": "فَإِن تَكُ طوبى راجَعَت أَخَواتِها",
      "ajuz": "فَقَد زُوِّدَت مِن طَيِّبِ الثَّمَراتِ"
    },
    {
      "n": 58,
      "sadr": "لَعَمرُكَ ما زُفَّت إِلى قَعرِ حُفرَةٍ",
      "ajuz": "وَلَكِنَّها زُفَّت إِلى الغُرُفاتِ"
    },
    {
      "n": 59,
      "sadr": "وَلَولاكَ قُلنا مَن يَقومُ مَقامَها",
      "ajuz": "وَمَن يُؤثِرُ التَّقوى عَلى الشُّبُهاتِ"
    },
    {
      "n": 60,
      "sadr": "سَقاها مَعَ الدَّمعِ الَّذي بُكِيَت بِهِ",
      "ajuz": "حَيا الغَيثِ في الرَّوحاتِ وَالغَدَواتِ"
    },
    {
      "n": 61,
      "sadr": "وَصَلّى عَلَيها كُلَّما ذَرَّ شارِقٌ",
      "ajuz": "وَحانَ غُروبٌ صاحِبُ الصَّلَواتِ"
    }
  ]
}
