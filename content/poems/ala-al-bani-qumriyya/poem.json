{
  "id": "ala-al-bani-qumriyya",
  "poet": "al-malik-al-amjad",
  "title": "عَلى البانِ قُمرِيَّةٌ تَسجَعُ",
  "meter": "mutaqarib",
  "rawiy": "ع",
  "abyat_in_full": 44,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1,  "sadr": "عَلى البانِ قُمرِيَّةٌ تَسجَعُ", "ajuz": "وَثَوبُ الدُّجى مُسبَلٌ أَسفَعُ" },
    { "n": 2,  "sadr": "تَغَنَّت فَسَحَّت وَقَد جَدَّدَت", "ajuz": "غَرامي عَلى الطَّلَلِ الأَدمُعُ" },
    { "n": 3,  "sadr": "ذَكَرتُ بِهِ جيرَةً قَوَّضوا", "ajuz": "عَنِ الخَيفِ لَيلاً وَما وَدَّعوا" },
    { "n": 4,  "sadr": "فَأَمطَرتُ مَربَعَهُم أَدمُعي", "ajuz": "فَكادَ يَرِقُّ لِيَ المَربَعُ" },
    { "n": 5,  "sadr": "وَعَينٌ تُفارِقُ أَحبابَها", "ajuz": "وَأُلّافَها كَيفَ لا تَدمَعُ" },
    { "n": 6,  "sadr": "شَكَوتُ إِلى الدّارِ مِن بَعدِهِم", "ajuz": "أَذى البَينِ لَو أَنَّها تَسمَعُ" },
    { "n": 7,  "sadr": "فَلَم تُغنِ شَكوى إِلى دِمنَةٍ", "ajuz": "يُهَيِّجُني رَسمُها البَلقَعُ" },
    { "n": 8,  "sadr": "وَكَيفَ أُرى جَذِلاً بَعدَما", "ajuz": "خَلَت مِن جَآذِرِها الأَربُعُ" },
    { "n": 9,  "sadr": "لَقَد عَفَّتِ الرّيحُ آثارَها", "ajuz": "فَريحُ غَرامي بِها زَعزَعُ" },
    { "n": 10, "sadr": "وَما الوَجدُ إِلّا حَشىً خافِقٌ", "ajuz": "وَقَلبٌ لِفُرقَتِهِم موجَعُ" },
    { "n": 11, "sadr": "وَنارُ فِراقٍ عَلى حَرِّها", "ajuz": "لِبَينِهِمُ تَنطَوي الأَضلُعُ" },
    { "n": 12, "sadr": "وَطَرفٌ إِذا ما رَأى بارِقاً", "ajuz": "فَلَيسَ يَغيضُ وَلا يَهجَعُ" },
    { "n": 13, "sadr": "لَقَد شاقَني البَرقُ لَمّا بَدا", "ajuz": "خِلالَ الدُّجى وَمضُهُ يَلمَعُ" },
    { "n": 14, "sadr": "فَأَذكَرَني ثَغرَ سُعدى وَقَد", "ajuz": "تَزَحزَحَ عَن بَرقِهِ البُرقُعُ" },
    { "n": 15, "sadr": "وَجَرَّعَني كَأسَ دَمعي وَقَد", "ajuz": "تَعَرَّضَ مِن دونِها الأَجرَعُ" },
    { "n": 16, "sadr": "فَكَم لَيلَةٍ بِتُّ لَمّا نَأَت", "ajuz": "عَنِ الجِزعِ مِن بَينِها أَجزَعُ" },
    { "n": 17, "sadr": "وَلَولا هَواها لَما أَرقَلَت", "ajuz": "إِلَيها بِيَ الأَينُقُ الظُّلَّعُ" },
    { "n": 18, "sadr": "تَدافَعُ في الخَرقِ مَزمومَةً", "ajuz": "فَتَذرَعُ شُقَّتَها الأَذرُعُ" },
    { "n": 19, "sadr": "لَواغِبَ تَهوي إِلى حَيِّها", "ajuz": "وَقَد فاتَها الرَّعيُ وَالمَكرَعُ" },
    { "n": 20, "sadr": "جَوانِحَ نَشأى القَطا كُلَّما", "ajuz": "تَقاضَيتُها أَو بَدا لَعلَعُ" },
    { "n": 21, "sadr": "وَلَولا هَوايَ لَقَد عاقَها", "ajuz": "وَجاها عَنِ الوَخدِ وَاليَرمَعُ" },
    { "n": 22, "sadr": "يُنازِعُني الشَّوقُ نَحوَ الحِمى", "ajuz": "وَأَحفِزُها فَهيَ بي تَنزِعُ" },
    { "n": 23, "sadr": "وَإِن رَدَّدَ الرَّكبُ ذِكرَ الهَوى", "ajuz": "سَرَت وَالطَّريقُ بِها مَهيَعُ" },
    { "n": 24, "sadr": "فَتَأتي طِلاحاً رُبى حاجِرٍ", "ajuz": "وَهُنَّ بِنا لُغَّبٌ خُضَّعُ" },
    { "n": 25, "sadr": "أَجوبُ الظَّلامَ وَأَهوالَهُ", "ajuz": "وَعَزمي إِذا جُبتُهُ الأَدرُعُ" },
    { "n": 26, "sadr": "أَرومُ سُعادَ وَقَلبي بِها", "ajuz": "وَإِن قَرُبَت أَو نَأَت مولَعُ" },
    { "n": 27, "sadr": "لَقَد غَدَرَت بي وَما خُنتُها", "ajuz": "فَيا بِئسَ ما أَصبَحَت تَصنَعُ" },
    { "n": 28, "sadr": "وَلَم يَبرَحِ الغَدرُ لِلغادِري", "ajuz": "نَ دَأباً إِذا حُفِظوا ضَيَّعوا" },
    { "n": 29, "sadr": "فَهَل لي شَفيعٌ إِلى قُربِها", "ajuz": "وَهَل لِوِصالٍ مَضى مَرجِعُ" },
    { "n": 30, "sadr": "أَبَعدَ المَشيبِ أَرومُ الشَّفيعَ", "ajuz": "وَهَيهاتَ بانَ الَّذي يَشفَعُ" },
    { "n": 31, "sadr": "وَلَم يَبقَ إِلّا بَياضٌ يَسوءُ", "ajuz": "عُيونَ الغَواني وَلا يَنفَعُ" },
    { "n": 32, "sadr": "شَبابُ الفَتى دونَ هِجرانِهِ", "ajuz": "إِذا رُمنَ هِجرانَهُ يَمنَعُ" },
    { "n": 33, "sadr": "أَلا قَرَّبَ اللَّهُ أَحبابَنا", "ajuz": "وَإِن هَجَرونا وَإِن أَزمَعوا" },
    { "n": 34, "sadr": "فَفي قُربِ حُبِّهِمُ راحَةٌ", "ajuz": "وَإِن لَم يَكُن فيهِمُ مَطمَعُ" },
    { "n": 35, "sadr": "قَنَعتُ بِقُربِهِمُ طائِعاً", "ajuz": "وَفي قُربِ دارِهِمُ مَقنَعُ" },
    { "n": 36, "sadr": "فَما العَيشُ إِلّا دُنُوُّ الدِّيارِ", "ajuz": "إِذا كانَ شَملي بِهِم يُجمَعُ" },
    { "n": 37, "sadr": "إِذا ما خَلَونا شَكَونا الهَوى", "ajuz": "وَفاضَت مَدامِعُنا الهُمَّعُ" },
    { "n": 38, "sadr": "وَحَدَّثتُها عَن زَمانِ الوِصالِ", "ajuz": "حَديثاً يَلَذُّ بِهِ المَسمَعُ" },
    { "n": 39, "sadr": "وَزادَ الحَنينُ إِلى عَصرِهِ", "ajuz": "إِلى أَن أَقَضَّ بِيَ المَضجَعُ" }
  ]
}
