{
  "id": "manalu-al-ula",
  "poet": "ibn-al-muqarrab",
  "title": "مَنالُ العُلا بِالمُرهَفاتِ القَواضِبِ",
  "meter": "tawil",
  "rawiy": "ب",
  "abyat_in_full": 47,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "مَنالُ العُلا بِالمُرهَفاتِ القَواضِبِ", "ajuz": "وَسُمرِ العَوالي وَالعِتاقِ الشَّوازِبِ" },
    { "n": 2,  "sadr": "وَطَعنٍ إِذا ما النَّقعُ ثارَ وَأَقبَلَت", "ajuz": "بَنو الحَربِ أَمثالَ الجِمالِ المَصاعِبِ" },
    { "n": 3,  "sadr": "وَضَربٍ يُزيلُ الهامَ عَن كُلِّ ماجِدٍ", "ajuz": "عَلى الهَولِ مِقدامٍ كَريمِ المَناسِبِ" },
    { "n": 4,  "sadr": "وَلَيسَ يَنالُ المَجدَ مَن كانَ هَمُّهُ", "ajuz": "طُروقُ الأَغاني أَو عِناقُ الحَبائِبِ" },
    { "n": 5,  "sadr": "وَلا بَلَغَ العَلياءَ إِلّا اِبنُ حُرَّةٍ", "ajuz": "قَليلُ اِفتِكارٍ في وُقوعِ العَواقِبِ" },
    { "n": 6,  "sadr": "جَريءٌ عَلى الأَعداءِ مُرٌّ مَذاقُهُ", "ajuz": "بَعيدُ المَدى جَمُّ النَّدى وَالمَواهِبِ" },
    { "n": 7,  "sadr": "حَليفُ سُرىً جَوّابُ أَرضٍ تَجاوَزَت", "ajuz": "بِهِ العيسُ أَجوازَ القِفارِ السَّباسِبِ" },
    { "n": 8,  "sadr": "وَخاضَت بِهِ الخَيلُ النَّجيعَ وَحُطِّمَت", "ajuz": "عَواليهِ قَسراً في صُدورِ الكَتائِبِ" },
    { "n": 9,  "sadr": "تَعَلَّمَ مِن فِعلِ الأَميرِ مُحَمَّدٍ", "ajuz": "فَأَصبَحَ مَلكاً في أَجَلِّ المَراتِبِ" },
    { "n": 10, "sadr": "فَتىً لَم تَزَل في كُلِّ يَومٍ جِيادُهُ", "ajuz": "يُقَسِّمنَ أَموالَ العَدُوِّ المُحارِبِ" },
    { "n": 11, "sadr": "يَشُنُّ بِها الغاراتِ أَروَعُ ماجِدٌ", "ajuz": "سَريعٌ إِلى الجُلّى بَعيدُ المَطالِبِ" },
    { "n": 12, "sadr": "شُجاعٌ إِذا ما أَصبَحَ الحَيُّ لَم يَكُن", "ajuz": "صَبوحُهُمُ إِلّا رِقاقَ المَضارِبِ" },
    { "n": 13, "sadr": "أَزاحَ الأَعادي عَن حِماها وَحازَهُ", "ajuz": "فَأَضحَت لَهُ آسادُها كَالثَّعالِبِ" },
    { "n": 14, "sadr": "فَلَم تَبقَ أَرضٌ لَم تَجُزها جِيادُهُ", "ajuz": "وَقَد حُطِّمَت أَركانُها بِالمَناكِبِ" },
    { "n": 15, "sadr": "فَسائِل بِهِ في الحَربِ أَبناءَ مالِكٍ", "ajuz": "وَما حاضِرٌ في عِلمِهِ مِثلُ غائِبِ" },
    { "n": 16, "sadr": "غَداةَ تَوَلَّوا هارِبينَ وَأَسلَموا", "ajuz": "عَلى الرُّغمِ مِنهُم كُلَّ بَيضاءَ كاعِبِ" },
    { "n": 17, "sadr": "أَتاهُم بِجَيشٍ يَملَأُ الأُفقَ ما لَهُ", "ajuz": "سِوى العِزِّ هَمٌّ مِن شَبابٍ وَشائِبِ" },
    { "n": 18, "sadr": "فَلَمّا رَأَوهُ أَنَّهُ هُوَ لَم يَكُن", "ajuz": "سِلاحُهُمُ إِلّا غُبارَ السَّلاهِبِ" },
    { "n": 19, "sadr": "وَهَل مَنَعَت مِنهُ غُزَيَّةُ دارَها", "ajuz": "بِأَسمَرَ عَسّالٍ وَأَبيَضَ قاضِبِ" },
    { "n": 20, "sadr": "غَداةَ أَتاهُم في سَماءِ عَجاجَةٍ", "ajuz": "أَسِنَّتُهُ مِن تَحتِها كَالكَواكِبِ" },
    { "n": 21, "sadr": "وَقَد جاءَهُم مِنهُ النَّذيرُ لِيَأخُذوا", "ajuz": "مِنَ البَرِّ عَن جَوزِ الطَّريقِ بِجانِبِ" },
    { "n": 22, "sadr": "فَلَم يَقبَلوا قَولَ النَّصيحِ وَأَعرَضوا", "ajuz": "وَظَنّوا ظُنوناً يا لَها مِن كَواذِبِ" },
    { "n": 23, "sadr": "فَصَبَّحَهُم شَعواءَ سَدَّت عَلَيهِمُ", "ajuz": "رِحابَ الفَيافي شَرقَها وَالمَغارِبِ" },
    { "n": 24, "sadr": "فَما لَبِثوا إِلّا فُواقاً وَأَجفَلوا", "ajuz": "كَإِجفالِ شاءٍ مِن ذِئابٍ سَواغِبِ" },
    { "n": 25, "sadr": "وَخَلَّوا عَنِ الأَموالِ صُغراً وَأَسلَموا", "ajuz": "عِذابَ الثَّنايا ضاحِكاتِ التَّرائِبِ" },
    { "n": 26, "sadr": "وَطارَ اِبنُ مَذكورٍ يَشُلُّ قِلاصَهُ", "ajuz": "وَيُنذِرُ مِن غاراتِهِ كُلَّ صاحِبِ" },
    { "n": 27, "sadr": "وَلَم يَرعَ ما قَد كانَ مِن حِلفِ دَهمَشٍ", "ajuz": "وَقالَ الوَفا في مِثلِها غَيرُ واجِبِ" },
    { "n": 28, "sadr": "وَلَمّا أَتَت أَهلُ الشَّآمِ يَقودُها", "ajuz": "إِلَيهِ الرَّدى قَودَ الجَنيبِ لِراكِبِ" },
    { "n": 29, "sadr": "سَعيدٌ وَمَسعودٌ وَرَهطُ حُدَيثَةٍ", "ajuz": "يَسيرونَ جُردَ الخَيلِ بَينَ النَّجائِبِ" },
    { "n": 30, "sadr": "وَقَد حَشَدوا أَهلَ الحِجازِ وَأَقبَلوا", "ajuz": "مِنَ الشّامِ في أَهليهِمُ وَالعَصائِبِ" },
    { "n": 31, "sadr": "أَتاهُم يَجوبُ البيدَ بِالخَيلِ وَالقَنا", "ajuz": "فَتىً عَبدَلِيٌّ في الوَغى غَيرُ هائِبِ" },
    { "n": 32, "sadr": "ضَروبٌ لِهاماتِ الكُماةِ مُعَوَّدٌ", "ajuz": "بِمَنعِ التَّوالي وَابتِذالِ الرَّغائِبِ" },
    { "n": 33, "sadr": "فَلَم يُنجِهِم إِلّا الفِرارُ وَجيرَةٌ", "ajuz": "أَتَت مِنهُ ما فيها مَعابٌ لِعائِبِ" },
    { "n": 34, "sadr": "وَقَد زَعَموا في زَعمِهِم أَنَّ خَيلَهُم", "ajuz": "تَدوسُ قُرى البَحرَينِ مِن كُلِّ جانِبِ" },
    { "n": 35, "sadr": "وَهَيهاتَ ما قَد حاوَلوهُ وَدونَهُ", "ajuz": "سُيوفُ اِبنِ فَضلٍ ذي العُلا وَالمَناقِبِ" },
    { "n": 36, "sadr": "وَفِتيانُ صِدقٍ مِن عُقَيلٍ أَعِزَّةٌ", "ajuz": "ثِقالٌ عَلى الأَعدا كِرامُ المَناسِبِ" },
    { "n": 37, "sadr": "بِهِ بَلَغوا آمالَهُم وَمُناهُمُ", "ajuz": "وَحَلّوا مِنَ العَلياءِ أَعلى المَراتِبِ" },
    { "n": 38, "sadr": "هُوَ الأَسَدُ الضِّرغامُ وَالسَّيِّدُ الَّذي", "ajuz": "بَنى مَجدَهُ فَوقَ النُّجومِ الثَّواقِبِ" },
    { "n": 39, "sadr": "لَهُ خَضَعَت غُلبُ الرِّقابِ وَأَصبَحَت", "ajuz": "بِهِ الأَرضُ تَزهو بَعدَ تِلكَ الغَياهِبِ" },
    { "n": 40, "sadr": "تَرى عِندَهُ رُسلَ المُلوكِ مُقيمَةً", "ajuz": "ذَهابُ رَسولٍ عِندَ آخَرَ آيِبِ" },
    { "n": 41, "sadr": "مَخافَةَ سَطواتٍ لَهُ يَعرِفونَها", "ajuz": "تُقيمُ عَلى الأَعداءِ صَوتَ النَّوادِبِ" },
    { "n": 42, "sadr": "مُوَرَّثَةٍ مِن عَهدِ عادٍ وَجُرهُمٍ", "ajuz": "وُهَيبِ اِبنِ أَفصى وَالقُرونِ الذَّواهِبِ" },
    { "n": 43, "sadr": "وَمالَ أَميرُ المُؤمِنينَ بِوُدِّهِ", "ajuz": "إِلَيهِ وَسَمّاهُ زَعيمَ الأَعارِبِ" },
    { "n": 44, "sadr": "حَمى البَرَّ مِن حَدِّ العِراقِ فَحازَهُ", "ajuz": "إِلى الشّامِ وَاستَولى عَلى حَدِّ ناعِبِ" },
    { "n": 45, "sadr": "فَعَزَّ بِسامي عِزِّهِ كُلُّ خائِفٍ", "ajuz": "مَروعٍ وَأَغنى جودُهُ كُلَّ طالِبِ" },
    { "n": 46, "sadr": "فَلا عَدِمَت يَوماً رَبيعَةُ مِثلَهُ", "ajuz": "لِتَشييدِ عِزٍّ أَو لِبَذلِ مَواهِبِ" },
    { "n": 47, "sadr": "وَلا بَرِحَت أَيّامُهُ في سَعادَةٍ", "ajuz": "وَلا زالَ مَحروسَ الحِمى وَالجَوانِبِ" }
  ]
}
