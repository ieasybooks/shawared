{
  "id": "bi-taybata",
  "poet": "hassan-ibn-thabit",
  "title": "بِطَيبَةَ رَسمٌ لِلرَّسولِ وَمَعهَدُ",
  "meter": "tawil",
  "themes": ["ritha", "prophetic"],
  "rawiy": "د",
  "abyat_in_full": 46,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "بِطَيبَةَ رَسمٌ لِلرَّسولِ وَمَعهَدُ", "ajuz": "مُنيرٌ وَقَد تَعفو الرُّسومُ وَتَهمَدُ" },
    { "n": 2,  "sadr": "وَلا تَنمَحي الآياتُ مِن دارِ حُرمَةٍ", "ajuz": "بِها مِنبَرُ الهادي الَّذي كانَ يَصعَدُ" },
    { "n": 3,  "sadr": "وَواضِحُ آياتٍ وَباقي مَعالِمٍ", "ajuz": "وَرَبعٌ لَهُ فيهِ مُصَلّىً وَمَسجِدُ" },
    { "n": 4,  "sadr": "بِها حُجُراتٌ كانَ يَنزِلُ وَسطَها", "ajuz": "مِنَ اللَّهِ نورٌ يُستَضاءُ وَيوقَدُ" },
    { "n": 5,  "sadr": "مَعالِمُ لَم تُطمَس عَلى العَهدِ آيُها", "ajuz": "أَتاها البِلى فَالآيُ مِنها تَجَدَّدُ" },
    { "n": 6,  "sadr": "عَرَفتُ بِها رَسمَ الرَّسولِ وَعَهدَهُ", "ajuz": "وَقَبراً بِها واراهُ في التُّربِ مُلحِدُ" },
    { "n": 7,  "sadr": "ظَلِلتُ بِها أَبكي الرَّسولَ فَأَسعَدَت", "ajuz": "عُيونٌ وَمِثلاها مِنَ الجَفنِ تُسعِدُ" },
    { "n": 8,  "sadr": "تَذَكَّرُ آلاءَ الرَّسولِ وَما أَرى", "ajuz": "لَها مُحصِياً نَفسي فَنَفسي تَبَلَّدُ" },
    { "n": 9,  "sadr": "مُفَجَّعَةٌ قَد شَفَّها فَقدُ أَحمَدٍ", "ajuz": "فَظَلَّت لِآلاءِ الرَّسولِ تُعَدِّدُ" },
    { "n": 10, "sadr": "وَما بَلَغَت مِن كُلِّ أَمرٍ عَشيرَهُ", "ajuz": "وَلَكِنَّ نَفسي بَعضَ ما فيهِ تَحمَدُ" },
    { "n": 11, "sadr": "أَطالَت وُقوفاً تَذرِفُ العَينُ جُهدَها", "ajuz": "عَلى طَلَلِ القَبرِ الَّذي فيهِ أَحمَدُ" },
    { "n": 12, "sadr": "فَبورِكتَ يا قَبرَ الرَّسولِ وَبورِكَت", "ajuz": "بِلادٌ ثَوى فيها الرَّشيدُ المُسَدَّدُ" },
    { "n": 13, "sadr": "وَبورِكَ لَحدٌ مِنكَ ضُمِّنَ طَيِّباً", "ajuz": "عَلَيهِ بِناءٌ مِن صَفيحٍ مُنَضَّدُ" },
    { "n": 14, "sadr": "تَهيلُ عَلَيهِ التُّربَ أَيدٍ وَأَعيُنٌ", "ajuz": "عَلَيهِ وَقَد غارَت بِذَلِكَ أَسعُدُ" },
    { "n": 15, "sadr": "لَقَد غَيَّبوا حِلماً وَعِلماً وَرَحمَةً", "ajuz": "عَشِيَّةَ عَلَّوهُ الثَّرى لا يُوَسَّدُ" },
    { "n": 16, "sadr": "وَراحوا بِحُزنٍ لَيسَ فيهِم نَبِيُّهُم", "ajuz": "وَقَد وَهَنَت مِنهُم ظُهورٌ وَأَعضُدُ" },
    { "n": 17, "sadr": "يُبَكّونَ مَن تَبكي السَّماواتُ يَومَهُ", "ajuz": "وَمَن قَد بَكَتهُ الأَرضُ فَالنّاسُ أَكمَدُ" },
    { "n": 18, "sadr": "وَهَل عَدَلَت يَوماً رَزِيَّةُ هالِكٍ", "ajuz": "رَزِيَّةَ يَومٍ ماتَ فيهِ مُحَمَّدُ" },
    { "n": 19, "sadr": "تَقَطَّعَ فيهِ مَنزِلُ الوَحيِ عَنهُمُ", "ajuz": "وَقَد كانَ ذا نورٍ يَغورُ وَيُنجِدُ" },
    { "n": 20, "sadr": "يَدُلُّ عَلى الرَّحمَنِ مَن يَقتَدي بِهِ", "ajuz": "وَيُنقِذُ مِن هَولِ الخَزايا وَيُرشِدُ" },
    { "n": 21, "sadr": "إِمامٌ لَهُم يَهديهِمُ الحَقَّ جاهِداً", "ajuz": "مُعَلِّمُ صِدقٍ إِن يُطيعوهُ يَسعَدوا" },
    { "n": 22, "sadr": "عَفُوٌّ عَنِ الزَّلّاتِ يَقبَلُ عُذرَهُم", "ajuz": "وَإِن يُحسِنوا فَاللَّهُ بِالخَيرِ أَجوَدُ" },
    { "n": 23, "sadr": "وَإِن نابَ أَمرٌ لَم يَقوموا بِحَملِهِ", "ajuz": "فَمِن عِندِهِ تَيسيرُ ما يَتَشَدَّدُ" },
    { "n": 24, "sadr": "فَبَينا هُمُ في نِعمَةِ اللَّهِ وَسطَهُم", "ajuz": "دَليلٌ بِهِ نَهجُ الطَّريقَةِ يُقصَدُ" },
    { "n": 25, "sadr": "عَزيزٌ عَلَيهِ أَن يَحيدوا عَنِ الهُدى", "ajuz": "حَريصٌ عَلى أَن يَستَقيموا وَيَهتَدوا" },
    { "n": 26, "sadr": "عَطوفٌ عَلَيهِم لا يُثَنّي جَناحَهُ", "ajuz": "إِلى كَنَفٍ يَحنو عَلَيهِم وَيَمهَدُ" },
    { "n": 27, "sadr": "فَبَينا هُمُ في ذَلِكَ النّورِ إِذ غَدا", "ajuz": "إِلى نورِهِم سَهمٌ مِنَ المَوتِ مُقصِدُ" },
    { "n": 28, "sadr": "فَأَصبَحَ مَحموداً إِلى اللَّهِ راجِعاً", "ajuz": "يُبَكّيهِ جَفنُ المُرسَلاتِ وَيُحمَدُ" },
    { "n": 29, "sadr": "وَأَمسَت بِلادُ الحُرمِ وَحشاً بِقاعُها", "ajuz": "لِغَيبَةِ ما كانَت مِنَ الوَحيِ تَعهَدُ" },
    { "n": 30, "sadr": "قِفاراً سِوى مَعمورَةِ اللَّحدِ ضافَها", "ajuz": "فَقيدٌ يُبَكّيهِ بَلاطٌ وَغَرقَدُ" },
    { "n": 31, "sadr": "وَمَسجِدُهُ فَالموحِشاتُ لِفَقدِهِ", "ajuz": "خَلاءٌ لَهُ فيهِ مَقامٌ وَمَقعَدُ" },
    { "n": 32, "sadr": "وَبِالجَمرَةِ الكُبرى لَهُ ثَمَّ أَوحَشَت", "ajuz": "دِيارٌ وَعَرصاتٌ وَرَبعٌ وَمَولِدُ" },
    { "n": 33, "sadr": "فَبَكّي رَسولَ اللَّهِ يا عَينُ عَبرَةً", "ajuz": "وَلا أَعرِفَنكِ الدَّهرَ دَمعُكِ يَجمُدُ" },
    { "n": 34, "sadr": "وَما لَكِ لا تَبكينَ ذا النِّعمَةِ الَّتي", "ajuz": "عَلى النّاسِ مِنها سابِغٌ يَتَغَمَّدُ" },
    { "n": 35, "sadr": "فَجودي عَلَيهِ بِالدُّموعِ وَأَعوِلي", "ajuz": "لِفَقدِ الَّذي لا مِثلُهُ الدَّهرَ يوجَدُ" },
    { "n": 36, "sadr": "وَما فَقَدَ الماضونَ مِثلَ مُحَمَّدٍ", "ajuz": "وَلا مِثلُهُ حَتّى القِيامَةِ يُفقَدُ" },
    { "n": 37, "sadr": "أَعَفَّ وَأَوفى ذِمَّةً بَعدَ ذِمَّةٍ", "ajuz": "وَأَقرَبَ مِنهُ نائِلاً لا يُنَكَّدُ" },
    { "n": 38, "sadr": "وَأَبذَلَ مِنهُ لِلطَّريفِ وَتالِدٍ", "ajuz": "إِذا ضَنَّ مِعطاءٌ بِما كانَ يُتلَدُ" },
    { "n": 39, "sadr": "وَأَكرَمَ حَيّاً في البُيوتِ إِذا اِنتَمى", "ajuz": "وَأَكرَمَ جَدّاً أَبطَحِيّاً يُسَوَّدُ" },
    { "n": 40, "sadr": "وَأَمنَعَ ذِرواتٍ وَأَثبَتَ في العُلا", "ajuz": "دَعائِمَ عِزٍّ شاهِقاتٍ تُشَيَّدُ" },
    { "n": 41, "sadr": "وَأَثبَتَ فَرعاً في الفُروعِ وَمَنبِتاً", "ajuz": "وَعوداً غَذاهُ المُزنُ فَالعودُ أَغيَدُ" },
    { "n": 42, "sadr": "رَباهُ وَليداً فَاستَتَمَّ تَمامَهُ", "ajuz": "عَلى أَكرَمِ الخَيراتِ رَبٌّ مُمَجَّدُ" },
    { "n": 43, "sadr": "تَناهَت وَصاةُ المُسلِمينَ بِكَفِّهِ", "ajuz": "فَلا العِلمُ مَحبوسٌ وَلا الرَّأيُ يُفنَدُ" },
    { "n": 44, "sadr": "أَقولُ وَلا يُلفى لِقَولِيَ عائِبٌ", "ajuz": "مِنَ النّاسِ إِلّا عازِبُ العَقلِ مُبعَدُ" },
    { "n": 45, "sadr": "وَلَيسَ هَوايَ نازِعاً عَن ثَنائِهِ", "ajuz": "لَعَلّي بِهِ في جَنَّةِ الخُلدِ أَخلُدُ" },
    { "n": 46, "sadr": "مَعَ المُصطَفى أَرجو بِذاكَ جِوارَهُ", "ajuz": "وَفي نَيلِ ذاكَ اليَومِ أَسعى وَأَجهَدُ" }
  ]
}
