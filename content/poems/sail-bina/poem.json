{
  "id": "sail-bina",
  "poet": "atika-bint-abd-al-muttalib",
  "title": "سائِل بِنا في قَومِنا",
  "meter": "kamil",
  "themes": ["fakhr", "hamasa"],
  "rawiy": "ع",
  "abyat_in_full": 6,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "سائِل بِنا في قَومِنا",
      "ajuz": "وَليَكفِ مِن شَرٍّ سَماعُه"
    },
    {
      "n": 2,
      "sadr": "قَيساً وَما جَمَعوا لَنا",
      "ajuz": "في مَجمَعٍ باقٍ شَناعُه"
    },
    {
      "n": 3,
      "sadr": "فيهِ السَّنَوَّرُ وَالقَنا",
      "ajuz": "وَالكَبشُ مُلتَمِعٌ قِناعُه"
    },
    {
      "n": 4,
      "sadr": "بِعُكاظَ يُعشي النّاظِري",
      "ajuz": "نَ إِذا هُمُ لَمَحوا شُعاعُه"
    },
    {
      "n": 5,
      "sadr": "فيهِ قَتَلنا مالِكاً",
      "ajuz": "قَسراً وَأَسلَمَهُ رَعاعُه"
    },
    {
      "n": 6,
      "sadr": "وَمُجَدَّلاً غادَرنَهُ",
      "ajuz": "بِالقاعِ تَنهَشُهُ ضِباعُه"
    }
  ]
}
