{
  "id": "man-raana",
  "poet": "adi-ibn-zayd",
  "title": "مَن رَآنا فَليُحَدِّث نَفسَهُ",
  "meter": "ramal",
  "themes": ["zuhd", "hikma"],
  "rawiy": "ل",
  "abyat_in_full": 7,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "مَن رَآنا فَليُحَدِّث نَفسَهُ",
      "ajuz": "أَنَّهُ موفٍ عَلى قَرنِ زَوال"
    },
    {
      "n": 2,
      "sadr": "وَخُطوبُ الدَّهرِ لا يَبقى لَها",
      "ajuz": "وَلِما تَأتي بِهِ صُمُّ الجِبال"
    },
    {
      "n": 3,
      "sadr": "رُبَّ رَكبٍ قَد أَناخوا عِندَنا",
      "ajuz": "يَشرَبونَ الخَمرَ بِالماءِ الزُّلال"
    },
    {
      "n": 4,
      "sadr": "وَالأَباريقُ عَلَيها فُدُمٌ",
      "ajuz": "وَعِتاقُ الخَيلِ تَردي في الجِلال"
    },
    {
      "n": 5,
      "sadr": "عَمِروا الدَّهرَ بِعَيشٍ حَسَنٍ",
      "ajuz": "آمِني دَهرِهِمُ غَيرَ عِجال"
    },
    {
      "n": 6,
      "sadr": "ثُمَّ أَضحَوا أَخنَعَ الدَّهرُ بِهِم",
      "ajuz": "وَكَذاكَ الدَّهرُ يودي بِالجِبال"
    },
    {
      "n": 7,
      "sadr": "وَكَذاكَ الدَّهرُ يَرمي بِالفَتى",
      "ajuz": "في طِلابِ العَيشِ حالاً بَعدَ حال"
    }
  ]
}
