{
  "id": "ajiddaka-la-yashu",
  "poet": "jarir",
  "title": "أَجِدَّكَ لا يَصحو الفُؤادُ المُعَلَّلُ",
  "meter": "tawil",
  "rawiy": "ل",
  "abyat_in_full": 22,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَجِدَّكَ لا يَصحو الفُؤادُ المُعَلَّلُ",
      "ajuz": "وَقَد لاحَ مِن شَيبٍ عِذارٌ وَمِسحَلُ"
    },
    {
      "n": 2,
      "sadr": "أَلا لَيتَ أَنَّ الظّاعِنينَ بِذي الغَضا",
      "ajuz": "أَقاموا وَبَعضَ الآخَرينَ تَحَمَّلوا"
    },
    {
      "n": 3,
      "sadr": "فَيَوماً يُجارينَ الهَوى غَيرَ ما صِباً",
      "ajuz": "وَيَوماً تَرى مِنهُنَّ غولاً تَغَوَّلُ"
    },
    {
      "n": 4,
      "sadr": "أَلا أَيُّها الوادي الَّذي بانَ أَهلُهُ",
      "ajuz": "فَساكِنُ مَغناهُم حَمامٌ وَدُخَّلُ"
    },
    {
      "n": 5,
      "sadr": "فَمَن راقَبَ الجَوزاءَ أَو باتَ لَيلُهُ",
      "ajuz": "طَويلاً فَلَيلي بِالمَجازَةِ أَطوَلُ"
    },
    {
      "n": 6,
      "sadr": "بَكى دَوبَلٌ لا يُرقِئِ اللَّهُ دَمعَهُ",
      "ajuz": "أَلا إِنَّما يَبكي مِنَ الذُّلِّ دَوبَلُ"
    },
    {
      "n": 7,
      "sadr": "جَزِعتَ اِبنَ ذاتِ القَلسِ لَمّا تَدارَكَت",
      "ajuz": "مِنَ الحَربِ أَنيابٌ عَلَيكَ وَكَلكَلُ"
    },
    {
      "n": 8,
      "sadr": "فَإِنَّكَ وَالجَحّافَ يَومَ تَحُضُّهُ",
      "ajuz": "أَرَدتَ بِذاكَ المُكثَ وَالوِردُ أَعجَلُ"
    },
    {
      "n": 9,
      "sadr": "سَرى نَحوَكُم لَيلٌ كَأَنَّ نُجومَهُ",
      "ajuz": "قَناديلُ فيهِنَّ الذُّبالُ المُفَتَّلُ"
    },
    {
      "n": 10,
      "sadr": "فَما اِنشَقَّ ضَوءُ الصُّبحِ حَتّى تَعَرَّفوا",
      "ajuz": "كَراديسَ يَهديهِنَّ وَردٌ مُحَجَّلُ"
    },
    {
      "n": 11,
      "sadr": "فَقَد قَذَفَت مِن حَربِ قَيسٍ نِساؤُكُم",
      "ajuz": "بِأَولادِها مِنها تَمامٌ وَمُعجَلُ"
    },
    {
      "n": 12,
      "sadr": "وَمَقتولَةٍ صَبراً تَرى عِندَ رِجلِها",
      "ajuz": "بَقيراً وَأُخرى ذاتِ بَعلٍ تُوَلوِلُ"
    },
    {
      "n": 13,
      "sadr": "وَقَد قَتَلَ الجَحّافُ أَولادَ نِسوَةٍ",
      "ajuz": "يَسوقُ اِبنُ خَلّاسٍ بِهِنَّ وَعَزهَلُ"
    },
    {
      "n": 14,
      "sadr": "تَقولُ لَكَ الثَّكلى المُصابُ حَليلُها",
      "ajuz": "أَبا مالِكٍ ما في الظَّعائِنِ مَغزَلُ"
    },
    {
      "n": 15,
      "sadr": "حَضَضتَ عَلى القَومِ الَّذينَ تَرَكتَهُم",
      "ajuz": "تَعُلُّ الرُّدَينِيّاتُ فيهِم وَتَنهَلُ"
    },
    {
      "n": 16,
      "sadr": "عُقابُ المَنايا تَستَديرُ عَلَيهِمُ",
      "ajuz": "وَشُعثُ النَّواصي لُجمُهُنَّ تَصَلصَلُ"
    },
    {
      "n": 17,
      "sadr": "بِدِجلَةَ إِن كَرّوا فَقَيسٌ وَراءَهُم",
      "ajuz": "صُفوفاً وَإِن راموا المَخاضَةَ أَوحَلوا"
    },
    {
      "n": 18,
      "sadr": "وَما زالَتِ القَتلى تَمورُ دِماؤُها",
      "ajuz": "بِدِجلَةَ حَتّى ماءُ دِجلَةَ أَشكَلُ"
    },
    {
      "n": 19,
      "sadr": "فَإِلّا تَعَلَّق مِن قُرَيشٍ بِذِمَّةٍ",
      "ajuz": "فَلَيسَ عَلى أَسيافِ قَيسٍ مُعَوَّلُ"
    },
    {
      "n": 20,
      "sadr": "لَنا الفَضلُ في الدُّنيا وَأَنفُكَ راغِمٌ",
      "ajuz": "وَنَحنُ لَكُم يَومَ القِيامَةِ أَفضَلُ"
    },
    {
      "n": 21,
      "sadr": "وَقَد شَقَّقَت يَومَ الرَّحوبِ سُيوفُنا",
      "ajuz": "عَواتِقَ لَم يَثبُت عَلَيهِنَّ مِحمَلُ"
    },
    {
      "n": 22,
      "sadr": "أَجارَ بَنو مَروانَ مِنهُم دِماءَكُم",
      "ajuz": "فَمَن مِن بَني مَروانَ أَعلى وَأَفضَلُ"
    }
  ]
}
