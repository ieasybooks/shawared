{
  "id": "atani-abayta-al-lana",
  "poet": "al-nabigha-al-dhubyani",
  "title": "أَتاني أَبَيتَ اللَّعنَ أَنَّكَ لُمتَني",
  "meter": "tawil",
  "rawiy": "ب",
  "abyat_in_full": 12,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَتاني أَبَيتَ اللَّعنَ أَنَّكَ لُمتَني",
      "ajuz": "وَتِلكَ الَّتي أَهتَمُّ مِنها وَأَنصَبُ"
    },
    {
      "n": 2,
      "sadr": "فَبِتُّ كَأَنَّ العائِداتِ فَرَشنَني",
      "ajuz": "هَراساً بِهِ يُعلى فِراشي وَيُقشَبُ"
    },
    {
      "n": 3,
      "sadr": "حَلَفتُ فَلَم أَترُك لِنَفسِكَ ريبَةً",
      "ajuz": "وَلَيسَ وَراءَ اللَّهِ لِلمَرءِ مَذهَبُ"
    },
    {
      "n": 4,
      "sadr": "لَئِن كُنتَ قَد بُلِّغتَ عَنّي خِيانَةً",
      "ajuz": "لَمُبلِغُكَ الواشي أَغَشُّ وَأَكذَبُ"
    },
    {
      "n": 5,
      "sadr": "وَلَكِنَّني كُنتُ اِمرَأً لِيَ جانِبٌ",
      "ajuz": "مِنَ الأَرضِ فيهِ مُستَرادٌ وَمَذهَبُ"
    },
    {
      "n": 6,
      "sadr": "مُلوكٌ وَإِخوانٌ إِذا ما أَتَيتُهُم",
      "ajuz": "أُحَكَّمُ في أَموالِهِم وَأُقَرَّبُ"
    },
    {
      "n": 7,
      "sadr": "كَفِعلِكَ في قَومٍ أَراكَ اِصطَنَعتَهُم",
      "ajuz": "فَلَم تَرَهُم في شُكرِ ذَلِكَ أَذنَبوا"
    },
    {
      "n": 8,
      "sadr": "فَلا تَترُكَنّي بِالوَعيدِ كَأَنَّني",
      "ajuz": "إِلى النّاسِ مَطلِيٌّ بِهِ القارُ أَجرَبُ"
    },
    {
      "n": 9,
      "sadr": "أَلَم تَرَ أَنَّ اللَّهَ أَعطاكَ سورَةً",
      "ajuz": "تَرى كُلَّ مَلكٍ دونَها يَتَذَبذَبُ"
    },
    {
      "n": 10,
      "sadr": "فَإِنَّكَ شَمسٌ وَالمُلوكُ كَواكِبٌ",
      "ajuz": "إِذا طَلَعَت لَم يَبدُ مِنهُنَّ كَوكَبُ"
    },
    {
      "n": 11,
      "sadr": "وَلَستَ بِمُستَبقٍ أَخاً لا تَلُمُّهُ",
      "ajuz": "عَلى شَعَثٍ أَيُّ الرِّجالِ المُهَذَّبُ"
    },
    {
      "n": 12,
      "sadr": "فَإِن أَكُ مَظلوماً فَعَبدٌ ظَلَمتَهُ",
      "ajuz": "وَإِن تَكُ ذا عُتبى فَمِثلُكَ يُعتِبُ"
    }
  ]
}
