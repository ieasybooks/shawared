{
  "expo": {
    "name": "شوارد",
    "slug": "shawared",
    "scheme": "shawared",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/app/icon.png",
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "KJ597HLVMB",
      "bundleIdentifier": "com.shawared.app",
      "icon": {
        "light": "./assets/app/icon.png",
        "dark": "./assets/app/icon-dark.png",
        "tinted": "./assets/app/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:shawared.com"]
    },
    "android": {
      "package": "com.shawared.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app/adaptive-foreground.png",
        "monochromeImage": "./assets/app/adaptive-monochrome.png",
        "backgroundColor": "#F3F0E8"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "shawared.com" },
            { "path": "/" },
            { "path": "/poets" },
            { "path": "/reciters" },
            { "path": "/meters" },
            { "path": "/library" },
            { "path": "/app" },
            { "pathPrefix": "/poems/" },
            { "pathPrefix": "/poets/" },
            { "pathPrefix": "/reciters/" },
            { "pathPrefix": "/meters/" },
            { "path": "/en" },
            { "path": "/en/poets" },
            { "path": "/en/reciters" },
            { "path": "/en/meters" },
            { "path": "/en/library" },
            { "path": "/en/app" },
            { "pathPrefix": "/en/poems/" },
            { "pathPrefix": "/en/poets/" },
            { "pathPrefix": "/en/reciters/" },
            { "pathPrefix": "/en/meters/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "شوارد · Shawared"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false,
          "asyncRoutes": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app/splash.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#F3F0E8",
          "dark": {
            "image": "./assets/app/splash-dark.png",
            "backgroundColor": "#12151F"
          }
        }
      ],
      "./plugins/with-release-signing"
    ],
    "extra": {
      "eas": {
        "projectId": "46acd2ca-c388-4ceb-a0b7-e9efea752a03"
      }
    },
    "owner": "aliosm"
  }
}
