{
  "id": "ya-arda-andalus",
  "poet": "abu-al-fadl-al-walid",
  "title": "يا أَرضَ أَندَلُسَ الخَضراءَ حَيّينا",
  "meter": "basit",
  "rawiy": "ن",
  "abyat_in_full": 131,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,   "sadr": "يا أَرضَ أَندَلُسَ الخَضراءَ حَيّينا",            "ajuz": "لَعَلَّ روحاً مِنَ الحَمراءِ تُحيينا" },
    { "n": 2,   "sadr": "فيكِ الذَّخائِرُ وَالأَعلاقُ باقِيَةٌ",           "ajuz": "مِنَ المُلوكِ الطَّريدينَ الشَّريدينا" },
    { "n": 3,   "sadr": "مِنّا السَّلامُ عَلى ما فيكِ مِن رِمَمٍ",         "ajuz": "وَمِن قُبورٍ وَأَطلالٍ تُصابينا" },
    { "n": 4,   "sadr": "لَقَد أَضَعناكِ في أَيّامِ شَقوَتِنا",            "ajuz": "وَلا نَزالُ مُحِبّيكِ المَشوقينا" },
    { "n": 5,   "sadr": "هَذي رُبوعُكِ بَعدَ الأُنسِ موحِشَةٌ",            "ajuz": "كَأَنَّنا لَم نَكُن فيها مُقيمينا" },
    { "n": 6,   "sadr": "مِن دَمعِنا قَد سَقَيناها وَمِن دَمِنا",          "ajuz": "فَفي ثَراها حُشاشَةٌ تُشاكينا" },
    { "n": 7,   "sadr": "عادَت إِلى أَهلِها تَشتاقُ فِتيَتَها",            "ajuz": "فَأَسمَعَت مِن غِناءِ الحُبِّ تَلحينا" },
    { "n": 8,   "sadr": "كانَت لَنا فَعَنَت تَحتَ السُّيوفِ لَهُم",        "ajuz": "لَكِنَّ حاضِرَها رَسمٌ لِماضينا" },
    { "n": 9,   "sadr": "في عِزِّنا حَبِلَت مِنّا فَصورَتُنا",             "ajuz": "مَحفوظَةٌ أَبَداً فيها تُعَزّينا" },
    { "n": 10,  "sadr": "لا بِدعَ إِن نَشَقَتنا مِن أَزاهِرِها",           "ajuz": "طيباً فَإِنّا مَلَأناها رَياحينا" },
    { "n": 11,  "sadr": "وَإِن طَرِبنا لِأَلحانٍ تُرَدِّدُها",             "ajuz": "فَإِنَّها أَخَذَت عَنّا أَغانينا" },
    { "n": 12,  "sadr": "تاقَت إِلى اللُّغَةِ الفُصحى وَقَد حَفِظَت",      "ajuz": "مِنها كَلاماً بَدَت فيهِ مَعانينا" },
    { "n": 13,  "sadr": "إِنّا لَنَذكُرُ نُعماها وَتَذكُرُنا",             "ajuz": "فَلَم يَضِع بَينَنا عَهدُ المُحِبّينا" },
    { "n": 14,  "sadr": "في البُرتُغالِ وَإِسبانِيَّةَ اِزدَهَرَت",         "ajuz": "آدابُنا وَسَمَت دَهراً مَبانينا" },
    { "n": 15,  "sadr": "وَفي صِقِلِّيَّةَ الآثارُ ما بَرِحَت",            "ajuz": "تَبكي التَّمَدُّنَ حيناً وَالعُلى حينا" },
    { "n": 16,  "sadr": "كَم مِن قُصورٍ وَجَنّاتٍ مُزَخرَفَةٍ",            "ajuz": "فيها الفُنونُ جَمَعناها أَفانينا" },
    { "n": 17,  "sadr": "وَكَم صُروحٍ وَأَبراجٍ مُمَرَّدَةٍ",              "ajuz": "زِدنا بِها المُلكَ تَوطيداً وَتَأمينا" },
    { "n": 18,  "sadr": "وَكَم مَساجِدَ أَعلَينا مَآذِنَها",               "ajuz": "فَأَطلَعَت أَنجُماً مِنها مَعالينا" },
    { "n": 19,  "sadr": "وَكَم جُسورٍ عَقَدنا مِن قَناطِرِها",             "ajuz": "أَقواسَ نَصرٍ عَلى نَهرٍ يُرَئّينا" },
    { "n": 20,  "sadr": "تِلكَ البِلادُ اِستَمَدَّت مِن حَضارَتِنا",        "ajuz": "ما أَبدَعَتهُ وَأَولَتهُ أَيادينا" },
    { "n": 21,  "sadr": "فيها النَّفائِسُ جاءَت مِن صِناعَتِنا",           "ajuz": "وَمِن زِراعَتِنا صارَت بَساتينا" },
    { "n": 22,  "sadr": "فَأَجدَبَت بَعدَنا وَاستَوحَشَت دِمَناً",         "ajuz": "تَصبو إِلَينا وَتَبكي مِن تَنائينا" },
    { "n": 23,  "sadr": "أَيّامَ كانَت قُصورُ المُلكِ عالِيَةً",           "ajuz": "كانَ الفِرَنجُ إِلى الغاباتِ آوينا" },
    { "n": 24,  "sadr": "وَحينَ كُنّا نَجُرُّ الخَزَّ أَردِيَةً",           "ajuz": "كانوا يَسيرونَ في الأَسواقِ عارينا" },
    { "n": 25,  "sadr": "لَقَد لَبِسنا مِنَ الأَبرادِ أَفخَرَها",          "ajuz": "لَمّا جَرَرنا ذُيولَ العَصبِ تَزيينا" },
    { "n": 26,  "sadr": "وَقَد ضَفَرنا لِإِدلالٍ ذَوائِبَنا",              "ajuz": "لَمّا حَمَينا المَغاني مِن غَوانينا" },
    { "n": 27,  "sadr": "وَقَد مَسَحنا صُنوفَ الطّيبِ في لِمَمٍ",          "ajuz": "لَمّا اِدَّرَعنا وَأَسرَجنا مَذاكينا" },
    { "n": 28,  "sadr": "كُلُّ الجَواهِرِ في لَبّاتِ نِسوَتِنا",           "ajuz": "صارَت عُقوداً تَزيدُ الدُّرَّ تَثمينا" },
    { "n": 29,  "sadr": "وَأَكرَمُ الخَيلِ جالَت في مَعارِكِنا",           "ajuz": "وَإِذ خَلا الجَوُّ خالَت في مَراعينا" },
    { "n": 30,  "sadr": "تَردي وَقَد عَلِمَت أَنّا فَوارِسُها",            "ajuz": "وَلا تَزالُ لِنَعلوها وَتُعلينا" },
    { "n": 31,  "sadr": "زِدنا السُّيوفَ مَضاءً مِن مَضارِبِنا",           "ajuz": "وَمِن مَطاعِنِنا زِدنا القَنا لينا" },
    { "n": 32,  "sadr": "مَن لِلكَتائِبِ أَو مَن لِلمَواكِبِ أَو",         "ajuz": "مَن لِلمَنابِرِ إِلّا سادَةٌ فينا" },
    { "n": 33,  "sadr": "جاءَت مِنَ المَلَأِ الأَعلى قَصائِدُنا",          "ajuz": "وَالرّومُ قَد أَخَذوا عَنّا قَوافينا" },
    { "n": 34,  "sadr": "لَم يَعرِفوا العِلمَ إِلّا مِن مَدارِسِنا",       "ajuz": "وَلا الفُروسَةَ إِلّا مِن مَجارينا" },
    { "n": 35,  "sadr": "أَعلى المَمالِكِ داسَتها جَحافِلُنا",             "ajuz": "وَسَرَّحَت خَيلَنا فيها سَراحينا" },
    { "n": 36,  "sadr": "تِلكَ الجِيادُ بِأَبطالِ الوَغى قَطَعَت",         "ajuz": "جِبالَ بَرناتَ وَانقَضَّت شَواهينا" },
    { "n": 37,  "sadr": "في أَرضِ إِفرَنسَةَ القُصوى لَها أَثَرٌ",         "ajuz": "قَد زادَهُ الدَّهرُ إيضاحاً وَتَبيينا" },
    { "n": 38,  "sadr": "داسَت حَوافِرُها ثَلجاً كَما وَطِئَت",            "ajuz": "رَملاً وَخاضَت عُباباً في مَغازينا" },
    { "n": 39,  "sadr": "الشَّمسُ ما أَشرَقَت مِن عُلوِ مَطلِعِها",        "ajuz": "إِلّا رَأَتنا إِلى الأَوطارِ ساعينا" },
    { "n": 40,  "sadr": "كِسرى وَقَيصَرُ قَد فَرَّت جُيوشُهُما",           "ajuz": "لِلمَرزُبانِ وَلِلبِطريقِ شاكينا" },
    { "n": 41,  "sadr": "حَيثُ العِمامَةُ بِالتّيجانِ مُزرِيَةٌ",          "ajuz": "مِن يَومِ يَرموكَ حَتّى يَومِ حِطّينا" },
    { "n": 42,  "sadr": "وَلِلعُروشِ طَوافٌ بِالسَّريرِ إِذا",             "ajuz": "قامَ الخَليفَةُ يُعطي النّاسَ تَأمينا" },
    { "n": 43,  "sadr": "بَعدَ الخِلافَةِ ضاعَت أَرضُ أَندَلُسٍ",          "ajuz": "وَما وَقى العَرَبُ الدُّنيا وَلا الدّينا" },
    { "n": 44,  "sadr": "المُلكُ أَصبَحَ دَعوى في طَوائِفِهِم",            "ajuz": "وَاستَمسَكوا بِعُرى اللَّذّاتِ غاوينا" },
    { "n": 45,  "sadr": "وَكُلُّ طائِفَةٍ قَد بايَعَت مَلِكاً",            "ajuz": "لَم يُلفِ مِن غارَةِ الإِسبانِ تَحصينا" },
    { "n": 46,  "sadr": "وَهَكَذا يَفقِدُ السُّلطانُ هَيبَتَهُ",           "ajuz": "إِن أَكثَرَ القَومُ بِالفَوضى السَّلاطينا" },
    { "n": 47,  "sadr": "وَالرَّأيُ وَالبَأسُ عِندَ النّاسِ ما اِئتَلَفوا", "ajuz": "لَكِن إِذا اِختَلَفوا صاروا مَجانينا" },
    { "n": 48,  "sadr": "تَقَلَّصَ الظِّلُّ عَن جَنّاتِ أَندَلُسٍ",        "ajuz": "وَحَطَّمَ السَّيفُ مُلكَ المُستَنيمينا" },
    { "n": 49,  "sadr": "فَما المَنازِلُ بِالباقينَ آهِلَةٌ",              "ajuz": "وَلا المَساجِدُ فيها لِلمُصَلّينا" },
    { "n": 50,  "sadr": "لَن تَرجِعَنَّ لَنا يا عَهدَ قُرطُبَةٍ",          "ajuz": "فَكَيفَ نَبكي وَقَد جَفَّت مَآقينا" },
    { "n": 51,  "sadr": "ذَبَلتَ زَهراً وَمِن رَيّاكَ نَشوَتُنا",          "ajuz": "وَإِنَّ ذِكراكَ في البَلوى تُسَلّينا" },
    { "n": 52,  "sadr": "ما كانَ أَعظَمَها لِلمُلكِ عاصِمَةً",             "ajuz": "وَكانَ أَكثَرَها لِلعِلمِ تَلقينا" },
    { "n": 53,  "sadr": "لَم يَبقَ مِنها وَمِن مُلكٍ وَمِن خَوَلٍ",        "ajuz": "إِلّا رُسومٌ وَأَطيافٌ تُباكينا" },
    { "n": 54,  "sadr": "وَالدَّهرُ ما زالَ في آثارِ نِعمَتِها",           "ajuz": "يَروي حَديثاً لَهُ تَبكي أَعادينا" },
    { "n": 55,  "sadr": "أَينَ المُلوكُ بَنو مَروانَ ساسَتُها",            "ajuz": "يُضحونَ قاضينَ أَو يُمسونَ غازينا" },
    { "n": 56,  "sadr": "وَأَينَ أَبناءُ عَبّادٍ وَرَونَقُهُم",            "ajuz": "وَهُم أَواخِرُ نورٍ في دَياجينا" },
    { "n": 57,  "sadr": "يا أَيُّها المَسجِدُ العاني بِقُرطُبَةٍ",         "ajuz": "هَلّا تُذَكِّرُكَ الأَجراسُ تَأذينا" },
    { "n": 58,  "sadr": "كانَ الخَليفَةُ يَمشي بَينَ أَعمِدَةٍ",           "ajuz": "كَأَنَّهُ اللَّيثُ يَمضي في عِفِرّينا" },
    { "n": 59,  "sadr": "إِن مالَ مالَت بِهِ الغَبراءُ واجِفَةً",          "ajuz": "أَو قالَ قالَت لَهُ العَلياءُ آمينا" },
    { "n": 60,  "sadr": "يا سائِحاً أَصبَحَت حَجّاً قِيافَتُهُ",           "ajuz": "قِف بِالطُّلولِ وَسَلها عَن مَلاهينا" },
    { "n": 61,  "sadr": "بَعدَ النَّعيمِ قُصورُ المُلكِ دارِسَةٌ",         "ajuz": "وَأَهلُها أَصبَحوا عَنها بَعيدينا" },
    { "n": 62,  "sadr": "فَلا جَمالٌ تَروقُ العَينَ بَهجَتُهُ",            "ajuz": "وَلا عَبيرٌ مَعَ الأَرواحِ يَأتينا" },
    { "n": 63,  "sadr": "صارَت طُلولاً وَلَكِنَّ الَّتي بَقِيَت",          "ajuz": "تَزدادُ بِالذِّكرِ بَعدَ الحُسنِ تَحسينا" },
    { "n": 64,  "sadr": "تِلكَ القُصورُ مِنَ الزَّهراءِ طامِسَةٌ",         "ajuz": "وَبِالتَّذَكُّرِ نَبنيها فَتَبنينا" },
    { "n": 65,  "sadr": "عَلى المَمالِكِ مِنها أَشرَفَت شَرَفاً",          "ajuz": "وَالمُلكُ يَعشَقُ تَشييداً وَتَزيينا" },
    { "n": 66,  "sadr": "وَعَبدُ رَحمانِها يَلهو بِزُخرُفِها",             "ajuz": "وَالفَنُّ يَعشَقُ تَشييداً وَتَزيينا" },
    { "n": 67,  "sadr": "كانَت حَقيقَةَ سُلطانٍ وَمَقدِرَةٍ",              "ajuz": "فَأَصبَحَت في البِلى وَهماً وَتَخمينا" },
    { "n": 68,  "sadr": "عَمائِمُ العَرَبِ الأَمجادِ ما بَرِحَت",           "ajuz": "عَلى المَطارِفِ بِالتَّمثيلِ تُصبينا" },
    { "n": 69,  "sadr": "وَفي المَحاريبِ أَشباحٌ تَلوحُ لَنا",             "ajuz": "وَفي المَنابِرِ أَصواتٌ تُنادينا" },
    { "n": 70,  "sadr": "يا بَرقُ طالِع قُصوراً أَهلُها رَحَلوا",          "ajuz": "وَحَيِّ أَجداثَ أَبطالٍ مُنيخينا" },
    { "n": 71,  "sadr": "أَهَكَذا كانَتِ الحَمراءُ موحِشَةً",              "ajuz": "إِذ كُنتَ تَرمُقُ أَفواجَ المُغَنّينا" },
    { "n": 72,  "sadr": "وَلِلبُرودِ حَفيفٌ فَوقَ مَرمَرِها",              "ajuz": "وَقَد تَضَوَّعَ مِنها مِسكُ دارينا" },
    { "n": 73,  "sadr": "وَيا غَمامُ اِفتَقِد جَنّاتِ مُرسِيَةٍ",           "ajuz": "وَرَوِّ مِن زَهرِها وَرداً وَنِسرينا" },
    { "n": 74,  "sadr": "وَأَمطِرِ النَّخلَ وَالزَّيتونَ غادِيَةً",        "ajuz": "وَالتّوتَ وَالكَرمَ وَالرُّمّانَ وَالتّينا" },
    { "n": 75,  "sadr": "أوصيكَ خَيراً بِأَشجارٍ مُقَدَّسَةٍ",             "ajuz": "لِأَنَّها كُلَّها مِن غَرسِ أَيدينا" },
    { "n": 76,  "sadr": "كُنّا المُلوكَ وَكانَ الكَونُ مَملَكَةً",         "ajuz": "فَكَيفَ صِرنا المَماليكَ المَساكينا" },
    { "n": 77,  "sadr": "وَفي رِقابِ العِدى اِنفَلَّت صَوارِمُنا",          "ajuz": "وَاليَومَ قَد نَزَعوا مِنّا السَّكاكينا" },
    { "n": 78,  "sadr": "لَيسَت بَسالَتُنا في الحَربِ نافِعَةً",           "ajuz": "وَمِن بَراقيلِهِم نَلقى طَواحينا" },
    { "n": 79,  "sadr": "فَلَو فَطِنّا لَقابَلنا قَذائِفَهُم",             "ajuz": "بِمِثلِها وَامتَنَعنا في صَياصينا" },
    { "n": 80,  "sadr": "وَاشتَدَّ عَسكَرُنا يَحمي مَنازِلَنا",            "ajuz": "وَارتَدَّ أُسطولُنا يَحمي شَواطينا" },
    { "n": 81,  "sadr": "إِذاً لَكانوا عَلى بَأسٍ مَلائِكَةً",             "ajuz": "وَما أَتَونا عَلى ضَعفٍ شَياطينا" },
    { "n": 82,  "sadr": "فَنَحنُ في أَرضِنا أَسرى بِلا أَمَلٍ",            "ajuz": "وَالدّارُ كَالسِّجنِ وَالجَلّادُ والينا" },
    { "n": 83,  "sadr": "شادوا القِلاعَ وَشَدّوا مِن مَدافِعِهِم",         "ajuz": "ما يَملَأُ الأَرضَ نيراناً لِيُفنينا" },
    { "n": 84,  "sadr": "بَعدَ اِعتِداءٍ وَتَدميرٍ وَمَجزَرَةٍ",            "ajuz": "قالوا أَماناً فَكونوا مُستَكينينا" },
    { "n": 85,  "sadr": "وَكَم يَقولونَ إِنّا ناصِبونَ لَكُم",             "ajuz": "ميزانَ عَدلٍ وَلَم توفوا المَوازينا" },
    { "n": 86,  "sadr": "تَحَكَّموا مِثلَما شاءَت مَطامِعُهُم",            "ajuz": "وَصَيَّروا بَينَنا التَّهويلَ تَهوينا" },
    { "n": 87,  "sadr": "فَلا تَغُرَّنَّ بِالآمالِ أَنفُسَنا",             "ajuz": "وَلِلفَرَنسيسِ جَوسٌ في نَواحينا" },
    { "n": 88,  "sadr": "هَل يَسمَحونَ وَلَو صِرنا مَلائِكَةً",            "ajuz": "بِأَن نَصيرَ لَهُم يَوماً مُبارينا" },
    { "n": 89,  "sadr": "لا يَعرِفونَ التَّراضي في هَوادَتِنا",            "ajuz": "وَلا سِلاحٌ بِها يُخشى تَقاضينا" },
    { "n": 90,  "sadr": "إِن لَم تَكُن حِكمَةٌ مِن عِلمِ حاضِرِنا",        "ajuz": "أَما لَنا عِبرَةٌ مِن جَهلِ ماضينا" },
    { "n": 91,  "sadr": "إِنّا نَعيشُ كَما عاشَت أَوائِلُنا",              "ajuz": "وَلا نُريدُ مِنَ الأَعلاجِ تَمدينا" },
    { "n": 92,  "sadr": "إِن قَدَّموا المَنَّ وَالسَّلوى عَلى ضَرَعٍ",     "ajuz": "نَختَر عَلى العِزِّ زَقّوماً وَغِسلينا" },
    { "n": 93,  "sadr": "يا مَغرِبِيَّةُ يا ذاتَ الخَفارَةِ يا",           "ajuz": "ذاتَ الحِجابِ الَّذي فيهِ تُصانينا" },
    { "n": 94,  "sadr": "صُدّي عَنِ العِلجِ وَاستَبقي أَخا عَرَبٍ",        "ajuz": "مِن وُلدِ عَمِّكِ يَهوى الحورَ وَالعينا" },
    { "n": 95,  "sadr": "يا نِعمَ أَندَلُسِيّاً كانَ جَدُّكِ في",          "ajuz": "عَهدِ النَّعيمِ وَهَذا العَهدُ يُشقينا" },
    { "n": 96,  "sadr": "خُذي دُموعي وَأَعطيني دُموعَ أَسىً",              "ajuz": "طالَ التَّأَسّي وَما أَجدى تَأَسّينا" },
    { "n": 97,  "sadr": "ذِكرُ السَّعادَةِ أَبكانا وَأَرَّقَنا",           "ajuz": "ما كُنتُ لَولا الهَوى أَبكي وَتَبكينا" },
    { "n": 98,  "sadr": "بَكى اِبنُ زَيدونَ حَيثُ النّونُ أَنَّتُهُ",       "ajuz": "وَلَم يَزَل شِعرُهُ يُبكي المُصابينا" },
    { "n": 99,  "sadr": "كَم شاقَني وَتَصَبّاني وَأَطرَبَني",              "ajuz": "إِذ كُنتِ وَرقاءَ في رَوضٍ تَنوحينا" },
    { "n": 100, "sadr": "وَمِن دُموعِكِ هاتيكَ السُّموطُ حَكَت",           "ajuz": "أَبياتَ نونِيَّةٍ فيها شَكاوينا" },
    { "n": 101, "sadr": "وَلّادَةُ اِستَنزَفَت أَسمى عَواطِفِهِ",           "ajuz": "فَخَلَّدَ الحُبَّ إِنشاداً وَتَدوينا" },
    { "n": 102, "sadr": "تِلكَ الأَميرَةُ أَعطَتهُ ظَرافَتَها",            "ajuz": "فَأَخرَجَ الشِّعرَ تَنغيماً وَتَحنينا" },
    { "n": 103, "sadr": "يا بِنتَ عَمّي وَفي القُربى لَنا وَطَرٌ",         "ajuz": "صوني المُحَيّا وَإِن زُرناكِ حَيّينا" },
    { "n": 104, "sadr": "لَيلُ الأَسى طالَ حَتّى خِلتُ أَنجُمَهُ",         "ajuz": "بَقِيَّةَ الصُّبحِ تَبدو مِن دَياجينا" },
    { "n": 105, "sadr": "نَشتاقُ فَجراً مِنَ النُّعمى وَظالِمُنا",         "ajuz": "يَقولُ إِنَّ ضِياءَ الفَجرِ يُؤذينا" },
    { "n": 106, "sadr": "فَلنُطلِعَنَّ إِذَن صُبحَ القُلوبِ عَلى",         "ajuz": "لَيلِ الخُطوبِ وَهَذا النّورُ يَكفينا" },
    { "n": 107, "sadr": "أَما كَفانا بِفَقدِ المُلكِ نائِبَةً",            "ajuz": "حَتّى أَتانا عُلوجُ الرّومِ عادينا" },
    { "n": 108, "sadr": "عَدا عَلَينا العِدى في بَرِّ عُدوَتِنا",          "ajuz": "وَقَد رَضيناهُ مَنفىً في عَوادينا" },
    { "n": 109, "sadr": "فيهِ الفَرَنسيسُ ما اِنفَكَّت مَدافِعُهُم",        "ajuz": "تُمَزِّقُ العَرَبَ العُزلَ المَروعينا" },
    { "n": 110, "sadr": "فَوَسطَ مَرّاكُشَ الكُبرى لِقائِدِهِم",           "ajuz": "دَستٌ وَقَد شَرَّدوا عَنها السَّلاطينا" },
    { "n": 111, "sadr": "وَفي الجَزائِرِ ما يُبكي العُيونَ دَماً",         "ajuz": "عَلى أَماجِدَ خَرّوا مُستَميتينا" },
    { "n": 112, "sadr": "وَفي طَرابُلُسِ الغَربِ اِستَجَدَّ لَنا",          "ajuz": "وَجدٌ قَديمٌ وَقَد ضاعَت أَمانينا" },
    { "n": 113, "sadr": "وَهَذِهِ تونُسُ الخَضراءُ باكِيَةٌ",              "ajuz": "تَرثي بَنيها المَطاعيمَ المَطاعينا" },
    { "n": 114, "sadr": "مِنَ الفَرَنسيسِ بَلوانا وَنَكبَتُنا",            "ajuz": "فَهَل يَظَلّونَ فينا مُستَبِدّينا" },
    { "n": 115, "sadr": "صُهبُ العَثانينِ مَع زُرقِ العُيونِ بَدَت",       "ajuz": "شُؤماً بِهِ حَدَثانُ الدَّهرِ يَرمينا" },
    { "n": 116, "sadr": "فَلا رَأَينا مِنَ الأَحداقِ زُرقَتَها",           "ajuz": "وَلا شَهِدنا مِنَ الصُّهبِ العَثانينا" },
    { "n": 117, "sadr": "وا طولَ لَهفي عَلى قَومٍ مَنازِلُهُم",            "ajuz": "تَأوي العُلوجَ ثِقالاً مُستَخِفّينا" },
    { "n": 118, "sadr": "قَد كافَحوا ما اِستَطاعوا دونَ حُرمَتِها",         "ajuz": "ثُمَّ اِستَكانوا عَلى ضَيمٍ مُطيعينا" },
    { "n": 119, "sadr": "لا يَملِكونَ دِفاعاً في خَصاصَتِهِم",             "ajuz": "وَيَنصُرونَ الفَرَنسيسَ المَلاعينا" },
    { "n": 120, "sadr": "أَعداؤُهُم قَطَّعوا أَوطانَهُم إِرَباً",          "ajuz": "فَأَصبَحوا مِثلَ أَنعامٍ مَسوقينا" },
    { "n": 121, "sadr": "هَذا لَعَمري لَسُخطُ اللَّهِ أَو غَضَبٌ",         "ajuz": "مِنَ النَّبِيِّ عَلى ساهينَ لاهينا" },
    { "n": 122, "sadr": "مَن ذا يُصَدِّقُ أَنَّ التّائِهينَ ثُبىً",        "ajuz": "كانوا جُيوشاً تَرى الدُّنيا مَيادينا" },
    { "n": 123, "sadr": "مَشَوا عَلى ناعِمٍ أَو ناضِرٍ زَمَناً",           "ajuz": "وَاليَومَ يَمشونَ في الصَّحراءِ حافينا" },
    { "n": 124, "sadr": "لا طارِقٌ يَطرُقُ الأَعلاجَ مِن كَثَبٍ",          "ajuz": "وَإِن دَعَونا فَلا موسى يُلَبّينا" },
    { "n": 125, "sadr": "بِالقَهرِ قَد أَخَذوا مِسكاً وَغالِيَةً",         "ajuz": "وَمِنهُما عَوَّضونا الوَحلَ وَالطّينا" },
    { "n": 126, "sadr": "وَأَدرَكوا ثَأرَهُم في شَنِّ غارَتِهِم",          "ajuz": "لَمّا أَتَونا لُصوصاً مُستَبيحينا" },
    { "n": 127, "sadr": "في الأَرضِ عاثوا فَساداً بَعدَما شَرِبوا",        "ajuz": "خَمرَ الحَوانيتِ وَامتَصّوا المَداخينا" }
  ]
}
