{
  "id": "muallaqat-amr-ibn-kulthum",
  "poet": "amr-ibn-kulthum",
  "title": "مُعَلَّقَةُ عَمرِو بنِ كُلثومٍ",
  "meter": "wafir",
  "rawiy": "ن",
  "abyat_in_full": 120,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1,   "sadr": "أَلا هُبّي بِصَحنِكِ فَاصبَحينا", "ajuz": "وَلا تُبقي خُمورَ الأَندَرينا" },
    { "n": 2,   "sadr": "مُشَعشَعَةً كَأَنَّ الحُصَّ فيها", "ajuz": "إِذا ما الماءُ خالَطَها سَخينا" },
    { "n": 3,   "sadr": "تَجورُ بِذي اللُّبانَةِ عَن هَواهُ", "ajuz": "إِذا ما ذاقَها حَتّى يَلينا" },
    { "n": 4,   "sadr": "تَرى اللَّحِزَ الشَّحيحَ إِذا أُمِرَّت", "ajuz": "عَلَيهِ لِمالِهِ فيها مُهينا" },
    { "n": 5,   "sadr": "كَأَنَّ الشُّهبَ في الآذانِ مِنها", "ajuz": "إِذا قَرَعوا بِحافَتِها الجَبينا" },
    { "n": 6,   "sadr": "صَبَنتِ الكَأسَ عَنّا أُمَّ عَمرٍو", "ajuz": "وَكانَ الكَأسُ مَجراها اليَمينا" },
    { "n": 7,   "sadr": "وَما شَرُّ الثَّلاثَةِ أُمَّ عَمرٍو", "ajuz": "بِصاحِبِكِ الَّذي لا تَصبَحينا" },
    { "n": 8,   "sadr": "وَكَأسٍ قَد شَرِبتُ بِبَعلَبَكٍّ", "ajuz": "وَأُخرى في دِمَشقَ وَقاصِرينا" },
    { "n": 9,   "sadr": "إِذا صَمَدَت حُمَيّاها أَريباً", "ajuz": "مِنَ الفِتيانِ خِلتَ بِهِ جُنونا" },
    { "n": 10,  "sadr": "فَما بَرِحَت مَجالَ الشَّربِ حَتّى", "ajuz": "تَغالَوها وَقالوا قَد رَوينا" },
    { "n": 11,  "sadr": "وَإِنّا سَوفَ تُدرِكُنا المَنايا", "ajuz": "مُقَدَّرَةً لَنا وَمُقَدَّرينا" },
    { "n": 12,  "sadr": "قِفي قَبلَ التَّفَرُّقِ يا ظَعينا", "ajuz": "نُخَبِّركِ اليَقينَ وَتُخبِرينا" },
    { "n": 13,  "sadr": "قِفي نَسأَلكِ هَل أَحدَثتِ صَرماً", "ajuz": "لِوَشكِ البَينِ أَم خُنتِ الأَمينا" },
    { "n": 14,  "sadr": "بِيَومِ كَريهَةٍ ضَرباً وَطَعناً", "ajuz": "أَقَرَّ بِهِ مَواليكِ العُيونا" },
    { "n": 15,  "sadr": "وَإِنَّ غَداً وَإِنَّ اليَومَ رَهنٌ", "ajuz": "وَبَعدَ غَدٍ بِما لا تَعلَمينا" },
    { "n": 16,  "sadr": "تُريكَ إِذا دَخَلتَ عَلى خَلاءٍ", "ajuz": "وَقَد أَمِنَت عُيونَ الكاشِحينا" },
    { "n": 17,  "sadr": "ذِراعَي عَيطَلٍ أَدماءَ بِكرٍ", "ajuz": "هِجانِ اللَّونِ لَم تَقرَأ جَنينا" },
    { "n": 18,  "sadr": "وَثَدياً مِثلَ حُقِّ العاجِ رَخصاً", "ajuz": "حَصاناً مِن أَكُفِّ اللّامِسينا" },
    { "n": 19,  "sadr": "وَنَحراً مِثلَ ضَوءِ البَدرِ وافى", "ajuz": "بِإِتمامٍ أُناساً مُدجِنينا" },
    { "n": 20,  "sadr": "وَمَتنَي لَدنَةٍ سَمَقَت وَطالَت", "ajuz": "رَوادِفُها تَنوءُ بِما وَلينا" },
    { "n": 21,  "sadr": "وَمَأكَمَةً يَضيقُ البابُ عَنها", "ajuz": "وَكَشحاً قَد جُنِنتُ بِهِ جُنونا" },
    { "n": 22,  "sadr": "وَسارِيَتَي بَلَنطٍ أَو رُخامٍ", "ajuz": "يَرِنُّ خَشاشُ حَليِهِما رَنينا" },
    { "n": 23,  "sadr": "فَما وَجَدَت كَوَجدي أُمُّ سَقبٍ", "ajuz": "أَضَلَّتهُ فَرَجَّعَتِ الحَنينا" },
    { "n": 24,  "sadr": "وَلا شَمطاءُ لَم يَترُك شَقاها", "ajuz": "لَها مِن تِسعَةٍ إِلّا جَنينا" },
    { "n": 25,  "sadr": "تَذَكَّرتُ الصِّبا وَاشتَقتُ لَمّا", "ajuz": "رَأَيتُ حُمولَها أُصُلاً حُدينا" },
    { "n": 26,  "sadr": "فَأَعرَضَتِ اليَمامَةُ وَاشمَخَرَّت", "ajuz": "كَأَسيافٍ بِأَيدي مُصلِتينا" },
    { "n": 27,  "sadr": "أَبا هِندٍ فَلا تَعجَل عَلَينا", "ajuz": "وَأَنظِرنا نُخَبِّركَ اليَقينا" },
    { "n": 28,  "sadr": "بِأَنّا نورِدُ الرّاياتِ بيضاً", "ajuz": "وَنُصدِرُهُنَّ حُمراً قَد رَوينا" },
    { "n": 29,  "sadr": "وَأَيّامٍ لَنا غُرٍّ طِوالٍ", "ajuz": "عَصَينا المَلكَ فيها أَن نَدينا" },
    { "n": 30,  "sadr": "وَسَيِّدِ مَعشَرٍ قَد تَوَّجوهُ", "ajuz": "بِتاجِ المُلكِ يَحمي المُحجَرينا" },
    { "n": 31,  "sadr": "تَرَكنا الخَيلَ عاكِفَةً عَلَيهِ", "ajuz": "مُقَلَّدَةً أَعِنَّتَها صُفونا" },
    { "n": 32,  "sadr": "وَأَنزَلنا البُيوتَ بِذي طُلوحٍ", "ajuz": "إِلى الشّاماتِ تَنفي الموعِدينا" },
    { "n": 33,  "sadr": "وَقَد هَرَّت كِلابُ الحَيِّ مِنّا", "ajuz": "وَشَذَّبنا قَتادَةَ مَن يَلينا" },
    { "n": 34,  "sadr": "مَتى نَنقُل إِلى قَومٍ رَحانا", "ajuz": "يَكونوا في اللِّقاءِ لَها طَحينا" },
    { "n": 35,  "sadr": "يَكونُ ثِفالُها شَرقِيَّ نَجدٍ", "ajuz": "وَلُهوَتُها قُضاعَةَ أَجمَعينا" },
    { "n": 36,  "sadr": "نَزَلتُم مَنزِلَ الأَضيافِ مِنّا", "ajuz": "فَأَعجَلنا القِرى أَن تَشتِمونا" },
    { "n": 37,  "sadr": "قَرَيناكُم فَعَجَّلنا قِراكُم", "ajuz": "قُبَيلَ الصُّبحِ مِرداةً طَحونا" },
    { "n": 38,  "sadr": "نَعُمُّ أُناسَنا وَنَعِفُّ عَنهُم", "ajuz": "وَنَحمِلُ عَنهُمُ ما حَمَّلونا" },
    { "n": 39,  "sadr": "نُطاعِنُ ما تَراخى النّاسُ عَنّا", "ajuz": "وَنَضرِبُ بِالسُّيوفِ إِذا غُشينا" },
    { "n": 40,  "sadr": "بِسُمرٍ مِن قَنا الخَطِّيِّ لُدنٍ", "ajuz": "ذَوابِلَ أَو بِبيضٍ يَختَلينا" },
    { "n": 41,  "sadr": "نَشُقُّ بِها رُؤوسَ القَومِ شَقّاً", "ajuz": "وَنُخليها الرِّقابَ فَتَختَلينا" },
    { "n": 42,  "sadr": "كَأَنَّ جَماجِمَ الأَبطالِ فيها", "ajuz": "وُسوقٌ بِالأَماعِزِ يَرتَمينا" },
    { "n": 43,  "sadr": "وَإِنَّ الضِّغنَ بَعدَ الضِّغنِ يَبدو", "ajuz": "عَلَيكَ وَيُخرِجُ الدّاءَ الدَّفينا" },
    { "n": 44,  "sadr": "وَرِثنا المَجدَ قَد عَلِمَت مَعَدٌّ", "ajuz": "نُطاعِنُ دونَهُ حَتّى يَبينا" },
    { "n": 45,  "sadr": "وَنَحنُ إِذا عِمادُ الحَيِّ خَرَّت", "ajuz": "عَنِ الأَحفاضِ نَمنَعُ مَن يَلينا" },
    { "n": 46,  "sadr": "نَجُذُّ رُؤوسَهُم في غَيرِ بِرٍّ", "ajuz": "فَما يَدرونَ ماذا يَتَّقونا" },
    { "n": 47,  "sadr": "كَأَنَّ سُيوفَنا فينا وَفيهِم", "ajuz": "مَخاريقٌ بِأَيدي لاعِبينا" },
    { "n": 48,  "sadr": "كَأَنَّ ثِيابَنا مِنّا وَمِنهُم", "ajuz": "خُضِبنَ بِأُرجُوانٍ أَو طُلينا" },
    { "n": 49,  "sadr": "إِذا ما عَيَّ بِالإِسنافِ حَيٌّ", "ajuz": "مِنَ الهَولِ المُشَبَّهِ أَن يَكونا" },
    { "n": 50,  "sadr": "نَصَبنا مِثلَ رَهوَةَ ذاتَ حَدٍّ", "ajuz": "مُحافَظَةً وَكُنّا السّابِقينا" },
    { "n": 51,  "sadr": "بِفِتيانٍ يَرَونَ القَتلَ مَجداً", "ajuz": "وَشيبٍ في الحُروبِ مُجَرَّبينا" },
    { "n": 52,  "sadr": "حُدَيّا النّاسِ كُلِّهِمُ جَميعاً", "ajuz": "مُقارَعَةً بَنيهِم عَن بَنينا" },
    { "n": 53,  "sadr": "فَأَمّا يَومَ خَشيَتِنا عَلَيهِم", "ajuz": "فَتُصبِحُ خَيلُنا عُصَباً ثُبينا" },
    { "n": 54,  "sadr": "وَأَمّا يَومَ لا نَخشى عَلَيهِم", "ajuz": "فَنُمعِنُ غارَةً مُتَلَبِّبينا" },
    { "n": 55,  "sadr": "بِرَأسٍ مِن بَني جُشَمِ اِبنِ بَكرٍ", "ajuz": "نَدُقُّ بِهِ السُّهولَةَ وَالحُزونا" },
    { "n": 56,  "sadr": "أَلا لا يَعلَمِ الأَقوامُ أَنّا", "ajuz": "تَضَعضَعنا وَأَنّا قَد وَنينا" },
    { "n": 57,  "sadr": "أَلا لا يَجهَلَن أَحَدٌ عَلَينا", "ajuz": "فَنَجهَلَ فَوقَ جَهلِ الجاهِلينا" },
    { "n": 58,  "sadr": "بِأَيِّ مَشيئَةٍ عَمرَو اِبنَ هِندٍ", "ajuz": "نَكونُ لِقَيلِكُم فيها قَطينا" },
    { "n": 59,  "sadr": "بِأَيِّ مَشيئَةٍ عَمرَو اِبنَ هِندٍ", "ajuz": "تُطيعُ بِنا الوُشاةَ وَتَزدَرينا" },
    { "n": 60,  "sadr": "بِأَيِّ مَشيئَةٍ عَمرَو اِبنَ هِندٍ", "ajuz": "تَرى أَنّا نَكونُ الأَرذَلينا" },
    { "n": 61,  "sadr": "تَهَدَّدنا وَأَوعِدنا رُوَيداً", "ajuz": "مَتى كُنّا لِأُمِّكَ مَقتَوينا" },
    { "n": 62,  "sadr": "فَإِنَّ قَناتَنا يا عَمرو أَعيَت", "ajuz": "عَلى الأَعداءِ قَبلَكَ أَن تَلينا" },
    { "n": 63,  "sadr": "إِذا عَضَّ الثِّقافُ بِها اِشمَأَزَّت", "ajuz": "وَوَلَّتهُم عَشَوزَنَةً زَبونا" },
    { "n": 64,  "sadr": "عَشَوزَنَةً إِذا اِنقَلَبَت أَرَنَّت", "ajuz": "تَشُجُّ قَفا المُثَقِّفِ وَالجَبينا" },
    { "n": 65,  "sadr": "فَهَل حُدِّثتَ في جُشَمِ اِبنِ بَكرٍ", "ajuz": "بِنَقصٍ في خُطوبِ الأَوَّلينا" },
    { "n": 66,  "sadr": "وَرِثنا مَجدَ عَلقَمَةَ اِبنِ سَيفٍ", "ajuz": "أَباحَ لَنا حُصونَ المَجدِ دينا" },
    { "n": 67,  "sadr": "وَرِثتُ مُهَلهِلاً وَالخَيرَ مِنهُ", "ajuz": "زُهَيراً نِعمَ ذُخرُ الذّاخِرينا" },
    { "n": 68,  "sadr": "وَعَتّاباً وَكُلثوماً جَميعاً", "ajuz": "بِهِم نِلنا تُراثَ الأَكرَمينا" },
    { "n": 69,  "sadr": "وَذا البُرَةِ الَّذي حُدِّثتَ عَنهُ", "ajuz": "بِهِ نُحمى وَنَحمي المُحجَرينا" },
    { "n": 70,  "sadr": "وَمِنّا قَبلَهُ السّاعي كُلَيبٌ", "ajuz": "فَأَيُّ المَجدِ إِلّا قَد وَلينا" },
    { "n": 71,  "sadr": "مَتى نَعقِد قَرينَتَنا بِحَبلٍ", "ajuz": "تَجُذَّ الحَبلَ أَو تَقِصِ القَرينا" },
    { "n": 72,  "sadr": "وَنوجَدُ نَحنُ أَمنَعَهُم ذِماراً", "ajuz": "وَأَوفاهُم إِذا عَقَدوا يَمينا" },
    { "n": 73,  "sadr": "وَنَحنُ غَداةَ أوقِدَ في خَزازى", "ajuz": "رَفَدنا فَوقَ رِفدِ الرّافِدينا" },
    { "n": 74,  "sadr": "وَنَحنُ الحابِسونَ بِذي أُراطى", "ajuz": "تَسَفُّ الجِلَّةُ الخورُ الدَّرينا" },
    { "n": 75,  "sadr": "وَنَحنُ الحاكِمونَ إِذا أُطِعنا", "ajuz": "وَنَحنُ العازِمونَ إِذا عُصينا" },
    { "n": 76,  "sadr": "وَنَحنُ التّارِكونَ لِما سَخِطنا", "ajuz": "وَنَحنُ الآخِذونَ لِما رَضينا" },
    { "n": 77,  "sadr": "وَكُنّا الأَيمَنينَ إِذا اِلتَقَينا", "ajuz": "وَكانَ الأَيسَرينَ بَنو أَبينا" },
    { "n": 78,  "sadr": "فَصالوا صَولَةً فيمَن يَليهِم", "ajuz": "وَصُلنا صَولَةً فيمَن يَلينا" },
    { "n": 79,  "sadr": "فَآبوا بِالنِّهابِ وَبِالسَّبايا", "ajuz": "وَأُبنا بِالمُلوكِ مُصَفَّدينا" },
    { "n": 80,  "sadr": "إِلَيكُم يا بَني بَكرٍ إِلَيكُم", "ajuz": "أَلَمّا تَعرِفوا مِنّا اليَقينا" },
    { "n": 81,  "sadr": "أَلَمّا تَعرِفوا مِنّا وَمِنكُم", "ajuz": "كَتائِبَ يَطَّعِنَّ وَيَرتَمينا" },
    { "n": 82,  "sadr": "نَقودُ الخَيلَ دامِيَةً كُلاها", "ajuz": "إِلى الأَعداءِ لاحِقَةً بُطونا" },
    { "n": 83,  "sadr": "عَلَينا البَيضُ وَاليَلَبُ اليَماني", "ajuz": "وَأَسيافٌ يَقُمنَ وَيَنحَنينا" },
    { "n": 84,  "sadr": "عَلَينا كُلُّ سابِغَةٍ دِلاصٍ", "ajuz": "تَرى فَوقَ النِّطاقِ لَها غُضونا" },
    { "n": 85,  "sadr": "إِذا وُضِعَت عَنِ الأَبطالِ يَوماً", "ajuz": "رَأَيتَ لَها جُلودَ القَومِ جونا" },
    { "n": 86,  "sadr": "كَأَنَّ غُضونَهُنَّ مُتونُ غُدرٍ", "ajuz": "تُصَفِّقُها الرِّياحُ إِذا جَرَينا" },
    { "n": 87,  "sadr": "وَتَحمِلُنا غَداةَ الرَّوعِ جُردٌ", "ajuz": "عُرِفنَ لَنا نَقائِذَ وَافتُلينا" },
    { "n": 88,  "sadr": "وَرَدنَ دَوارِعاً وَخَرَجنَ شُعثاً", "ajuz": "كَأَمثالِ الرَّصائِعِ قَد بَلينا" },
    { "n": 89,  "sadr": "وَرِثناهُنَّ عَن آباءِ صِدقٍ", "ajuz": "وَنورِثُها إِذا مِتنا بَنينا" },
    { "n": 90,  "sadr": "عَلى آثارِنا بيضٌ حِسانٌ", "ajuz": "نُحاذِرُ أَن تُقَسَّمَ أَو تَهونا" },
    { "n": 91,  "sadr": "أَخَذنَ عَلى بُعولَتِهِنَّ عَهداً", "ajuz": "إِذا لاقَوا كَتائِبَ مُعلِمينا" },
    { "n": 92,  "sadr": "لَتَستَلِبُنَّ أَفراساً وَبيضاً", "ajuz": "وَأَسرى في الحَديدِ مُقَرَّنينا" },
    { "n": 93,  "sadr": "تَرانا بارِزينَ وَكُلُّ حَيٍّ", "ajuz": "قَدِ اِتَّخَذوا مَخافَتَنا قَرينا" },
    { "n": 94,  "sadr": "إِذا ما رُحنَ يَمشينَ الهُوَينى", "ajuz": "كَما اِضطَرَبَت مُتونُ الشّارِبينا" },
    { "n": 95,  "sadr": "يَقُتنَ جِيادَنا وَيَقُلنَ لَستُم", "ajuz": "بُعولَتَنا إِذا لَم تَمنَعونا" },
    { "n": 96,  "sadr": "إِذا لَم نَحمِهِنَّ فَلا بَقينا", "ajuz": "لِشَيءٍ بَعدَهُنَّ وَلا حَيينا" },
    { "n": 97,  "sadr": "ظَعائِنُ مِن بَني جُشَمِ اِبنِ بَكرٍ", "ajuz": "خَلَطنَ بِميسَمٍ حَسَباً وَدينا" },
    { "n": 98,  "sadr": "وَما مَنَعَ الظَّعائِنَ مِثلُ ضَربٍ", "ajuz": "تَرى مِنهُ السَّواعِدَ كَالقُلينا" },
    { "n": 99,  "sadr": "كَأَنّا وَالسُّيوفُ مُسَلَّلاتٌ", "ajuz": "وَلَدنا النّاسَ طُرّاً أَجمَعينا" },
    { "n": 100, "sadr": "يُدَهدونَ الرُّؤوسَ كَما تُدَهدي", "ajuz": "حَزاوِرَةٌ بِأَبطَحِها الكُرينا" },
    { "n": 101, "sadr": "وَقَد عَلِمَ القَبائِلُ مِن مَعَدٍّ", "ajuz": "إِذا قُبَبٌ بِأَبطَحِها بُنينا" },
    { "n": 102, "sadr": "بِأَنّا العاصِمونَ بِكُلِّ كَحلٍ", "ajuz": "وَأَنّا الباذِلونَ لِمُجتَدينا" },
    { "n": 103, "sadr": "وَأَنّا المُطعِمونَ إِذا قَدَرنا", "ajuz": "وَأَنّا المُهلِكونَ إِذا اِبتُلينا" },
    { "n": 104, "sadr": "وَأَنّا المانِعونَ لِما أَرَدنا", "ajuz": "وَأَنّا النّازِلونَ بِحَيثُ شينا" },
    { "n": 105, "sadr": "وَأَنّا المانِعونَ لِما يَلينا", "ajuz": "إِذا ما البيضُ زايَلَتِ الجُفونا" },
    { "n": 106, "sadr": "وَأَنّا التّارِكونَ إِذا سَخِطنا", "ajuz": "وَأَنّا الآخِذونَ إِذا رَضينا" },
    { "n": 107, "sadr": "وَأَنّا العاصِمونَ إِذا أُطِعنا", "ajuz": "وَأَنّا العارِمونَ إِذا عُصينا" },
    { "n": 108, "sadr": "وَأَنّا الطّالِبونَ إِذا نَقَمنا", "ajuz": "وَأَنّا الضّارِبونَ إِذا اِبتُلينا" },
    { "n": 109, "sadr": "وَأَنّا النّازِلونَ بِكُلِّ ثَغرٍ", "ajuz": "يَخافُ النّازِلونَ بِهِ المَنونا" },
    { "n": 110, "sadr": "وَنَشرَبُ إِن وَرَدنا الماءَ صَفواً", "ajuz": "وَيَشرَبُ غَيرُنا كَدِراً وَطينا" },
    { "n": 111, "sadr": "أَلا أَبلِغ بَني الطَّمّاحِ عَنّا", "ajuz": "وَدُعمِيّاً فَكَيفَ وَجَدتُمونا" },
    { "n": 112, "sadr": "إِذا ما المَلكُ سامَ النّاسَ خَسفاً", "ajuz": "أَبَينا أَن نُقِرَّ الذُّلَّ فينا" },
    { "n": 113, "sadr": "لَنا الدُّنيا وَمَن أَمسى عَلَيها", "ajuz": "وَنَبطِشُ حينَ نَبطِشُ قادِرينا" },
    { "n": 114, "sadr": "بُغاةً ظالِمينَ وَما ظُلِمنا", "ajuz": "وَلَكِنّا سَنَبدَأُ ظالِمينا" },
    { "n": 115, "sadr": "تَنادى المُصعَبانِ وَآلُ بَكرٍ", "ajuz": "وَنادَوا يا لَكِندَةَ أَجمَعينا" },
    { "n": 116, "sadr": "فَإِن نَغلِب فَغَلّابونَ قِدماً", "ajuz": "وَإِن نُغلَب فَغَيرُ مُغَلَّبينا" },
