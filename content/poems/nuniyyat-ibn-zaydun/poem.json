{
  "id": "nuniyyat-ibn-zaydun",
  "poet": "ibn-zaydun",
  "title": "نونِيَّةُ اِبنِ زَيدون",
  "meter": "basit",
  "rawiy": "ن",
  "abyat_in_full": 52,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1,    "sadr": "أَضحى التَّنائي بَديلاً مِن تَدانينا", "ajuz": "وَنابَ عَن طيبِ لُقيانا تَجافينا" },
    { "n": 2,    "sadr": "أَلّا وَقَد حانَ صُبحُ البَينِ صَبَّحَنا", "ajuz": "حَينٌ فَقامَ بِنا لِلحَينِ ناعينا" },
    { "n": 3,    "sadr": "مَن مُبلِغُ المُلبِسينا بِانتِزاحِهِمُ", "ajuz": "حُزناً مَعَ الدَّهرِ لا يَبلى وَيُبلينا" },
    { "n": 4,    "sadr": "أَنَّ الزَّمانَ الَّذي ما زالَ يُضحِكُنا", "ajuz": "أُنساً بِقُربِهِمُ قَد عادَ يُبكينا" },
    { "n": 5,    "sadr": "غيظَ العِدا مِن تَساقينا الهَوى فَدَعَوا", "ajuz": "بِأَن نَغَصَّ فَقالَ الدَّهرُ آمينا" },
    { "n": 6,    "sadr": "فَانحَلَّ ما كانَ مَعقوداً بِأَنفُسِنا", "ajuz": "وَانبَتَّ ما كانَ مَوصولاً بِأَيدينا" },
    { "n": 7,    "sadr": "وَقَد نَكونُ وَما يُخشى تَفَرُّقُنا", "ajuz": "فَاليَومَ نَحنُ وَما يُرجى تَلاقينا" },
    { "n": 8,    "sadr": "يا لَيتَ شِعري وَلَم نُعتِب أَعادِيَكُم", "ajuz": "هَل نالَ حَظّاً مِنَ العُتبى أَعادينا" },
    { "n": 9,    "sadr": "لَم نَعتَقِد بَعدَكُم إِلّا الوَفاءَ لَكُم", "ajuz": "رَأياً وَلَم نَتَقَلَّد غَيرَهُ دينا" },
    { "n": 10,   "sadr": "ما حَقُّنا أَن تُقِرّوا عَينَ ذي حَسَدٍ", "ajuz": "بِنا وَلا أَن تَسُرّوا كاشِحاً فينا" },
    { "n": 11,   "sadr": "كُنّا نَرى اليَأسَ تُسلينا عَوارِضُهُ", "ajuz": "وَقَد يَئِسنا فَما لِليَأسِ يُغرينا" },
    { "n": 12,   "sadr": "بِنتُم وَبِنّا فَما اِبتَلَّت جَوانِحُنا", "ajuz": "شَوقاً إِلَيكُم وَلا جَفَّت مَآقينا" },
    { "n": 13,   "sadr": "نَكادُ حينَ تُناجيكُم ضَمائِرُنا", "ajuz": "يَقضي عَلَينا الأَسى لَولا تَأَسّينا" },
    { "n": 14,   "sadr": "حالَت لِفَقدِكُمُ أَيّامُنا فَغَدَت", "ajuz": "سوداً وَكانَت بِكُم بيضاً لَيالينا" },
    { "n": 15,   "sadr": "إِذ جانِبُ العَيشِ طَلقٌ مِن تَأَلُّفِنا", "ajuz": "وَمَربَعُ اللَّهوِ صافٍ مِن تَصافينا" },
    { "n": 16,   "sadr": "وَإِذ هَصَرنا فُنونَ الوَصلِ دانِيَةً", "ajuz": "قِطافُها فَجَنَينا مِنهُ ما شينا" },
    { "n": 17,   "sadr": "لِيُسقَ عَهدُكُمُ عَهدُ السُّرورِ فَما", "ajuz": "كُنتُم لِأَرواحِنا إِلّا رَياحينا" },
    { "n": 18,   "sadr": "لا تَحسَبوا نَأيَكُم عَنّا يُغَيِّرُنا", "ajuz": "أَن طالَما غَيَّرَ النَّأيُ المُحِبّينا" },
    { "n": 19,   "sadr": "وَاللَّهِ ما طَلَبَت أَهواؤُنا بَدَلاً", "ajuz": "مِنكُم وَلا اِنصَرَفَت عَنكُم أَمانينا" },
    { "n": 20,   "sadr": "يا سارِيَ البَرقِ غادِ القَصرَ وَاسقِ بِهِ", "ajuz": "مَن كانَ صِرفَ الهَوى وَالوُدِّ يَسقينا" },
    { "n": 21,   "sadr": "وَاسأَل هُنالِكَ هَل عَنّى تَذَكُّرُنا", "ajuz": "إِلفاً تَذَكُّرُهُ أَمسى يُعَنّينا" },
    { "n": 22,   "sadr": "وَيا نَسيمَ الصَّبا بَلِّغ تَحِيَّتَنا", "ajuz": "مَن لَو عَلى البُعدِ حَيّا كانَ يُحيينا" },
    { "n": 23,   "sadr": "فَهَل أَرى الدَّهرَ يَقضينا مُساعَفَةً", "ajuz": "مِنهُ وَإِن لَم يَكُن غِبّاً تَقاضينا" },
    { "n": 24,   "sadr": "رَبيبُ مُلكٍ كَأَنَّ اللَّهَ أَنشَأَهُ", "ajuz": "مِسكاً وَقَدَّرَ إِنشاءَ الوَرى طينا" },
    { "n": 25,   "sadr": "أَو صاغَهُ وَرِقاً مَحضاً وَتَوَّجَهُ", "ajuz": "مِن ناصِعِ التِّبرِ إِبداعاً وَتَحسينا" },
    { "n": 26,   "sadr": "إِذا تَأَوَّدَ آدَتهُ رَفاهِيَةً", "ajuz": "تومُ العُقودِ وَأَدمَتهُ البُرى لينا" },
    { "n": 27,   "sadr": "كانَت لَهُ الشَّمسُ ظِئراً في أَكِلَّتِهِ", "ajuz": "بَل ما تَجَلّى لَها إِلّا أَحايينا" },
    { "n": 28,   "sadr": "كَأَنَّما أُثبِتَت في صَحنِ وَجنَتِهِ", "ajuz": "زُهرُ الكَواكِبِ تَعويذاً وَتَزيينا" },
    { "n": 29,   "sadr": "ما ضَرَّ أَن لَم نَكُن أَكفاءَهُ شَرَفاً", "ajuz": "وَفي المَوَدَّةِ كافٍ مِن تَكافينا" },
    { "n": 30,   "sadr": "يا رَوضَةً طالَما أَجنَت لَواحِظَنا", "ajuz": "وَرداً جَلاهُ الصَّبا غَضّاً وَنِسرينا" },
    { "n": 31,   "sadr": "وَيا حَياةً تَمَلَّينا بِزَهرَتِها", "ajuz": "مُنىً ضُروباً وَلَذّاتٍ أَفانينا" },
    { "n": 32,   "sadr": "وَيا نَعيماً خَطَرنا مِن غَضارَتِهِ", "ajuz": "في وَشيِ نُعمى سَحَبنا ذَيلَهُ حينا" },
    { "n": 33,   "sadr": "لَسنا نُسَمّيكِ إِجلالاً وَتَكرِمَةً", "ajuz": "وَقَدرُكِ المُعتَلي عَن ذاكَ يُغنينا" },
    { "n": 34,   "sadr": "إِذا اِنفَرَدتِ وَما شورِكتِ في صِفَةٍ", "ajuz": "فَحَسبُنا الوَصفُ إيضاحاً وَتَبيينا" },
    { "n": 35,   "sadr": "يا جَنَّةَ الخُلدِ أُبدِلنا بِسِدرَتِها", "ajuz": "وَالكَوثَرِ العَذبِ زَقّوماً وَغِسلينا" },
    { "n": 36,   "sadr": "إِن كانَ قَد عَزَّ في الدُّنيا اللِّقاءُ فَفي", "ajuz": "مَواقِفِ الحَشرِ نَلقاكُم وَيَكفينا" },
    { "n": 37,   "sadr": "كَأَنَّنا لَم نَبِت وَالوَصلُ ثالِثُنا", "ajuz": "وَالسَّعدُ قَد غَضَّ مِن أَجفانِ واشينا" },
    { "n": 38,   "sadr": "سِرّانِ في خاطِرِ الظَّلماءِ يَكتُمُنا", "ajuz": "حَتّى يَكادَ لِسانُ الصُّبحِ يُفشينا" },
    { "n": 39,   "sadr": "لا غَروَ في أَن ذَكَرنا الحُزنَ حينَ نَهَت", "ajuz": "عَنهُ النُّهى وَتَرَكنا الصَّبرَ ناسينا" },
    { "n": 40,   "sadr": "إِنّا قَرَأنا الأَسى يَومَ النَّوى سُوَراً", "ajuz": "مَكتوبَةً وَأَخَذنا الصَّبرَ تَلقينا" },
    { "n": 41,   "sadr": "أَمّا هَواكِ فَلَم نَعدِل بِمَنهَلِهِ", "ajuz": "شِرباً وَإِن كانَ يُروينا فَيُظمينا" },
    { "n": 42,   "sadr": "لَم نَجفُ أُفقَ جَمالٍ أَنتِ كَوكَبُهُ", "ajuz": "سالينَ عَنهُ وَلَم نَهجُرهُ قالينا" },
    { "n": 43,   "sadr": "وَلا اِختِياراً تَجَنَّبناهُ عَن كَثَبٍ", "ajuz": "لَكِن عَدَتنا عَلى كُرهٍ عَوادينا" },
    { "n": 44,   "sadr": "نَأسى عَلَيكِ إِذا حُثَّت مُشَعشَعَةً", "ajuz": "فينا الشَّمولُ وَغَنّانا مُغَنّينا" },
    { "n": 45,   "sadr": "لا أَكؤُسُ الرّاحِ تُبدي مِن شَمائِلِنا", "ajuz": "سيما اِرتِياحٍ وَلا الأَوتارُ تُلهينا" },
    { "n": 46,   "sadr": "دومي عَلى العَهدِ ما دُمنا مُحافِظَةً", "ajuz": "فَالحُرُّ مَن دانَ إِنصافاً كَما دينا" },
    { "n": 47,   "sadr": "فَما اِستَعَضنا خَليلاً مِنكِ يَحبِسُنا", "ajuz": "وَلا اِستَفَدنا حَبيباً عَنكِ يَثنينا" },
    { "n": 48,   "sadr": "وَلَو صَبا نَحوَنا مِن عُلوِ مَطلَعِهِ", "ajuz": "بَدرُ الدُّجى لَم يَكُن حاشاكِ يُصبينا" },
    { "n": 49,   "sadr": "أَولي وَفاءً وَإِن لَم تَبذُلي صِلَةً", "ajuz": "فَالطَّيفُ يُقنِعُنا وَالذِّكرُ يَكفينا" },
    { "n": 50,   "sadr": "وَفي الجَوابِ مَتاعٌ إِن شَفَعتِ بِهِ", "ajuz": "بيضَ الأَيادي الَّتي ما زِلتِ تولينا" },
    { "n": 51,   "sadr": "عَلَيكِ مِنّا سَلامُ اللَّهِ ما بَقِيَت", "ajuz": "صَبابَةٌ بِكِ نُخفيها فَتُخفينا" }
  ]
}
