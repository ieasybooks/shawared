{
  "id": "banat-suad",
  "poet": "kab-ibn-zuhayr",
  "title": "بانَت سُعادُ",
  "meter": "basit",
  "themes": ["apology", "prophetic"],
  "rawiy": "ل",
  "abyat_in_full": 59,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "بانَت سُعادُ فَقَلبي اليَومَ مَتبولُ", "ajuz": "مُتَيَّمٌ إِثرَها لَم يُفدَ مَكبولُ" },
    { "n": 2,  "sadr": "وَما سُعادُ غَداةَ البَينِ إِذ رَحَلوا", "ajuz": "إِلّا أَغَنُّ غَضيضُ الطَّرفِ مَكحولُ" },
    { "n": 3,  "sadr": "هَيفاءُ مُقبِلَةً عَجزاءُ مُدبِرَةً", "ajuz": "لا يُشتَكى قِصَرٌ مِنها وَلا طولُ" },
    { "n": 4,  "sadr": "تَجلو عَوارِضَ ذي ظَلمٍ إِذا اِبتَسَمَت", "ajuz": "كَأَنَّهُ مُنهَلٌ بِالرّاحِ مَعلولُ" },
    { "n": 5,  "sadr": "شُجَّت بِذي شَبَمٍ مِن ماءِ مَحنِيَةٍ", "ajuz": "صافٍ بِأَبطَحَ أَضحى وَهوَ مَشمولُ" },
    { "n": 6,  "sadr": "تَنفي الرِّياحُ القَذى عَنهُ وَأَفرَطَهُ", "ajuz": "مِن صَوبِ سارِيَةٍ بيضٌ يَعاليلُ" },
    { "n": 7,  "sadr": "يا وَيحَها خُلَّةً لَو أَنَّها صَدَقَت", "ajuz": "ما وَعَدَت أَو لَوَ اَنَّ النُّصحَ مَقبولُ" },
    { "n": 8,  "sadr": "لَكِنَّها خُلَّةٌ قَد سيطَ مِن دَمِها", "ajuz": "فَجعٌ وَوَلعٌ وَإِخلافٌ وَتَبديلُ" },
    { "n": 9,  "sadr": "فَما تَدومُ عَلى حالٍ تَكونُ بِها", "ajuz": "كَما تَلَوَّنُ في أَثوابِها الغولُ" },
    { "n": 10, "sadr": "وَلا تَمَسَّكُ بِالعَهدِ الَّذي زَعَمَت", "ajuz": "إِلّا كَما يُمسِكُ الماءَ الغَرابيلُ" },
    { "n": 11, "sadr": "فَلا يَغُرَّنكَ ما مَنَّت وَما وَعَدَت", "ajuz": "إِنَّ الأَمانِيَّ وَالأَحلامَ تَضليلُ" },
    { "n": 12, "sadr": "كانَت مَواعيدُ عُرقوبٍ لَها مَثَلاً", "ajuz": "وَما مَواعيدُها إِلّا الأَباطيلُ" },
    { "n": 13, "sadr": "أَرجو وَآمُلُ أَن تَدنو مَوَدَّتُها", "ajuz": "وَما إِخالُ لَدَينا مِنكِ تَنويلُ" },
    { "n": 14, "sadr": "أَمسَت سُعادُ بِأَرضٍ لا يُبَلِّغُها", "ajuz": "إِلّا العِتاقُ النَّجيباتُ المَراسيلُ" },
    { "n": 15, "sadr": "وَلَن يُبَلِّغَها إِلّا عُذافِرَةٌ", "ajuz": "لَها عَلى الأَينِ إِرقالٌ وَتَبغيلُ" },
    { "n": 16, "sadr": "مِن كُلِّ نَضّاخَةِ الذِّفرى إِذا عَرِقَت", "ajuz": "عُرضَتُها طامِسُ الأَعلامِ مَجهولُ" },
    { "n": 17, "sadr": "تَرمي الغُيوبَ بِعَينَي مُفرَدٍ لَهَقٍ", "ajuz": "إِذا تَوَقَّدَتِ الحُزّانُ وَالميلُ" },
    { "n": 18, "sadr": "ضَخمٌ مُقَلَّدُها فَعمٌ مُقَيَّدُها", "ajuz": "في خَلقِها عَن بَناتِ الفَحلِ تَفضيلُ" },
    { "n": 19, "sadr": "غَلباءُ وَجناءُ عُلكومٌ مُذَكَّرَةٌ", "ajuz": "في دَفِّها سَعَةٌ قُدّامُها ميلُ" },
    { "n": 20, "sadr": "وَجِلدُها مِن أَطومٍ ما يُؤَيِّسُهُ", "ajuz": "طِلحٌ بِضاحِيَةِ المَتنَينِ مَهزولُ" },
    { "n": 21, "sadr": "حَرفٌ أَخوها أَبوها مِن مُهَجَّنَةٍ", "ajuz": "وَعَمُّها خالُها قَوداءُ شِمليلُ" },
    { "n": 22, "sadr": "يَمشي القُرادُ عَلَيها ثُمَّ يُزلِقُهُ", "ajuz": "مِنها لَبانٌ وَأَقرابٌ زَهاليلُ" },
    { "n": 23, "sadr": "عَيرانَةٌ قُذِفَت بِالنَّحضِ عَن عُرُضٍ", "ajuz": "مِرفَقُها عَن بَناتِ الزَّورِ مَفتولُ" },
    { "n": 24, "sadr": "كَأَنَّما فاتَ عَينَيها وَمَذبَحَها", "ajuz": "مِن خَطمِها وَمِنَ اللَّحيَينِ بِرطيلُ" },
    { "n": 25, "sadr": "تَمُرُّ مِثلَ عَسيبِ النَّخلِ ذا خُصَلٍ", "ajuz": "في غارِزٍ لَم تَخَوَّنهُ الأَحاليلُ" },
    { "n": 26, "sadr": "قَنواءُ في حُرَّتَيها لِلبَصيرِ بِها", "ajuz": "عِتقٌ مُبينٌ وَفي الخَدَّينِ تَسهيلُ" },
    { "n": 27, "sadr": "تَخدي عَلى يَسَراتٍ وَهيَ لاحِقَةٌ", "ajuz": "ذَوابِلٍ مَسُّهُنَّ الأَرضَ تَحليلُ" },
    { "n": 28, "sadr": "سُمرُ العُجاياتِ يَترُكنَ الحَصى زِيَماً", "ajuz": "لَم يَقِهِنَّ رُؤوسَ الأُكمِ تَنعيلُ" },
    { "n": 29, "sadr": "كَأَنَّ أَوبَ ذِراعَيها إِذا عَرِقَت", "ajuz": "وَقَد تَلَفَّعَ بِالقورِ العَساقيلُ" },
    { "n": 30, "sadr": "يَوماً يَظَلُّ بِهِ الحِرباءُ مُصطَخِداً", "ajuz": "كَأَنَّ ضاحِيَهُ بِالشَّمسِ مَملولُ" },
    { "n": 31, "sadr": "وَقالَ لِلقَومِ حاديهِم وَقَد جَعَلَت", "ajuz": "وُرقُ الجَنادِبِ يَركُضنَ الحَصى قيلوا" },
    { "n": 32, "sadr": "شَدَّ النَّهارِ ذِراعا عَيطَلٍ نَصَفٍ", "ajuz": "قامَت فَجاوَبَها نُكدٌ مَثاكيلُ" },
    { "n": 33, "sadr": "نَوّاحَةٍ رِخوَةِ الضَّبعَينِ لَيسَ لَها", "ajuz": "لَمّا نَعى بِكرَها النّاعونَ مَعقولُ" },
    { "n": 34, "sadr": "تَفري اللَّبانَ بِكَفَّيها وَمِدرَعُها", "ajuz": "مُشَقَّقٌ عَن تَراقيها رَعابيلُ" },
    { "n": 35, "sadr": "يَسعى الوُشاةُ جَنابَيها وَقَولُهُمُ", "ajuz": "إِنَّكَ يا اِبنَ أَبي سُلمى لَمَقتولُ" },
    { "n": 36, "sadr": "وَقالَ كُلُّ خَليلٍ كُنتُ آمُلُهُ", "ajuz": "لا أُلفِيَنَّكَ إِنّي عَنكَ مَشغولُ" },
    { "n": 37, "sadr": "فَقُلتُ خَلّوا سَبيلي لا أَبا لَكُمُ", "ajuz": "فَكُلُّ ما قَدَّرَ الرَّحمَنُ مَفعولُ" },
    { "n": 38, "sadr": "كُلُّ اِبنِ أُنثى وَإِن طالَت سَلامَتُهُ", "ajuz": "يَوماً عَلى آلَةٍ حَدباءَ مَحمولُ" },
    { "n": 39, "sadr": "أُنبِئتُ أَنَّ رَسولَ اللَّهِ أَوعَدَني", "ajuz": "وَالعَفوُ عِندَ رَسولِ اللَّهِ مَأمولُ" },
    { "n": 40, "sadr": "مَهلاً هَداكَ الَّذي أَعطاكَ نافِلَةَ", "ajuz": "القُرآنِ فيها مَواعيظٌ وَتَفصيلُ" },
    { "n": 41, "sadr": "لا تَأخُذَنّي بِأَقوالِ الوُشاةِ وَلَم", "ajuz": "أُذنِب وَلَو كَثُرَت فِيَّ الأَقاويلُ" },
    { "n": 42, "sadr": "لَقَد أَقومُ مَقاماً لَو يَقومُ بِهِ", "ajuz": "أَرى وَأَسمَعُ ما لَو يَسمَعُ الفيلُ" },
    { "n": 43, "sadr": "لَظَلَّ يُرعَدُ إِلّا أَن يَكونَ لَهُ", "ajuz": "مِنَ الرَّسولِ بِإِذنِ اللَّهِ تَنويلُ" },
    { "n": 44, "sadr": "ما زِلتُ أَقتَطِعُ البَيداءَ مُدَّرِعاً", "ajuz": "جُنحَ الظَّلامِ وَثَوبُ اللَّيلِ مَسدولُ" },
    { "n": 45, "sadr": "حَتّى وَضَعتُ يَميني لا أُنازِعُهُ", "ajuz": "في كَفِّ ذي نَقِماتٍ قيلُهُ القيلُ" },
    { "n": 46, "sadr": "لَذاكَ أَهيَبُ عِندي إِذ أُكَلِّمُهُ", "ajuz": "وَقيلَ إِنَّكَ مَنسوبٌ وَمَسؤولُ" },
    { "n": 47, "sadr": "مِن ضَيغَمٍ مِن ضِراءِ الأُسدِ مَخدَرُهُ", "ajuz": "بِبَطنِ عَثَّرَ غيلٌ دونَهُ غيلُ" },
    { "n": 48, "sadr": "يَغدو فَيَلحَمُ ضِرغامَينِ عَيشُهُما", "ajuz": "لَحمٌ مِنَ القَومِ مَعفورٌ خَراديلُ" },
    { "n": 49, "sadr": "إِذا يُساوِرُ قِرناً لا يَحِلُّ لَهُ", "ajuz": "أَن يَترُكَ القِرنَ إِلّا وَهوَ مَفلولُ" },
    { "n": 50, "sadr": "مِنهُ تَظَلُّ سِباعُ الجَوِّ ضامِزَةً", "ajuz": "وَلا تَمَشّى بِواديهِ الأَراجيلُ" },
    { "n": 51, "sadr": "وَلا يَزالُ بِواديهِ أَخو ثِقَةٍ", "ajuz": "مُطَرَّحُ البَزِّ وَالدُّرسانِ مَأكولُ" },
    { "n": 52, "sadr": "إِنَّ الرَّسولَ لَسَيفٌ يُستَضاءُ بِهِ", "ajuz": "مُهَنَّدٌ مِن سُيوفِ اللَّهِ مَسلولُ" },
    { "n": 53, "sadr": "في فِتيَةٍ مِن قُرَيشٍ قالَ قائِلُهُم", "ajuz": "بِبَطنِ مَكَّةَ لَمّا أَسلَموا زولوا" },
    { "n": 54, "sadr": "زالوا فَما زالَ أَنكاسٌ وَلا كُشُفٌ", "ajuz": "عِندَ اللِّقاءِ وَلا ميلٌ مَعازيلُ" },
    { "n": 55, "sadr": "شُمُّ العَرانينِ أَبطالٌ لَبوسُهُمُ", "ajuz": "مِن نَسجِ داوُدَ في الهَيجا سَرابيلُ" },
    { "n": 56, "sadr": "بيضٌ سَوابِغُ قَد شُكَّت لَها حَلَقٌ", "ajuz": "كَأَنَّها حَلَقُ القَفعاءِ مَجدولُ" },
    { "n": 57, "sadr": "يَمشونَ مَشيَ الجِمالِ الزُّهرِ يَعصِمُهُم", "ajuz": "ضَربٌ إِذا عَرَّدَ السّودُ التَّنابيلُ" },
    { "n": 58, "sadr": "لا يَفرَحونَ إِذا نالَت رِماحُهُمُ", "ajuz": "قَوماً وَلَيسوا مَجازيعاً إِذا نيلوا" },
    { "n": 59, "sadr": "لا يَقَعُ الطَّعنُ إِلّا في نُحورِهِمُ", "ajuz": "وَما لَهُم عَن حِياضِ المَوتِ تَهليلُ" }
  ]
}
