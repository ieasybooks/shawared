{
  "id": "khalilayya-hadha-rabu",
  "poet": "kuthayyir-azza",
  "title": "خَليلَيَّ هَذا رَبعُ عَزَّةَ فَاعقِلا",
  "meter": "tawil",
  "rawiy": "ت",
  "abyat_in_full": 43,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "خَليلَيَّ هَذا رَبعُ عَزَّةَ فَاعقِلا",
      "ajuz": "قَلوصَيكُما ثُمَّ اِبكِيا حَيثُ حَلَّتِ"
    },
    {
      "n": 2,
      "sadr": "وَمُسّا تُراباً كانَ قَد مَسَّ جِلدَها",
      "ajuz": "وَبيتا وَظِلّا حَيثُ باتَت وَظَلَّتِ"
    },
    {
      "n": 3,
      "sadr": "وَلا تَيأَسا أَن يَمحُوَ اللَّهُ عَنكُما",
      "ajuz": "ذُنوباً إِذا صَلَّيتُما حَيثُ صَلَّتِ"
    },
    {
      "n": 4,
      "sadr": "وَما كُنتُ أَدري قَبلَ عَزَّةَ ما البُكا",
      "ajuz": "وَلا موجِعاتِ القَلبِ حَتّى تَوَلَّتِ"
    },
    {
      "n": 5,
      "sadr": "وَما أَنصَفَت أَمّا النِّساءُ فَبَغَّضَت",
      "ajuz": "إِلَينا وَأَمّا بِالنَّوالِ فَضَنَّتِ"
    },
    {
      "n": 6,
      "sadr": "فَقَد حَلَفَت جَهداً بِما نَحَرَت لَهُ",
      "ajuz": "قُرَيشٌ غَداةَ المَأزِمَينِ وَصَلَّتِ"
    },
    {
      "n": 7,
      "sadr": "أُناديكَ ما حَجَّ الحَجيجُ وَكَبَّرَت",
      "ajuz": "بِفَيفاءِ آلٍ رُفقَةٌ وَأَهَلَّتِ"
    },
    {
      "n": 8,
      "sadr": "وَما كَبَّرَت مِن فَوقِ رُكبَةَ رُفقَةٌ",
      "ajuz": "وَمِن ذي غَزالٍ أَشعَرَت وَاِستَهَلَّتِ"
    },
    {
      "n": 9,
      "sadr": "وَكانَت لِقَطعِ الحَبلِ بَيني وَبَينَها",
      "ajuz": "كَناذِرَةٍ نَذراً وَفَت فَأَحَلَّتِ"
    },
    {
      "n": 10,
      "sadr": "فَقُلتُ لَها يا عَزَّ كُلُّ مُصيبَةٍ",
      "ajuz": "إِذا وُطِّنَت يَوماً لَها النَّفسُ ذَلَّتِ"
    },
    {
      "n": 11,
      "sadr": "وَلَم يَلقَ إِنسانٌ مِنَ الحُبِّ مَيعَةً",
      "ajuz": "تَعُمُّ وَلا عَمياءَ إِلّا تَجَلَّتِ"
    },
    {
      "n": 12,
      "sadr": "فَإِن سَأَلَ الواشونَ فيمَ صَرَمتُها",
      "ajuz": "فَقُل نَفسُ حُرٍّ سُلِّيَت فَتَسَلَّتِ"
    },
    {
      "n": 13,
      "sadr": "كَأَنّي أُنادي صَخرَةً حينَ أَعرَضَت",
      "ajuz": "مِنَ الصُّمِّ لَو تَمشي بِها العُصمُ زَلَّتِ"
    },
    {
      "n": 14,
      "sadr": "صَفوحٌ فَما تَلقاكَ إِلّا بَخيلَةً",
      "ajuz": "فَمَن مَلَّ مِنها ذَلِكَ الوَصلَ مَلَّتِ"
    },
    {
      "n": 15,
      "sadr": "أَباحَت حِمىً لَم يَرعَهُ النّاسُ قَبلَها",
      "ajuz": "وَحَلَّت تِلاعاً لَم تَكُن قَبلُ حُلَّتِ"
    },
    {
      "n": 16,
      "sadr": "فَلَيتَ قَلوصي عِندَ عَزَّةَ قُيِّدَت",
      "ajuz": "بِحَبلٍ ضَعيفٍ غُرَّ مِنها فَضَلَّتِ"
    },
    {
      "n": 17,
      "sadr": "وَغودِرَ في الحَيِّ المُقيمينَ رَحلُها",
      "ajuz": "وَكانَ لَها باغٍ سِوايَ فَبَلَّتِ"
    },
    {
      "n": 18,
      "sadr": "وَكُنتُ كَذي رِجلَينِ رِجلٍ صَحيحَةٍ",
      "ajuz": "وَرِجلٍ رَمى فيها الزَّمانُ فَشَلَّتِ"
    },
    {
      "n": 19,
      "sadr": "وَكُنتُ كَذاتِ الظَّلعِ لَمّا تَحامَلَت",
      "ajuz": "عَلى ظَلعِها بَعدَ العِثارِ اِستَقَلَّتِ"
    },
    {
      "n": 20,
      "sadr": "أُريدُ الثَّواءَ عِندَها وَأَظُنُّها",
      "ajuz": "إِذا ما أَطَلنا عِندَها المُكثَ مَلَّتِ"
    },
    {
      "n": 21,
      "sadr": "يُكَلِّفُها الخِنزيرُ شَتمي وَما بِها",
      "ajuz": "هَواني وَلَكِن لِلمَليكِ اِستَذَلَّتِ"
    },
    {
      "n": 22,
      "sadr": "هَنيئاً مَريئاً غَيرَ داءٍ مُخامِرٍ",
      "ajuz": "لِعَزَّةَ مِن أَعراضِنا ما اِستَحَلَّتِ"
    },
    {
      "n": 23,
      "sadr": "وَوَاللَّهِ ما قارَبتُ إِلّا تَباعَدَت",
      "ajuz": "بِصَرمٍ وَلا أَكثَرتُ إِلّا أَقَلَّتِ"
    },
    {
      "n": 24,
      "sadr": "وَلي زَفَراتٌ لَو يَدُمنَ قَتَلنَني",
      "ajuz": "تُوالي الَّتي تَأتي المُنى قَد تَوَلَّتِ"
    },
    {
      "n": 25,
      "sadr": "وَكُنّا سَلَكنا في صَعودٍ مِنَ الهَوى",
      "ajuz": "فَلَمّا تَوافَينا ثَبَتُّ وَزَلَّتِ"
    },
    {
      "n": 26,
      "sadr": "وَكُنّا عَقَدنا عُقدَةَ الوَصلِ بَينَنا",
      "ajuz": "فَلَمّا تَواثَقنا شَدَدتُ وَحَلَّتِ"
    },
    {
      "n": 27,
      "sadr": "فَإِن تَكُنِ العُتبى فَأَهلاً وَمَرحَباً",
      "ajuz": "وَحُقَّت لَها العُتبى لَدَينا وَقَلَّتِ"
    },
    {
      "n": 28,
      "sadr": "وَإِن تَكُنِ الأُخرى فَإِنَّ وَراءَنا",
      "ajuz": "بِلاداً إِذا كَلَّفتُها العيسَ كَلَّتِ"
    },
    {
      "n": 29,
      "sadr": "خَليلَيَّ إِنَّ الحاجِبِيَّةَ طَلَّحَت",
      "ajuz": "قَلوصَيكُما وَناقَتي قَد أَكَلَّتِ"
    },
    {
      "n": 30,
      "sadr": "فَلا يَبعُدَن وَصلٌ لِعَزَّةَ أَصبَحَت",
      "ajuz": "بِعاقِبَةٍ أَسبابُهُ قَد تَوَلَّتِ"
    },
    {
      "n": 31,
      "sadr": "أَسيئي بِنا أَو أَحسِني لا مَلومَةً",
      "ajuz": "لَدَينا وَلا مَقلِيَّةً إِن تَقَلَّتِ"
    },
    {
      "n": 32,
      "sadr": "وَلَكِن أَنيلي وَاِذكُري مِن مَوَدَّةٍ",
      "ajuz": "لَنا خُلَّةً كانَت لَدَيكُم فَضَلَّتِ"
    },
    {
      "n": 33,
      "sadr": "وَإِنّي وَإِن صَدَّت لَمُثنٍ وَصادِقٌ",
      "ajuz": "عَلَيها بِما كانَت إِلَينا أَزَلَّتِ"
    },
    {
      "n": 34,
      "sadr": "فَما أَنا بِالدّاعي لَعَزَّةَ بِالرَّدى",
      "ajuz": "وَلا شامِتٍ إِن نَعلُ عَزَّةَ زَلَّتِ"
    },
    {
      "n": 35,
      "sadr": "فَلا يَحسَبِ الواشونَ أَنَّ صَبابَتي",
      "ajuz": "بِعَزَّةَ كانَت غَمرَةً فَتَجَلَّتِ"
    },
    {
      "n": 36,
      "sadr": "فَأَصبَحتُ قَد أَبلَلتُ مِن دَنَفٍ بِها",
      "ajuz": "كَما أُدنِفَت هَيماءُ ثُمَّ اِستَبَلَّتِ"
    },
    {
      "n": 37,
      "sadr": "فَوَاللَّهِ ثُمَّ اللَّهِ لا حَلَّ بَعدَها",
      "ajuz": "وَلا قَبلَها مِن خُلَّةٍ حَيثُ حَلَّتِ"
    },
    {
      "n": 38,
      "sadr": "وَما مَرَّ مِن يَومٍ عَلَيَّ كَيَومِها",
      "ajuz": "وَإِن عَظُمَت أَيّامُ أُخرى وَجَلَّتِ"
    },
    {
      "n": 39,
      "sadr": "وَحَلَّت بِأَعلى شاهِقٍ مِن فُؤادِهِ",
      "ajuz": "فَلا القَلبُ يَسلاها وَلا النَّفسُ مَلَّتِ"
    },
    {
      "n": 40,
      "sadr": "فَوا عَجَباً لِلقَلبِ كَيفَ اِعتِرافُهُ",
      "ajuz": "وَلِلنَّفسِ لَمّا وُطِّنَت فَاِطمَأَنَّتِ"
    },
    {
      "n": 41,
      "sadr": "وَإِنّي وَتَهيامي بِعَزَّةَ بَعدَما",
      "ajuz": "تَخَلَّيتُ مِمّا بَينَنا وَتَخَلَّتِ"
    },
    {
      "n": 42,
      "sadr": "لَكَالمُرتَجي ظِلَّ الغَمامَةِ كُلَّما",
      "ajuz": "تَبَوَّأَ مِنها لِلمَقيلِ اِضمَحَلَّتِ"
    },
    {
      "n": 43,
      "sadr": "كَأَنّي وَإِيّاها سَحابَةُ مُمحِلٍ",
      "ajuz": "رَجاها فَلَمّا جاوَزَتهُ اِستَهَلَّتِ"
    }
  ]
}
