{
  "id": "al-qubbara-wabnuha",
  "poet": "ahmad-shawqi",
  "title": "القُبَّرَةُ وَابنُها",
  "meter": "rajaz",
  "abyat_in_full": 10,
  "added": "2026-11-24",
  "abyat": [
    {"n": 1, "sadr": "رَأَيتُ في بَعضِ الرِّياضِ قُبَّرَةً", "ajuz": "تُطَيِّرُ اِبنَها بِأَعلى الشَّجَرَةِ"},
    {"n": 2, "sadr": "وَهيَ تَقولُ يا جَمالَ العُشِّ", "ajuz": "لا تَعتَمِد عَلى الجَناحِ الهَشِّ"},
    {"n": 3, "sadr": "وَقِف عَلى عودٍ بِجَنبِ عودِ", "ajuz": "وَافعَل كَما أَفعَلُ في الصُّعودِ"},
    {"n": 4, "sadr": "فَانتَقَلَت مِن فَنَنٍ إِلى فَنَن", "ajuz": "وَجَعَلَت لِكُلِّ نَقلَةٍ زَمَن"},
    {"n": 5, "sadr": "كَي يَستَريحَ الفَرخُ في الأَثناءِ", "ajuz": "فَلا يَمَلُّ ثِقَلَ الهَواءِ"},
    {"n": 6, "sadr": "لَكِنَّهُ قَد خالَفَ الإِشارَةَ", "ajuz": "لَمّا أَرادَ يُظهِرُ الشَّطارَةَ"},
    {"n": 7, "sadr": "وَطارَ في الفَضاءِ حَتّى اِرتَفَعا", "ajuz": "فَخانَهُ جَناحُهُ فَوَقَعا"},
    {"n": 8, "sadr": "فَانكَسَرَت في الحالِ رُكبَتاهُ", "ajuz": "وَلَم يَنَل مِنَ العُلا مُناهُ"},
    {"n": 9, "sadr": "وَلَو تَأَنّى نالَ ما تَمَنّى", "ajuz": "وَعاشَ طولَ عُمرِهِ مُهَنّا"},
    {"n": 10, "sadr": "لِكُلِّ شَيءٍ في الحَياةِ وَقتُهُ", "ajuz": "وَغايَةُ المُستَعجِلينَ فَوتُهُ"}
  ]
}
