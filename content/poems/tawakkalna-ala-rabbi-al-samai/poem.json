{
  "id": "tawakkalna-ala-rabbi-al-samai",
  "poet": "ali-ibn-al-jahm",
  "title": "تَوَكَّلنا عَلى رَبِّ السَّماءِ",
  "meter": "wafir",
  "themes": ["hikma", "religion"],
  "rawiy": "ء",
  "abyat_in_full": 29,
  "added": "2026-11-19",
  "abyat": [
    { "n": 1, "sadr": "تَوَكَّلنا عَلى رَبِّ السَّماءِ", "ajuz": "وَسَلَّمنا لِأَسبابِ القَضاءِ" },
    { "n": 2, "sadr": "وَوَطَّنّا عَلى غَيرِ اللَّيالي", "ajuz": "نُفوساً سامَحَت بَعدَ الإِباءِ" },
    { "n": 3, "sadr": "وَأَفنِيَةُ المُلوكِ مُحَجَّباتٌ", "ajuz": "وَبابُ اللَّهِ مَبذولُ الفِناءِ" },
    { "n": 4, "sadr": "فَما أَرجو سِواهُ لِكَشفِ ضُرّي", "ajuz": "وَلَم أَفزَع إِلى غَيرِ الدُّعاءِ" },
    { "n": 5, "sadr": "وَلِمَ لا أَشتَكي بَثّي وَحُزني", "ajuz": "إِلى مَن لا يَصَمُّ عَنِ النِّداءِ" },
    { "n": 6, "sadr": "هِيَ الأَيّامُ تَكلِمُنا وَتَأسو", "ajuz": "وَتَجري بِالسَّعادَةِ وَالشَّقاءِ" },
    { "n": 7, "sadr": "فَلا طولُ الثَّواءِ يَرُدُّ رِزقاً", "ajuz": "وَلا يَأتي بِهِ طولُ البَقاءِ" },
    { "n": 8, "sadr": "وَلا يُجدي الثَّراءُ عَلى بَخيلٍ", "ajuz": "إِذا ما كانَ مَحظورَ الثَّراءِ" },
    { "n": 9, "sadr": "وَلَيسَ يَبيدُ مالٌ عَن نَوالٍ", "ajuz": "وَلا يُؤتى سَخِيٌّ مِن سَخاءِ" },
    { "n": 10, "sadr": "كَما أَنَّ السُّؤالَ يُذِلُّ قَوماً", "ajuz": "كَذاكَ يُعِزُّ قَوماً بِالعَطاءِ" },
    { "n": 11, "sadr": "حَلَبنا الدَّهرَ أَشطُرَهُ وَمَرَّت", "ajuz": "بِنا عُقَبُ الشَّدائِدِ وَالرَّخاءِ" },
    { "n": 12, "sadr": "فَلَم آسَف عَلى دُنيا تَوَلَّت", "ajuz": "وَلَم نُسبَق إِلى حُسنِ العَزاءِ" },
    { "n": 13, "sadr": "وَلَم نَدَعِ الحَياءَ لِمَسِّ ضُرٍّ", "ajuz": "وَبَعضُ الضُّرِّ يَذهَبُ بِالحَياءِ" },
    { "n": 14, "sadr": "وَجَرَّبنا وَجَرَّبَ أَوَّلونا", "ajuz": "فَلا شَيءٌ أَعَزُّ مِنَ الوَفاءِ" }
  ]
}
