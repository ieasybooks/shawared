{
  "id": "al-khuffash-wa-malikat-al-farash",
  "poet": "ahmad-shawqi",
  "title": "حِكايَةُ الخُفّاشِ وَمَليكَةِ الفَراشِ",
  "meter": "rajaz",
  "themes": ["fables"],
  "abyat_in_full": 31,
  "added": "2026-11-19",
  "abyat": [
    { "n": 1, "sadr": "مَرَّت عَلى الخُفّاشِ", "ajuz": "مَليكَةُ الفَراشِ" },
    { "n": 2, "sadr": "تَطيرُ بِالجُموعِ", "ajuz": "سَعياً إِلى الشُّموعِ" },
    { "n": 3, "sadr": "فَعَطَفَت وَمالَت", "ajuz": "وَاِستَضحَكَت فَقالَت" },
    { "n": 4, "sadr": "أَزرَيتَ بِالغَرامِ", "ajuz": "يا عاشِقَ الظَّلامِ" },
    { "n": 5, "sadr": "صِف لي الصَّديقَ الأَسوَدا", "ajuz": "الخامِلَ المُجَرَّدا" },
    { "n": 6, "sadr": "قالَ سَأَلتِ فيهِ", "ajuz": "أَصدَقَ واصِفيهِ" },
    { "n": 7, "sadr": "هُوَ الصَّديقُ الوافي", "ajuz": "الكامِلُ الأَوصافِ" },
    { "n": 8, "sadr": "جِوارُهُ أَمانُ", "ajuz": "وَسِرُّهُ كِتمانُ" },
    { "n": 9, "sadr": "وَطَرفُهُ كَليلُ", "ajuz": "إِذا هَفا الخَليلُ" },
    { "n": 10, "sadr": "يَحنو عَلى العُشّاقِ", "ajuz": "يَسمَعُ لِلمُشتاقِ" },
    { "n": 11, "sadr": "وَجُملَةُ المَقالِ", "ajuz": "هُوَ الحَبيبُ الغالي" },
    { "n": 12, "sadr": "فَقالَتِ الحَمقاءُ", "ajuz": "وَقَولُها اِستِهزاءُ" },
    { "n": 13, "sadr": "أَينَ أَبو المِسكِ الخَصِيُّ", "ajuz": "ذو الثَّمَنِ المُستَرخَصِ" },
    { "n": 14, "sadr": "مِن صاحِبي الأَميرِ", "ajuz": "الظّاهِرِ المُنيرِ" },
    { "n": 15, "sadr": "إِن عُدَّ فيمَن أَعرِفُ", "ajuz": "أَسمو بِهِ وَأَشرُفُ" },
    { "n": 16, "sadr": "وَإِن سُئِلتُ عَنهُ", "ajuz": "وَعَن مَكاني مِنهُ" },
    { "n": 17, "sadr": "أُفاخِرُ الأَترابا", "ajuz": "وَأَنثَني إِعجابا" },
    { "n": 18, "sadr": "فَقالَ يا مَليكَةُ", "ajuz": "وَرَبَّةَ الأَريكَةِ" },
    { "n": 19, "sadr": "إِنَّ مِنَ الغُرورِ", "ajuz": "مَلامَةَ المَغرورِ" },
    { "n": 20, "sadr": "فَأَعطِني قَفاكِ", "ajuz": "وَاِمضي إِلى الهَلاكِ" },
    { "n": 21, "sadr": "فَتَرَكَتهُ ساخِرَةً", "ajuz": "وَذَهَبَت مُفاخِرَةً" },
    { "n": 22, "sadr": "وَبَعدَ ساعَةٍ مَضَت", "ajuz": "مِنَ الزَّمانِ فَاِنقَضَت" },
    { "n": 23, "sadr": "مَرَّت عَلى الخُفّاشِ", "ajuz": "مَليكَةُ الفَراشِ" },
    { "n": 24, "sadr": "ناقِصَةَ الأَعضاءِ", "ajuz": "تَشكو مِنَ الفَناءِ" },
    { "n": 25, "sadr": "فَجاءَها مُنهَمِكا", "ajuz": "يُضحِكُهُ مِنها البُكا" },
    { "n": 26, "sadr": "قالَ أَلَم أَقُل لَكِ", "ajuz": "هَلَكتِ أَو لَم تَهلِكي" },
    { "n": 27, "sadr": "رُبَّ صَديقٍ عَبدِ", "ajuz": "أَبيَضُ وَجهِ الوُدِّ" },
    { "n": 28, "sadr": "يَفديكِ كَالرَّئيسِ", "ajuz": "بِالنَّفسِ وَالنَّفيسِ" },
    { "n": 29, "sadr": "وَصاحِبٍ كَالنّورِ", "ajuz": "في الحُسنِ وَالظُّهورِ" },
    { "n": 30, "sadr": "مُعتَكِرِ الفُؤادِ", "ajuz": "مُضَيِّعِ الوِدادِ" },
    { "n": 31, "sadr": "حِبالُهُ أَشراكُ", "ajuz": "وَقُربُهُ هَلاكُ" }
  ]
}
