{
  "id": "al-bayan-fi-tahzib-al-quran",
  "poet": "muhammad-abu-raqaba",
  "title": "البَيانُ في تَحزيبِ القُرآنِ",
  "meter": "rajaz",
  "abyat_in_full": 14,
  "added": "2026-11-19",
  "abyat": [
    {"n": 1, "sadr": "إِن قيلَ قُل لي يا فَتى الإيمانِ", "ajuz": "كَم سورَةً في مُحكَمِ القُرآنِ"},
    {"n": 2, "sadr": "فَمِئَةٌ وَأَربَعٌ وَعَشَرَة", "ajuz": "أَسماؤُها مَعروفَةٌ مُشتَهِرَة"},
    {"n": 3, "sadr": "وَاتَّفَقوا في سِتَّةِ الآلافِ", "ajuz": "وَمِئَتَينِ وَبِلا خِلافِ"},
    {"n": 4, "sadr": "في عَدِّ آيِهِ وَما زادَ أَتى", "ajuz": "خِلافُهُم فيهِ لِوَقفٍ ثَبَتا"},
    {"n": 5, "sadr": "هَذا وَقَد حَزَّبَهُ الحَجّاجُ", "ajuz": "سِتّينَ حِزباً كُلُّ حِزبٍ تاجُ"},
    {"n": 6, "sadr": "وَقُسِّمَ الحِزبُ إِلى أَرباعِ", "ajuz": "فَاحفَظ وَكُن بِالحَقِّ خَيرَ داعِ"},
    {"n": 7, "sadr": "وَالجُزءُ ما كانَ مِنَ الحِزبَينِ", "ajuz": "وَهوَ ثَلاثونَ بِغَيرِ مَينِ"},
    {"n": 8, "sadr": "تَعاهَدِ القُرآنَ بِالإِكثارِ", "ajuz": "مِنَ التِّلاوَةِ وَلا تُمارِ"},
    {"n": 9, "sadr": "فَاقرَأهُ في شَهرٍ كَما جاءَ الخَبَر", "ajuz": "عَنِ النَّبِيِّ المُصطَفى خَيرِ البَشَر"},
    {"n": 10, "sadr": "وَاقرَأهُ في سَبعٍ إِذا كُنتَ فَتىً", "ajuz": "مِثلَ اِبنِ عَمرٍو إِنَّهُ نِعمَ الفَتى"},
    {"n": 11, "sadr": "وَهَكَذا الصَّحابَةُ الكِرامُ", "ajuz": "قَد حَزَّبوهُ وَهوَ التَّمامُ"},
    {"n": 12, "sadr": "قَد أُنزِلَ القُرآنُ بِالتَّرتيلِ", "ajuz": "كَما أَتى في مُحكَمِ التَّنزيلِ"},
    {"n": 13, "sadr": "فَرَتِّلِ القُرآنَ تَرتيلاً كَما", "ajuz": "قَد جاءَنا مُرَتَّلاً مِنَ السَّما"},
    {"n": 14, "sadr": "يا رَبِّ فَاجعَلهُ لَنا شَفيعاً", "ajuz": "وَاجعَلهُ في القَلبِ لَنا رَبيعاً"}
  ]
}
