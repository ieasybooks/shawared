{
  "id": "saha-al-qalbu",
  "poet": "zuhayr-ibn-abi-sulma",
  "title": "صَحا القَلبُ عَن سَلمى وَأَقصَرَ باطِلُه",
  "meter": "tawil",
  "rawiy": "ل",
  "abyat_in_full": 47,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "صَحا القَلبُ عَن سَلمى وَأَقصَرَ باطِلُه",
      "ajuz": "وَعُرِّيَ أَفراسُ الصِّبا وَرَواحِلُه"
    },
    {
      "n": 2,
      "sadr": "وَأَقصَرتُ عَمّا تَعلَمينَ وَسُدِّدَت",
      "ajuz": "عَلَيَّ سِوى قَصدِ السَّبيلِ مَعادِلُه"
    },
    {
      "n": 3,
      "sadr": "وَقالَ العَذارى إِنَّما أَنتَ عَمُّنا",
      "ajuz": "وَكانَ الشَّبابُ كَالخَليطِ نُزايِلُه"
    },
    {
      "n": 4,
      "sadr": "فَأَصبَحتُ ما يَعرِفنَ إِلّا خَليقَتي",
      "ajuz": "وَإِلّا سَوادَ الرَّأسِ وَالشَّيبُ شامِلُه"
    },
    {
      "n": 5,
      "sadr": "لِمَن طَلَلٌ كَالوَحيِ عافٍ مَنازِلُه",
      "ajuz": "عَفا الرَّسُّ مِنهُ فَالرُّسَيسُ فَعاقِلُه"
    },
    {
      "n": 6,
      "sadr": "فَرَقدٌ فَصاراتٌ فَأَكنافُ مَنعِجٍ",
      "ajuz": "فَشَرقِيُّ سَلمى حَوضُهُ فَأَجاوِلُه"
    },
    {
      "n": 7,
      "sadr": "فَوادي البَدِيِّ فَالطَّوِيُّ فَثادِقٌ",
      "ajuz": "فَوادي القَنانِ جِزعُهُ فَأَفاكِلُه"
    },
    {
      "n": 8,
      "sadr": "وَغَيثٍ مِنَ الوَسمِيِّ حُوٍّ تِلاعُهُ",
      "ajuz": "أَجابَت رَوابيهِ النِّجا وَهَواطِلُه"
    },
    {
      "n": 9,
      "sadr": "هَبَطتُ بِمَمسودِ النَّواشِرِ سابِحٍ",
      "ajuz": "مُمَرٍّ أَسيلِ الخَدِّ نَهدٍ مَراكِلُه"
    },
    {
      "n": 10,
      "sadr": "تَميمٍ فَلَوناهُ فَأُكمِلَ صُنعُهُ",
      "ajuz": "فَتَمَّ وَعَزَّتهُ يَداهُ وَكاهِلُه"
    },
    {
      "n": 11,
      "sadr": "أَمينٍ شَظاهُ لَم يُخَرَّق صِفاقُهُ",
      "ajuz": "بِمِنقَبَةٍ وَلَم تُقَطَّع أَباجِلُه"
    },
    {
      "n": 12,
      "sadr": "إِذا ما غَدَونا نَبتَغي الصَّيدَ مَرَّةً",
      "ajuz": "مَتى نَرَهُ فَإِنَّنا لا نُخاتِلُه"
    },
    {
      "n": 13,
      "sadr": "فَبَينا نُبَغّي الصَّيدَ جاءَ غُلامُنا",
      "ajuz": "يَدِبُّ وَيُخفي شَخصَهُ وَيُضائِلُه"
    },
    {
      "n": 14,
      "sadr": "فَقالَ شِياهٌ راتِعاتٌ بِقَفرَةٍ",
      "ajuz": "بِمُستَأسِدِ القُريانِ حُوٍّ مَسائِلُه"
    },
    {
      "n": 15,
      "sadr": "ثَلاثٌ كَأَقواسِ السَّراءِ وَمِسحَلٌ",
      "ajuz": "قَدِ اِخضَرَّ مِن لَسِّ الغَميرِ جَحافِلُه"
    },
    {
      "n": 16,
      "sadr": "وَقَد خَرَّمَ الطُّرّادُ عَنهُ جِحاشَهُ",
      "ajuz": "فَلَم يَبقَ إِلّا نَفسُهُ وَحَلائِلُه"
    },
    {
      "n": 17,
      "sadr": "فَقالَ أَميري ما تَرى رَأيَ ما نَرى",
      "ajuz": "أَنَختِلُهُ عَن نَفسِهِ أَم نُصاوِلُه"
    },
    {
      "n": 18,
      "sadr": "فَبِتنا عُراةً عِندَ رَأسِ جَوادِنا",
      "ajuz": "يُزاوِلُنا عَن نَفسِهِ وَنُزاوِلُه"
    },
    {
      "n": 19,
      "sadr": "وَنَضرِبُهُ حَتّى اِطمَئَنَّ قَذالُهُ",
      "ajuz": "وَلَم يَطمَئِنَّ قَلبُهُ وَخَصائِلُه"
    },
    {
      "n": 20,
      "sadr": "وَمُلجِمُنا ما إِن يَنالُ قَذالَهُ",
      "ajuz": "وَلا قَدَماهُ الأَرضَ إِلّا أَنامِلُه"
    },
    {
      "n": 21,
      "sadr": "فَلَأياً بِلَأيٍ ما حَمَلنا وَليدَنا",
      "ajuz": "عَلى ظَهرِ مَحبوكٍ ظِماءٍ مَفاصِلُه"
    },
    {
      "n": 22,
      "sadr": "وَقُلتُ لَهُ سَدِّد وَأَبصِر طَريقَهُ",
      "ajuz": "وَما هُوَ فيهِ عَن وَصاتِيَ شاغِلُه"
    },
    {
      "n": 23,
      "sadr": "وَقُلتُ تَعَلَّم أَنَّ لِلصَّيدِ غِرَّةً",
      "ajuz": "وَإِلّا تُضَيِّعها فَإِنَّكَ قاتِلُه"
    },
    {
      "n": 24,
      "sadr": "فَتَبَّعَ آثارَ الشِّياهِ وَليدُنا",
      "ajuz": "كَشُؤبوبِ غَيثٍ يَحفِشُ الأُكمَ وابِلُه"
    },
    {
      "n": 25,
      "sadr": "نَظَرتُ إِلَيهِ نَظرَةً فَرَأَيتُهُ",
      "ajuz": "عَلى كُلِّ حالٍ مَرَّةً هُوَ حامِلُه"
    },
    {
      "n": 26,
      "sadr": "يُثِرنَ الحَصى في وَجهِهِ وَهوَ لاحِقٌ",
      "ajuz": "سِراعٌ تَواليهِ صِيابٌ أَوائِلُه"
    },
    {
      "n": 27,
      "sadr": "فَرَدَّ عَلَينا العَيرَ مِن دونِ إِلفِهِ",
      "ajuz": "عَلى رُغمِهِ يَدمى نَساهُ وَفائِلُه"
    },
    {
      "n": 28,
      "sadr": "فَرُحنا بِهِ يَنضو الجِيادَ عَشِيَّةً",
      "ajuz": "مُخَضَّبَةً أَرساغُهُ وَعَوامِلُه"
    },
    {
      "n": 29,
      "sadr": "بِذي مَيعَةٍ لا مَوضِعُ الرُّمحِ مُسلِمٌ",
      "ajuz": "لِبُطءٍ وَلا ما خَلفَ ذَلِكَ خاذِلُه"
    },
    {
      "n": 30,
      "sadr": "وَأَبيَضَ فَيّاضٍ يَداهُ غَمامَةٌ",
      "ajuz": "عَلى مُعتَفيهِ ما تُغِبُّ فَواضِلُه"
    },
    {
      "n": 31,
      "sadr": "بَكَرتُ عَلَيهِ غُدوَةً فَرَأَيتُهُ",
      "ajuz": "قُعوداً لَدَيهِ بِالصَّريمِ عَواذِلُه"
    },
    {
      "n": 32,
      "sadr": "يُفَدّينَهُ طَوراً وَطَوراً يَلُمنَهُ",
      "ajuz": "وَأَعيا فَما يَدرينَ أَينَ مَخاتِلُه"
    },
    {
      "n": 33,
      "sadr": "فَأَقصَرنَ مِنهُ عَن كَريمٍ مُرَزَّءٍ",
      "ajuz": "عَزومٍ عَلى الأَمرِ الَّذي هُوَ فاعِلُه"
    },
    {
      "n": 34,
      "sadr": "أَخي ثِقَةٍ لا تُتلِفُ الخَمرُ مالَهُ",
      "ajuz": "وَلَكِنَّهُ قَد يُهلِكُ المالَ نائِلُه"
    },
    {
      "n": 35,
      "sadr": "تَراهُ إِذا ما جِئتَهُ مُتَهَلِّلاً",
      "ajuz": "كَأَنَّكَ تُعطيهِ الَّذي أَنتَ سائِلُه"
    },
    {
      "n": 36,
      "sadr": "وَذي نَسَبٍ ناءٍ بَعيدٍ وَصَلتَهُ",
      "ajuz": "بِمالٍ وَما يَدري بِأَنَّكَ واصِلُه"
    },
    {
      "n": 37,
      "sadr": "وَذي نِعمَةٍ تَمَّمتَها وَشَكَرتَها",
      "ajuz": "وَخَصمٍ يَكادُ يَغلِبُ الحَقَّ باطِلُه"
    },
    {
      "n": 38,
      "sadr": "دَفَعتَ بِمَعروفٍ مِنَ القَولِ صائِبٍ",
      "ajuz": "إِذا ما أَضَلَّ النّاطِقينَ مَفاصِلُه"
    },
    {
      "n": 39,
      "sadr": "وَذي خَطَلٍ في القَولِ يَحسِبُ أَنَّهُ",
      "ajuz": "مُصيبٌ فَما يُلمِم بِهِ فَهوَ قائِلُه"
    },
    {
      "n": 40,
      "sadr": "عَبَأتَ لَهُ حِلماً وَأَكرَمتَ غَيرَهُ",
      "ajuz": "وَأَعرَضتَ عَنهُ وَهوَ بادٍ مَقاتِلُه"
    },
    {
      "n": 41,
      "sadr": "حُذَيفَةُ يُنميهِ وَبَدرٌ كِلاهُما",
      "ajuz": "إِلى باذِخٍ يَعلو عَلى مَن يُطاوِلُه"
    },
    {
      "n": 42,
      "sadr": "وَمَن مِثلُ حِصنٍ في الحُروبِ وَمِثلُهُ",
      "ajuz": "لِإِنكارِ ضَيمٍ أَو لِأَمرٍ يُحاوِلُه"
    },
    {
      "n": 43,
      "sadr": "أَبى الضَّيمَ وَالنُّعمانُ يَحرِقُ نابَهُ",
      "ajuz": "عَلَيهِ فَأَفضى وَالسُّيوفُ مَعاقِلُه"
    },
    {
      "n": 44,
      "sadr": "عَزيزٌ إِذا حَلَّ الحَليفانِ حَولَهُ",
      "ajuz": "بِذي لَجَبٍ لَجّاتُهُ وَصَواهِلُه"
    },
    {
      "n": 45,
      "sadr": "يُهَدُّ لَهُ ما دونَ رَملَةِ عالِجٍ",
      "ajuz": "وَمَن أَهلُهُ بِالغَورِ زالَت زَلازِلُه"
    },
    {
      "n": 46,
      "sadr": "وَأَهلِ خِباءٍ صالِحٍ ذاتُ بَينِهِم",
      "ajuz": "قَدِ اِحتَرَبوا في عاجِلٍ أَنا آجِلُه"
    },
    {
      "n": 47,
      "sadr": "فَأَقبَلتُ في السّاعينَ أَسأَلُ عَنهُمُ",
      "ajuz": "سُؤالَكَ بِالشَّيءِ الَّذي أَنتَ جاهِلُه"
    }
  ]
}
