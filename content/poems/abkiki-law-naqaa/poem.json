{
  "id": "abkiki-law-naqaa",
  "poet": "al-sharif-al-radi",
  "title": "أَبكيكِ لَو نَقَعَ الغَليلَ بُكائي",
  "meter": "kamil",
  "rawiy": "ء",
  "abyat_in_full": 68,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَبكيكِ لَو نَقَعَ الغَليلَ بُكائي",
      "ajuz": "وَأَقولُ لَو ذَهَبَ المَقالُ بِدائي"
    },
    {
      "n": 2,
      "sadr": "وَأَعوذُ بِالصَّبرِ الجَميلِ تَعَزِّياً",
      "ajuz": "لَو كانَ بِالصَّبرِ الجَميلِ عَزائي"
    },
    {
      "n": 3,
      "sadr": "طوراً تُكاثِرُني الدُّموعُ وَتارَةً",
      "ajuz": "آوي إِلى أَكرومَتي وَحَيائي"
    },
    {
      "n": 4,
      "sadr": "كَم عَبرَةٍ مَوَّهتُها بِأَنامِلي",
      "ajuz": "وَسَتَرتُها مُتَجَمِّلاً بِرِدائي"
    },
    {
      "n": 5,
      "sadr": "أُبدي التَّجَلُّدَ لِلعَدوِّ وَلَو دَرى",
      "ajuz": "بِتَمَلمُلي لَقَدِ اِشتَفى أَعدائي"
    },
    {
      "n": 6,
      "sadr": "ما كُنتُ أَذخَرُ في فِداكِ رَغيبَةً",
      "ajuz": "لَو كانَ يَرجِعُ مَيِّتٌ بِفِداءِ"
    },
    {
      "n": 7,
      "sadr": "لَو كانَ يُدفَعُ ذا الحِمامُ بِقُوَّةٍ",
      "ajuz": "لَتَكَدَّسَت عُصَبٌ وَراءَ لِوائي"
    },
    {
      "n": 8,
      "sadr": "بِمُدَرَّبينَ عَلى القِراعِ تَفَيَّأوا",
      "ajuz": "ظِلَّ الرِّماحِ لِكُلِّ يَومِ لِقاءِ"
    },
    {
      "n": 9,
      "sadr": "قَومٌ إِذا مَرِهوا بِأَغبابِ السُّرى",
      "ajuz": "كَحَلوا العُيونَ بِإِثمِدِ الظَّلماءِ"
    },
    {
      "n": 10,
      "sadr": "يَمشونَ في حَلَقِ الدُّروعِ كَأَنَّهُم",
      "ajuz": "صُمُّ الجَلامِدِ في غَديرِ الماءِ"
    },
    {
      "n": 11,
      "sadr": "بِبُروقِ أَدراعٍ وَرَعدِ صَوارِمٍ",
      "ajuz": "وَغَمامِ قَسطَلَةٍ وَوَبلِ دِماءِ"
    },
    {
      "n": 12,
      "sadr": "فارَقتُ فيكِ تَماسُكي وَتَجَمُّلي",
      "ajuz": "وَنَسيتُ فيكِ تَعَزُّزي وَإِبائي"
    },
    {
      "n": 13,
      "sadr": "وَصَنَعتُ ما ثَلَمَ الوَقارَ صَنيعُهُ",
      "ajuz": "مِمّا عَراني مِن جَوى البُرحاءِ"
    },
    {
      "n": 14,
      "sadr": "كَم زَفرَةٍ ضَعُفَت فَصارَت أَنَّةً",
      "ajuz": "تَمَّمتُها بِتَنَفُّسِ الصُّعَداءِ"
    },
    {
      "n": 15,
      "sadr": "لَهفانَ أَنزو في حَبائِلِ كُربَةٍ",
      "ajuz": "مَلَكَت عَلَيَّ جَلادَتي وَغَنائي"
    },
    {
      "n": 16,
      "sadr": "وَجَرى الزَّمانُ عَلى عَوائِدِ كَيدِهِ",
      "ajuz": "في قَلبِ آمالي وَعَكسِ رَجائي"
    },
    {
      "n": 17,
      "sadr": "قَد كُنتُ آمُلُ أَن أَكونَ لَكِ الفِدا",
      "ajuz": "مِمّا أَلَمَّ فَكُنتِ أَنتِ فِدائي"
    },
    {
      "n": 18,
      "sadr": "وَتَفَرُّقُ البُعداءِ بَعدَ مَوَدَّةٍ",
      "ajuz": "صَعبٌ فَكَيفَ تَفَرُّقُ القُرَباءِ"
    },
    {
      "n": 19,
      "sadr": "وَخَلائِقُ الدُّنيا خَلائِقُ مومِسٍ",
      "ajuz": "لِلمَنعِ آوِنَةً وَلِلإِعطاءِ"
    },
    {
      "n": 20,
      "sadr": "طَوراً تُبادِلُكَ الصَّفاءَ وَتارَةً",
      "ajuz": "تَلقاكَ تُنكِرُها مِنَ البَغضاءِ"
    },
    {
      "n": 21,
      "sadr": "وَتَداوُلُ الأَيّامِ يُبلينا كَما",
      "ajuz": "يُبلي الرَّشاءَ تَطاوُحُ الأَرجاءِ"
    },
    {
      "n": 22,
      "sadr": "وَكَأَنَّ طولَ العُمرِ رَوحَةُ راكِبٍ",
      "ajuz": "قَضّى اللُّغوبَ وَجَدَّ في الإِسراءِ"
    },
    {
      "n": 23,
      "sadr": "أَمضَيتِ عَيشَكِ عِفَّةً وَزَهادَةً",
      "ajuz": "وَطُرِحتِ مُثقَلَةً مِنَ الأَعباءِ"
    },
    {
      "n": 24,
      "sadr": "بِصِيامِ يَومِ القَيظِ تَلهَبُ شَمسُهُ",
      "ajuz": "وَقِيامِ طولِ اللَّيلَةِ اللَّيلاءِ"
    },
    {
      "n": 25,
      "sadr": "ما كانَ يَوماً بِالغَبينِ مَنِ اِشتَرى",
      "ajuz": "رَغدَ الجِنانِ بِعيشَةٍ خَشناءِ"
    },
    {
      "n": 26,
      "sadr": "لَو كانَ مِثلَكِ كُلُّ أُمٍّ بَرَّةٍ",
      "ajuz": "غَنِيَ البَنونَ بِها عَنِ الآباءِ"
    },
    {
      "n": 27,
      "sadr": "كَيفَ السُّلوُّ وَكُلُّ مَوقِعِ لَحظَةٍ",
      "ajuz": "أَثَرٌ لِفَضلِكِ خالِدٌ بِإِزائي"
    },
    {
      "n": 28,
      "sadr": "فَعَلاتُ مَعروفٍ تُقِرُّ نَواظِري",
      "ajuz": "فَتَكونُ أَجلَبَ جالِبٍ لِبُكائي"
    },
    {
      "n": 29,
      "sadr": "ما ماتَ مَن نَزَعَ البَقاءَ وَذِكرُهُ",
      "ajuz": "بِالصّالِحاتِ يُعَدُّ في الأَحياءِ"
    },
    {
      "n": 30,
      "sadr": "فَبِأَيِّ كَفٍّ أَستَجِنُّ وَأَتَّقي",
      "ajuz": "صَرفَ النَّوائِبِ أَم بِأَيِّ دُعاءِ"
    },
    {
      "n": 31,
      "sadr": "وَمَنِ المُمَوِّلُ لي إِذا ضاقَت يَدي",
      "ajuz": "وَمَنِ المُعَلِّلُ لي مِنَ الأَدواءِ"
    },
    {
      "n": 32,
      "sadr": "وَمَنِ الَّذي إِن ساوَرَتني نَكبَةٌ",
      "ajuz": "كانَ المُوَقّي لي مِنَ الأَسواءِ"
    },
    {
      "n": 33,
      "sadr": "أَم مَن يَلِطُّ عَلَيَّ سِترَ دُعائِهِ",
      "ajuz": "حَرَماً مِنَ البَأساءِ وَالضَّرّاءِ"
    },
    {
      "n": 34,
      "sadr": "رُزآنِ يَزدادانِ طولَ تَجَدُّدٍ",
      "ajuz": "أَبَدَ الزَّمانِ فَناؤُها وَبَقائي"
    },
    {
      "n": 35,
      "sadr": "شَهِدَ الخَلائِقُ أَنَّها لَنَجيبَةٌ",
      "ajuz": "بِدَليلِ مَن وَلَدَت مِنَ النُّجَباءِ"
    },
    {
      "n": 36,
      "sadr": "في كُلِّ مُظلِمِ أَزمَةٍ أَو ضيقَةٍ",
      "ajuz": "يَبدو لَها أَثَرُ اليَدِ البَيضاءِ"
    },
    {
      "n": 37,
      "sadr": "ذَخَرَت لَنا الذِّكرَ الجَميلَ إِذا اِنقَضى",
      "ajuz": "ما يَذخَرُ الآباءُ لِلأَبناءِ"
    },
    {
      "n": 38,
      "sadr": "قَد كُنتُ آمُلُ أَن يَكونَ أَمامَها",
      "ajuz": "يَومي وَتُشفِقُ أَن تَكونَ وَرائي"
    },
    {
      "n": 39,
      "sadr": "كَم آمِرٍ لي بِالتَّصَبُّرِ هاجَ لي",
      "ajuz": "داءً وَقَدَّرَ أَنَّ ذاكَ دَوائي"
    },
    {
      "n": 40,
      "sadr": "آوي إِلى بَردِ الظِّلالِ كَأنَّني",
      "ajuz": "لِتَحَرُّقي آوي إِلى الرَّمضاءِ"
    },
    {
      "n": 41,
      "sadr": "وَأَهُبُّ مِن طيبِ المَنامِ تَفَزُّعاً",
      "ajuz": "فَزَعَ اللَّديغِ نَبا عَنِ الإِغفاءِ"
    },
    {
      "n": 42,
      "sadr": "آباؤُكِ الغُرُّ الَّذينَ تَفَجَّرَت",
      "ajuz": "بِهِمِ يَنابيعٌ مِنَ النَّعماءِ"
    },
    {
      "n": 43,
      "sadr": "مِن ناصِرٍ لِلحَقِّ أَو داعٍ إِلى",
      "ajuz": "سُبُلِ الهُدى أَو كاشِفِ الغَمّاءِ"
    },
    {
      "n": 44,
      "sadr": "نَزَلوا بِعَرعَرَةِ السَّنامِ مِنَ العُلى",
      "ajuz": "وَعَلَوا عَلى الأَثباجِ وَالأَمطاءِ"
    },
    {
      "n": 45,
      "sadr": "مِن كُلِّ مُستَبِقِ اليَدَينِ إِلى النَّدى",
      "ajuz": "وَمُسَدِّدِ الأَقوالِ وَالآراءِ"
    },
    {
      "n": 46,
      "sadr": "يُرجى عَلى النَّظَرِ الحَديدِ تَكَرُّماً",
      "ajuz": "وَيُخافُ في الإِطراقِ وَالإِغضاءِ"
    },
    {
      "n": 47,
      "sadr": "دَرَجوا عَلى أَثَرِ القُرونِ وَخَلَّفوا",
      "ajuz": "طُرُقاً مُعَبَّدَةً مِنَ العَلياءِ"
    },
    {
      "n": 48,
      "sadr": "يا قَبرُ أَمنَحُهُ الهَوى وَأَوَدُّ لَو",
      "ajuz": "نَزَفَت عَلَيهِ دُموعُ كُلِّ سَماءِ"
    },
    {
      "n": 49,
      "sadr": "لا زالَ مُرتَجِزُ الرُّعودِ مُجَلجِلٌ",
      "ajuz": "هَزِجُ البَوارِقِ مُجلِبُ الضَّوضاءِ"
    },
    {
      "n": 50,
      "sadr": "يَرغو رُغاءَ العودِ جَعجَعَهُ السُّرى",
      "ajuz": "وَيَنوءُ نَوءَ المُقرِبِ العُشَراءِ"
    },
    {
      "n": 51,
      "sadr": "يَقتادُ مُثقَلَةَ الغَمامِ كَأَنَّما",
      "ajuz": "يَنهَضنَ بِالعَقَداتِ وَالأَنقاءِ"
    },
    {
      "n": 52,
      "sadr": "يَهفو بِها جِنحَ الدُّجى وَيَسوقُها",
      "ajuz": "سَوقَ البِطاءِ بِعاصِفٍ هَوجاءِ"
    },
    {
      "n": 53,
      "sadr": "يَرميكَ بارِقُها بِأَفلاذِ الحَيا",
      "ajuz": "وَيَفُضُّ فيكَ لَطائِمَ الأَنداءِ"
    },
    {
      "n": 54,
      "sadr": "مُتَحَلِّباً عَذراءَ كُلِّ سَحابَةٍ",
      "ajuz": "تَغذو الجَميمَ بِرَوضَةٍ عَذراءِ"
    },
    {
      "n": 55,
      "sadr": "لَلَؤُمتُ إِن لَم أَسقِها بِمَدامِعي",
      "ajuz": "وَوَكَلتُ سُقياها إِلى الأَنواءِ"
    },
    {
      "n": 56,
      "sadr": "لَهفي عَلى القَومِ الأُلى غادَرتُهُم",
      "ajuz": "وَعَلَيهِمُ طَبَقٌ مِنَ البَيداءِ"
    },
    {
      "n": 57,
      "sadr": "صُوَرٌ ضَنَنتُ عَلى العُيونِ بِلَحظِها",
      "ajuz": "أَمسَيتُ أوقِرُها مِنَ البَوغاءِ"
    },
    {
      "n": 58,
      "sadr": "وَنَواظِرٌ كَحَلَ التُّرابُ جُفونَها",
      "ajuz": "قَد كُنتُ أَحرُسُها مِنَ الأَقذاءِ"
    },
    {
      "n": 59,
      "sadr": "قَرُبَت ضَرائِحُهُم عَلى زُوّارِها",
      "ajuz": "وَنَأوا عَنِ الطُّلّابِ أَيَّ تَنائي"
    },
    {
      "n": 60,
      "sadr": "وَلَبِئسَ ما تَلقى بِعُقرِ دِيارِهِم",
      "ajuz": "أُذنُ المُصيخِ بِها وَعَينُ الرائي"
    },
    {
      "n": 61,
      "sadr": "مَعروفُكِ السامي أَنيسُكِ كُلَّما",
      "ajuz": "وَرَدَ الظَّلامُ بِوَحشَةِ الغَبراءِ"
    },
    {
      "n": 62,
      "sadr": "وَضِياءُ ما قَدَّمتِهِ مِن صالِحٍ",
      "ajuz": "لَكِ في الدُّجى بَدَلٌ مِنَ الأَضواءِ"
    },
    {
      "n": 63,
      "sadr": "إِنَّ الَّذي أَرضاهُ فِعلُكِ لا تَزَل",
      "ajuz": "تُرضيكِ رَحمَتُهُ صَباحَ مَساءِ"
    },
    {
      "n": 64,
      "sadr": "صَلّى عَلَيكِ وَما فَقَدتِ صَلاتَهُ",
      "ajuz": "قَبلَ الرَّدى وَجَزاكِ أَيَّ جَزاءِ"
    },
    {
      "n": 65,
      "sadr": "لَو كانَ يُبلِغُكِ الصَّفيحُ رَسائِلي",
      "ajuz": "أَو كانَ يُسمِعُكِ التُّرابُ نِدائي"
    },
    {
      "n": 66,
      "sadr": "لَسَمِعتِ طولَ تَأَوُّهي وَتَفَجُّعي",
      "ajuz": "وَعَلِمتِ حُسنَ رِعايَتي وَوَفائي"
    },
    {
      "n": 67,
      "sadr": "كانَ اِرتِكاضي في حَشاكِ مُسَبِّباً",
      "ajuz": "رَكضَ الغَليلِ عَلَيكِ في أَحشائي"
    }
  ]
}
