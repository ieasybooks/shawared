{
  "id": "li-suquri-ardin",
  "poet": "ihab-al-shabatat",
  "title": "لِصُقورِ أَرضٍ زَورَةُ العَلياءِ",
  "meter": "kamil",
  "rawiy": "ء",
  "abyat_in_full": 35,
  "added": "2026-11-19",
  "abyat": [
    {"n": 1, "sadr": "لِصُقورِ أَرضٍ زَورَةُ العَلياءِ", "ajuz": "تَتَقارَبُ الأَرواحُ في الأَكفاءِ"},
    {"n": 2, "sadr": "ما ضَرَّني عُقمُ الحَياةِ بِأَهلِها", "ajuz": "تَلِدُ الزُّهورُ رَحيقَها بِإِنائي"},
    {"n": 3, "sadr": "تَزهو يَنابيعُ الرَّبيعِ بِرَشفَةٍ", "ajuz": "تَتَقَمَّصُ الفَمَ مِن دَمِ الشُّعَراءِ"},
    {"n": 4, "sadr": "نَسَماتُ خَدِّ الزَّهرِ فِيَّ تُظِلُّني", "ajuz": "إِن صاحَ شَوكُ هَباءَةٍ بِعِدائي"},
    {"n": 5, "sadr": "أَنكَرتُ أَطلالاً عَرَفتُ بِها جَوىً", "ajuz": "وَهَيُؤتُ أَعراقاً بِلا سيماءِ"},
    {"n": 6, "sadr": "وَفُئِدتُ بِالأَبياتِ حَتّى خِلتُها", "ajuz": "مَنظومَةً بِنُشارَةِ الأَحشاءِ"},
    {"n": 7, "sadr": "أَمشي وَحيداً في دَياجيرِ الوَرى", "ajuz": "عَقلي يُنيرُ بَقِيَّةَ الأَحياءِ"},
    {"n": 8, "sadr": "أَرَقُ الفَيافي بِاللَّيالي ضَمَّني", "ajuz": "وَعَشَوتُ نَفسي وَالجَميعُ إِزائي"},
    {"n": 9, "sadr": "في كالِحِ اللَّيلِ الجِبالُ تَرى الَّذي", "ajuz": "ما لا تَراهُ كَواحِلُ الغَبراءِ"},
    {"n": 10, "sadr": "يَتَعاظَمُ الأَشخاصُ وَزنَ مَهابَةٍ", "ajuz": "وَعُقولُهُم مَوزونَةُ الآراءِ"},
    {"n": 11, "sadr": "وَأَرى نُجومَ اللَّيلِ في أَصفادِها", "ajuz": "فَيَميلُ بي هَمّي إِلى أَدوائي"},
    {"n": 12, "sadr": "وَتَمورُ عَجلى ذِكرِياتُ طُفولَتي", "ajuz": "وَتَثورُ أَحلامٌ قَلَت أَرزائي"},
    {"n": 13, "sadr": "فَأَرى رُؤىً أُحجِيَّةٌ خُطُواتُها", "ajuz": "طارَت بِبَغدادٍ إِلى صَنعاءِ"},
    {"n": 14, "sadr": "ضَحِكُ الطُّفولَةِ في غَدٍ وَمُرَدِّداً", "ajuz": "تَرنيمَةً تَرنو إِلى أَصدائي"},
    {"n": 15, "sadr": "وَرَأَيتُ ثَغرَ الكَونِ باسِمَةً وَفي", "ajuz": "كَفّي فَسيلٌ مِن شَذى أَندائي"},
    {"n": 16, "sadr": "عَبَقُ العُذوقِ يَمُدُّ في أَرجائِهِ", "ajuz": "وَمُراقِباً دَينونَةَ الأَعداءِ"},
    {"n": 17, "sadr": "وَبَعيدَةٌ في قُربِها وَكَأَنَّها", "ajuz": "عِنَبُ الطَّفيلَةِ فَترَةَ الجَوزاءِ"},
    {"n": 18, "sadr": "تَتَمايَلُ الأَوراقُ في خَضرائِها", "ajuz": "كَيَدِ العَروسِ بِلَيلَةِ الحِنّاءِ"},
    {"n": 19, "sadr": "تَتَسابَقُ الأَفلاكُ حَولَ دِيارِنا", "ajuz": "وَنَكونُ شَيئاً جَوهَرَ الأَشياءِ"},
    {"n": 20, "sadr": "تَرمي بُذورَ الفَجرِ في أَرحامِنا", "ajuz": "وَتَغورُ نُطفَةُ قادِمِ الضُّعَفاءِ"},
    {"n": 21, "sadr": "مُهَجٌ تَذودُ حِياضَها بِمَراشِفٍ", "ajuz": "عيدانُها مَوصولَةُ الكَدراءِ"},
    {"n": 22, "sadr": "بادٍ لَهيبُ الأَرضِ في أَنفاسِنا", "ajuz": "فَعَلامَ أَضلُعُنا خِيامُ شِتاءِ"},
    {"n": 23, "sadr": "في كُلِّ خافِقَةٍ عَلَت بِفُؤادِها", "ajuz": "خُفَّ النَّدى بِمَسالِكِ الرَّمضاءِ"},
    {"n": 24, "sadr": "نَطَقَ السَّلامُ سَلامَهُ بِبَلاغَةٍ", "ajuz": "لُسُنُ الحُروبِ تُجيبُ بِالفَأفاءِ"},
    {"n": 25, "sadr": "لَعَقَ الصَّباحُ تُرابَنا أَنَفاً بِأَن", "ajuz": "تَتَفاضَلَ الأَعماقُ بِالشُّهَداءِ"},
    {"n": 26, "sadr": "وَتَعَفَّرَت أَنوارُهُ بِدِمائِهِم", "ajuz": "كَتَعَفُّرِ الإِنسانِ بِالحَصباءِ"},
    {"n": 27, "sadr": "نَثَرَ الزَّمانُ رِمالَهُ لِعِداتِنا", "ajuz": "تَعدو بِها الأَنفاسُ في الرَّملاءِ"},
    {"n": 28, "sadr": "أَثَّت سَنابِلُ مَرجَةٍ أَجواءَها", "ajuz": "بِوَليدِ قَمحٍ أَصفَرِ الوَجناءِ"},
    {"n": 29, "sadr": "عَبَّ الهَواءُ مِنَ الغُيومِ رِداءَها", "ajuz": "وَرَمى الخُيوطَ عَلى ثَرى الصَّمّاءِ"},
    {"n": 30, "sadr": "عَزفُ اليَعاسيبِ الجَميلُ عَلى الرُّبى", "ajuz": "وَمُغازِلاً إِشراقَةَ الأَنواءِ"},
    {"n": 31, "sadr": "وَالسّاحِلُ الشَّرقِيُّ ضَمَّ غَمامَةً", "ajuz": "كانَت يَتيمَةَ غُربَةِ البُعَداءِ"},
    {"n": 32, "sadr": "كُلُّ اِغتِرابٍ هانَ يَوماً لِلفَتى", "ajuz": "إِلّا اِغتِرابُ مَجالِسِ الجُهَلاءِ"},
    {"n": 33, "sadr": "بَوّابَةُ الظَّلماءِ موصَدَةُ الخُطى", "ajuz": "أَقفالُها مَختومَةٌ بِدِماءِ"},
    {"n": 34, "sadr": "تَشدو نُجومُ اللَّيلِ نوراً هازِئاً", "ajuz": "بِهَواجِسٍ في حَبسَةِ الظَّلماءِ"},
    {"n": 35, "sadr": "وَتَفاعَلَ الأَلَمُ القَسيمُ بِكُلِّهِ", "ajuz": "وَتَداوَتِ الأَعضاءُ بِالأَعضاءِ"}
  ]
}
