{
  "id": "taraqatka-zairatun",
  "poet": "marwan-ibn-abi-hafsa",
  "title": "طَرَقَتكَ زائِرَةٌ فَحَيِّ خَيالَها",
  "meter": "kamil",
  "themes": ["madh", "politics"],
  "rawiy": "ل",
  "abyat_in_full": 38,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "طَرَقَتكَ زائِرَةٌ فَحَيِّ خَيالَها",
      "ajuz": "بَيضاءُ تَخلِطُ بِالحَياءِ دَلالَها"
    },
    {
      "n": 2,
      "sadr": "قادَت فُؤادَكَ فَاستَقادَ وَمِثلُها",
      "ajuz": "قادَ القُلوبَ إِلى الصِّبا فَأَمالَها"
    },
    {
      "n": 3,
      "sadr": "وَكَأَنَّما طَرَقَت بِنَفحَةِ رَوضَةٍ",
      "ajuz": "سَحَّت بِها دِيَمُ الرَّبيعِ ظِلالَها"
    },
    {
      "n": 4,
      "sadr": "باتَت تُسائِلُ في المَنامِ مُعَرِّساً",
      "ajuz": "بِالبيدِ أَشعَثَ لا يَمَلُّ سُؤالَها"
    },
    {
      "n": 5,
      "sadr": "في فِتيَةٍ هَجَعوا غِراراً بَعدَما",
      "ajuz": "سَئِموا مُراعَشَةَ السُّرى وَمِطالَها"
    },
    {
      "n": 6,
      "sadr": "فَكَأَنَّ حَشوَ ثِيابِهِم هِندِيَّةٌ",
      "ajuz": "نَحَلَت وَأَغفَلَتِ العُيونُ صِقالَها"
    },
    {
      "n": 7,
      "sadr": "وَضَعوا الخُدودَ لَدى سَواهِمَ جُنَّحٍ",
      "ajuz": "تَشكو كُلومَ صِفاحِها وَكَلالَها"
    },
    {
      "n": 8,
      "sadr": "طَلَبَت أَميرَ المُؤمِنينَ فَواصَلَت",
      "ajuz": "بَعدَ السُّرى بِغُدُوِّها آصالَها"
    },
    {
      "n": 9,
      "sadr": "نَزَعَت إِلَيكَ صَوادِياً فَتَقاذَفَت",
      "ajuz": "تَطوي الفَلاةَ حُزونَها وَرِمالَها"
    },
    {
      "n": 10,
      "sadr": "يَتبَعنَ ناجِيَةً يَهُزُّ مِراحُها",
      "ajuz": "بَعدَ النُّحولِ تَليلَها وَقَذالَها"
    },
    {
      "n": 11,
      "sadr": "هَوجاءَ تَدَّرِعُ الرُّبى وَتَشُقُّها",
      "ajuz": "شَقَّ الشَّموسِ إِذا تُراعُ جِلالَها"
    },
    {
      "n": 12,
      "sadr": "تَنجو إِذا رُفِعَ القَطيعُ كَما نَجَت",
      "ajuz": "خَرجاءُ بادَرَتِ الظَّلامَ رِئالَها"
    },
    {
      "n": 13,
      "sadr": "كَالقَوسِ ساهِمَةً أَتَتكَ وَقَد تُرى",
      "ajuz": "كَالبُرجِ تَملَأُ رَحلَها وَحِبالَها"
    },
    {
      "n": 14,
      "sadr": "أَحيا أَميرُ المُؤمِنينَ مُحَمَّدٌ",
      "ajuz": "سُنَنَ النَّبِيِّ حَرامَها وَحَلالَها"
    },
    {
      "n": 15,
      "sadr": "مَلِكٌ تَفَرَّعَ نَبعُهُ مِن هاشِمٍ",
      "ajuz": "مَدَّ الإِلَهُ عَلى الأَنامِ ظِلالَها"
    },
    {
      "n": 16,
      "sadr": "جَبَلٌ لِأُمَّتِهِ تَلوذُ بِرُكنِهِ",
      "ajuz": "رادى جِبالَ عَدُوِّها فَأَزالَها"
    },
    {
      "n": 17,
      "sadr": "لَم تَغشَها مِمّا تَخافُ عَظيمَةٌ",
      "ajuz": "إِلّا أَجالَ لَها الأُمورَ مَجالَها"
    },
    {
      "n": 18,
      "sadr": "حَتّى يُفَرِّجَها أَغَرُّ مُبارَكٌ",
      "ajuz": "أَلفى أَباهُ مُفَرِّجاً أَمثالَها"
    },
    {
      "n": 19,
      "sadr": "ثَبتٌ عَلى زَلَلِ الحَوادِثِ راكِبٌ",
      "ajuz": "مِن صَرفِهِنَّ لِكُلِّ حالٍ حالَها"
    },
    {
      "n": 20,
      "sadr": "كِلتا يَدَيكَ جَعَلتَ فَضلَ نَوالِها",
      "ajuz": "لِلمُسلِمينَ وَفي العَدُوِّ وَبالَها"
    },
    {
      "n": 21,
      "sadr": "وَقَعَت مَواقِعَها بِعَفوِكَ أَنفُسٌ",
      "ajuz": "أَذهَبتَ بَعدَ مَخافَةٍ أَوجالَها"
    },
    {
      "n": 22,
      "sadr": "آمَنتَ غَيرَ مُعاقِبٍ طُرّادَها",
      "ajuz": "وَفَكَكتَ مِن أُسَرائِها أَغلالَها"
    },
    {
      "n": 23,
      "sadr": "وَنَصَبتَ نَفسَكَ خَيرَ نَفسٍ دونَها",
      "ajuz": "وَجَعَلتَ مالَكَ واقِياً أَموالَها"
    },
    {
      "n": 24,
      "sadr": "هَل تَعلَمونَ خَليفَةً مِن قَبلِهِ",
      "ajuz": "أَجرى لِغايَتِهِ الَّتي أَجرى لَها"
    },
    {
      "n": 25,
      "sadr": "طَلَعَ الدُّروبَ مُشَمِّراً عَن ساقِهِ",
      "ajuz": "بِالخَيلِ مُنصَلِتاً يَجُدُّ نِعالَها"
    },
    {
      "n": 26,
      "sadr": "قوداً تَريعُ إِلى أَغَرَّ لِوَجهِهِ",
      "ajuz": "نورٌ يُضيءُ أَمامَها وَخِلالَها"
    },
    {
      "n": 27,
      "sadr": "قَصُرَت حَمائِلُهُ عَلَيهِ فَقَلَّصَت",
      "ajuz": "وَلَقَد تَحَفَّظَ قَينُها فَأَطالَها"
    },
    {
      "n": 28,
      "sadr": "حَتّى إِذا وَرَدَت أَوائِلُ خَيلِهِ",
      "ajuz": "جَيحانَ بَثَّ عَلى العَدُوِّ رِعالَها"
    },
    {
      "n": 29,
      "sadr": "أَحمى بِلادَ المُسلِمينَ عَلَيهِمُ",
      "ajuz": "وَأَباحَ سَهلَ بِلادِهِم وَجِبالَها"
    },
    {
      "n": 30,
      "sadr": "أَدمَت دَوابِرَ خَيلِهِ وَشَكيمَها",
      "ajuz": "غاراتُهُنَّ وَأَلحَقَت آطالَها"
    },
    {
      "n": 31,
      "sadr": "لَم تُبقِ بَعدَ مَقادِها وَطِرادِها",
      "ajuz": "إِلّا نَحائِزَها وَإِلّا آلَها"
    },
    {
      "n": 32,
      "sadr": "هَل تَطمِسونَ مِنَ السَّماءِ نُجومَها",
      "ajuz": "بِأَكُفِّكُم أَم تَستُرونَ هِلالَها"
    },
    {
      "n": 33,
      "sadr": "أَم تَجحَدونَ مَقالَةً عَن رَبِّكُمُ",
      "ajuz": "جِبريلُ بَلَّغَها النَّبِيَّ فَقالَها"
    },
    {
      "n": 34,
      "sadr": "شَهِدَت مِنَ الأَنفالِ آخِرُ آيَةٍ",
      "ajuz": "بِتُراثِهِم فَأَرَدتُمُ إِبطالَها"
    },
    {
      "n": 35,
      "sadr": "فَذَروا الأُسودَ خَوادِراً في غيلِها",
      "ajuz": "لا تولِغَنَّ دِماءَكُم أَشبالَها"
    },
    {
      "n": 36,
      "sadr": "رَفَعَ الخَليفَةُ ناظِرَيَّ وَراشَني",
      "ajuz": "بِيَدٍ مُبارَكَةٍ شَكَرتُ نَوالَها"
    },
    {
      "n": 37,
      "sadr": "وَحُسِدتُ حَتّى قيلَ أَصبَحَ باغِياً",
      "ajuz": "في المَشيِ مُترَفَ شيمَةِ مُختالِها"
    },
    {
      "n": 38,
      "sadr": "وَلَقَد حَذَوتَ لِمَن أَطاعَ وَمَن عَصى",
      "ajuz": "نَعلاً وَرِثتَ عَنِ النَّبِيِّ مِثالَها"
    }
  ]
}
