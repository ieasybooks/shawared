{
  "id": "al-qasida-al-alawiyya",
  "poet": "husayn-abu-al-faraj",
  "title": "القَصيدَةُ العَلَوِيَّةُ",
  "meter": "basit",
  "rawiy": "ه",
  "abyat_in_full": 252,
  "added": "2026-11-24",
  "abyat": [
    {"n": 1, "sadr": "أَختالُ فَخراً وَأَزهو في الوَرى تيها", "ajuz": "إِذ في عَلِيٍّ أَصوغُ الدُّرَّ تَنويها"},
    {"n": 2, "sadr": "إِلى أَبي الحَسَنَينِ النَّدبِ قَد رَكِبَت", "ajuz": "قَوافِلُ المَدحِ وَالإِجلالُ حاديها"},
    {"n": 3, "sadr": "بَيني وَبَينَكَ بيدٌ رَملُها حِقَبٌ", "ajuz": "وَمِثلُها هَيبَةٌ مَن ذا يُباريها"},
    {"n": 4, "sadr": "وَلَستُ أَجهَلُ ما في السَّيرِ مِن نَصَبٍ", "ajuz": "لَكِنَّ لي نِيَّةً في السَّيرِ أَنويها"},
    {"n": 5, "sadr": "فَلَستَ فينا أَحاديثاً مَضَت وَخَلَت", "ajuz": "بَل أَنتَ أَصدَقُ فيما جَدَّ تَنبيها"},
    {"n": 6, "sadr": "وَأَنتَ أَوعَظُ في حالٍ وَفي أَثَرٍ", "ajuz": "مِنَ المَواعِظِ قَد قامَت دَواعيها"},
    {"n": 7, "sadr": "وَأَنتَ أَفصَحُ في نَظمٍ وَفي خُطَبٍ", "ajuz": "مِمّا تَجيشُ بِهِ الأَقحاحُ مِن فيها"},
    {"n": 8, "sadr": "وَأَنتَ أَشجَعُ وَالفُرسانُ صائِلَةٌ", "ajuz": "لِمَورِدِ المَوتِ تُدنيها مَذاكيها"},
    {"n": 9, "sadr": "وَأَنتَ أَقرَبُ لِلمُختارِ في نَسَبٍ", "ajuz": "وَتَحتَكَ اِبنَتُهُ وُدّاً تُصافيها"},
    {"n": 10, "sadr": "وَفيكَ وَحدَكَ دونَ الصَّحبِ مُمتَحَنٌ", "ajuz": "لِأَنفُسِ النّاسِ غاليها وَقاليها"},
    {"n": 11, "sadr": "أَبا تُرابٍ لَعَمرُ اللَّهِ قَد شَرِبَت", "ajuz": "قُلوبُنا الحُبَّ بِالآثارِ نَرويها"},
    {"n": 12, "sadr": "مَوَدَّةً لِرَسولِ اللَّهِ نَرقُبُها", "ajuz": "في عِترَةِ الطُّهرِ بِالآباءِ نَفديها"},
    {"n": 13, "sadr": "سُبحانَ مَن شَجَّرَ الأَنسابَ فَافتَرَقَت", "ajuz": "الأَصلُ يَجمَعُها وَالفَرعُ يُنئيها"},
    {"n": 14, "sadr": "مِنها فُروعٌ تَسامَت في الوَرى شَرَفاً", "ajuz": "حَتّى اِستَحالَت صُروحاً في مَبانيها"},
    {"n": 15, "sadr": "وَبَعضُها قَد ذَوى ذِكراً وَمَنقَبَةً", "ajuz": "مِنَ الخُمولِ لَعَلَّ اللَّهَ يُحييها"},
    {"n": 16, "sadr": "وَما الحَسابَةُ لِلإِنسانِ موجِبَةٌ", "ajuz": "فَخراً وَلا أَعجَزَت هِمّاتِ بانيها"},
    {"n": 17, "sadr": "فَكَم شَريفٍ هَوى مِن قِمَّةٍ سَمَقَت", "ajuz": "إِلى الحَضيضِ تَرَدّى في مَهاويها"},
    {"n": 18, "sadr": "وَكَم وَضيعٍ رَنَت لِلشُّهبِ هِمَّتُهُ", "ajuz": "تَسَلَّقَ الشُّمَّ كَي يَرقى لِعاليها"},
    {"n": 19, "sadr": "وَيا عَلِيُّ عَلَوتَ النّاسَ في نَسَبٍ", "ajuz": "وَفي المَناقِبِ تَثوي في أَعاليها"},
    {"n": 20, "sadr": "أَبوكَ عَمُّ رَسولِ اللَّهِ قَد شَهِدَت", "ajuz": "بَطحاءُ مَكَّةَ أَيّاماً لَهُ فيها"},
    {"n": 21, "sadr": "حاطَ النَّبِيَّ مِنَ الأَخطارِ يَمنَعُهُ", "ajuz": "بِالجاهِ وَالسَّيفِ وَالأَبياتِ يُلقيها"},
    {"n": 22, "sadr": "وَماتَ لَم يَسأَلِ الرَّحمَنَ مَغفِرَةً", "ajuz": "وَلِلهِدايَةِ أَقدارٌ تُواتيها"},
    {"n": 23, "sadr": "وَجَدُّكَ الضَّخمُ جَدُّ المُصطَفى عَرَفَت", "ajuz": "لَهُ قُرَيشٌ يَداً بَيضاءَ يُسديها"},
    {"n": 24, "sadr": "هَل في قُرَيشٍ إِذا ما عُدَّ سادَتُها", "ajuz": "كَشَيبَةِ الحَمدِ عِندَ الخَطبِ يَكفيها"},
    {"n": 25, "sadr": "أَجَدَّ زَمزَمَ يَسقي النّاسَ كَوثَرَها", "ajuz": "وَما يَزالُ لِيَومِ النّاسِ يَسقيها"},
    {"n": 26, "sadr": "مَشى لِأَبرَهَةٍ في رَدِّ أَينُقِهِ", "ajuz": "وَوَكَّلَ الكَعبَةَ الجَبّارَ يَحميها"},
    {"n": 27, "sadr": "أَبوهُ عَمرو العُلى هَشّامُ أَرغِفَةٍ", "ajuz": "نَحّارُ راغِيَةٍ لِلضَّيفِ يَقريها"},
    {"n": 28, "sadr": "وَسَنَّ لِلقَومِ فيما سَنَّ رِحلَتَها", "ajuz": "إيلافَ صائِفِها طُرّاً وَشاتيها"},
    {"n": 29, "sadr": "وَنَسلُهُ الرَّهطُ آلُ البَيتِ قَد مُنِعوا", "ajuz": "أَكلَ الزَّكاةِ مِنَ الأَموالِ تَنزيها"},
    {"n": 30, "sadr": "أَبوهُ عَبدُ مَنافٍ سَيِّدٌ حَفِظَت", "ajuz": "لَهُ القَبيلَةُ سِفراً في تَباهيها"},
    {"n": 31, "sadr": "المُنجِبُ السّادَةَ الأَفذاذَ مَن عَقَدوا", "ajuz": "أَحلافَ قَومِهِمُ صَوناً وَتَرفيها"},
    {"n": 32, "sadr": "هُمُ العَشيرَةُ في الإِنذارِ إِذ نَزَلَت", "ajuz": "فَقامَ فيها رَسولُ اللَّهِ داعيها"},
    {"n": 33, "sadr": "أَبوهُ زَيدٌ قَدِ اِستَعلَت بِهِ هِمَمٌ", "ajuz": "فَجاءَ لِلبَيتِ يَسعى مِن أَقاصيها"},
    {"n": 34, "sadr": "أَجلى خُزاعَةَ فَاعتَزَّت بِهِ مُضَرٌ", "ajuz": "في سيرَةٍ لا يَمَلُّ الرَّدَّ راويها"},
    {"n": 35, "sadr": "لَهُ اللِّواءُ وَسَدنُ البَيتِ قَد جُمِعا", "ajuz": "إِلى الرِّفادَةِ وَالسُّقيا وَناديها"},
    {"n": 36, "sadr": "وَفي أَبيهِ كِلابٍ يَلتَقي أَبَوا", "ajuz": "نَبِيِّنا مِن عُروقٍ طابَ ناميها"},
    {"n": 37, "sadr": "هُوَ اِبنُ مُرَّةَ مِن كَعبٍ تَحَدُّرُهُ", "ajuz": "وَكَم لِكَعبٍ مِنَ الآثارِ نُحصيها"},
    {"n": 38, "sadr": "قَد سَنَّ لِلعُربِ أَمّا بَعدُ فَاتَّبَعَت", "ajuz": "فَصلَ الخِطابِ عَلى المِنهاجِ تُنشيها"},
    {"n": 39, "sadr": "أَمّا أَبوهُ لُؤَيٌّ فاقَ إِخوَتَهُ", "ajuz": "وَتِلكَ مَوهِبَةٌ وَاللَّهُ مُعطيها"},
    {"n": 40, "sadr": "تَوَسَّمَ الخَيرَ فيهِ غالِبٌ فَأَتى", "ajuz": "سُمَيذَعاً كَجُدودٍ طابَ ماضيها"},
    {"n": 41, "sadr": "وَغالِبٌ بَزَّ أَقراناً فَكانَ لَهُ", "ajuz": "سِيادَةٌ في بَني فِهرٍ تُجَلّيها"},
    {"n": 42, "sadr": "أَبوهُ فِهرٌ نَماهُ مالِكٌ فَسَما", "ajuz": "وَجَدُّهُ النَّضرُ لِلأَساسِ بانيها"},
    {"n": 43, "sadr": "هُوَ القَبيلَةُ إِذ مِن صُلبِهِ اِنحَدَرَت", "ajuz": "قُرَيشُ فَارتَفَعَت شَأناً وَتَنويها"},
    {"n": 44, "sadr": "إِلى كِنانَةَ وَالإِعراقُ مُتَّصِلٌ", "ajuz": "فَذاكَ جُمجُمَةٌ وَالعُربُ تُعليها"},
    {"n": 45, "sadr": "إِلى خُزَيمَةَ مِن أَبناءِ مُدرِكَةٍ", "ajuz": "مِن صُلبِ إِلياسَ في أَعلى عَواليها"},
    {"n": 46, "sadr": "هُمُ الخِيارُ إِذا ما أُطرِيَت مُضَرُ ال", "ajuz": "حَمراءُ يَذكُرُهُم بِالمَجدِ مُطريها"},
    {"n": 47, "sadr": "وَمِن نِزارٍ عَلى الأَزمانِ سيرَتُهُم", "ajuz": "كَالمِسكِ يَنفَحُ طيباً في نَواحيها"},
    {"n": 48, "sadr": "وَفي مَعَدِّ بنِ عَدنانٍ مَآثِرُهُم", "ajuz": "كَالنَّقشِ خالِدَةً مَن ذا يُعَفّيها"},
    {"n": 49, "sadr": "نَسلُ النُّبُوَّةِ إِسماعيلُ مَحتِدُهُم", "ajuz": "فَلا يُقالُ لِمَدّاحٍ لَهُم إيها"},
    {"n": 50, "sadr": "إِنَّ الخَمائِلَ إِن طابَت وَباكَرَها", "ajuz": "الوابِلُ السَّحُّ قُل طابَت مَجانيها"},
    {"n": 51, "sadr": "أَمّا السِّباخُ وَما تُخفيهِ مِن دِمَنٍ", "ajuz": "فَهيَ الوَخيمَةُ إِن قامَت مَراعيها"},
    {"n": 52, "sadr": "وَأَنتَ حَرثُكَ آتى أُكلَهُ وَزَكا", "ajuz": "في كُلِّ حينٍ مِنَ السّاداتِ يُؤتيها"},
    {"n": 53, "sadr": "إِنَّ البَتولَ بِأَمرِ اللَّهِ قَد وَصَلَت", "ajuz": "نَسلَ النَّبِيِّ بِحَبلٍ مِن ذَراريها"},
    {"n": 54, "sadr": "اِبناكُما سَيِّدا الأَشبالِ مُنقَلَباً", "ajuz": "إِنَّ السِّيادَةَ تَهوى مُستَحِقّيها"},
    {"n": 55, "sadr": "وَبِالكِساءِ نَبِيُّ اللَّهِ جَلَّلَكُم", "ajuz": "وَأُمُّنا لِلوَرى بِالحُبِّ تَرويها"},
    {"n": 56, "sadr": "لِلَّهِ دَرُّ شَبيهِ المُصطَفى حَسَنٍ", "ajuz": "وَخُطَّةِ الرُّشدِ لَمّا قامَ يُعطيها"},
    {"n": 57, "sadr": "الزّاخِرُ البَحرُ في عِلمٍ وَفي كَرَمٍ", "ajuz": "وَالشّامِخُ الطَّودُ إِن ثارَت سَوافيها"},
    {"n": 58, "sadr": "مُجَمِّعٌ سَيِّدٌ قَرمٌ حَليفُ نَدىً", "ajuz": "يُهدي الخِلافَةَ كَالأَموالِ يُهديها"},
    {"n": 59, "sadr": "نُبوءَةٌ لِرَسولِ اللَّهِ حَقَّقَها", "ajuz": "في سُنَّةٍ لِرَسولِ اللَّهِ يُحييها"},
    {"n": 60, "sadr": "أَمّا الحُسَينُ فَلَيثُ الغابِ هامَتَهُ", "ajuz": "لِغَيرِ خالِقِهِ ما كانَ يَحنيها"},
    {"n": 61, "sadr": "مُشَبَّهٌ بِأَميرِ المُؤمِنينَ مَضى", "ajuz": "لِذاتِ غايَتِهِ بِالسَّيفِ يُلفيها"},
    {"n": 62, "sadr": "قَد صادَمَ الجَيشَ في آلٍ لَهُ غُرَرٍ", "ajuz": "فَاستَقبَلَ الخَيلَ بِالإِقدامِ يَرميها"},
    {"n": 63, "sadr": "تَناوَشَتهُ رِماحُ الظُّلمِ غاشِمَةً", "ajuz": "وَيلٌ لِآمِرِها طوبى لِناهيها"},
    {"n": 64, "sadr": "هُوَ السَّعيدُ وَأَشقى القَومِ قاتِلُهُ", "ajuz": "وَهوَ الشَّهيدُ إِذا ما خابَ جاثيها"},
    {"n": 65, "sadr": "بِنتاكُما زَينَبٌ وَالدّينُ رائِدُها", "ajuz": "وَأُمُّ كُلثومَ وَالإيمانُ حاديها"},
    {"n": 66, "sadr": "وَما العَقيلَةُ إِلّا عِرضُ والِدِها", "ajuz": "فَلَيسَ يَحظى بِها مَن لا يُكافيها"},
    {"n": 67, "sadr": "فَزَينَبٌ زَوجُ بَحرِ الجودِ فازَ بِها", "ajuz": "وَأُمُّ كُلثومَ لِلفاروقِ حاظيها"},
    {"n": 68, "sadr": "وَبَعدَ فاطِمَةٍ أَصهَرتَ مُتَّخِذاً", "ajuz": "إِلى القَبائِلِ أَزواجاً تُراعيها"},
    {"n": 69, "sadr": "نَجَلتَ ذُرِّيَّةً لِلحَقِّ نُصرَتُهُم", "ajuz": "أَسماؤُهُم تُبطِلُ الدَّعوى وَتَنفيها"},
    {"n": 70, "sadr": "مُحَمَّدٌ وَأَبو بَكرٍ وَجَعفَرُ وَال", "ajuz": "عَبّاسُ ذُرِّيَّةٌ جَلَّت وَمُسميها"},
    {"n": 71, "sadr": "يَحيى وَعُثمانُ ذو الإِقدامِ مَع عُمَرٍ", "ajuz": "فَتِلكَ صاغِيَةٌ طابَت فَواليها"},
    {"n": 72, "sadr": "وَاذكُر عُبَيداً وَعَبدَ اللَّهِ وَابكِهِما", "ajuz": "جَرَت دِماؤُهُما وَالسَّيفُ مُجريها"},
    {"n": 73, "sadr": "بَل جُلُّهُم قَد قَضَوا بِالسَّيفِ نَحبَهُمُ", "ajuz": "كَذَلِكَ الحُرُّ يَصلاها وَيُصليها"},
    {"n": 74, "sadr": "رَبّاكَ أَحمَدُ في أَبياتِهِ فَبَخٍ", "ajuz": "بَخٍ لِتَربِيَةٍ وَحيٌ يُزَكّيها"},
    {"n": 75, "sadr": "وَكُنتَ حِلسَ رَسولِ اللَّهِ مُقتَدِياً", "ajuz": "بِسَمتِهِ في خِصالٍ كُنتَ تُبديها"},
    {"n": 76, "sadr": "شَهِدتَ أَحوالَهُ في كُلِّ مُعتَرَكٍ", "ajuz": "سَرّاءَ تُبهِجُ أَو أُخرى يُعانيها"},
    {"n": 77, "sadr": "لَبَّيتَ دَعوَتَهُ لَمّا دَعاكَ إِلى", "ajuz": "صَلاحِ أَمرِكَ في الدُّنيا وَتاليها"},
    {"n": 78, "sadr": "فَكُنتَ أَقدَمَ إِسلاماً عَلى صِغَرٍ", "ajuz": "مَعَ الثَّلاثَةِ وَالرَّحمَنُ هاديها"},
    {"n": 79, "sadr": "وَكُنتَ أَوَّلَ مَن صَلّى وَقَد فُرِضَت", "ajuz": "مَعَ النَّبِيِّ عَلى خَوفٍ تُؤَدّيها"},
    {"n": 80, "sadr": "وَيَومَ هِجرَتِهِ وَلّاكَ عُهدَتَهُ", "ajuz": "وَبِتَّ في مَرقَدِ المُختارِ تَمويها"},
    {"n": 81, "sadr": "لَحِقتَهُ بِالتِّئامِ الشَّملِ في عَجَلٍ", "ajuz": "مَعَ الفَواطِمِ تَرعاها وَتَحميها"},
    {"n": 82, "sadr": "وَاختارَكَ اللَّهُ زَوجاً لِلبَتولِ فَقُل", "ajuz": "قَد لاقَتِ البَضعَةُ الزَّهرا مُكافيها"},
    {"n": 83, "sadr": "وَكُنتَ جاراً لِأَبياتِ الرَّسولِ وَكَم", "ajuz": "قَبَستَ مِن نورِهِ رُشداً وَتَوجيها"},
    {"n": 84, "sadr": "وَما تَخَلَّفتَ عَن غَزوٍ وَلا خَطَرٍ", "ajuz": "حَمّالَ أَلوِيَةٍ بِالفَتحِ تُعليها"},
    {"n": 85, "sadr": "خَلا تَبوكَ فَفي طابا بَقيتَ بِها", "ajuz": "بِأَمرِ أَحمَدَ فيها كُنتَ واليها"},
    {"n": 86, "sadr": "فَكُنتَ مِنهُ كَما هارونُ في صِلَةٍ", "ajuz": "مِنَ الكَليمِ وَحَسبي ذاكَ تَشبيها"},
    {"n": 87, "sadr": "وَأَنزَلَ اللَّهُ آياتٍ بِها نُبِذَت", "ajuz": "مِنَ العُهودِ إِلى الكُفّارِ ماضيها"},
    {"n": 88, "sadr": "أَخَذتَها عَن رَسولِ اللَّهِ تَحمِلُها", "ajuz": "عَلى مَطِيَّتِهِ العَضباءِ تُزجيها"},
    {"n": 89, "sadr": "حَتّى بَلَغتَ بِجَمعٍ وَسطَ مَحفِلِهِم", "ajuz": "عَلى مَسامِعِهِم كَالصَّخرِ تُلقيها"},
    {"n": 90, "sadr": "بَراءَةٌ وَيَظَلُّ الرَّجعُ مُتَّصِلاً", "ajuz": "وَيُنصِتُ الكَونُ إِذعاناً لِما فيها"},
    {"n": 91, "sadr": "وَفي الغَديرِ كَساكَ المُصطَفى شَرَفاً", "ajuz": "مَع عِترَةٍ أَوجَبَ المَولى تَوَلّيها"},
    {"n": 92, "sadr": "وَيَومَ أَظلَمَتِ الدُّنيا إِذِ اِنطَفَأَت", "ajuz": "أَنوارُ طَيبَةَ مِن مِشكاةِ هاديها"},
    {"n": 93, "sadr": "عَلا النَّشيجُ مِنَ الأَصحابِ في ذَهَلٍ", "ajuz": "مِثلَ الدَّوِيِّ بِهِ ضَجَّت نَواحيها"},
    {"n": 94, "sadr": "باشَرتَ غَسلَ رَسولِ اللَّهِ فَاغتَسَلَت", "ajuz": "يَداكَ وَاللَّهُ بِالفِردَوسِ يَجزيها"},
    {"n": 95, "sadr": "نَزَلتَ في قَبرِهِ لِلَّحدِ تَحمِلُهُ", "ajuz": "مُوَدِّعاً صُحبَةً بِالدَّمعِ تَبكيها"},
    {"n": 96, "sadr": "وَيَومَ بَدرٍ وَأَيمُ اللَّهِ قَد خَرَجَت", "ajuz": "عِصابَةٌ خَيرُ أَهلِ الأَرضِ مَن فيها"},
    {"n": 97, "sadr": "زامَلتَ فيهِ رَسولَ اللَّهِ تَعقُبُهُ", "ajuz": "عَلى البَعيرِ إِلى الغاياتِ يَطويها"},
    {"n": 98, "sadr": "حَمَلتَ رايَتَهُ البَيضاءَ في ثِقَةٍ", "ajuz": "في فِتيَةٍ مِن قُرَيشٍ مَن يُجاريها"},
    {"n": 99, "sadr": "لَولا الوَفاءُ لِعَبدِ الدّارِ ما حَمَلَ ال", "ajuz": "لِواءَ غَيرُكَ إِذ نادى مُناديها"},
    {"n": 100, "sadr": "أَمّا سَخينَةُ بِالأَبطالِ قَد زَحَفَت", "ajuz": "كُفراً وَصَدّاً عَنِ الإِسلامِ تَبغيها"},
    {"n": 101, "sadr": "نادَت نَزالِ فَلَبَّيتَ النِّداءَ كَما", "ajuz": "لَيثٍ بِأَبيَضَ في يُمناكَ تَفريها"},
    {"n": 102, "sadr": "هَذانِ خَصمانِ فيكُم يَومَها نَزَلَت", "ajuz": "يُحيي وَقائِعَها في النّاسِ تاليها"},
    {"n": 103, "sadr": "وَيَومَ أَقبَلَتِ الأَحزابُ في عَدَدٍ", "ajuz": "وَاللَّهُ خاذِلُها وَاللَّهُ مُخزيها"},
    {"n": 104, "sadr": "تَقَحَّمَ الخَندَقَ المَضروبَ مُرتَجِزاً", "ajuz": "عَمرو بنُ وُدٍّ عَلى جَرداءَ يُجريها"},
    {"n": 105, "sadr": "شاكي السِّلاحِ سَرَت في العُربِ هَيبَتُهُ", "ajuz": "ما بَينَ حاضِرِها مِنها وَباديها"},
    {"n": 106, "sadr": "أَقدَمتَ تَردَعُهُ بِالسَّيفِ تَقرَعُهُ", "ajuz": "فَكانَ مَصرَعُهُ في قَعرِ واديها"},
    {"n": 107, "sadr": "وَاذكُر بِخَيبَرَ إِذ طالَت مَعاقِلُها", "ajuz": "عَلى الإِغارَةِ وَاستَعصَت صَياصيها"},
    {"n": 108, "sadr": "ظَنَّت يَهودُ بِأَنَّ الحِصنَ يَمنَعُها", "ajuz": "وَأَنَّ حائِطَها دَهراً سَيَكفيها"},
    {"n": 109, "sadr": "قالَ الرَّسولُ سَأُعطي رايَتي رَجُلاً", "ajuz": "الحُبُّ آيَتُهُ بِالفَتحِ يَأتيها"},
    {"n": 110, "sadr": "نادوا عَلِيّاً فَقالوا يَشتَكي رَمَداً", "ajuz": "مِن أَمسِ في عَينِهِ قَد باتَ يُؤذيها"},
    {"n": 111, "sadr": "أَتى يُهادى وَغَشّى عَينَهُ عَمَشٌ", "ajuz": "فَيَبصُقُ المُصطَفى وَاللَّهُ يَشفيها"},
    {"n": 112, "sadr": "اُنفُذ عَلِيُّ عَلى رِسلٍ فَغايَتُنا", "ajuz": "هِدايَةُ النّاسِ قاصيها وَدانيها"},
    {"n": 113, "sadr": "وَفي حُنَينٍ أَضَرَّ النّاسَ كَثرَتُهُم", "ajuz": "فَجاءَتِ الغارَةُ الشَّعواءُ تَنبيها"},
    {"n": 114, "sadr": "تَضَعضَعَ الجَيشُ وَانتابَ الوَرى فَزَعٌ", "ajuz": "كُلٌّ إِلى وِجهَةٍ ذُعراً يُوَلّيها"},
    {"n": 115, "sadr": "إِلّا الرَّسولَ وَأَصحاباً ذَوي قَدَمٍ", "ajuz": "في السَّبقِ قَد ثَبَتوا في وَجهِ عاتيها"},
    {"n": 116, "sadr": "اِستَبسَلَت ثُلَّةٌ مِن دونِ قائِدِها", "ajuz": "تَفديهِ بِالرّوحِ حُبّاً وَهوَ يَفديها"},
    {"n": 117, "sadr": "فَكُنتَ مِنهُم بِسوقِ المَوتِ مُشتَغِلاً", "ajuz": "تَكيلُ بِالسَّيفِ هاماتٍ تُوَفّيها"},
    {"n": 118, "sadr": "عَرقَبتَ فيهِ ذَلولاً كانَ راكِبُهُ", "ajuz": "يَرمي الصُّفوفَ بِغاراتٍ فَيُفنيها"},
    {"n": 119, "sadr": "فَصُدَّتِ الغارَةُ الشَّعواءُ وَانقَشَعَت", "ajuz": "غَمامَةٌ يَخطِفُ الأَبصارَ ناضيها"},
    {"n": 120, "sadr": "وَأَمكَنَ اللَّهُ مِن نَصرٍ وَمِن جُشَمٍ", "ajuz": "وَمِن ثَقيفٍ إِذِ اُقتيدَت نَواصيها"},
    {"n": 121, "sadr": "وَبَعدَ قاصِمَةِ الظَّهرِ الَّتي كَرَبَت", "ajuz": "أَن تَطمِسَ الدّينَ مِن هَولِ عَواديها"},
    {"n": 122, "sadr": "تَدارَكَ اللَّهُ بِالصِّدّيقِ مِن فِتَنٍ", "ajuz": "يَومَ السَّقيفَةِ فَانجابَت دَياجيها"},
    {"n": 123, "sadr": "في فَلتَةٍ سَبَقَت مِن بَعدِ ما وَجَبَت", "ajuz": "لِبَيعَةٍ كانَتِ الأَنصارُ تَنويها"},
    {"n": 124, "sadr": "بايَعتَ ثانِيَ يَومٍ بَعدَما عُقِدَت", "ajuz": "مَعَ الزُّبَيرِ عَنِ الخُدرِيِّ نَرويها"},
    {"n": 125, "sadr": "وَما نَفِستَ عَلى الصِّدّيقِ مَوهِبَةً", "ajuz": "وَلا اِفتَأَتَّ وَلا قَد كُنتَ تَبغيها"},
    {"n": 126, "sadr": "لَكِن وَجَدتَ لِرَأيٍ في المَشورَةِ إِذ", "ajuz": "قَد كُنتَ تَأخُذُها مِنهُم وَتُعطيها"},
    {"n": 127, "sadr": "وَبَعدَ ما لَحِقَت بِنتُ الرَّسولِ بِهِ", "ajuz": "في جَنَّةِ الخُلدِ لَمّا قامَ ناعيها"},
    {"n": 128, "sadr": "أَعتَبتَ إِذ جاءَكَ الصِّدّيقُ فَانبَجَسَت", "ajuz": "عَينُ المَوَدَّةِ فَيضاً في مَجاريها"},
    {"n": 129, "sadr": "صَحِبتَهُ ناصِحاً فيما يُحاوِلُهُ", "ajuz": "بِالرَّأيِ مِنكَ شُؤونَ الحُكمِ يُمضيها"},
    {"n": 130, "sadr": "وَكُنتَ بَعدُ مَعَ الفاروقِ مُؤتَلِفاً", "ajuz": "وَلِلجَماعَةِ بِالقِسطاسِ قاضيها"},
    {"n": 131, "sadr": "وَظَلتَ تَعرِفُ لِلشَّيخَينِ مَنزِلَةً", "ajuz": "دونَ الرَّسولِ فَلا حَيٌّ يُدانيها"},
    {"n": 132, "sadr": "وَكَم نَهَرتَ عَلى التَّفضيلِ مِن رَجُلٍ", "ajuz": "بِالسَّوطِ تَجلِدُهُ زَجراً وَتَسفيها"},
    {"n": 133, "sadr": "بايَعتَ عُثمانَ ذا النّورَينِ مُرتَضِياً", "ajuz": "مَشورَةً بِالهُدى حُفَّت مَراميها"},
    {"n": 134, "sadr": "فَكُنتَ أَوَّلَ مَن أَعطاهُ بَيعَتَهُ", "ajuz": "وَالسِّبطُ آخِرُ مَن بِالدّارِ يَحميها"},
    {"n": 135, "sadr": "وَأَنتَ رابِعُهُم حُكماً وَمَرتَبَةً", "ajuz": "مَراتِبٌ بِالتُّقى شيدَت مَبانيها"},
    {"n": 136, "sadr": "وَكُلُّكُم مِن رَسولِ اللَّهِ مُتَّخِذٌ", "ajuz": "بَدراً يُضيءُ إِذا ما اِسوَدَّ داجيها"},
    {"n": 137, "sadr": "هُمُ الخَلائِفُ لِلإِسلامِ قَلعَتُهُ", "ajuz": "وَلِلشَّريعَةِ دِرعٌ دونَ راميها"},
    {"n": 138, "sadr": "الرّاشِدونَ فَما يَشقى بِهِم تَبَعٌ", "ajuz": "إِلى النَّجاةِ وَإِن طالَت مَواميها"},
    {"n": 139, "sadr": "الجاعِلونَ نُصوصَ الوَحيِ قائِدَهُم", "ajuz": "وَالعارِفونَ فَما تَخفى مَعانيها"},
    {"n": 140, "sadr": "المُسرِعونَ إِلى الخَيراتِ في سَبَقٍ", "ajuz": "وَالرّاكِبونَ إِذا نادى مُناديها"},
    {"n": 141, "sadr": "المُخصِبونَ وَكَفُّ النّاسِ مُجدِبَةٌ", "ajuz": "وَالمُعرِضونَ عَنِ الدُّنيا وَما فيها"},
    {"n": 142, "sadr": "أَصهارُ أَحمَدَ قَد فازوا بِنُصرَتِهِ", "ajuz": "مُنَزَّهونَ عَنِ الأَهواءِ تَنزيها"},
    {"n": 143, "sadr": "في سَكرَةِ الفَتحِ وَالأَرجاءُ باسِمَةٌ", "ajuz": "وَالدَّهرُ مُغتَبِطُ الأَيّامِ هانيها"},
    {"n": 144, "sadr": "تَكَدَّرَ الصَّفوُ إِذ غاضَت مَنابِعُهُ", "ajuz": "وَصَوَّحَ البَقلُ تَذروهُ ذَواريها"},
    {"n": 145, "sadr": "إِذِ الوُفودُ بِشَهرِ الحَجِّ قَد نَزَلَت", "ajuz": "أَفناءَ مَكَّةَ تَرجو فَضلَ باريها"},
    {"n": 146, "sadr": "ثارَت عَلى الشَّيخِ غَدراً فِتنَةٌ عَمَمٌ", "ajuz": "لا بارَكَ اللَّهُ فيمَن كانَ يُذكيها"},
    {"n": 147, "sadr": "أَعلاجُ ثَغرٍ أَتَوا في عَسكَرٍ لَجِبٍ", "ajuz": "كَما تَدِبُّ إِلى جُحرٍ أَفاعيها"},
    {"n": 148, "sadr": "وَطَوَّقوا الدّارَ لَم يَرعَوا لِصاحِبِها", "ajuz": "سَبقاً وَلا حَفِظوا عَوراتِ مَن فيها"},
    {"n": 149, "sadr": "وَزَوَّروا عَنكَ كُتباً لَستَ صاحِبَها", "ajuz": "بِخَطِّ كاتِبِهِم إِبليسُ يُمليها"},
    {"n": 150, "sadr": "وَما كَتَبتَ وَلَم تَأمُر وَلا اِتَّفَقَت", "ajuz": "دَعواكَ مَع عُصبَةٍ خابَت دَعاويها"},
    {"n": 151, "sadr": "وَيحاً لَهُم قَوَّضوا طَوداً بِساحَتِهِم", "ajuz": "مِن أَن تَميدَ بِهِم قَد كانَ يُرسيها"},
    {"n": 152, "sadr": "فَاذكُر حُذَيفَةَ في بابٍ وَقى فِتَناً", "ajuz": "إِذا تَكَسَّرَ عَمَّت في نَواحيها"},
    {"n": 153, "sadr": "دارَت رَحى الشَّرِّ فَالأَيّامُ واجِمَةٌ", "ajuz": "ثَكلى تَحِنُّ إِلى أَفراحِ ماضيها"},
    {"n": 154, "sadr": "وَأَصبَحَت طَيبَةٌ رَهناً لِشِرذِمَةٍ", "ajuz": "وَسادَةُ القَومِ سادَتها مَواليها"},
    {"n": 155, "sadr": "رَنَت إِلَيكَ عُيونُ النّاسِ في لَهَفٍ", "ajuz": "كَالنَّجمِ في سُدفَةِ الظَّلماءِ تَهديها"},
    {"n": 156, "sadr": "وَبايَعوكَ عَلى أَنقاضِ مَملَكَةٍ", "ajuz": "فَقُمتَ فيهِم عَلى الأَنقاضِ تَبنيها"},
    {"n": 157, "sadr": "رَأَيتَ أَن يَستَتِبَّ الأَمرُ في دَعَةٍ", "ajuz": "حَتّى يُمَكَّنَ في الأَحكامِ قاضيها"},
    {"n": 158, "sadr": "وَأَن تُفَرِّقَ أَوباشاً قَدِ اِجتَمَعَت", "ajuz": "عَنِ المَدينَةِ لِلأَمصارِ تُجليها"},
    {"n": 159, "sadr": "وَأَنتَ في كُلِّ ما حاوَلتَ مُجتَهِدٌ", "ajuz": "وَحِكمَةُ اللَّهِ في الأَقدارِ يُجريها"},
    {"n": 160, "sadr": "وَخالَفَتكَ فِئامٌ تَبتَغي قَوَداً", "ajuz": "مِنَ الجُناةِ وَشيكاً لَيسَ يُرجيها"},
    {"n": 161, "sadr": "فيهِم زُبَيرٌ حَوارِيُّ الرَّسولِ لَهُ", "ajuz": "مِنَ المَآثِرِ في الإِسلامِ غاليها"},
    {"n": 162, "sadr": "وَطَلحَةُ بنُ عُبَيدِ اللَّهِ مَن شُلَّت", "ajuz": "دونَ النُّبُوَّةِ يُمناهُ يُفَدّيها"},
    {"n": 163, "sadr": "وَأُمُّنا دُرَّةُ الهادي وَبَهجَتُهُ", "ajuz": "أَنعِم وَأَكرِم وَقُل تَبّاً لِشانيها"},
    {"n": 164, "sadr": "سارَت مَعَ الجَيشِ في خِدرٍ عَلى جَمَلٍ", "ajuz": "وَسِرتَ أَنتَ مَعَ الأَجنادِ تَثنيها"},
    {"n": 165, "sadr": "دَعواكُمُ يَومَها في الحَقِّ واحِدَةٌ", "ajuz": "أَمّا الخِلافُ فَفي سُبلٍ تُؤَدّيها"},
    {"n": 166, "sadr": "يَومَ اِلتَقَيتُم وَثارَت بَينَكُم رُسُلٌ", "ajuz": "بِالرَّأبِ ذاهِبُها يَسعى وَجائيها"},
    {"n": 167, "sadr": "بِتُّم عَلى خَيرِ حالٍ وَانطَوَت إِحَنٌ", "ajuz": "وَباتَ يُذكي لَهيبَ النّارِ مُذكيها"},
    {"n": 168, "sadr": "لَولا الدَّسائِسُ ما ثارَ الغُبارُ وَما", "ajuz": "سالَت نُفوسٌ وَقَد شيمَت مَواضيها"},
    {"n": 169, "sadr": "وَقَفتَ في ساحَةِ الأَبطالِ تَأمُرُهُم", "ajuz": "وَأُمُّ قَسطَلَ تَسعى في نَواحيها"},
    {"n": 170, "sadr": "توبوا لِرُشدِكُمُ شيموا سُيوفَكُمُ", "ajuz": "كُفّوا أَياديكُم بِالحَزمِ تُلقيها"},
    {"n": 171, "sadr": "وَالحَربُ مِثلُ شَرارِ النّارِ إِن وَرِيَت", "ajuz": "آضَت سَعيراً فَكُلُّ القَومِ صاليها"},
    {"n": 172, "sadr": "أَصمى زُبَيراً وَدَهدى رَأسَهُ لُكَعٌ", "ajuz": "جِنايَةٌ أَوجَبَت وَيلاً لِجانيها"},
    {"n": 173, "sadr": "وَخَرَّ طَلحَةُ عَن قَوسٍ مُوَتَّرَةٍ", "ajuz": "فَيا لَها رَميَةً أَودَت بِراميها"},
    {"n": 174, "sadr": "غَطّى القَتامُ ضِياءَ الشَّمسِ فَانطَفَأَت", "ajuz": "وَأُمُّنا بَينَ راميها وَحاميها"},
    {"n": 175, "sadr": "سَبعونَ نَفساً مِنَ الأَبطالِ قَد زَهَقَت", "ajuz": "دونَ الخِطامِ وَعَينُ الأُمِّ تَبكيها"},
    {"n": 176, "sadr": "لَمّا اِنجَلى النَّقعُ لَم تُجهِز عَلى رَجُلٍ", "ajuz": "بَلِ اِنكَفَأتَ عَلى الجَرحى تُداويها"},
    {"n": 177, "sadr": "وَما أَسَرتَ وَلَم تَغنَم لَهُم سَلَباً", "ajuz": "أَمّا النِّساءُ فَلَم تَأذَن لِسابيها"},
    {"n": 178, "sadr": "وَتِلكَ نَفسٌ لِجامُ الدّينِ يَعصِمُها", "ajuz": "إِذا النُّفوسُ اِطَّباها نَزغُ مُغويها"},
    {"n": 179, "sadr": "وَبِالشَّآمِ اِستَقَلَّت عَنكَ طائِفَةٌ", "ajuz": "فَلَم تُبايِع وَأَمضَت أَمرَ واليها"},
    {"n": 180, "sadr": "نادَت بِثاراتِ عُثمانٍ مُطالِبَةً", "ajuz": "بِأَن تُؤَدّى أَماناتٌ لِأَهليها"},
    {"n": 181, "sadr": "تَعاظَمَت ما جَرى ظُلماً وَقَد خَشِيَت", "ajuz": "مِن أَن تُطَلَّ دِماءٌ ضَلَّ مُجريها"},
    {"n": 182, "sadr": "يَقودُها كاتِبُ الوَحيِ الَّذي شَهِدَت", "ajuz": "لَهُ الأَكابِرُ تَوثيقاً وَتَنويها"},
    {"n": 183, "sadr": "العَبشَمِيُّ الَّذي ما حَلَّ حَبوَتَهُ", "ajuz": "طَيشٌ إِذا ما الحُبى طاشَت بِمَن فيها"},
    {"n": 184, "sadr": "زَحَفتَ بِالجَيشِ في حَزمٍ لِتَأطُرَها", "ajuz": "أَطراً عَلى السَّمعِ تَرجو أَوبَ عاصيها"},
    {"n": 185, "sadr": "عَسكَرتَ وَالجُندُ في صِفّينَ مُرتَقِباً", "ajuz": "إِذِ اِبنُ عَمِّكَ في جُندٍ تُكافيها"},
    {"n": 186, "sadr": "حَتّى إِذا اِنسَلَخَ الشَّهرُ الحَرامُ سَعى", "ajuz": "بَينَ الكَتائِبِ بِالتَّحريضِ ساعيها"},
    {"n": 187, "sadr": "فَلاقَتِ الخَيلُ خَيلاً مِثلَها عَدَداً", "ajuz": "وَلاقَتِ الجُندُ أَجناداً تُباريها"},
    {"n": 188, "sadr": "وَقاتَلَ النّاسُ عَن دينٍ وَمُعتَقَدٍ", "ajuz": "قِتالَ مَن عَرَفَ الجَنّاتِ يَبغيها"},
    {"n": 189, "sadr": "فَلَم يَفِرَّ فَتىً مِن قِرنِهِ هَلَعاً", "ajuz": "وَلا هَوَت رايَةٌ مِن كَفِّ مُعليها"},
    {"n": 190, "sadr": "سالَت دِماءٌ وَدارَت في الرَّحى مُهَجٌ", "ajuz": "إِنَّ الدِّماءَ وَقودُ الحَربِ توريها"},
    {"n": 191, "sadr": "إِذا وَنى فَيلَقٌ فَالقَتلُ يَبعَثُهُ", "ajuz": "وَإِن خَبَت جَبهَةٌ فَالقَتلُ يُذكيها"},
    {"n": 192, "sadr": "حَربٌ سِجالٌ وَأَيّامٌ مُضَرَّجَةٌ", "ajuz": "وَالعُربُ كادَ سَعيرُ الحَربِ يُفنيها"},
    {"n": 193, "sadr": "يُخَضِّبُ الأَرضَ ما تُجري أَسِنَّتُها", "ajuz": "فَتَنضَحُ الأَرضُ إِشفاقاً مَآقيها"},
    {"n": 194, "sadr": "حَتّى إِذا ما هَوى عَمّارُ وَاتَّضَحَت", "ajuz": "حالٌ لِراشِدِها مِن حالِ باغيها"},
    {"n": 195, "sadr": "أَحيا بِمَقتَلِهِ الأَصحابَ فَانبَعَثوا", "ajuz": "وَهَدَّ مَقتَلُهُ الأَخصامَ يُجثيها"},
    {"n": 196, "sadr": "وَلاذَ بِالتَّلِّ جَمعُ الشّامِ وَانكَسَرَت", "ajuz": "عَزائِمٌ كانَ قَصدُ الحَقِّ حاديها"},
    {"n": 197, "sadr": "نادَوا بِتَحكيمِ آيِ اللَّهِ فَارتَفَعَت", "ajuz": "مَصاحِفٌ وَرِماحُ الجُندِ تُعليها"},
    {"n": 198, "sadr": "وَقَفتَ عِندَ كِتابِ اللَّهِ مُرتَضِياً", "ajuz": "حُكمَ المُهَيمِنِ تَعظيماً وَتَأليها"},
    {"n": 199, "sadr": "وَنابَ عَنكَ أَبو موسى مُفاوَضَةً", "ajuz": "مُعَلِّمُ الذِّكرِ إِقراءً وَتَفقيها"},
    {"n": 200, "sadr": "وَنابَ عَمرٌو عَن أَهلِ الشّامِ فَاتَّفَقا", "ajuz": "عَلى المَشورَةِ حِرصاً في تَوَخّيها"},
    {"n": 201, "sadr": "الحُكمُ لِلَّهِ وَالمَخلوقُ مُؤتَمَنٌ", "ajuz": "عَلى الشَّرائِعِ عَن وُسعٍ يُؤَدّيها"},
    {"n": 202, "sadr": "وَأَسعَدُ النّاسِ في الدّارَينِ مَنزِلَةً", "ajuz": "مَن عَبَّدَ النَّفسَ لِلخَلّاقِ باريها"},
    {"n": 203, "sadr": "وَأَغلَظُ النّاسِ مَن غالى وَقَد بُذِلَت", "ajuz": "شَريعَةُ اللَّهِ تَشديداً يُناويها"},
    {"n": 204, "sadr": "وَأَجهَلُ النّاسِ بِالقُرآنِ طائِفَةٌ", "ajuz": "لَم تَبلُغِ الآيُ أَقصى مِن تَراقيها"},
    {"n": 205, "sadr": "وَأَسفَهُ النّاسِ في أَقطارِها حَدَثٌ", "ajuz": "سامى كُهولاً رَسولُ اللَّهِ هاديها"},
    {"n": 206, "sadr": "ما إِن قَفَلتَ مِنَ التَّحكيمِ إِذ نَبَحَت", "ajuz": "كِلابُ جَيشِكَ تَحكي صَوتَ عاويها"},
    {"n": 207, "sadr": "الرّاسِبِيُّ إِمامُ السَّوءِ مَن سَهِرَت", "ajuz": "آناءَ لَيلَتِهِ بِالذِّكرِ يُحييها"},
    {"n": 208, "sadr": "وَكَفَّرَتكَ فَقُل وَاللَّهِ قَد هَزُلَت", "ajuz": "حَتّى بِفِلسٍ فَلَم يُطمَع بِشاريها"},
    {"n": 209, "sadr": "عِصابَةٌ مِن جُفاةِ القَومِ ما فَتِئَت", "ajuz": "تُحَرِّفُ الآيَ عَن جَهلٍ وَتَلويها"},
    {"n": 210, "sadr": "تُنَزِّلُ الآيَ في الكُفّارِ قَد نَزَلَت", "ajuz": "عَلى الصَّحابَةِ فَاعجَب مِن تَماديها"},
    {"n": 211, "sadr": "فَقُمتَ فيها بِنورِ الوَحيِ تُرشِدُها", "ajuz": "وَبِالدَّلائِلِ عَن فَهمٍ تُماريها"},
    {"n": 212, "sadr": "وَقامَ فيها اِبنُ عَبّاسٍ فَأَفحَمَها", "ajuz": "وَعادَ بِالثُّلثِ عَن آراءِ مُغويها"},
    {"n": 213, "sadr": "وَما بَدَأتَ بِهَجرٍ أَو مُناجَزَةٍ", "ajuz": "بَل قُلتَ باغِيَةٌ وَاللَّهُ يَهديها"},
    {"n": 214, "sadr": "وَما مَنَعتَهُمُ فَيئاً وَلا صِلَةً", "ajuz": "وَلا مَنَعتَ بُيوتَ اللَّهِ آتيها"},
    {"n": 215, "sadr": "لَكِنَّهُم سَدَروا في الغَيِّ وَاجتَرَؤوا", "ajuz": "عَلى دِماءٍ يَشي بِالظُّلمِ قانيها"},
    {"n": 216, "sadr": "حَرَّضتَ جَيشَكَ بِالآثارِ تَبعَثُهُم", "ajuz": "عَلى القِتالِ عَنِ المَعصومِ تَرويها"},
    {"n": 217, "sadr": "حَتّى إِذا ما اِلتَقى الجَمعانِ مِن كَثَبٍ", "ajuz": "قامَ الشَّقِيُّ عَلى الأَجلافِ يوصيها"},
    {"n": 218, "sadr": "أَلقوا الرِّماحَ وَسُلّوا السَّيفَ لا تَهِنوا", "ajuz": "فَجَنَّةُ الخُلدِ قَد طابَت لِباغيها"},
    {"n": 219, "sadr": "فَوَحَّشوا بِالقَنا الخَطِّيِّ عَن حُمُقٍ", "ajuz": "إِنَّ الحَماقَةَ أَعيَت مَن يُداويها"},
    {"n": 220, "sadr": "شَجَرتَهُم بِرِماحِ الجُندِ تَحصُدُهُم", "ajuz": "حَصدَ السَّنابِلِ قَد مالَت لِجانيها"},
    {"n": 221, "sadr": "أَخا مُرادٍ لَحاكَ اللَّهُ مِن غُدَرٍ", "ajuz": "لَبِئسَها قُربَةً لِلَّهِ تُهديها"},
    {"n": 222, "sadr": "خَضَّبتَ لِحيَتَهُ مِن هامَةٍ مُلِئَت", "ajuz": "لِلنّاسِ عَدلاً وَلِلقُرّاءِ تَفقيها"},
    {"n": 223, "sadr": "وَما اِجتَرَأتَ وَلَكِن جِئتَ مِن دُبُرٍ", "ajuz": "كَالصِّلِّ تَلدَغُ غَدراً مَن يُقَفّيها"},
    {"n": 224, "sadr": "لِسَبعَ عَشرَةَ مِن شَهرِ الصِّيامِ خَلَت", "ajuz": "أَدمَيتَ أَفئِدَةً في رَأسِ راعيها"},
    {"n": 225, "sadr": "يا ضَربَةً مِن شَقِيٍّ ما أَرادَ بِها", "ajuz": "إِلّا لِيَطمِسَ وَجهَ الدّينِ تَشويها"},
    {"n": 226, "sadr": "وَظَلَّ بَعدُ عَلِيٌّ في تَصَبُّرِهِ", "ajuz": "يَومَينِ وَالرّوحُ تَهفو نَحوَ باريها"},
    {"n": 227, "sadr": "وَفاضَتِ النَّفسُ نَحوَ الخُلدِ طاهِرَةً", "ajuz": "لِتَلحَقَ الرَّكبَ في الفِردَوسِ عاليها"},
    {"n": 228, "sadr": "بِمَوتِهِ ثُمَّ في بِضعِ الشُّهورِ تَلَت", "ajuz": "مِن بَيعَةِ الحَسَنِ المَحمودِ واليها"},
    {"n": 229, "sadr": "تَمَّت خِلافَةُ رُشدٍ وَانطَوَت فِئَةٌ", "ajuz": "عَلى خُطى المُصطَفى نَهجاً مَساعيها"},
    {"n": 230, "sadr": "فَاعرِفهُمُ غُرَراً وَاذكُرهُمُ خَبَراً", "ajuz": "وَاتبَعهُمُ أَثَراً وَاهجُر مُعاديها"},
    {"n": 231, "sadr": "يا تابِعَ السُّنَّةِ البَيضاءِ تَنصُرُها", "ajuz": "بِسيرَةٍ مِنكَ لِلدُّنيا تُجَلّيها"},
    {"n": 232, "sadr": "وَقامِعَ البِدَعِ النَّكراءِ تَدحَضُها", "ajuz": "بِحَربَةِ الحَقِّ تَرميها فَتُصميها"},
    {"n": 233, "sadr": "عَظَّمتَ سُنَّةَ خَيرِ الخَلقِ مُجتَهِداً", "ajuz": "وَكانَ دَأبُكَ في حِرصٍ تَأَسّيها"},
    {"n": 234, "sadr": "قَد قالَ عِمرانُ هَذا المَرءُ ذَكَّرَنا", "ajuz": "صَلاةَ أَحمَدَ إِذ كُنّا نُصَلّيها"},
    {"n": 235, "sadr": "خالَفتَ عُثمانَ ذا النّورَينِ مُعتَرِضاً", "ajuz": "في مُتعَةِ الحَجِّ جَهراً قُمتَ تَنويها"},
    {"n": 236, "sadr": "وَقُلتَ قَولاً لَهُ بَل قَد جَرى مَثَلاً", "ajuz": "لِأُمَّةٍ تَقتَفي مَمشى أَواليها"},
    {"n": 237, "sadr": "لا لَستُ أَترُكُ يا عُثمانُ سُنَّتَهُ", "ajuz": "لِقَولَةِ النّاسِ أَيّاً كانَ مُلقيها"},
    {"n": 238, "sadr": "وَأَنتَ مَن حَرَّقَ الغالينَ إِذ كَفَروا", "ajuz": "فَأَلَّهوكَ مَعَ الرَّحمَنِ تَأليها"},
    {"n": 239, "sadr": "وَما اِدَّعَيتَ لِأَهلِ البَيتِ عِصمَتَهُم", "ajuz": "بَل عَنكَ نَروي صُراحاً ما يُنافيها"},
    {"n": 240, "sadr": "وَأَنتَ مَن قالَ لَم نُخصَص بِمَعرِفَةٍ", "ajuz": "إِلّا فُهوماً إِلَهُ الكَونِ يُعطيها"},
    {"n": 241, "sadr": "وَفي قِرابِكَ لَعنٌ لِلأُلى ذَبَحوا", "ajuz": "لِغَيرِ رَبّي وَحَسبي ذاكَ تَنبيها"},
    {"n": 242, "sadr": "صَحيفَةٌ مُلِئَت نوراً وَمَعرِفَةً", "ajuz": "فيها مِنَ الفِقهِ وَالتَّوحيدِ ما فيها"},
    {"n": 243, "sadr": "وَقَد بَعَثتَ أَبا الهَيّاجِ تَأمُرُهُ", "ajuz": "أَوامِراً كانَ خَيرُ الخَلقِ يُمليها"},
    {"n": 244, "sadr": "فَقامَ بِالأَمرِ في التِّمثالِ يَطمِسُهُ", "ajuz": "وَفي القُبورِ إِذا شيدَت يُسَوّيها"},
    {"n": 245, "sadr": "وَمِنكَ نَعرِفُ لِلشَّيخَينِ مَنزِلَةً", "ajuz": "عَن آلِ بَيتِكَ بِالإِسنادِ نَحميها"},
    {"n": 246, "sadr": "إِلى اِبنِ عَمِّكَ عَنكَ الدَّهرَ نُسنِدُها", "ajuz": "وَلِابنِكَ الحَنَفِيِّ الفَذِّ عازيها"},
    {"n": 247, "sadr": "وَعَنكَ نَقرَأُ آيَ الذِّكرِ مُتَّصِلاً", "ajuz": "أَنعِم بِها أُمَّةً أَكرِم بِمُقريها"},
    {"n": 248, "sadr": "لِيَهنِكَ الفَوزُ في الأُخرى أَبا حَسَنٍ", "ajuz": "وَيَهنِ جَنّاتِ عَدنٍ طيبُ جائيها"},
    {"n": 249, "sadr": "في ثُلَّةٍ أَنجَزَت ما عاهَدَت وَوَفَت", "ajuz": "وَاللَّهُ أَنجَزُ بِالحُسنى سَيَجزيها"},
    {"n": 250, "sadr": "وَيا مُحِبَّ أَميرِ المُؤمِنينَ أَما", "ajuz": "وَقَد عَرَفتَ خِصالَ النَّدبِ فَاحكيها"},
    {"n": 251, "sadr": "فَإِنَّما النَّصبُ في أَعلى مَراتِبِهِ", "ajuz": "في أَن تُخالِفَها ذَمّاً وَتَسفيها"},
    {"n": 252, "sadr": "حَقيقَةٌ مِثلُ ضَوءِ الشَّمسِ مُشرِقَةٌ", "ajuz": "فَليَجحَدِ الشَّمسَ مَهما شاءَ نافيها"}
  ]
}
