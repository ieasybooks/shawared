{
  "id": "uluwwun-fi-al-hayati",
  "poet": "abu-al-hasan-al-anbari",
  "title": "عُلُوٌّ في الحَياةِ وَفي المَماتِ",
  "meter": "wafir",
  "themes": ["ritha", "karam"],
  "rawiy": "ت",
  "abyat_in_full": 21,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "عُلُوٌّ في الحَياةِ وَفي المَماتِ",
      "ajuz": "لَحَقٌّ أَنتَ إِحدى المُعجِزاتِ"
    },
    {
      "n": 2,
      "sadr": "كَأَنَّ النّاسَ حَولَكَ حينَ قاموا",
      "ajuz": "وُفودُ نَداكَ أَيّامَ الصِّلاتِ"
    },
    {
      "n": 3,
      "sadr": "كَأَنَّكَ قائِمٌ فيهِم خَطيباً",
      "ajuz": "وَكُلُّهُمُ قِيامٌ لِلصَّلاةِ"
    },
    {
      "n": 4,
      "sadr": "مَدَدتَ يَدَيكَ نَحوَهُمُ اِحتِفاءً",
      "ajuz": "كَمَدِّهِما إِلَيهِم بِالهِباتِ"
    },
    {
      "n": 5,
      "sadr": "وَلَمّا ضاقَ بَطنُ الأَرضِ عَن أَن",
      "ajuz": "يَضُمَّ عُلاكَ مِن بَعدِ الوَفاةِ"
    },
    {
      "n": 6,
      "sadr": "أَصاروا الجَوَّ قَبرَكَ وَاستَعاضوا",
      "ajuz": "عَنِ الأَكفانِ ثَوبَ السّافِياتِ"
    },
    {
      "n": 7,
      "sadr": "لِعُظمِكَ في النُّفوسِ تَبيتُ تُرعى",
      "ajuz": "بِحُرّاسٍ وَحُفّاظٍ ثِقاتِ"
    },
    {
      "n": 8,
      "sadr": "وَتوقَدُ حَولَكَ النّيرانُ لَيلاً",
      "ajuz": "كَذَلِكَ كُنتَ أَيّامَ الحَياةِ"
    },
    {
      "n": 9,
      "sadr": "رَكِبتَ مَطِيَّةً مِن قَبلُ زَيدٌ",
      "ajuz": "عَلاها في السِّنينَ الماضِياتِ"
    },
    {
      "n": 10,
      "sadr": "وَتِلكَ قَضِيَّةٌ فيها تَأَسٍّ",
      "ajuz": "تُباعِدُ عَنكَ تَعييرَ العُداةِ"
    },
    {
      "n": 11,
      "sadr": "وَلَم أَرَ قَبلَ جِذعِكَ قَطُّ جِذعاً",
      "ajuz": "تَمَكَّنَ مِن عِناقِ المَكرُماتِ"
    },
    {
      "n": 12,
      "sadr": "أَسَأتَ إِلى النَّوائِبِ فَاستَثارَت",
      "ajuz": "فَأَنتَ قَتيلُ ثَأرِ النّائِباتِ"
    },
    {
      "n": 13,
      "sadr": "وَكُنتَ تُجيرُنا مِن صَرفِ دَهرٍ",
      "ajuz": "فَعادَ مُطالِباً لَكَ بِالتِّراتِ"
    },
    {
      "n": 14,
      "sadr": "وَصَيَّرَ دَهرُكَ الإِحسانَ فيهِ",
      "ajuz": "إِلَينا مِن عَظيمِ السَّيِّئاتِ"
    },
    {
      "n": 15,
      "sadr": "وَكُنتَ لِمَعشَرٍ سَعداً فَلَمّا",
      "ajuz": "مَضَيتَ تَفَرَّقوا بِالمُنحِساتِ"
    },
    {
      "n": 16,
      "sadr": "غَليلٌ باطِنٌ لَكَ في فُؤادي",
      "ajuz": "يُخَفَّفُ بِالدُّموعِ الجارِياتِ"
    },
    {
      "n": 17,
      "sadr": "وَلَو أَنّي قَدَرتُ عَلى قِيامٍ",
      "ajuz": "بِفَرضِكَ وَالحُقوقِ الواجِباتِ"
    },
    {
      "n": 18,
      "sadr": "مَلَأتُ الأَرضَ مِن نَظمِ القَوافي",
      "ajuz": "وَنُحتُ بِها خِلافَ النّائِحاتِ"
    },
    {
      "n": 19,
      "sadr": "وَلَكِنّي أُصَبِّرُ عَنكَ نَفسي",
      "ajuz": "مَخافَةَ أَن أُعَدَّ مِنَ الجُناةِ"
    },
    {
      "n": 20,
      "sadr": "وَما لَكَ تُربَةٌ فَأَقولَ تُسقى",
      "ajuz": "لِأَنَّكَ نُصبُ هَطلِ الهاطِلاتِ"
    },
    {
      "n": 21,
      "sadr": "عَلَيكَ تَحِيَّةُ الرَّحمَنِ تَترى",
      "ajuz": "بِرَحماتٍ غَوادٍ رائِحاتِ"
    }
  ]
}
