{
  "id": "al-najatan",
  "poet": "ahmad-shawqi",
  "title": "النَّعجَتانِ",
  "meter": "rajaz",
  "themes": ["fables"],
  "abyat_in_full": 11,
  "added": "2026-11-24",
  "abyat": [
    {"n": 1, "sadr": "كانَ لِبَعضِ النّاسِ نَعجَتانِ", "ajuz": "وَكانَتا في الغَيطِ تَرعَيانِ"},
    {"n": 2, "sadr": "إِحداهُما سَمينَةٌ وَالثّانِيَةُ", "ajuz": "عِظامُها مِنَ الهُزالِ بادِيَةٌ"},
    {"n": 3, "sadr": "فَكانَتِ الأولى تُباهي بِالسِّمَن", "ajuz": "وَقَولِهِم بِأَنَّها ذاتُ ثَمَن"},
    {"n": 4, "sadr": "وَتَدَّعي أَنَّ لَها مِقدارا", "ajuz": "وَأَنَّها تَستَوقِفُ الأَبصارا"},
    {"n": 5, "sadr": "فَتَصبِرُ الأُختُ عَلى الإِذلالِ", "ajuz": "حامِلَةً مَرارَةَ الإِدلالِ"},
    {"n": 6, "sadr": "حَتّى أَتى الجَزّارُ ذاتَ يَومِ", "ajuz": "وَقَلَّبَ النَّعجَةَ دونَ القَومِ"},
    {"n": 7, "sadr": "فَقالَ لِلمالِكِ أَشتَريها", "ajuz": "وَنَقَدَ الكيسَ النَّفيسَ فيها"},
    {"n": 8, "sadr": "فَانطَلَقَت مِن فَورِها لِأُختِها", "ajuz": "وَهيَ تَشُكُّ في صَلاحِ بَختِها"},
    {"n": 9, "sadr": "تَقولُ يا أُختاهُ خَبِّريني", "ajuz": "هَل تَعرِفينَ حامِلَ السِّكّينِ"},
    {"n": 10, "sadr": "قالَت دَعيني وَهُزالي وَالزَّمَن", "ajuz": "وَكَلِّمي الجَزّارَ يا ذاتَ الثَّمَن"},
    {"n": 11, "sadr": "لِكُلِّ حالٍ حُلوُها وَمُرُّها", "ajuz": "ما أَدَبُ النَّعجَةِ إِلّا صَبرُها"}
  ]
}
