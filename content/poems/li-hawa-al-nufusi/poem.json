{
  "id": "li-hawa-al-nufusi",
  "poet": "al-mutanabbi",
  "title": "لِهَوى النُّفوسِ سَريرَةٌ لا تُعلَمُ",
  "meter": "kamil",
  "rawiy": "م",
  "abyat_in_full": 36,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1,  "sadr": "لِهَوى النُّفوسِ سَريرَةٌ لا تُعلَمُ", "ajuz": "عَرَضاً نَظَرتُ وَخِلتُ أَنّي أَسلَمُ" },
    { "n": 2,  "sadr": "يا أُختَ مُعتَنِقِ الفَوارِسِ في الوَغى", "ajuz": "لَأَخوكِ ثَمَّ أَرَقُّ مِنكِ وَأَرحَمُ" },
    { "n": 3,  "sadr": "راعَتكِ رائِعَةُ البَياضِ بِمَفرِقي", "ajuz": "وَلَوَ اَنَّها الأُولى لَراعَ الأَسحَمُ" },
    { "n": 4,  "sadr": "لَو كانَ يُمكِنُني سَفَرتُ عَنِ الصِّبا", "ajuz": "فَالشَّيبُ مِن قَبلِ الأَوانِ تَلَثُّمُ" },
    { "n": 5,  "sadr": "وَلَقَد رَأَيتُ الحادِثاتِ فَلا أَرى", "ajuz": "يَقَقاً يُميتُ وَلا سَواداً يَعصِمُ" },
    { "n": 6,  "sadr": "وَالهَمُّ يَختَرِمُ الجَسيمَ نَحافَةً", "ajuz": "وَيُشيبُ ناصِيَةَ الصَّبِيِّ وَيُهرِمُ" },
    { "n": 7,  "sadr": "ذو العَقلِ يَشقى في النَّعيمِ بِعَقلِهِ", "ajuz": "وَأَخو الجَهالَةِ في الشَّقاوَةِ يَنعَمُ" },
    { "n": 8,  "sadr": "وَالنّاسُ قَد نَبَذوا الحِفاظَ فَمُطلَقٌ", "ajuz": "يَنسى الَّذي يولى وَعافٍ يَندَمُ" },
    { "n": 9,  "sadr": "لا يَخدَعَنَّكَ مِن عَدُوٍّ دَمعُهُ", "ajuz": "وَارحَم شَبابَكَ مِن عَدُوٍّ تَرحَمُ" },
    { "n": 10, "sadr": "لا يَسلَمُ الشَّرَفُ الرَّفيعُ مِنَ الأَذى", "ajuz": "حَتّى يُراقَ عَلى جَوانِبِهِ الدَّمُ" },
    { "n": 11, "sadr": "يُؤذي القَليلُ مِنَ اللِّئامِ بِطَبعِهِ", "ajuz": "مَن لا يَقِلُّ كَما يَقِلُّ وَيَلؤُمُ" },
    { "n": 12, "sadr": "وَالظُّلمُ مِن شِيَمِ النُّفوسِ فَإِن تَجِد", "ajuz": "ذا عِفَّةٍ فَلِعِلَّةٍ لا يَظلِمُ" },
    { "n": 13, "sadr": "وَمِنَ البَلِيَّةِ عَذلُ مَن لا يَرعَوي", "ajuz": "عَن جَهلِهِ وَخِطابُ مَن لا يَفهَمُ" },
    { "n": 14, "sadr": "وَجُفونُهُ ما تَستَقِرُّ كَأَنَّها", "ajuz": "مَطروقَةٌ أَو فُتَّ فيها حِصرِمُ" },
    { "n": 15, "sadr": "وَإِذا أَشارَ مُحَدِّثاً فَكَأَنَّهُ", "ajuz": "قِردٌ يُقَهقِهُ أَو عَجوزٌ تَلطِمُ" },
    { "n": 16, "sadr": "وَتَراهُ أَصغَرَ ما تَراهُ ناطِقاً", "ajuz": "وَيَكونُ أَكذَبَ ما يَكونُ وَيُقسِمُ" },
    { "n": 17, "sadr": "وَالذُّلُّ يُظهِرُ في الذَّليلِ مَوَدَّةً", "ajuz": "وَأَوَدُّ مِنهُ لِمَن يَوَدُّ الأَرقَمُ" },
    { "n": 18, "sadr": "وَمِنَ العَداوَةِ ما يَنالُكَ نَفعُهُ", "ajuz": "وَمِنَ الصَّداقَةِ ما يَضُرُّ وَيُؤلِمُ" },
    { "n": 19, "sadr": "أَرسَلتَ تَسأَلُني المَديحَ سَفاهَةً", "ajuz": "صَفراءُ أَضيَقُ مِنكَ ماذا أَزعُمُ" },
    { "n": 20, "sadr": "فَلَشَدَّ ما جاوَزتَ قَدرَكَ صاعِداً", "ajuz": "وَلَشَدَّ ما قَرُبَت عَلَيكَ الأَنجُمُ" },
    { "n": 21, "sadr": "وَأَرَدتَ ما لِأَبي العَشائِرِ خالِصاً", "ajuz": "إِنَّ الثَّناءَ لِمَن يُزارُ فَيُنعِمُ" },
    { "n": 22, "sadr": "وَلِمَن أَقَمتَ عَلى الهَوانِ بِبابِهِ", "ajuz": "تَدنو فَيوجَأُ أَخدَعاكَ وَتُنهَمُ" },
    { "n": 23, "sadr": "وَلِمَن يُهينُ المالَ وَهوَ مُكَرَّمٌ", "ajuz": "وَلِمَن يَجُرُّ الجَيشَ وَهوَ عَرَمرَمُ" },
    { "n": 24, "sadr": "وَلِمَن إِذا اِلتَقَتِ الكُماةُ بِمَأزِقٍ", "ajuz": "فَنَصيبُهُ مِنها الكَمِيُّ المُعلِمُ" },
    { "n": 25, "sadr": "وَلَرُبَّما أَطَرَ القَناةَ بِفارِسٍ", "ajuz": "وَثَنى فَقَوَّمَها بِآخَرَ مِنهُمُ" },
    { "n": 26, "sadr": "وَالوَجهُ أَزهَرُ وَالفُؤادُ مُشَيَّعٌ", "ajuz": "وَالرُّمحُ أَسمَرُ وَالحُسامُ مُصَمِّمُ" },
    { "n": 27, "sadr": "أَفعالُ مَن تَلِدُ الكِرامُ كَريمَةٌ", "ajuz": "وَفَعالُ مَن تَلِدُ الأَعاجِمُ أَعجَمُ" }
  ]
}
