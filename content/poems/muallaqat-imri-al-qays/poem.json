{
  "id": "muallaqat-imri-al-qays",
  "poet": "imru-al-qays",
  "title": "مُعَلَّقَةُ اِمرِئِ القَيسِ",
  "meter": "tawil",
  "themes": ["wasf", "ghazal"],
  "rawiy": "ل",
  "abyat_in_full": 82,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1,  "sadr": "قِفا نَبكِ مِن ذِكرى حَبيبٍ وَمَنزِلِ", "ajuz": "بِسَقطِ اللِّوى بَينَ الدَّخولِ فَحَومَلِ" },
    { "n": 2,  "sadr": "فَتوضِحَ فَالمِقراةِ لَم يَعفُ رَسمُها", "ajuz": "لِما نَسَجَتها مِن جَنوبٍ وَشَمأَلِ" },
    { "n": 3,  "sadr": "تَرى بَعَرَ الأَرآمِ في عَرَصاتِها", "ajuz": "وَقيعانِها كَأَنَّهُ حَبُّ فُلفُلِ" },
    { "n": 4,  "sadr": "كَأَنّي غَداةَ البَينِ يَومَ تَحَمَّلوا", "ajuz": "لَدى سَمُراتِ الحَيِّ ناقِفُ حَنظَلِ" },
    { "n": 5,  "sadr": "وُقوفاً بِها صَحبي عَلَيَّ مَطِيَّهُم", "ajuz": "يَقولونَ لا تَهلِك أَسىً وَتَجَمَّلِ" },
    { "n": 6,  "sadr": "وَإِنَّ شِفائي عَبرَةٌ مُهَراقَةٌ", "ajuz": "فَهَل عِندَ رَسمٍ دارِسٍ مِن مُعَوَّلِ" },
    { "n": 7,  "sadr": "كَدَأبِكَ مِن أُمِّ الحُوَيرِثِ قَبلَها", "ajuz": "وَجارَتِها أُمِّ الرَّبابِ بِمَأسَلِ" },
    { "n": 8,  "sadr": "إِذا قامَتا تَضَوَّعَ المِسكُ مِنهُما", "ajuz": "نَسيمَ الصَّبا جاءَت بِرَيّا القَرَنفُلِ" },
    { "n": 9,  "sadr": "فَفاضَت دُموعُ العَينِ مِنّي صَبابَةً", "ajuz": "عَلى النَّحرِ حَتّى بَلَّ دَمعِيَ مِحمَلي" },
    { "n": 10, "sadr": "أَلا رُبَّ يَومٍ لَكَ مِنهُنَّ صالِحٍ", "ajuz": "وَلا سِيَّما يَومٌ بِدارَةِ جُلجُلِ" },
    { "n": 11, "sadr": "وَيَومَ عَقَرتُ لِلعَذارى مَطِيَّتي", "ajuz": "فَيا عَجَبا مِن كورِها المُتَحَمَّلِ" },
    { "n": 12, "sadr": "فَظَلَّ العَذارى يَرتَمينَ بِلَحمِها", "ajuz": "وَشَحمٍ كَهُدّابِ الدِّمَقسِ المُفَتَّلِ" },
    { "n": 13, "sadr": "وَيَومَ دَخَلتُ الخِدرَ خِدرَ عُنَيزَةٍ", "ajuz": "فَقالَت لَكَ الوَيلاتُ إِنَّكَ مُرجِلي" },
    { "n": 14, "sadr": "تَقولُ وَقَد مالَ الغَبيطُ بِنا مَعاً", "ajuz": "عَقَرتَ بَعيري يا اِمرَأَ القَيسِ فَانزِلِ" },
    { "n": 15, "sadr": "فَقُلتُ لَها سيري وَأَرخي زِمامَهُ", "ajuz": "وَلا تُبعِديني مِن جَناكِ المُعَلَّلِ" },
    { "n": 16, "sadr": "فَمِثلِكِ حُبلى قَد طَرَقتُ وَمُرضِعٍ", "ajuz": "فَأَلهَيتُها عَن ذي تَمائِمَ مُحوِلِ" },
    { "n": 17, "sadr": "إِذا ما بَكى مِن خَلفِها اِنصَرَفَت لَهُ", "ajuz": "بِشِقٍّ وَتَحتي شِقُّها لَم يُحَوَّلِ" },
    { "n": 18, "sadr": "وَيَوماً عَلى ظَهرِ الكَثيبِ تَعَذَّرَت", "ajuz": "عَلَيَّ وَآلَت حَلفَةً لَم تَحَلَّلِ" },
    { "n": 19, "sadr": "أَفاطِمَ مَهلاً بَعضَ هَذا التَّدَلُّلِ", "ajuz": "وَإِن كُنتِ قَد أَزمَعتِ صَرمي فَأَجمِلي" },
    { "n": 20, "sadr": "أَغَرَّكِ مِنّي أَنَّ حُبَّكِ قاتِلي", "ajuz": "وَأَنَّكِ مَهما تَأمُري القَلبَ يَفعَلِ" },
    { "n": 21, "sadr": "وَإِن تَكُ قَد ساءَتكِ مِنّي خَليقَةٌ", "ajuz": "فَسُلّي ثِيابي مِن ثِيابِكِ تَنسُلِ" },
    { "n": 22, "sadr": "وَما ذَرَفَت عَيناكِ إِلّا لِتَضرِبي", "ajuz": "بِسَهمَيكِ في أَعشارِ قَلبٍ مُقَتَّلِ" },
    { "n": 23, "sadr": "وَبَيضَةِ خِدرٍ لا يُرامُ خِباؤُها", "ajuz": "تَمَتَّعتُ مِن لَهوٍ بِها غَيرَ مُعجَلِ" },
    { "n": 24, "sadr": "تَجاوَزتُ أَحراساً إِلَيها وَمَعشَراً", "ajuz": "عَلَيَّ حِراصاً لَو يُسِرّونَ مَقتَلي" },
    { "n": 25, "sadr": "إِذا ما الثُّرَيّا في السَّماءِ تَعَرَّضَت", "ajuz": "تَعَرُّضَ أَثناءِ الوِشاحِ المُفَصَّلِ" },
    { "n": 26, "sadr": "فَجِئتُ وَقَد نَضَت لِنَومٍ ثِيابَها", "ajuz": "لَدى السِّترِ إِلّا لِبسَةَ المُتَفَضِّلِ" },
    { "n": 27, "sadr": "فَقالَت يَمينَ اللَّهِ ما لَكَ حيلَةٌ", "ajuz": "وَما إِن أَرى عَنكَ الغَوايَةَ تَنجَلي" },
    { "n": 28, "sadr": "خَرَجتُ بِها تَمشي تَجُرُّ وَراءَنا", "ajuz": "عَلى أَثَرَينا ذَيلَ مِرطٍ مُرَحَّلِ" },
    { "n": 29, "sadr": "فَلَمّا أَجَزنا ساحَةَ الحَيِّ وَانتَحى", "ajuz": "بِنا بَطنُ خَبتٍ ذي حِقافٍ عَقَنقَلِ" },
    { "n": 30, "sadr": "هَصَرتُ بِفَودَي رَأسِها فَتَمايَلَت", "ajuz": "عَلَيَّ هَضيمَ الكَشحِ رَيّا المُخَلخَلِ" },
    { "n": 31, "sadr": "مُهَفهَفَةٌ بَيضاءُ غَيرُ مُفاضَةٍ", "ajuz": "تَرائِبُها مَصقولَةٌ كَالسَّجَنجَلِ" },
    { "n": 32, "sadr": "كَبِكرِ المُقاناةِ البَياضِ بِصُفرَةٍ", "ajuz": "غَذاها نَميرُ الماءِ غَيرُ المُحَلَّلِ" },
    { "n": 33, "sadr": "تَصُدُّ وَتُبدي عَن أَسيلٍ وَتَتَّقي", "ajuz": "بِناظِرَةٍ مِن وَحشِ وَجرَةَ مُطفِلِ" },
    { "n": 34, "sadr": "وَجيدٍ كَجيدِ الرِّئمِ لَيسَ بِفاحِشٍ", "ajuz": "إِذا هِيَ نَصَّتهُ وَلا بِمُعَطَّلِ" },
    { "n": 35, "sadr": "وَفَرعٍ يَزينُ المَتنَ أَسوَدَ فاحِمٍ", "ajuz": "أَثيثٍ كَقِنوِ النَّخلَةِ المُتَعَثكِلِ" },
    { "n": 36, "sadr": "غَدائِرُهُ مُستَشزِراتٌ إِلى العُلا", "ajuz": "تَضِلُّ العِقاصُ في مُثَنّىً وَمُرسَلِ" },
    { "n": 37, "sadr": "وَكَشحٍ لَطيفٍ كَالجَديلِ مُخَصَّرٍ", "ajuz": "وَساقٍ كَأُنبوبِ السَّقِيِّ المُذَلَّلِ" },
    { "n": 38, "sadr": "وَتُضحي فَتيتُ المِسكِ فَوقَ فِراشِها", "ajuz": "نَؤومُ الضُّحى لَم تَنتَطِق عَن تَفَضُّلِ" },
    { "n": 39, "sadr": "وَتَعطو بِرَخصٍ غَيرِ شَثنٍ كَأَنَّهُ", "ajuz": "أَساريعُ ظَبيٍ أَو مَساويكُ إِسحِلِ" },
    { "n": 40, "sadr": "تُضيءُ الظَّلامَ بِالعِشاءِ كَأَنَّها", "ajuz": "مَنارَةُ مُمسى راهِبٍ مُتَبَتِّلِ" },
    { "n": 41, "sadr": "إِلى مِثلِها يَرنو الحَليمُ صَبابَةً", "ajuz": "إِذا ما اِسبَكَرَّت بَينَ دِرعٍ وَمِجوَلِ" },
    { "n": 42, "sadr": "تَسَلَّت عَماياتُ الرِّجالِ عَنِ الصِّبا", "ajuz": "وَلَيسَ فُؤادي عَن هَواكِ بِمُنسَلِ" },
    { "n": 43, "sadr": "أَلا رُبَّ خَصمٍ فيكِ أَلوى رَدَدتُهُ", "ajuz": "نَصيحٍ عَلى تَعذالِهِ غَيرِ مُؤتَلِ" },
    { "n": 44, "sadr": "وَلَيلٍ كَمَوجِ البَحرِ أَرخى سُدولَهُ", "ajuz": "عَلَيَّ بِأَنواعِ الهُمومِ لِيَبتَلي" },
    { "n": 45, "sadr": "فَقُلتُ لَهُ لَمّا تَمَطّى بِصُلبِهِ", "ajuz": "وَأَردَفَ أَعجازاً وَناءَ بِكَلكَلِ" },
    { "n": 46, "sadr": "أَلا أَيُّها اللَّيلُ الطَّويلُ أَلا اِنجَلي", "ajuz": "بِصُبحٍ وَما الإِصباحُ مِنكَ بِأَمثَلِ" },
    { "n": 47, "sadr": "فَيا لَكَ مِن لَيلٍ كَأَنَّ نُجومَهُ", "ajuz": "بِكُلِّ مُغارِ الفَتلِ شُدَّت بِيَذبُلِ" },
    { "n": 48, "sadr": "كَأَنَّ الثُّرَيّا عُلِّقَت في مَصامِها", "ajuz": "بِأَمراسِ كَتّانٍ إِلى صُمِّ جَندَلِ" },
    { "n": 49, "sadr": "وَقِربَةِ أَقوامٍ جَعَلتُ عِصامَها", "ajuz": "عَلى كاهِلٍ مِنّي ذَلولٍ مُرَحَّلِ" },
    { "n": 50, "sadr": "وَوادٍ كَجَوفِ العَيرِ قَفرٍ قَطَعتُهُ", "ajuz": "بِهِ الذِّئبُ يَعوي كَالخَليعِ المُعَيَّلِ" },
    { "n": 51, "sadr": "فَقُلتُ لَهُ لَمّا عَوى إِنَّ شَأنَنا", "ajuz": "قَليلُ الغِنى إِن كُنتَ لَمّا تَمَوَّلِ" },
    { "n": 52, "sadr": "كِلانا إِذا ما نالَ شَيئاً أَفاتَهُ", "ajuz": "وَمَن يَحتَرِث حَرثي وَحَرثَكَ يَهزِلِ" },
    { "n": 53, "sadr": "وَقَد أَغتَدي وَالطَّيرُ في وُكُناتِها", "ajuz": "بِمُنجَرِدٍ قَيدِ الأَوابِدِ هَيكَلِ" },
    { "n": 54, "sadr": "مِكَرٍّ مِفَرٍّ مُقبِلٍ مُدبِرٍ مَعاً", "ajuz": "كَجُلمودِ صَخرٍ حَطَّهُ السَّيلُ مِن عَلِ" },
    { "n": 55, "sadr": "كُمَيتٍ يَزِلُّ اللِّبدُ عَن حالِ مَتنِهِ", "ajuz": "كَما زَلَّتِ الصَّفواءُ بِالمُتَنَزِّلِ" },
    { "n": 56, "sadr": "عَلى الذَّبلِ جَيّاشٍ كَأَنَّ اِهتِزامَهُ", "ajuz": "إِذا جاشَ فيهِ حَميُهُ غَليُ مِرجَلِ" },
    { "n": 57, "sadr": "مِسَحٍّ إِذا ما السّابِحاتُ عَلى الوَنى", "ajuz": "أَثَرنَ الغُبارَ بِالكَديدِ المُرَكَّلِ" },
    { "n": 58, "sadr": "يَزِلُّ الغُلامُ الخِفُّ عَن صَهَواتِهِ", "ajuz": "وَيُلوي بِأَثوابِ العَنيفِ المُثَقَّلِ" },
    { "n": 59, "sadr": "دَريرٍ كَخُذروفِ الوَليدِ أَمَرَّهُ", "ajuz": "تَتابُعُ كَفَّيهِ بِخَيطٍ مُوَصَّلِ" },
    { "n": 60, "sadr": "لَهُ أَيطَلا ظَبيٍ وَساقا نَعامَةٍ", "ajuz": "وَإِرخاءُ سِرحانٍ وَتَقريبُ تَتفُلِ" },
    { "n": 61, "sadr": "ضَليعٍ إِذا اِستَدبَرتَهُ سَدَّ فَرجَهُ", "ajuz": "بِضافٍ فُوَيقَ الأَرضِ لَيسَ بِأَعزَلِ" },
    { "n": 62, "sadr": "كَأَنَّ عَلى المَتنَينِ مِنهُ إِذا اِنتَحى", "ajuz": "مَداكَ عَروسٍ أَو صَلايَةَ حَنظَلِ" },
    { "n": 63, "sadr": "كَأَنَّ دِماءَ الهادِياتِ بِنَحرِهِ", "ajuz": "عُصارَةُ حِنّاءٍ بِشَيبٍ مُرَجَّلِ" },
    { "n": 64, "sadr": "فَعَنَّ لَنا سِربٌ كَأَنَّ نِعاجَهُ", "ajuz": "عَذارى دَوارٍ في مُلاءٍ مُذَيَّلِ" },
    { "n": 65, "sadr": "فَأَدبَرنَ كَالجَزعِ المُفَصَّلِ بَينَهُ", "ajuz": "بِجيدٍ مُعَمٍّ في العَشيرَةِ مُخوَلِ" },
    { "n": 66, "sadr": "فَأَلحَقَنا بِالهادِياتِ وَدونَهُ", "ajuz": "جَواحِرُها في صَرَّةٍ لَم تَزَيَّلِ" },
    { "n": 67, "sadr": "فَعادى عِداءً بَينَ ثَورٍ وَنَعجَةٍ", "ajuz": "دِراكاً وَلَم يَنضَح بِماءٍ فَيُغسَلِ" },
    { "n": 68, "sadr": "فَظَلَّ طُهاةُ اللَّحمِ مِن بَينِ مُنضِجٍ", "ajuz": "صَفيفَ شِواءٍ أَو قَديرٍ مُعَجَّلِ" },
    { "n": 69, "sadr": "وَرُحنا يَكادُ الطَّرفُ يَقصُرُ دونَهُ", "ajuz": "مَتى ما تَرَقَّ العَينُ فيهِ تَسَفَّلِ" },
    { "n": 70, "sadr": "فَباتَ عَلَيهِ سَرجُهُ وَلِجامُهُ", "ajuz": "وَباتَ بِعَيني قائِماً غَيرَ مُرسَلِ" },
    { "n": 71, "sadr": "أَصاحِ تَرى بَرقاً أُريكَ وَميضَهُ", "ajuz": "كَلَمعِ اليَدَينِ في حَبِيٍّ مُكَلَّلِ" },
    { "n": 72, "sadr": "يُضيءُ سَناهُ أَو مَصابيحُ راهِبٍ", "ajuz": "أَمالَ السَّليطَ بِالذُّبالِ المُفَتَّلِ" },
    { "n": 73, "sadr": "قَعَدتُ لَهُ وَصُحبَتي بَينَ ضارِجٍ", "ajuz": "وَبَينَ العُذَيبِ بُعدَ ما مُتَأَمَّلي" },
    { "n": 74, "sadr": "عَلى قَطَنٍ بِالشَّيمِ أَيمَنُ صَوبِهِ", "ajuz": "وَأَيسَرُهُ عَلى السِّتارِ فَيَذبُلِ" },
    { "n": 75, "sadr": "فَأَضحى يَسُحُّ الماءَ حَولَ كُتَيفَةٍ", "ajuz": "يَكُبُّ عَلى الأَذقانِ دَوحَ الكَنَهبَلِ" },
    { "n": 76, "sadr": "وَمَرَّ عَلى القَنانِ مِن نَفَيانِهِ", "ajuz": "فَأَنزَلَ مِنهُ العُصمَ مِن كُلِّ مَنزِلِ" },
    { "n": 77, "sadr": "وَتَيماءَ لَم يَترُك بِها جِذعَ نَخلَةٍ", "ajuz": "وَلا أُطُماً إِلّا مَشيداً بِجَندَلِ" },
    { "n": 78, "sadr": "كَأَنَّ ثَبيراً في عَرانينِ وَبلِهِ", "ajuz": "كَبيرُ أُناسٍ في بِجادٍ مُزَمَّلِ" },
    { "n": 79, "sadr": "كَأَنَّ ذُرى رَأسِ المُجَيمِرِ غُدوَةً", "ajuz": "مِنَ السَّيلِ وَالغُثّاءِ فَلكَةُ مِغزَلِ" },
    { "n": 80, "sadr": "وَأَلقى بِصَحراءِ الغَبيطِ بَعاعَهُ", "ajuz": "نُزولَ اليَماني ذي العِيابِ المُحَمَّلِ" },
    { "n": 81, "sadr": "كَأَنَّ مَكاكِيَّ الجِواءِ غُدَيَّةً", "ajuz": "صُبِحنَ سُلافاً مِن رَحيقٍ مُفَلفَلِ" },
    { "n": 82, "sadr": "كَأَنَّ السِّباعَ فيهِ غَرقى عَشِيَّةً", "ajuz": "بِأَرجائِهِ القُصوى أَنابيشُ عُنصُلِ" }
  ]
}
