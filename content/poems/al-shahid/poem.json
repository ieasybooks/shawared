{
  "id": "al-shahid",
  "poet": "abd-al-rahim-mahmud",
  "title": "الشَّهيدُ",
  "meter": "mutaqarib",
  "themes": ["watani", "hamasa"],
  "rawiy": "ا",
  "abyat_in_full": 19,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1,  "sadr": "سَأَحمِلُ روحي عَلى راحَتي", "ajuz": "وَأُلقي بِها في مَهاوي الرَّدى" },
    { "n": 2,  "sadr": "فَإِمّا حَياةٌ تَسُرُّ الصَّديقَ", "ajuz": "وَإِمّا مَماتٌ يُغيظُ العِدى" },
    { "n": 3,  "sadr": "وَنَفسُ الشَّريفِ لَها غايَتانِ", "ajuz": "وُرودُ المَنايا وَنَيلُ المُنى" },
    { "n": 4,  "sadr": "وَما العَيشُ لا عِشتُ إِن لَم أَكُن", "ajuz": "مَخوفَ الجَنابِ حَرامَ الحِمى" },
    { "n": 5,  "sadr": "إِذا قُلتُ أَصغى لِيَ العالَمونَ", "ajuz": "وَدَوّى مَقالِيَ بَينَ الوَرى" },
    { "n": 6,  "sadr": "لَعَمرُكَ إِنّي أَرى مَصرَعي", "ajuz": "وَلَكِن أَغُذُّ إِلَيهِ الخُطى" },
    { "n": 7,  "sadr": "أَرى مَصرَعي دونَ حَقّي السَّليبِ", "ajuz": "وَدونَ بِلادي هُوَ المُبتَغى" },
    { "n": 8,  "sadr": "يَلَذُّ لِأُذني سَماعُ الصَّليلِ", "ajuz": "وَيُبهِجُ نَفسي مَسيلُ الدِّما" },
    { "n": 9,  "sadr": "وَجِسمٌ تَجَدَّلَ في الصَّحصَحانِ", "ajuz": "تُناوِشُهُ جارِحاتُ الفَلا" },
    { "n": 10, "sadr": "فَمِنهُ نَصيبٌ لِأُسدِ السَّماءِ", "ajuz": "وَمِنهُ نَصيبٌ لِأُسدِ الشَّرى" },
    { "n": 11, "sadr": "كَسا دَمُهُ الأَرضَ بِالأُرجُوانِ", "ajuz": "وَأَثقَلَ بِالعِطرِ ريحَ الصَّبا" },
    { "n": 12, "sadr": "وَعَفَّرَ مِنهُ بَهِيَّ الجَبينِ", "ajuz": "وَلَكِن عُفاراً يَزيدُ البَها" },
    { "n": 13, "sadr": "وَبانَ عَلى شَفَتَيهِ اِبتِسامٌ", "ajuz": "مَعانيهِ هُزءٌ بِهَذي الدُّنى" },
    { "n": 14, "sadr": "وَنامَ لِيَحلُمَ حُلمَ الخُلودِ", "ajuz": "وَيَهنَأَ فيهِ بِأَحلى الرُّؤى" },
    { "n": 15, "sadr": "لَعَمرُكَ هَذا مَماتُ الرِّجالِ", "ajuz": "وَمَن رامَ مَوتاً شَريفاً فَذا" },
    { "n": 16, "sadr": "فَكَيفَ اِصطِباري لِكَيدِ الحَقودِ", "ajuz": "وَكَيفَ اِحتِمالي لِسَومِ الأَذى" },
    { "n": 17, "sadr": "أَخَوفاً وَعِندي تَهونُ الحَياةُ", "ajuz": "وَذُلّاً وَإِنّي لَرَبُّ الإِبا" },
    { "n": 18, "sadr": "بِقَلبي سَأَرمي وُجوهَ العُداةِ", "ajuz": "فَقَلبي حَديدٌ وَناري لَظى" },
    { "n": 19, "sadr": "وَأَحمي حِياضي بِحَدِّ الحُسامِ", "ajuz": "فَيَعلَمُ قَومِيَ أَنّي الفَتى" }
  ]
}
