{
  "id": "kadhabatka-aynuka",
  "poet": "al-akhtal",
  "title": "كَذَبَتكَ عَينُكَ أَم رَأَيتَ بِواسِطٍ",
  "meter": "kamil",
  "themes": ["fakhr", "hija"],
  "rawiy": "ل",
  "abyat_in_full": 47,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "كَذَبَتكَ عَينُكَ أَم رَأَيتَ بِواسِطٍ",
      "ajuz": "غَلَسَ الظَّلامِ مِنَ الرَّبابِ خَيالا"
    },
    {
      "n": 2,
      "sadr": "وَتَعَرَّضَت لَكَ بِالأَبالِخِ بَعدَما",
      "ajuz": "قَطَعَت بِأَبرَقَ خُلَّةً وَوِصالا"
    },
    {
      "n": 3,
      "sadr": "وَتَغَوَّلَت لِتَروعَنا جِنِّيَّةٌ",
      "ajuz": "وَالغانِياتُ يُرينَكَ الأَهوالا"
    },
    {
      "n": 4,
      "sadr": "يَمدُدنَ مِن هَفَواتِهِنَّ إِلى الصِّبا",
      "ajuz": "سَبَباً يَصِدنَ بِهِ الغُواةَ طُوالا"
    },
    {
      "n": 5,
      "sadr": "ما إِن رَأَيتُ كَمَكرِهِنَّ إِذا جَرى",
      "ajuz": "فينا وَلا كَحِبالِهِنَّ حِبالا"
    },
    {
      "n": 6,
      "sadr": "المُهدِياتِ لِمَن هَوينَ مَسَبَّةً",
      "ajuz": "وَالمُحسِناتِ لِمَن قَلَينَ مَقالا"
    },
    {
      "n": 7,
      "sadr": "يَرعَينَ عَهدَكَ ما رَأَينَكَ شاهِداً",
      "ajuz": "وَإِذا مَذِلتَ يَصِرنَ عَنكَ مِذالا"
    },
    {
      "n": 8,
      "sadr": "وَإِذا وَعَدنَكَ نائِلاً أَخلَفنَهُ",
      "ajuz": "وَوَجَدتَ عِندَ عِداتِهِنَّ مِطالا"
    },
    {
      "n": 9,
      "sadr": "وَإِذا دَعَونَكَ عَمَّهُنَّ فَإِنَّهُ",
      "ajuz": "نَسَبٌ يَزيدُكَ عِندَهُنَّ خَبالا"
    },
    {
      "n": 10,
      "sadr": "وَإِذا وَزَنتَ حُلومَهُنَّ إِلى الصِّبا",
      "ajuz": "رَجَحَ الصِّبا بِحُلومِهِنَّ فَمالا"
    },
    {
      "n": 11,
      "sadr": "أَهِيَ الصَّريمَةُ مِنكِ أُمَّ مُخَلَّدٍ",
      "ajuz": "أَم ذا الدَّلالُ فَطالَ ذاكَ دَلالا"
    },
    {
      "n": 12,
      "sadr": "وَلَقَد عَلِمتِ إِذا العِشارُ تَرَوَّحَت",
      "ajuz": "هَدَجَ الرِّئالِ تَكُبُّهُنَّ شَمالا"
    },
    {
      "n": 13,
      "sadr": "تَرمي العِضاهَ بِحاصِبٍ مِن ثَلجِها",
      "ajuz": "حَتّى يَبيتَ عَلى العِضاهِ جُفالا"
    },
    {
      "n": 14,
      "sadr": "أَنّا نُعَجِّلُ بِالعَبيطِ لِضَيفِنا",
      "ajuz": "قَبلَ العِيالِ وَنَقتُلُ الأَبطالا"
    },
    {
      "n": 15,
      "sadr": "أَبَني كُلَيبٍ إِنَّ عَمَّيَّ اللَّذا",
      "ajuz": "قَتَلا المُلوكَ وَفَكَّكا الأَغلالا"
    },
    {
      "n": 16,
      "sadr": "وَأَخوهُما السَّفّاحُ ظَمَّأَ خَيلَهُ",
      "ajuz": "حَتّى وَرَدنَ جِبى الكُلابِ نِهالا"
    },
    {
      "n": 17,
      "sadr": "يَخرُجنَ مِن ثَغرِ الكُلابِ عَلَيهِمِ",
      "ajuz": "خَبَبَ السِّباعِ تُبادِرُ الأَوشالا"
    },
    {
      "n": 18,
      "sadr": "مِن كُلِّ مُجتَنِبٍ شَديدٍ أَسرُهُ",
      "ajuz": "سَلِسِ القِيادِ تَخالُهُ مُختالا"
    },
    {
      "n": 19,
      "sadr": "وَمُمَرَّةٍ أَثَرُ السِّلاحِ بِنَحرِها",
      "ajuz": "فَكَأَنَّ فَوقَ لَبانِها جِريالا"
    },
    {
      "n": 20,
      "sadr": "قُبَّ البُطونِ قَدِ اِنطَوَينَ مِنَ السُّرى",
      "ajuz": "وَطِرادِهِنَّ إِذا لَقينَ قِتالا"
    },
    {
      "n": 21,
      "sadr": "مُلحَ المُتونِ كَأَنَّما أَلبَستَها",
      "ajuz": "بِالماءِ إِذ يَبِسَ النَّضيحُ جِلالا"
    },
    {
      "n": 22,
      "sadr": "وَلَقَلَّما يُصبِحنَ إِلّا شُزَّباً",
      "ajuz": "يَركَبنَ مِن عُرَضِ الحَوادِثِ حالا"
    },
    {
      "n": 23,
      "sadr": "فَطَحَنَّ حائِرَةَ المُلوكِ بِكَلكَلٍ",
      "ajuz": "حَتّى اِحتَذَينَ مِنَ الدِّماءِ نِعالا"
    },
    {
      "n": 24,
      "sadr": "وَأَبَرنَ قَومَكَ يا جَريرُ وَغَيرَهُم",
      "ajuz": "وَأَبَرنَ مِن حِلَقِ الرِّبابِ حِلالا"
    },
    {
      "n": 25,
      "sadr": "وَلَقَد دَخَلنَ عَلى شَقيقٍ بَيتَهُ",
      "ajuz": "وَلَقَد رَأَينَ بِساقِ نَضرَةَ خالا"
    },
    {
      "n": 26,
      "sadr": "وَبَنو غُدانَةَ شاخِصٌ أَبصارُهُم",
      "ajuz": "يَسعَونَ تَحتَ بُطونِهِنَّ رِجالا"
    },
    {
      "n": 27,
      "sadr": "يَنقُلنَهُم نَقلَ الكِلابِ جِراءَها",
      "ajuz": "حَتّى وَرَدنَ عُراعِراً وَأُثالا"
    },
    {
      "n": 28,
      "sadr": "خُزرَ العُيونِ إِلى رِياحٍ بَعدَما",
      "ajuz": "جَعَلَت لِضَبَّةَ بِالرِّماحِ ظِلالا"
    },
    {
      "n": 29,
      "sadr": "ما إِن تَرَكنَ مِنَ الغَواضِرِ مُعصِراً",
      "ajuz": "إِلّا فَصَمنَ بِساقِها خَلخالا"
    },
    {
      "n": 30,
      "sadr": "وَلَقَد سَما لَكُمُ الهُذَيلُ فَنالَكُم",
      "ajuz": "بِإِرابَ حَيثُ يُقَسِّمُ الأَنفالا"
    },
    {
      "n": 31,
      "sadr": "في فَيلَقٍ يَدعو الأَراقِمَ لَم تَكُن",
      "ajuz": "فُرسانُهُ عُزلاً وَلا أَكفالا"
    },
    {
      "n": 32,
      "sadr": "بِالخَيلِ ساهِمَةَ الوُجوهِ كَأَنَّما",
      "ajuz": "خالَطنَ مِن عَمَلِ الوَجيفِ سُلالا"
    },
    {
      "n": 33,
      "sadr": "وَلَقَد عَطَفنَ عَلى فَزارَةَ عَطفَةً",
      "ajuz": "كَرَّ المَنيحِ وَجُلنَ ثُمَّ مَجالا"
    },
    {
      "n": 34,
      "sadr": "فَسَقَينَ مَن عادَينَ كَأساً مُرَّةً",
      "ajuz": "وَأَزَلنَ جَدَّ بَني الحُبابِ فَزالا"
    },
    {
      "n": 35,
      "sadr": "يَغشَينَ جيفَةَ كاهِلٍ عَرَّينَها",
      "ajuz": "وَابنَ المُهَزَّمِ قَد تَرَكنَ مُذالا"
    },
    {
      "n": 36,
      "sadr": "فَقَتَلنَ مَن حَمَلَ السِّلاحَ وَغَيرَهُم",
      "ajuz": "وَتَرَكنَ فَلَّهُمُ عَلَيكَ عِيالا"
    },
    {
      "n": 37,
      "sadr": "وَلَقَد بَكى الجَحّافُ مِمّا أَوقَعَت",
      "ajuz": "بِالشَّرعَبِيَّةِ إِذ رَأى الأَطفالا"
    },
    {
      "n": 38,
      "sadr": "وَلَقَد جَشِمتَ جَريرُ أَمراً عاجِزاً",
      "ajuz": "وَأَرَيتَ عَورَةَ أُمِّكَ الجُهّالا"
    },
    {
      "n": 39,
      "sadr": "وَإِذا سَما لِلمَجدِ فَرعا وائِلٍ",
      "ajuz": "وَاستَجمَعَ الوادي عَلَيكَ فَسالا"
    },
    {
      "n": 40,
      "sadr": "كُنتَ القَذى في مَوجِ أَكدَرَ مُزبِدٍ",
      "ajuz": "قَذَفَ الأَتِيُّ بِهِ فَضَلَّ ضَلالا"
    },
    {
      "n": 41,
      "sadr": "وَلَقَد وَطِئنَ عَلى المَشاعِرِ مِن مِنىً",
      "ajuz": "حَتّى قَذَفنَ عَلى الجِبالِ جِبالا"
    },
    {
      "n": 42,
      "sadr": "فَانعِق بِضَأنِكَ يا جَريرُ فَإِنَّما",
      "ajuz": "مَنَّتكَ نَفسُكَ في الخَلاءِ ضَلالا"
    },
    {
      "n": 43,
      "sadr": "مَنَّتكَ نَفسُكَ أَن تُسامِيَ دارِماً",
      "ajuz": "أَو أَن تُوازِنَ حاجِباً وَعِقالا"
    },
    {
      "n": 44,
      "sadr": "وَإِذا وَضَعتَ أَباكَ في ميزانِهِم",
      "ajuz": "قَفَزَت حَديدَتُهُ إِلَيكَ فَشالا"
    },
    {
      "n": 45,
      "sadr": "إِنَّ العَرارَةَ وَالنُّبوحَ لِدارِمٍ",
      "ajuz": "وَالمُستَخِفُّ أَخوهُمُ الأَثقالا"
    },
    {
      "n": 46,
      "sadr": "المانِعينَ الماءَ حَتّى يَشرَبوا",
      "ajuz": "عِفَواتِهِ وَيُقَسِّموهُ سِجالا"
    },
    {
      "n": 47,
      "sadr": "وَابنُ المَراغَةِ حابِسٌ أَعيارَهُ",
      "ajuz": "قَذفَ الغَريبَةِ ما يَذُقنَ بِلالا"
    }
  ]
}
