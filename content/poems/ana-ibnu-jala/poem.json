{
  "id": "ana-ibnu-jala",
  "poet": "suhaym-ibn-wathil",
  "title": "أَنا اِبنُ جَلا وَطَلّاعُ الثَّنايا",
  "meter": "wafir",
  "rawiy": "ن",
  "abyat_in_full": 11,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَنا اِبنُ جَلا وَطَلّاعُ الثَّنايا",
      "ajuz": "مَتى أَضَعِ العِمامَةَ تَعرِفوني"
    },
    {
      "n": 2,
      "sadr": "وَإِنَّ مَكانَنا مِن حِميَرِيٍّ",
      "ajuz": "مَكانُ اللَّيثِ مِن وَسَطِ العَرينِ"
    },
    {
      "n": 3,
      "sadr": "وَإِنّي لا يَعودُ إِلَيَّ قِرني",
      "ajuz": "غَداةَ الغِبِّ إِلّا في قَرينِ"
    },
    {
      "n": 4,
      "sadr": "بِذي لِبَدٍ يَصُدُّ الرَّكبُ عَنهُ",
      "ajuz": "وَلا تُؤتى فَريسَتُهُ لِحينِ"
    },
    {
      "n": 5,
      "sadr": "عَذَرتُ البُزلَ إِذ هِيَ خاطَرَتني",
      "ajuz": "فَما بالي وَبالُ اِبنَي لَبونِ"
    },
    {
      "n": 6,
      "sadr": "وَماذا يَدَّري الشُّعَراءُ مِنّي",
      "ajuz": "وَقَد جاوَزتُ رَأسَ الأَربَعينِ"
    },
    {
      "n": 7,
      "sadr": "أَخو خَمسينَ مُجتَمِعاً أَشُدّي",
      "ajuz": "وَنَجَّذَني مُداوَرَةُ الشُّؤونِ"
    },
    {
      "n": 8,
      "sadr": "فَإِنَّ عُلالَتي وَجِراءَ حَولي",
      "ajuz": "لَذو شِقٍّ عَلى الضَّرَعِ الظَّنونِ"
    },
    {
      "n": 9,
      "sadr": "سَأَحيا ما حَييتُ وَإِنَّ ظَهري",
      "ajuz": "لَمُستَنِدٌ إِلى نَضَدٍ أَمينِ"
    },
    {
      "n": 10,
      "sadr": "كَريمُ الخالِ مِن سَلَفَي رِياحٍ",
      "ajuz": "كَنَصلِ السَّيفِ وَضّاحُ الجَبينِ"
    },
    {
      "n": 11,
      "sadr": "فَإِنَّ قَناتَنا مَشِظٌ شَظاها",
      "ajuz": "شَديدٌ مَدُّها عُنُقَ القَرينِ"
    }
  ]
}
