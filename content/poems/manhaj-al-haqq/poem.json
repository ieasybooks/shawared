{
  "id": "manhaj-al-haqq",
  "poet": "abd-al-rahman-al-sadi",
  "title": "مَنهَجُ الحَقِّ",
  "meter": "tawil",
  "rawiy": "د",
  "abyat_in_full": 65,
  "added": "2026-11-19",
  "abyat": [
    {"n": 1, "sadr": "فَيا سائِلاً عَن مَنهَجِ الحَقِّ يَبتَغي", "ajuz": "سُلوكَ طَريقِ القَومِ حَقّاً وَيَسعَدُ"},
    {"n": 2, "sadr": "تَأَمَّل هَداكَ اللَّهُ ما قَد نَظَمتُهُ", "ajuz": "تَأَمُّلَ مَن قَد كانَ لِلحَقِّ يَقصِدُ"},
    {"n": 3, "sadr": "نُقِرُّ بِأَنَّ اللَّهَ لا رَبَّ غَيرُهُ", "ajuz": "إِلَهٌ عَلى العَرشِ العَظيمِ مُمَجَّدُ"},
    {"n": 4, "sadr": "وَنَشهَدُ أَنَّ اللَّهَ مَعبودُنا الَّذي", "ajuz": "نُخَصِّصُهُ بِالحُبِّ ذُلّاً وَنُفرِدُ"},
    {"n": 5, "sadr": "فَلِلَّهِ كُلُّ الحَمدِ وَالمَجدِ وَالثَّنا", "ajuz": "فَمِن أَجلِ ذا كُلٌّ إِلى اللَّهِ يَقصُدُ"},
    {"n": 6, "sadr": "تُسَبِّحُهُ الأَملاكُ وَالأَرضُ وَالسَّما", "ajuz": "وَكُلُّ جَميعِ الخَلقِ حَقّاً وَتَحمَدُ"},
    {"n": 7, "sadr": "تَنَزَّهَ عَن نِدٍّ وَكُفءٍ مُماثِلٍ", "ajuz": "وَعَن وَصفِ ذي النُّقصانِ جَلَّ المُوَحَّدُ"},
    {"n": 8, "sadr": "وَنُثبِتُ أَخبارَ الصِّفاتِ جَميعَها", "ajuz": "وَنَبرَأُ مِن تَأويلِ مَن كانَ يَجحَدُ"},
    {"n": 9, "sadr": "فَلَيسَ يُطيقُ العَقلُ كُنهَ صِفاتِهِ", "ajuz": "فَسَلِّم لِما قالَ الرَّسولُ مُحَمَّدُ"},
    {"n": 10, "sadr": "هُوَ الصَّمَدُ العالي لِعِظمِ صِفاتِهِ", "ajuz": "وَكُلُّ جَميعِ الخَلقِ لِلَّهِ يَصمُدُ"},
    {"n": 11, "sadr": "عَلِيٌّ عَلا ذاتاً وَقَدراً وَقَهرُهُ", "ajuz": "قَريبٌ مُجيبٌ بِالوَرى مُتَوَدِّدُ"},
    {"n": 12, "sadr": "هُوَ الحَيُّ وَالقَيّومُ ذو الجودِ وَالغِنى", "ajuz": "وَكُلُّ صِفاتِ الحَمدِ لِلَّهِ تُسنَدُ"},
    {"n": 13, "sadr": "أَحاطَ بِكُلِّ الخَلقِ عِلماً وَقُدرَةً", "ajuz": "وَبِرّاً وَإِحساناً فَإِيّاهُ نَعبُدُ"},
    {"n": 14, "sadr": "وَيُبصِرُ ذَرّاتِ العَوالِمِ كُلَّها", "ajuz": "وَيَسمَعُ أَصواتَ العِبادِ وَيَشهَدُ"},
    {"n": 15, "sadr": "لَهُ المُلكُ وَالحَمدُ المُحيطُ بِمُلكِهِ", "ajuz": "وَحِكمَتُهُ العُظمى بِها الخَلقُ تَشهَدُ"},
    {"n": 16, "sadr": "وَنَشهَدُ أَنَّ اللَّهَ يَنزِلُ في الدُّجى", "ajuz": "كَما قالَهُ المَبعوثُ بِالحَقِّ أَحمَدُ"},
    {"n": 17, "sadr": "وَنَشهَدُ أَنَّ اللَّهَ أَرسَلَ رُسلَهُ", "ajuz": "بِآياتِهِ لِلخَلقِ تَهدي وَتُرشِدُ"},
    {"n": 18, "sadr": "وَفاضَلَ بَينَ الرُّسلِ وَالخَلقِ كُلِّهِم", "ajuz": "بِحِكمَتِهِ جَلَّ العَظيمُ المُوَحَّدُ"},
    {"n": 19, "sadr": "فَأَفضَلُ خَلقِ اللَّهِ في الأَرضِ وَالسَّما", "ajuz": "نَبِيُّ الهُدى وَالعالَمينَ مُحَمَّدُ"},
    {"n": 20, "sadr": "وَخَصَّ لَهُ الرَّحمَنُ أَصحابَهُ الأُلى", "ajuz": "أَقاموا الهُدى وَالدّينَ حَقّاً وَمَهَّدوا"},
    {"n": 21, "sadr": "فَحُبُّ جَميعِ الآلِ وَالصَّحبِ عِندَنا", "ajuz": "مَعاشِرَ أَهلِ الحَقِّ فَرضٌ مُؤَكَّدُ"},
    {"n": 22, "sadr": "وَمِن قَولِ أَهلِ الحَقِّ أَنَّ كَلامَهُ", "ajuz": "هُوَ اللَّفظُ وَالمَعنى جَميعاً مُجَوَّدُ"},
    {"n": 23, "sadr": "وَلَيسَ بِمَخلوقٍ وَأَنّى لِخَلقِهِ", "ajuz": "بِقَولٍ كَقَولِ اللَّهِ إِذ هُوَ أَمجَدُ"},
    {"n": 24, "sadr": "وَنَشهَدُ أَنَّ الخَيرَ وَالشَّرَّ كُلَّهُ", "ajuz": "بِتَقديرِهِ وَالعَبدُ يَسعى وَيَجهَدُ"},
    {"n": 25, "sadr": "وَإيمانُنا قَولٌ وَفِعلٌ وَنِيَّةٌ", "ajuz": "مِنَ الخَيرِ وَالطّاعاتِ فيها نُقَيِّدُ"},
    {"n": 26, "sadr": "وَيَزدادُ بِالطّاعاتِ مَع تَركِ ما نَهى", "ajuz": "وَيَنقُصُ بِالعِصيانِ جَزماً وَيَفسُدُ"},
    {"n": 27, "sadr": "نُقِرُّ بِأَحوالِ القِيامَةِ كُلِّها", "ajuz": "وَما اِشتَمَلَتهُ الدّارُ حَقّاً وَنَشهَدُ"},
    {"n": 28, "sadr": "تَفَكَّر بِآثارِ العَظيمِ وَما حَوَت", "ajuz": "مَمالِكُهُ العُظمى لَعَلَّكَ تَرشُدُ"},
    {"n": 29, "sadr": "أَلَم تَرَ هَذا اللَّيلَ إِذ جاءَ مُظلِماً", "ajuz": "فَأَعقَبَهُ جَيشٌ مِنَ الصُّبحِ يَطرُدُ"},
    {"n": 30, "sadr": "تَأَمَّل بِأَرجاءِ السَّماءِ جَميعِها", "ajuz": "كَواكِبُها وَقّادَةٌ تَتَرَدَّدُ"},
    {"n": 31, "sadr": "أَلَيسَ لِهَذا مُحدِثٌ مُتَصَرِّفٌ", "ajuz": "حَكيمٌ عَليمٌ واحِدٌ مُتَفَرِّدُ"},
    {"n": 32, "sadr": "بَلى وَالَّذي بِالحَقِّ أَتقَنَ صُنعَها", "ajuz": "وَأَودَعَها الأَسرارَ لِلَّهِ تَشهَدُ"},
    {"n": 33, "sadr": "وَفي الأَرضِ آياتٌ لِمَن كانَ موقِناً", "ajuz": "وَما تَنفَعُ الآياتُ مَن كانَ يَجحَدُ"},
    {"n": 34, "sadr": "وَفي النَّفسِ آياتٌ وَفيها عَجائِبٌ", "ajuz": "بِها يُعرَفُ اللَّهُ العَظيمُ وَيُعبَدُ"},
    {"n": 35, "sadr": "لَقَد قامَتِ الآياتُ تَشهَدُ أَنَّهُ", "ajuz": "إِلَهٌ عَظيمٌ فَضلُهُ لَيسَ يَنفَدُ"},
    {"n": 36, "sadr": "فَمَن كانَ مِن غَرسِ الإِلَهِ أَجابَهُ", "ajuz": "وَلَيسَ لِمَن وَلّى وَأَدبَرَ مُسعِدُ"},
    {"n": 37, "sadr": "عَلَيكَ بِتَقوى اللَّهِ في فِعلِ أَمرِهِ", "ajuz": "وَتَجتَنِبُ المَنهِيَّ عَنهُ وَتُبعِدُ"},
    {"n": 38, "sadr": "وَكُن مُخلِصاً لِلَّهِ وَاحذَر مِنَ الرِّيا", "ajuz": "وَتابِع رَسولَ اللَّهِ إِن كُنتَ تَعبُدُ"},
    {"n": 39, "sadr": "تَوَكَّل عَلى الرَّحمَنِ حَقّاً وَثِق بِهِ", "ajuz": "لِيَكفيكَ ما يُغنيكَ حَقّاً وَتَرشُدُ"},
    {"n": 40, "sadr": "تَصَبَّر عَنِ العِصيانِ وَاصبِر لِحُكمِهِ", "ajuz": "وَصابِر عَلى الطّاعاتِ عَلَّكَ تَسعَدُ"},
    {"n": 41, "sadr": "وَكُن سائِراً بَينَ المَخافَةِ وَالرَّجا", "ajuz": "هُما كَجَناحَي طائِرٍ حينَ تَقصِدُ"},
    {"n": 42, "sadr": "وَقَلبَكَ طَهِّرهُ وَمِن كُلِّ آفَةٍ", "ajuz": "وَكُن أَبَداً عَن عَيبِهِ تَتَفَقَّدُ"},
    {"n": 43, "sadr": "وَجَمِّل بِنُصحِ الخَلقِ قَلبَكَ إِنَّهُ", "ajuz": "لَأَعلى جَمالٍ لِلقُلوبِ وَأَجوَدُ"},
    {"n": 44, "sadr": "وَصاحِب إِذا صاحَبتَ كُلَّ مُوَفَّقٍ", "ajuz": "يَقودُكَ لِلخَيراتِ نُصحاً وَيُرشِدُ"},
    {"n": 45, "sadr": "وَإِيّاكَ وَالمَرءَ الَّذي إِن صَحِبتَهُ", "ajuz": "خَسِرتَ خَساراً لَيسَ فيهِ تَرَدُّدُ"},
    {"n": 46, "sadr": "خُذِ العَفوَ مِنَ أَخلاقِ مَن قَد صَحِبتَهُ", "ajuz": "كَما يَأمُرُ الرَّحمَنُ فيهِ وَيُرشِدُ"},
    {"n": 47, "sadr": "تَرَحَّل عَنِ الدُّنيا فَلَيسَت إِقامَةً", "ajuz": "وَلَكِنَّها زادٌ لِمَن يَتَزَوَّدُ"},
    {"n": 48, "sadr": "وَكُن سالِكاً طُرقَ الَّذينَ تَقَدَّموا", "ajuz": "إِلى المَنزِلِ الباقي الَّذي لَيسَ يَنفَدُ"},
    {"n": 49, "sadr": "وَكُن ذاكِراً لِلَّهِ في كُلِّ حالَةٍ", "ajuz": "فَلَيسَ لِذِكرِ اللَّهِ وَقتٌ مُقَيَّدُ"},
    {"n": 50, "sadr": "فَذِكرُ إِلَهِ العَرشِ سِرّاً وَمُعلَناً", "ajuz": "يُزيلُ الشَّقا وَالهَمَّ عَنكَ وَيَطرُدُ"},
    {"n": 51, "sadr": "وَيَجلِبُ لِلخَيراتِ دُنياً وَآجِلاً", "ajuz": "وَإِن يَأتِكَ الوَسواسُ يَوماً يُشَرِّدُ"},
    {"n": 52, "sadr": "فَقَد أَخبَرَ المُختارُ يَوماً لِصَحبِهِ", "ajuz": "بِأَنَّ كَثيرَ الذِّكرِ في السَّبقِ مُفرِدُ"},
    {"n": 53, "sadr": "وَوَصّى مُعاذاً يَستَعينُ إِلَهَهُ", "ajuz": "عَلى ذِكرِهِ وَالشُّكرِ بِالحُسنِ يَعبُدُ"},
    {"n": 54, "sadr": "وَأَوصى لِشَخصٍ قَد أَتى لِنَصيحَةٍ", "ajuz": "وَقَد كانَ في حَملِ الشَّرائِعِ يَجهَدُ"},
    {"n": 55, "sadr": "بِأَن لا يَزَل رَطباً لِسانُكَ هَذِهِ", "ajuz": "تُعينُ عَلى كُلِّ الأُمورِ وَتُسعِدُ"},
    {"n": 56, "sadr": "وَأَخبَرَ أَنَّ الذِّكرَ غَرسٌ لِأَهلِهِ", "ajuz": "بِجَنّاتِ عَدنٍ وَالمَساكِنُ تُمهَدُ"},
    {"n": 57, "sadr": "وَأَخبَرَ أَنَّ اللَّهَ يَذكُرُ عَبدَهُ", "ajuz": "وَمَعهُ عَلى كُلِّ الأُمورِ يُسَدِّدُ"},
    {"n": 58, "sadr": "وَأَخبَرَ أَنَّ الذِّكرَ يَبقى بِجَنَّةٍ", "ajuz": "وَيَنقَطِعُ التَّكليفُ حينَ يُخَلَّدوا"},
    {"n": 59, "sadr": "وَلَو لَم يَكُن في ذِكرِهِ غَيرَ أَنَّهُ", "ajuz": "طَريقٌ إِلى حُبِّ الإِلَهِ وَمُرشِدُ"},
    {"n": 60, "sadr": "وَيَنهى الفَتى عَن غيبَةٍ وَنَميمَةٍ", "ajuz": "وَعَن كُلِّ قَولٍ لِلدِّيانَةِ مُفسِدُ"},
    {"n": 61, "sadr": "لَكانَ لَنا حَظٌّ عَظيمٌ وَرَغبَةٌ", "ajuz": "بِكَثرَةِ ذِكرِ اللَّهِ نِعمَ المُوَحَّدُ"},
    {"n": 62, "sadr": "وَلَكِنَّنا مِن جَهلِنا قَلَّ ذِكرُنا", "ajuz": "كَما قَلَّ مِنّا لِلإِلَهِ التَّعَبُّدُ"},
    {"n": 63, "sadr": "وَسَل رَبَّكَ التَّوفيقَ وَالفَوزَ دائِماً", "ajuz": "فَما خابَ عَبدٌ لِلمُهَيمِنِ يَقصِدُ"},
    {"n": 64, "sadr": "وَصَلِّ إِلَهي مَع سَلامٍ وَرَحمَةٍ", "ajuz": "عَلى خَيرِ مَن قَد كانَ لِلخَلقِ يُرشِدُ"},
    {"n": 65, "sadr": "وَآلٍ وَأَصحابٍ وَمَن كانَ تابِعاً", "ajuz": "صَلاةً وَتَسليماً يَدومُ وَيَخلُدُ"}
  ]
}
