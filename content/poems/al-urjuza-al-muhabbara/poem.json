{
  "id": "al-urjuza-al-muhabbara",
  "poet": "ali-ibn-al-jahm",
  "title": "الأُرجوزَةُ المُحَبَّرَةُ",
  "meter": "rajaz",
  "themes": ["didactic"],
  "abyat_in_full": 335,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,    "sadr": "الحَمدُ لِلَّهِ المُعيدِ المُبدي", "ajuz": "حَمداً كَثيراً وَهوَ أَهلُ الحَمدِ" },
    { "n": 2,    "sadr": "ثُمَّ الصَّلاةُ أَوَّلاً وَآخِرا", "ajuz": "عَلى النَّبِيِّ باطِناً وَظاهِرا" },
    { "n": 3,    "sadr": "يا سائِلي عَنِ اِبتِداءِ الخَلقِ", "ajuz": "مَسأَلَةَ القاصِدِ قَصدَ الحَقِّ" },
    { "n": 4,    "sadr": "أَخبَرَني قَومٌ مِنَ الثِّقاتِ", "ajuz": "أُولو عُلومٍ وَأُولو هَيئاتِ" },
    { "n": 5,    "sadr": "تَقَدَّموا في طَلَبِ الآثارِ", "ajuz": "وَعَرَفوا حَقائِقَ الأَخبارِ" },
    { "n": 6,    "sadr": "وَفَهِموا التَّوراةَ وَالإِنجيلا", "ajuz": "وَأَحكَموا التَّنزيلَ وَالتَّأويلا" },
    { "n": 7,    "sadr": "أَنَّ الَّذي يَفعَلُ ما يَشاءُ", "ajuz": "وَمَن لَهُ العِزَّةُ وَالبَقاءُ" },
    { "n": 8,    "sadr": "أَنشَأَ خَلقَ آدَمٍ إِنشاءَ", "ajuz": "وَقَدَّ مِنهُ زَوجَهُ حَوّاءَ" },
    { "n": 9,    "sadr": "مُبتَدِئاً ذَلِكَ يَومَ الجُمعَة", "ajuz": "حَتّى إِذا أَكمَلَ مِنهُ صُنعَه" },
    { "n": 10,   "sadr": "أَسكَنَهُ وَزَوجَهُ الجِنانا", "ajuz": "فَكانَ مِن أَمرِهِما ما كانا" },
    { "n": 11,   "sadr": "غَرَّهُما إِبليسُ فَاغتَرّا بِهِ", "ajuz": "كَما أَبانَ اللَّهُ في كِتابِهِ" },
    { "n": 12,   "sadr": "دَلّاهُما المَلعونُ فيما صَنَعا", "ajuz": "فَأُهبِطا مِنها إِلى الأَرضِ مَعا" },
    { "n": 13,   "sadr": "فَوَقَعَ الشَّيخُ أَبونا آدَم", "ajuz": "بِجَبَلٍ في الهِندِ يُدعى واسِم" },
    { "n": 14,   "sadr": "لَبِئسَما اِعتاضَ مِنَ الجِنانِ", "ajuz": "وَعَن جِوارِ المَلِكِ المَنّانِ" },
    { "n": 15,   "sadr": "وَالضَّعفُ مِن خَليقَةِ الإِنسانِ", "ajuz": "لا سِيَّما في أَوَّلِ الزَّمانِ" },
    { "n": 16,   "sadr": "ما لَبِثا في الفَوزِ يَوماً واحِدا", "ajuz": "حَتّى اِستَعاضا مِنهُ جَهداً جاهِدا" },
    { "n": 17,   "sadr": "فَشَقِيا وَوَرَّثا الشَّقاءَ", "ajuz": "نَسلَهُما وَالهَمَّ وَالعَناءَ" },
    { "n": 18,   "sadr": "وَلَم يَزَل مُستَغفِراً مِن ذَنبِهِ", "ajuz": "حَتّى تَلَقّى كَلِماتِ رَبِّهِ" },
    { "n": 19,   "sadr": "فَأَمِنَ السَّخطَةَ وَالعِقابا", "ajuz": "وَاللَّهُ تَوّابٌ عَلى مَن تابا" },
    { "n": 20,   "sadr": "ثُمَّ اِستَمَلّا وَأَحَبّا النَّسلا", "ajuz": "فَحَمَلَت حَوّاءُ مِنهُ حَملا" },
    { "n": 21,   "sadr": "وَوَضَعَت إِبناً وَبِنتاً تَوأَما", "ajuz": "فَسُرَّ لَمّا سَلِمَت وَسَلِما" },
    { "n": 22,   "sadr": "وَاقتَنَيا الإِبنَ فَسُمّي قايِنا", "ajuz": "وَعايَنا مِن أَمرِهِ ما عايَنا" },
    { "n": 23,   "sadr": "ثُمَّ أَغَبَّت بَعدَهُ قَليلا", "ajuz": "فَوَضَعَت مُتئِمَةً هابيلا" },
    { "n": 24,   "sadr": "فَشَبَّ هابيلُ وَشَبَّ قايِنُ", "ajuz": "وَلَم يَكُن بَينَهُما تَبايُنُ" },
    { "n": 25,   "sadr": "فَقَرَّبا لِحاجَةٍ قُربانا", "ajuz": "وَخَضَعا لِلَّهِ وَاستَكانا" },
    { "n": 26,   "sadr": "فَقُبِلَ القُربانُ مِن هابيلِ", "ajuz": "وَلَم يَفُز قايِنُ بِالقَبولِ" },
    { "n": 27,   "sadr": "فَثارَ لِلحَينِ الَّذي حُيِّنَ لَه", "ajuz": "إِلى أَخيهِ ظالِماً فَقَتَلَه" },
    { "n": 28,   "sadr": "ثُمَّ اِستَفَزَّ أُختَهُ فَهَرَبا", "ajuz": "وَفارَقا أُمّاً أَلوفاً وَأَبا" },
    { "n": 29,   "sadr": "فَبَعُدَت دارُهُما مِن دارِهِ", "ajuz": "وَزَهِدا في الخَيرِ مِن جِوارِهِ" },
    { "n": 30,   "sadr": "فَأَخلَفَ اللَّهُ عَلَيهِ شيثا", "ajuz": "وَلَم يَزَل بِاللَّهِ مُستَغيثا" },
    { "n": 31,   "sadr": "حَتّى إِذا أَحَسَّ بِالحِمامِ", "ajuz": "وَذاكَ بَعدَ سَبعِ مِيَّة عامِ" },
    { "n": 32,   "sadr": "كانَت إِلى شيثَ اِبنِهِ الوَصِيَّة", "ajuz": "وَلَيسَ شَيءٌ يُعجِزُ المَنِيَّة" },
    { "n": 33,   "sadr": "أَنِ اُعبُدِ اللَّهَ وَجانِب قايِنا", "ajuz": "وَكُن لَهُ وَنَسلِهِ مُبايِنا" },
    { "n": 34,   "sadr": "فَلَم يَزَل شيثُ عَلى الإيمانِ", "ajuz": "مُعتَصِماً بِطاعَةِ الرَّحمَنِ" },
    { "n": 35,   "sadr": "يَحفَظُ ما أَوصى بِهِ أَبوهُ", "ajuz": "لا يَتَخَطّاهُ وَلا يَعدوهُ" },
    { "n": 36,   "sadr": "حَتّى إِذا ما حَضَرَت وَفاتُهُ", "ajuz": "وَخافَ أَن يَفجَأَهُ ميقاتُهُ" },
    { "n": 37,   "sadr": "أَوصى أَنوشاً وَأَنوشٌ كَهلُ", "ajuz": "بِمِثلِ ما أَوصى أَبوهُ قَبلُ" },
    { "n": 38,   "sadr": "فَلَم يَزَل أَنوشُ يَقفو أَثَرَه", "ajuz": "لا يَتَعَدّى جاهِداً ما أَمَرَه" },
    { "n": 39,   "sadr": "ثُمَّ تَلاهُ إِبنُهُ قَينانُ", "ajuz": "وَقَولُهُ وَفِعلُهُ الإيمانُ" },
    { "n": 40,   "sadr": "ثُمَّ تَلا قَينانَ مَهلائيلُ", "ajuz": "فَسَنَّ ما سَنَّت لَهُ الكُهولُ" },
    { "n": 41,   "sadr": "ثُمَّ اِستَقَلَّ بِالأُمورِ يَردُ", "ajuz": "أَخنوخُ وَهوَ في العُلومِ فَردُ" },
    { "n": 42,   "sadr": "وَكانَ في زَمانِهِ توبيلُ", "ajuz": "الخالِعُ المُضَلِّلُ الضِّلّيلُ" },
    { "n": 43,   "sadr": "أَوَّلُ مَن تَتَبَّعَ المَلاهِيا", "ajuz": "وَأَظهَرَ الفَسادَ وَالمَعاصِيا" },
    { "n": 44,   "sadr": "وَكانَ مِن نَسلِ الغَوِيِّ قايِنِ", "ajuz": "وَغَيرُ بِدعٍ خائِنٌ مِن خائِنِ" },
    { "n": 45,   "sadr": "فَاغتَرَّ مِن أَولادِ شيثٍ عالَما", "ajuz": "حَتّى عَصَوا وَانتَهَكوا المَحارِما" },
    { "n": 46,   "sadr": "وَخالَفوا وَصِيَّةَ الآباءِ", "ajuz": "وَافتَتَنوا بِاللَّهوِ وَالنِّساءِ" },
    { "n": 47,   "sadr": "وَلَم يَزَل يارِدُ يَألو قَومَهُ", "ajuz": "نُصحاً وَكانوا يُكثِرونَ لَومَهُ" },
    { "n": 48,   "sadr": "حَتّى إِذا ماتَ اِستَقَلَّ بَعدَهُ", "ajuz": "إِدريسُ بِالأَمرِ فَأَورى زَندَهُ" },
    { "n": 49,   "sadr": "وَهوَ خَنوخُ بِالبَيانِ أَعجَما", "ajuz": "صَلّى عَلَيهِ رَبُّنا وَسَلَّما" },
    { "n": 50,   "sadr": "أَوَّلُ مَبعوثٍ إِلى العِبادِ", "ajuz": "وَآمِرٍ بِالخَيرِ وَالرَّشادِ" },
    { "n": 51,   "sadr": "وَأَوَّلُ النّاسِ قَرا وَكَتَبا", "ajuz": "وَعَلَّمَ الحِسابَ لَمّا حَسَبا" },
    { "n": 52,   "sadr": "فَلَم يُطِعهُ أَحَدٌ مِن أَهلِهِ", "ajuz": "وَاختَلَطوا بِقايِنٍ وَنَسلِهِ" },
    { "n": 53,   "sadr": "فَرَفَعَ اللَّهُ إِلَيهِ عَبدَهُ", "ajuz": "مِن بَعدِ ما اِختارَ المُقامَ عِندَهُ" },
    { "n": 54,   "sadr": "وَصارَ مَتّوشَلَخٌ مُستَخلَفا", "ajuz": "مِن بَعدِ إِدريسَ النَّبِيِّ المُصطَفى" },
    { "n": 55,   "sadr": "فَحَذَّرَ النّاسَ عَذاباً نازِلا", "ajuz": "فَلَم يَجِد في الأَرضِ مِنهُم قابِلا" },
    { "n": 56,   "sadr": "غَيرَ اِبنِهِ لَمكٍ فَأَوصى لَمكا", "ajuz": "وَصِيَّةً كانَت تُقىً وَنُسكا" },
    { "n": 57,   "sadr": "فَوَعَظَ النّاسَ فَخالَفوهُ", "ajuz": "وَنَفَروا عَنهُ وَفارَقوهُ" },
    { "n": 58,   "sadr": "فَأَرسَلَ اللَّهُ إِلَيهِم نوحا", "ajuz": "عَبداً لِمَن أَرسَلَهُ نَصوحا" },
    { "n": 59,   "sadr": "فَعاشَ أَلفاً غَيرَ خَمسينَ سَنَة", "ajuz": "يَدعو إِلى اللَّهِ وَتَمضي الأَزمِنَة" },
    { "n": 60,   "sadr": "يَدعوهُمُ سِرّاً وَيَدعو جَهرا", "ajuz": "فَلَم يَزِدهُم ذاكَ إِلّا كُفرا" },
    { "n": 61,   "sadr": "وَانهَمَكوا في الكُفرِ وَالطُّغيانِ", "ajuz": "وَأَظهَروا عِبادَةَ الأَوثانِ" },
    { "n": 62,   "sadr": "حَتّى إِذا اِستَيأَسَ أَن يُطاعا", "ajuz": "وَحَجَبوا مِن دونِهِ الأَسماعا" },
    { "n": 63,   "sadr": "دَعا عَلَيهِم دَعوَةَ البَوارِ", "ajuz": "مِن بَعدِ ما أَبلَغَ في الإِنذارِ" },
    { "n": 64,   "sadr": "وَاتَّخَذَ الفُلكَ بِأَمرِ رَبِّهِ", "ajuz": "حَتّى نَجا بِنَفسِهِ وَحِزبِهِ" },
    { "n": 65,   "sadr": "وَأَقبَلَ الطّوفانُ ماءً طاغِيا", "ajuz": "فَلَم يَدَع في الأَرضِ خَلقاً باقِيا" },
    { "n": 66,   "sadr": "غَيرَ الَّذينَ اِعتَصَموا في الفُلكِ", "ajuz": "فَسَلِموا مِن غَمَراتِ الهُلكِ" },
    { "n": 67,   "sadr": "وَكانَ هَذا كُلُّهُ في آبِ", "ajuz": "قَبلَ اِنتِصافِ الشَّهرِ في الحِسابِ" },
    { "n": 68,   "sadr": "فَعَزَموا عِندَ اِقتِرابِ المَعمَعَة", "ajuz": "أَن يَركَبوا الفُلكَ وَأَن يَنجوا مَعَه" },
    { "n": 69,   "sadr": "وَكانَ مِن أَولادِ نوحٍ واحِدُ", "ajuz": "مُخالِفٌ لِأَمرِهِ مُعانِدُ" },
    { "n": 70,   "sadr": "فَبادَ فيمَن بادَ مِن عِبادِهِ", "ajuz": "وَسَلِمَ الباقونَ مِن أَولادِهِ" },
    { "n": 71,   "sadr": "سامٌ وَحامٌ وَالصَّغيرُ الثّالِثُ", "ajuz": "وَهُوَ في التَّوراةِ يُدعى يافِثُ" },
    { "n": 72,   "sadr": "فَأَكثَرُ البيضانِ نَسلُ سامِ", "ajuz": "وَأَكثَرُ السّودانِ نَسلُ حامِ" },
    { "n": 73,   "sadr": "وَيافِثٌ في نَسلِهِ عَجائِبُ", "ajuz": "يَأجوجُ وَالأَتراكُ وَالصَّقالِبُ" },
    { "n": 74,   "sadr": "وَمِن بَني سامِ اِبنِ نوحٍ إِرَمُ", "ajuz": "وَارفَخشَذٌ وَلاوِذٌ وَغَيلَمُ" },
    { "n": 75,   "sadr": "فَكَثُرَت مِن بَعدِ نوحٍ عادُ", "ajuz": "وَشاعَ مِنها العَيثُ وَالفَسادُ" },
    { "n": 76,   "sadr": "وَعادُ مِن أَولادِ عَوصِ اِبنِ إِرَم", "ajuz": "وَمِن بَني عَوصٍ جَديسٌ وَطَسَم" },
    { "n": 77,   "sadr": "فَأَرسَلَ اللَّهُ إِلَيهِم هودا", "ajuz": "فَجَرَّدَ الحَقَّ لَهُم تَجريدا" },
    { "n": 78,   "sadr": "فَعانَدوهُ شَرَّ ما عِنادِ", "ajuz": "وَانهَمَكوا في الكُفرِ وَالإِلحادِ" },
    { "n": 79,   "sadr": "فَقالَ يا رَبِّ أَعِزَّ القَطرا", "ajuz": "عَنهُم فَعَدّاهُم سِنينَ عَشرا" },
    { "n": 80,   "sadr": "وَأَرسَلَ الرّيحَ عَلَيهِم عاصِفا", "ajuz": "فَلَم تَدَع مِن آلِ عادٍ طائِفا" },
    { "n": 81,   "sadr": "وَكانَ وَفدٌ مِنهُمُ سَبعونا", "ajuz": "كادوا إِلى مَكَّةَ يَسبِقونا" },
    { "n": 82,   "sadr": "فَابتَهَلوا وَرَفَعوا أَيديهِم", "ajuz": "وَكانَ لُقمانُ اِبنُ عادٍ مِنهُم" },
    { "n": 83,   "sadr": "فَسَأَلَ البَقاءَ وَالتَّعميرا", "ajuz": "فَعاشَ حَتّى أَهلَكَ النُّسورا" },
    { "n": 84,   "sadr": "وَوافَقَت دَعوَتُهُ إِجابَة", "ajuz": "إِذ لَم يَكُن بِمُرتَضٍ أَصحابَه" },
    { "n": 85,   "sadr": "وَأَثمَرَت ثَمودُ بَعدَ عادِ", "ajuz": "فَسَكَنَت حِجراً وَبَطنَ الوادي" },
    { "n": 86,   "sadr": "فَأَرسَلَ اللَّهُ إِلَيهِم صالِحا", "ajuz": "فَتىً حَديثَ السِّنِّ مِنهُم راجِحا" },
    { "n": 87,   "sadr": "فَلَم يَزَل يَدعوهُمُ حَتّى اِكتَهَل", "ajuz": "وَلَم يُجِبهُ مِنهُمُ إِلّا الأَقَل" },
    { "n": 88,   "sadr": "وَأَحضَروهُ صَخرَةً مَلساءَ", "ajuz": "وَقالوا أَخلِص عِندَها الدُّعاءَ" },
    { "n": 89,   "sadr": "فَهَل لِمَن تَعبُدُهُ مِن طاقَة", "ajuz": "أَن تَتَشَظّى وَلَداً عَن ناقَة" },
    { "n": 90,   "sadr": "فَانفَلَقَت حَتّى بَدا زَجيلُها", "ajuz": "عَن ناقَةٍ يَتبَعُها فَصيلُها" },
    { "n": 91,   "sadr": "فَعَقَروا النّاقَةَ لِلشَّقاءِ", "ajuz": "فَعاجَلَتهُم صَيحَةُ الفَناءِ" },
    { "n": 92,   "sadr": "فَتِلكَ حِجرٌ مِن ثَمودَ خالِيَة", "ajuz": "فَهَل تَرى في الأَرضِ مِنهُم باقِيَة" },
    { "n": 93,   "sadr": "ثُمَّ اِصطَفى رَبُّكَ إِبراهيما", "ajuz": "وَلَم يَزَل بِخَلقِهِ رَحيما" },
    { "n": 94,   "sadr": "فَكانَ مِن إِخلاصِهِ التَّوحيدا", "ajuz": "أَن هَجَرَ القَريبَ وَالبَعيدا" },
    { "n": 95,   "sadr": "وَشَرَعَ الشَّرائِعَ الحِسانا", "ajuz": "وَكَسَّرَ الأَصنامَ وَالأَوثانا" },
    { "n": 96,   "sadr": "وَقالَ لوطٌ إِنَّني مُهاجِرُ", "ajuz": "وَبِالَّذي تَأمُرُ قَومي آمِرُ" },
    { "n": 97,   "sadr": "ما قَد تَوَلّى شَرحَهُ القُرآنُ", "ajuz": "وَفي القُرانِ الصِّدقُ وَالبَيانُ" },
    { "n": 98,   "sadr": "فَشَكَرَ اللَّهُ لَهُ الإيمانا", "ajuz": "وَخَصَّهُ الحُجَّةَ وَالبُرهانا" },
    { "n": 99,   "sadr": "وَقَمَعَ النُّمرودَ عاتي دَهرِهِ", "ajuz": "بِحُجَجِ اللَّهِ وَحُسنِ صَبرِهِ" },
    { "n": 100,  "sadr": "وَجَعَلَ الحِكمَةَ في أَولادِهِ", "ajuz": "وَاختارَهُم طُرّاً عَلى عِبادِهِ" },
    { "n": 101,  "sadr": "وَجَعَلَ الأَمرَ لِإِسماعيلِ", "ajuz": "فَهوَ أَسَنُّ وَلَدِ الخَليلِ" },
    { "n": 102,  "sadr": "وَوَلَدَت هاجَرُ قَبلَ سارَة", "ajuz": "وَقَبلَها بُلِّغَتِ البِشارَة" },
    { "n": 103,  "sadr": "مِن رَبِّها وَسَمِعَت نِداءَ", "ajuz": "قَد سَمِعَ اللَّهُ لَكِ الدُّعاءَ" },
    { "n": 104,  "sadr": "وَأُسكِنَت في البَلَدِ الأَمينِ", "ajuz": "وَشَبَّ إِسماعيلُ في الحَجونِ" },
    { "n": 105,  "sadr": "وَكانَ يَوماً عِندَهُ جِبريلُ", "ajuz": "وَعِندَهُ النَّبِيُّ إِسماعيلُ" },
    { "n": 106,  "sadr": "وَهوَ صَغيرٌ فَاشتَكى الظَّماءَ", "ajuz": "فَخَرَجَت هاجَرُ تَبغي الماءَ" },
    { "n": 107,  "sadr": "فَهَمَزَ الأَرضَ فَجاشَت جُمجُما", "ajuz": "تَفورُ مِن هَمزَتِهِ أَنهُرَ ما" },
    { "n": 108,  "sadr": "وَأَقبَلَت هاجَرُ لَمّا يَئِسَت", "ajuz": "فَراعَها ما عايَنَت فَأَبلَسَت" },
    { "n": 109,  "sadr": "وَجَعَلَت تَبني لَهُ الصَّفائِحا", "ajuz": "لَو تَرَكَتهُ كانَ ماءً سائِحا" },
    { "n": 110,  "sadr": "وَجاوَرَتهُم جُرهُمٌ في الدّارِ", "ajuz": "راغِبَةً في الصِّهرِ وَالجِوارِ" },
    { "n": 111,  "sadr": "فَوَلَدوا النِّساءَ وَالرِّجالا", "ajuz": "خُؤولَةً شَرَّفَتِ الأَخوالا" },
    { "n": 112,  "sadr": "وَوَطَّنوا مَكَّةَ دَهراً داهِرا", "ajuz": "حَتّى إِذا ما قارَفوا الكَبائِرا" },
    { "n": 113,  "sadr": "وَبَدَّلوا شِرعَةَ إِبراهيمِ", "ajuz": "وَشَبَّهوا التَّحليلَ بِالتَّحريمِ" },
    { "n": 114,  "sadr": "أَجلَتهُمُ عَنها بَنو كِنانَة", "ajuz": "فَرَحَلوا بِالذُّلِّ وَالمَهانَة" },
    { "n": 115,  "sadr": "وَوَلِيَ البَيتَ وَأَمرَ النّاسِ", "ajuz": "الأَكرَمونَ مِن بَني إِلياسِ" },
    { "n": 116,  "sadr": "فَلَم تَزَل شِرعَةُ إِسماعيلِ", "ajuz": "بِأَهلِهِ واضِحَةَ السَّبيلِ" },
    { "n": 117,  "sadr": "حَتّى اِنتَهى الأَمرُ إِلى قُصَيِّ", "ajuz": "مُجَمِّعٍ خَيرِ بَني لُؤَيِّ" },
    { "n": 118,  "sadr": "فَسَلَّمَ النّاسُ لَهُ المَقاما", "ajuz": "وَالبَيتَ وَالمَشعَرَ وَالحَراما" },
    { "n": 119,  "sadr": "وَصارَتِ القَوسُ إِلى باريها", "ajuz": "وَصادَفَت رَمِيَّةٌ راميها" },
    { "n": 120,  "sadr": "فَأُبطِنَت في أَهلِها المَكارِمُ", "ajuz": "وَرُفِعَت لِشَيدِها الدَّعائِمُ" },
    { "n": 121,  "sadr": "وَوَرَّثَ الشَّيخُ بَنيهِ الشَّرَفا", "ajuz": "وَكُلُّهُم أَغنى وَأَجدى وَكَفى" },
    { "n": 122,  "sadr": "وَاسمَع حَديثَ عَمِّنا إِسحاقا", "ajuz": "فَإِنَّني أَسوقُهُ أَنساقا" },
    { "n": 123,  "sadr": "جاءَ عَلى فَوتٍ مِنَ الشَّبابِ", "ajuz": "وَمِئَةٍ مَرَّت مِنَ الأَحقابِ" },
    { "n": 124,  "sadr": "فَأَيَّدَ اللَّهُ بِهِ الخَليلا", "ajuz": "وَعَضَدَ الصّادِقَ إِسماعيلا" },
    { "n": 125,  "sadr": "وَعَجِبَت سارَةُ لَمّا بُشِّرَت", "ajuz": "بِهِ فَصَكَّت وَجهَها وَذُعِرَت" },
    { "n": 126,  "sadr": "قالَت وَأَنّى تَلِدُ العَجوزُ", "ajuz": "قيلَ إِذا قَدَّرَهُ العَزيزُ" },
    { "n": 127,  "sadr": "وَقيلَ مِن وَرائِهِ يَعقوبُ", "ajuz": "مَقالَةٌ لَيسَ لَها تَكذيبُ" },
    { "n": 128,  "sadr": "فَتَمَّ وَعدُ اللَّهِ جَلَّ ذِكرُهُ", "ajuz": "وَغَلَبَ الأَمرَ جَميعاً أَمرُهُ" },
    { "n": 129,  "sadr": "فَكانَ مِن قِصَّةِ يَعقوبَ النَّبي", "ajuz": "ما لَيسَ يَخفى ذِكرُهُ في الكُتُبِ" },
    { "n": 130,  "sadr": "قَد أَفرَدَ اللَّهُ بِذاكَ سورَة", "ajuz": "مَعروفَةً بيوسُفٍ مَشهورَة" },
    { "n": 131,  "sadr": "وَماتَ يَعقوبُ بِأَرضِ مِصرِ", "ajuz": "مِن بَعدِ تِسعٍ كَمَلَت وَعَشرِ" },
    { "n": 132,  "sadr": "وَإِنَّما طالَعَ مِصرَ زائِرا", "ajuz": "ليوسُفٍ ثُمَّ ثَوى مُجاوِرا" },
    { "n": 133,  "sadr": "حَتّى إِذا أَيقَنَ بِالحِمامِ", "ajuz": "أَوصى بِأَن يُقبَرَ بِالشَّآمِ" },
    { "n": 134,  "sadr": "فَحَمَلَ التّابوتَ حَتّى قَبَرَه", "ajuz": "يوسُفُ بِالشّامِ عَلى ما أَمَرَه" },
    { "n": 135,  "sadr": "ثُمَّ أَتى مِصرَ فَعاشَ حِقَبا", "ajuz": "حَتّى قَضى مِنَ الحَياةِ أَرَبا" },
    { "n": 136,  "sadr": "وَكانَ مِن أُسرَتِهِ سَبعونا", "ajuz": "أَتَوهُ مَع يَعقوبَ زائِرينا" },
    { "n": 137,  "sadr": "فَكَثُرَت عِدَّتُهُم بِمِصرِ", "ajuz": "وَنالَهُم فيها أَشَدُّ ضُرِّ" },
    { "n": 138,  "sadr": "وَكانَ فِرعَونُ يَليهِم قَسرا", "ajuz": "فَسامَهُم سوءَ العَذابِ دَهرا" },
    { "n": 139,  "sadr": "فَبَعَثَ اللَّهُ إِلَيهِم موسى", "ajuz": "مِن بَعدِ ما قَدَّسَهُ تَقديسا" },
    { "n": 140,  "sadr": "فَخَلَّصَ القَومَ مِنَ العَذابِ", "ajuz": "وَهُم عَلى ما قيلَ في الحِسابِ" },
    { "n": 141,  "sadr": "سِوى الذَّراري وَالرِّجالِ العُجفِ", "ajuz": "مِنَ الرِّجالِ سِتُّ مِيَّة أَلفِ" },
    { "n": 142,  "sadr": "وَنَقَلَ التّابوتَ ذو العَهدِ الوَفي", "ajuz": "موسى وَفي التّابوتِ جِسمُ يوسُفِ" },
    { "n": 143,  "sadr": "لَم يَثنِهِ عَن ذاكَ بُعدُ العَهدِ", "ajuz": "وَلا الَّذي مَرَّ بِهِ مِن جَهدِ" },
    { "n": 144,  "sadr": "وَبَينَهُم إِحدى وَخَمسونَ سَنَة", "ajuz": "وَمِئَةٌ كامِلَةٌ مُمتَحَنَة" },
    { "n": 145,  "sadr": "وَمَكَثوا في التّيهِ أَربَعينا", "ajuz": "وَلَم يَعيشوا مِثلَها سِنينا" },
    { "n": 146,  "sadr": "وَماتَ هارونُ اِبنُ عِمرانَ النَّبي", "ajuz": "مِن قَبلِ موسى في مَنامٍ طَيِّبِ" },
    { "n": 147,  "sadr": "وَقيلَ ما أُخِّرَ عَن أَخيهِ", "ajuz": "إِلّا لِأَمرٍ قَد قُضي في التّيهِ" },
    { "n": 148,  "sadr": "ثُمَّ تَنَبّا يوشَعُ اِبنُ نونِ", "ajuz": "وَصِيُّ موسى الصّادِقِ الأَمينِ" },
    { "n": 149,  "sadr": "فَخاضَ بَحرَ أُردُنَ العَميقا", "ajuz": "وَجَعَلَ البَحرَ لَهُ طَريقا" },
    { "n": 150,  "sadr": "وَحُرِّقَت مِن خَوفِهِ أَريحا", "ajuz": "وَفَتَحَ اللَّهُ بِهِ الفُتوحا" },
    { "n": 151,  "sadr": "وَقالَ لِلشَّمسِ قِفي فَوَقَفَت", "ajuz": "وَرَدَّها مِن قَصدِها فَانصَرَفَت" },
    { "n": 152,  "sadr": "وَذَلَّلَ المُلوكَ حَتّى ذَلَّت", "ajuz": "وَقُلِّلَت في عَينِهِ فَقَلَّت" },
    { "n": 153,  "sadr": "وَأَسكَنَ الشّامَ بَني اِسرائيلِ", "ajuz": "وَعداً مِنَ الرَّحمَنِ في التَّنزيلِ" },
    { "n": 154,  "sadr": "ثُمَّ تَنَبّا وَقَفاهُ كالِبُ", "ajuz": "وَقالَ لِلأَسباطِ إِنّي ذاهِبُ" },
    { "n": 155,  "sadr": "وَخَلَّفَ الحَليمَ حِزقائيلا", "ajuz": "اِبنَ العَجوزِ بَعدَهُ بَديلا" },
    { "n": 156,  "sadr": "وَكَثُرَت مِن بَعدِهِ الأَحزابُ", "ajuz": "وَنَصَبوا بَعلَهُمُ وَعابوا" },
    { "n": 157,  "sadr": "فَقالَ إِلياسُ اِبنُ ياسينَ لَهُم", "ajuz": "وَهوَ نَبِيٌّ مُرسَلٌ مِن بَعدِهِم" },
    { "n": 158,  "sadr": "أَنِ اُعبُدوا اللَّهَ وَأَلقوا بَعلا", "ajuz": "فَاستَكبَروا وَأَوعَدوهُ القَتلا" },
    { "n": 159,  "sadr": "فَلَم يَزَل مُستَخفِياً سَيّاحا", "ajuz": "حَتّى دُعي بِالمَوتِ فَاستَراحا" },
    { "n": 160,  "sadr": "وَقيلَ في التَّوراةِ إِنَّ فَرَسا", "ajuz": "أَتاهُ في صَباحِهِ أَو في مَسا" },
    { "n": 161,  "sadr": "حَتّى إِذا رَكِبَهُ إِلياسُ", "ajuz": "غابَ فَلَم يَظهَر عَلَيهِ النّاسُ" },
    { "n": 162,  "sadr": "وَلَم يَزَل إِبنُ الخُطوبِ اليَسَعُ", "ajuz": "يَردَعُهُم دَهراً فَلَم يَرتَدِعوا" },
    { "n": 163,  "sadr": "وَسُلِبوا التّابوتَ مِن بَعدِ اليَسَع", "ajuz": "وَماتَ عالي رَأسُهُم مِنَ الجَزَع" },
    { "n": 164,  "sadr": "وَظَهَرَت عَلَيهِمُ الأَعداءُ", "ajuz": "وَعَمَّهُم بَعدَ الهُدى العَماءُ" },
    { "n": 165,  "sadr": "فَسَأَلوا نَبِيَّهُم سَمويلا", "ajuz": "أَن يَستَقيلَ المَلِكَ الجَليلا" },
    { "n": 166,  "sadr": "وَسَأَلوهُ أَن يُوَلّي والِيا", "ajuz": "عَلَيهِمُ يُقاتِلُ الأَعادِيا" },
    { "n": 167,  "sadr": "وَعاهَدوهُ أَن يُطيعوا أَمرَهُ", "ajuz": "وَأَن يُعِزّوهُ وَيُعلوا قَدرَهُ" },
    { "n": 168,  "sadr": "فَبَعَثَ اللَّهُ لَهُم طالوتا", "ajuz": "فَاتَّبَعوهُ وَغَزَوا جالوتا" },
    { "n": 169,  "sadr": "وَكانَ داوُدُ أَقامَ بَعدَهُ", "ajuz": "في أَهلِهِ ثُمَّ أَتاهُ وَحدَهُ" },
    { "n": 170,  "sadr": "وَكَلَّمَتهُ صَخرَةٌ صَمّاءُ", "ajuz": "نادَتهُ حَيثُ يُسمَعُ النِّداءُ" },
    { "n": 171,  "sadr": "خُذني فَإِنّي حَجَرُ الخَليلِ", "ajuz": "يُقتَلُ بي جالوتُ عَن قَليلِ" },
    { "n": 172,  "sadr": "وَكانَ أَيضاً سَأَلَتهُ قَبلَها", "ajuz": "صَخرَةُ إِسحاقَ النَّبِيِّ حَملَها" },
    { "n": 173,  "sadr": "فَشاهَدَ الحَربَ عَلى أَناتِهِ", "ajuz": "وَاصطَكَّتِ الأَحجارُ في مِخلاتِهِ" },
    { "n": 174,  "sadr": "وَكُلُّها يَطمَعُ في إِسدائِهِ", "ajuz": "مُنتَقِمٌ لِلَّهِ مِن أَعدائِهِ" },
    { "n": 175,  "sadr": "فَنالَ داوُدُ بِبَعضِهِنَّه", "ajuz": "جالوتَ إِذ كانَت لَهُ مَظِنَّه" },
    { "n": 176,  "sadr": "فَأَهلَكَ اللَّهُ لَهُ عَدُوَّه", "ajuz": "وَفازَ بِالمُلكِ وَبِالنُّبُوَّة" },
    { "n": 177,  "sadr": "وَكانَ طالوتُ لَهُ حَسودا", "ajuz": "فَأَظفَرَ اللَّهُ بِهِ داوُدا" },
    { "n": 178,  "sadr": "وَكانَ قَد أَسَّسَ بَيتَ المَقدِسِ", "ajuz": "بورِكَ في الأَساسِ وَالمُؤَسِّسِ" },
    { "n": 179,  "sadr": "وَإِنَّما تَمَّمَهُ سُلَيمان", "ajuz": "مِن بَعدِهِ حَتّى اِستَقَلَّ البُنيان" },
    { "n": 180,  "sadr": "وَكانَ قَد وَصّاهُ بِاستِتمامِهِ", "ajuz": "داوُدُ إِذ أَشفى عَلى حِمامِهِ" },
    { "n": 181,  "sadr": "وَقامَ بِالمُلكِ سُلَيمانُ المَلِك", "ajuz": "نَحوَ اَربَعينَ سَنَةً حَتّى هَلَك" },
    { "n": 182,  "sadr": "وَكانَ مِن أَولادِهِ عِشرونا", "ajuz": "مِن بَعدِهِ بِالمُلكِ قائِمونا" },
    { "n": 183,  "sadr": "ثُمَّ أَزالَ المُلكَ بُختُنَصَّرُ", "ajuz": "عَنهُم فَقامَ بَعدَهُم وَقَصَّروا" },
    { "n": 184,  "sadr": "وَخَرَّبَ الشَّقِيُّ بَيتَ المَقدِسِ", "ajuz": "وَكانَ مَشغوفاً بِقَتلِ الأَنفُسِ" },
    { "n": 185,  "sadr": "وَماتَ بِالرَّملَةِ عَن بَنينا", "ajuz": "مِن بَعدِهِ بِالمُلكِ قائِمينا" },
    { "n": 186,  "sadr": "فَقَتَلَ الأَخيرَ مِن بَنيهِ", "ajuz": "دارا وَصارَ مُلكُهُم إِلَيهِ" },
    { "n": 187,  "sadr": "وَكانَ في زَمانِهِ أَيّوبُ", "ajuz": "الصّابِرُ المُحتَسِبُ المُنيبُ" },
    { "n": 188,  "sadr": "وَبَعدَ أَيّوبَ اِبنُ مَتّى يونُسُ", "ajuz": "وَفيهِ لِلَّهِ كِتابٌ يُدرَسُ" },
    { "n": 189,  "sadr": "وَيونُسٌ وَلّى فَقامَ شَعيا", "ajuz": "فَأَنزَلَ اللَّهُ عَلَيهِ الوَحيا" },
    { "n": 190,  "sadr": "وَقيلَ إِنَّ الخِضرَ مِن إِخوانِهِ", "ajuz": "وَإِنَّهُ قَد كانَ في زَمانِهِ" },
    { "n": 191,  "sadr": "وَزَكَرِيّاءُ وَيَحيى الطّاهِرُ", "ajuz": "قَد أَنذَرا لَو أَغنَتِ المَناذِرُ" },
    { "n": 192,  "sadr": "كِلاهُما أُكرِمَ بِالشَّهادَة", "ajuz": "فَسَعِدا وَأَيَّما سَعادَة" },
    { "n": 193,  "sadr": "وَكانَ يَحيى أَدرَكَ اِبنَ مَريَمِ", "ajuz": "طِفلاً صَغيراً في الزَّمانِ الأَقدَمِ" },
    { "n": 194,  "sadr": "وَقَبلَ ذاكَ مَلَكَ الإِسكَندَرُ", "ajuz": "وَهُوَ ذو القَرنَينِ فيما يُذكَرُ" },
    { "n": 195,  "sadr": "وَكانَ عيسى بَعدَ ذي القَرنَينِ", "ajuz": "بِنَحوِ خَمسينَ وَمِيَّتَينِ" },
    { "n": 196,  "sadr": "يَنقُصُ حَولاً في حِسابِ الرّومِ", "ajuz": "بِذِكرِهِ في الخَبَرِ المَعلومِ" },
    { "n": 197,  "sadr": "وَكانَ في أَيّامِهِ الأَشغانون", "ajuz": "وَهُم مُلوكٌ لِلبِلادِ غازون" },
    { "n": 198,  "sadr": "فَجَذَّهُم بِالسَّيفِ أَردَشيرُ", "ajuz": "ثُمَّ اِبنُهُ مِن بَعدِهِ سابورُ" },
    { "n": 199,  "sadr": "وَانقَطَعَ الوَحيُ وَصارَ مُلكا", "ajuz": "وَأَعلَنوا بَعدَ المَسيحِ الشِّركا" },
    { "n": 200,  "sadr": "فَخَصَّ بِالطَّولِ بَني اِسماعيلِ", "ajuz": "أَضافَهُم بِالشَّرَفِ الجَليلِ" },
    { "n": 201,  "sadr": "فَلَزِمَت مَكَّةَ وَالبَوادِيا", "ajuz": "وَحَلَّتِ الأَريافَ وَالحَواشِيا" },
    { "n": 202,  "sadr": "وَظَهَرَت بِاليَمَنِ التَّبابِعَة", "ajuz": "شِمرُ اِبنُ رَعشٍ وَمُلوكٌ خالِعَة" },
    { "n": 203,  "sadr": "وَاستَولَتِ الرّومُ عَلى الشّاماتِ", "ajuz": "فَآثَرَت رَفاهَةَ الحَياةِ" },
    { "n": 204,  "sadr": "وَأَجمَعَت لِلفُرسِ أَرضُ بابِلِ", "ajuz": "وَقَنِعَت مِن عاجِلٍ بِآجِلِ" },
    { "n": 205,  "sadr": "فَهَذِهِ جُملَةُ أَخبارِ الأُمَم", "ajuz": "مَنقولَةٌ مِن عَرَبٍ وَمِن عَجَم" },
    { "n": 206,  "sadr": "وَكُلُّ قَومٍ لَهُمُ تَكثيرُ", "ajuz": "وَقَلَّما تُحَصَّلُ الأُمورُ" },
    { "n": 207,  "sadr": "وَعَمِيَت في الفَترَةِ الأَخبارُ", "ajuz": "إِلّا الَّتي سارَت بِها الأَشعارُ" },
    { "n": 208,  "sadr": "وَالفُرسُ وَالرّومُ لَهُم أَيّامُ", "ajuz": "يَمنَعُ مِن تَفخيمِها الإِسلامُ" },
    { "n": 209,  "sadr": "وَإِنَّما يَقنَعُ أَهلُ العَقلِ", "ajuz": "بِكُتُبِ اللَّهِ وَقَولِ الرُّسلِ" },
    { "n": 210,  "sadr": "ثُمَّ أَزالَ الظُّلمَةَ الضِّياءُ", "ajuz": "وَعاوَدَت جِدَّتَها الأَشياءُ" },
    { "n": 211,  "sadr": "وَدانَتِ الشُّعوبُ وَالأَحياءُ", "ajuz": "وَجاءَ ما لَيسَ بِهِ خَفاءُ" },
    { "n": 212,  "sadr": "أَتاهُمُ المُنتَجَبُ الأَوّاهُ", "ajuz": "مُحَمَّدٌ صَلّى عَلَيهِ اللَّهُ" },
    { "n": 213,  "sadr": "أَكرَمُ خَلقِ اللَّهِ طُرّاً نَفسا", "ajuz": "وَمَولِداً وَمَحتِداً وَجِنسا" },
    { "n": 214,  "sadr": "يَقضي لَهُ بِالشَّرَفِ الأَشرافُ", "ajuz": "لا مِريَةٌ فيهِ وَلا خِلافُ" },
    { "n": 215,  "sadr": "أَقامَ في مَكَّتِهِ سِنينا", "ajuz": "حَتّى إِذا اِستَكمَلَ أَربَعينا" },
    { "n": 216,  "sadr": "أَرسَلَهُ اللَّهُ إِلى العِبادِ", "ajuz": "أَشرِف بِهِ مِن مُنذِرٍ وَهادِ" },
    { "n": 217,  "sadr": "فَظَلَّ يَدعوهُم ثَلاثَ عَشرَة", "ajuz": "بِمَكَّةٍ قَبلَ حُضورِ الهِجرَة" },
    { "n": 218,  "sadr": "ثُمَّ أَتى مَحَلَّةَ الأَنصارِ", "ajuz": "في عُصبَةٍ مِن قَومِهِ خِيارِ" },
    { "n": 219,  "sadr": "أَوَّلُهُم صاحِبُهُ في الغارِ", "ajuz": "أَفضَلُ تِلكَ العُصبَةِ الأَبرارِ" },
    { "n": 220,  "sadr": "صِدّيقُها الصّادِقُ في مَقالِهِ", "ajuz": "المُحسِنُ المُجمِلُ في أَفعالِهِ" },
    { "n": 221,  "sadr": "وَذاكَ في شَهرِ رَبيعِ الأَوَّلِ", "ajuz": "لِلَيلَتَينِ بَعدَ عَشرٍ كُمَّلِ" },
    { "n": 222,  "sadr": "فَسُرَّتِ الأَنصارُ بِالمُهاجِرَة", "ajuz": "وَكُلُّهُم يُؤثِرُ دارَ الآخِرَة" },
    { "n": 223,  "sadr": "وَاحتَشَدَت لِحَربِهِ القَبائِلُ", "ajuz": "فَثَبَتَ الحَقُّ وَزالَ الباطِلُ" },
    { "n": 224,  "sadr": "فَلَم يَزَل في يَثرِبٍ مُهاجِرا", "ajuz": "عَشرَ سِنينَ غازِياً وَنافِرا" },
    { "n": 225,  "sadr": "حَتّى إِذا ما ظَهَرَ الإيمانُ", "ajuz": "وَخَضَعَت لِأَمرِهِ الأَوثانُ" },
    { "n": 226,  "sadr": "وَبَلَّغَ الرِّسالَةَ الرَّسولُ", "ajuz": "وَوَضَحَ التَّأويلُ وَالتَّنزيلُ" },
    { "n": 227,  "sadr": "وَعُرِفَ النّاسِخُ وَالمَنسوخُ", "ajuz": "وَكانَ مِن هِجرَتِهِ التّاريخُ" },
    { "n": 228,  "sadr": "دَعا مَنِ اِجتَباهُ فَاستَجابا", "ajuz": "مِن بَعدِ ما اِختارَ لَهُ أَصحابا" },
    { "n": 229,  "sadr": "عَدَّلَهُم في مُحكَمِ الكِتابِ", "ajuz": "لِعَبدِهِ وَلِذَوي الأَلبابِ" },
    { "n": 230,  "sadr": "قامَ أَبو بَكرِ الَّذي وَلّاهُ", "ajuz": "أَمرَ صَلاةِ النّاسِ وَارتَضاهُ" },
    { "n": 231,  "sadr": "فَعاشَ حَولَينِ وَعاشَ أَشهُرا", "ajuz": "ثَلاثَةً تَزيدُ ثُلثاً أَوفَرا" },
    { "n": 232,  "sadr": "وَماتَ في شَهرِ جُمادى الآخِرَة", "ajuz": "يَومَ الثُّلاثاءِ لِسَبعٍ غابِرَة" },
    { "n": 233,  "sadr": "وَكانَتِ الرِّدَّةُ في أَيّامِهِ", "ajuz": "فَصَلَحَ النَّقضُ عَلى إِبرامِهِ" },
    { "n": 234,  "sadr": "وَقامَ مِن بَعدِ أَبي بَكرٍ عُمَر", "ajuz": "فَبَرَزَت أَيّامُهُ تِلكَ الغُرَر" },
    { "n": 235,  "sadr": "تَضَعضَعَت مِنهُ مُلوكُ فارِسِ", "ajuz": "وَخَرَّتِ الرّومُ عَلى المَعاطِسِ" },
    { "n": 236,  "sadr": "أَسلَمَ كِسرى فارِسٍ إيوانَهُ", "ajuz": "وَأَصبَحَت مَفروسَةً فُرسانُهُ" },
    { "n": 237,  "sadr": "وَأَجلَتِ الرّومُ عَنِ الشَّآمِ", "ajuz": "وَأَدبَرَت مَخافَةَ الإِسلامِ" },
    { "n": 238,  "sadr": "وَدانَتِ الأَقطارُ لِلفاروقِ", "ajuz": "وَاتَّسَعَت عَلَيهِ بَعدَ الضّيقِ" },
    { "n": 239,  "sadr": "وَوَهَبَ اللَّهُ لَهُ الشَّهادَة", "ajuz": "خاتِمَةً دَلَّت عَلى السَّعادَة" },
    { "n": 240,  "sadr": "وَذاكَ مِن بَعدِ سِنينَ عَشرِ", "ajuz": "وَشَطرِ حَولٍ يا لَهُ مِن شَطرِ" },
    { "n": 241,  "sadr": "وَقامَ عُثمانُ اِبنُ عَفّانَ الرِّضا", "ajuz": "بِالأَمرِ ثِنتَي عَشرَةً ثُمَّ مَضى" },
    { "n": 242,  "sadr": "مُستَشهَداً عَلى طَريقِ الحَقِّ", "ajuz": "لَم يَثنِهِ عَنهُ بَناتُ الطُّرقِ" },
    { "n": 243,  "sadr": "وَفَوَّضَ الأَمرَ إِلى عَلِيِّ", "ajuz": "الهاشِمِيِّ الفاضِلِ الزَّكِيِّ" },
    { "n": 244,  "sadr": "فَقامَ بِالأَمرِ سِنينَ أَربَعا", "ajuz": "وَتِسعَةً مِنَ الشُّهورِ شُرَّعا" },
    { "n": 245,  "sadr": "ثُمَّ مَضى مُستَشهَداً مَحمودا", "ajuz": "عاشَ حَميداً وَمَضى مَفقودا" },
    { "n": 246,  "sadr": "وَكانَ هَذا عامَ أَربَعينا", "ajuz": "مِنها اِنقَضَت مِن عِدَّةِ السِّنينا" },
    { "n": 247,  "sadr": "وَانتَقَلَ الأَمرُ عَنِ المَدينَة", "ajuz": "وَكانَ حَقّاً ما رَوى سَفينَة" },
    { "n": 248,  "sadr": "عَنِ النَّبِيِّ في وُلاةِ الأُمَّة", "ajuz": "مِنَ المُلوكِ وَمِنَ الأَئِمَّة" },
    { "n": 249,  "sadr": "ثُمَّ تَوَلّى أَمرَهُم مُعاوِيَة", "ajuz": "فَعاشَ عَشراً بَعدَ عَشرٍ خالِيَة" },
    { "n": 250,  "sadr": "حَتّى إِذا أَوفاهُمُ عِشرينا", "ajuz": "ماتَ مِنَ التّاريخِ في سِتّينا" },
    { "n": 251,  "sadr": "وَمَلَكَ الأَمرَ اِبنُهُ يَزيدُ", "ajuz": "لا حازِمُ الرَّأيِ وَلا رَشيدُ" },
    { "n": 252,  "sadr": "وَقُتِلَ الحُسَينُ في زَمانِهِ", "ajuz": "أَعوذُ بِالرَّحمَنِ مِن خِذلانِهِ" },
    { "n": 253,  "sadr": "وَإِنَّما عاشَ ثَلاثَ حِجَجِ", "ajuz": "وَأَشهُراً مِن بَعدِ حَملِ المَخرَجِ" },
    { "n": 254,  "sadr": "ثُمَّ اِبنُهُ مُعَيَّةُ المُضَعَّفُ", "ajuz": "كانَ لَهُ دينٌ وَعَقلٌ يُعرَفُ" },
    { "n": 255,  "sadr": "فَدامَ شَهراً ثُمَّ نِصفَ شَهرِ", "ajuz": "وَجاءَهُ المَوتُ عَزيزَ الأَمرِ" },
    { "n": 256,  "sadr": "وَتَرَكَ النّاسَ بِغَيرِ عَهدِ", "ajuz": "تَوَقِّياً مِنهُ وَفَضلَ زُهدِ" },
    { "n": 257,  "sadr": "وَفَوَّضَ الأَمرَ إِلى مَروانِ", "ajuz": "بَعدَ يَزيدَ وَهوَ شَيخٌ فانِ" },
    { "n": 258,  "sadr": "فَقَتَلَ الضَّحّاكَ في ذي القَعدَة", "ajuz": "بِراهِطٍ ثُمَّ اِستَمالَ جُندَه" },
    { "n": 259,  "sadr": "وَلَم يَعِش إِلّا شُهوراً عَشرَة", "ajuz": "وَلَيسَ شَيءٌ يَتَعَدّى قَدرَه" },
    { "n": 260,  "sadr": "وَلَم يَزَل إِبنُ الزُّبَيرِ بَعدَهُ", "ajuz": "تِسعَ سِنينَ لَيسَ يَألو جُهدَهُ" },
    { "n": 261,  "sadr": "مُعتَصِماً بِالكَعبَةِ الحَرامِ", "ajuz": "مُمتَنِعاً مِن أُمَراءِ الشّامِ" },
    { "n": 262,  "sadr": "حَتّى تَوَلّى قَتلَهُ الحَجّاجُ", "ajuz": "مِن بَعدِ ما ضاقَت بِهِ الفِجاجُ" },
    { "n": 263,  "sadr": "وَكانَ هَدمُ الكَعبَةِ المَصونَة", "ajuz": "وَوَقعَةُ الحَرَّةِ بِالمَدينَة" },
    { "n": 264,  "sadr": "وَقامَ عَبدُ المَلِكِ اِبنُ مَروان", "ajuz": "مُستَنهِضاً لِلحَربِ غَيرَ وَسنان" },
    { "n": 265,  "sadr": "حَتّى إِذا دانَت لَهُ الآفاقُ", "ajuz": "وَأَقفَرَت مِن مُصعَبَ العِراقُ" },
    { "n": 266,  "sadr": "وَمِن أَخيهِ البَلَدُ الحَرامُ", "ajuz": "وَخافَ مِن سَطوَتِهِ الأَنامُ" },
    { "n": 267,  "sadr": "ماتَ وَقَد عاشَ ثَلاثَ عَشرَة", "ajuz": "وَأَشهُراً أَربَعَةً بِالإِمرَة" },
    { "n": 268,  "sadr": "وَمَلَكَ النّاسَ اِبنُهُ الوَليدُ", "ajuz": "وَعِندَهُ الأَموالُ وَالجُنودُ" },
    { "n": 269,  "sadr": "سَبعَ سِنينَ بَعدَها ثَمانِيَة", "ajuz": "كامِلَةً مِنَ الشُّهورِ وافِيَة" },
    { "n": 270,  "sadr": "ثُمَّ سُلَيمانُ اِبنُ عَبدِ المَلِكِ", "ajuz": "اُختيرَ لِلعَهدِ وَلَمّا يُترَكِ" },
    { "n": 271,  "sadr": "فَعاشَ حَولَينِ وَثُلثَي حَولِ", "ajuz": "ثُمَّ أَتى دابِقَ مُرخى الذَّيلِ" },
    { "n": 272,  "sadr": "فَماتَ وَاستَولى عَلى الأَمرِ عُمَر", "ajuz": "بِسيرَةٍ مَحمودَةٍ بَينَ السِّيَر" },
    { "n": 273,  "sadr": "فَعاشَ عامَينِ وَنِصفَ عامِ", "ajuz": "بِدَيرِ سِمعانَ سِوى الأَيّامِ" },
    { "n": 274,  "sadr": "ثُمَّ تَوَلّى أَمرَهُم يَزيدُ", "ajuz": "وَاللَّهُ فَعّالٌ لِما يُريدُ" },
    { "n": 275,  "sadr": "وَهُوَ مِن أَولادِ عَبدِ المَلِكِ", "ajuz": "ثالِثُهُم في عَهدِهِ المُشتَرَكِ" },
    { "n": 276,  "sadr": "فَعاشَ حَولَينِ إِلى حَولَينِ", "ajuz": "تَزيدُ أَشهُراً قَريرَ العَينِ" },
    { "n": 277,  "sadr": "ثُمَّ تَوَلّى بَعدَهُ هِشامُ", "ajuz": "أَخوهُ فَامتَدَّت لَهُ الأَيّامُ" },
    { "n": 278,  "sadr": "فَلَم يَزَل عِشرينَ عاماً والِيا", "ajuz": "إِلّا شُهوراً خَمسَةً بَواقِيا" },
    { "n": 279,  "sadr": "ثُمَّ الوَليدُ اِبنُ يَزيدَ الغافِلُ", "ajuz": "تَعاوَرَتهُ الأُسُدُ البَواسِلُ" },
    { "n": 280,  "sadr": "مِن بَعدِ شَهرَينِ وَبَعدِ عامِ", "ajuz": "وَبَعدِ عِشرينَ مِنَ الأَيّامِ" },
    { "n": 281,  "sadr": "وَنَصَبَ الحَربَ لَهُ اِبنُ عَمِّهِ", "ajuz": "مُستَنكِراً سيرَتَهُ بِزَعمِهِ" },
    { "n": 282,  "sadr": "فَقُتِلَ الوَليدُ بِالبَخراءِ", "ajuz": "مِن بَعدِ أَن أَثخَنَ بِالأَعداءِ" },
    { "n": 283,  "sadr": "ثُمَّ يَزيدُ اِبنُ الوَليدِ النّاقِصُ", "ajuz": "عافَصَهُ الحَينُ الَّذي يُعافِصُ" },
    { "n": 284,  "sadr": "فَلَم يَعِش إِلّا شُهوراً سِتَّة", "ajuz": "حَتّى أَزالَتهُ المَنايا بَغتَة" },
    { "n": 285,  "sadr": "وَبايَعوا مَروانَ أَجمَعينا", "ajuz": "فَكانَ حِصناً لَهُمُ حَصينا" },
    { "n": 286,  "sadr": "وَلَم يَزَل خَمسَ سِنينَ وافِيَة", "ajuz": "يَملِكُهُم وَأَشهُراً ثَمانِيَة" },
    { "n": 287,  "sadr": "حَتّى أَتى اللَّهُ وَلِيُّ النِّعمَة", "ajuz": "بِالحَقِّ مِنهُ رَأفَةً وَرَحمَة" },
    { "n": 288,  "sadr": "وَاختارَ لِلنّاسِ أَبا العَبّاسِ", "ajuz": "مِن أَنجَدِ النّاسِ خِيارِ النّاسِ" },
    { "n": 289,  "sadr": "آلِ النَّبِيِّ مِن بَني العَبّاسِ", "ajuz": "أَئِمَّةٍ أَفاضِلٍ أَكياسِ" },
    { "n": 290,  "sadr": "فَعادَ نَصلُ المُلكِ في قِرابِهِ", "ajuz": "وَرَجَعَ الحَقُّ إِلى أَصحابِهِ" },
    { "n": 291,  "sadr": "ثُمَّ رَقى المِنبَرَ يَومَ الجُمعَة", "ajuz": "في مَسجِدِ الكوفَةِ يُذري دَمعَه" },
    { "n": 292,  "sadr": "فَقامَ في الدّينِ قِيامَ مِثلِهِ", "ajuz": "بِرَأيِهِ المَيمونِ حَسبَ فِعلِهِ" },
    { "n": 293,  "sadr": "وَماتَ بَعدَ أَربَعٍ كَوامِلِ", "ajuz": "وَسَبعَةٍ مِن أَشهُرٍ فَواضِلِ" },
    { "n": 294,  "sadr": "وَقامَ بِالخِلافَةِ المَنصورُ", "ajuz": "فَاستَوسَقَت بِعَزمِهِ الأُمورُ" },
    { "n": 295,  "sadr": "فَعاشَ ثِنتَينِ وَعِشرينَ سَنَة", "ajuz": "يَحمي حِمى المُلكِ وَيُفني الخَوَنَة" },
    { "n": 296,  "sadr": "حَتّى تُوُفّي مُحرِماً بِمَكَّة", "ajuz": "فَوَرِثَ المَهدِيُّ عَنهُ مُلكَه" },
    { "n": 297,  "sadr": "فَعاشَ عَشرَ حِجَجٍ وَشَهرا", "ajuz": "وَنِصفَ شَهرٍ ثُمَّ زارَ القَبرا" },
    { "n": 298,  "sadr": "وَاستَخلَفَ الهادِيَ موسى بَعدَهُ", "ajuz": "وَكانَ قَد وَلّاهُ قَبلُ عَهدَهُ" },
    { "n": 299,  "sadr": "وَعاشَ موسى سَنَةً وَشَهرَين", "ajuz": "تَنقُصُ يَوماً واحِداً أَوِ اِثنَين" },
    { "n": 300,  "sadr": "وَقامَ بِالخِلافَةِ الرَّشيدُ", "ajuz": "المَلِكُ المُمَنَّعُ السَّعيدُ" },
    { "n": 301,  "sadr": "فَعاشَ عِشرينَ وَوَفّى عَدَّها", "ajuz": "وَعاشَ عامَينِ وَعاماً بَعدَها" },
    { "n": 302,  "sadr": "وَنِصفَ شَهرٍ ثُمَّ وافاهُ الأَجَل", "ajuz": "بِطوسَ يَومَ السَّبتِ فَانهَدَّ الجَبَل" },
    { "n": 303,  "sadr": "وَبايَعوا مُحَمَّدَ الأَمينا", "ajuz": "وَنَكَثوا البَيعَةَ أَجمَعينا" },
    { "n": 304,  "sadr": "إِلّا قَليلاً وَالقَليلُ أَحمَدُ", "ajuz": "وَالمَوتُ لِلنّاسِ جَميعاً مَوعِدُ" },
    { "n": 305,  "sadr": "فَأَمَّنوهُ ثُمَّ قاتَلوهُ", "ajuz": "ما هَكَذا عاهَدَهُم أَبوهُ" },
    { "n": 306,  "sadr": "ما عاشَ إِلّا أَربَعاً وَأَشهُرا", "ajuz": "حَتّى تَهادَوا رَأسَهُ مُعَفَّرا" },
    { "n": 307,  "sadr": "وَبايَعوا المَأمونَ عَبدَ اللَّهِ", "ajuz": "فَبايَعوا يَقظانَ غَيرَ ساهِ" },
    { "n": 308,  "sadr": "وَفّاهُمُ خِلافَةَ المَنصورِ", "ajuz": "في عَدَدِ السِّنينَ وَالشُّهورِ" },
    { "n": 309,  "sadr": "ثُمَّ أَتى الرّومَ فَماتَ غازِيا", "ajuz": "كانَ البَذَندونُ المَحَلَّ القاصِيا" },
    { "n": 310,  "sadr": "وَقُلِّدَ الأَمرَ أَبو إِسحاقِ", "ajuz": "فَانقَضَّ كَالصَّقرِ عَلى العِراقِ" },
    { "n": 311,  "sadr": "مُعتَصِماً بِاللَّهِ غَيرَ غافِلِ", "ajuz": "فَأَيَّدَ الأَمرَ بِرَأيٍ فاضِلِ" },
    { "n": 312,  "sadr": "وَقامَ فيهِم حِجَجاً ثَمانِيَة", "ajuz": "وَمِثلَها مِنَ الشُّهورِ باقِيَة" },
    { "n": 313,  "sadr": "وَنَحوَ عِشرينَ مِنَ الأَيّامِ", "ajuz": "وَخَمسَةً أَدنَتهُ لِلحِمامِ" },
    { "n": 314,  "sadr": "وَماتَ في شَهرِ رَبيعِ الأَوَّلِ", "ajuz": "وَعُمرُهُ خَمسونَ لَم يَستَكمِلِ" },
    { "n": 315,  "sadr": "فَبايَعوا مِن بَعدِهِ لِلواثِقِ", "ajuz": "وَكانَ ذاكَ بِالقَضاءِ السّابِقِ" },
    { "n": 316,  "sadr": "وَلَم يَزَل في بَسطَةٍ وَمَنعَة", "ajuz": "خَمسَ سِنينَ وَشُهوراً تِسعَة" },
    { "n": 317,  "sadr": "وَزادَ أَيّاماً عَلَيها خَمسَة", "ajuz": "مَعدودَةً ثُمَّ تَوارى رَمسَه" },
    { "n": 318,  "sadr": "وَبايَعَ النّاسُ الإِمامَ جَعفَرا", "ajuz": "خَليفَةَ اللَّهِ الأَغَرَّ الأَزهَرا" },
    { "n": 319,  "sadr": "بَعدَ ثَلاثينَ وَميتَي عامِ", "ajuz": "وَبَعدَ حَولَينِ سِوى أَيّامِ" },
    { "n": 320,  "sadr": "خَلَت مِنَ الهِجرَةِ في الحِسابِ", "ajuz": "في العَرَبِيِّ المُحكَمِ الصَّوابِ" },
    { "n": 321,  "sadr": "لِسِتَّةٍ بَقينَ مِن ذي الحِجَّة", "ajuz": "فَأَوضَحَ السَّبيلَ وَالمَحَجَّة" },
    { "n": 322,  "sadr": "وَقامَ في النّاسِ لَهُم خَليفَة", "ajuz": "خِلافَةً مُنيفَةً شَريفَة" },
    { "n": 323,  "sadr": "قَد سَكَّنَ اللَّهُ بِهِ الأَطرافا", "ajuz": "فَما تَرى في مُلكِهِ خِلافا" },
    { "n": 324,  "sadr": "أَقامَ عَشراً ثُمَّ خَمساً بَعدَها", "ajuz": "مِنَ السِّنينَ فَأَبانَ مَجدَها" },
    { "n": 325,  "sadr": "ثُمَّ تَوَلّى قَتلَهُ الفَراغِنَة", "ajuz": "وَساعَدَتهُم عُصبَةٌ فَراعِنَة" },
    { "n": 326,  "sadr": "لِأَربَعٍ خَلَونَ مِن شَوّالِ", "ajuz": "فَأَصبَحَ المُلكُ أَخا اِختِلالِ" },
    { "n": 327,  "sadr": "وَبايَعوا مِن بَعدِهِ لِلمُنتَصِر", "ajuz": "فَأَصبَحَ الرّابِحُ مِنهُم قَد خَسِر" },
    { "n": 328,  "sadr": "فَعاشَ في السُّلطانِ سِتَّةَ اَشهُر", "ajuz": "أَخرَجَهُم مِن مُلكِهِ وَالعَسكَر" },
    { "n": 329,  "sadr": "ثُمَّ أَتاهُ بَغتَةً حِمامُهُ", "ajuz": "سُبحانَ مَن يُعاجِلُ اِنتِقامُهُ" },
    { "n": 330,  "sadr": "فَانتَخَبَ اللَّهُ لَهُم إِماما", "ajuz": "يُؤَيِّدُ اللَّهُ بِهِ الإِسلاما" },
    { "n": 331,  "sadr": "وَبايَعوا بَعدَ الرِّضا لِأَحمَدِ", "ajuz": "المُستَعينِ بِالإِلَهِ الأَوحَدِ" },
    { "n": 332,  "sadr": "فَكانَ ثاني العَشرِ مِن وُلاتِها", "ajuz": "مِن آلِ عَبّاسٍ وَمِن حُماتِها" },
    { "n": 333,  "sadr": "فَنَحنُ في خِلافَةٍ مُبارَكَة", "ajuz": "خَلَت عَنِ الإِضرارِ وَالمُشارَكَة" },
    { "n": 334,  "sadr": "فَالحَمدُ لِلَّهِ عَلى إِنعامِهِ", "ajuz": "جَميعُ هَذا الأَمرِ مِن أَحكامِهِ" },
    { "n": 335,  "sadr": "ثُمَّ السَّلامُ أَوَّلاً وَآخِرا", "ajuz": "عَلى النَّبِيِّ باطِناً وَظاهِرا" }
  ]
}
