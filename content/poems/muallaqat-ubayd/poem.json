{
  "id": "muallaqat-ubayd",
  "poet": "ubayd-ibn-al-abras",
  "title": "مُعَلَّقَةُ عَبيدِ بنِ الأَبرَصِ",
  "meter": "basit",
  "rawiy": "ب",
  "abyat_in_full": 50,
  "added": "2026-11-24",
  "abyat": [
    {"n": 1, "sadr": "أَقفَرَ مِن أَهلِهِ مَلحوبُ", "ajuz": "فَالقُطَبِيّاتُ فَالذَّنوبُ"},
    {"n": 2, "sadr": "فَراكِسٌ فَثُعالِباتٌ", "ajuz": "فَذاتُ فِرقَينِ فَالقَليبُ"},
    {"n": 3, "sadr": "فَعَردَةٌ فَقَفا حِبِرٍّ", "ajuz": "لَيسَ بِها مِنهُمُ عَريبُ"},
    {"n": 4, "sadr": "أَن بُدِّلَت أَهلَها وُحوشاً", "ajuz": "وَغَيَّرَت حالَها الخُطوبُ"},
    {"n": 5, "sadr": "أَرضٌ تَوارَثُها شَعوبُ", "ajuz": "وَكُلُّ مَن حَلَّها مَحروبُ"},
    {"n": 6, "sadr": "عَيناكَ دَمعُهُما سَروبُ", "ajuz": "كَأَنَّ شَأنَيهِما شَعيبُ"},
    {"n": 7, "sadr": "واهِيَةٌ أَو مَعينٌ مُمعِنٌ", "ajuz": "مِن هَضبَةٍ دونَها لُهوبُ"},
    {"n": 8, "sadr": "أَو فَلَجٌ ما بِبَطنِ وادٍ", "ajuz": "لِلماءِ مِن تَحتِهِ سُكوبُ"},
    {"n": 9, "sadr": "أَو جَدوَلٌ في ظِلالِ نَخلٍ", "ajuz": "لِلماءِ مِن بَينِهِ قَسيبُ"},
    {"n": 10, "sadr": "تَصبو وَأَنّى لَكَ التَّصابي", "ajuz": "أَنّى وَقَد راعَكَ المَشيبُ"},
    {"n": 11, "sadr": "إِن يَكُ حُوِّلَ مِنها أَهلُها", "ajuz": "فَلا بَديءٌ وَلا عَجيبُ"},
    {"n": 12, "sadr": "أَو يَكُ أَقفَرَ مِنها جَوُّها", "ajuz": "وَعادَها المَحلُ وَالجُدوبُ"},
    {"n": 13, "sadr": "فَكُلُّ ذي نِعمَةٍ مَخلوسٌ", "ajuz": "وَكُلُّ ذي أَمَلٍ مَكذوبُ"},
    {"n": 14, "sadr": "وَكُلُّ ذي إِبِلٍ مَوروثٌ", "ajuz": "وَكُلُّ ذي سَلَبٍ مَسلوبُ"},
    {"n": 15, "sadr": "وَكُلُّ ذي غَيبَةٍ يَؤوبُ", "ajuz": "وَغائِبُ المَوتِ لا يَؤوبُ"},
    {"n": 16, "sadr": "أَعاقِرٌ مِثلُ ذاتِ رِحمٍ", "ajuz": "أَم غانِمٌ مِثلُ مَن يَخيبُ"},
    {"n": 17, "sadr": "أَفلِح بِما شِئتَ قَد يُبلَغُ", "ajuz": "بِالضَّعفِ وَقَد يُخدَعُ الأَريبُ"},
    {"n": 18, "sadr": "لا يَنفَعُ اللُّبُّ عَن تَعَلُّمٍ", "ajuz": "إِلّا السَّجِيّاتُ وَالقُلوبُ"},
    {"n": 19, "sadr": "فَقَد يَعودَن حَبيباً شانِئٌ", "ajuz": "وَيَرجِعَن شانِئاً حَبيبُ"},
    {"n": 20, "sadr": "ساعِد بِأَرضٍ إِذا كُنتَ بِها", "ajuz": "وَلا تَقُل إِنَّني غَريبُ"},
    {"n": 21, "sadr": "قَد يوصَلُ النّازِحُ النّائي وَقَد", "ajuz": "يُقطَعُ ذو السُّهمَةِ القَريبُ"},
    {"n": 22, "sadr": "مَن يَسأَلِ النّاسَ يَحرِموهُ", "ajuz": "وَسائِلُ اللَّهِ لا يَخيبُ"},
    {"n": 23, "sadr": "وَالمَرءُ ما عاشَ في تَكذيبٍ", "ajuz": "طولُ الحَياةِ لَهُ تَعذيبُ"},
    {"n": 24, "sadr": "بَل إِن أَكُن قَد عَلَتني ذُرأَةٌ", "ajuz": "وَالشَّيبُ شَينٌ لِمَن يَشيبُ"},
    {"n": 25, "sadr": "فَرُبَّ ماءٍ وَرَدتُ آجِنٍ", "ajuz": "سَبيلُهُ خائِفٌ جَديبُ"},
    {"n": 26, "sadr": "ريشُ الحَمامِ عَلى أَرجائِهِ", "ajuz": "لِلقَلبِ مِن خَوفِهِ وَجيبُ"},
    {"n": 27, "sadr": "هَبَطتُهُ غُدوَةً مُشيحاً", "ajuz": "وَصاحِبي بادِنٌ خَبوبُ"},
    {"n": 28, "sadr": "عَيرانَةٌ مُؤجَدٌ فَقارُها", "ajuz": "كَأَنَّ حارِكَها الكَثيبُ"},
    {"n": 29, "sadr": "أَخلَفَ ما بازِلاً سَديسُها", "ajuz": "لا حِقَّةٌ هِيَ وَلا نَيوبُ"},
    {"n": 30, "sadr": "كَأَنَّها مِن حَميرِ غابٍ", "ajuz": "جَونٌ بِصَفحَتِهِ نُدوبُ"},
    {"n": 31, "sadr": "أَو شَبَبٌ يَحفِرُ الرُّخامى", "ajuz": "تَلُفُّهُ شَمالٌ هَبوبُ"},
    {"n": 32, "sadr": "فَذاكَ عَصرٌ وَقَد أَراني", "ajuz": "تَحمِلُني نَهدَةٌ سُرحوبُ"},
    {"n": 33, "sadr": "مُضَبَّرٌ خَلقُها تَضبيراً", "ajuz": "يَنشَقُّ عَن وَجهِها السَّبيبُ"},
    {"n": 34, "sadr": "زَيتِيَّةٌ نائِمٌ عُروقُها", "ajuz": "وَلَيِّنٌ أَسرُها صَليبُ"},
    {"n": 35, "sadr": "كَأَنَّها لِقوَةٌ طَلوبٌ", "ajuz": "تَيبَسُ في وَكرِها القُلوبُ"},
    {"n": 36, "sadr": "بانَت عَلى إِرَمٍ عَذوباً", "ajuz": "كَأَنَّها شَيخَةٌ رَقوبُ"},
    {"n": 37, "sadr": "فَأَصبَحَت في غَداةِ قُرٍّ", "ajuz": "يَنحَطُّ عَن ريشِها الضَّريبُ"},
    {"n": 38, "sadr": "فَأَبصَرَت ثَعلَباً بَعيداً", "ajuz": "وَدونَهُ سَبسَبٌ جَديبُ"},
    {"n": 39, "sadr": "فَنَشَرَت ريشَها فَانتَفَضَت", "ajuz": "فَذاكَ مِن نَهضَةٍ قَريبُ"},
    {"n": 40, "sadr": "يَدِبُّ مِن حِسِّها دَبيباً", "ajuz": "وَالعَينُ حِملاقُها مَقلوبُ"},
    {"n": 41, "sadr": "فَنَهَضَت نَحوَهُ حَثيثَةً", "ajuz": "وَحَرَدَت حَردَهُ تَسيبُ"},
    {"n": 42, "sadr": "فَاشتالَ وَارتاعَ مِن خَشيَتِها", "ajuz": "وَفِعلَهُ يَفعَلُ المَزؤودُ"},
    {"n": 43, "sadr": "فَأَدرَكَتهُ فَخَوَّتَتهُ", "ajuz": "وَالصَّيدُ مِن تَحتِها مَكروبُ"},
    {"n": 44, "sadr": "فَجَدَّلَتهُ فَطَرَّحَتهُ", "ajuz": "فَكَدَّحَت وَجهَهُ الجَبوبُ"},
    {"n": 45, "sadr": "يَضغو وَمِخلَبُها في دَفِّهِ", "ajuz": "لا بُدَّ حَيزومُهُ مَنقوبُ"}
  ]
}
