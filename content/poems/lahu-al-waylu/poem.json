{
  "id": "lahu-al-waylu",
  "poet": "al-buhturi",
  "title": "لَهُ الوَيلُ مِن لَيلٍ تَطاوَلَ آخِرُه",
  "meter": "tawil",
  "rawiy": "ر",
  "abyat_in_full": 45,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "لَهُ الوَيلُ مِن لَيلٍ تَطاوَلَ آخِرُه",
      "ajuz": "وَوَشكِ نَوى حَيٍّ تُزَمُّ أَباعِرُه"
    },
    {
      "n": 2,
      "sadr": "إِذا كانَ وِردُ الدَّمعِ بِالنَّأيِ أَعوَزَت",
      "ajuz": "بِغَيرِ تَداني الحِلَّتَينِ مَصادِرُه"
    },
    {
      "n": 3,
      "sadr": "أَدارَهُمُ الأولى بِدارَةِ جُلجُلٍ",
      "ajuz": "سَقاكِ الحَيا رَوحاتُهُ وَبَواكِرُه"
    },
    {
      "n": 4,
      "sadr": "وَجاءَكِ يَحكي يوسُفَ بنَ مُحَمَّدٍ",
      "ajuz": "فَرَوَّتكِ رَيّاهُ وَجادَكِ ماطِرُه"
    },
    {
      "n": 5,
      "sadr": "عَلى أَنَّهُ لَو شاءَ رَبعُكِ بَيَّنَت",
      "ajuz": "مَعالِمُهُ لِلصَّبِّ أَينَ تُماضِرُه"
    },
    {
      "n": 6,
      "sadr": "وَإِنّي لَثانٍ مِن عِناني فَسائِلٌ",
      "ajuz": "جَآذِرُهُ أَينَ اِستَقَرَّت جَآذِرُه"
    },
    {
      "n": 7,
      "sadr": "تَقَضّى الصِّبا إِلّا خَيالاً يَعودُني",
      "ajuz": "بِهِ ذو دَلالٍ أَحوَرُ الطَّرفِ فاتِرُه"
    },
    {
      "n": 8,
      "sadr": "يَجوبُ سَوادَ اللَّيلِ مِن عِندِ مُرهَفٍ",
      "ajuz": "ضَعيفِ قَوامِ الخَصرِ سودٍ غَدائِرُه"
    },
    {
      "n": 9,
      "sadr": "فَيُذكِرُني العَهدَ القَديمَ وَلَيلَةً",
      "ajuz": "لَدى سَمُراتِ الجِزعِ إِذ نامَ سامِرُه"
    },
    {
      "n": 10,
      "sadr": "وَعَهداً أَبَينا فيهِ إِلّا تَبايُناً",
      "ajuz": "فَلا أَنا ناسيهِ وَلا هُوَ ذاكِرُه"
    },
    {
      "n": 11,
      "sadr": "رَأَيتُ أَبا يَعقوبَ وَالنّاسُ ذو حِجاً",
      "ajuz": "يُؤَمِّلُهُ أَو ذو ضَلالِ يُحاذِرُه"
    },
    {
      "n": 12,
      "sadr": "هُوَ المَلِكُ المَرجُوُّ لِلدّينِ وَالعُلا",
      "ajuz": "فَلِلَّهِ تَقواهُ وَلِلمَجدِ سائِرُه"
    },
    {
      "n": 13,
      "sadr": "لَهُ البَأسُ يُخشى وَالسَّماحَةُ تُرتَجى",
      "ajuz": "فَلا الغَيثُ ثانيهِ وَلا اللَّيثُ عاشِرُه"
    },
    {
      "n": 14,
      "sadr": "وَقورُ النَّواحي وَالنَّدى يَستَخِفُّهُ",
      "ajuz": "لَنا وَأَميرُ الشَّرقِ وَالجودُ آمِرُه"
    },
    {
      "n": 15,
      "sadr": "إِذا وَقَعَت بِالقُربِ مِنهُ مُلِمَّةٌ",
      "ajuz": "ثَنى طَرفَهُ نَحوَ الحُسامِ يُشاوِرُه"
    },
    {
      "n": 16,
      "sadr": "إِذا خَرِسَ الأَبطالُ في حَمَسِ الوَغى",
      "ajuz": "عَلَت فَوقَ أَصواتِ الحَديدِ زَماجِرُه"
    },
    {
      "n": 17,
      "sadr": "إِذا التَّهَبَت في لَحظِ عَينَيهِ غَضبَةٌ",
      "ajuz": "رَأَيتَ المَنايا في النُّفوسِ تُؤامِرُه"
    },
    {
      "n": 18,
      "sadr": "وَلا عِزَّ لِلإِشراكِ مِن بَعدِ ما التَّقَت",
      "ajuz": "عَلى السَّفحِ مِن عُليا طَرونَ عَساكِرُه"
    },
    {
      "n": 19,
      "sadr": "وَلَيسَ بِهِ أَلّا يَكونَ مَرامُها",
      "ajuz": "عَسيراً وَلَكِن أَسلَمَ الغابَ خادِرُه"
    },
    {
      "n": 20,
      "sadr": "وَما كانَ بُقراطُ بنُ آشوطَ عِندَهُ",
      "ajuz": "بِأَوَّلِ عَبدٍ أَوبَقَتهُ جَرائِرُه"
    },
    {
      "n": 21,
      "sadr": "وَقَد شاغَبَ الإِسلامَ خَمسينَ حِجَّةً",
      "ajuz": "فَلا الخَوفُ ناهيهِ وَلا الحِلمُ زاجِرُه"
    },
    {
      "n": 22,
      "sadr": "وَلَمّا اِلتَقى الجَمعانِ لَم تَجتَمِع لَهُ",
      "ajuz": "يَداهُ وَلَم يَثبُت عَلى البيضِ ناظِرُه"
    },
    {
      "n": 23,
      "sadr": "وَلَم يَرضَ مِن جُرزانَ حِرزاً يُجيرُهُ",
      "ajuz": "وَلا في جِبالِ الرّومِ رَيداً يُجاوِرُه"
    },
    {
      "n": 24,
      "sadr": "فَجاءَ مَجيءَ العَيرِ قادَتهُ حَيرَةٌ",
      "ajuz": "إِلى أَهرَتِ الشِّدقَينِ تَدمى أَظافِرُه"
    },
    {
      "n": 25,
      "sadr": "وَمَن كانَ في اِستِسلامِهِ لائِماً لَهُ",
      "ajuz": "فَإِنّي عَلى ما كانَ مِن ذاكَ عاذِرُه"
    },
    {
      "n": 26,
      "sadr": "وَكَيفَ يَفوتُ اللَّيثَ في قيدِ لَحظَةٍ",
      "ajuz": "وَكانَ عَلى شَهرَينِ وَهوَ مُحاصِرُه"
    },
    {
      "n": 27,
      "sadr": "تَضَمَّنَهُ ثِقلُ الحَديدِ فَأُحكِمَت",
      "ajuz": "خَلاخِلُهُ مِن صَوغِهِ وَأَساوِرُه"
    },
    {
      "n": 28,
      "sadr": "فَإِن أَدرَكَتهُ بِالعِراقِ مَنِيَّةٌ",
      "ajuz": "فَقاتِلُهُ عِندَ الخَليفَةِ آسِرُه"
    },
    {
      "n": 29,
      "sadr": "بِتَدبيرِكَ المَيمونِ أُغلِقَ كَيدُهُ",
      "ajuz": "عَلَيهِ وَكَلَّت سُمرُهُ وَبَواتِرُه"
    },
    {
      "n": 30,
      "sadr": "وَطَيِّكَ سِرّاً لَو تَكَلَّفَ طَيَّهُ",
      "ajuz": "دُجى اللَّيلِ عَنّا لَم تَسَعهُ ضَمائِرُه"
    },
    {
      "n": 31,
      "sadr": "وَلَم يَبقَ بِطريقٌ لَهُ مِثلُ جُرمِهِ",
      "ajuz": "بِأَرّانَ إِلّا عازِبُ اللُّبِّ طائِرُه"
    },
    {
      "n": 32,
      "sadr": "كَسَرتَهُمُ كَسرَ الزُّجاجَةِ بَعدَهُ",
      "ajuz": "وَمَن يَجبُرُ الوَهى الَّذي أَنتَ كاسِرُه"
    },
    {
      "n": 33,
      "sadr": "فَإِن يَكُ هَذا أَوَّلُ النَّقصِ فيهِمُ",
      "ajuz": "وَكُنتَ لَهُم جاراً فَما هُوَ آخِرُه"
    },
    {
      "n": 34,
      "sadr": "وَما مُسلِمُ الثَّغرِ المُعانِدُ رَبَّهُ",
      "ajuz": "بِناءٍ عَنِ الكَأسِ الَّتي اِشتَفَّ كافِرُه"
    },
    {
      "n": 35,
      "sadr": "وَقَد عَلِمَ العاصي وَإِن أَمعَنَت بِهِ",
      "ajuz": "مَحَلَّتُهُ في الأَرضِ أَنَّكَ زائِرُه"
    },
    {
      "n": 36,
      "sadr": "حُسامٌ وَعَزمٌ كَالحُسامِ وَجَحفَلٌ",
      "ajuz": "شِدادٌ قُواهُ مُحصَداتٌ مَرائِرُه"
    },
    {
      "n": 37,
      "sadr": "قَليلُ فُضولِ الزّادِ إِلّا صَواهِلاً",
      "ajuz": "ظَهارِيَّ طَعنٍ أَو حَديداً يُظاهِرُه"
    },
    {
      "n": 38,
      "sadr": "إِذا اِنبَثَّ في عَرضِ الفَضاءِ فَمَذحِجٌ",
      "ajuz": "مَيامِنُهُ وَالحَيُّ قَيسٌ مَياسِرُه"
    },
    {
      "n": 39,
      "sadr": "تَهولُ الصُّدورَ الهائِلاتِ سُلَيمُهُ",
      "ajuz": "وَأَعصُرُهُ في السّابِغاتِ وَعامِرُه"
    },
    {
      "n": 40,
      "sadr": "أَمَعشَرَ قَيسٍ قَيسِ عَيلانَ إِنَّكُم",
      "ajuz": "حُماةُ الوَغى يَومَ الوَغى وَمَساعِرُه"
    },
    {
      "n": 41,
      "sadr": "عَجِلتُم إِلى نَصرِ الأَميرِ وَلَم يَزَل",
      "ajuz": "يُوالي مَواليهِ وَيُنصَرُ ناصِرُه"
    },
    {
      "n": 42,
      "sadr": "وَإِن يَكثُرِ الإِحسانُ مِنكُم فَإِنَّهُ",
      "ajuz": "بِأَنعُمِهِ جازٍ عَلَيهِ وَشاكِرُه"
    },
    {
      "n": 43,
      "sadr": "غَدا قِسمَةً عَدلاً فَفيكُم نَوالُهُ",
      "ajuz": "وَفي سَروِ نَبهانَ بنِ عَمرٍو مَآثِرُه"
    },
    {
      "n": 44,
      "sadr": "وَلا عَجَبٌ أَن تَشهَدوا الطَّعنَ دونَهُ",
      "ajuz": "وَما عَشَرَتكُم في نَداهُ عَشائِرُه"
    },
    {
      "n": 45,
      "sadr": "وَلَو لَم تَكُن إِلّا مَساعيكُمُ الَّتي",
      "ajuz": "يَقومُ بِها بَينَ السِّماطَينِ شاعِرُه"
    }
  ]
}
