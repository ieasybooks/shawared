{
  "id": "qad-akthara-al-nasu",
  "poet": "al-suyuti",
  "title": "قَد أَكثَرَ النّاسُ في المَنسوخِ مِن عَدَدٍ",
  "meter": "basit",
  "rawiy": "ر",
  "abyat_in_full": 10,
  "added": "2026-11-19",
  "abyat": [
    {
      "n": 1,
      "sadr": "قَد أَكثَرَ النّاسُ في المَنسوخِ مِن عَدَدٍ",
      "ajuz": "وَأَدخَلوا فيهِ آياً لَيسَ تَنحَصِرُ"
    },
    {
      "n": 2,
      "sadr": "وَهاكَ تَحريرَ آيٍ لا مَزيدَ لَها",
      "ajuz": "عِشرينَ حَرَّرَها الحُذّاقُ وَالكُبَرُ"
    },
    {
      "n": 3,
      "sadr": "آيُ التَّوَجُّهِ حَيثُ المَرءُ كانَ وَأَن",
      "ajuz": "يوصي لِأَهلِهِ عِندَ المَوتِ مُحتَضِرُ"
    },
    {
      "n": 4,
      "sadr": "وَحُرمَةُ الأَكلِ بَعدَ النَّومِ مَع رَفَثٍ",
      "ajuz": "وَفِديَةٌ لِمُطيقِ الصَّومِ مُشتَهِرُ"
    },
    {
      "n": 5,
      "sadr": "وَحَقُّ تَقواهُ فيما صَحَّ مِن أَثَرٍ",
      "ajuz": "وَفي الحَرامِ قِتالٌ لِلأُلى كَفَروا"
    },
    {
      "n": 6,
      "sadr": "وَالاِعتِدادُ بِحَولٍ مَع وَصِيَّتِها",
      "ajuz": "وَأَن يُدانَ حَديثُ النَّفسِ وَالفِكَرُ"
    },
    {
      "n": 7,
      "sadr": "وَالحِلفُ وَالحَبسُ لِلزّاني وَتَركُ أُولي",
      "ajuz": "كُفرٍ وَإِشهادُهُم وَالصَّبرُ وَالنَّفَرُ"
    },
    {
      "n": 8,
      "sadr": "وَمَنعُ عَقدٍ لِزانٍ أَو لِزانِيَةٍ",
      "ajuz": "وَما عَلى المُصطَفى في العَقدِ مُحتَظَرُ"
    },
    {
      "n": 9,
      "sadr": "وَدَفعُ مَهرٍ لِمَن جاءَت وَآيَةُ نَج",
      "ajuz": "واهُ كَذاكَ قِيامُ اللَّيلِ مُستَطَرُ"
    },
    {
      "n": 10,
      "sadr": "وَزيدَ آيَةُ الاِستِئذانِ مَن مَلَكَت",
      "ajuz": "وَآيَةُ القِسمَةِ الفُضلى لِمَن حَضَروا"
    }
  ]
}
