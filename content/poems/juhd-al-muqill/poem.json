{
  "id": "juhd-al-muqill",
  "poet": "abd-allah-al-salim-ibn-hanbal",
  "title": "جُهدُ المُقِلِّ",
  "meter": "rajaz",
  "abyat_in_full": 50,
  "added": "2026-11-19",
  "abyat": [
    {"n": 1, "sadr": "حَمداً لِمَن شَرَّفَ روحَ الحَقِّ", "ajuz": "بِحُسنِ خُلقِهِ وَحُسنِ الخَلقِ"},
    {"n": 2, "sadr": "صَلّى عَلَيهِ بارِئُ البَرايا", "ajuz": "مَن خَصَّهُ بِأَفضَلِ المَزايا"},
    {"n": 3, "sadr": "هَذا وَلَمّا فاتَنا مَرأى النَّبي", "ajuz": "وَكانَ أَسنى مَطلَبٍ وَمَرغَبِ"},
    {"n": 4, "sadr": "وَكانَ في نُعوتِهِ البَهِيَّه", "ajuz": "مَزِيَّةٌ أَعظِم بِها مَزِيَّه"},
    {"n": 5, "sadr": "قَد دَوَّنَ الحُفّاظُ مِنها جُمَلا", "ajuz": "جَليلَةً تَكسو الدَّراري خَجَلا"},
    {"n": 6, "sadr": "جَمَعتُها كَالجَوهَرِ المُنَظَّمِ", "ajuz": "بِرَسمِ خِدمَةِ الجَنابِ الأَعظَمِ"},
    {"n": 7, "sadr": "في رَجَزٍ سَمَّيتُهُ جُهدَ المُقِلِّ", "ajuz": "وَصُنتُهُ عَمّا يُخِلُّ أَو يُمِلُّ"},
    {"n": 8, "sadr": "فَقُلتُ ناقِلاً عَنِ الحُفّاظِ", "ajuz": "مُحافِظاً جُهدي عَلى الأَلفاظِ"},
    {"n": 9, "sadr": "قَد كانَ أَحسَنَ الوَرى وَأَجمَلا", "ajuz": "وَكانَ أَبهى صورَةً وَأَكمَلا"},
    {"n": 10, "sadr": "وَكانَ فَخماً بادِناً مُفَخَّما", "ajuz": "وَكانَ ضَربَ اللَّحمِ لا مُطَهَّما"},
    {"n": 11, "sadr": "وَلا مُكَلثَماً عَظيمَ الهامَه", "ajuz": "رَبعَةَ قَدٍّ في اِعتِدالِ القامَه"},
    {"n": 12, "sadr": "لا بائِناً مُشَذَّباً مُمَّغِطا", "ajuz": "وَلا قَصيراً مُتَرَدِّدَ الخُطا"},
    {"n": 13, "sadr": "وَمَعَ ذا يَطولُ مَن ماشاهُ", "ajuz": "إِذ لَيسَ يَعلوهُ الوَرى حاشاهُ"},
    {"n": 14, "sadr": "وَكانَ أَزهَرَ وَكانَ أَنوَرا", "ajuz": "أَبيَضَ مُشرَباً بِلَونٍ أَحمَرا"},
    {"n": 15, "sadr": "لَيسَ بِأَمهَقَ وَلا بِآدَمِ", "ajuz": "لِوَجهِهِ ضَوءٌ كَضَوءِ الجَيلَمِ"},
    {"n": 16, "sadr": "وَجهٌ كَما شِئتَ مِنِ اِستِدارَتِه", "ajuz": "يَطَّرِدُ الجَمالُ في أَسِرَّتِه"},
    {"n": 17, "sadr": "يَجري عَلى خَدَّيهِ ماءُ الذَّهَبِ", "ajuz": "عَرَقُهُ كَلُؤلُؤٍ مُلتَهِبِ"},
    {"n": 18, "sadr": "يُزري بَهاءُ وَجهِهِ الحُسّانِ", "ajuz": "بِالبَدرِ في لَيلَةِ إِضحيانِ"},
    {"n": 19, "sadr": "بَل لَو رَأَيتَهُ رَأَيتَ الشَّمسا", "ajuz": "طالِعَةً فَطِبتَ عَنها نَفسا"},
    {"n": 20, "sadr": "يَقولُ مَن يَنعَتُهُ في الجُملَه", "ajuz": "لَم أَرَ قَبلَهُ وَبَعدُ مِثلَه"},
    {"n": 21, "sadr": "يَهابُهُ بَديهَةً مَن أَبصَرَه", "ajuz": "يُحِبُّهُ الخَليطُ مَهما اِختَبَرَه"},
    {"n": 22, "sadr": "وَكانَ رَحبَ راحَةٍ سَبطَ العَصَبِ", "ajuz": "في وَجهِهِ عِرقٌ يُدِرُّهُ الغَضَبِ"},
    {"n": 23, "sadr": "أَليَنُ مِن مَسِّ الحَريرِ كَفُّهُ", "ajuz": "أَطيَبُ مِن شَذى الغَوالي عَرفُهُ"},
    {"n": 24, "sadr": "وَكانَ أَدعَجَ وَكانَ أَنجَلا", "ajuz": "أَهدَبَ أَبلَجَ أَزَجَّ أَشكَلا"},
    {"n": 25, "sadr": "أَفلَجَ أَشنَبَ ضَليعَ الفَمِ", "ajuz": "يَفتَرُّ عَن كَالبَرَدِ المُنهَمِّ"},
    {"n": 26, "sadr": "وَكانَ بَرّاقَ الثَّنايا مِنهُما", "ajuz": "يَخرُجُ كَالنّورِ إِذا تَكَلَّما"},
    {"n": 27, "sadr": "ضِحكُهُ تَبَسُّمٌ وَرُبَّما", "ajuz": "أَبدى نَواجِذَ كَدُرٍّ نُظِما"},
    {"n": 28, "sadr": "كانَ جَهيرَ الصَّوتِ فيهِ صَحَلُ", "ajuz": "وَنُطقُهُ مُبَيَّنٌ مُفَصَّلُ"},
    {"n": 29, "sadr": "وَخاتَمُ النُّبُوَّةِ اللَّذ كانَ لَه", "ajuz": "بِنُغضِ يُسراهُ كَزِرِّ الحَجَلَه"},
    {"n": 30, "sadr": "أَو مِثلُ جُمعٍ حَولَهُ خيلانُ", "ajuz": "مِثلُ الثَّآليلِ بِهِ تَزدانُ"},
    {"n": 31, "sadr": "وَكانَ ذا عَقيقَةٍ إِن تَنفَرِق", "ajuz": "فَرَقَها يَترُكُها إِن تَتَّفِق"},
    {"n": 32, "sadr": "شَعرُهُ مُغدَودِفٌ يُوَفِّرُهُ", "ajuz": "لِشَحمَةِ الأُذُنِ وَطَوراً يَضفِرُهُ"},
    {"n": 33, "sadr": "وَكانَ رَجِلاً غَيرَ جَعدٍ مُفرِطِ", "ajuz": "بَل كانَ بَينَ سَبِطٍ وَقَطَطِ"},
    {"n": 34, "sadr": "لَم يَبلُغِ العِشرينَ شَيبُ لِحيَتِه", "ajuz": "وَرَأسِهِ فَكانَ ذا مِن حِليَتِه"},
    {"n": 35, "sadr": "وَكانَ شَثنَ قَدَمٍ وَكَفِّ", "ajuz": "وَسائِلَ الأَطرافِ أَقنى الأَنفِ"},
    {"n": 36, "sadr": "وَواسِعَ الجَبينِ سَهلَ الخَدَّينِ", "ajuz": "شَبحَ الذِّراعَينِ طَويلَ الزَّندَينِ"},
    {"n": 37, "sadr": "كانَ عَريضَ الصَّدرِ كَثَّ اللِّحيَه", "ajuz": "عُنُقُهُ كَمِثلِ جيدِ دُميَه"},
    {"n": 38, "sadr": "ضَخمَ الكَراديسِ جَليلَ الكَتِدِ", "ajuz": "مَعَ المُشاشِ وَهوَ عَبلُ العَضُدِ"},
    {"n": 39, "sadr": "أَجرَدَ ذا مَسرُبَةٍ رَقيقَه", "ajuz": "وَعُكنَةٍ رائِقَةٍ أَنيقَه"},
    {"n": 40, "sadr": "بِمَنكِبَيهِ شَعَرٌ وَبِأَعا", "ajuz": "لي الصَّدرِ مِنهُ وَالذِّراعَينِ مَعا"},
    {"n": 41, "sadr": "كانَ مَسيحَ القَدَمَينِ يَنبو", "ajuz": "عَن قَدَمَيهِ الماءُ إِذ يُصَبُّ"},
    {"n": 42, "sadr": "خُمصانَ الأَخمَصَينِ ذا حُموشَه", "ajuz": "في ساقِهِ وَعَقِبٍ مَنهوشَه"},
    {"n": 43, "sadr": "يُقبِلُ مَهما يَلتَفِت جَميعا", "ajuz": "وَكانَ هَوناً مَشيُهُ ذَريعا"},
    {"n": 44, "sadr": "يَزولُ قَلعاً إِن مَشى وَيَخطو", "ajuz": "تَكَفُّؤاً كَأَنَّما يَنحَطُّ"},
    {"n": 45, "sadr": "مِن صَبَبٍ وَكانَ جُلُّ نَظَرِه", "ajuz": "لَحظاً وَمِن سيماهُ غَضُّ بَصَرِه"},
    {"n": 46, "sadr": "يُقَلِّبُ كَفَّيهِ إِذا هُوَ عَجِب", "ajuz": "بِها يُشيرُ وَيُشيحُ إِن غَضِب"},
    {"n": 47, "sadr": "وَيَستَنيرُ وَجهُهُ إِذا يُسَرُّ", "ajuz": "كَأَنَّهُ في الحُسنِ قِطعَةُ قَمَر"},
    {"n": 48, "sadr": "وَغالِباً يُكثِرُ مَسَّ لِحيَتِه", "ajuz": "عِندَ اِهتِمامِهِ بِأَمرِ أُمَّتِه"},
    {"n": 49, "sadr": "وَرُبَّما بِعودٍ أَو بِمِخصَرَه", "ajuz": "نَكَتَ في الأَرضِ لِسِرٍّ أَضمَرَه"},
    {"n": 50, "sadr": "يَجلِسُ حَيثُ مَجلِسٌ بِهِ اِنتَهى", "ajuz": "صَلّى عَلَيهِ رَبُّهُ بِلا اِنتِها"}
  ]
}
