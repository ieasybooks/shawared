{
  "id": "ihsa-al-asma-al-husna",
  "poet": "muhammad-ibn-farhan-al-fayfi",
  "title": "إِحصاءُ الأَسماءِ الحُسنى",
  "meter": "rajaz",
  "abyat_in_full": 30,
  "added": "2026-11-19",
  "abyat": [
    {"n": 1, "sadr": "لِلَّهِ مِن أَسمائِهِ تِسعونا", "ajuz": "وَتِسعَةٌ مِن بَعدِها يَتلونا"},
    {"n": 2, "sadr": "جَزاءُ مُحصيها دُخولُ الجَنَّةِ", "ajuz": "كَما رَواهُ في صَحيحِ السُّنَّةِ"},
    {"n": 3, "sadr": "أَبو هُرَيرَةَ عَنِ المُختارِ", "ajuz": "صَلّى عَلَيهِ اللَّهُ في الأَعصارِ"},
    {"n": 4, "sadr": "إِحصاؤُها في العَدِّ ثُمَّ الفَهمِ", "ajuz": "ثُمَّ الدُّعاءِ يا مُحِبَّ العِلمِ"},
    {"n": 5, "sadr": "يا اللَّهُ يا رَبُّ وَيا رَحمَنُ", "ajuz": "وَيا رَحيمُ سُؤلُنا الغُفرانُ"},
    {"n": 6, "sadr": "أَوَّلٌ آخِرٌ أَحَطتَ بِالزَّمانِ", "ajuz": "ظاهِرٌ باطِنٌ أَحَطتَ بِالمَكانِ"},
    {"n": 7, "sadr": "في الحَشرِ قُدّوسٌ سَلامٌ مُؤمِنٌ", "ajuz": "مُهَيمِنٌ إِنّي بِهِ لَمُؤمِنُ"},
    {"n": 8, "sadr": "جَبّارٌ وَهوَ المُتَكَبِّرُ اِعلَمِ", "ajuz": "وَبارِئٌ مُصَوِّرٌ في الرَّحِمِ"},
    {"n": 9, "sadr": "أَنتَ المَليكُ مالِكٌ وَمَلِكُ", "ajuz": "وَإِنَّني الفَقيرُ لا أَمتَلِكُ"},
    {"n": 10, "sadr": "أَنتَ القَديرُ قادِرٌ مُقتَدِرُ", "ajuz": "وَإِنَّني الضَّعيفُ لا أَنتَصِرُ"},
    {"n": 11, "sadr": "أَنتَ العَلِيُّ المُتَعالي الأَعلى", "ajuz": "وَإِنَّني العَبدُ الذَّليلُ المَولى"},
    {"n": 12, "sadr": "أَنتَ الكَريمُ الأَكرَمُ الرَّزّاقُ", "ajuz": "وَالرّازِقُ الخالِقُ وَالخَلّاقُ"},
    {"n": 13, "sadr": "أَنتَ الشَّكورُ الشّاكِرُ الغَفّارُ", "ajuz": "أَنتَ الغَفورُ القاهِرُ القَهّارُ"},
    {"n": 14, "sadr": "أَنتَ الحَكيمُ الحَكَمُ المَولى الوَلي", "ajuz": "والواحِدُ الأَحَدُ في شِبهٍ جَلي"},
    {"n": 15, "sadr": "الحَيُّ وَالقَيّومُ وَالحَقُّ المُبينُ", "ajuz": "وَهوَ السَّميعُ وَالبَصيرُ يا فَطينُ"},
    {"n": 16, "sadr": "وَهوَ اللَّطيفُ وَالخَبيرُ وَالحَميد", "ajuz": "مَعَ المَجيدِ وَالرَّقيبِ وَالشَّهيد"},
    {"n": 17, "sadr": "وَهوَ القَريبُ وَالمُجيبُ وَالقَوي", "ajuz": "مَعَ العَزيزِ غالِبُ كُلِّ قَوي"},
    {"n": 18, "sadr": "وَإِنَّهُ الفَتّاحُ وَالعَليمُ", "ajuz": "وَإِنَّهُ الغَنِيُّ وَالحَليمُ"},
    {"n": 19, "sadr": "في السُّنَّةِ الحَيِيُّ وَالسَّتيرُ", "ajuz": "تَمَّ اِقتِرانُ اِسمَينِ يا نِحريرُ"},
    {"n": 20, "sadr": "أَمّا الَّتي تَقابَلَت فَأَربَعَه", "ajuz": "مُقَدِّمٌ مُؤَخِّرٌ يَأتي مَعَه"},
    {"n": 21, "sadr": "كَذَينِ أَيضاً قابِضٌ وَباسِطُ", "ajuz": "وَكُلُّها في سُنَّةٍ يا ضابِطُ"},
    {"n": 22, "sadr": "وَما بَقي مِنَ الأَسامي اِنفَرَدا", "ajuz": "وَهِيَ ثَلاثونَ فَأَحصِ العَدَدا"},
    {"n": 23, "sadr": "فَهوَ الإِلَهُ البَرُّ وَالتَّوّابُ", "ajuz": "جَميلُ وَالجَوادُ لا تَحسابُ"},
    {"n": 24, "sadr": "حَسيبٌ وَالحَفيظُ مَع دَيّانِ", "ajuz": "رَؤوفٌ وَالرَّفيقُ ذو الإِحسانِ"},
    {"n": 25, "sadr": "وَإِنَّهُ السُّبّوحُ وَهوَ السَّيِّدُ", "ajuz": "وَإِنَّهُ الشّافي المَريضَ الصَّمَدُ"},
    {"n": 26, "sadr": "وَالطَّيِّبُ العَظيمُ إِنَّهُ العَفو", "ajuz": "وَبِالكَبيرِ وَالمَتينِ يُعرَفُ"},
    {"n": 27, "sadr": "وَمُحسِنٌ مُسَعِّرٌ وَالمُعطي", "ajuz": "مُقيتٌ مَنّانٌ نَصيرُ الرَّهطِ"},
    {"n": 28, "sadr": "وَواسِعٌ وَالوِترُ مَع وَدودِ", "ajuz": "وَكيلٌ وَهّابٌ اِنتَهى مَقصودي"},
    {"n": 29, "sadr": "سُبحانَ مَن أَرشَدَنا مُنَبِّها", "ajuz": "وَقالَ في الأَعرافِ فَادعوهُ بِها"},
    {"n": 30, "sadr": "دُعا عِبادَةٍ هُوَ الثَّناءُ لَه", "ajuz": "مَع سُؤلِ حاجَةٍ دُعاءِ المَسأَلَه"}
  ]
}
