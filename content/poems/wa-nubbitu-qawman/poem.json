{
  "id": "wa-nubbitu-qawman",
  "poet": "bashshar-ibn-burd",
  "title": "وَنُبِّئتُ قَوماً بِهِم جِنَّةٌ",
  "meter": "mutaqarib",
  "themes": ["madh", "fakhr", "karam"],
  "rawiy": "م",
  "abyat_in_full": 30,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "وَنُبِّئتُ قَوماً بِهِم جِنَّةٌ",
      "ajuz": "يَقولونَ مَن ذا وَكُنتُ العَلَم"
    },
    {
      "n": 2,
      "sadr": "أَلا أَيُّها السّائِلي جاهِداً",
      "ajuz": "لِيَعرِفَني أَنا أَنفُ الكَرَم"
    },
    {
      "n": 3,
      "sadr": "نَمَت في الكِرامِ بَني عامِرٍ",
      "ajuz": "فُروعي وَأَصلي قُرَيشُ العَجَم"
    },
    {
      "n": 4,
      "sadr": "فَإِنّي لَأُغني مَقامَ الفَتى",
      "ajuz": "وَأُصبي الفَتاةَ فَما تَعتَصِم"
    },
    {
      "n": 5,
      "sadr": "وَجارِيَةٍ خُلِقَت وَحدَها",
      "ajuz": "كَأَنَّ النِّساءَ لَدَيها خَدَم"
    },
    {
      "n": 6,
      "sadr": "دُوارُ العَذارى إِذا زُرنَها",
      "ajuz": "أَطَفنَ بِحَوراءَ مِثلِ الصَّنَم"
    },
    {
      "n": 7,
      "sadr": "يَظَلنَ يُمَسِّحنَ أَركانَها",
      "ajuz": "كَما يُمسَحُ الحَجَرُ المُستَلَم"
    },
    {
      "n": 8,
      "sadr": "وَبَيضاءَ يَضحَكُ ماءُ الشَّبا",
      "ajuz": "بِ في وَجهِها لَكَ إِذ تَبتَسِم"
    },
    {
      "n": 9,
      "sadr": "ظَمِئتُ إِلَيها فَلَم تَسقِني",
      "ajuz": "بِرِيٍّ وَلَم تَشفِني مِن سَقَم"
    },
    {
      "n": 10,
      "sadr": "وَقالَت هَويتَ فَمُت راشِداً",
      "ajuz": "كَما ماتَ عُروَةُ غَمّاً بِغَم"
    },
    {
      "n": 11,
      "sadr": "فَلَمّا رَأَيتُ الهَوى قاتِلي",
      "ajuz": "وَلَستُ بِجارٍ وَلا بِابنِ عَم"
    },
    {
      "n": 12,
      "sadr": "دَسَستُ إِلَيها أَبا مِجلَزٍ",
      "ajuz": "وَأَيَّ فَتىً إِن أَصابَ اِعتَزَم"
    },
    {
      "n": 13,
      "sadr": "فَما زالَ حَتّى أَنابَت لَهُ",
      "ajuz": "فَراحَ وَحَلَّ لَنا ما حَرُم"
    },
    {
      "n": 14,
      "sadr": "أَصَفراءُ لَيسَ الفَتى صَخرَةً",
      "ajuz": "وَلَكِنَّهُ نُصبُ هَمٍّ وَغَم"
    },
    {
      "n": 15,
      "sadr": "أَقولُ لَها حينَ قَلَّ الثَّراء",
      "ajuz": "وَضاقَ المُرادُ وَأَودى النَّعَم"
    },
    {
      "n": 16,
      "sadr": "إِذا ما اِفتَقَرتُ فَأُحيي السُّرى",
      "ajuz": "إِلى اِبنِ العَلاءِ طَبيبِ العَدَم"
    },
    {
      "n": 17,
      "sadr": "دَعاني إِلى عُمَرٍ جودُهُ",
      "ajuz": "وَقَولُ العَشيرَةِ بَحرٌ خِضَم"
    },
    {
      "n": 18,
      "sadr": "وَلَولا الَّذي زَعَموا لَم أَكُن",
      "ajuz": "لِأَمدَحَ رَيحانَةً قَبلَ شَمّ"
    },
    {
      "n": 19,
      "sadr": "أَلا أَيُّها الطّالِبُ المُبتَغي",
      "ajuz": "نُجومَ السَّماءِ بِسَعيٍ أَمَم"
    },
    {
      "n": 20,
      "sadr": "سَمِعتَ بِمَكرُمَةِ اِبنِ العَلا",
      "ajuz": "فَأَنشَأتَ تَطلُبُها لَستَ ثَمّ"
    },
    {
      "n": 21,
      "sadr": "إِذا عَرَضَ اللَّهوُ في صَدرِهِ",
      "ajuz": "لَها بِالعَطاءِ وَضَربِ البُهَم"
    },
    {
      "n": 22,
      "sadr": "يَلَذُّ العَطاءَ وَسَفكَ الدِّماءِ",
      "ajuz": "وَيَغدو عَلى نِعَمٍ أَو نِقَم"
    },
    {
      "n": 23,
      "sadr": "فَقُل لِلخَليفَةِ إِن جِئتَهُ",
      "ajuz": "نَصوحاً وَلا خَيرَ في مُتَّهَم"
    },
    {
      "n": 24,
      "sadr": "إِذا أَيقَظَتكَ حُروبُ العِدا",
      "ajuz": "فَنَبِّه لَها عُمَراً ثُمَّ نَم"
    },
    {
      "n": 25,
      "sadr": "فَتىً لا يَنامُ عَلى ثَأرِهِ",
      "ajuz": "وَلا يَشرَبُ الماءَ إِلّا بِدَم"
    },
    {
      "n": 26,
      "sadr": "إِذا ما غَزا بَشَّرَت طَيرُهُ",
      "ajuz": "بِفَتحٍ وَبَشَّرَنا بِالنِّعَم"
    },
    {
      "n": 27,
      "sadr": "إِذا قالَ تَمَّ عَلى قَولِهِ",
      "ajuz": "وَماتَ العَناءُ بِلا أَو نَعَم"
    },
    {
      "n": 28,
      "sadr": "وَبَعضُ الرِّجالِ بِمَوعودِهِ",
      "ajuz": "قَريبٌ وَبِالفِعلِ تَحتَ الرَّجَم"
    },
    {
      "n": 29,
      "sadr": "كَجاري السَّرابِ تَرى لَمعَهُ",
      "ajuz": "وَلَستَ بِواجِدِهِ عِندَكُم"
    }
  ]
}
