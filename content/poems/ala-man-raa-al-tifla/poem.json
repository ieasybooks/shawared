{
  "id": "ala-man-raa-al-tifla",
  "poet": "ibn-al-zayyat",
  "title": "أَلا مَن رَأى الطِّفلَ المُفارِقَ أُمَّهُ",
  "meter": "tawil",
  "rawiy": "ن",
  "abyat_in_full": 19,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1,  "sadr": "أَلا مَن رَأى الطِّفلَ المُفارِقَ أُمَّهُ", "ajuz": "بُعَيدَ الكَرى عَيناهُ تَنسَكِبانِ" },
    { "n": 2,  "sadr": "رَأى كُلَّ أُمٍّ وَابنَها غَيرَ أُمِّهِ", "ajuz": "يَبيتانِ تَحتَ اللَّيلِ يَنتَجِيانِ" },
    { "n": 3,  "sadr": "يَرِنُّ بِصَوتٍ فَضَّ قَلبي نَشيجُهُ", "ajuz": "وَسَحِّ دُموعٍ ثَرَّةِ الهَمَلانِ" },
    { "n": 4,  "sadr": "وَباتَ وَحيداً في الفِراشِ تَحُثُّهُ", "ajuz": "بَلابِلُ قَلبٍ دائِمِ الخَفَقانِ" },
    { "n": 5,  "sadr": "أَلا إِنَّ سِجلاً واحِداً إِن هَرَقتُهُ", "ajuz": "مِنَ الدَّمعِ أَو سِجلَينِ قَد شَفَياني" },
    { "n": 6,  "sadr": "فَلا تَلحَياني إِن بَكَيتُ فَإِنَّما", "ajuz": "أُداوي بِهَذا الدَّمعِ ما تَرَيانِ" },
    { "n": 7,  "sadr": "وَإِنَّ مَكاناً في الثَّرى خُطَّ لَحدُهُ", "ajuz": "لِمَن كانَ مِن قَلبي بِكُلِّ مَكانِ" },
    { "n": 8,  "sadr": "أَحَقُّ مَكانٍ بِالزِّيارَةِ وَالهَوى", "ajuz": "فَهَل أَنتُما إِن عُجتُ مُنتَظِرانِ" },
    { "n": 9,  "sadr": "فَهَبني عَزَمتُ الصَّبرَ عَنها لِأَنَّني", "ajuz": "جَليدٌ فَمَن بِالصَّبرِ لِابنِ ثَمانِ" },
    { "n": 10, "sadr": "ضَعيفُ القُوى لا يَطلُبُ الأَجرَ حِسبَةً", "ajuz": "وَلا يَأتَسي بِالنّاسِ في الحَدَثانِ" },
    { "n": 11, "sadr": "أَلا مَن أُمَنّيهِ المُنى وَأُعِدُّهُ", "ajuz": "لِعَثرَةِ أَيّامٍ وَصَرفِ زَمانِ" },
    { "n": 12, "sadr": "أَلا مَن إِذا ما جِئتُ أَكرَمَ مَجلِسي", "ajuz": "وَإِن غِبتُ عَنهُ حاطَني وَكَفاني" },
    { "n": 13, "sadr": "فَلَم أَرَ كَالأَقدارِ كَيفَ تُصيبُني", "ajuz": "وَلا مِثلَ هَذا الدَّهرِ كَيفَ رَماني" },
    { "n": 14, "sadr": "وَلا مِثلَ أَيّامٍ فُجِعتُ بِفَقدِها", "ajuz": "وَلا مِثلَ يَومٍ بَعدَ ذاكَ دَهاني" },
    { "n": 15, "sadr": "أَعَينَيَّ إِلّا تُسعِدا اليَومَ عَبرَتي", "ajuz": "فَبِئسَ إِذَن ما في غَدٍ تَعِداني" },
    { "n": 16, "sadr": "أَعَينَيَّ إِن أَنعَ السُّرورَ وَأَهلَهُ", "ajuz": "وَعَهدَ الصِّبا عِندي فَقَد نَعَياني" },
    { "n": 17, "sadr": "أَعَينَيَّ إِن أَبكِ البَشاشَةَ وَالصِّبا", "ajuz": "فَقَد آذَنا مِنّي وَقَد بَكَياني" },
    { "n": 18, "sadr": "أَلا إِنَّ بَيتاً لَم أَزُرهُ لَشَدَّ ما", "ajuz": "تَلَبَّسَ مِن قَلبي بِهِ وَعَناني" },
    { "n": 19, "sadr": "أَلا إِنَّ بَيتاً لَم أَزُرهُ لَعَزَّ ما", "ajuz": "تَضَمَّنَ مِنهُ في الثَّرى الكَفَنانِ" }
  ]
}
