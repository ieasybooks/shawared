{
  "id": "tafdika-al-nufusu",
  "poet": "abu-al-ala-al-maarri",
  "title": "تُفَدّيكَ النُّفوسُ وَلا تَفادى",
  "meter": "wafir",
  "themes": ["shawq", "wasf"],
  "rawiy": "د",
  "abyat_in_full": 56,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "تُفَدّيكَ النُّفوسُ وَلا تَفادى",
      "ajuz": "فَأَدنِ القُربَ أَو أَطِلِ البِعادا"
    },
    {
      "n": 2,
      "sadr": "أَرانا يا عَلِيُّ وَإِن أَقَمنا",
      "ajuz": "نُشاطِرُكَ الصَّبابَةَ وَالسُّهادا"
    },
    {
      "n": 3,
      "sadr": "وَلَولا أَن يُظَنَّ بِنا غُلُوٌّ",
      "ajuz": "لَزِدنا في المَقالِ مَنِ اِستَزادا"
    },
    {
      "n": 4,
      "sadr": "وَقيلَ أَفادَ بِالأَسفارِ مالاً",
      "ajuz": "فَقُلنا هَل أَفادَ بِها فُؤادا"
    },
    {
      "n": 5,
      "sadr": "وَهَل هانَت عَزائِمُهُ وَلانَت",
      "ajuz": "فَقَد كانَت عَرائِكُها شِدادا"
    },
    {
      "n": 6,
      "sadr": "إِذا سارَتكَ شُهبُ اللَّيلِ قالَت",
      "ajuz": "أَعانَ اللَّهُ أَبعَدَنا مُرادا"
    },
    {
      "n": 7,
      "sadr": "وَإِن جارَتكَ هوجُ الرّيحِ كانَت",
      "ajuz": "أَكَلَّ رَكائِباً وَأَقَلَّ زادا"
    },
    {
      "n": 8,
      "sadr": "إِذا جَلّى لَيالي الشَّهرِ سَيرٌ",
      "ajuz": "عَلَيكَ أَخَذتَ أَسبَغَها حِدادا"
    },
    {
      "n": 9,
      "sadr": "تَخَيَّرُ سودَها وَتَقولُ أَحلى",
      "ajuz": "عُيونِ الخَلقِ أَكثَرُها سَوادا"
    },
    {
      "n": 10,
      "sadr": "تَضَيَّفُكَ الخَوامِعُ في المَوامي",
      "ajuz": "فَتَقريهِنَّ مَثنى أَو فُرادى"
    },
    {
      "n": 11,
      "sadr": "وَيَبكي رِقَّةً لَكَ كُلُّ نَوءٍ",
      "ajuz": "فَتَملَأُ مِن مَدامِعِهِ المَزادا"
    },
    {
      "n": 12,
      "sadr": "إِذا صاحَ اِبنُ دَأيَةَ بِالتَّداني",
      "ajuz": "جَعَلنا خِطرَ لِمَّتِهِ جَسادا"
    },
    {
      "n": 13,
      "sadr": "نُضَمِّخُ بِالعَبيرِ لَهُ جَناحاً",
      "ajuz": "أَحَمَّ كَأَنَّهُ طُلِيَ المِدادا"
    },
    {
      "n": 14,
      "sadr": "سَنَلثِمُ مِن نَجائِبِكَ الهَوادي",
      "ajuz": "وَنَرشُفُ غِمدَ سَيفِكَ وَالنِّجادا"
    },
    {
      "n": 15,
      "sadr": "وَنَستَشفي بِسُؤرِ جَوادِ خَيلٍ",
      "ajuz": "قَدِمتَ عَلَيهِ إِن خِفنا الجُوادا"
    },
    {
      "n": 16,
      "sadr": "كَأَنَّكَ مِنهُ فَوقَ سَماءِ عِزٍّ",
      "ajuz": "وَقَد جُعِلَت قَوائِمُهُ عِمادا"
    },
    {
      "n": 17,
      "sadr": "إِذا هادى أَخٌ مِنّا أَخاهُ",
      "ajuz": "تُرابَكَ كانَ أَلطَفَ ما يُهادى"
    },
    {
      "n": 18,
      "sadr": "كَأَنَّ بَني سَبيكَةَ فَوقَ طَيرٍ",
      "ajuz": "يَجوبونَ الغَوائِرَ وَالنِّجادا"
    },
    {
      "n": 19,
      "sadr": "أَبِالإِسكَندَرِ المَلِكِ اِقتَدَيتُم",
      "ajuz": "فَما تَضَعونَ في بَلَدٍ وِسادا"
    },
    {
      "n": 20,
      "sadr": "لَعَلَّكَ يا جَليدَ القَلبِ ثانٍ",
      "ajuz": "لِأَوَّلِ ماسِحٍ مَسَحَ البِلادا"
    },
    {
      "n": 21,
      "sadr": "بِعيسٍ مِثلِ أَطرافِ المَداري",
      "ajuz": "يَخُضنَ مِنَ الدُّجى لِمَماً جِعادا"
    },
    {
      "n": 22,
      "sadr": "عَلامَ هَجَرتَ شَرقَ الأَرضِ حَتّى",
      "ajuz": "أَتَيتَ الغَربَ تَختَبِرُ العِبادا"
    },
    {
      "n": 23,
      "sadr": "وَكانَت مِصرُ ذاتُ النّيلِ عَصراً",
      "ajuz": "تُنافِسُ فيكَ دِجلَةَ وَالسَّوادا"
    },
    {
      "n": 24,
      "sadr": "وَإِنَّ مِنَ الصَّراةِ إِلى مَجَرِّ ال",
      "ajuz": "فُراتِ إِلى قُوَيقٍ مُستَرادا"
    },
    {
      "n": 25,
      "sadr": "مِياهٌ لَو طَرَحتَ بِها لُجَيناً",
      "ajuz": "وَمُشبِهَها لَمُيِّزَتِ اِنتِقادا"
    },
    {
      "n": 26,
      "sadr": "فَإِن تَجِدِ الدِّيارَ كَما أَرادَ ال",
      "ajuz": "غَريبُ فَما الصَّديقُ كَما أَرادا"
    },
    {
      "n": 27,
      "sadr": "إِذا الشِّعرى اليَمانِيَةُ اِستَنارَت",
      "ajuz": "فَجَدِّد لِلشَّآمِيَةِ الوِدادا"
    },
    {
      "n": 28,
      "sadr": "فَلِلشّامِ الوَفاءُ وَإِنَّ سِواهُ",
      "ajuz": "تَوافى مَنطِقاً غَدَرَ اِعتِقادا"
    },
    {
      "n": 29,
      "sadr": "ظَعَنتَ لِتَستَفيدَ أَخاً وَفِيّاً",
      "ajuz": "وَضَيَّعتَ القَديمَ المُستَفادا"
    },
    {
      "n": 30,
      "sadr": "وَسِرتَ لِتَذعَرَ الحيتانَ لَمّا",
      "ajuz": "ذَعَرتَ الوَحشَ وَالأُسدَ الوِرادا"
    },
    {
      "n": 31,
      "sadr": "وَلَيلٍ خافَ قَولَ النّاسِ لَمّا",
      "ajuz": "تَوَلّى سارَ مُنهَزِماً فَعادا"
    },
    {
      "n": 32,
      "sadr": "دَجا فَتَلَهَّبَ المِرّيخُ فيهِ",
      "ajuz": "وَأَلبَسَ جَمرَةَ الشَّمسِ الرَّمادا"
    },
    {
      "n": 33,
      "sadr": "كَأَنَّكَ مِن كَواكِبِهِ سُهَيلٌ",
      "ajuz": "إِذا طَلَعَ اِعتِزالاً وَاِنفِرادا"
    },
    {
      "n": 34,
      "sadr": "جَعَلتَ النّاجِياتِ عَلَيهِ عَوناً",
      "ajuz": "فَلَم تَطعَم وَلا طَعِمَت رُقادا"
    },
    {
      "n": 35,
      "sadr": "تَوَهَّمُ أَنَّ ضَوءَ الفَجرِ دانٍ",
      "ajuz": "فَلَم تَقدَح بِظِنَّتِها زِنادا"
    },
    {
      "n": 36,
      "sadr": "وَما لاحَ الصَّباحُ لَها وَلَكِن",
      "ajuz": "رَأَت مِن نارِ عَزمَتِكَ اِتِّقادا"
    },
    {
      "n": 37,
      "sadr": "قَطَعتَ بِحارَها وَالبَرَّ حَتّى",
      "ajuz": "تَعالَلتَ السَّفائِنَ وَالجِيادا"
    },
    {
      "n": 38,
      "sadr": "فَلَم تَترُك لِجارِيَةٍ شِراعاً",
      "ajuz": "وَلَم تَترُك لِعادِيَةٍ بِدادا"
    },
    {
      "n": 39,
      "sadr": "بِأَرضٍ لا يَصوبُ الغَيثُ فيها",
      "ajuz": "وَلا تَرعى البُداةُ بِها النِّقادا"
    },
    {
      "n": 40,
      "sadr": "وَأُخرى رومُها عَرَبٌ عَلَيها",
      "ajuz": "وَإِن لَم يَركَبوا فيها جَوادا"
    },
    {
      "n": 41,
      "sadr": "سِوى أَنَّ السَّفينَ تُخالُ فيها",
      "ajuz": "بُيوتَ الشَّعرِ شَكلاً وَاِسوِدادا"
    },
    {
      "n": 42,
      "sadr": "دِيارُهُمُ بِهِم تَسري وَتَجري",
      "ajuz": "إِذا شاؤوا مُغاراً أَو طِرادا"
    },
    {
      "n": 43,
      "sadr": "تَصَيَّدُ سَفرُها في كُلِّ وَجهٍ",
      "ajuz": "وَغايَةُ مَن تَصَيَّدَ أَن يُصادا"
    },
    {
      "n": 44,
      "sadr": "تَكادُ تَكونُ في لَونٍ وَفِعلٍ",
      "ajuz": "نَواظِرُها أَسِنَّتَها الحِدادا"
    },
    {
      "n": 45,
      "sadr": "أَقِم في الأَقرَبينَ فَكُلُّ حَيٍّ",
      "ajuz": "يُراوَحُ بِالمَعيشَةِ أَو يُغادى"
    },
    {
      "n": 46,
      "sadr": "وَلَيسَ يُزادُ في رِزقٍ حَريصٌ",
      "ajuz": "وَلَو رَكِبَ العَواصِفَ كَي يُزادا"
    },
    {
      "n": 47,
      "sadr": "وَكَيفَ تَسيرُ مُبتَغِياً طَريفاً",
      "ajuz": "وَقَد وَهَبَت أَنامِلُكَ التِّلادا"
    },
    {
      "n": 48,
      "sadr": "فَما يَنفَكُّ ذا مالٍ عَتيدٍ",
      "ajuz": "فَتىً جَعَلَ القُنوعَ لَهُ عَتادا"
    },
    {
      "n": 49,
      "sadr": "وَلَو أَنَّ السَّحابَ هَمى بِعَقلٍ",
      "ajuz": "لَما أَروى مَعَ النَّخلِ القَتادا"
    },
    {
      "n": 50,
      "sadr": "وَلَو أَعطى عَلى قَدرِ المَعالي",
      "ajuz": "سَقى الهَضَباتِ وَاِجتَنَبَ الوِهادا"
    },
    {
      "n": 51,
      "sadr": "وَما زِلتَ الرَّشيدَ نُهىً وَحاشا",
      "ajuz": "لِفَضلِكَ أَن أُذَكِّرَهُ الرَّشادا"
    },
    {
      "n": 52,
      "sadr": "وَمِثلُكَ لِلأَصادِقِ مُستَقيدٌ",
      "ajuz": "وَشَرُّ الخَيلِ أَصعَبُها قِيادا"
    },
    {
      "n": 53,
      "sadr": "وَرُبَّ مُبالِغٍ في كَيدِ أَمرٍ",
      "ajuz": "تَقولُ لَهُ أَحِبَّتُهُ اِقتِصادا"
    },
    {
      "n": 54,
      "sadr": "وَذي أَمَلٍ تَبَصَّرَ كُنهَ أَمرٍ",
      "ajuz": "فَقَصَّرَ بَعدَما أَشفى وَكادا"
    },
    {
      "n": 55,
      "sadr": "نُراسِلُكَ التَّنَصُّحَ في القَوافي",
      "ajuz": "وَغَيرُكَ مَن نُعَلِّمُهُ السَّدادا"
    },
    {
      "n": 56,
      "sadr": "فَإِن تَقبَل فَذاكَ هَوى أُناسٍ",
      "ajuz": "وَإِن تَردُد فَلَم نَألُ اِجتِهادا"
    }
  ]
}
