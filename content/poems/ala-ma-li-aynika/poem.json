{
  "id": "ala-ma-li-aynika",
  "poet": "al-khansa",
  "title": "أَلا ما لِعَينِكِ أَم ما لَها",
  "meter": "mutaqarib",
  "themes": ["ritha"],
  "rawiy": "ل",
  "abyat_in_full": 31,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1,  "sadr": "أَلا ما لِعَينِكِ أَم ما لَها", "ajuz": "لَقَد أَخضَلَ الدَّمعُ سِربالَها" },
    { "n": 2,  "sadr": "أَبَعدَ اِبنِ عَمرٍو مِنَ آلِ الشَّريدِ", "ajuz": "حَلَّت بِهِ الأَرضُ أَثقالَها" },
    { "n": 3,  "sadr": "فَآلَيتُ آسى عَلى هالِكٍ", "ajuz": "وَأَسأَلُ باكِيَةً ما لَها" },
    { "n": 4,  "sadr": "لَعَمرُ أَبيكَ لَنِعمَ الفَتى", "ajuz": "تَحُشُّ بِهِ الحَربُ أَجذالَها" },
    { "n": 5,  "sadr": "حَديدُ السِّنانِ ذَليقُ اللِّسانِ", "ajuz": "يُجاري المَقارِضَ أَمثالَها" },
    { "n": 6,  "sadr": "هَمَمتُ بِنَفسِيَ كُلَّ الهُمومِ", "ajuz": "فَأَولى لِنَفسِيَ أَولى لَها" },
    { "n": 7,  "sadr": "سَأَحمِلُ نَفسي عَلى آلَةٍ", "ajuz": "فَإِمّا عَلَيها وَإِمّا لَها" },
    { "n": 8,  "sadr": "فَإِن تَصبِرِ النَّفسُ تَلقَ السُّرورَ", "ajuz": "وَإِن تَجزَعِ النَّفسُ أَشقى لَها" },
    { "n": 9,  "sadr": "نُهينُ النُّفوسَ وَهَونُ النُّفوسِ", "ajuz": "يَومَ الكَريهَةِ أَبقى لَها" },
    { "n": 10, "sadr": "وَنَعلَمُ أَنَّ مَنايا الرِّجالِ", "ajuz": "بالِغَةٌ حَيثُ يُحلى لَها" },
    { "n": 11, "sadr": "لِتَجرِ المَنِيَّةُ بَعدَ الفَتى", "ajuz": "المُغادَرِ بِالمَحوِ أَذلالَها" },
    { "n": 12, "sadr": "وَرَجراجَةٍ فَوقَها بيضُها", "ajuz": "عَلَيها المُضاعَفُ أَمثالَها" },
    { "n": 13, "sadr": "كَكِرفِئَةِ الغَيثِ ذاتِ الصَّبيرِ", "ajuz": "تَرمي السَّحابَ وَيُرمى لَها" },
    { "n": 14, "sadr": "وَخَيلٍ تَكَدَّسُ بِالدّارِعينَ", "ajuz": "نازَلتَ بِالسَّيفِ أَبطالَها" },
    { "n": 15, "sadr": "وَقافِيَةٍ مِثلِ حَدِّ السِّنانِ", "ajuz": "تَبقى وَيَذهَبُ مَن قالَها" },
    { "n": 16, "sadr": "تَقُدُّ الذُّؤابَةَ مِن يَذبُلٍ", "ajuz": "أَبَت أَن تُفارِقَ أَوعالَها" },
    { "n": 17, "sadr": "نَطَقتَ اِبنَ عَمرٍو فَسَهَّلتَها", "ajuz": "وَلَم يَنطِقِ النّاسُ أَمثالَها" },
    { "n": 18, "sadr": "فَإِن تَكُ مُرَّةُ أَودَت بِهِ", "ajuz": "فَقَد كانَ يُكثِرُ تَقتالَها" },
    { "n": 19, "sadr": "فَخَرَّ الشَّوامِخُ مِن قَتلِهِ", "ajuz": "وَزُلزِلَتِ الأَرضُ زِلزالَها" },
    { "n": 20, "sadr": "وَزالَ الكَواكِبُ مِن فَقدِهِ", "ajuz": "وَجُلِّلَتِ الشَّمسُ أَجلالَها" },
    { "n": 21, "sadr": "وَداهِيَةٍ جَرَّها جارِمٌ", "ajuz": "تُبينُ الحَواضِنُ أَحمالَها" },
    { "n": 22, "sadr": "كَفاها اِبنُ عَمرٍو وَلَم يَستَعِن", "ajuz": "وَلَو كانَ غَيرُكَ أَدنى لَها" },
    { "n": 23, "sadr": "وَلَيسَ بِأَولى وَلَكِنَّهُ", "ajuz": "سَيَكفي العَشيرَةَ ما غالَها" },
    { "n": 24, "sadr": "بِمُعتَرَكٍ ضَيِّقٍ بَينَهُ", "ajuz": "تَجُرُّ المَنِيَّةُ أَذيالَها" },
    { "n": 25, "sadr": "تُطاعِنُها فَإِذا أَدبَرَت", "ajuz": "بَلَلتَ مِنَ الدَّمِ أَكفالَها" },
    { "n": 26, "sadr": "وَبيضٍ مَنَعتَ غَداةَ الصُّياحِ", "ajuz": "تَكشِفُ لِلرَّوعِ أَذيالَها" },
    { "n": 27, "sadr": "وَمُعمَلَةٍ سُقتَها قاعِداً", "ajuz": "فَأَعلَمتَ بِالسَّيفِ أَغفالَها" },
    { "n": 28, "sadr": "وَناجِيَةٍ كَأَتانِ الثَّميلِ", "ajuz": "غادَرتَ بِالخَلِّ أَوصالَها" },
    { "n": 29, "sadr": "إِلى مَلِكٍ لا إِلى سوقَةٍ", "ajuz": "وَذَلِكَ ما كانَ أُكلاً لَها" },
    { "n": 30, "sadr": "وَتَمنَحُ خَيلَكَ أَرضَ العِدى", "ajuz": "وَتَنبِذُ بِالغَزوِ أَطفالَها" },
    { "n": 31, "sadr": "وَنَوحٍ بَعَثتَ كَمِثلِ الإِراخِ", "ajuz": "آنَسَتِ العينُ أَشبالَها" }
  ]
}
