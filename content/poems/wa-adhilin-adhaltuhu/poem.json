{
  "id": "wa-adhilin-adhaltuhu",
  "poet": "abu-tammam",
  "title": "وَعاذِلٍ عَذَلتُهُ في عَذلِهِ",
  "meter": "rajaz",
  "themes": ["hija", "fakhr"],
  "rawiy": "ل",
  "abyat_in_full": 18,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "وَعاذِلٍ عَذَلتُهُ في عَذلِهِ",
      "ajuz": "فَظَنَّ أَنّي جاهِلٌ مِن جَهلِهِ"
    },
    {
      "n": 2,
      "sadr": "ما غَبَنَ المَغبونَ مِثلُ عَقلِهِ",
      "ajuz": "مَن لَكَ يَوماً بِأَخيكَ كُلِّهِ"
    },
    {
      "n": 3,
      "sadr": "لَبِستُ رَيعاني فَدَعني أُبلِهِ",
      "ajuz": "رَأيَ اِبنِ دَهرٍ غَرِقاً في خَبلِهِ"
    },
    {
      "n": 4,
      "sadr": "أَعلَمَ مِنهُ بِحُداءِ إِبلِهِ",
      "ajuz": "قَد لَعِبَت أَيدي النَّوى بِشَملِهِ"
    },
    {
      "n": 5,
      "sadr": "مُمَتَّعاً مُضطَلِعاً بِحِملِهِ",
      "ajuz": "مُنصَلِتاً كَالسَّيفِ عِندَ سَلِّهِ"
    },
    {
      "n": 6,
      "sadr": "مَولودَةٌ هِمَّتُهُ مِن قَبلِهِ",
      "ajuz": "قَد دانَ ذو الفَضلِ لَهُ بِفَضلِهِ"
    },
    {
      "n": 7,
      "sadr": "كَالصّابِ مَن يَذُقهُ لا يَستَحلِهِ",
      "ajuz": "إِلّا بِأَن يَسكُنَ تَحتَ ظِلِّهِ"
    },
    {
      "n": 8,
      "sadr": "مُفيدُ جَزلِ المالِ مُعطي جَزلِهِ",
      "ajuz": "يَحويهِ مِن حَرامِهِ وَحِلِّهِ"
    },
    {
      "n": 9,
      "sadr": "وَيَجعَلُ النّائِلَ أَدنى سُبُلِهِ",
      "ajuz": "وَبَلَدٍ نائي المَحَلِّ مَحلِهِ"
    },
    {
      "n": 10,
      "sadr": "رَمَيتُهُ مِنَ السُّرى بِنَبلِهِ",
      "ajuz": "بِبازِلٍ مُقابَلٍ في بُزلِهِ"
    },
    {
      "n": 11,
      "sadr": "مِثلي سَرى في مِثلِهِ بِمِثلِهِ",
      "ajuz": "وَمَلِكٍ في كِبرِهِ وَنُبلِهِ"
    },
    {
      "n": 12,
      "sadr": "وَسوقَةٍ في قَولِهِ وَفِعلِهِ",
      "ajuz": "بَذَلتُ مَدحي فيهِ باغي بَذلِهِ"
    },
    {
      "n": 13,
      "sadr": "فَحَذَّ حَبلَ أَمَلي مِن أَصلِهِ",
      "ajuz": "مِن بَعدِ ما اِستَعبَدَني بِمَطلِهِ"
    },
    {
      "n": 14,
      "sadr": "ثُمَّ أَتى مُعتَذِراً بِجَهلِهِ",
      "ajuz": "ذا عُنُقٍ في المَجدِ لَم يُحلِهِ"
    },
    {
      "n": 15,
      "sadr": "يَعجَبُ مِن تَعَجُّبي وَبُخلِهِ",
      "ajuz": "يَلحَظُني في جَدِّهِ وَهَزلِهِ"
    },
    {
      "n": 16,
      "sadr": "لَحظَ الأَسيرِ حَلَقاتِ كَبلِهِ",
      "ajuz": "حَتّى كَأَنّي جِئتُهُ بِعَزلِهِ"
    },
    {
      "n": 17,
      "sadr": "يا واحِداً مُنفَرِداً بِعَدلِهِ",
      "ajuz": "أَلبَستَهُ الغِنى فَلا تُملِهِ"
    },
    {
      "n": 18,
      "sadr": "ما أَضيَعَ الغِمدَ بِغَيرِ نَصلِهِ",
      "ajuz": "وَالشِّعرَ ما لَم يَكُ عِندَ أَهلِهِ"
    }
  ]
}
