{
  "id": "yaslamu-al-maru-akhuhu",
  "poet": "abu-al-atahiya",
  "title": "يُسلِمُ المَرءَ أَخوهُ",
  "meter": "ramal",
  "rawiy": "ه",
  "abyat_in_full": 44,
