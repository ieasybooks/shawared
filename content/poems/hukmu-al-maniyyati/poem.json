{
  "id": "hukmu-al-maniyyati",
  "poet": "abu-al-hasan-al-tihami",
  "title": "حُكمُ المَنِيَّةِ في البَرِيَّةِ جارِ",
  "meter": "kamil",
  "themes": ["ritha", "hikma"],
  "rawiy": "ر",
  "abyat_in_full": 89,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "حُكمُ المَنِيَّةِ في البَرِيَّةِ جارِ",
      "ajuz": "ما هَذِهِ الدُّنيا بِدارِ قَرارِ"
    },
    {
      "n": 2,
      "sadr": "بَينا يُرى الإِنسانُ فيها مُخبِراً",
      "ajuz": "حَتّى يُرى خَبَراً مِنَ الأَخبارِ"
    },
    {
      "n": 3,
      "sadr": "طُبِعَت عَلى كَدَرٍ وَأَنتَ تُريدُها",
      "ajuz": "صَفواً مِنَ الأَقذاءِ وَالأَكدارِ"
    },
    {
      "n": 4,
      "sadr": "وَمُكَلِّفُ الأَيّامِ ضِدَّ طِباعِها",
      "ajuz": "مُتَطَلِّبٌ في الماءِ جَذوَةَ نارِ"
    },
    {
      "n": 5,
      "sadr": "وَإِذا رَجَوتَ المُستَحيلَ فَإِنَّما",
      "ajuz": "تَبني الرَّجاءَ عَلى شَفيرٍ هارِ"
    },
    {
      "n": 6,
      "sadr": "فَالعَيشُ نَومٌ وَالمَنِيَّةُ يَقظَةٌ",
      "ajuz": "وَالمَرءُ بَينَهُما خَيالٌ سارِ"
    },
    {
      "n": 7,
      "sadr": "وَالنَّفسُ إِن رَضِيَت بِذَلِكَ أَو أَبَت",
      "ajuz": "مُنقادَةٌ بِأَزِمَّةِ الأَقدارِ"
    },
    {
      "n": 8,
      "sadr": "فَاقضوا مَآرِبَكُم عِجالاً إِنَّما",
      "ajuz": "أَعمارُكُم سَفَرٌ مِنَ الأَسفارِ"
    },
    {
      "n": 9,
      "sadr": "وَتَراكَضوا خَيلَ الشَّبابِ وَبادِروا",
      "ajuz": "أَن تُستَرَدَّ فَإِنَّهُنَّ عَوارِ"
    },
    {
      "n": 10,
      "sadr": "فَالدَّهرُ يَخدَعُ بِالمُنى وَيُغِصُّ إِن",
      "ajuz": "هَنّى وَيَهدِمُ ما بَنى بِبَوارِ"
    },
    {
      "n": 11,
      "sadr": "لَيسَ الزَّمانُ وَإِن حَرَصتَ مُسالِماً",
      "ajuz": "خُلُقُ الزَّمانِ عَداوَةُ الأَحرارِ"
    },
    {
      "n": 12,
      "sadr": "إِنّي وُتِرتُ بِصارِمٍ ذي رَونَقٍ",
      "ajuz": "أَعدَدتُهُ لِطِلابَةِ الأَوتارِ"
    },
    {
      "n": 13,
      "sadr": "أُثني عَلَيهِ بِإِثرِهِ وَلَو أَنَّهُ",
      "ajuz": "لَم يُغتَبَط أَثنَيتُ بِالآثارِ"
    },
    {
      "n": 14,
      "sadr": "يا كَوكَباً ما كانَ أَقصَرَ عُمرَهُ",
      "ajuz": "وَكَذاكَ عُمرُ كَواكِبِ الأَسحارِ"
    },
    {
      "n": 15,
      "sadr": "وَهِلالَ أَيّامٍ مَضى لَم يَستَدِر",
      "ajuz": "بَدراً وَلَم يُمهَل لِوَقتِ سِرارِ"
    },
    {
      "n": 16,
      "sadr": "عَجِلَ الخُسوفُ عَلَيهِ قَبلَ أَوانِهِ",
      "ajuz": "فَمَحاهُ قَبلَ مَظِنَّةِ الإِبدارِ"
    },
    {
      "n": 17,
      "sadr": "وَاستُلَّ مِن أَترابِهِ وَلِداتِهِ",
      "ajuz": "كَالمُقلَةِ اُستُلَّت مِنَ الأَشفارِ"
    },
    {
      "n": 18,
      "sadr": "فَكَأَنَّ قَلبي قَبرُهُ وَكَأَنَّهُ",
      "ajuz": "في طَيِّهِ سِرٌّ مِنَ الأَسرارِ"
    },
    {
      "n": 19,
      "sadr": "إِن يُغتَبَط صِغَراً فَرُبَّ مُفَخَّمٍ",
      "ajuz": "يَبدو ضَئيلَ الشَّخصِ لِلنُّظّارِ"
    },
    {
      "n": 20,
      "sadr": "إِنَّ الكَواكِبَ في عُلُوِّ مَحَلِّها",
      "ajuz": "لَتُرى صِغاراً وَهيَ غَيرُ صِغارِ"
    },
    {
      "n": 21,
      "sadr": "وَلَدُ المُعَزّى بَعضُهُ فَإِذا مَضى",
      "ajuz": "بَعضُ الفَتى فَالكُلُّ في الآثارِ"
    },
    {
      "n": 22,
      "sadr": "أَبكيهِ ثُمَّ أَقولُ مُعتَذِراً لَهُ",
      "ajuz": "وُفِّقتَ حينَ تَرَكتَ أَلأَمَ دارِ"
    },
    {
      "n": 23,
      "sadr": "جاوَرتُ أَعدائي وَجاوَرَ رَبَّهُ",
      "ajuz": "شَتّانَ بَينَ جِوارِهِ وَجِواري"
    },
    {
      "n": 24,
      "sadr": "أَشكو بُعادَكَ لي وَأَنتَ بِمَوضِعٍ",
      "ajuz": "لَولا الرَّدى لَسَمِعتَ فيهِ سِراري"
    },
    {
      "n": 25,
      "sadr": "وَالشَّرقُ نَحوَ الغَربِ أَقرَبُ شُقَّةً",
      "ajuz": "مِن بُعدِ تِلكَ الخَمسَةِ الأَشبارِ"
    },
    {
      "n": 26,
      "sadr": "هَيهاتَ قَد عَلِقَتكَ أَشراكُ الرَّدى",
      "ajuz": "وَاغتالَ عُمرَكَ قاطِعُ الأَعمارِ"
    },
    {
      "n": 27,
      "sadr": "وَلَقَد جَرَيتَ كَما جَرَيتُ لِغايَةٍ",
      "ajuz": "فَبَلَغتَها وَأَبوكَ في المِضمارِ"
    },
    {
      "n": 28,
      "sadr": "وَإِذا نَطَقتُ فَأَنتَ أَوَّلُ مَنطِقي",
      "ajuz": "وَإِذا سَكَتُّ فَأَنتَ في إِضماري"
    },
    {
      "n": 29,
      "sadr": "أُخفي مِنَ البُرَحاءِ ناراً مِثلَما",
      "ajuz": "يُخفي مِنَ النّارِ الزِّنادُ الواري"
    },
    {
      "n": 30,
      "sadr": "وَأُخَفِّضُ الزَّفَراتِ وَهيَ صَواعِدٌ",
      "ajuz": "وَأُكَفكِفُ العَبَراتِ وَهيَ جَوارِ"
    },
    {
      "n": 31,
      "sadr": "وَشِهابُ نارِ الحُزنِ إِن طاوَعتُهُ",
      "ajuz": "أَورى وَإِن عاصَيتُهُ مُتَوارِ"
    },
    {
      "n": 32,
      "sadr": "وَأَكُفُّ نيرانَ الأَسى وَلَرُبَّما",
      "ajuz": "غَلَبَ التَّصَبُّرَ فَارتَمَت بِشَرارِ"
    },
    {
      "n": 33,
      "sadr": "ثَوبُ الرِّياءِ يَشِفُّ عَمّا تَحتَهُ",
      "ajuz": "وَإِذا اِلتَحَفتَ بِهِ فَإِنَّكَ عارِ"
    },
    {
      "n": 34,
      "sadr": "قَصُرَت جُفوني أَم تَباعَدَ بَينُها",
      "ajuz": "أَم صُوِّرَت عَيني بِلا أَشفارِ"
    },
    {
      "n": 35,
      "sadr": "جَفَتِ الكَرى حَتّى كَأَنَّ غِرارَهُ",
      "ajuz": "عِندَ اِغتِماضِ العَينِ وَخزُ غِرارِ"
    },
    {
      "n": 36,
      "sadr": "وَلَوِ اِستَزارَت رَقدَةً لَرَمى بِها",
      "ajuz": "ما بَينَ أَجفاني مِنَ التَّيّارِ"
    },
    {
      "n": 37,
      "sadr": "أُحيي لَيالي التَّمِّ وَهيَ تُميتُني",
      "ajuz": "وَيُميتُهُنَّ تَبَلُّجُ الأَسحارِ"
    },
    {
      "n": 38,
      "sadr": "حَتّى رَأَيتُ الصُّبحَ يَألَفُ كَفُّهُ",
      "ajuz": "بِالضَّوءِ رَفرَفَ خَيمَةٍ كَالقارِ"
    },
    {
      "n": 39,
      "sadr": "وَالصُّبحُ قَد غَمَرَ النُّجومَ كَأَنَّهُ",
      "ajuz": "سَيلٌ طَغى فَطَفا عَلى النُّوّارِ"
    },
    {
      "n": 40,
      "sadr": "لَو كُنتَ تُمنَعُ خاضَ دونَكَ فِتيَةٌ",
      "ajuz": "مِنّا بِحارَ عَوامِلٍ وَشِفارِ"
    },
    {
      "n": 41,
      "sadr": "وَدَحَوا فُوَيقَ الأَرضِ أَرضاً مِن دَمٍ",
      "ajuz": "ثُمَّ اِنثَنَوا فَبَنَوا سَماءَ غُبارِ"
    },
    {
      "n": 42,
      "sadr": "قَومٌ إِذا لَبِسوا الدُّروعَ حَسِبتَها",
      "ajuz": "سُحُباً مُزَرَّرَةً عَلى أَقمارِ"
    },
    {
      "n": 43,
      "sadr": "وَتَرى سُيوفَ الدّارِعينَ كَأَنَّها",
      "ajuz": "خُلُجٌ تُمَدُّ بِها أَكُفُّ بِحارِ"
    },
    {
      "n": 44,
      "sadr": "لَو أَشرَعوا أَيمانَهُم مِن طولِها",
      "ajuz": "طَعَنوا بِها عِوَضَ القَنا الخَطّارِ"
    },
    {
      "n": 45,
      "sadr": "شوسٌ إِذا عَدِموا الوَغى اِنتَجَعوا لَها",
      "ajuz": "مِن كُلِّ أَوبٍ نُجعَةَ الأَمطارِ"
    },
    {
      "n": 46,
      "sadr": "جَنَّبوا الجِيادَ عَلى المَطِيِّ وَراوَحوا",
      "ajuz": "بَينَ السُّروجِ هُناكَ وَالأَكوارِ"
    },
    {
      "n": 47,
      "sadr": "وَكَأَنَّما مَلَؤوا عِيابَ دُروعِهِم",
      "ajuz": "وَعَمودَ أَنصُلِهِم سَرابَ قِفارِ"
    },
    {
      "n": 48,
      "sadr": "وَكَأَنَّ مَن صَنَعَ السَّوابِغَ غَرَّهُ",
      "ajuz": "ماءُ الحَديدِ فَصاغَ ماءَ قَرارِ"
    },
    {
      "n": 49,
      "sadr": "زَرَداً فَأَحكَمَ كُلَّ مَوصِلِ حَلقَةٍ",
      "ajuz": "بِحَبابَةٍ في مَوضِعِ المِسمارِ"
    },
    {
      "n": 50,
      "sadr": "فَتَسَربَلوا بِمُتونِ ماءٍ جامِدٍ",
      "ajuz": "وَتَقَنَّعوا بِحَبابِ ماءٍ جارِ"
    },
    {
      "n": 51,
      "sadr": "أُسدٌ وَلَكِن يُؤثِرونَ بِزادِهِم",
      "ajuz": "وَالأُسدُ لَيسَ تَدينُ بِالإيثارِ"
    },
    {
      "n": 52,
      "sadr": "يَتَزَيَّنُ النّادي بِحُسنِ وُجوهِهِم",
      "ajuz": "كَتَزَيُّنِ الهالاتِ بِالأَقمارِ"
    },
    {
      "n": 53,
      "sadr": "يَتَعَطَّفونَ عَلى المُجاوِرِ فيهِمُ",
      "ajuz": "بِالمُنفِساتِ تَعَطُّفَ الأَظآرِ"
    },
    {
      "n": 54,
      "sadr": "مِن كُلِّ مَن جَعَلَ الظُّبا أَنصارَهُ",
      "ajuz": "وَكَرُمنَ فَاستَغنى عَنِ الأَنصارِ"
    },
    {
      "n": 55,
      "sadr": "وَإِذا هُوَ اِعتَقَلَ القَناةَ حَسِبتَها",
      "ajuz": "صِلّاً تَأَبَّطَهُ هِزَبرٌ ضارِ"
    },
    {
      "n": 56,
      "sadr": "وَاللَّيثُ إِن ثاوَرتَهُ لَم يَعتَمِد",
      "ajuz": "إِلّا عَلى الأَنيابِ وَالأَظفارِ"
    },
    {
      "n": 57,
      "sadr": "زَرَدُ الدِّلاصِ مِنَ الطِّعانِ بِرُمحِهِ",
      "ajuz": "في الجَحفَلِ المُتَضايِقِ الجَرّارِ"
    },
    {
      "n": 58,
      "sadr": "ما بَينَ تُربٍ بِالدِّماءِ مُضَمَّخٍ",
      "ajuz": "زَلِقٍ وَنَقعٍ بِالطِّرادِ مُثارِ"
    },
    {
      "n": 59,
      "sadr": "وَالهَونُ في ظِلِّ الهُوَينا كامِنٌ",
      "ajuz": "وَجَلالَةُ الأَخطارِ في الإِخطارِ"
    },
    {
      "n": 60,
      "sadr": "تَندى أَسِرَّةُ وَجهِهِ وَيَمينُهُ",
      "ajuz": "في حالَةِ الإِعسارِ وَالإيسارِ"
    },
    {
      "n": 61,
      "sadr": "وَيَمُدُّ نَحوَ المَكرُماتِ أَنامِلاً",
      "ajuz": "لِلرِّزقِ في أَثنائِهِنَّ مَجارِ"
    },
    {
      "n": 62,
      "sadr": "يَحوي المَعالي كاسِباً أَو غالِباً",
      "ajuz": "أَبَداً يُدارى دونَها وَيُداري"
    },
    {
      "n": 63,
      "sadr": "قَد لاحَ في لَيلِ الشَّبابِ كَواكِبٌ",
      "ajuz": "إِن أُمهِلَت آلَت إِلى الإِسفارِ"
    },
    {
      "n": 64,
      "sadr": "وَتَلَهُّبُ الأَحشاءِ شَيَّبَ مَفرِقي",
      "ajuz": "هَذا الضِّياءُ شُواظُ تِلكَ النّارِ"
    },
    {
      "n": 65,
      "sadr": "شابَ القَذالُ وَكُلُّ غُصنٍ صائِرٌ",
      "ajuz": "فَينانُهُ الأَحوى إِلى الإِزهارِ"
    },
    {
      "n": 66,
      "sadr": "وَالشِّبهُ مُنجَذِبٌ فَلِم بيضُ الدُّمى",
      "ajuz": "عَن بيضِ مَفرِقِهِ ذَواتُ نِفارِ"
    },
    {
      "n": 67,
      "sadr": "وَتَوَدُّ لَو جَعَلَت سَوادَ قُلوبِها",
      "ajuz": "وَسَوادَ أَعيُنِها خِضابَ عِذاري"
    },
    {
      "n": 68,
      "sadr": "لا تَنفِرِ الظَّبَياتُ عَنهُ فَقَد رَأَت",
      "ajuz": "كَيفَ اِختِلافُ النَّبتِ في الأَطوارِ"
    },
    {
      "n": 69,
      "sadr": "شَيئانِ يَنقَشِعانِ أَوَّلَ وَهلَةٍ",
      "ajuz": "ظِلُّ الشَّبابِ وَخُلَّةُ الأَشرارِ"
    },
    {
      "n": 70,
      "sadr": "لا حَبَّذا الشَّيبُ الوَفِيُّ وَحَبَّذا",
      "ajuz": "ظِلُّ الشَّبابِ الخائِنُ الغَدّارِ"
    },
    {
      "n": 71,
      "sadr": "وَطَري مِنَ الدُّنيا الشَّبابُ وَرَوقُهُ",
      "ajuz": "فَإِذا اِنقَضى فَقَدِ اِنقَضَت أَوطاري"
    },
    {
      "n": 72,
      "sadr": "قَصُرَت مَسافَتُهُ وَما حَسَناتُهُ",
      "ajuz": "عِندي وَلا آلاؤُهُ بِقِصارِ"
    },
    {
      "n": 73,
      "sadr": "نَزدادُ هَمّاً كُلَّما اِزدَدنا غِنىً",
      "ajuz": "وَالفَقرُ كُلُّ الفَقرِ في الإِكثارِ"
    },
    {
      "n": 74,
      "sadr": "ما زادَ فَوقَ الزّادِ خُلِّفَ ضائِعاً",
      "ajuz": "في حادِثٍ أَو وارِثٍ أَو عارِ"
    },
    {
      "n": 75,
      "sadr": "إِنّي لَأَرحَمُ حاسِدِيَّ لِحَرِّ ما",
      "ajuz": "ضَمَّت صُدورُهُمُ مِنَ الأَوغارِ"
    },
    {
      "n": 76,
      "sadr": "نَظَروا صَنيعَ اللَّهِ بي فَعُيونُهُم",
      "ajuz": "في جَنَّةٍ وَقُلوبُهُم في نارِ"
    },
    {
      "n": 77,
      "sadr": "لا ذَنبَ لي قَد رُمتُ كَتمَ فَضائِلي",
      "ajuz": "فَكَأَنَّما بَرقَعتُ وَجهَ نَهاري"
    },
    {
      "n": 78,
      "sadr": "وَسَتَرتُها بِتَواضُعي فَتَطَلَّعَت",
