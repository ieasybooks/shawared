  "abyat": [
    {"n": 1, "sadr": "بَكَيتُ عَلى الشَّبابِ بِدَمعِ عَيني", "ajuz": "فَلَم يُغنِ البُكاءُ وَلا النَّحيبُ"},
    {"n": 2, "sadr": "فَيا أَسَفاً أَسِفتُ عَلى شَبابٍ", "ajuz": "نَعاهُ الشَّيبُ وَالرَّأسُ الخَضيبُ"},
    {"n": 3, "sadr": "عَريتُ مِنَ الشَّبابِ وَكانَ غَضّاً", "ajuz": "كَما يَعرى مِنَ الوَرَقِ القَضيبُ"},
    {"n": 4, "sadr": "فَيا لَيتَ الشَّبابَ يَعودُ يَوماً", "ajuz": "فَأُخبِرَهُ بِما صَنَعَ المَشيبُ"}
