{
  "id": "la-khayla-indaka",
  "poet": "al-mutanabbi",
  "title": "لا خَيلَ عِندَكَ تُهديها وَلا مالُ",
  "meter": "basit",
  "themes": ["madh", "karam"],
  "rawiy": "ل",
  "abyat_in_full": 46,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "لا خَيلَ عِندَكَ تُهديها وَلا مالُ",
      "ajuz": "فَليُسعِدِ النُّطقُ إِن لَم تُسعِدِ الحالُ"
    },
    {
      "n": 2,
      "sadr": "وَاجزِ الأَميرَ الَّذي نُعماهُ فاجِئَةٌ",
      "ajuz": "بِغَيرِ قَولٍ وَنُعمى النّاسِ أَقوالُ"
    },
    {
      "n": 3,
      "sadr": "فَرُبَّما جَزِيَ الإِحسانَ مولِيَهُ",
      "ajuz": "خَريدَةٌ مِن عَذارى الحَيِّ مِكسالُ"
    },
    {
      "n": 4,
      "sadr": "وَإِن تَكُن مُحكَماتُ الشُّكلِ تَمنَعُني",
      "ajuz": "ظُهورَ جَريٍ فَلي فيهِنَّ تَصهالُ"
    },
    {
      "n": 5,
      "sadr": "وَما شَكَرتُ لِأَنَّ المالَ فَرَّحَني",
      "ajuz": "سِيّانِ عِندِيَ إِكثارٌ وَإِقلالُ"
    },
    {
      "n": 6,
      "sadr": "لَكِن رَأَيتُ قَبيحاً أَن يُجادَ لَنا",
      "ajuz": "وَأَنَّنا بِقَضاءِ الحَقِّ بُخّالُ"
    },
    {
      "n": 7,
      "sadr": "فَكُنتُ مَنبِتَ رَوضِ الحَزنِ باكَرَهُ",
      "ajuz": "غَيثٌ بِغَيرِ سِباخِ الأَرضِ هَطّالُ"
    },
    {
      "n": 8,
      "sadr": "غَيثٌ يُبَيِّنُ لِلنُّظّارِ مَوقِعُهُ",
      "ajuz": "أَنَّ الغُيوثَ بِما تَأتيهِ جُهّالُ"
    },
    {
      "n": 9,
      "sadr": "لا يُدرِكُ المَجدَ إِلّا سَيِّدٌ فَطِنٌ",
      "ajuz": "لِما يَشُقُّ عَلى السّاداتِ فَعّالُ"
    },
    {
      "n": 10,
      "sadr": "لا وارِثٌ جَهِلَت يُمناهُ ما وَهَبَت",
      "ajuz": "وَلا كَسوبٌ بِغَيرِ السَّيفِ سَأّالُ"
    },
    {
      "n": 11,
      "sadr": "قالَ الزَّمانُ لَهُ قَولاً فَأَفهَمَهُ",
      "ajuz": "إِنَّ الزَّمانَ عَلى الإِمساكِ عَذّالُ"
    },
    {
      "n": 12,
      "sadr": "تَدري القَناةُ إِذا اِهتَزَّت بِراحَتِهِ",
      "ajuz": "أَنَّ الشَّقِيَّ بِها خَيلٌ وَأَبطالُ"
    },
    {
      "n": 13,
      "sadr": "كَفاتِكٍ وَدُخولُ الكافِ مَنقَصَةٌ",
      "ajuz": "كَالشَّمسِ قُلتُ وَما لِلشَّمسِ أَمثالُ"
    },
    {
      "n": 14,
      "sadr": "القائِدِ الأُسدَ غَذَّتها بَراثِنُهُ",
      "ajuz": "بِمِثلِها مِن عِداهُ وَهيَ أَشبالُ"
    },
    {
      "n": 15,
      "sadr": "القاتِلِ السَّيفَ في جِسمِ القَتيلِ بِهِ",
      "ajuz": "وَلِلسُّيوفِ كَما لِلنّاسِ آجالُ"
    },
    {
      "n": 16,
      "sadr": "تُغيرُ عَنهُ عَلى الغاراتِ هَيبَتُهُ",
      "ajuz": "وَمالُهُ بِأَقاصي الأَرضِ أَهمالُ"
    },
    {
      "n": 17,
      "sadr": "لَهُ مِنَ الوَحشِ ما اِختارَت أَسِنَّتُهُ",
      "ajuz": "عَيرٌ وَهَيقٌ وَخَنساءٌ وَذَيّالُ"
    },
    {
      "n": 18,
      "sadr": "تُمسي الضُّيوفُ مُشَهّاةً بِعَقوَتِهِ",
      "ajuz": "كَأَنَّ أَوقاتَها في الطّيبِ آصالُ"
    },
    {
      "n": 19,
      "sadr": "لَوِ اِشتَهَت لَحمَ قاريها لَبادَرَها",
      "ajuz": "خَرادِلٌ مِنهُ في الشّيزى وَأَوصالُ"
    },
    {
      "n": 20,
      "sadr": "لا يَعرِفُ الرُّزءَ في مالٍ وَلا وَلَدٍ",
      "ajuz": "إِلّا إِذا حَفَزَ الأَضيافَ تَرحالُ"
    },
    {
      "n": 21,
      "sadr": "يُروي صَدى الأَرضِ مِن فَضلاتِ ما شَرِبوا",
      "ajuz": "مَحضُ اللِّقاحِ وَصافي اللَّونِ سَلسالُ"
    },
    {
      "n": 22,
      "sadr": "تَقري صَوارِمُهُ السّاعاتِ عَبطَ دَمٍ",
      "ajuz": "كَأَنَّما السّاعُ نُزّالٌ وَقُفّالُ"
    },
    {
      "n": 23,
      "sadr": "تَجري النُّفوسُ حَوالَيهِ مُخَلَّطَةً",
      "ajuz": "مِنها عُداةٌ وَأَغنامٌ وَآبالُ"
    },
    {
      "n": 24,
      "sadr": "لا يَحرِمُ البُعدُ أَهلَ البُعدِ نائِلَهُ",
      "ajuz": "وَغَيرُ عاجِزَةٍ عَنهُ الأُطَيفالُ"
    },
    {
      "n": 25,
      "sadr": "أَمضى الفَريقَينِ في أَقرانِهِ ظُبَةً",
      "ajuz": "وَالبيضُ هادِيَةٌ وَالسُّمرُ ضُلّالُ"
    },
    {
      "n": 26,
      "sadr": "يُريكَ مَخبَرُهُ أَضعافَ مَنظَرِهِ",
      "ajuz": "بَينَ الرِّجالِ وَفيها الماءُ وَالآلُ"
    },
    {
      "n": 27,
      "sadr": "وَقَد يُلَقِّبُهُ المَجنونَ حاسِدُهُ",
      "ajuz": "إِذا اِختَلَطنَ وَبَعضُ العَقلِ عُقّالُ"
    },
    {
      "n": 28,
      "sadr": "يَرمي بِها الجَيشَ لا بُدٌّ لَهُ وَلَها",
      "ajuz": "مِن شَقِّهِ وَلَوَ أَنَّ الجَيشَ أَجبالُ"
    },
    {
      "n": 29,
      "sadr": "إِذا العِدى نَشِبَت فيهِم مَخالِبُهُ",
      "ajuz": "لَم يَجتَمِع لَهُمُ حِلمٌ وَرِئبالُ"
    },
    {
      "n": 30,
      "sadr": "يَروعُهُم مِنهُ دَهرٌ صَرفُهُ أَبَداً",
      "ajuz": "مُجاهِرٌ وَصُروفُ الدَّهرِ تَغتالُ"
    },
    {
      "n": 31,
      "sadr": "أَنالَهُ الشَّرَفَ الأَعلى تَقَدُّمُهُ",
      "ajuz": "فَما الَّذي بِتَوَقّي ما أَتى نالوا"
    },
    {
      "n": 32,
      "sadr": "إِذا المُلوكُ تَحَلَّت كانَ حِليَتَهُ",
      "ajuz": "مُهَنَّدٌ وَأَصَمُّ الكَعبِ عَسّالُ"
    },
    {
      "n": 33,
      "sadr": "أَبو شُجاعٍ أَبو الشُّجعانِ قاطِبَةً",
      "ajuz": "هَولٌ نَمَتهُ مِنَ الهَيجاءِ أَهوالُ"
    },
    {
      "n": 34,
      "sadr": "تَمَلَّكَ الحَمدَ حَتّى ما لِمُفتَخِرٍ",
      "ajuz": "في الحَمدِ حاءٌ وَلا ميمٌ وَلا دالُ"
    },
    {
      "n": 35,
      "sadr": "عَلَيهِ مِنهُ سَرابيلٌ مُضاعَفَةٌ",
      "ajuz": "وَقَد كَفاهُ مِنَ الماذِيِّ سِربالُ"
    },
    {
      "n": 36,
      "sadr": "وَكَيفَ أَستُرُ ما أَولَيتَ مِن حَسَنٍ",
      "ajuz": "وَقَد غَمَرتَ نَوالاً أَيُّها النّالُ"
    },
    {
      "n": 37,
      "sadr": "لَطَّفتَ رَأيَكَ في بِرّي وَتَكرِمَتي",
      "ajuz": "إِنَّ الكَريمَ عَلى العَلياءِ يَحتالُ"
    },
    {
      "n": 38,
      "sadr": "حَتّى غَدَوتَ وَلِلأَخبارِ تَجوالُ",
      "ajuz": "وَلِلكَواكِبِ في كَفَّيكَ آمالُ"
    },
    {
      "n": 39,
      "sadr": "وَقَد أَطالَ ثَنائي طولُ لابِسِهِ",
      "ajuz": "إِنَّ الثَّناءَ عَلى التِّنبالِ تِنبالُ"
    },
    {
      "n": 40,
      "sadr": "إِن كُنتَ تَكبُرُ أَن تَختالَ في بَشَرٍ",
      "ajuz": "فَإِنَّ قَدرَكَ في الأَقدارِ يَختالُ"
    },
    {
      "n": 41,
      "sadr": "كَأَنَّ نَفسَكَ لا تَرضاكَ صاحِبَها",
      "ajuz": "إِلّا وَأَنتَ عَلى المِفضالِ مِفضالُ"
    },
    {
      "n": 42,
      "sadr": "وَلا تَعُدُّكَ صَوّاناً لِمُهجَتِها",
      "ajuz": "إِلّا وَأَنتَ لَها في الرَّوعِ بَذّالُ"
    },
    {
      "n": 43,
      "sadr": "لَولا المَشَقَّةُ سادَ النّاسُ كُلُّهُمُ",
      "ajuz": "الجودُ يُفقِرُ وَالإِقدامُ قَتّالُ"
    },
    {
      "n": 44,
      "sadr": "وَإِنَّما يَبلُغُ الإِنسانُ طاقَتَهُ",
      "ajuz": "ما كُلُّ ماشِيَةٍ بِالرَّحلِ شِملالُ"
    },
    {
      "n": 45,
      "sadr": "إِنّا لَفي زَمَنٍ تَركُ القَبيحِ بِهِ",
      "ajuz": "مِن أَكثَرِ النّاسِ إِحسانٌ وَإِجمالُ"
    },
    {
      "n": 46,
      "sadr": "ذِكرُ الفَتى عُمرُهُ الثّاني وَحاجَتُهُ",
      "ajuz": "ما قاتَهُ وَفُضولُ العَيشِ أَشغالُ"
    }
  ]
}
