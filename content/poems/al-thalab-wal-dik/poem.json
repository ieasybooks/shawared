{
  "id": "al-thalab-wal-dik",
  "poet": "ahmad-shawqi",
  "title": "الثَّعلَبُ وَالدّيكُ",
  "meter": "ramal",
  "themes": ["fables"],
  "rawiy": "ن",
  "abyat_in_full": 13,
  "added": "2026-11-24",
  "abyat": [
    {"n": 1, "sadr": "بَرَزَ الثَّعلَبُ يَوماً", "ajuz": "في شِعارِ الواعِظينا"},
    {"n": 2, "sadr": "فَمَشى في الأَرضِ يَهذي", "ajuz": "وَيَسُبُّ الماكِرينا"},
    {"n": 3, "sadr": "وَيَقولُ الحَمدُ لِلَّ", "ajuz": "هِ إِلَهِ العالَمينا"},
    {"n": 4, "sadr": "يا عِبادَ اللَّهِ توبوا", "ajuz": "فَهوَ مَأوى التّائِبينا"},
    {"n": 5, "sadr": "وَازهَدوا في الطَّيرِ إِنَّ ال", "ajuz": "عَيشَ عَيشُ الزّاهِدينا"},
    {"n": 6, "sadr": "وَاطلُبوا الدّيكَ يُؤَذِّن", "ajuz": "لِصَلاةِ الصُّبحِ فينا"},
    {"n": 7, "sadr": "فَأَتى الدّيكَ رَسولٌ", "ajuz": "مِن إِمامِ النّاسِكينا"},
    {"n": 8, "sadr": "عَرَضَ الأَمرَ عَلَيهِ", "ajuz": "وَهوَ يَرجو أَن يَلينا"},
    {"n": 9, "sadr": "فَأَجابَ الدّيكُ عُذراً", "ajuz": "يا أَضَلَّ المُهتَدينا"},
    {"n": 10, "sadr": "بَلِّغِ الثَّعلَبَ عَنّي", "ajuz": "عَن جُدودي الصّالِحينا"},
    {"n": 11, "sadr": "عَن ذَوي التّيجانِ مِمَّن", "ajuz": "دَخَلَ البَطنَ اللَّعينا"},
    {"n": 12, "sadr": "أَنَّهُم قالوا وَخَيرُ ال", "ajuz": "قَولِ قَولُ العارِفينا"},
    {"n": 13, "sadr": "مُخطِئٌ مَن ظَنَّ يَوماً", "ajuz": "أَنَّ لِلثَّعلَبِ دينا"}
  ]
}
