{
  "id": "ya-sulama",
  "poet": "ihab-al-shabatat",
  "title": "يا سُلامى طابَ لي مِنها سَلاما",
  "meter": "ramal",
  "rawiy": "م",
  "abyat_in_full": 16,
  "added": "2026-11-19",
  "abyat": [
    { "n": 1, "sadr": "يا سُلامى طابَ لي مِنها سَلاما", "ajuz": "نَفَسُ الأُمِّ بِأَنفاسِ الخُزامى" },
    { "n": 2, "sadr": "وَاِقطَعي عَن خافِقي شاهِقَةً", "ajuz": "ثَقُلَت أُمّي مَديداً أَو لِماما" },
    { "n": 3, "sadr": "وَصِلي لَيلَكِ بي ساجِدَةً", "ajuz": "عَلَّ روحي أَرضَ أُمّي تَتَسامى" },
    { "n": 4, "sadr": "وَدَعيها خَطَراتي بِالهَوى", "ajuz": "إِن يَنَم شَوقٌ فَما كانَت نِياما" },
    { "n": 5, "sadr": "شَوقُ صَبٍّ ما أَراهُ كاذِباً", "ajuz": "إِن يَغِب يَأتِ وَإِن غابَ تَنامى" },
    { "n": 6, "sadr": "وَأَرى أُمّي أَمامي لَحظَةً", "ajuz": "حينَ عَيني عَن فِراقٍ تَتَعامى" },
    { "n": 7, "sadr": "وَحَنَنتُ الشّايَ مِن إِبريقِها", "ajuz": "سُكَّرٌ إِن زِدتُهُ خانَ مَراما" },
    { "n": 8, "sadr": "أَوثَقَتني غُربَتي لا قَسوَتي", "ajuz": "إِن بَريدي طارَ شِعراً وَحَماما" },
    { "n": 9, "sadr": "جَسَدي فُلَّ وَروحي مَع حِمى", "ajuz": "أَلفِ حَدٍّ مِن حَديدٍ تَتَرامى" },
    { "n": 10, "sadr": "وَطَبيبٍ جَسَّ قَلبي قائِلاً", "ajuz": "ضيقُ صَدرٍ أَمرُهُ بانَ سَلاما" },
    { "n": 11, "sadr": "طِبُّهُ لَم يَعلَمِ النّارَ بِهِ", "ajuz": "فِطرُها لَيلي وَإِن صابَ صِياما" },
    { "n": 12, "sadr": "وَهَبيني بِعُيوني غائِباً", "ajuz": "فَدُموعي مَع هَداياكِ نَدامى" },
    { "n": 13, "sadr": "اِعتِدالٌ لَيسَ اِسماً إِنَّما", "ajuz": "قيمَةٌ فيكِ تَراءَتِ اِنسِجاما" },
    { "n": 14, "sadr": "لَو رَأَت ناسٌ عُبوساً ساعَةً", "ajuz": "حينَ تَقسينَ لَظَنّوهُ اِبتِساما" },
    { "n": 15, "sadr": "لَم تَكوني لَهُمُ أُمّاً وَلَو", "ajuz": "صِرتِ ظَنّوا أَنَّهُم كانوا يَتامى" },
    { "n": 16, "sadr": "وَسَلامُ اللَّهِ تُرباً قَد حَوى", "ajuz": "جَسَدي إِن قُلتِ لي يَوماً مَلاما" }
  ]
}
