{
  "id": "qalat-wa-lam-taqsid",
  "poet": "abu-qays-ibn-al-aslat",
  "title": "قالَت وَلَم تَقصِد لِقيلِ الخَنا",
  "meter": "sari",
  "themes": ["fakhr", "hamasa"],
  "rawiy": "ع",
  "abyat_in_full": 24,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "قالَت وَلَم تَقصِد لِقيلِ الخَنا",
      "ajuz": "مَهلاً فَقَد أَبلَغتَ إِسماعي"
    },
    {
      "n": 2,
      "sadr": "أَنكَرتِهِ حينَ تَوَسَّمتِهِ",
      "ajuz": "وَالحَربُ غولٌ ذاتُ أَوجاعِ"
    },
    {
      "n": 3,
      "sadr": "مَن يَذُقِ الحَربَ يَجِد طَعمَها",
      "ajuz": "مُرّاً وَتَحبِسهُ بِجَعجاعِ"
    },
    {
      "n": 4,
      "sadr": "قَد حَصَّتِ البَيضَةُ رَأسي فَما",
      "ajuz": "أَطعَمُ غُمضاً غَيرَ تَهجاعِ"
    },
    {
      "n": 5,
      "sadr": "أَسعى عَلى جُلِّ بَني مالِكٍ",
      "ajuz": "كُلُّ اِمرِئٍ في شَأنِهِ ساعِ"
    },
    {
      "n": 6,
      "sadr": "أَعدَدتُ لِلأَعداءِ مَوضونَةً",
      "ajuz": "فَضفاضَةً كَالنِّهيِ بِالقاعِ"
    },
    {
      "n": 7,
      "sadr": "أَحفِزُها عَنّي بِذي رَونَقٍ",
      "ajuz": "مُهَنَّدٍ كَالمِلحِ قَطّاعِ"
    },
    {
      "n": 8,
      "sadr": "صَدقٍ حُسامٍ وادِقٍ حَدُّهُ",
      "ajuz": "وَمُجنَإٍ أَسمَرَ قَرّاعِ"
    },
    {
      "n": 9,
      "sadr": "بَزِّ اِمرِئٍ مُستَبسِلٍ حاذِرٍ",
      "ajuz": "لِلدَّهرِ جَلدٍ غَيرِ مِجزاعِ"
    },
    {
      "n": 10,
      "sadr": "الحَزمُ وَالقُوَّةُ خَيرٌ مِنَ",
      "ajuz": "الإِدهانِ وَالفَكَّةِ وَالهاعِ"
    },
    {
      "n": 11,
      "sadr": "لَيسَ قَطاً مِثلَ قُطَيٍّ وَلا",
      "ajuz": "المَرعِيُّ في الأَقوامِ كَالرّاعي"
    },
    {
      "n": 12,
      "sadr": "لا نَألَمُ القَتلَ وَنَجزي بِهِ",
      "ajuz": "الأَعداءَ كَيلَ الصّاعِ بِالصّاعِ"
    },
    {
      "n": 13,
      "sadr": "نَذودُهُم عَنّا بِمُستَنَّةٍ",
      "ajuz": "ذاتِ عَرانينَ وَدُفّاعِ"
    },
    {
      "n": 14,
      "sadr": "كَأَنَّهُم أُسدٌ لَدى أَشبُلٍ",
      "ajuz": "يَنهِتنَ في غيلٍ وَأَجزاعِ"
    },
    {
      "n": 15,
      "sadr": "حَتّى تَجَلَّت وَلَنا غايَةٌ",
      "ajuz": "مِن بَينِ جَمعٍ غَيرِ جُمّاعِ"
    },
    {
      "n": 16,
      "sadr": "هَلّا سَأَلتِ الخَيلَ إِذ قَلَّصَت",
      "ajuz": "ما كانَ إِبطائي وَإِسراعي"
    },
    {
      "n": 17,
      "sadr": "هَل أَبذُلُ المالَ عَلى حُبِّهِ",
      "ajuz": "فيهِم وَآتي دَعوَةَ الدّاعي"
    },
    {
      "n": 18,
      "sadr": "وَأَضرِبُ القَونَسَ يَومَ الوَغى",
      "ajuz": "بِالسَّيفِ لَم يَقصُر بِهِ باعي"
    },
    {
      "n": 19,
      "sadr": "وَأَقطَعُ الخَرقَ يُخافُ الرَّدى",
      "ajuz": "فيهِ عَلى أَدماءَ هِلواعِ"
    },
    {
      "n": 20,
      "sadr": "ذاتِ أَساهيجَ جُمَاليَّةٍ",
      "ajuz": "حُشَّت بِحارِيٍّ وَأَقطاعِ"
    },
    {
      "n": 21,
      "sadr": "تُعطي عَلى الأَينِ وَتَنجو مِنَ",
      "ajuz": "الضَّربِ أَمونٍ غَيرِ مِظلاعِ"
    },
    {
      "n": 22,
      "sadr": "كَأَنَّ أَطرافَ وَلِيّاتِها",
      "ajuz": "في شَمأَلٍ حَصّاءَ زَعزاعِ"
    },
    {
      "n": 23,
      "sadr": "أُزَيِّنُ الرَّحلَ بِمَعقومَةٍ",
      "ajuz": "حارِيَّةٍ أَو ذاتِ أَقطاعِ"
    },
    {
      "n": 24,
      "sadr": "أَقضي بِها الحاجاتِ إِنَّ الفَتى",
      "ajuz": "رَهنٌ بِذي لَونَينِ خَدّاعِ"
    }
  ]
}
