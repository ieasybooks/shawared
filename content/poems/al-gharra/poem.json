{
  "id": "al-gharra",
  "poet": "fawwaz-ibn-jurays",
  "title": "الغَرّاءُ",
  "meter": "rajaz",
  "abyat_in_full": 58,
  "added": "2026-11-19",
  "abyat": [
    {"n": 1, "sadr": "الحَمدُ لِلَّهِ الَّذي تَجَلّى", "ajuz": "بِالعَدلِ وَالإِحسانِ ثُمَّ صَلّى"},
    {"n": 2, "sadr": "عَلى النَّبِيِّ القُرَشِيِّ الهادي", "ajuz": "مَن قادَنا لِلنَّصرِ وَالجِهادِ"},
    {"n": 3, "sadr": "فَهاكَ نَظماً في المَغازي مُختَصَر", "ajuz": "يُضيءُ لِلسّاري مَصابيحَ العِبَر"},
    {"n": 4, "sadr": "في عامِهِ الثّاني غَزا وَدّانا", "ajuz": "وَعادَ لَم يَلقَ بِها عُدوانا"},
    {"n": 5, "sadr": "في رابِغٍ عُبَيدَةٌ قَد نَصَبا", "ajuz": "أَوَّلَ رايَةِ الهُدى وَاحتَسَبا"},
    {"n": 6, "sadr": "وَكانَ سَعدٌ في الرُّماةِ الأَوَّلا", "ajuz": "في نُصرَةِ الدّينِ فَأَضحى مَثَلا"},
    {"n": 7, "sadr": "وَقيلَ بَل أَوَّلُ رايَةِ الظَّفَر", "ajuz": "كانَت لِلَيثِ اللَّهِ في سيفِ البَحر"},
    {"n": 8, "sadr": "إِلى بُواطَ في رَبيعِ الأَوَّلِ", "ajuz": "أَمَّ بِجُندِ اللَّهِ خَيرُ الرُّسُلِ"},
    {"n": 9, "sadr": "وَبَعدَها وادَعَ في العُشَيرَةِ", "ajuz": "أَبناءَ مُدلِجٍ وَأَبناءَ ضَمرَةِ"},
    {"n": 10, "sadr": "وَسَيَّرَ المُختارُ لِلخَرّارِ", "ajuz": "سَعداً وَرَهطَهُ خَلا الأَنصارِ"},
    {"n": 11, "sadr": "وَبَعدَها سَفوانُ بَدرُ الأولى", "ajuz": "وَكانَ كُرزٌ إِذ عَدا جَهولا"},
    {"n": 12, "sadr": "وَأَرسَلَ النَّبِيُّ عَبدَ اللَّهِ", "ajuz": "لِنَخلَةٍ وَكانَ غَيرَ لاهي"},
    {"n": 13, "sadr": "وَقالَ لِلشَّهرِ الحَرامِ دونَكا", "ajuz": "فَأُنزِلَت آيَةُ يَسأَلونَكا"},
    {"n": 14, "sadr": "ثُمَّ أَتى العَزيزُ بِالفُرقانِ", "ajuz": "بَينَ جُنودِ الكُفرِ وَالإيمانِ"},
    {"n": 15, "sadr": "في يَومِ الاِثنَينِ لِشَهرِ الصَّومِ", "ajuz": "بَعدَ ثَمانٍ قَد مَضى بِالقَومِ"},
    {"n": 16, "sadr": "أَرادَ عيراً لِقُرَيشٍ أَفلَتَت", "ajuz": "فَقَدَّرَ الإِلَهُ حَرباً سُعِّرَت"},
    {"n": 17, "sadr": "لَكِن أَرادَ عَونَ أَهلِ النُّصرَةِ", "ajuz": "فَقامَ سَعدٌ ناصِراً بِالخُطبَةِ"},
    {"n": 18, "sadr": "وَبَعدَ عَشرٍ ثُمَّ سَبعٍ قَد مَضَت", "ajuz": "تَقاتَلوا وَرُسُلُ رَبّي أُنزِلَت"},
    {"n": 19, "sadr": "حَتّى أَصابوا في الوَغى سَبعينا", "ajuz": "وَمِثلُهُم أَسرى مُصَفَّدينا"},
    {"n": 20, "sadr": "وَاذكُر عُمَيراً قَتلَهُ العَصماءَ", "ajuz": "وَسالِماً لَبّى لَهُ النِّداءَ"},
    {"n": 21, "sadr": "وَبَعدَها لِلكُدرِ سَلَّ صارِما", "ajuz": "إِلى سُلَيمٍ ثُمَّ عادَ سالِما"},
    {"n": 22, "sadr": "ثُمَّ السَّويقُ إِذ أَغارَ صَخرُ", "ajuz": "حَتّى رَأى الرَّسولَ قالَ فِرّوا"},
    {"n": 23, "sadr": "ثُمَّ أَطالَ المُكثَ في شَهرِ صَفَر", "ajuz": "مُرابِطاً لِلَّهِ وَسطَ ذي أَمَر"},
    {"n": 24, "sadr": "وَرابَطوا مِن بَعدُ في بُحرانا", "ajuz": "شَهرَينِ لَم يَلقَوا بِها طِعانا"},
    {"n": 25, "sadr": "وَغَدرُ قَينُقاعَ بِالعُهودِ", "ajuz": "وَالخُبثُ مِن جِبِلَّةِ اليَهودِ"},
    {"n": 26, "sadr": "وَزَيدٌ إِذ رَسولُ رَبّي أَسنَدَه", "ajuz": "لِنَيلِ عيرِ القَومِ عِندَ القَرَدَه"},
    {"n": 27, "sadr": "وَاذكُر بِشَوّالٍ مَسيراً في أُحُد", "ajuz": "ثُمَّ نَفيراً نَحوَ حَمراءِ الأَسَد"},
    {"n": 28, "sadr": "إِذ خالَفَ الرُّماةُ لِلغَنيمَةِ", "ajuz": "وَكانَ دَرساً لِعُصاةِ الشِّرعَةِ"},
    {"n": 29, "sadr": "وَبَعدَها الرَّجيعُ ثُمَّ بِئرُ", "ajuz": "مَعونَةٍ فيهِم تَجَلّى الغَدرُ"},
    {"n": 30, "sadr": "ثُمَّ بَنو النَّضيرِ مَكرُهُم ظَهَر", "ajuz": "أَجلاهُمُ المُختارُ في آيِ الحَشر"},
    {"n": 31, "sadr": "في رابِعٍ ذاتُ الرِّقاعِ أُرِّخَت", "ajuz": "فيها صَلاةُ الخَوفِ حَقّاً شُرِّعَت"},
    {"n": 32, "sadr": "ثُمَّ غَزا يُريدُ بَدرَ المَوعِدِ", "ajuz": "وَدومَةَ الجَندَلِ بَعدُ فَاعدُدِ"},
    {"n": 33, "sadr": "وَابنُ أُنَيسٍ جَندَلَ الفُرسانا", "ajuz": "بِنَخلَةٍ لِيَقتُلَ الشَّيطانا"},
    {"n": 34, "sadr": "وَاجتَمَعَ الأَحزابُ عِندَ الخَندَقِ", "ajuz": "وَما وَفَت قُرَيظَةٌ بِالمَوثِقِ"},
    {"n": 35, "sadr": "فَأَرسَلَ اللَّهُ عَلَيهِم جُندَهُ", "ajuz": "بِقَهرِ جَيشِ الشِّركِ أَوفى وَعدَهُ"},
    {"n": 36, "sadr": "وَابنُ مُعاذٍ قامَ بِالتَّحكيمِ", "ajuz": "وَاهتَزَّ عَرشُ المَلِكِ العَظيمِ"},
    {"n": 37, "sadr": "وَاذكُر بَني لِحيانَ وَاذكُر ذا قَرَد", "ajuz": "عَدا الفَزارِيُّ عَلى سَرحِ البَلَد"},
    {"n": 38, "sadr": "ثُمَّ المُرَيسيعُ وَقيلَ أُرِّخَت", "ajuz": "في رابِعٍ إِذ أُمُّنا قَد بُرِّئَت"},
    {"n": 39, "sadr": "قَد سارَ زَيدٌ باغِتاً جُذاما", "ajuz": "وَكادَ يَلقى بَعدَها الحِماما"},
    {"n": 40, "sadr": "وَاذكُر مَسيرَ كُرزٍ وَابنِ عَوفِ", "ajuz": "لِدومَةِ الجَندَلِ دونَ خَوفِ"},
    {"n": 41, "sadr": "وَمَصرَعَ اليُسَيرِ دونَ خَيبَرِ", "ajuz": "وَابنَ أُثالٍ ما رَواهُ المَقبُري"},
    {"n": 42, "sadr": "وَعامِراً إِذ سارَ وَالجَيشُ اِفتَقَر", "ajuz": "فَأَخرَجَ اللَّهُ لَهُم حوتَ البَحَر"},
    {"n": 43, "sadr": "ثُمَّ أَقامَ مَع قُرَيشٍ صُلحا", "ajuz": "سَمّاهُ رَبّي في الكِتابِ فَتحا"},
    {"n": 44, "sadr": "في أَوَّلِ السّابِعِ فَتحُ خَيبَرِ", "ajuz": "وَوافَقَ النَّصرُ قُدومَ جَعفَرِ"},
    {"n": 45, "sadr": "وَسارَ رَكبُ غالِبٍ لِمُرَّةِ", "ajuz": "وَابنُ أَبي حَدرَدٍ نَحوَ الغابَةِ"},
    {"n": 46, "sadr": "وَمَديَنٌ دانَت لِزَيدٍ الغالِبِ", "ajuz": "وَسارَ لِلكُدَيدِ رَكبُ غالِبِ"},
    {"n": 47, "sadr": "وَعَمرٌو في ذاتِ السَّلاسِلِ اِلتَحَم", "ajuz": "وَابنُ أَبي حَدرَدٍ في بَطنِ إِضَم"},
    {"n": 48, "sadr": "وَمُؤتَةٌ زَيدٌ تَقَدَّمَ المَلا", "ajuz": "فَجَعفَرٌ فَابنُ رَواحَةٍ تَلا"},
    {"n": 49, "sadr": "ثُمَّ أَتى الفَتحُ وَزالَ الباطِلُ", "ajuz": "في مَكَّةٍ وَدانَتِ القَبائِلُ"},
    {"n": 50, "sadr": "وَاذكُر حُنَيناً عُجبَهُم بِالكَثرَةِ", "ajuz": "لا يُغلَبَنَّ جَيشُنا مِن قِلَّةِ"},
    {"n": 51, "sadr": "فَثَبَّتَ اللَّهُ النَّبِيَّ وَانتَصَر", "ajuz": "ثُمَّ إِلى الطّائِفِ حَثَّ مَن حَضَر"},
    {"n": 52, "sadr": "في تاسِعٍ سارَ إِلى تَبوكِ", "ajuz": "فَزُعزِعَت مَكانَةُ المُلوكِ"},
    {"n": 53, "sadr": "يُحَنَّةٌ صالَحَهُم بِالجِزيَةِ", "ajuz": "وَخالِدٌ صَفَّدَ مَلِكَ دَومَةِ"},
    {"n": 54, "sadr": "عُيَينَةٌ صَبَّحَ حَيَّ العَنبَرِ", "ajuz": "وَابنُ مُجَزِّزٍ أَتى لَم يَثأَرِ"},
    {"n": 55, "sadr": "سارَ عَلِيٌّ لِلجَنوبِ وَاقتَفى", "ajuz": "في حَجِّهِ إِذ عادَ فِعلَ المُصطَفى"},
    {"n": 56, "sadr": "وَأَمَّرَ المُختارُ نَحوَ الشّامِ", "ajuz": "أُسامَةً فَفازَ بِالخِتامِ"},
    {"n": 57, "sadr": "فَالحَمدُ لِلَّذي تَجَلّى وَاعتَلى", "ajuz": "وَصَلِّ يا رَبِّ عَلى خَيرِ المَلا"},
    {"n": 58, "sadr": "وَآلِهِ وَصَحبِهِ وَمَن تَبِع", "ajuz": "آثارَهُم وَمِن سَنا الحَقِّ اِنتَفَع"}
  ]
}
