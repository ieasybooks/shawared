{
  "id": "hawaya-maa-al-rakbi",
  "poet": "jafar-ibn-ulba",
  "title": "هَوايَ مَعَ الرَّكبِ اليَمانينَ مُصعِدٌ",
  "meter": "tawil",
  "themes": ["shawq", "hamasa"],
  "rawiy": "ق",
  "abyat_in_full": 9,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "هَوايَ مَعَ الرَّكبِ اليَمانينَ مُصعِدٌ",
      "ajuz": "جَنيبٌ وَجُثماني بِمَكَّةَ موثَقُ"
    },
    {
      "n": 2,
      "sadr": "عَجِبتُ لِمَسراها وَأَنّى تَخَلَّصَت",
      "ajuz": "إِلَيَّ وَبابُ السِّجنِ دونِيَ مُغلَقُ"
    },
    {
      "n": 3,
      "sadr": "أَلَمَّت فَحَيَّت ثُمَّ قامَت فَوَدَّعَت",
      "ajuz": "فَلَمّا تَوَلَّت كادَتِ النَّفسُ تَزهَقُ"
    },
    {
      "n": 4,
      "sadr": "فَما بَرِحَت حَتّى وَدِدتُ بِأَنَّني",
      "ajuz": "بِما في فُؤادي مِن دَمِ الجَوفِ أَشرَقُ"
    },
    {
      "n": 5,
      "sadr": "فَلا تَحسَبي أَنّي تَخَشَّعتُ بَعدَكُم",
      "ajuz": "لِشَيءٍ وَلا أَنّي مِنَ المَوتِ أَفرَقُ"
    },
    {
      "n": 6,
      "sadr": "وَلا أَنَّ نَفسي يَزدَهيها وَعيدُكُم",
      "ajuz": "وَلا أَنَّني بِالمَشيِ في القَيدِ أَخرَقُ"
    },
    {
      "n": 7,
      "sadr": "وَكَيفَ وَفي نَفسي حُسامٌ مُذَلَّقٌ",
      "ajuz": "يَعَضُّ بِهاماتِ الرِّجالِ وَيَفلِقُ"
    },
    {
      "n": 8,
      "sadr": "وَلَكِن عَرَتني مِن هَواكِ صَبابَةٌ",
      "ajuz": "كَما كُنتُ أَلقى مِنكِ إِذ أَنا مُطلَقُ"
    }
  ]
}
