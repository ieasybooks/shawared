{
  "id": "baduna-wa-in-jawaratna",
  "poet": "lisan-al-din-ibn-al-khatib",
  "title": "بَعُدنا وَإِن جاوَرَتنا البُيوت",
  "meter": "mutaqarib",
  "rawiy": "ت",
  "abyat_in_full": 8,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1, "sadr": "بَعُدنا وَإِن جاوَرَتنا البُيوت", "ajuz": "وَجِئنا بِوَعظٍ وَنَحنُ صُموت" },
    { "n": 2, "sadr": "وَأَنفاسُنا سَكَتَت دُفعَةً", "ajuz": "كَجَهرِ الصَّلاةِ تَلاهُ القُنوت" },
    { "n": 3, "sadr": "وَكُنّا عِظاماً فَصِرنا عِظاماً", "ajuz": "وَكُنّا نَقوتُ فَها نَحنُ قوت" },
    { "n": 4, "sadr": "وَكُنّا شُموسَ سَماءِ العُلا", "ajuz": "غَرَبنَ فَناحَت عَلَيها البُيوت" },
    { "n": 5, "sadr": "فَكَم جَدَّلَت ذا الحُسامِ الظُّبا", "ajuz": "وَذا البَختِ كَم خَذَلَتهُ البُخوت" },
    { "n": 6, "sadr": "وَكَم سيقَ لِلقَبرِ في خِرقَةٍ", "ajuz": "فَتىً مُلِئَت مِن كُساهُ التُّخوت" },
    { "n": 7, "sadr": "فَقُل لِلعِدا ذَهَبَ اِبنُ الخَطيبِ", "ajuz": "وَفاتَ وَمَن ذا الَّذي لا يَفوت" },
    { "n": 8, "sadr": "فَمَن كانَ يَفرَحُ مِنكُم لَهُ", "ajuz": "فَقُل يَفرَحُ اليَومَ مَن لا يَموت" }
  ]
}
