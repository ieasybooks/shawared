{
  "id": "wa-sariyatin-tartadu",
  "poet": "ali-ibn-al-jahm",
  "title": "وَسارِيَةٍ تَرتادُ أَرضاً تَجودُها",
  "meter": "tawil",
  "rawiy": "د",
  "abyat_in_full": 48,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "وَسارِيَةٍ تَرتادُ أَرضاً تَجودُها",
      "ajuz": "شَغَلتُ بِها عَيناً قَليلاً هُجودُها"
    },
    {
      "n": 2,
      "sadr": "أَتَتنا بِها ريحُ الصَّبا وَكَأَنَّها",
      "ajuz": "فَتاةٌ تُزَجّيها عَجوزٌ تَقودُها"
    },
    {
      "n": 3,
      "sadr": "تَميسُ بِها مَيساً فَلا هِيَ إِن وَنَت",
      "ajuz": "نَهَتها وَلا إِن أَسرَعَت تَستَعيدُها"
    },
    {
      "n": 4,
      "sadr": "إِذا فارَقَتها ساعَةً وَلِهَت بِها",
      "ajuz": "كَأُمِّ وَليدٍ غابَ عَنها وَليدُها"
    },
    {
      "n": 5,
      "sadr": "فَلَمّا أَضَرَّت بِالعُيونِ بُروقُها",
      "ajuz": "وَكادَت تُصِمُّ السّامِعينَ رُعودُها"
    },
    {
      "n": 6,
      "sadr": "وَكادَت تَميسُ الأَرضُ إِمّا تَلَهُّفاً",
      "ajuz": "وَإِمّا حِذاراً أَن يَضيعَ مُريدُها"
    },
    {
      "n": 7,
      "sadr": "فَلَمّا رَأَت حُرَّ الثَّرى مُتَعَقِّداً",
      "ajuz": "بِما زَلَّ مِنها وَالرُّبى تَستَزيدُها"
    },
    {
      "n": 8,
      "sadr": "وَأَنَّ أَقاليمَ العِراقِ فَقيرَةٌ",
      "ajuz": "إِلَيها أَقامَت بِالعِراقِ تَجودُها"
    },
    {
      "n": 9,
      "sadr": "فَما بَرِحَت بَغدادَ حَتّى تَفَجَّرَت",
      "ajuz": "بِأَودِيَةٍ ما تَستَفيقُ مُدودُها"
    },
    {
      "n": 10,
      "sadr": "وَحَتّى رَأَينا الطَّيرَ في جَنَباتِها",
      "ajuz": "تَكادُ أَكُفُّ الغانِياتِ تَصيدُها"
    },
    {
      "n": 11,
      "sadr": "وَحَتّى اِكتَسَت مِن كُلِّ نَورٍ كَأَنَّها",
      "ajuz": "عَروسٌ زَهاها وَشيُها وَبُرودُها"
    },
    {
      "n": 12,
      "sadr": "دَعَتها إِلى حَلِّ النِّطاقِ فَأَرعَشَت",
      "ajuz": "إِلَيها وَجَرَّت سِمطُها وَفَريدُها"
    },
    {
      "n": 13,
      "sadr": "وَدِجلَةُ كَالدِّرعِ المُضاعَفِ نَسجُها",
      "ajuz": "لَها حَلَقٌ يَبدو وَيَخفى حَديدُها"
    },
    {
      "n": 14,
      "sadr": "فَلَمّا قَضَت حَقَّ العِراقِ وَأَهلِهِ",
      "ajuz": "أَتاها مِنَ الرّيحِ الشَّمالِ بَريدُها"
    },
    {
      "n": 15,
      "sadr": "فَمَرَّت تَفوتُ الطَّرفَ سَبقاً كَأَنَّما",
      "ajuz": "جُنودُ عُبَيدِ اللَّهِ وَلَّت بُنودُها"
    },
    {
      "n": 16,
      "sadr": "وَخَلَّت أَميرَ المُؤمِنينَ مُجَدَّلاً",
      "ajuz": "شَهيداً وَمِن خَيرِ المُلوكِ شَهيدُها"
    },
    {
      "n": 17,
      "sadr": "وَكانَ أَضاعَ الحَزمَ وَاِتَّبَعَ الهَوى",
      "ajuz": "وَوَكَّلَ غِرّاً بِالجُيوشِ يَقودُها"
    },
    {
      "n": 18,
      "sadr": "كَأَنَّهُمُ لَم يَعلَموا أَنَّ بَيعَةً",
      "ajuz": "أَحاطَت بِأَعناقِ الرِّجالِ عُقودُها"
    },
    {
      "n": 19,
      "sadr": "فَلَمّا اِقتَضاها لَيلَةَ الرَّوعِ حَقَّهُ",
      "ajuz": "جَرَت سُنُحاً ساداتُها وَمَسودُها"
    },
    {
      "n": 20,
      "sadr": "وَباتَت خَبايا كَالبَغايا جُنودُهُ",
      "ajuz": "وَفي زَورَقِ الصَّيّادِ باتَ عَميدُها"
    },
    {
      "n": 21,
      "sadr": "بَلى وَقَفَ الفَتحُ اِبنُ خاقانَ وَقفَةً",
      "ajuz": "فَأَعذَرَ مَولى هاشِمٍ وَتَليدُها"
    },
    {
      "n": 22,
      "sadr": "وَجادَ بِنَفسٍ حُرَّةٍ سَهَّلَت لَهُ",
      "ajuz": "وُرودَ المَنايا حَيثُ يُخشى وُرودُها"
    },
    {
      "n": 23,
      "sadr": "وَفَرَّ عُبَيدُ اللَّهِ فيمَن أَطاعَهُ",
      "ajuz": "إِلى سَقَرِ اللَّهِ البَطيءِ خُمودُها"
    },
    {
      "n": 24,
      "sadr": "وَلَم تَحضُرِ السّاداتُ مِن آلِ مُصعَبٍ",
      "ajuz": "فَيُغنِيَ عَنهُ وَعدُها وَوَعيدُها"
    },
    {
      "n": 25,
      "sadr": "وَلَو حَضَرَتهُ عُصبَةٌ طاهِرِيَّةٌ",
      "ajuz": "مُكَرَّمَةٌ آباؤُها وَجُدودُها"
    },
    {
      "n": 26,
      "sadr": "لَعَزَّ عَلى أَيدي المَنونِ اِختِرامُهُ",
      "ajuz": "وَإِن كانَ مَحتوماً عَلَيهِ وُرودُها"
    },
    {
      "n": 27,
      "sadr": "أُولَئِكَ أَركانُ الخِلافَةِ إِنَّما",
      "ajuz": "بِها ثَبَتَت أَطنابُها وَعَمودُها"
    },
    {
      "n": 28,
      "sadr": "مَواهِبُها لَذّاتُها وَسُيوفُها",
      "ajuz": "مَعاقِلُها وَالمُسلِمونَ شُهودُها"
    },
    {
      "n": 29,
      "sadr": "فَيا لِجُنودٍ ضَيَّعَتها مُلوكُها",
      "ajuz": "وَيا لِمُلوكٍ أَسلَمَتها جُنودُها"
    },
    {
      "n": 30,
      "sadr": "أَيُقتَلُ في دارِ الخِلافَةِ جَعفَرٌ",
      "ajuz": "عَلى فُرقَةٍ صَبراً وَأَنتُم شُهودُها"
    },
    {
      "n": 31,
      "sadr": "فَلا طالِبٌ لِلثَّأرِ مِن بَعدِ مَوتِهِ",
      "ajuz": "وَلا دافِعٌ عَن نَفسِهِ مَن يُريدُها"
    },
    {
      "n": 32,
      "sadr": "بَنو هاشِمٍ مِثلُ النُّجومِ وَإِنَّما",
      "ajuz": "مُلوكُ بَني العَبّاسِ مِنها سُعودُها"
    },
    {
      "n": 33,
      "sadr": "بَني هاشِمٍ صَبراً فَكُلُّ مُصيبَةٍ",
      "ajuz": "سَيَبلى عَلى طولِ الزَّمانِ جِديدُها"
    },
    {
      "n": 34,
      "sadr": "عَزيزٌ عَلَينا أَن نَرى سَرَواتِكُم",
      "ajuz": "تُفَرّى بِأَيدي النّاكِثينَ جُلودُها"
    },
    {
      "n": 35,
      "sadr": "وَلَكِن بِأَيديكُم تُراقُ دِماؤُكُم",
      "ajuz": "وَيَحكُمُ في أَرحامِكُم مَن يَكيدُها"
    },
    {
      "n": 36,
      "sadr": "أَلَهفا وَما يُغني التَّلَهُّفُ بَعدَما",
      "ajuz": "أُذِلَّت لِضِبعانِ الفَلاةِ أُسودُها"
    },
    {
      "n": 37,
      "sadr": "عَبيدُ أَميرِ المُؤمِنينَ قَتَلنَهُ",
      "ajuz": "وَأَعظَمُ آفاتِ المُلوكِ عَبيدُها"
    },
    {
      "n": 38,
      "sadr": "أَما وَالمَنايا ما عَمَرنَ بِمِثلِهِ",
      "ajuz": "القُبورَ وَما ضُمَّت عَلَيهِ لُحودُها"
    },
    {
      "n": 39,
      "sadr": "أَتَتنا القَوافي صارِخاتٍ لِفَقدِهِ",
      "ajuz": "مُصَلَّمَةٌ أَرجازُها وَقَصيدُها"
    },
    {
      "n": 40,
      "sadr": "فَقُلتُ اِرجِعي مَوفورَةً لا تَمَهَّلي",
      "ajuz": "مَعانِيَ أَعيا الطّالِبينَ وُجودُها"
    },
    {
      "n": 41,
      "sadr": "وَلَو شِئتُ لَم يَصعُب عَلَيَّ مَرامُها",
      "ajuz": "لِبُعدٍ وَلَم يَشرُد عَلَيَّ شَريدُها"
    },
    {
      "n": 42,
      "sadr": "وَلَو شِئتُ أَشعَلتُ القُلوبَ بِشُرَّدٍ",
      "ajuz": "مِن الشِّعرِ أَفلاذُ القُلوبِ وَقودُها"
    },
    {
      "n": 43,
      "sadr": "فَيا ناصِرَ الإِسلامِ غَرَّكَ عُصبَةٌ",
      "ajuz": "زَنادِقَةٌ قَد كُنتُ قَبلُ أَذودُها"
    },
    {
      "n": 44,
      "sadr": "وَكُنتَ إِذا أَشهَدتَها بِيَ مَشهَداً",
      "ajuz": "تَطَأمَنَ عاديها وَذَلَّ عَنيدُها"
    },
    {
      "n": 45,
      "sadr": "فَلَمّا نَأَت داري وَمالَ بِكَ الهَوى",
      "ajuz": "إِلَيها وَلَم يَسكُن إِلَيكَ رَشيدُها"
    },
    {
      "n": 46,
      "sadr": "أَشاعَ وَزيرُ السّوءِ عَنكَ عَجائِباً",
      "ajuz": "يُشيدُ بِها في كُلِّ أَرضٍ مُشيدُها"
    },
    {
      "n": 47,
      "sadr": "وَباعَدَ أَهلَ النُّصحِ عَنكَ وَأوغِرَت",
      "ajuz": "صُدورُ المَوالي وَاِستَسَرَّت حُقودُها"
    },
    {
      "n": 48,
      "sadr": "فَطُلَّ دَمٌ ما طُلَّ في الأَرضِ مِثلُهُ",
      "ajuz": "وَكانَت أُمورٌ لَيسَ مِثلي يُعيدُها"
    }
  ]
}
