{
  "id": "atarifu-atlalan",
  "poet": "hatim-al-tai",
  "title": "أَتَعرِفُ أَطلالاً وَنُؤياً مُهَدَّما",
  "meter": "tawil",
  "rawiy": "م",
  "abyat_in_full": 41,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَتَعرِفُ أَطلالاً وَنُؤياً مُهَدَّما",
      "ajuz": "كَخَطِّكَ في رَقٍّ كِتاباً مُنَمنَما"
    },
    {
      "n": 2,
      "sadr": "أَذاعَت بِهِ الأَرواحُ بَعدَ أَنيسِهِ",
      "ajuz": "شُهوراً وَأَيّاماً وَحَولاً مُجَرَّما"
    },
    {
      "n": 3,
      "sadr": "فَأَصبَحنَ قَد غَيَّرنَ ظاهِرَ تُربِهِ",
      "ajuz": "وَبَدَّلَتِ الأَنواءُ ما كانَ مُعلَما"
    },
    {
      "n": 4,
      "sadr": "وَغَيَّرَها طولُ التَّقادُمِ وَالبِلى",
      "ajuz": "فَما أَعرِفُ الأَطلالَ إِلّا تَوَهُّما"
    },
    {
      "n": 5,
      "sadr": "دِيارُ الَّتي قامَت تُريكَ وَقَد خَلَت",
      "ajuz": "وَأَقوَت مِنَ الزُّوّارِ كَفّاً وَمِعصَما"
    },
    {
      "n": 6,
      "sadr": "وَنَحراً كَفاثورِ اللُّجَينِ يَزينُهُ",
      "ajuz": "تَوَقُّدُ ياقوتٍ وَشَذراً مُنَظَّما"
    },
    {
      "n": 7,
      "sadr": "كَجَمرِ الغَضا هَبَّت لَهُ بَعدَ هَجعَةٍ",
      "ajuz": "مِنَ اللَّيلِ أَرواحُ الصَّبا فَتَضَرَّما"
    },
    {
      "n": 8,
      "sadr": "يُضيءُ لَها البَيتُ الظَّليلُ خَصاصُهُ",
      "ajuz": "إِذا هِيَ لَيلاً حاوَلَت أَن تَبَسَّما"
    },
    {
      "n": 9,
      "sadr": "إِذا اِنقَلَبَت فَوقَ الحَشِيَّةِ مَرَّةً",
      "ajuz": "تَرَنَّمَ وَسواسُ الحُلِيِّ تَرَنُّما"
    },
    {
      "n": 10,
      "sadr": "وَعاذِلَتَينِ هَبَّتا بَعدَ هَجعَةٍ",
      "ajuz": "تَلومانِ مِتلافاً مُفيداً مُلَوَّما"
    },
    {
      "n": 11,
      "sadr": "تَلومانِ لَمّا غَوَّرَ النَّجمُ ضِلَّةً",
      "ajuz": "فَتىً لا يَرى الإِنفاقَ في الحَقِّ مَغرَما"
    },
    {
      "n": 12,
      "sadr": "فَقُلتُ وَقَد طالَ العِتابُ عَلَيهِما",
      "ajuz": "وَأَوعَدَتاني أَن تَبينا فَتَصرِما"
    },
    {
      "n": 13,
      "sadr": "أَلا لا تَلوماني عَلى ما تَقَدَّما",
      "ajuz": "كَفى بِصُروفِ الدَّهرِ لِلمَرءِ مُحكِما"
    },
    {
      "n": 14,
      "sadr": "فَإِنَّكُما لا ما مَضى تُدرِكانِهِ",
      "ajuz": "وَلَستُ عَلى ما فاتَني مُتَنَدِّما"
    },
    {
      "n": 15,
      "sadr": "تَحَلَّم عَلى الأَدنَينَ وَاستَبقِ وُدَّهُم",
      "ajuz": "وَلَن تَستَطيعَ الحِلمَ حَتّى تَحَلَّما"
    },
    {
      "n": 16,
      "sadr": "وَنَفسَكَ أَكرِمها فَإِنَّكَ إِن تَهُن",
      "ajuz": "عَلَيكَ فَلَن تَلقى لَها الدَّهرَ مُكرِما"
    },
    {
      "n": 17,
      "sadr": "أَهِن في الَّذي تَهوى التِّلادَ فَإِنَّهُ",
      "ajuz": "يَصيرُ إِذا ما مُتَّ نَهباً مُقَسَّما"
    },
    {
      "n": 18,
      "sadr": "وَلا تَشقَيَن فيهِ فَيَسعَدَ وارِثٌ",
      "ajuz": "بِهِ حينَ تُحشى أَغبَرَ الجَوفِ مُظلِما"
    },
    {
      "n": 19,
      "sadr": "يُقَسِّمُهُ غُنماً وَيَشري كِرامَهُ",
      "ajuz": "وَقَد صِرتَ في خَطٍّ مِنَ الأَرضِ أَعظُما"
    },
    {
      "n": 20,
      "sadr": "قَليلاً بِهِ ما يَحمَدَنَّكَ وارِثٌ",
      "ajuz": "إِذا ساقَ مِمّا كُنتَ تَجمَعُ مَغنَما"
    },
    {
      "n": 21,
      "sadr": "مَتى تَرقِ أَضغانَ العَشيرَةِ بِالأَنى",
      "ajuz": "وَكَفِّ الأَذى يَحسِم لَكَ الدّاءَ مِحسَما"
    },
    {
      "n": 22,
      "sadr": "إِذا شِئتَ نازَيتَ اِمرَأَ السَّوءِ ما نَزا",
      "ajuz": "إِلَيكَ وَلاطَمتَ اللَّئيمَ المُلطَّما"
    },
    {
      "n": 23,
      "sadr": "وَعَوراءَ قَد أَعرَضتُ عَنها فَلَم تَضِر",
      "ajuz": "وَذي أَوَدٍ قَوَّمتُهُ فَتَقَوَّما"
    },
    {
      "n": 24,
      "sadr": "وَأَغفِرُ عَوراءَ الكَريمِ اِدِّخارَهُ",
      "ajuz": "وَأُعرِضُ عَن شَتمِ اللَّئيمِ تَكَرُّما"
    },
    {
      "n": 25,
      "sadr": "وَلا أَخذُلُ المَولى وَإِن كانَ خاذِلاً",
      "ajuz": "وَلا أَشتُمُ اِبنَ العَمِّ إِن كانَ مُفحَما"
    },
    {
      "n": 26,
      "sadr": "وَما اِبتَعَثَتني في هَوايَ لَجاجَةٌ",
      "ajuz": "إِذا لَم أَجِد فيما أَمامي مُقَدَّما"
    },
    {
      "n": 27,
      "sadr": "وَلَيلٍ بَهيمٍ قَد تَسَربَلتُ هَولَهُ",
      "ajuz": "إِذا اللَّيلُ بِالنِّكسِ الجَبانِ تَجَهَّما"
    },
    {
      "n": 28,
      "sadr": "وَلَن يَكسِبَ الصُّعلوكُ حَمداً وَلا غِنىً",
      "ajuz": "إِذا هُوَ لَم يَركَب مِنَ الأَمرِ مُعظَما"
    },
    {
      "n": 29,
      "sadr": "وَلَم يَشهَدِ الخَيلَ المُغيرَةَ بِالضُّحى",
      "ajuz": "يُثِرنَ عَجاجاً بِالسَّنابِكِ أَقتَما"
    },
    {
      "n": 30,
      "sadr": "عَلَيهِنَّ فِتيانٌ كَجِنَّةِ عَبقَرٍ",
      "ajuz": "يَهُزّونَ بِالأَيدي وَشيجاً مُقَوَّما"
    },
    {
      "n": 31,
      "sadr": "لَحى اللَّهُ صُعلوكاً مُناهُ وَهَمُّهُ",
      "ajuz": "مِنَ العَيشِ أَن يَلقى لَبوساً وَمَطعَما"
    },
    {
      "n": 32,
      "sadr": "يَنامُ الضُّحى حَتّى إِذا يَومُهُ اِستَوى",
      "ajuz": "تَنَبَّهَ مَثلوجَ الفُؤادِ مُوَرَّما"
    },
    {
      "n": 33,
      "sadr": "مُقيماً مَعَ المُثرينَ لَيسَ بِبارِحٍ",
      "ajuz": "إِذا نالَ جَدوى مِن طَعامٍ وَمَجثَما"
    },
    {
      "n": 34,
      "sadr": "وَلِلَّهِ صُعلوكٌ يُساوِرُ هَمَّهُ",
      "ajuz": "وَيَمضي عَلى الأَحداثِ وَالدَّهرِ مُقدِما"
    },
    {
      "n": 35,
      "sadr": "فَتى طَلِباتٍ لا يَرى الخَمصَ تَرحَةً",
      "ajuz": "وَلا شَبعَةً إِن نالَها عَدَّ مَغنَما"
    },
    {
      "n": 36,
      "sadr": "إِذا ما رَأى يَوماً مَكارِمَ أَعرَضَت",
      "ajuz": "تَيَمَّمَ كُبراهُنَّ ثُمَّتَ صَمَّما"
    },
    {
      "n": 37,
      "sadr": "يَرى رُمحَهُ وَنَبلَهُ وَمِجَنَّهُ",
      "ajuz": "وَذا شُطَبٍ عَضبَ الضَّريبَةِ مِخذَما"
    },
    {
      "n": 38,
      "sadr": "وَأَحناءَ سَرجٍ قاتِرٍ وَلِجامَهُ",
      "ajuz": "عَتادَ فَتى هَيجا وَطِرفاً مُسَوَّما"
    },
    {
      "n": 39,
      "sadr": "وَيَغشى إِذا ما كانَ يَومُ كَريهَةٍ",
      "ajuz": "صُدورَ العَوالي فَهوَ مُختَضِبٌ دَما"
    },
    {
      "n": 40,
      "sadr": "إِذا الحَربُ أَبدَت ناجِذَيها وَشَمَّرَت",
      "ajuz": "وَوَلّى هَدانُ القَومِ أَقدَمَ مُعلَما"
    },
    {
      "n": 41,
      "sadr": "فَذَلِكَ إِن يَهلِك فَحَسَنٌ ثَناؤُهُ",
      "ajuz": "وَإِن عاشَ لَم يَقعُد ضَعيفاً مُذَمَّما"
    }
  ]
}
