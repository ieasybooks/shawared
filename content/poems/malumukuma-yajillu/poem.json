{
  "id": "malumukuma-yajillu",
  "poet": "al-mutanabbi",
  "title": "مَلومُكُما يَجِلُّ عَنِ المَلامِ",
  "meter": "wafir",
  "rawiy": "م",
  "abyat_in_full": 42,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "مَلومُكُما يَجِلُّ عَنِ المَلامِ",
      "ajuz": "وَوَقعُ فَعالِهِ فَوقَ الكَلامِ"
    },
    {
      "n": 2,
      "sadr": "ذَراني وَالفَلاةَ بِلا دَليلٍ",
      "ajuz": "وَوَجهي وَالهَجيرَ بِلا لِثامِ"
    },
    {
      "n": 3,
      "sadr": "فَإِنّي أَستَريحُ بِذي وَهَذا",
      "ajuz": "وَأَتعَبُ بِالإِناخَةِ وَالمُقامِ"
    },
    {
      "n": 4,
      "sadr": "عُيونُ رَواحِلي إِن حِرتُ عَيني",
      "ajuz": "وَكُلُّ بُغامِ رازِحَةٍ بُغامي"
    },
    {
      "n": 5,
      "sadr": "فَقَد أَرِدُ المِياهَ بِغَيرِ هادٍ",
      "ajuz": "سِوى عَدّي لَها بَرقَ الغَمامِ"
    },
    {
      "n": 6,
      "sadr": "يُذِمُّ لِمُهجَتي رَبّي وَسَيفي",
      "ajuz": "إِذا اِحتاجَ الوَحيدُ إِلى الذِّمامِ"
    },
    {
      "n": 7,
      "sadr": "وَلا أُمسي لِأَهلِ البُخلِ ضَيفاً",
      "ajuz": "وَلَيسَ قِرىً سِوى مُخِّ النَّعامِ"
    },
    {
      "n": 8,
      "sadr": "وَلَمّا صارَ وُدُّ النّاسِ خِبّاً",
      "ajuz": "جَزَيتُ عَلى اِبتِسامٍ بِابتِسامِ"
    },
    {
      "n": 9,
      "sadr": "وَصِرتُ أَشُكُّ فيمَن أَصطَفيهِ",
      "ajuz": "لِعِلمي أَنَّهُ بَعضُ الأَنامِ"
    },
    {
      "n": 10,
      "sadr": "يُحِبُّ العاقِلونَ عَلى التَّصافي",
      "ajuz": "وَحُبُّ الجاهِلينَ عَلى الوَسامِ"
    },
    {
      "n": 11,
      "sadr": "وَآنَفُ مِن أَخي لِأَبي وَأُمّي",
      "ajuz": "إِذا ما لَم أَجِدهُ مِنَ الكِرامِ"
    },
    {
      "n": 12,
      "sadr": "أَرى الأَجدادَ تَغلِبُها جَميعاً",
      "ajuz": "عَلى الأَولادِ أَخلاقُ اللِّئامِ"
    },
    {
      "n": 13,
      "sadr": "وَلَستُ بِقانِعٍ مِن كُلِّ فَضلٍ",
      "ajuz": "بِأَن أُعزى إِلى جَدٍّ هُمامِ"
    },
    {
      "n": 14,
      "sadr": "عَجِبتُ لِمَن لَهُ قَدٌّ وَحَدٌّ",
      "ajuz": "وَيَنبو نَبوَةَ القَضِمِ الكَهامِ"
    },
    {
      "n": 15,
      "sadr": "وَمَن يَجِدِ الطَّريقَ إِلى المَعالي",
      "ajuz": "فَلا يَذَرُ المَطِيَّ بِلا سَنامِ"
    },
    {
      "n": 16,
      "sadr": "وَلَم أَرَ في عُيوبِ النّاسِ شَيئاً",
      "ajuz": "كَنَقصِ القادِرينَ عَلى التَّمامِ"
    },
    {
      "n": 17,
      "sadr": "أَقَمتُ بِأَرضِ مِصرَ فَلا وَرائي",
      "ajuz": "تَخِبُّ بِيَ الرِّكابُ وَلا أَمامي"
    },
    {
      "n": 18,
      "sadr": "وَمَلَّنِيَ الفِراشُ وَكانَ جَنبي",
      "ajuz": "يَمَلُّ لِقاءَهُ في كُلِّ عامِ"
    },
    {
      "n": 19,
      "sadr": "قَليلٌ عائِدي سَقِمٌ فُؤادي",
      "ajuz": "كَثيرٌ حاسِدي صَعبٌ مَرامي"
    },
    {
      "n": 20,
      "sadr": "عَليلُ الجِسمِ مُمتَنِعُ القِيامِ",
      "ajuz": "شَديدُ السُّكرِ مِن غَيرِ المُدامِ"
    },
    {
      "n": 21,
      "sadr": "وَزائِرَتي كَأَنَّ بِها حَياءً",
      "ajuz": "فَلَيسَ تَزورُ إِلّا في الظَّلامِ"
    },
    {
      "n": 22,
      "sadr": "بَذَلتُ لَها المَطارِفَ وَالحَشايا",
      "ajuz": "فَعافَتها وَباتَت في عِظامي"
    },
    {
      "n": 23,
      "sadr": "يَضيقُ الجِلدُ عَن نَفسي وَعَنها",
      "ajuz": "فَتوسِعُهُ بِأَنواعِ السَّقامِ"
    },
    {
      "n": 24,
      "sadr": "كَأَنَّ الصُّبحَ يَطرُدُها فَتَجري",
      "ajuz": "مَدامِعُها بِأَربَعَةٍ سِجامِ"
    },
    {
      "n": 25,
      "sadr": "أُراقِبُ وَقتَها مِن غَيرِ شَوقٍ",
      "ajuz": "مُراقَبَةَ المَشوقِ المُستَهامِ"
    },
    {
      "n": 26,
      "sadr": "وَيَصدُقُ وَعدُها وَالصِّدقُ شَرٌّ",
      "ajuz": "إِذا أَلقاكَ في الكُرَبِ العِظامِ"
    },
    {
      "n": 27,
      "sadr": "أَبِنتَ الدَّهرِ عِندي كُلُّ بِنتٍ",
      "ajuz": "فَكَيفَ وَصَلتِ أَنتِ مِنَ الزِّحامِ"
    },
    {
      "n": 28,
      "sadr": "جَرَحتِ مُجَرَّحاً لَم يَبقَ فيهِ",
      "ajuz": "مَكانٌ لِلسُّيوفِ وَلا السِّهامِ"
    },
    {
      "n": 29,
      "sadr": "أَلا يا لَيتَ شِعرَ يَدي أَتُمسي",
      "ajuz": "تَصَرَّفُ في عِنانٍ أَو زِمامِ"
    },
    {
      "n": 30,
      "sadr": "وَهَل أَرمي هَوايَ بِراقِصاتٍ",
      "ajuz": "مُحَلّاةِ المَقاوِدِ بِاللُّغامِ"
    },
    {
      "n": 31,
      "sadr": "فَرُبَّتَما شَفَيتُ غَليلَ صَدري",
      "ajuz": "بِسَيرٍ أَو قَناةٍ أَو حُسامِ"
    },
    {
      "n": 32,
      "sadr": "وَضاقَت خُطَّةٌ فَخَلَصتُ مِنها",
      "ajuz": "خَلاصَ الخَمرِ مِن نَسجِ الفِدامِ"
    },
    {
      "n": 33,
      "sadr": "وَفارَقتُ الحَبيبَ بِلا وَداعٍ",
      "ajuz": "وَوَدَّعتُ البِلادَ بِلا سَلامِ"
    },
    {
      "n": 34,
      "sadr": "يَقولُ لِيَ الطَّبيبُ أَكَلتَ شَيئاً",
      "ajuz": "وَداؤُكَ في شَرابِكَ وَالطَّعامِ"
    },
    {
      "n": 35,
      "sadr": "وَما في طِبِّهِ أَنّي جَوادٌ",
      "ajuz": "أَضَرَّ بِجِسمِهِ طولُ الجَمامِ"
    },
    {
      "n": 36,
      "sadr": "تَعَوَّدَ أَن يُغَبِّرَ في السَّرايا",
      "ajuz": "وَيَدخُلَ مِن قَتامٍ في قَتامِ"
    },
    {
      "n": 37,
      "sadr": "فَأُمسِكَ لا يُطالُ لَهُ فَيَرعى",
      "ajuz": "وَلا هُوَ في العَليقِ وَلا اللِّجامِ"
    },
    {
      "n": 38,
      "sadr": "فَإِن أَمرَض فَما مَرِضَ اِصطِباري",
      "ajuz": "وَإِن أُحمَم فَما حُمَّ اِعتِزامي"
    },
    {
      "n": 39,
      "sadr": "وَإِن أَسلَم فَما أَبقى وَلَكِن",
      "ajuz": "سَلِمتُ مِنَ الحِمامِ إِلى الحِمامِ"
    },
    {
      "n": 40,
      "sadr": "تَمَتَّع مِن سُهادٍ أَو رُقادٍ",
      "ajuz": "وَلا تَأمُل كَرىً تَحتَ الرِّجامِ"
    },
    {
      "n": 41,
      "sadr": "فَإِنَّ لِثالِثِ الحالَينِ مَعنىً",
      "ajuz": "سِوى مَعنى اِنتِباهِكَ وَالمَنامِ"
    }
  ]
}
