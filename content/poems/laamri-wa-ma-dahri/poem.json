{
  "id": "laamri-wa-ma-dahri",
  "poet": "mutammim-ibn-nuwayra",
  "title": "لَعَمري وَما دَهري بِتَأبينِ هالِكٍ",
  "meter": "tawil",
  "themes": ["ritha"],
  "rawiy": "ع",
  "abyat_in_full": 51,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "لَعَمري وَما دَهري بِتَأبينِ هالِكٍ",
      "ajuz": "وَلا جَزَعٍ مِمّا أَصابَ فَأَوجَعا"
    },
    {
      "n": 2,
      "sadr": "لَقَد كَفَّنَ المِنهالُ تَحتَ رِدائِهِ",
      "ajuz": "فَتىً غَيرَ مِبطانِ العَشِيّاتِ أَروَعا"
    },
    {
      "n": 3,
      "sadr": "وَلا بَرَماً تُهدي النِّساءُ لِعِرسِهِ",
      "ajuz": "إِذا القَشعُ مِن بَردِ الشِّتاءِ تَقَعقَعا"
    },
    {
      "n": 4,
      "sadr": "لَبيبٌ أَعانَ اللُّبَّ مِنهُ سَماحَةٌ",
      "ajuz": "خَصيبٌ إِذا ما راكِبُ الجَدبِ أَوضَعا"
    },
    {
      "n": 5,
      "sadr": "تَراهُ كَصَدرِ السَّيفِ يَهتَزُّ لِلنَّدى",
      "ajuz": "إِذا لَم تَجِد عِندَ اِمرِئِ السَّوءِ مَطمَعا"
    },
    {
      "n": 6,
      "sadr": "وَيَوماً إِذا ما كَظَّكَ الخَصمُ إِن يَكُن",
      "ajuz": "نَصيرَكَ مِنهُم لا تَكُن أَنتَ أَضيَعا"
    },
    {
      "n": 7,
      "sadr": "وَإِن تَلقَهُ في الشَّربِ لا تَلقَ فاحِشاً",
      "ajuz": "عَلى الكَأسِ ذا قاذورَةٍ مُتَزَبِّعا"
    },
    {
      "n": 8,
      "sadr": "وَإِن ضَرَّسَ الغَزوُ الرِّجالَ رَأَيتَهُ",
      "ajuz": "أَخا الحَربِ صَدقاً في اللِّقاءِ سَمَيدَعا"
    },
    {
      "n": 9,
      "sadr": "وَما كانَ وَقّافاً إِذا الخَيلُ أَحجَمَت",
      "ajuz": "وَلا طائِشاً عِندَ اللِّقاءِ مُدَفَّعا"
    },
    {
      "n": 10,
      "sadr": "وَلا بِكَهامٍ بَزُّهُ عَن عَدُوِّهِ",
      "ajuz": "إِذا هُوَ لاقى حاسِراً أَو مُقَنَّعا"
    },
    {
      "n": 11,
      "sadr": "فَعَينَيَّ هَلّا تَبكِيانِ لِمالِكٍ",
      "ajuz": "إِذا أَذرَتِ الرّيحُ الكَنيفَ المُرَفَّعا"
    },
    {
      "n": 12,
      "sadr": "وَلِلشَّربِ فَابكي مالِكاً وَلِبُهمَةٍ",
      "ajuz": "شَديدٍ نَواحيهِ عَلى مَن تَشَجَّعا"
    },
    {
      "n": 13,
      "sadr": "وَضَيفٍ إِذا أَرغى طُروقاً بَعيرَهُ",
      "ajuz": "وَعانٍ ثَوى في القِدِّ حَتّى تَكَنَّعا"
    },
    {
      "n": 14,
      "sadr": "وَأَرمَلَةٍ تَمشي بِأَشعَثَ مُحثَلٍ",
      "ajuz": "كَفَرخِ الحُبارى رَأسُهُ قَد تَضَوَّعا"
    },
    {
      "n": 15,
      "sadr": "إِذا جَرَّدَ القَومُ القِداحَ وَأوقِدَت",
      "ajuz": "لَهُم نارُ أَيسارٍ كَفى مَن تَضَجَّعا"
    },
    {
      "n": 16,
      "sadr": "وَإِن شَهِدَ الأَيسارَ لَم يُلفَ مالِكٌ",
      "ajuz": "عَلى الفَرثِ يَحمي اللَّحمَ أَن يَتَوَزَّعا"
    },
    {
      "n": 17,
      "sadr": "أَبى الصَّبرَ آياتٌ أَراها وَإِنَّني",
      "ajuz": "أَرى كُلَّ حَبلٍ بَعدَ حَبلِكَ أَقطَعا"
    },
    {
      "n": 18,
      "sadr": "وَإِنّي مَتى ما أَدعُ بِاسمِكَ لا تُجِب",
      "ajuz": "وَكُنتَ جَديراً أَن تُجيبَ وَتَسمَعا"
    },
    {
      "n": 19,
      "sadr": "وَعِشنا بِخَيرٍ في الحَياةِ وَقَبلَنا",
      "ajuz": "أَصابَ المَنايا رَهطَ كِسرى وَتُبَّعا"
    },
    {
      "n": 20,
      "sadr": "فَلَمّا تَفَرَّقنا كَأَنّي وَمالِكاً",
      "ajuz": "لِطولِ اِجتِماعٍ لَم نَبِت لَيلَةً مَعا"
    },
    {
      "n": 21,
      "sadr": "وَكُنّا كَنَدمانَي جَذيمَةَ حِقبَةً",
      "ajuz": "مِنَ الدَّهرِ حَتّى قيلَ لَن يَتَصَدَّعا"
    },
    {
      "n": 22,
      "sadr": "فَإِن تَكُنِ الأَيّامُ فَرَّقنَ بَينَنا",
      "ajuz": "فَقَد بانَ مَحموداً أَخي حينَ وَدَّعا"
    },
    {
      "n": 23,
      "sadr": "أَقولُ وَقَد طارَ السَّنا في رَبابِهِ",
      "ajuz": "وَجَونٍ يَسُحُّ الماءَ حَتّى تَرَيَّعا"
    },
    {
      "n": 24,
      "sadr": "سَقى اللَّهُ أَرضاً حَلَّها قَبرُ مالِكٍ",
      "ajuz": "ذِهابَ الغَوادي المُدجِناتِ فَأَمرَعا"
    },
    {
      "n": 25,
      "sadr": "وَآثَرَ سَيلَ الوادِيَينِ بِديمَةٍ",
      "ajuz": "تُرَشِّحُ وَسمِيّاً مِنَ النَّبتِ خِروَعا"
    },
    {
      "n": 26,
      "sadr": "فَمُجتَمَعَ الأَسدامِ مِن حَولِ شارِعٍ",
      "ajuz": "فَرَوّى جِبالَ القَريَتَينِ فَضَلفَعا"
    },
    {
      "n": 27,
      "sadr": "فَوَاللَّهِ ما أُسقي البِلادَ لِحُبِّها",
      "ajuz": "وَلَكِنَّني أُسقي الحَبيبَ المُوَدَّعا"
    },
    {
      "n": 28,
      "sadr": "تَحِيَّتَهُ مِنّي وَإِن كانَ نائِياً",
      "ajuz": "وَأَمسى تُراباً فَوقَهُ الأَرضُ بَلقَعا"
    },
    {
      "n": 29,
      "sadr": "تَقولُ اِبنَةُ العَمرِيِّ ما لَكَ بَعدَما",
      "ajuz": "أَراكَ حَديثاً ناعِمَ البالِ أَفرَعا"
    },
    {
      "n": 30,
      "sadr": "فَقُلتُ لَها طولُ الأَسى إِذ سَأَلَتني",
      "ajuz": "وَلَوعَةُ حُزنٍ تَترُكُ الوَجهَ أَسفَعا"
    },
    {
      "n": 31,
      "sadr": "وَفَقدُ بَني أُمٍّ تَداعَوا فَلَم أَكُن",
      "ajuz": "خِلافَهُمُ أَن أَستَكينَ وَأَضرَعا"
    },
    {
      "n": 32,
      "sadr": "وَلَكِنَّني أَمضي عَلى ذاكَ مُقدِماً",
      "ajuz": "إِذا بَعضُ مَن يَلقى الحُروبَ تَكَعكَعا"
    },
    {
      "n": 33,
      "sadr": "وَغَيَّرَني ما غالَ قَيساً وَمالِكاً",
      "ajuz": "وَعَمراً وَجُزءاً بِالمُشَقَّرِ أَلمَعا"
    },
    {
      "n": 34,
      "sadr": "وَما غالَ نَدماني يَزيدَ وَلَيتَني",
      "ajuz": "تَمَلَّيتُهُ بِالأَهلِ وَالمالِ أَجمَعا"
    },
    {
      "n": 35,
      "sadr": "وَإِنّي وَإِن هازَلتِني قَد أَصابَني",
      "ajuz": "مِنَ البَثِّ ما يُبكي الحَزينَ المُفَجَّعا"
    },
    {
      "n": 36,
      "sadr": "وَلَستُ إِذا ما الدَّهرُ أَحدَثَ نَكبَةً",
      "ajuz": "وَرُزءاً بِزَوّارِ القَرائِبِ أَخضَعا"
    },
    {
      "n": 37,
      "sadr": "قَعيدَكِ أَلّا تُسمِعيني مَلامَةً",
      "ajuz": "وَلا تَنكَئي قَرحَ الفُؤادِ فَييجَعا"
    },
    {
      "n": 38,
      "sadr": "فَقَصرَكِ إِنّي قَد شَهِدتُ فَلَم أَجِد",
      "ajuz": "بِكَفِّيَ عَنهُم لِلمَنِيَّةِ مَدفَعا"
    },
    {
      "n": 39,
      "sadr": "فَلا فَرِحاً إِن كُنتُ يَوماً بِغِبطَةٍ",
      "ajuz": "وَلا جَزِعاً مِمّا أَصابَ فَأَوجَعا"
    },
    {
      "n": 40,
      "sadr": "فَلَو أَنَّ ما أَلقى يُصيبُ مُتالِعاً",
      "ajuz": "أَوِ الرُّكنَ مِن سَلمى إِذاً لَتَضَعضَعا"
    },
    {
      "n": 41,
      "sadr": "وَما وَجدُ أَظآرٍ ثَلاثٍ رَوائِمٍ",
      "ajuz": "أَصَبنَ مَجَرّاً مِن حُوارٍ وَمَصرَعا"
    },
    {
      "n": 42,
      "sadr": "يُذَكِّرنَ ذا البَثِّ الحَزينَ بِبَثِّهِ",
      "ajuz": "إِذا حَنَّتِ الأُولى سَجَعنَ لَها مَعا"
    },
    {
      "n": 43,
      "sadr": "إِذا شارِفٌ مِنهُنَّ قامَت فَرَجَّعَت",
      "ajuz": "حَنيناً فَأَبكى شَجوُها البَركَ أَجمَعا"
    },
    {
      "n": 44,
      "sadr": "بِأَوجَدَ مِنّي يَومَ قامَ بِمالِكٍ",
      "ajuz": "مُنادٍ بَصيرٌ بِالفِراقِ فَأَسمَعا"
    },
    {
      "n": 45,
      "sadr": "أَلَم تَأتِ أَخبارُ المُحِلِّ سَراتَكُم",
      "ajuz": "فَيَغضَبَ مِنكُم كُلُّ مَن كانَ موجَعا"
    },
    {
      "n": 46,
      "sadr": "بِمَشمَتِهِ إِذ صادَفَ الحَتفُ مالِكاً",
      "ajuz": "وَمَشهَدِهِ ما قَد رَأى ثُمَّ ضَيَّعا"
    },
    {
      "n": 47,
      "sadr": "أَآثَرتَ هِدماً بالِياً وَسَوِيَّةً",
      "ajuz": "وَجِئتَ بِها تَعدو بَريداً مُقَزَّعا"
    },
    {
      "n": 48,
      "sadr": "فَلا تَفرَحَن يَوماً بِنَفسِكَ إِنَّني",
      "ajuz": "أَرى المَوتَ وَقّاعاً عَلى مَن تَشَجَّعا"
    },
    {
      "n": 49,
      "sadr": "لَعَلَّكَ يَوماً أَن تُلِمَّ مُلِمَّةٌ",
      "ajuz": "عَلَيكَ مِنَ اللّائي يَدَعنَكَ أَجدَعا"
    },
    {
      "n": 50,
      "sadr": "نَعَيتَ اِمرَأً لَو كانَ لَحمُكَ عِندَهُ",
      "ajuz": "لَآواهُ مَجموعاً لَهُ أَو مُمَزَّعا"
    },
    {
      "n": 51,
      "sadr": "فَلا يَهنَإِ الواشينَ مَقتَلُ مالِكٍ",
      "ajuz": "فَقَد آبَ شانيهِ إِياباً فَوَدَّعا"
    }
  ]
}
