{
  "id": "al-asad-wal-thalab-wal-ijl",
  "poet": "ahmad-shawqi",
  "title": "الأَسَدُ وَالثَّعلَبُ وَالعِجلُ",
  "meter": "ramal",
  "themes": ["fables", "politics"],
  "abyat_in_full": 24,
  "added": "2026-11-24",
  "abyat": [
    {"n": 1, "sadr": "نَظَرَ اللَّيثُ إِلى عِجلٍ سَمين", "ajuz": "كانَ بِالقُربِ عَلى غَيطٍ أَمين"},
    {"n": 2, "sadr": "فَاشتَهَت مِن لَحمِهِ نَفسُ الرَّئيس", "ajuz": "وَكَذا الأَنفُسُ يُصبيها النَّفيس"},
    {"n": 3, "sadr": "قالَ لِلثَّعلَبِ يا ذا الاِحتِيال", "ajuz": "رَأسُكَ المَحبوبُ أَو ذاكَ الغَزال"},
    {"n": 4, "sadr": "فَدَعا بِالسَّعدِ وَالعُمرِ الطَّويل", "ajuz": "وَمَضى في الحالِ لِلأَمرِ الجَليل"},
    {"n": 5, "sadr": "وَأَتى الغَيطَ وَقَد جَنَّ الظَّلام", "ajuz": "فَرَأى العِجلَ فَأَهداهُ السَّلام"},
    {"n": 6, "sadr": "قائِلاً يا أَيُّها المَولى الوَزير", "ajuz": "أَنتَ أَهلُ العَفوِ وَالبِرِّ الغَزير"},
    {"n": 7, "sadr": "حَمَلَ الذِّئبَ عَلى قَتلي الحَسَد", "ajuz": "فَوَشى بي عِندَ مَولانا الأَسَد"},
    {"n": 8, "sadr": "فَتَرامَيتُ عَلى الجاهِ الرَّفيع", "ajuz": "وَهوَ فينا لَم يَزَل نِعمَ الشَّفيع"},
    {"n": 9, "sadr": "فَبَكى المَغرورُ مِن حالِ الخَبيث", "ajuz": "وَدَنا يَسأَلُ عَن شَرحِ الحَديث"},
    {"n": 10, "sadr": "قالَ هَل تَجهَلُ يا حُلوَ الصِّفات", "ajuz": "أَنَّ مَولانا أَبا الأَفيالِ ماتَ"},
    {"n": 11, "sadr": "فَرَأى السُّلطانُ في الرَّأسِ الكَبير", "ajuz": "مَوطِنَ الحِكمَةِ وَالحِذقِ الكَثير"},
    {"n": 12, "sadr": "وَرَآكُم خَيرَ مَن يُستَوزَرُ", "ajuz": "وَلِأَمرِ المُلكِ رُكناً يُذخَرُ"},
    {"n": 13, "sadr": "وَلَقَد عَدّوا لَكُم بَينَ الجُدود", "ajuz": "مِثلَ آبيسَ وَمَعبودِ اليَهود"},
    {"n": 14, "sadr": "فَأَقاموا لِمَعاليكُم سَرير", "ajuz": "عَن يَمينِ المَلِكِ السّامي الخَطير"},
    {"n": 15, "sadr": "وَاستَعَدَّ الطَّيرُ وَالوَحشُ لِذاك", "ajuz": "في اِنتِظارِ السَّيِّدِ العالي هُناك"},
    {"n": 16, "sadr": "فَإِذا قُمتُم بِأَعباءِ الأُمور", "ajuz": "وَانتَهى الأُنسُ إِلَيكُم وَالسُّرور"},
    {"n": 17, "sadr": "بَرِّئوني عِندَ سُلطانِ الزَّمان", "ajuz": "وَاطلُبوا لِيَ العَفوَ مِنهُ وَالأَمان"},
    {"n": 18, "sadr": "وَكَفاكُم أَنَّني العَبدُ المُطيع", "ajuz": "أَخدُمُ المُنعِمَ جُهدَ المُستَطيع"},
    {"n": 19, "sadr": "فَأَحَدَّ العِجلُ قَرنَيهِ وَقال", "ajuz": "أَنتَ مُنذُ اليَومِ جاري لا تُنال"},
    {"n": 20, "sadr": "فَامضِ وَاكشِف لي إِلى اللَّيثِ الطَّريق", "ajuz": "أَنا لا يَشقى لَدَيهِ بي رَفيق"},
    {"n": 21, "sadr": "فَمَضى الخِلّانِ تَوّاً لِلفَلاةِ", "ajuz": "ذا إِلى المَوتِ وَهَذا لِلحَياةِ"},
    {"n": 22, "sadr": "وَهُناكَ اِبتَلَعَ اللَّيثُ الوَزير", "ajuz": "وَحَبا الثَّعلَبَ مِنهُ بِاليَسير"},
    {"n": 23, "sadr": "فَانثَنى يَضحَكُ مِن طَيشِ العُجول", "ajuz": "وَجَرى في حَلبَةِ الفَخرِ يَقول"},
    {"n": 24, "sadr": "سَلِمَ الثَّعلَبُ بِالرَّأسِ الصَّغير", "ajuz": "فَفَداهُ كُلُّ ذي رَأسٍ كَبير"}
  ]
}
