{
  "id": "ghayru-mujdin",
  "poet": "abu-al-ala-al-maarri",
  "title": "غَيرُ مُجدٍ في مِلَّتي وَاعتِقادي",
  "meter": "khafif",
  "themes": ["ritha", "hikma"],
  "rawiy": "د",
  "abyat_in_full": 64,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "غَيرُ مُجدٍ في مِلَّتي وَاعتِقادي",
      "ajuz": "نَوحُ باكٍ وَلا تَرَنُّمُ شادِ"
    },
    {
      "n": 2,
      "sadr": "وَشَبيهٌ صَوتُ النَّعِيِّ إِذا قي",
      "ajuz": "سَ بِصَوتِ البَشيرِ في كُلِّ نادِ"
    },
    {
      "n": 3,
      "sadr": "أَبَكَت تِلكُمُ الحَمامَةُ أَم غَن",
      "ajuz": "نَت عَلى فَرعِ غُصنِها المَيّادِ"
    },
    {
      "n": 4,
      "sadr": "صاحِ هَذي قُبورُنا تَملَأُ الرُّح",
      "ajuz": "بَ فَأَينَ القُبورُ مِن عَهدِ عادِ"
    },
    {
      "n": 5,
      "sadr": "خَفِّفِ الوَطءَ ما أَظُنُّ أَديمَ ال",
      "ajuz": "أَرضِ إِلّا مِن هَذِهِ الأَجسادِ"
    },
    {
      "n": 6,
      "sadr": "وَقَبيحٌ بِنا وَإِن قَدُمَ العَه",
      "ajuz": "دُ هَوانُ الآباءِ وَالأَجدادِ"
    },
    {
      "n": 7,
      "sadr": "سِر إِنِ اِسطَعتَ في الهَواءِ رُوَيداً",
      "ajuz": "لا اِختِيالاً عَلى رُفاتِ العِبادِ"
    },
    {
      "n": 8,
      "sadr": "رُبَّ لَحدٍ قَد صارَ لَحداً مِراراً",
      "ajuz": "ضاحِكٍ مِن تَزاحُمِ الأَضدادِ"
    },
    {
      "n": 9,
      "sadr": "وَدَفينٍ عَلى بَقايا دَفينٍ",
      "ajuz": "في طَويلِ الأَزمانِ وَالآبادِ"
    },
    {
      "n": 10,
      "sadr": "فَاسأَلِ الفَرقَدَينِ عَمَّن أَحَسّا",
      "ajuz": "مِن قَبيلٍ وَآنَسا مِن بِلادِ"
    },
    {
      "n": 11,
      "sadr": "كَم أَقاما عَلى زَوالِ نَهارٍ",
      "ajuz": "وَأَنارا لِمُدلِجٍ في سَوادِ"
    },
    {
      "n": 12,
      "sadr": "تَعَبٌ كُلُّها الحَياةُ فَما أَع",
      "ajuz": "جَبُ إِلّا مِن راغِبٍ في اِزدِيادِ"
    },
    {
      "n": 13,
      "sadr": "إِنَّ حُزناً في ساعَةِ المَوتِ أَضعا",
      "ajuz": "فُ سُرورٍ في ساعَةِ الميلادِ"
    },
    {
      "n": 14,
      "sadr": "خُلِقَ النّاسُ لِلبَقاءِ فَضَلَّت",
      "ajuz": "أُمَّةٌ يَحسَبونَهُم لِلنَّفادِ"
    },
    {
      "n": 15,
      "sadr": "إِنَّما يُنقَلونَ مِن دارِ أَعما",
      "ajuz": "لٍ إِلى دارِ شِقوَةٍ أَو رَشادِ"
    },
    {
      "n": 16,
      "sadr": "ضَجعَةُ المَوتِ رَقدَةٌ يَستَريحُ ال",
      "ajuz": "جِسمُ فيها وَالعَيشُ مِثلُ السُّهادِ"
    },
    {
      "n": 17,
      "sadr": "أَبَناتِ الهَديلِ أَسعِدنَ أَو عِد",
      "ajuz": "نَ قَليلَ العَزاءِ بِالإِسعادِ"
    },
    {
      "n": 18,
      "sadr": "إيهِ لِلَّهِ دَرُّكُنَّ فَأَنتُن",
      "ajuz": "نَ اللَّواتي يُحسِنَّ حِفظَ الوِدادِ"
    },
    {
      "n": 19,
      "sadr": "ما نَسيتُنَّ هالِكاً في الأَوانِ ال",
      "ajuz": "خالِ أَودى مِن قَبلِ هُلكِ إِيادِ"
    },
    {
      "n": 20,
      "sadr": "بَيدَ أَنّي لا أَرتَضي ما فَعَلتُن",
      "ajuz": "نَ وَأَطواقُكُنَّ في الأَجيادِ"
    },
    {
      "n": 21,
      "sadr": "فَتَسَلَّبنَ وَاستَعِرنَ جَميعاً",
      "ajuz": "مِن قَميصِ الدُّجى ثِيابَ حِدادِ"
    },
    {
      "n": 22,
      "sadr": "ثُمَّ غَرِّدنَ في المَآتِمِ وَاندُب",
      "ajuz": "نَ بِشَجوٍ مَعَ الغَواني الخِرادِ"
    },
    {
      "n": 23,
      "sadr": "قَصَدَ الدَّهرُ مِن أَبي حَمزَةَ الأَو",
      "ajuz": "وابِ مَولى حِجاً وَخِدنَ اِقتِصادِ"
    },
    {
      "n": 24,
      "sadr": "وَفَقيهاً أَفكارُهُ شِدنَ لِلنُّع",
      "ajuz": "مانِ ما لَم يَشِدهُ شِعرُ زِيادِ"
    },
    {
      "n": 25,
      "sadr": "فَالعِراقِيُّ بَعدَهُ لِلحِجازي",
      "ajuz": "يِ قَليلُ الخِلافِ سَهلُ القِيادِ"
    },
    {
      "n": 26,
      "sadr": "وَخَطيباً لَو قامَ بَينَ وُحوشٍ",
      "ajuz": "عَلَّمَ الضّارِياتِ بِرَّ النِّقادِ"
    },
    {
      "n": 27,
      "sadr": "راوِياً لِلحَديثِ لَم يُحوِجِ المَع",
      "ajuz": "روفُ مِن صِدقِهِ إِلى الإِسنادِ"
    },
    {
      "n": 28,
      "sadr": "أَنفَقَ العُمرَ ناسِكاً يَطلُبُ العِل",
      "ajuz": "مَ بِكَشفٍ عَن أَصلِهِ وَانتِقادِ"
    },
    {
      "n": 29,
      "sadr": "مُستَقي الكَفِّ مِن قَليبِ زُجاجٍ",
      "ajuz": "بِغُروبِ اليَراعِ ماءَ مِدادِ"
    },
    {
      "n": 30,
      "sadr": "ذا بَنانٍ لا تَلمِسُ الذَّهَبَ الأَح",
      "ajuz": "مَرَ زُهداً في العَسجَدِ المُستَفادِ"
    },
    {
      "n": 31,
      "sadr": "وَدِّعا أَيُّها الحَفِيّانِ ذاكَ ال",
      "ajuz": "شَّخصَ إِنَّ الوَداعَ أَيسَرُ زادِ"
    },
    {
      "n": 32,
      "sadr": "وَاغسِلاهُ بِالدَّمعِ إِن كانَ طُهراً",
      "ajuz": "وَادفِناهُ بَينَ الحَشا وَالفُؤادِ"
    },
    {
      "n": 33,
      "sadr": "وَاحبُواهُ الأَكفانَ مِن وَرَقِ المُص",
      "ajuz": "حَفِ كِبراً عَن أَنفَسِ الأَبرادِ"
    },
    {
      "n": 34,
      "sadr": "وَاتلوا النَّعشَ بِالقِراءَةِ وَالتَّس",
      "ajuz": "بيحِ لا بِالنَّحيبِ وَالتَّعدادِ"
    },
    {
      "n": 35,
      "sadr": "أَسَفٌ غَيرُ نافِعٍ وَاجتِهادٌ",
      "ajuz": "لا يُؤَدّي إِلى غَناءِ اِجتِهادِ"
    },
    {
      "n": 36,
      "sadr": "طالَما أَخرَجَ الحَزينَ جَوى الحُز",
      "ajuz": "نِ إِلى غَيرِ لائِقٍ بِالسَّدادِ"
    },
    {
      "n": 37,
      "sadr": "مِثلَ ما فاتَتِ الصَّلاةُ سُلَيما",
      "ajuz": "نَ فَأَنحى عَلى رِقابِ الجِيادِ"
    },
    {
      "n": 38,
      "sadr": "وَهُوَ مَن سُخِّرَت لَهُ الإِنسُ وَالجِن",
      "ajuz": "نُ بِما صَحَّ مِن شَهادَةِ صادِ"
    },
    {
      "n": 39,
      "sadr": "خافَ غَدرَ الأَنامِ فَاستَودَعَ الرّي",
      "ajuz": "حَ سَليلاً تَغذوهُ دَرَّ العِهادِ"
    },
    {
      "n": 40,
      "sadr": "وَتَوَخّى لَهُ النَّجاةَ وَقَد أَي",
      "ajuz": "قَنَ أَنَّ الحِمامَ بِالمِرصادِ"
    },
    {
      "n": 41,
      "sadr": "فَرَمَتهُ بِهِ عَلى جانِبِ الكُر",
      "ajuz": "سِيِّ أُمُّ اللُّهَيمِ أُختُ النَّآدِ"
    },
    {
      "n": 42,
      "sadr": "كَيفَ أَصبَحتَ في مَحَلِّكَ بَعدي",
      "ajuz": "يا جَديراً مِنّي بِحُسنِ اِفتِقادِ"
    },
    {
      "n": 43,
      "sadr": "قَد أَقَرَّ الطَّبيبُ عَنكَ بِعَجزٍ",
      "ajuz": "وَتَقَضّى تَرَدُّدُ العُوّادِ"
    },
    {
      "n": 44,
      "sadr": "وَانتَهى اليَأسُ مِنكَ وَاستَشعَرَ الوا",
      "ajuz": "جِدُ أَن لا مَعادَ حَتّى المَعادِ"
    },
    {
      "n": 45,
      "sadr": "هَجَدَ السّاهِرونَ حَولَكَ لِلتَّم",
      "ajuz": "ريضِ وَيحٌ لِأَعيُنِ الهُجّادِ"
    },
    {
      "n": 46,
      "sadr": "أَنتَ مِن أُسرَةٍ مَضَوا غَيرَ مَغرو",
      "ajuz": "رينَ مِن عيشَةٍ بِذاتِ ضِمادِ"
    },
    {
      "n": 47,
      "sadr": "لا يُغَيِّركُمُ الصَّعيدُ وَكونوا",
      "ajuz": "فيهِ مِثلَ السُّيوفِ في الأَغمادِ"
    },
    {
      "n": 48,
      "sadr": "فَعَزيزٌ عَلَيَّ خَلطُ اللَّيالي",
      "ajuz": "رِمَّ أَقدامِكُم بِرِمِّ الهَوادي"
    },
    {
      "n": 49,
      "sadr": "كُنتَ خِلَّ الصِّبا فَلَمّا أَرادَ ال",
      "ajuz": "بَينَ وافَقتَ رَأيَهُ في المُرادِ"
    },
    {
      "n": 50,
      "sadr": "وَرَأَيتَ الوَفاءَ لِلصّاحِبِ الأَو",
      "ajuz": "وَلِ مِن شيمَةِ الكَريمِ الجَوادِ"
    },
    {
      "n": 51,
      "sadr": "وَخَلَعتَ الشَّبابَ غَضّاً فَيا لَي",
      "ajuz": "تَكَ أَبلَيتَهُ مَعَ الأَندادِ"
    },
    {
      "n": 52,
      "sadr": "فَاذهَبا خَيرَ ذاهِبَينِ حَقيقَي",
      "ajuz": "نِ بِسُقيا رَوائِحٍ وَغَوادِ"
    },
    {
      "n": 53,
      "sadr": "وَمَراثٍ لَو أَنَّهُنَّ دُموعٌ",
      "ajuz": "لَمَحَونَ السُّطورَ في الإِنشادِ"
    },
    {
      "n": 54,
      "sadr": "زُحَلٌ أَشرَفُ الكَواكِبِ داراً",
      "ajuz": "مِن لِقاءِ الرَّدى عَلى ميعادِ"
    },
    {
      "n": 55,
      "sadr": "وَلِنارِ المِرّيخِ مِن حَدَثانِ الدَّه",
      "ajuz": "رِ مُطفٍ وَإِن عَلَت في اِتِّقادِ"
    },
    {
      "n": 56,
      "sadr": "وَالثُّرَيّا رَهينَةٌ بِاجتِماعِ ال",
      "ajuz": "شَّملِ حَتّى تُعَدَّ في الأَفرادِ"
    },
    {
      "n": 57,
      "sadr": "فَليَكُن لِلمُحَسِّنِ الأَجَلُ المَم",
      "ajuz": "دودُ رَغماً لِآنُفِ الحُسّادِ"
    },
    {
      "n": 58,
      "sadr": "وَليَطِب عَن أَخيهِ نَفساً وَأَبنا",
      "ajuz": "ءُ أَخيهِ جَرائِحَ الأَكبادِ"
    },
    {
      "n": 59,
      "sadr": "وَإِذا البَحرُ غاضَ عَنّي وَلَم أَر",
      "ajuz": "وَ فَلا رِيَّ بِادِّخارِ الثِّمادِ"
    },
    {
      "n": 60,
      "sadr": "كُلُّ بَيتٍ لِلهَدمِ ما تَبتَني الوَر",
      "ajuz": "قاءُ وَالسَّيِّدُ الرَّفيعُ العِمادِ"
    },
    {
      "n": 61,
      "sadr": "وَالفَتى ظاعِنٌ وَيَكفيهِ ظِلُّ ال",
      "ajuz": "سِّدرِ ضَربَ الأَطنابِ وَالأَوتادِ"
    },
    {
      "n": 62,
      "sadr": "بانَ أَمرُ الإِلَهِ وَاختَلَفَ النّا",
      "ajuz": "سُ فَداعٍ إِلى ضَلالٍ وَهادِ"
    },
    {
      "n": 63,
      "sadr": "وَالَّذي حارَتِ البَرِيَّةُ فيهِ",
      "ajuz": "حَيَوانٌ مُستَحدَثٌ مِن جَمادِ"
    },
    {
      "n": 64,
      "sadr": "وَاللَّبيبُ اللَّبيبُ مَن لَيسَ يَغتَر",
      "ajuz": "رُ بِكَونٍ مَصيرُهُ لِفَسادِ"
    }
  ]
}
