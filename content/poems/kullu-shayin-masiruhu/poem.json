{
  "id": "kullu-shayin-masiruhu",
  "poet": "al-harith-ibn-ubbad",
  "title": "كُلُّ شَيءٍ مَصيرُهُ لِلزَّوالِ",
  "meter": "khafif",
  "rawiy": "ل",
  "abyat_in_full": 106,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "كُلُّ شَيءٍ مَصيرُهُ لِلزَّوالِ",
      "ajuz": "غَيرَ رَبّي وَصالِحِ الأَعمالِ"
    },
    {
      "n": 2,
      "sadr": "وَتَرى النّاسَ يَنظُرونَ جَميعاً",
      "ajuz": "لَيسَ فيهِم لِذاكَ بَعضُ اِحتِيالِ"
    },
    {
      "n": 3,
      "sadr": "قُل لِأُمِّ الأَغَرِّ تَبكي بُجَيراً",
      "ajuz": "حيلَ بَينَ الرِّجالِ وَالأَموالِ"
    },
    {
      "n": 4,
      "sadr": "وَلَعَمري لَأَبكِيَنَّ بُجَيراً",
      "ajuz": "ما أَتى الماءُ مِن رُؤوسِ الجِبالِ"
    },
    {
      "n": 5,
      "sadr": "لَهفَ نَفسي عَلى بُجَيرٍ إِذا ما",
      "ajuz": "جالَتِ الخَيلُ يَومَ حَربٍ عُضالِ"
    },
    {
      "n": 6,
      "sadr": "وَتَساقى الكُماةُ سُمّاً نَقيعاً",
      "ajuz": "وَبَدا البيضُ مِن قِبابِ الحِجالِ"
    },
    {
      "n": 7,
      "sadr": "وَسَعَت كُلُّ حُرَّةِ الوَجهِ تَدعو",
      "ajuz": "يا لَبَكرٍ غَرّاءَ كَالتِّمثالِ"
    },
    {
      "n": 8,
      "sadr": "يا بُجَيرَ الخَيراتِ لا صُلحَ حَتّى",
      "ajuz": "تُملَأَ البيدُ مِن رُؤوسِ الرِّجالِ"
    },
    {
      "n": 9,
      "sadr": "وَتَقَرَّ العُيونُ بَعدَ بُكاها",
      "ajuz": "حينَ تَسقي الدِّما صُدورَ العَوالي"
    },
    {
      "n": 10,
      "sadr": "أَصبَحَت وائِلٌ تَعِجُّ مِنَ الحَربِ",
      "ajuz": "عَجيجَ الجِمالِ بِالأَثقالِ"
    },
    {
      "n": 11,
      "sadr": "لَم أَكُن مِن جُناتِها عَلِمَ اللَّهُ",
      "ajuz": "وَإِنّي لِحَرِّها اليَومَ صالِ"
    },
    {
      "n": 12,
      "sadr": "قَد تَجَنَّبتُ وائِلاً كَي يُفيقوا",
      "ajuz": "فَأَبَت تَغلِبٌ عَلَيَّ اِعتِزالي"
    },
    {
      "n": 13,
      "sadr": "وَأَشابوا ذُؤابَتي بِبُجَيرٍ",
      "ajuz": "قَتَلوهُ ظُلماً بِغَيرِ قِتالِ"
    },
    {
      "n": 14,
      "sadr": "قَتَلوهُ بِشِسعِ نَعلِ كُلَيبٍ",
      "ajuz": "إِنَّ قَتلَ الكَريمِ بِالشِّسعِ غالِ"
    },
    {
      "n": 15,
      "sadr": "يا بَني تَغلِبَ خُذوا الحِذرَ إِنّا",
      "ajuz": "قَد شَرِبنا بِكَأسِ مَوتٍ زُلالِ"
    },
    {
      "n": 16,
      "sadr": "يا بَني تَغلِبٍ قَتَلتُم قَتيلاً",
      "ajuz": "ما سَمِعنا بِمِثلِهِ في الخَوالي"
    },
    {
      "n": 17,
      "sadr": "قَرِّبا مَربِطَ النَّعامَةِ مِنّي",
      "ajuz": "لَقِحَت حَربُ وائِلٍ عَن حِيالِ"
    },
    {
      "n": 18,
      "sadr": "قَرِّبا مَربِطَ النَّعامَةِ مِنّي",
      "ajuz": "لَيسَ قَولي يُرادُ لَكِن فَعالي"
    },
    {
      "n": 19,
      "sadr": "قَرِّبا مَربِطَ النَّعامَةِ مِنّي",
      "ajuz": "جَدَّ نَوحُ النِّساءِ بِالإِعوالِ"
    },
    {
      "n": 20,
      "sadr": "قَرِّبا مَربِطَ النَّعامَةِ مِنّي",
      "ajuz": "شابَ رَأسي وَأَنكَرَتني القَوالي"
    },
    {
      "n": 21,
      "sadr": "قَرِّبا مَربِطَ النَّعامَةِ مِنّي",
      "ajuz": "لِلسُّرى وَالغُدُوِّ وَالآصالِ"
    },
    {
      "n": 22,
      "sadr": "قَرِّبا مَربِطَ النَّعامَةِ مِنّي",
      "ajuz": "طالَ لَيلي عَلى اللَّيالي الطِّوالِ"
    },
    {
      "n": 23,
      "sadr": "قَرِّبا مَربِطَ النَّعامَةِ مِنّي",
      "ajuz": "لِاِعتِناقِ الأَبطالِ بِالأَبطالِ"
    },
    {
      "n": 24,
      "sadr": "قَرِّبا مَربِطَ النَّعامَةِ مِنّي",
      "ajuz": "وَاِعدِلا عَن مَقالَةِ الجُهّالِ"
    },
    {
      "n": 25,
      "sadr": "قَرِّبا مَربِطَ النَّعامَةِ مِنّي",
      "ajuz": "لَيسَ قَلبي عَنِ القِتالِ بِسالِ"
    },
    {
      "n": 26,
      "sadr": "قَرِّبا مَربِطَ النَّعامَةِ مِنّي",
      "ajuz": "كُلَّما هَبَّ ريحُ ذَيلِ الشَّمالِ"
    },
    {
      "n": 27,
      "sadr": "قَرِّبا مَربِطَ النَّعامَةِ مِنّي",
      "ajuz": "لِبُجَيرٍ مُفَكِّكِ الأَغلالِ"
    },
    {
      "n": 28,
      "sadr": "قَرِّبا مَربِطَ النَّعامَةِ مِنّي",
      "ajuz": "لِكَريمٍ مُتَوَّجٍ بِالجَمالِ"
    },
    {
      "n": 29,
      "sadr": "قَرِّبا مَربِطَ النَّعامَةِ مِنّي",
      "ajuz": "لا نَبيعُ الرِّجالَ بَيعَ النِّعالِ"
    },
    {
      "n": 30,
      "sadr": "قَرِّبا مَربِطَ النَّعامَةِ مِنّي",
      "ajuz": "لِبُجَيرٍ فَداهُ عَمّي وَخالي"
    },
    {
      "n": 31,
      "sadr": "قَرِّباها لِحَيِّ تَغلِبَ شوساً",
      "ajuz": "لِاِعتِناقِ الكُماةِ يَومَ القِتالِ"
    },
    {
      "n": 32,
      "sadr": "قَرِّباها وَقَرِّبا لَأمَتي",
      "ajuz": "دِرعاً دِلاصاً تَرُدُّ حَدَّ النِّبالِ"
    },
    {
      "n": 33,
      "sadr": "قَرِّباها بِمُرهَفاتٍ حِدادٍ",
      "ajuz": "لِقِراعِ الأَبطالِ يَومَ النِّزالِ"
    },
    {
      "n": 34,
      "sadr": "رُبَّ جَيشٍ لَقيتُهُ يُمطِرُ المَوتَ",
      "ajuz": "عَلى هَيكَلٍ خَفيفِ الجِلالِ"
    },
    {
      "n": 35,
      "sadr": "سائِلوا كِندَةَ الكِرامَ وَبَكراً",
      "ajuz": "وَاسأَلوا مَذحِجاً وَحَيَّ هِلالِ"
    },
    {
      "n": 36,
      "sadr": "إِذ أَتَونا بِعَسكَرٍ ذي زُهاءٍ",
      "ajuz": "مُكفَهِرِّ الأَذى شَديدِ المَصالِ"
    },
    {
      "n": 37,
      "sadr": "فَقَرَيناهُ حينَ رامَ قِرانا",
      "ajuz": "كُلَّ ماضي الذُّبابِ عَضبِ الصِّقالِ"
    }
  ]
}
