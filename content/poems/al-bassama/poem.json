{
  "id": "al-bassama",
  "poet": "ibn-abdun",
  "title": "البَسّامَةُ",
  "meter": "basit",
  "themes": ["ritha", "hikma"],
  "rawiy": "ر",
  "abyat_in_full": 77,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "الدَّهرُ يَفجَعُ بَعدَ العَينِ بِالأَثَرِ",   "ajuz": "فَما البُكاءُ عَلى الأَشباحِ وَالصُّوَرِ" },
    { "n": 2,  "sadr": "أَنهاكَ أَنهاكَ لا آلوكَ مَوعِظَةً",          "ajuz": "عَن نَومَةٍ بَينَ نابِ اللَّيثِ وَالظُّفُرِ" },
    { "n": 3,  "sadr": "فَالدَّهرُ حَربٌ وَإِن أَبدى مُسالَمَةً",     "ajuz": "وَالبيضُ وَالسّودُ مِثلُ البيضِ وَالسُّمُرِ" },
    { "n": 4,  "sadr": "وَلا هَوادَةَ بَينَ الرَّأسِ تَأخُذُهُ",      "ajuz": "يَدُ الضِّرابِ وَبَينَ الصّارِمِ الذَّكَرِ" },
    { "n": 5,  "sadr": "فَلا تَغُرَّنكَ مِن دُنياكَ نَومَتُها",       "ajuz": "فَما صِناعَةُ عَينَيها سِوى السَّهَرِ" },
    { "n": 6,  "sadr": "ما لِلَّيالي أَقالَ اللَّهُ عَثرَتَنا",       "ajuz": "مِنَ اللَّيالي وَخانَتها يَدُ الغِيَرِ" },
    { "n": 7,  "sadr": "في كُلِّ حينٍ لَها في كُلِّ جارِحَةٍ",        "ajuz": "مِنّا جِراحٌ وَإِن زاغَت عَنِ النَّظَرِ" },
    { "n": 8,  "sadr": "تَسُرُّ بِالشَّيءِ لَكِن كَي تَغُرَّ بِهِ",   "ajuz": "كَالأَيمِ ثارَ إِلى الجاني مِنَ الزَّهَرِ" },
    { "n": 9,  "sadr": "كَم دَولَةٍ وَلِيَت بِالنَّصرِ خِدمَتَها",    "ajuz": "لَم تُبقِ مِنها وَسَل ذِكراكَ عَن خَبَرِ" },
    { "n": 10, "sadr": "هَوَت بِدارا وَفَلَّت غَربَ قاتِلِهِ",        "ajuz": "وَكانَ عَضباً عَلى الأَملاكِ ذا أُثُرِ" },
    { "n": 11, "sadr": "وَاستَرجَعَت مِن بَني ساسانَ ما وَهَبَت",     "ajuz": "وَلَم تَدَع لِبَني يونانَ مِن أَثَرِ" },
    { "n": 12, "sadr": "وَأَلحَقَت أُختَها طَسماً وَعادَ عَلى",       "ajuz": "عادٍ وَجُرهُمَ مِنها ناقِضُ المِرَرِ" },
    { "n": 13, "sadr": "وَما أَقالَت ذَوي الهَيئاتِ مِن يَمَنٍ",      "ajuz": "وَلا أَجارَت ذَوي الغاياتِ مِن مُضَرِ" },
    { "n": 14, "sadr": "وَمَزَّقَت سَبَأً في كُلِّ قاصِيَةٍ",         "ajuz": "فَما اِلتَقى رائِحٌ مِنهُم بِمُبتَكِرِ" },
    { "n": 15, "sadr": "وَأَنفَذَت في كُلَيبٍ حُكمَها وَرَمَت",       "ajuz": "مُهَلهِلاً بَينَ سَمعِ الأَرضِ وَالبَصَرِ" },
    { "n": 16, "sadr": "وَلَم تَرُدَّ عَلى الضِّلّيلِ صِحَّتَهُ",     "ajuz": "وَلا ثَنَت أَسَداً عَن رَبِّها حُجُرِ" },
    { "n": 17, "sadr": "وَدَوَّخَت آلَ ذُبيانٍ وَإِخوَتَهُم",         "ajuz": "عَبساً وَعَضَّت بَني بَدرٍ عَلى النَّهَرِ" },
    { "n": 18, "sadr": "وَأَلحَقَت بِعَدِيٍّ بِالعِراقِ عَلى",        "ajuz": "يَدِ اِبنِهِ أَحمَرَ العَينَينِ وَالشَّعَرِ" },
    { "n": 19, "sadr": "وَأَهلَكَت أَبرَويزاً بِابنِهِ وَرَمَت",     "ajuz": "بِيَزدَجِردَ إِلى مَروٍ فَلَم يَحُرِ" },
    { "n": 20, "sadr": "وَبَلَّغَت يَزدَجِردَ الصّينَ وَاختَزَلَت",   "ajuz": "عَنهُ سِوى الفُرسِ جَمعَ التُّركِ وَالخَزَرِ" },
    { "n": 21, "sadr": "وَلَم تَرُدَّ مَواضي رُستُمٍ وَقَنا",         "ajuz": "ذي حاجِبٍ عَنهُ سَعداً في اِبنَةِ الغِيَرِ" },
    { "n": 22, "sadr": "يَومَ القَليبِ بَنو بَدرٍ فَنوا وَسَعى",     "ajuz": "قَليبُ بَدرٍ بِمَن فيهِ إِلى سَقَرِ" },
    { "n": 23, "sadr": "وَمَزَّقَت جَعفَراً بِالبيضِ وَاختَلَسَت",    "ajuz": "مِن غيلِهِ حَمزَةَ الظَّلّامَ لِلجُزُرِ" },
    { "n": 24, "sadr": "وَأَشرَفَت بِخُبَيبٍ فَوقَ فارِعَةٍ",         "ajuz": "وَأَلصَقَت طَلحَةَ الفَيّاضَ بِالعَفَرِ" },
    { "n": 25, "sadr": "وَخَضَّبَت شَيبَ عُثمانٍ دَماً وَخَطَت",      "ajuz": "إِلى الزُّبَيرِ وَلَم تَستَحيِ مِن عُمَرِ" },
    { "n": 26, "sadr": "وَلا رَعَت لِأَبي اليَقظانِ صُحبَتَهُ",       "ajuz": "وَلَم تُزَوِّدهُ إِلّا الضَّيحَ في الغُمَرِ" },
    { "n": 27, "sadr": "وَأَجزَرَت سَيفَ أَشقاها أَبا حَسَنٍ",        "ajuz": "وَأَمكَنَت مِن حُسَينٍ راحَتَي شَمِرِ" },
    { "n": 28, "sadr": "وَلَيتَها إِذ فَدَت عَمراً بِخارِجَةٍ",       "ajuz": "فَدَت عَلِيّاً بِمَن شاءَت مِنَ البَشَرِ" },
    { "n": 29, "sadr": "وَأَردَتِ اِبنَ زِيادٍ بِالحُسَينِ فَلَم",    "ajuz": "يَبُؤ بِشِسعٍ لَهُ قَد طاحَ أَو ظُفُرِ" },
    { "n": 30, "sadr": "وَعَمَّمَت بِالظُّبى فَودَي أَبي أَنَسٍ",     "ajuz": "وَلَم تَرُدَّ الرَّدى عَنهُ قَنا زُفَرِ" },
    { "n": 31, "sadr": "وَأَنزَلَت مُصعَباً مِن رَأسِ شاهِقَةٍ",      "ajuz": "كانَت بِها مُهجَةُ المُختارِ في وَزَرِ" },
    { "n": 32, "sadr": "وَلَم تُراقِب مَكانَ اِبنِ الزُّبَيرِ وَلا",  "ajuz": "راعَت عِياذَتَهُ بِالبَيتِ وَالحَجَرِ" },
    { "n": 33, "sadr": "وَلَم تَدَع لِأَبي الذِّبّانِ قاضِيَةً",      "ajuz": "لَيسَ اللَّطيمُ لَها عَمرٌو بِمُنتَصِرِ" },
    { "n": 34, "sadr": "وَأَحرَقَت شِلوَ زَيدٍ بَعدَما اِحتَرَقَت",   "ajuz": "عَلَيهِ وَجداً قُلوبُ الآيِ وَالسُّوَرِ" },
    { "n": 35, "sadr": "وَأَظفَرَت بِالوَليدِ اِبنِ اليَزيدِ وَلَم",    "ajuz": "تُبقِ الخِلافَةَ بَينَ الكَأسِ وَالوَتَرِ" },
    { "n": 36, "sadr": "حَبابَةٌ حَبُّ رُمّانٍ أُتيحَ لَها",          "ajuz": "وَأَحمَرٌ قَطَّرَتهُ نَفحَةُ القُطُرِ" },
    { "n": 37, "sadr": "وَلَم تَعُد قُضُبُ السَّفّاحِ نائِيَةً",      "ajuz": "عَن رَأسِ مَروانَ أَو أَشياعِهِ الفُجُرِ" },
    { "n": 38, "sadr": "وَأَسبَلَت دَمعَةَ الرّوحِ الأَمينِ عَلى",    "ajuz": "دَمٍ بِفَخٍّ لِآلِ المُصطَفى هَدَرِ" },
    { "n": 39, "sadr": "وَأَشرَقَت جَعفَراً وَالفَضلُ يَنظُرُهُ",     "ajuz": "وَالشَّيخُ يَحيى بِريقِ الصّارِمِ الذَّكَرِ" },
    { "n": 40, "sadr": "وَأَخفَرَت في الأَمينِ العَهدَ وَانتَدَبَت", "ajuz": "لِجَعفَرٍ بِابنِهِ وَالأَعبُدِ الغُدُرِ" },
    { "n": 41, "sadr": "وَما وَفَت بِعُهودِ المُستَعينِ وَلا",        "ajuz": "بِما تَأَكَّدَ لِلمُعتَزِّ مِن مِرَرِ" },
    { "n": 42, "sadr": "وَأَوثَقَت في عُراها كُلَّ مُعتَمِدٍ",        "ajuz": "وَأَشرَقَت بِقَذاها كُلَّ مُقتَدِرِ" },
    { "n": 43, "sadr": "وَرَوَّعَت كُلَّ مَأمونٍ وَمُؤتَمَنٍ",        "ajuz": "وَأَسلَمَت كُلَّ مَنصورٍ وَمُنتَصِرِ" },
    { "n": 44, "sadr": "وَأَعثَرَت آلَ عَبّاسٍ لَعاً لَهُمُ",         "ajuz": "بِذَيلِ زَبّاءَ لَم تَنفِر مِنَ الذُّعُرِ" },
    { "n": 45, "sadr": "بَني المُظَفَّرِ وَالأَيّامُ ما بَرِحَت",     "ajuz": "مَراحِلاً وَالوَرى مِنها عَلى سَفَرِ" },
    { "n": 46, "sadr": "سُحقاً لِيَومِكُمُ يَوماً وَلا حَمَلَت",      "ajuz": "بِمِثلِهِ لَيلَةٌ في غابِرِ العُمُرِ" },
    { "n": 47, "sadr": "مَن لِلأَسِرَّةِ أَو مَن لِلأَعِنَّةِ أَو",   "ajuz": "مَن لِلأَسِنَّةِ يَهديها إِلى الثُّغَرِ" },
    { "n": 48, "sadr": "مَن لِلظُّبى وَعَوالي الخَطِّ قَد عُقِدَت",   "ajuz": "أَطرافُ أَلسُنِها بِالعِيِّ وَالحَصَرِ" },
    { "n": 49, "sadr": "وَطَوَّقَت بِالمَنايا السّودِ بيضَهُمُ",      "ajuz": "فَاعجَب لِذاكَ وَما مِنها سِوى الذِّكَرِ" },
    { "n": 50, "sadr": "مَن لِليَراعَةِ أَو مَن لِلبَراعَةِ أَو",     "ajuz": "مَن لِلسَّماحَةِ أَو لِلنَّفعِ وَالضَّرَرِ" },
    { "n": 51, "sadr": "أَو دَفعِ كارِثَةٍ أَو رَدعِ آزِفَةٍ",        "ajuz": "أَو قَمعِ حادِثَةٍ تَعيا عَلى القَدَرِ" },
    { "n": 52, "sadr": "وَيبَ السَّماحِ وَوَيبَ البَأسِ لَو سَلِما",  "ajuz": "وَحَسرَةَ الدّينِ وَالدُّنيا عَلى عُمَرِ" },
    { "n": 53, "sadr": "سَقَت ثَرى الفَضلِ وَالعَبّاسِ هامِيَةٌ",     "ajuz": "تُعزى إِلَيهِم سَماحاً لا إِلى المَطَرِ" },
    { "n": 54, "sadr": "ثَلاثَةٌ ما اِرتَقى النَّسرانِ حَيثُ رَقوا", "ajuz": "وَكُلُّ ما طارَ مِن نَسرٍ وَلَم يَطِرِ" },
    { "n": 55, "sadr": "ثَلاثَةٌ كَذَواتِ الدَّهرِ مُنذُ نَأَوا",     "ajuz": "عَنّي مَضى الدَّهرُ لَم يَربَع وَلَم يَحُرِ" },
    { "n": 56, "sadr": "وَمَرَّ مِن كُلِّ شَيءٍ فيهِ أَطيَبُهُ",      "ajuz": "حَتّى التَّمَتُّعُ بِالآصالِ وَالبُكَرِ" },
    { "n": 57, "sadr": "أَينَ الجَلالُ الَّذي غَضَّت مَهابَتُهُ",     "ajuz": "قُلوبَنا وَعُيونَ الأَنجُمِ الزُّهُرِ" },
    { "n": 58, "sadr": "أَينَ الإِباءُ الَّذي أَرسَوا قَواعِدَهُ",    "ajuz": "عَلى دَعائِمَ مِن عِزٍّ وَمِن ظَفَرِ" },
    { "n": 59, "sadr": "أَينَ الوَفاءُ الَّذي أَصفَوا شَرائِعَهُ",    "ajuz": "فَلَم يَرِد أَحَدٌ مِنها عَلى كَدَرِ" },
    { "n": 60, "sadr": "كانوا رَواسِيَ أَرضِ اللَّهِ مُنذُ مَضَوا",   "ajuz": "عَنها اِستَطارَت بِمَن فيها وَلَم تَقِرِ" },
    { "n": 61, "sadr": "كانوا مَصابيحَها فَمُذ خَبَوا عَثَرَت",       "ajuz": "هَذي الخَليقَةُ يا لَلَّهِ في سَدَرِ" },
    { "n": 62, "sadr": "كانوا شَجا الدَّهرِ فَاستَهوَتهُمُ خُدَعٌ",   "ajuz": "مِنهُ بِأَحلامِ عادٍ في خُطا الخَضِرِ" },
    { "n": 63, "sadr": "وَيلُمِّهِ مِن طَلوبِ الثَّأرِ مُدرِكِهِ",    "ajuz": "مِنهُم بِأُسدٍ سَراةٍ في الوَغى صُبُرِ" },
    { "n": 64, "sadr": "مَن لي وَلا مَن بِهِم إِن أَظلَمَت نُوَبٌ",   "ajuz": "وَلَم يَكُن لَيلُها يُفضي إِلى سَحَرِ" },
    { "n": 65, "sadr": "مَن لي وَلا مَن بِهِم إِن عُطِّلَت سُنَنٌ",   "ajuz": "وَأُخفِيَت أَلسُنُ الآثارِ وَالسِّيَرِ" },
    { "n": 66, "sadr": "مَن لي وَلا مَن بِهِم إِن أَطبَقَت مِحَنٌ",   "ajuz": "وَلَم يَكُن وِردُها يَدعو إِلى صَدَرِ" },
    { "n": 67, "sadr": "عَلى الفَضائِلِ إِلّا الصَّبرَ بَعدَهُمُ",    "ajuz": "سَلامُ مُرتَقِبٍ لِلأَجرِ مُنتَظِرِ" },
    { "n": 68, "sadr": "يَرجو عَسى وَلَهُ في أُختِها أَمَلٌ",         "ajuz": "وَالدَّهرُ ذو عُقَبٍ شَتّى وَذو غِيَرِ" },
    { "n": 69, "sadr": "قَرَّطتُ آذانَ مَن فيها بِفاضِحَةٍ",          "ajuz": "عَلى الحِسانِ حَصى الياقوتِ وَالدُّرَرِ" },
    { "n": 70, "sadr": "سَيّارَةٍ في أَقاصي الأَرضِ قاطِعَةٍ",        "ajuz": "شَقاشِقاً هَدَرَت في البَدوِ وَالحَضَرِ" },
    { "n": 71, "sadr": "مُطاعَةِ الأَمرِ في الأَلبابِ قاضِيَةٍ",     "ajuz": "مِنَ المَسامِعِ ما لَم يُقضَ مِن وَطَرِ" },
    { "n": 72, "sadr": "ثُمَّ الصَّلاةُ عَلى المُختارِ سَيِّدِنا",    "ajuz": "المُصطَفى المُجتَبى المَبعوثِ مِن مُضَرِ" },
    { "n": 73, "sadr": "وَالآلِ وَالصَّحبِ ثُمَّ التّابِعينَ لَهُ",   "ajuz": "ما هَبَّ ريحٌ وَهَلَّ السُّحبُ بِالمَطَرِ" }
  ]
}
