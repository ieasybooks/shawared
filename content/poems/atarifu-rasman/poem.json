{
  "id": "atarifu-rasman",
  "poet": "qays-ibn-al-khatim",
  "title": "مُذَهَّبَةُ قَيسِ بنِ الخَطيمِ",
  "meter": "tawil",
  "rawiy": "ب",
  "abyat_in_full": 38,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَتَعرِفُ رَسماً كَاطِّرادِ المَذاهِبِ",
      "ajuz": "لِعَمرَةَ وَحشاً غَيرَ مَوقِفِ راكِبِ"
    },
    {
      "n": 2,
      "sadr": "دِيارَ الَّتي كانَت وَنَحنُ عَلى مِنىً",
      "ajuz": "تَحُلُّ بِنا لَولا نَجاءُ الرَّكائِبِ"
    },
    {
      "n": 3,
      "sadr": "تَبَدَّت لَنا كَالشَّمسِ تَحتَ غَمامَةٍ",
      "ajuz": "بَدا حاجِبٌ مِنها وَضَنَّت بِحاجِبِ"
    },
    {
      "n": 4,
      "sadr": "وَلَم أَرَها إِلّا ثَلاثاً عَلى مِنىً",
      "ajuz": "وَعَهدي بِها عَذراءُ ذاتَ ذَوائِبِ"
    },
    {
      "n": 5,
      "sadr": "وَمِثلُكِ قَد أَصبَيتُ لَيسَت بِكَنَّةٍ",
      "ajuz": "وَلا جارَةٍ وَلا حَليلَةِ صاحِبِ"
    },
    {
      "n": 6,
      "sadr": "دَعَوتُ بَني عَوفٍ لِحَقنِ دِمائِهِم",
      "ajuz": "فَلَمّا أَبَوا سامَحتُ في حَربِ حاطِبِ"
    },
    {
      "n": 7,
      "sadr": "وَكُنتُ اِمرَأً لا أَبعَثُ الحَربَ ظالِماً",
      "ajuz": "فَلَمّا أَبَوا أَشعَلتُها كُلَّ جانِبِ"
    },
    {
      "n": 8,
      "sadr": "أَرِبتُ بِدَفعِ الحَربِ حَتّى رَأَيتُها",
      "ajuz": "عَنِ الدَّفعِ لا تَزدادُ غَيرَ تَقارُبِ"
    },
    {
      "n": 9,
      "sadr": "فَإِذ لَم يَكُن عَن غايَةِ الحَربِ مَدفَعٌ",
      "ajuz": "فَأَهلاً بِها إِذ لَم تَزَل في المَراحِبِ"
    },
    {
      "n": 10,
      "sadr": "فَلَمّا رَأَيتُ الحَربَ حَرباً تَجَرَّدَت",
      "ajuz": "لَبِستُ مَعَ البُردَينِ ثَوبَ المُحارِبِ"
    },
    {
      "n": 11,
      "sadr": "مُضاعَفَةً يَغشى الأَنامِلَ فَضلُها",
      "ajuz": "كَأَنَّ قَتيرَيها عُيونُ الجَنادِبِ"
    },
    {
      "n": 12,
      "sadr": "أَتَت عُصَبٌ مِنَ الأَوسِ تَخطُرُ بِالقَنا",
      "ajuz": "كَمَشيِ الأُسودِ في رَشاشِ الأَهاضِبِ"
    },
    {
      "n": 13,
      "sadr": "رِجالٌ مَتى يُدعَوا إِلى المَوتِ يُرقِلوا",
      "ajuz": "إِلَيهِ كَإِرقالِ الجِمالِ المَصاعِبِ"
    },
    {
      "n": 14,
      "sadr": "إِذا فَزِعوا مَدّوا إِلى اللَّيلِ صارِخاً",
      "ajuz": "كَمَوجِ الأَتِيِّ المُزبِدِ المُتَراكِبِ"
    },
    {
      "n": 15,
      "sadr": "تَرى قِصَدَ المُرّانِ تَهوي كَأَنَّها",
      "ajuz": "تَذَرُّعُ خِرصانٍ بِأَيدي الشَّواطِبِ"
    },
    {
      "n": 16,
      "sadr": "صَبَحنا بِها الآطامَ حَولَ مُزاحِمٍ",
      "ajuz": "قَوانِسُ أولى بَيضِها كَالكَواكِبِ"
    },
    {
      "n": 17,
      "sadr": "لَو أَنَّكَ تُلقي حَنظَلاً فَوقَ بَيضِها",
      "ajuz": "تَدَحرَجَ عَن ذي سامِهِ المُتَقارِبِ"
    },
    {
      "n": 18,
      "sadr": "إِذا ما فَرَرنا كانَ أَسوأَ فِرارِنا",
      "ajuz": "صُدودُ الخُدودِ وَازوِرارُ المَناكِبِ"
    },
    {
      "n": 19,
      "sadr": "صُدودُ الخُدودِ وَالقَنا مُتَشاجِرٌ",
      "ajuz": "وَلا تَبرَحُ الأَقدامُ عِندَ التَّضارُبِ"
    },
    {
      "n": 20,
      "sadr": "إِذا قَصُرَت أَسيافُنا كانَ وَصلُها",
      "ajuz": "خُطانا إِلى أَعدائِنا فَنُضارِبِ"
    },
    {
      "n": 21,
      "sadr": "وَأَضرِبُهُم يَومَ الحَديقَةِ حاسِراً",
      "ajuz": "كَأَنَّ يَدي بِالسَّيفِ مِخراقُ لاعِبِ"
    },
    {
      "n": 22,
      "sadr": "وَيَومَ بُعاثٍ أَسلَمَتنا سُيوفُنا",
      "ajuz": "إِلى نَسَبٍ في جِذمِ غَسّانَ ثاقِبِ"
    },
    {
      "n": 23,
      "sadr": "يُعَرَّينَ بيضاً حينَ نَلقى عَدُوَّنا",
      "ajuz": "وَيُغمَدنَ حُمراً ناحِلاتِ المَضارِبِ"
    },
    {
      "n": 24,
      "sadr": "أَطاعَت بَنو عَوفٍ أَميراً نَهاهُمُ",
      "ajuz": "عَنِ السِّلمِ حَتّى كانَ أَوَّلَ واجِبِ"
    },
    {
      "n": 25,
      "sadr": "أَوَيتُ لِعَوفٍ إِذ تَقولُ نِساؤُهُم",
      "ajuz": "وَيَرمينَ دَفعاً لَيتَنا لَم نُحارِبِ"
    },
    {
      "n": 26,
      "sadr": "صَبَحناهُمُ شَهباءَ يَبرُقُ بَيضُها",
      "ajuz": "تُبينُ خَلاخيلَ النِّساءِ الهَوارِبِ"
    },
    {
      "n": 27,
      "sadr": "أَصابَت سَراةً مِ الأَغَرِّ سُيوفُنا",
      "ajuz": "وَغودِرَ أَولادُ الإِماءِ الحَواطِبِ"
    },
    {
      "n": 28,
      "sadr": "وَمِنّا الَّذي آلى ثَلاثينَ لَيلَةً",
      "ajuz": "عَنِ الخَمرِ حَتّى زارَكُم بِالكَتائِبِ"
    },
    {
      "n": 29,
      "sadr": "رَضيتُ لَهُم إِذ لا يَريمونَ قَعرَها",
      "ajuz": "إِلى عازِبِ الأَموالِ إِلّا بِصاحِبِ"
    },
    {
      "n": 30,
      "sadr": "فَلَولا ذُرى الآطامِ قَد تَعلَمونَهُ",
      "ajuz": "وَتَركُ الفَضا شورِكتُمُ في الكَواعِبِ"
    },
    {
      "n": 31,
      "sadr": "فَلَم تَمنَعوا مِنّا مَكاناً نُريدُهُ",
      "ajuz": "لَكُم مُحرِزاً إِلّا ظُهورَ المَشارِبِ"
    },
    {
      "n": 32,
      "sadr": "فَهَلّا لَدى الحَربِ العَوانِ صَبَرتُمُ",
      "ajuz": "لِوَقعَتِنا وَالبَأسُ صَعبُ المَراكِبِ"
    },
    {
      "n": 33,
      "sadr": "ظَأَرناكُمُ بِالبَيضِ حَتّى لَأَنتُمُ",
      "ajuz": "أَذَلُّ مِنَ السُّقبانِ بَينَ الحَلائِبِ"
    },
    {
      "n": 34,
      "sadr": "وَلَمّا هَبَطنا الحَرثَ قالَ أَميرُنا",
      "ajuz": "حَرامٌ عَلَينا الخَمرُ ما لَم نُضارِبِ"
    },
    {
      "n": 35,
      "sadr": "فَسامَحَهُ مِنّا رِجالٌ أَعِزَّةٌ",
      "ajuz": "فَما بَرِحوا حَتّى أُحِلَّت لِشارِبِ"
    },
    {
      "n": 36,
      "sadr": "فَلَيتَ سُوَيداً راءَ مَن خَرَّ مِنهُمُ",
      "ajuz": "وَمَن فَرَّ إِذ يَحدونَهُم كَالجَلائِبِ"
    },
    {
      "n": 37,
      "sadr": "فَأُبنا إِلى أَبنائِنا وَنِسائِنا",
      "ajuz": "وَما إِن تَرَكنا في بُعاثٍ بِآيِبِ"
    },
    {
      "n": 38,
      "sadr": "وَلَو غِبتُ عَن قَومي كَفَتني عَشيرَتي",
      "ajuz": "وَيَومُ بُعاثٍ كانَ يَومَ التَّغالُبِ"
    }
  ]
}
