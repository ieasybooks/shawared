{
  "id": "nuniyyat-al-rundi",
  "poet": "abu-al-baqa-al-rundi",
  "title": "نونِيَّةُ الرُّندِيِّ",
  "meter": "basit",
  "rawiy": "ن",
  "abyat_in_full": 42,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1,  "sadr": "لِكُلِّ شَيءٍ إِذا ما تَمَّ نُقصانُ", "ajuz": "فَلا يُغَرُّ بِطيبِ العَيشِ إِنسانُ" },
    { "n": 2,  "sadr": "هِيَ الأُمورُ كَما شاهَدتَها دُوَلٌ", "ajuz": "مَن سَرَّهُ زَمَنٌ ساءَتهُ أَزمانُ" },
    { "n": 3,  "sadr": "وَهَذِهِ الدّارُ لا تُبقي عَلى أَحَدٍ", "ajuz": "وَلا يَدومُ عَلى حالٍ لَها شانُ" },
    { "n": 4,  "sadr": "يُمَزِّقُ الدَّهرُ حَتماً كُلَّ سابِغَةٍ", "ajuz": "إِذا نَبَت مَشرَفِيّاتٌ وَخُرصانُ" },
    { "n": 5,  "sadr": "وَيَنتَضي كُلَّ سَيفٍ لِلفَناءِ وَلَو", "ajuz": "كانَ اِبنَ ذي يَزَنٍ وَالغِمدَ غُمدانُ" },
    { "n": 6,  "sadr": "أَينَ المُلوكُ ذَوو التّيجانِ مِن يَمَنٍ", "ajuz": "وَأَينَ مِنهُم أَكاليلٌ وَتيجانُ" },
    { "n": 7,  "sadr": "وَأَينَ ما شادَهُ شَدّادُ في إِرَمٍ", "ajuz": "وَأَينَ ما ساسَهُ في الفُرسِ ساسانُ" },
    { "n": 8,  "sadr": "وَأَينَ ما حازَهُ قارونُ مِن ذَهَبٍ", "ajuz": "وَأَينَ عادٌ وَعَدنانٌ وَقَحطانُ" },
    { "n": 9,  "sadr": "أَتى عَلى الكُلِّ أَمرٌ لا مَرَدَّ لَهُ", "ajuz": "حَتّى قَضَوا فَكَأَنَّ القَومَ ما كانوا" },
    { "n": 10, "sadr": "وَصارَ ما كانَ مِن مُلكٍ وَمِن مَلِكٍ", "ajuz": "كَما حَكى عَن خَيالِ الطَّيفِ وَسنانُ" },
    { "n": 11, "sadr": "دارَ الزَّمانُ عَلى دارا وَقاتِلِهِ", "ajuz": "وَأَمَّ كِسرى فَما آواهُ إيوانُ" },
    { "n": 12, "sadr": "كَأَنَّما الصَّعبُ لَم يَسهُل لَهُ سَبَبٌ", "ajuz": "يَوماً وَلا مَلَكَ الدُّنيا سُلَيمانُ" },
    { "n": 13, "sadr": "فَجائِعُ الدَّهرِ أَنواعٌ مُنَوَّعَةٌ", "ajuz": "وَلِلزَّمانِ مَسَرّاتٌ وَأَحزانُ" },
    { "n": 14, "sadr": "وَلِلحَوادِثِ سُلوانٌ يُسَهِّلُها", "ajuz": "وَما لِما حَلَّ بِالإِسلامِ سُلوانُ" },
    { "n": 15, "sadr": "دَهى الجَزيرَةَ أَمرٌ لا عَزاءَ لَهُ", "ajuz": "هَوى لَهُ أُحُدٌ وَانهَدَّ ثَهلانُ" },
    { "n": 16, "sadr": "أَصابَها العَينُ في الإِسلامِ فَامتُحِنَت", "ajuz": "حَتّى خَلَت مِنهُ أَقطارٌ وَبُلدانُ" },
    { "n": 17, "sadr": "فَاسأَل بَلَنسِيَةً ما شَأنُ مُرسِيَةٍ", "ajuz": "وَأَينَ شاطِبَةٌ أَم أَينَ جَيّانُ" },
    { "n": 18, "sadr": "وَأَينَ قُرطُبَةٌ دارُ العُلومِ فَكَم", "ajuz": "مِن عالِمٍ قَد سَما فيها لَهُ شانُ" },
    { "n": 19, "sadr": "وَأَينَ حِمصُ وَما تَحويهِ مِن نُزَهٍ", "ajuz": "وَنَهرُها العَذبُ فَيّاضٌ وَمَلآنُ" },
    { "n": 20, "sadr": "قَواعِدٌ كُنَّ أَركانَ البِلادِ فَما", "ajuz": "عَسى البَقاءُ إِذا لَم تَبقَ أَركانُ" },
    { "n": 21, "sadr": "تَبكي الحَنيفِيَّةُ البَيضاءُ مِن أَسَفٍ", "ajuz": "كَما بَكى لِفِراقِ الإِلفِ هَيمانُ" },
    { "n": 22, "sadr": "عَلى دِيارٍ مِنَ الإِسلامِ خالِيَةٍ", "ajuz": "قَد أَقفَرَت وَلَها بِالكُفرِ عُمرانُ" },
    { "n": 23, "sadr": "حَيثُ المَساجِدُ قَد صارَت كَنائِسَ ما", "ajuz": "فيهِنَّ إِلّا نَواقيسٌ وَصُلبانُ" },
    { "n": 24, "sadr": "حَتّى المَحاريبُ تَبكي وَهيَ جامِدَةٌ", "ajuz": "حَتّى المَنابِرُ تَرثي وَهيَ عيدانُ" },
    { "n": 25, "sadr": "يا غافِلاً وَلَهُ في الدَّهرِ مَوعِظَةٌ", "ajuz": "إِن كُنتَ في سِنَةٍ فَالدَّهرُ يَقظانُ" },
    { "n": 26, "sadr": "وَماشِياً مَرِحاً يُلهيهِ مَوطِنُهُ", "ajuz": "أَبَعدَ حِمصٍ تَغُرُّ المَرءَ أَوطانُ" },
    { "n": 27, "sadr": "تِلكَ المُصيبَةُ أَنسَت ما تَقَدَّمَها", "ajuz": "وَما لَها مَعَ طولِ الدَّهرِ نِسيانُ" },
    { "n": 28, "sadr": "يا راكِبينَ عِتاقَ الخَيلِ ضامِرَةً", "ajuz": "كَأَنَّها في مَجالِ السَّبقِ عِقبانُ" },
    { "n": 29, "sadr": "وَحامِلينَ سُيوفَ الهِندِ مُرهَفَةً", "ajuz": "كَأَنَّها في ظَلامِ النَّقعِ نيرانُ" },
    { "n": 30, "sadr": "وَراتِعينَ وَراءَ البَحرِ في دَعَةٍ", "ajuz": "لَهُم بِأَوطانِهِم عِزٌّ وَسُلطانُ" },
    { "n": 31, "sadr": "أَعِندَكُم نَبَأٌ مِن أَهلِ أَندَلُسٍ", "ajuz": "فَقَد سَرى بِحَديثِ القَومِ رُكبانُ" },
    { "n": 32, "sadr": "كَم يَستَغيثُ بِنا المُستَضعَفونَ وَهُم", "ajuz": "قَتلى وَأَسرى فَما يَهتَزُّ إِنسانُ" },
    { "n": 33, "sadr": "ماذا التَّقاطُعُ في الإِسلامِ بَينَكُمُ", "ajuz": "وَأَنتُمُ يا عِبادَ اللَّهِ إِخوانُ" },
    { "n": 34, "sadr": "أَلا نُفوسٌ أَبِيّاتٌ لَها هِمَمٌ", "ajuz": "أَما عَلى الخَيرِ أَنصارٌ وَأَعوانُ" },
    { "n": 35, "sadr": "يا مَن لِذِلَّةِ قَومٍ بَعدَ عِزِّهِمُ", "ajuz": "أَحالَ حالَهُمُ جَورٌ وَطُغيانُ" },
    { "n": 36, "sadr": "بِالأَمسِ كانوا مُلوكاً في مَنازِلِهِم", "ajuz": "وَاليَومَ هُم في بِلادِ الكُفرِ عُبدانُ" },
    { "n": 37, "sadr": "فَلَو تَراهُم حَيارى لا دَليلَ لَهُم", "ajuz": "عَلَيهِمُ مِن ثِيابِ الذُّلِّ أَلوانُ" },
    { "n": 38, "sadr": "وَلَو رَأَيتَ بُكاهُم عِندَ بَيعِهِمُ", "ajuz": "لَهالَكَ الأَمرُ وَاستَهوَتكَ أَحزانُ" },
    { "n": 39, "sadr": "يا رُبَّ أُمٍّ وَطِفلٍ حيلَ بَينَهُما", "ajuz": "كَما تَفَرَّقُ أَرواحٌ وَأَبدانُ" },
    { "n": 40, "sadr": "وَطِفلَةٍ مِثلِ حُسنِ الشَّمسِ إِذ طَلَعَت", "ajuz": "كَأَنَّما هِيَ ياقوتٌ وَمَرجانُ" },
    { "n": 41, "sadr": "يَقودُها العِلجُ لِلمَكروهِ مُكرَهَةً", "ajuz": "وَالعَينُ باكِيَةٌ وَالقَلبُ حَيرانُ" },
    { "n": 42, "sadr": "لِمِثلِ هَذا يَذوبُ القَلبُ مِن كَمَدٍ", "ajuz": "إِن كانَ في القَلبِ إِسلامٌ وَإيمانُ" }
  ]
}
