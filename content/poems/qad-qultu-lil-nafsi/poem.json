{
  "id": "qad-qultu-lil-nafsi",
  "poet": "al-sharif-al-radi",
  "title": "قَد قُلتُ لِلنَّفسِ الشَّعاعِ أَضُمُّها",
  "meter": "kamil",
  "themes": ["itab", "hija"],
  "rawiy": "ت",
  "abyat_in_full": 25,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "قَد قُلتُ لِلنَّفسِ الشَّعاعِ أَضُمُّها",
      "ajuz": "كَم ذا القِراعُ لِكُلِّ بابٍ مُصمَتِ"
    },
    {
      "n": 2,
      "sadr": "قَد آنَ أَن أَعصي المَطامِعَ طائِعاً",
      "ajuz": "لِليَأسِ جامِعَ شَملِيَ المُتَشَتِّتِ"
    },
    {
      "n": 3,
      "sadr": "يَقضي الحَريصُ وَلَيسَ يَقضي أُربَةً",
      "ajuz": "مُتَعَلِّلاً أَبَداً بِغَيرِ تَعِلَّةِ"
    },
    {
      "n": 4,
      "sadr": "قُل لِلَّذينَ بَلَوتُهُم فَوَجَدتُهُم",
      "ajuz": "آلاً وَغَيرُ الآلِ يَنقَعُ غُلَّتي"
    },
    {
      "n": 5,
      "sadr": "أَعدَدتُكُم لِدِفاعِ كُلِّ مُلِمَّةٍ",
      "ajuz": "عَنّي فَكُنتُم عَونَ كُلِّ مُلِمَّةٍ"
    },
    {
      "n": 6,
      "sadr": "وَتَخِذتُكُم لي جُنَّةً فَكَأَنَّما",
      "ajuz": "نَظَرَ العَدُوُّ مَقاتِلي مِن جُنَّتي"
    },
    {
      "n": 7,
      "sadr": "سُمَعٌ يَبُلُّ بِها الحَسودُ غَليلَهُ",
      "ajuz": "وَمَتى نُبِثنَ عَلى عَدوٍّ يَشمَتِ"
    },
    {
      "n": 8,
      "sadr": "تَأَبى ثِمارٌ أَن تَكونَ كَريمَةً",
      "ajuz": "وَفُروعُ دَوحَتِها لِئامُ المَنبِتِ"
    },
    {
      "n": 9,
      "sadr": "لَمّا رَمَيتُ إِلَيكُمُ بِمَطامِعي",
      "ajuz": "كَثُرَ الخِلاجُ مُقَلِّباً لِرَوِيَّتي"
    },
    {
      "n": 10,
      "sadr": "وَوَقَفتُ دونَكُمُ وُقوفَ مُقَسَّمٍ",
      "ajuz": "حَذَرَ المَنِيَّةِ راجِيَ الأُمنِيَّةِ"
    },
    {
      "n": 11,
      "sadr": "قَدَمٌ تَؤُمُّكُمُ وَأُخرى تَنثَني",
      "ajuz": "عَنكُم وَحَزمُ الرَّأيِ لِلمُتَثَبِّتِ"
    },
    {
      "n": 12,
      "sadr": "لَولا الحَوادِثُ ما أَفَدتُ تَجارِباً",
      "ajuz": "يَعسو الرَّطيبُ وَيَقرَحُ الجَذَعُ الفَتي"
    },
    {
      "n": 13,
      "sadr": "يَأسٌ ثَنى سَنَنَ المَطالِبِ عَنكُمُ",
      "ajuz": "وَلَوى إِلى الأَوطانِ عُنقَ مَطِيَّتي"
    },
    {
      "n": 14,
      "sadr": "لا عُذرَ لي إِلّا ذَهابي عَنكُمُ",
      "ajuz": "فَإِذا ذَهَبتُ فَيَأسُكُم مِن رَجعَتي"
    },
    {
      "n": 15,
      "sadr": "فَلَأَرحَلَنَّ رَحيلَ لا مُتَلَهِّفٍ",
      "ajuz": "لِفِراقِكُم أَبَداً وَلا مُتَلَفِّتِ"
    },
    {
      "n": 16,
      "sadr": "وَلَأَنفُضَنَّ يَدَيَّ يَأساً مِنكُمُ",
      "ajuz": "نَفضَ الأَنامِلِ مِن تُرابِ المَيِّتِ"
    },
    {
      "n": 17,
      "sadr": "وَلَأَلمَعَنَّ بِكُلِّ بَيتٍ شارِدٍ",
      "ajuz": "لَمعَ المُهَنَّدِ في يَمينِ المُصلِتِ"
    },
    {
      "n": 18,
      "sadr": "مِن كُلِّ قافِيَةٍ تَخُبُّ إِلَيكُمُ",
      "ajuz": "بِشَواظِها خَبَبَ الجَوادِ المُفلِتِ"
    },
    {
      "n": 19,
      "sadr": "وَأَقولُ لِلقَلبِ المُنازِعِ نَحوَكُم",
      "ajuz": "أَقصِر هَواكَ لَكَ اللُّتَيّا وَالَّتي"
    },
    {
      "n": 20,
      "sadr": "أَأَهُزُّ مَن لا يَنثَني وَأُديرُ مَن",
      "ajuz": "لا يَرعَوي وَأَلومُ مَن لا يَختَتي"
    },
    {
      "n": 21,
      "sadr": "يا ضَيعَةَ الأَمَلِ الَّذي وَجَّهتُهُ",
      "ajuz": "طَمَعاً إِلى الأَقوامِ بَل يا ضَيعَتي"
    },
    {
      "n": 22,
      "sadr": "وَسُرى السَّفائِنِ يَنثَني بِصُدورِها",
      "ajuz": "مَوجٌ كَأَسنِمَةِ الجِمالِ الجِلَّةِ"
    },
    {
      "n": 23,
      "sadr": "قَومٌ إِذا حَضَروا النَّدِيَّ مَهانَةً",
      "ajuz": "عَطَسَت مَوارِنُهُم بِغَيرِ مُشَمِّتِ"
    },
    {
      "n": 24,
      "sadr": "يا دَهرُ حَسبُكَ قَد أَصَبتَ مَقاتِلي",
      "ajuz": "ما زِلتَ تَطلُبُ بِالمَقادِرِ غِرَّتي"
    },
    {
      "n": 25,
      "sadr": "ما لي أُحيلُ عَلى سِواكَ بِما جَنى",
      "ajuz": "قَدَرٌ عَلى قَدَرٍ وَأَنتَ بَلِيَّتي"
    }
  ]
}
