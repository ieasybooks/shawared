{
  "id": "ala-taraqat-asmau",
  "poet": "amr-ibn-al-ahtam",
  "title": "أَلا طَرَقَت أَسماءُ وَهيَ طَروقُ",
  "meter": "tawil",
  "themes": ["karam", "fakhr"],
  "rawiy": "ق",
  "abyat_in_full": 23,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَلا طَرَقَت أَسماءُ وَهيَ طَروقُ",
      "ajuz": "وَبانَت عَلى أَنَّ الخَيالَ يَشوقُ"
    },
    {
      "n": 2,
      "sadr": "بِحاجَةِ مَحزونٍ كَأَنَّ فُؤادَهُ",
      "ajuz": "جَناحٌ وَهى عَظماهُ فَهوَ خَفوقُ"
    },
    {
      "n": 3,
      "sadr": "وَهانَ عَلى أَسماءَ أَن شَطَّتِ النَّوى",
      "ajuz": "يَحِنُّ إِلَيها والِهٌ وَيَتوقُ"
    },
    {
      "n": 4,
      "sadr": "ذَريني فَإِنَّ البُخلَ يا أُمَّ هَيثَمٍ",
      "ajuz": "لِصالِحِ أَخلاقِ الرِّجالِ سَروقُ"
    },
    {
      "n": 5,
      "sadr": "ذَريني وَحُطّي في هَوايَ فَإِنَّني",
      "ajuz": "عَلى الحَسَبِ الزّاكي الرَّفيعِ شَفيقُ"
    },
    {
      "n": 6,
      "sadr": "وَإِنّي كَريمٌ ذو عِيالٍ تُهِمُّني",
      "ajuz": "نَوائِبُ يَغشى رُزؤُها وَحُقوقُ"
    },
    {
      "n": 7,
      "sadr": "وَمُستَنبِحٍ بَعدَ الهُدوءِ دَعَوتُهُ",
      "ajuz": "وَقَد حانَ مِن نَجمِ الشِّتاءِ خُفوقُ"
    },
    {
      "n": 8,
      "sadr": "يُعالِجُ عِرنيناً مِنَ اللَّيلِ بارِداً",
      "ajuz": "تَلُفُّ رِياحٌ ثَوبَهُ وَبُروقُ"
    },
    {
      "n": 9,
      "sadr": "تَأَلَّقُ في عَينٍ مِنَ المُزنِ وادِقٍ",
      "ajuz": "لَهُ هَيدَبٌ داني السَّحابِ دَفوقُ"
    },
    {
      "n": 10,
      "sadr": "أَضَفتُ فَلَم أُفحِش عَلَيهِ وَلَم أَقُل",
      "ajuz": "لِأَحرِمَهُ إِنَّ المَكانَ مَضيقُ"
    },
    {
      "n": 11,
      "sadr": "فَقُلتُ لَهُ أَهلاً وَسَهلاً وَمَرحَباً",
      "ajuz": "فَهَذا صَبوحٌ راهِنٌ وَصَديقُ"
    },
    {
      "n": 12,
      "sadr": "وَقُمتُ إِلى البَركِ الهَواجِدِ فَاتَّقَت",
      "ajuz": "مَقاحيدُ كومٌ كَالمَجادِلِ روقُ"
    },
    {
      "n": 13,
      "sadr": "بِأَدماءَ مِرباعِ النِّتاجِ كَأَنَّها",
      "ajuz": "إِذا عَرَضَت دونَ العِشارِ فَنيقُ"
    },
    {
      "n": 14,
      "sadr": "بِضَربَةِ ساقٍ أَو بِنَجلاءَ ثَرَّةٍ",
      "ajuz": "لَها مِن أَمامِ المَنكِبَينِ فَتيقُ"
    },
    {
      "n": 15,
      "sadr": "وَقامَ إِلَيها الجازِرانِ فَأَوفَدا",
      "ajuz": "يُطيرانِ عَنها الجِلدَ وَهيَ تَفوقُ"
    },
    {
      "n": 16,
      "sadr": "فَجُرَّ إِلَينا ضَرعُها وَسَنامُها",
      "ajuz": "وَأَزهَرُ يَحبو لِلقِيامِ عَتيقُ"
    },
    {
      "n": 17,
      "sadr": "بَقيرٌ جَلا بِالسَّيفِ عَنهُ غِشاءَهُ",
      "ajuz": "أَخٌ بِإِخاءِ الصّالِحينَ رَفيقُ"
    },
    {
      "n": 18,
      "sadr": "فَباتَ لَنا مِنها وَلِلضَّيفِ مَوهِناً",
      "ajuz": "شِواءٌ سَمينٌ زاهِقٌ وَغَبوقُ"
    },
    {
      "n": 19,
      "sadr": "وَباتَ لَهُ دونَ الصَّبا وَهيَ قَرَّةٌ",
      "ajuz": "لِحافٌ وَمَصقولُ الكِساءِ رَقيقُ"
    },
    {
      "n": 20,
      "sadr": "وَكُلُّ كَريمٍ يَتَّقي الذَّمَّ بِالقِرى",
      "ajuz": "وَلِلخَيرِ بَينَ الصّالِحينَ طَريقُ"
    },
    {
      "n": 21,
      "sadr": "لَعَمرُكَ ما ضاقَت بِلادٌ بِأَهلِها",
      "ajuz": "وَلَكِنَّ أَخلاقَ الرِّجالِ تَضيقُ"
    },
    {
      "n": 22,
      "sadr": "نَمَتني عُروقٌ مِن زُرارَةَ لِلعُلى",
      "ajuz": "وَمِن فَدَكِيٍّ وَالأَشَدِّ عُروقُ"
    },
    {
      "n": 23,
      "sadr": "مَكارِمُ يَجعَلنَ الفَتى في أَرومَةٍ",
      "ajuz": "يَفاعٍ وَبَعضُ الوالِدينَ دَقيقُ"
    }
  ]
}
