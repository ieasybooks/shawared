{
  "id": "ala-umma-amrin",
  "poet": "al-shanfara",
  "title": "أَلا أُمُّ عَمرٍو أَجمَعَت فَاستَقَلَّتِ",
  "meter": "tawil",
  "themes": ["fakhr", "hamasa"],
  "rawiy": "ت",
  "abyat_in_full": 36,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَلا أُمُّ عَمرٍو أَجمَعَت فَاستَقَلَّتِ",
      "ajuz": "وَما وَدَّعَت جيرانَها إِذ تَوَلَّتِ"
    },
    {
      "n": 2,
      "sadr": "وَقَد سَبَقَتنا أُمُّ عَمرٍو بِأَمرِها",
      "ajuz": "وَكانَت بِأَعناقِ المَطِيِّ أَظَلَّتِ"
    },
    {
      "n": 3,
      "sadr": "بِعَينَيَّ ما أَمسَت فَباتَت فَأَصبَحَت",
      "ajuz": "فَقَضَّت أُموراً فَاستَقَلَّت فَوَلَّتِ"
    },
    {
      "n": 4,
      "sadr": "فَوا كَبِدا عَلى أُمَيمَةَ بَعدَ ما",
      "ajuz": "طَمِعتُ فَهَبها نِعمَةَ العَيشِ زَلَّتِ"
    },
    {
      "n": 5,
      "sadr": "فَيا جارَتي وَأَنتِ غَيرُ مُليمَةٍ",
      "ajuz": "إِذا ذُكِرَت وَلا بِذاتِ تَقَلَّتِ"
    },
    {
      "n": 6,
      "sadr": "لَقَد أَعجَبَتني لا سَقوطاً قِناعُها",
      "ajuz": "إِذا ما مَشَت وَلا بِذاتِ تَلَفُّتِ"
    },
    {
      "n": 7,
      "sadr": "تَبيتُ بُعَيدَ النَّومِ تُهدي غَبوقَها",
      "ajuz": "لِجارَتِها إِذا الهَدِيَّةُ قَلَّتِ"
    },
    {
      "n": 8,
      "sadr": "تَحُلُّ بِمَنجاةٍ مِنَ اللَّومِ بَيتَها",
      "ajuz": "إِذا ما بُيوتٌ بِالمَذَمَّةِ حُلَّتِ"
    },
    {
      "n": 9,
      "sadr": "كَأَنَّ لَها في الأَرضِ نِسياً تَقُصُّهُ",
      "ajuz": "عَلى أَمِّها وَإِن تُكَلِّمكَ تَبلَتِ"
    },
    {
      "n": 10,
      "sadr": "أُمَيمَةُ لا يُخزي نَثاها حَليلَها",
      "ajuz": "إِذا ذُكِرَ النِّسوانُ عَفَّت وَجَلَّتِ"
    },
    {
      "n": 11,
      "sadr": "إِذا هُوَ أَمسى آبَ قُرَّةَ عَينِهِ",
      "ajuz": "مَآبَ السَّعيدِ لَم يَسَل أَينَ ظَلَّتِ"
    },
    {
      "n": 12,
      "sadr": "فَدَقَّت وَجَلَّت وَاسبَكَرَّت وَأُكمِلَت",
      "ajuz": "فَلَو جُنَّ إِنسانٌ مِنَ الحُسنِ جُنَّتِ"
    },
    {
      "n": 13,
      "sadr": "فَبِتنا كَأَنَّ البَيتَ حُجِّرَ فَوقَنا",
      "ajuz": "بِرَيحانَةٍ ريحَت عِشاءً وَطُلَّتِ"
    },
    {
      "n": 14,
      "sadr": "بِرَيحانَةٍ مِن بَطنِ حَليَةَ نَوَّرَت",
      "ajuz": "لَها أَرَجٌ ما حَولَها غَيرُ مُسنِتِ"
    },
    {
      "n": 15,
      "sadr": "وَباضِعَةٍ حُمرِ القِسِيِّ بَعَثتُها",
      "ajuz": "وَمَن يَغزُ يَغنَم مَرَّةً وَيُشَمَّتِ"
    },
    {
      "n": 16,
      "sadr": "خَرَجنا مِنَ الوادي الَّذي بَينَ مِشعَلٍ",
      "ajuz": "وَبَينَ الجَبا هَيهاتَ أَنشَأتُ سُربَتي"
    },
    {
      "n": 17,
      "sadr": "أُمَشّي عَلى الأَرضِ الَّتي لَن تَضُرَّني",
      "ajuz": "لِأَنكِيَ قَوماً أَو أُصادِفَ حُمَّتي"
    },
    {
      "n": 18,
      "sadr": "أُمَشّي عَلى أَينِ الغَزاةِ وَبُعدِها",
      "ajuz": "يُقَرِّبُني مِنها رَواحي وَغَدوَتي"
    },
    {
      "n": 19,
      "sadr": "وَأُمِّ عِيالٍ قَد شَهِدتُ تَقوتُهُم",
      "ajuz": "إِذا أَطعَمَتهُم أَوتَحَت وَأَقَلَّتِ"
    },
    {
      "n": 20,
      "sadr": "تَخافُ عَلَينا العَيلَ إِن هِيَ أَكثَرَت",
      "ajuz": "وَنَحنُ جِياعٌ أَيَّ آلٍ تَأَلَّتِ"
    },
    {
      "n": 21,
      "sadr": "وَما إِن بِها ضِنٌّ بِما في وِعائِها",
      "ajuz": "وَلَكِنَّها مِن خيفَةِ الجوعِ أَبقَتِ"
    },
    {
      "n": 22,
      "sadr": "مُصَعلِكَةٍ لا يَقصُرُ السِّترُ دونَها",
      "ajuz": "وَلا تُرتَجى لِلبَيتِ إِن لَم تُبَيِّتِ"
    },
    {
      "n": 23,
      "sadr": "لَها وَفضَةٌ مِنها ثَلاثونَ سَيحَفاً",
      "ajuz": "إِذا آنَسَت أُولى العَدِيِّ اِقشَعَرَّتِ"
    },
    {
      "n": 24,
      "sadr": "وَتَأتي العَدِيَّ بارِزاً نِصفُ ساقِها",
      "ajuz": "تَجولُ كَعَيرِ العانَةِ المُتَلَفِّتِ"
    },
    {
      "n": 25,
      "sadr": "إِذا فَزِعوا طارَت بِأَبيَضَ صارِمٍ",
      "ajuz": "وَرامَت بِما في جَفرِها ثُمَّ سَلَّتِ"
    },
    {
      "n": 26,
      "sadr": "حُسامٍ كَلَونِ المِلحِ صافٍ حَديدُهُ",
      "ajuz": "جُرازٍ كَأَقطاعِ الغَديرِ المُنَعَّتِ"
    },
    {
      "n": 27,
      "sadr": "تَراها كَأَذنابِ الحَسيلِ صَوادِراً",
      "ajuz": "وَقَد نَهِلَت مِنَ الدِّماءِ وَعَلَّتِ"
    },
    {
      "n": 28,
      "sadr": "قَتَلنا قَتيلاً مُهدِياً بِمُلَبِّدٍ",
      "ajuz": "جِمارَ مِنىً وَسطَ الحَجيجِ المُصَوِّتِ"
    },
    {
      "n": 29,
      "sadr": "جَزَينا سَلامانَ اِبنَ مُفرِجَ قَرضَها",
      "ajuz": "بِما قَدَّمَت أَيديهِمُ وَأَزَلَّتِ"
    },
    {
      "n": 30,
      "sadr": "وَهُنِّئَ بي قَومٌ وَما إِن هَنَأتُهُم",
      "ajuz": "وَأَصبَحتُ في قَومٍ وَلَيسوا بِمُنيَتي"
    },
    {
      "n": 31,
      "sadr": "شَفَينا بِعَبدِ اللَّهِ بَعضَ غَليلِنا",
      "ajuz": "وَعَوفٍ لَدى المَعدى أَوانَ اِستَهَلَّتِ"
    },
    {
      "n": 32,
      "sadr": "إِذا ما أَتَتني ميتَتي لَم أُبالِها",
      "ajuz": "وَلَم تُذرِ خالاتي الدُّموعَ وَعَمَّتي"
    },
    {
      "n": 33,
      "sadr": "وَلَو لَم أَرِم في أَهلِ بَيتِيَ قاعِداً",
      "ajuz": "إِذَن جاءَني بَينَ العَمودَينِ حُمَّتي"
    },
    {
      "n": 34,
      "sadr": "أَلا لا تَعُدني إِن تَشَكَّيتُ خَلَّتي",
      "ajuz": "شَفاني بِأَعلى ذي البُرَيقَينِ عَدوَتي"
    },
    {
      "n": 35,
      "sadr": "وَإِنّي لَحُلوٌ إِن أُريدَت حَلاوَتي",
      "ajuz": "وَمُرٌّ إِذا نَفسُ العَزوفِ اِستَمَرَّتِ"
    },
    {
      "n": 36,
      "sadr": "أَبِيٌّ لِما آبى سَريعٌ مَباءَتي",
      "ajuz": "إِلى كُلِّ نَفسٍ تَنتَحي في مَسَرَّتي"
    }
  ]
}
