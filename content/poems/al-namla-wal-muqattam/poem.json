{
  "id": "al-namla-wal-muqattam",
  "poet": "ahmad-shawqi",
  "title": "النَّملَةُ وَالمُقَطَّمُ",
  "meter": "ramal",
  "themes": ["fables", "hikma"],
  "rawiy": "م",
  "abyat_in_full": 12,
  "added": "2026-11-24",
  "abyat": [
    {"n": 1, "sadr": "كانَتِ النَّملَةُ تَمشي", "ajuz": "مَرَّةً تَحتَ المُقَطَّم"},
    {"n": 2, "sadr": "فَارتَخى مَفصِلُها مِن", "ajuz": "هَيبَةِ الطَّودِ المُعَظَّم"},
    {"n": 3, "sadr": "وَانثَنَت تَنظُرُ حَتّى", "ajuz": "أَوجَدَ الخَوفُ وَأَعدَم"},
    {"n": 4, "sadr": "قالَتِ اليَومَ هَلاكي", "ajuz": "حَلَّ يَومي وَتَحَتَّم"},
    {"n": 5, "sadr": "لَيتَ شِعري كَيفَ أَنجو", "ajuz": "إِن هَوى هَذا وَأَسلَم"},
    {"n": 6, "sadr": "فَسَعَت تَجري وَعَينا", "ajuz": "ها تَرى الطَّودَ فَتَندَم"},
    {"n": 7, "sadr": "سَقَطَت في شِبرِ ماءٍ", "ajuz": "هُوَ عِندَ النَّملِ كَاليَمِّ"},
    {"n": 8, "sadr": "فَبَكَت يَأساً وَصاحَت", "ajuz": "قَبلَ جَريِ الماءِ في الفَم"},
    {"n": 9, "sadr": "ثُمَّ قالَت وَهيَ أَدرى", "ajuz": "بِالَّذي قالَت وَأَعلَم"},
    {"n": 10, "sadr": "لَيتَني لَم أَتَأَخَّر", "ajuz": "لَيتَني لَم أَتَقَدَّم"},
    {"n": 11, "sadr": "لَيتَني سَلَّمتُ فَالعا", "ajuz": "قِلُ مَن خافَ فَسَلَّم"},
    {"n": 12, "sadr": "صاحِ لا تَخشَ عَظيماً", "ajuz": "فَالَّذي في الغَيبِ أَعظَم"}
  ]
}
