{
  "id": "arafa-al-hawa",
  "poet": "mahmud-sami-al-barudi",
  "title": "عَرَفَ الهَوى في نَظرَتي فَنَهاني",
  "meter": "kamil",
  "themes": ["ghazal", "wasf"],
  "rawiy": "ن",
  "abyat_in_full": 16,
  "added": "2026-11-19",
  "abyat": [
    {
      "n": 1,
      "sadr": "عَرَفَ الهَوى في نَظرَتي فَنَهاني",
      "ajuz": "خِلٌّ رَعَيتُ وِدادَهُ فَرَعاني"
    },
    {
      "n": 2,
      "sadr": "أَخفَيتُ عَنهُ سَريرَتي فَوَشى بِها",
      "ajuz": "دَمعٌ أَباحَ لَهُ حِمى كِتماني"
    },
    {
      "n": 3,
      "sadr": "فَبِأَيِّ مَعذِرَةٍ أُكَذِّبُ لَوعَةً",
      "ajuz": "شَهِدَت بِها العَبَراتُ مِن أَجفاني"
    },
    {
      "n": 4,
      "sadr": "يا صاحِ لا أَبصَرتَ ما صَنَعَ الهَوى",
      "ajuz": "بِأَخيكَ يَومَ تَفَرُّقِ الأَظعانِ"
    },
    {
      "n": 5,
      "sadr": "يَومٌ فَقَدتُ الحِلمَ فيهِ وَشَفَّني",
      "ajuz": "وَلَهٌ أَصابَ جَوانِحي فَرَماني"
    },
    {
      "n": 6,
      "sadr": "فَعَلَيكَ مِن قَلبي السَّلامُ فَإِنَّهُ",
      "ajuz": "تَبِعَ الهَوى فَمَضى بِغَيرِ عِنانِ"
    },
    {
      "n": 7,
      "sadr": "هَيهاتَ يَرجِعُ بَعدَما عَلِقَت بِهِ",
      "ajuz": "لَحَظاتُ ذاكَ الشّادِنِ الفَتّانِ"
    },
    {
      "n": 8,
      "sadr": "وَعَلى الرَّحائِلِ نِسوَةٌ عَرَبِيَّةٌ",
      "ajuz": "يَخدَعنَ لُبَّ الحازِمِ اليَقظانِ"
    },
    {
      "n": 9,
      "sadr": "ما كُنتُ أَعلَمُ قَبلَ بادِرَةِ النَّوى",
      "ajuz": "أَنَّ الأُسودَ فَرائِسُ الغِزلانِ"
    },
    {
      "n": 10,
      "sadr": "رَحَلوا فَأَيَّةُ عَبرَةٍ مَسفوحَةٍ",
      "ajuz": "وَيَدٍ تَضُمُّ حَشاً مِنَ الخَفَقانِ"
    },
    {
      "n": 11,
      "sadr": "وَلَقَد حَنَنتُ لِبارِقٍ شَخَصَت لَهُ",
      "ajuz": "مِنّا العُيونُ بِأَبرَقِ الحَنّانِ"
    },
    {
      "n": 12,
      "sadr": "يَستَنُّ في عُرضِ الغَمامِ كَأَنَّهُ",
      "ajuz": "لَهَبٌ تَرَدَّدَ في سَماءِ دُخانِ"
    },
    {
      "n": 13,
      "sadr": "فَانظُر لَعَلَّكَ تَستَبينُ رِكابَهُ",
      "ajuz": "طَوعَ الرِّياحِ يُصيبُ أَيَّ مَكانِ"
    },
    {
      "n": 14,
      "sadr": "فَهُناكَ تَجتَمِعُ الشُّعوبُ وَتَلتَقي",
      "ajuz": "هُدبُ الخُدورِ عَلى غُصونِ البانِ"
    }
  ]
}
