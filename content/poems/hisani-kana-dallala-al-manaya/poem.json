{
  "id": "hisani-kana-dallala-al-manaya",
  "poet": "antara",
  "title": "حِصاني كانَ دَلّالَ المَنايا",
  "meter": "wafir",
  "themes": ["fakhr", "hamasa"],
  "rawiy": "ع",
  "abyat_in_full": 14,
  "added": "2026-11-24",
  "abyat": [
    {"n": 1, "sadr": "حِصاني كانَ دَلّالَ المَنايا", "ajuz": "فَخاضَ غُبارَها وَشَرى وَباعا"},
    {"n": 2, "sadr": "وَسَيفي كانَ في الهَيجا طَبيباً", "ajuz": "يُداوي رَأسَ مَن يَشكو الصُّداعا"},
    {"n": 3, "sadr": "أَنا العَبدُ الَّذي خُبِّرتَ عَنهُ", "ajuz": "وَقَد عايَنتَني فَدَعِ السَّماعا"},
    {"n": 4, "sadr": "وَلَو أَرسَلتُ رُمحي مَع جَبانٍ", "ajuz": "لَكانَ بِهَيبَتي يَلقى السِّباعا"},
    {"n": 5, "sadr": "مَلَأتُ الأَرضَ خَوفاً مِن حُسامي", "ajuz": "وَخَصمي لَم يَجِد فيها اِتِّساعا"},
    {"n": 6, "sadr": "إِذا الأَبطالُ فَرَّت خَوفَ بَأسي", "ajuz": "تَرى الأَقطارَ باعاً أَو ذِراعا"}
  ]
}
