{
  "id": "maghani-al-shib",
  "poet": "al-mutanabbi",
  "title": "مَغاني الشِّعبِ طيباً في المَغاني",
  "meter": "wafir",
  "rawiy": "ن",
  "abyat_in_full": 48,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "مَغاني الشِّعبِ طيباً في المَغاني",
      "ajuz": "بِمَنزِلَةِ الرَّبيعِ مِنَ الزَّمانِ"
    },
    {
      "n": 2,
      "sadr": "وَلَكِنَّ الفَتى العَرَبِيَّ فيها",
      "ajuz": "غَريبُ الوَجهِ وَاليَدِ وَاللِّسانِ"
    },
    {
      "n": 3,
      "sadr": "مَلاعِبُ جِنَّةٍ لَو سارَ فيها",
      "ajuz": "سُلَيمانٌ لَسارَ بِتَرجُمانِ"
    },
    {
      "n": 4,
      "sadr": "طَبَت فُرسانَنا وَالخَيلَ حَتّى",
      "ajuz": "خَشيتُ وَإِن كَرُمنَ مِنَ الحِرانِ"
    },
    {
      "n": 5,
      "sadr": "غَدَونا تَنفُضُ الأَغصانُ فيها",
      "ajuz": "عَلى أَعرافِها مِثلَ الجُمانِ"
    },
    {
      "n": 6,
      "sadr": "فَسِرتُ وَقَد حَجَبنَ الحَرَّ عَنّي",
      "ajuz": "وَجِئنَ مِنَ الضِّياءِ بِما كَفاني"
    },
    {
      "n": 7,
      "sadr": "وَأَلقى الشَّرقُ مِنها في ثِيابي",
      "ajuz": "دَنانيراً تَفِرُّ مِنَ البَنانِ"
    },
    {
      "n": 8,
      "sadr": "لَها ثَمَرٌ تُشيرُ إِلَيكَ مِنهُ",
      "ajuz": "بِأَشرِبَةٍ وَقَفنَ بِلا أَواني"
    },
    {
      "n": 9,
      "sadr": "وَأَمواهٌ تَصِلُّ بِها حَصاها",
      "ajuz": "صَليلَ الحَليِ في أَيدي الغَواني"
    },
    {
      "n": 10,
      "sadr": "وَلَو كانَت دِمَشقَ ثَنى عِناني",
      "ajuz": "لَبيقُ الثَّردِ صينِيُّ الجِفانِ"
    },
    {
      "n": 11,
      "sadr": "يَلَنجوجِيُّ ما رُفِعَت لِضَيفٍ",
      "ajuz": "بِها النّيرانُ نَدِّيُّ الدُّخانِ"
    },
    {
      "n": 12,
      "sadr": "تَحُلُّ بِهِ عَلى قَلبٍ شُجاعٍ",
      "ajuz": "وَتَرحَلُ مِنهُ عَن قَلبٍ جَبانِ"
    },
    {
      "n": 13,
      "sadr": "مَنازِلُ لَم يَزَل مِنها خَيالٌ",
      "ajuz": "يُشَيِّعُني إِلى النَّوبَندَجانِ"
    },
    {
      "n": 14,
      "sadr": "إِذا غَنّى الحَمامُ الوُرقُ فيها",
      "ajuz": "أَجابَتهُ أَغانِيُّ القِيانِ"
    },
    {
      "n": 15,
      "sadr": "وَمَن بِالشِّعبِ أَحوَجُ مِن حَمامٍ",
      "ajuz": "إِذا غَنّى وَناحَ إِلى البَيانِ"
    },
    {
      "n": 16,
      "sadr": "وَقَد يَتَقارَبُ الوَصفانِ جِدّاً",
      "ajuz": "وَمَوصوفاهُما مُتَباعِدانِ"
    },
    {
      "n": 17,
      "sadr": "يَقولُ بِشِعبِ بَوّانٍ حِصاني",
      "ajuz": "أَعَن هَذا يُسارُ إِلى الطِّعانِ"
    },
    {
      "n": 18,
      "sadr": "أَبوكُم آدَمٌ سَنَّ المَعاصي",
      "ajuz": "وَعَلَّمَكُم مُفارَقَةَ الجِنانِ"
    },
    {
      "n": 19,
      "sadr": "فَقُلتُ إِذا رَأَيتُ أَبا شُجاعٍ",
      "ajuz": "سَلَوتُ عَنِ العِبادِ وَذا المَكانِ"
    },
    {
      "n": 20,
      "sadr": "فَإِنَّ النّاسَ وَالدُّنيا طَريقٌ",
      "ajuz": "إِلى مَن ما لَهُ في النّاسِ ثاني"
    },
    {
      "n": 21,
      "sadr": "لَقَد عَلَّمتُ نَفسِيَ القَولَ فيهِم",
      "ajuz": "كَتَعليمِ الطِّرادِ بِلا سِنانِ"
    },
    {
      "n": 22,
      "sadr": "بِعَضدِ الدَّولَةِ اِمتَنَعَت وَعَزَّت",
      "ajuz": "وَلَيسَ لِغَيرِ ذي عَضُدٍ يَدانِ"
    },
    {
      "n": 23,
      "sadr": "وَلا قَبضٌ عَلى البيضِ المَواضي",
      "ajuz": "وَلا حَطٌّ مِنَ السُّمرِ اللِّدانِ"
    },
    {
      "n": 24,
      "sadr": "دَعَتهُ بِمَفزَعِ الأَعضاءِ مِنها",
      "ajuz": "لِيَومِ الحَربِ بِكرٍ أَو عَوانِ"
    },
    {
      "n": 25,
      "sadr": "فَما يُسمي كَفَنّاخُسرَ مُسمٍ",
      "ajuz": "وَلا يَكني كَفَنّاخُسرَ كانِ"
    },
    {
      "n": 26,
      "sadr": "وَلا تُحصى فَضائِلُهُ بِظَنٍّ",
      "ajuz": "وَلا الإِخبارِ عَنهُ وَلا العِيانِ"
    },
    {
      "n": 27,
      "sadr": "أُروضُ النّاسِ مِن تُربٍ وَخَوفٍ",
      "ajuz": "وَأَرضُ أَبي شُجاعٍ مِن أَمانِ"
    },
    {
      "n": 28,
      "sadr": "يُذِمُّ عَلى اللُّصوصِ لِكُلِّ تَجرٍ",
      "ajuz": "وَيَضمَنُ لِلصَّوارِمِ كُلَّ جاني"
    },
    {
      "n": 29,
      "sadr": "إِذا طَلَبَت وَدائِعُهُم ثِقاتٍ",
      "ajuz": "دُفِعنَ إِلى المَحاني وَالرِّعانِ"
    },
    {
      "n": 30,
      "sadr": "فَباتَت فَوقَهُنَّ بِلا صِحابٍ",
      "ajuz": "تَصيحُ بِمَن يَمُرُّ أَلا تَراني"
    },
    {
      "n": 31,
      "sadr": "رُقاهُ كُلُّ أَبيَضَ مَشرَفِيٍّ",
      "ajuz": "لِكُلِّ أَصَمَّ صِلٍّ أُفعُوانِ"
    },
    {
      "n": 32,
      "sadr": "وَما تُرقى لُهاهُ مِن نَداهُ",
      "ajuz": "وَلا المالُ الكَريمُ مِنَ الهَوانِ"
    },
    {
      "n": 33,
      "sadr": "حَمى أَطرافَ فارِسَ شَمَّرِيٌّ",
      "ajuz": "يَحُضُّ عَلى التَّباقي بِالتَّفاني"
    },
    {
      "n": 34,
      "sadr": "بِضَربٍ هاجَ أَطرابَ المَنايا",
      "ajuz": "سِوى ضَربِ المَثالِثِ وَالمَثاني"
    },
    {
      "n": 35,
      "sadr": "كَأَنَّ دَمَ الجَماجِمِ في العَناصي",
      "ajuz": "كَسا البُلدانَ ريشَ الحَيقُطانِ"
    },
    {
      "n": 36,
      "sadr": "فَلَو طُرِحَت قُلوبُ العِشقِ فيها",
      "ajuz": "لَما خافَت مِنَ الحَدَقِ الحِسانِ"
    },
    {
      "n": 37,
      "sadr": "وَلَم أَرَ قَبلَهُ شِبلَي هِزَبرٍ",
      "ajuz": "كَشِبلَيهِ وَلا مُهرَي رِهانِ"
    },
    {
      "n": 38,
      "sadr": "أَشَدَّ تَنازُعاً لِكَريمِ أَصلٍ",
      "ajuz": "وَأَشبَهَ مَنظَراً بِأَبٍ هِجانِ"
    },
    {
      "n": 39,
      "sadr": "وَأَكثَرَ في مَجالِسِهِ اِستِماعاً",
      "ajuz": "فُلانٌ دَقَّ رُمحاً في فُلانِ"
    },
    {
      "n": 40,
      "sadr": "وَأَوَّلُ رَأيَةٍ رَأَيا المَعالي",
      "ajuz": "فَقَد عَلِقا بِها قَبلَ الأَوانِ"
    },
    {
      "n": 41,
      "sadr": "وَأَوَّلُ لَفظَةٍ فَهِما وَقالا",
      "ajuz": "إِغاثَةُ صارِخٍ أَو فَكُّ عاني"
    },
    {
      "n": 42,
      "sadr": "وَكُنتَ الشَّمسَ تَبهَرُ كُلَّ عَينٍ",
      "ajuz": "فَكَيفَ وَقَد بَدَت مَعَها اِثنَتانِ"
    },
    {
      "n": 43,
      "sadr": "فَعاشا عيشَةَ القَمَرَينِ يُحيا",
      "ajuz": "بِضَوئِهِما وَلا يَتَحاسَدانِ"
    },
    {
      "n": 44,
      "sadr": "وَلا مَلَكا سِوى مُلكِ الأَعادي",
      "ajuz": "وَلا وَرِثا سِوى مَن يَقتُلانِ"
    },
    {
      "n": 45,
      "sadr": "وَكانَ اِبنا عَدُوٍّ كاثَراهُ",
      "ajuz": "لَهُ ياءَي حُروفِ أُنَيسِيانِ"
    },
    {
      "n": 46,
      "sadr": "دُعاءٌ كَالثَّناءِ بِلا رِثاءٍ",
      "ajuz": "يُؤَدّيهِ الجَنانُ إِلى الجَنانِ"
    },
    {
      "n": 47,
      "sadr": "فَقَد أَصبَحتَ مِنهُ في فِرِندٍ",
      "ajuz": "وَأَصبَحَ مِنكَ في عَضبٍ يَماني"
    },
    {
      "n": 48,
      "sadr": "وَلَولا كَونُكُم في النّاسِ كانوا",
      "ajuz": "هَراءً كَالكَلامِ بِلا مَعاني"
    }
  ]
}
