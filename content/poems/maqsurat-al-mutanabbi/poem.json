{
  "id": "maqsurat-al-mutanabbi",
  "poet": "al-mutanabbi",
  "title": "أَلا كُلُّ ماشِيَةِ الخَيزَلى",
  "meter": "mutaqarib",
  "rawiy": "ا",
  "abyat_in_full": 36,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "أَلا كُلُّ ماشِيَةِ الخَيزَلى", "ajuz": "فِدى كُلِّ ماشِيَةِ الهَيذَبى" },
    { "n": 2,  "sadr": "وَكُلِّ نَجاةٍ بُجاوِيَّةٍ", "ajuz": "خَنوفٍ وَما بِيَ حُسنُ المِشى" },
    { "n": 3,  "sadr": "وَلَكِنَّهُنَّ حِبالُ الحَياةِ", "ajuz": "وَكَيدُ العُداةِ وَمَيطُ الأَذى" },
    { "n": 4,  "sadr": "ضَرَبتُ بِها التّيهَ ضَربَ القِما", "ajuz": "رِ إِمّا لِهَذا وَإِمّا لِذا" },
    { "n": 5,  "sadr": "إِذا فَزِعَت قَدَّمَتها الجِيادُ", "ajuz": "وَبيضُ السُّيوفِ وَسُمرُ القَنا" },
    { "n": 6,  "sadr": "فَمَرَّت بِنَخلٍ وَفي رَكبِها", "ajuz": "عَنِ العالَمينَ وَعَنهُ غِنى" },
    { "n": 7,  "sadr": "وَأَمسَت تُخَيِّرُنا بِالنِّقا", "ajuz": "بِ وادي المِياهِ وَوادي القُرى" },
    { "n": 8,  "sadr": "وَقُلنا لَها أَينَ أَرضُ العِراقِ", "ajuz": "فَقالَت وَنَحنُ بِتُربانَ ها" },
    { "n": 9,  "sadr": "وَهَبَّت بِحِسمى هُبوبَ الدَّبو", "ajuz": "رِ مُستَقبِلاتٍ مَهَبَّ الصَّبا" },
    { "n": 10, "sadr": "رَوامي الكِفافِ وَكِبدِ الوِهادِ", "ajuz": "وَجارِ البُوَيرَةِ وادي الغَضى" },
    { "n": 11, "sadr": "وَجابَت بُسَيطَةَ جَوبَ الرِّدا", "ajuz": "ءِ بَينَ النَّعامِ وَبَينَ المَها" },
    { "n": 12, "sadr": "إِلى عُقدَةِ الجَوفِ حَتّى شَفَت", "ajuz": "بِماءِ الجُراوِيِّ بَعضَ الصَّدى" },
    { "n": 13, "sadr": "وَلاحَ لَها صَوَرٌ وَالصَّباحَ", "ajuz": "وَلاحَ الشَّغورُ لَها وَالضُّحى" },
    { "n": 14, "sadr": "وَمَسّى الجُمَيعِيَّ دِئداؤُها", "ajuz": "وَغادى الأَضارِعَ ثُمَّ الدَّنا" },
    { "n": 15, "sadr": "فَيا لَكَ لَيلاً عَلى أَعكُشٍ", "ajuz": "أَحَمَّ البِلادِ خَفِيَّ الصُّوى" },
    { "n": 16, "sadr": "وَرَدنا الرُّهَيمَةَ في جَوزِهِ", "ajuz": "وَباقيهِ أَكثَرُ مِمّا مَضى" },
    { "n": 17, "sadr": "فَلَمّا أَنَخنا رَكَزنا الرِّما", "ajuz": "حَ فَوقَ مَكارِمِنا وَالعُلا" },
    { "n": 18, "sadr": "وَبِتنا نُقَبِّلُ أَسيافَنا", "ajuz": "وَنَمسَحُها مِن دِماءِ العِدا" },
    { "n": 19, "sadr": "لِتَعلَمَ مِصرُ وَمَن بِالعِراقِ", "ajuz": "وَمَن بِالعَواصِمِ أَنّي الفَتى" },
    { "n": 20, "sadr": "وَأَنّي وَفَيتُ وَأَنّي أَبَيتُ", "ajuz": "وَأَنّي عَتَوتُ عَلى مَن عَتا" },
    { "n": 21, "sadr": "وَما كُلُّ مَن قالَ قَولاً وَفى", "ajuz": "وَلا كُلُّ مَن سيمَ خَسفاً أَبى" },
    { "n": 22, "sadr": "وَلا بُدَّ لِلقَلبِ مِن آلَةٍ", "ajuz": "وَرَأيٍ يُصَدِّعُ صُمَّ الصَّفا" },
    { "n": 23, "sadr": "وَمَن يَكُ قَلبٌ كَقَلبي لَهُ", "ajuz": "يَشُقُّ إِلى العِزِّ قَلبَ التَّوى" },
    { "n": 24, "sadr": "وَكُلُّ طَريقٍ أَتاهُ الفَتى", "ajuz": "عَلى قَدَرِ الرِّجلِ فيهِ الخُطا" },
    { "n": 25, "sadr": "وَنامَ الخُوَيدِمُ عَن لَيلِنا", "ajuz": "وَقَد نامَ قَبلُ عَمىً لا كَرى" },
    { "n": 26, "sadr": "وَكانَ عَلى قُربِنا بَينَنا", "ajuz": "مَهامِهُ مِن جَهلِهِ وَالعَمى" },
    { "n": 27, "sadr": "وَمَن جَهِلَت نَفسُهُ قَدرَهُ", "ajuz": "رَأى غَيرُهُ مِنهُ ما لا يَرى" }
  ]
}
