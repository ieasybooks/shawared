{
  "id": "liaynayki-ma-yalqa",
  "poet": "al-mutanabbi",
  "title": "لِعَينَيكِ ما يَلقى الفُؤادُ وَما لَقي",
  "meter": "tawil",
  "rawiy": "ق",
  "abyat_in_full": 43,
  "added": "2026-11-16",
  "abyat": [
    { "n": 1,  "sadr": "لِعَينَيكِ ما يَلقى الفُؤادُ وَما لَقي", "ajuz": "وَلِلحُبِّ ما لَم يَبقَ مِنّي وَما بَقي" },
    { "n": 2,  "sadr": "وَما كُنتُ مِمَّن يَدخُلُ العِشقُ قَلبَهُ", "ajuz": "وَلَكِنَّ مَن يُبصِر جُفونَكِ يَعشَقِ" },
    { "n": 3,  "sadr": "وَبَينَ الرِّضا وَالسُّخطِ وَالقُربِ وَالنَّوى", "ajuz": "مَجالٌ لِدَمعِ المُقلَةِ المُتَرَقرِقِ" },
    { "n": 4,  "sadr": "وَأَحلى الهَوى ما شَكَّ في الوَصلِ رَبُّهُ", "ajuz": "وَفي الهَجرِ فَهوَ الدَّهرَ يَرجو وَيَتَّقي" },
    { "n": 5,  "sadr": "وَغَضبى مِنَ الإِدلالِ سَكرى مِنَ الصِّبا", "ajuz": "شَفَعتُ إِلَيها مِن شَبابي بِرَيِّقِ" },
    { "n": 6,  "sadr": "وَأَشنَبَ مَعسولِ الثَّنِيّاتِ واضِحٍ", "ajuz": "سَتَرتُ فَمي عَنهُ فَقَبَّلَ مَفرِقي" },
    { "n": 7,  "sadr": "وَأَجيادِ غِزلانٍ كَجيدِكِ زُرنَني", "ajuz": "فَلَم أَتَبَيَّن عاطِلاً مِن مُطَوَّقِ" },
    { "n": 8,  "sadr": "وَما كُلُّ مَن يَهوى يَعِفُّ إِذا خَلا", "ajuz": "عَفافي وَيُرضي الحِبَّ وَالخَيلُ تَلتَقي" },
    { "n": 9,  "sadr": "سَقى اللَّهُ أَيّامَ الصِّبا ما يَسُرُّها", "ajuz": "وَيَفعَلُ فِعلَ البابِلِيِّ المُعَتَّقِ" },
    { "n": 10, "sadr": "إِذا ما لَبِستَ الدَّهرَ مُستَمتِعاً بِهِ", "ajuz": "تَخَرَّقتَ وَالمَلبوسُ لَم يَتَخَرَّقِ" },
    { "n": 11, "sadr": "وَلَم أَرَ كَالأَلحاظِ يَومَ رَحيلِهِم", "ajuz": "بَعَثنَ بِكُلِّ القَتلِ مِن كُلِّ مُشفِقِ" },
    { "n": 12, "sadr": "أَدَرنَ عُيوناً حائِراتٍ كَأَنَّها", "ajuz": "مُرَكَّبَةٌ أَحداقُها فَوقَ زِئبَقِ" },
    { "n": 13, "sadr": "عَشِيَّةَ يَعدونا عَنِ النَّظَرِ البُكا", "ajuz": "وَعَن لَذَّةِ التَّوديعِ خَوفُ التَّفَرُّقِ" },
    { "n": 14, "sadr": "نُوَدِّعُهُم وَالبَينُ فينا كَأَنَّهُ", "ajuz": "قَنا اِبنِ أَبي الهَيجاءِ في قَلبِ فَيلَقِ" },
    { "n": 15, "sadr": "قَواضٍ مَواضٍ نَسجُ داوُدَ عِندَها", "ajuz": "إِذا وَقَعَت فيهِ كَنَسجِ الخَدَرنَقِ" },
    { "n": 16, "sadr": "هَوادٍ لِأَملاكِ الجُيوشِ كَأَنَّها", "ajuz": "تَخَيَّرُ أَرواحَ الكُماةِ وَتَنتَقي" },
    { "n": 17, "sadr": "تَقُدُّ عَلَيهِم كُلَّ دِرعٍ وَجَوشَنٍ", "ajuz": "وَتَفري إِلَيهِم كُلَّ سورٍ وَخَندَقِ" },
    { "n": 18, "sadr": "يُغيرُ بِها بَينَ اللُّقانِ وَواسِطٍ", "ajuz": "وَيُركِزُها بَينَ الفُراتِ وَجِلِّقِ" },
    { "n": 19, "sadr": "وَيُرجِعُها حُمراً كَأَنَّ صَحيحَها", "ajuz": "يُبَكّي دَماً مِن رَحمَةِ المُتَدَقِّقِ" },
    { "n": 20, "sadr": "فَلا تُبلِغاهُ ما أَقولُ فَإِنَّهُ", "ajuz": "شُجاعٌ مَتى يُذكَر لَهُ الطَّعنُ يَشتَقِ" },
    { "n": 21, "sadr": "ضَروبٌ بِأَطرافِ السُّيوفِ بَنانُهُ", "ajuz": "لَعوبٌ بِأَطرافِ الكَلامِ المُشَقَّقِ" },
    { "n": 22, "sadr": "كَسائِلِهِ مَن يَسأَلُ الغَيثَ قَطرَةً", "ajuz": "كَعاذِلِهِ مَن قالَ لِلفَلَكِ اُرفُقِ" },
    { "n": 23, "sadr": "لَقَد جُدتَ حَتّى جُدتَ في كُلِّ مِلَّةٍ", "ajuz": "وَحَتّى أَتاكَ الحَمدُ مِن كُلِّ مَنطِقِ" },
    { "n": 24, "sadr": "رَأى مَلِكُ الرّومِ اِرتِياحَكَ لِلنَّدى", "ajuz": "فَقامَ مَقامَ المُجتَدي المُتَمَلِّقِ" },
    { "n": 25, "sadr": "وَخَلّى الرِّماحَ السَّمهَرِيَّةَ صاغِراً", "ajuz": "لِأَدرَبَ مِنهُ بِالطِّعانِ وَأَحذَقِ" },
    { "n": 26, "sadr": "وَكاتَبَ مِن أَرضٍ بَعيدٍ مَرامُها", "ajuz": "قَريبٍ عَلى خَيلٍ حَوالَيكَ سُبَّقِ" },
    { "n": 27, "sadr": "وَقَد سارَ في مَسراكَ مِنها رَسولُهُ", "ajuz": "فَما سارَ إِلّا فَوقَ هامٍ مُفَلَّقِ" },
    { "n": 28, "sadr": "فَلَمّا دَنا أَخفى عَلَيهِ مَكانَهُ", "ajuz": "شُعاعُ الحَديدِ البارِقِ المُتَأَلِّقِ" },
    { "n": 29, "sadr": "وَأَقبَلَ يَمشي في البِساطِ فَما دَرى", "ajuz": "إِلى البَحرِ يَمشي أَم إِلى البَدرِ يَرتَقي" },
    { "n": 30, "sadr": "وَلَم يَثنِكَ الأَعداءُ عَن مُهَجاتِهِم", "ajuz": "بِمِثلِ خُضوعٍ في كَلامٍ مُنَمَّقِ" },
    { "n": 31, "sadr": "وَكُنتَ إِذا كاتَبتَهُ قَبلَ هَذِهِ", "ajuz": "كَتَبتَ إِلَيهِ في قَذالِ الدُّمُستُقِ" },
    { "n": 32, "sadr": "فَإِن تُعطِهِ مِنكَ الأَمانَ فَسائِلٌ", "ajuz": "وَإِن تُعطِهِ حَدَّ الحُسامِ فَأَخلِقِ" },
    { "n": 33, "sadr": "وَهَل تَرَكَ البيضُ الصَّوارِمُ مِنهُمُ", "ajuz": "أَسيراً لِفادٍ أَو رَقيقاً لِمُعتِقِ" },
    { "n": 34, "sadr": "لَقَد وَرَدوا وِردَ القَطا شَفَراتِها", "ajuz": "وَمَرّوا عَلَيها زَردَقاً بَعدَ زَردَقِ" },
    { "n": 35, "sadr": "بَلَغتُ بِسَيفِ الدَّولَةِ النّورِ رُتبَةً", "ajuz": "أَثَرتُ بِها ما بَينَ غَربٍ وَمَشرِقِ" },
    { "n": 36, "sadr": "إِذا شاءَ أَن يَلهو بِلِحيَةِ أَحمَقٍ", "ajuz": "أَراهُ غُباري ثُمَّ قالَ لَهُ اِلحَقِ" },
    { "n": 37, "sadr": "وَما كَمَدُ الحُسّادِ شَيئاً قَصَدتُهُ", "ajuz": "وَلَكِنَّهُ مَن يَزحَمِ البَحرَ يَغرَقِ" },
    { "n": 38, "sadr": "وَيَمتَحِنُ النّاسَ الأَميرُ بِرَأيِهِ", "ajuz": "وَيُغضي عَلى عِلمٍ بِكُلِّ مُمَخرِقِ" },
    { "n": 39, "sadr": "وَإِطراقُ طَرفِ العَينِ لَيسَ بِنافِعٍ", "ajuz": "إِذا كانَ طَرفُ القَلبِ لَيسَ بِمُطرِقِ" },
    { "n": 40, "sadr": "فَيا أَيُّها المَطلوبُ جاوِرهُ تَمتَنِع", "ajuz": "وَيا أَيُّها المَحرومُ يَمِّمهُ تُرزَقِ" },
    { "n": 41, "sadr": "وَيا أَجبَنَ الفُرسانِ صاحِبهُ تَجتَرِئ", "ajuz": "وَيا أَشجَعَ الشُّجعانِ فارِقهُ تَفرَقِ" },
    { "n": 42, "sadr": "إِذا سَعَتِ الأَعداءُ في كَيدِ مَجدِهِ", "ajuz": "سَعى جَدُّهُ في كَيدِهِم سَعيَ مُحنَقِ" },
    { "n": 43, "sadr": "وَما يَنصُرُ الفَضلُ المُبينُ عَلى العِدا", "ajuz": "إِذا لَم يَكُن فَضلَ السَّعيدِ المُوَفَّقِ" }
  ]
}
