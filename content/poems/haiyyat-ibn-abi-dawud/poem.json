{
  "id": "haiyyat-ibn-abi-dawud",
  "poet": "ibn-abi-dawud",
  "title": "حائِيَّةُ اِبنِ أَبي داوُدَ",
  "meter": "tawil",
  "rawiy": "ح",
  "abyat_in_full": 33,
  "added": "2026-11-19",
  "abyat": [
    {
      "n": 1,
      "sadr": "تَمَسَّك بِحَبلِ اللَّهِ وَاتَّبِعِ الهُدى",
      "ajuz": "وَلا تَكُ بِدعِيّاً لَعَلَّكَ تُفلِحُ"
    },
    {
      "n": 2,
      "sadr": "وَدِن بِكِتابِ اللَّهِ وَالسُّنَنِ الَّتي",
      "ajuz": "أَتَت عَن رَسولِ اللَّهِ تَنجو وَتَربَحُ"
    },
    {
      "n": 3,
      "sadr": "وَقُل غَيرُ مَخلوقٍ كَلامُ مَليكِنا",
      "ajuz": "بِذَلِكَ دانَ الأَتقِياءُ وَأَفصَحوا"
    },
    {
      "n": 4,
      "sadr": "وَلا تَكُ في القُرآنِ بِالوَقفِ قائِلاً",
      "ajuz": "كَما قالَ أَتباعٌ لِجَهمٍ وَأَسجَحوا"
    },
    {
      "n": 5,
      "sadr": "وَلا تَقُلِ القُرآنُ خَلقٌ قَرَأتُهُ",
      "ajuz": "فَإِنَّ كَلامَ اللَّهِ بِاللَّفظِ يوضَحُ"
    },
    {
      "n": 6,
      "sadr": "وَقُل يَتَجَلّى اللَّهُ لِلخَلقِ جَهرَةً",
      "ajuz": "كَما البَدرُ لا يَخفى وَرَبُّكَ أَوضَحُ"
    },
    {
      "n": 7,
      "sadr": "وَلَيسَ بِمَولودٍ وَلَيسَ بِوالِدٍ",
      "ajuz": "وَلَيسَ لَهُ شِبهٌ تَعالى المُسَبَّحُ"
    },
    {
      "n": 8,
      "sadr": "وَقَد يُنكِرُ الجَهمِيُّ هَذا وَعِندَنا",
      "ajuz": "بِمِصداقِ ما قُلنا حَديثٌ مُصَرَّحُ"
    },
    {
      "n": 9,
      "sadr": "رَواهُ جَريرٌ عَن مَقالِ مُحَمَّدٍ",
      "ajuz": "فَقُل مِثلَ ما قَد قالَ في ذاكَ تَنجَحُ"
    },
    {
      "n": 10,
      "sadr": "وَقَد يُنكِرُ الجَهمِيُّ أَيضاً يَمينَهُ",
      "ajuz": "وَكِلتا يَدَيهِ بِالفَواضِلِ تَنفَحُ"
    },
    {
      "n": 11,
      "sadr": "وَقُل يَنزِلُ الجَبّارُ في كُلِّ لَيلَةٍ",
      "ajuz": "بِلا كَيفَ جَلَّ الواحِدُ المُتَمَدِّحُ"
    },
    {
      "n": 12,
      "sadr": "إِلى طَبَقِ الدُّنيا يَمُنُّ بِفَضلِهِ",
      "ajuz": "فَتُفرَجُ أَبوابُ السَّماءِ وَتُفتَحُ"
    },
    {
      "n": 13,
      "sadr": "يَقولُ أَلا مُستَغفِرٌ يَلقَ غافِراً",
      "ajuz": "وَمُستَمنِحٌ خَيراً وَرِزقاً فَيُمنَحُ"
    },
    {
      "n": 14,
      "sadr": "رَوى ذاكَ قَومٌ لا يُرَدُّ حَديثُهُم",
      "ajuz": "أَلا خابَ قَومٌ كَذَّبوهُم وَقُبِّحوا"
    },
    {
      "n": 15,
      "sadr": "وَقُل إِنَّ خَيرَ النّاسِ بَعدَ مُحَمَّدٍ",
      "ajuz": "وَزيراهُ قِدماً ثُمَّ عُثمانُ الأَرجَحُ"
    },
    {
      "n": 16,
      "sadr": "وَرابِعُهُم خَيرُ البَرِيَّةِ بَعدَهُم",
      "ajuz": "عَلِيٌّ حَليفُ الخَيرِ بِالخَيرِ مُنجِحُ"
    },
    {
      "n": 17,
      "sadr": "وَإِنَّهُمُ لَلرَّهطُ لا رَيبَ فيهِمُ",
      "ajuz": "عَلى نُجُبِ الفِردَوسِ بِالنّورِ تَسرَحُ"
    },
    {
      "n": 18,
      "sadr": "سَعيدٌ وَسَعدٌ وَابنُ عَوفٍ وَطَلحَةٌ",
      "ajuz": "وَعامِرُ فِهرٍ وَالزُّبَيرُ المُمَدَّحُ"
    },
    {
      "n": 19,
      "sadr": "وَقُل خَيرَ قَولٍ في الصَّحابَةِ كُلِّهِم",
      "ajuz": "وَلا تَكُ طَعّاناً تَعيبُ وَتَجرَحُ"
    },
    {
      "n": 20,
      "sadr": "فَقَد نَطَقَ الوَحيُ المُبينُ بِفَضلِهِم",
      "ajuz": "وَفي الفَتحِ آيٌ لِلصَّحابَةِ تَمدَحُ"
    },
    {
      "n": 21,
      "sadr": "وَبِالقَدَرِ المَقدورِ أَيقِن فَإِنَّهُ",
      "ajuz": "دِعامَةُ عَقدِ الدّينِ وَالدّينُ أَفيَحُ"
    },
    {
      "n": 22,
      "sadr": "وَلا تُنكِرَن جَهلاً نَكيراً وَمُنكَراً",
      "ajuz": "وَلا الحَوضَ وَالميزانَ إِنَّكَ تُنصَحُ"
    },
    {
      "n": 23,
      "sadr": "وَقُل يُخرِجُ اللَّهُ العَظيمُ بِفَضلِهِ",
      "ajuz": "مِنَ النّارِ أَجساداً مِنَ الفَحمِ تُطرَحُ"
    },
    {
      "n": 24,
      "sadr": "عَلى النَّهرِ في الفِردَوسِ تَحيا بِمائِهِ",
      "ajuz": "كَحِبِّ حَميلِ السَّيلِ إِذ جاءَ يَطفَحُ"
    },
    {
      "n": 25,
      "sadr": "وَإِنَّ رَسولَ اللَّهِ لِلخَلقِ شافِعٌ",
      "ajuz": "وَقُل في عَذابِ القَبرِ حَقٌّ مُوَضَّحُ"
    },
    {
      "n": 26,
      "sadr": "وَلا تُكفِرَن أَهلَ الصَّلاةِ وَإِن عَصَوا",
      "ajuz": "فَكُلُّهُمُ يَعصي وَذو العَرشِ يَصفَحُ"
    },
    {
      "n": 27,
      "sadr": "وَلا تَعتَقِد رَأيَ الخَوارِجِ إِنَّهُ",
      "ajuz": "مَقالٌ لِمَن يَهواهُ يُردي وَيَفضَحُ"
    },
    {
      "n": 28,
      "sadr": "وَلا تَكُ مُرجِيّاً لَعوباً بِدينِهِ",
      "ajuz": "أَلا إِنَّما المُرجِيُّ بِالدّينِ يَمزَحُ"
    },
    {
      "n": 29,
      "sadr": "وَقُل إِنَّما الإيمانُ قَولٌ وَنِيَّةٌ",
      "ajuz": "وَفِعلٌ عَلى قَولِ النَّبِيِّ مُصَرَّحُ"
    },
    {
      "n": 30,
      "sadr": "وَيَنقُصُ طَوراً بِالمَعاصي وَتارَةً",
      "ajuz": "بِطاعَتِهِ يَنمى وَفي الوَزنِ يَرجَحُ"
    },
    {
      "n": 31,
      "sadr": "وَدَع عَنكَ آراءَ الرِّجالِ وَقَولَهُم",
      "ajuz": "فَقَولُ رَسولِ اللَّهِ أَزكى وَأَشرَحُ"
    },
    {
      "n": 32,
      "sadr": "وَلا تَكُ مِن قَومٍ تَلَهَّوا بِدينِهِم",
      "ajuz": "فَتَطعَنَ في أَهلِ الحَديثِ وَتَقدَحُ"
    },
    {
      "n": 33,
      "sadr": "إِذا ما اِعتَقَدتَ الدَّهرَ يا صاحِ هَذِهِ",
      "ajuz": "فَأَنتَ عَلى خَيرٍ تَبيتُ وَتُصبِحُ"
    }
  ]
}
