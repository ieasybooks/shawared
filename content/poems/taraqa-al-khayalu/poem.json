{
  "id": "taraqa-al-khayalu",
  "poet": "al-harith-ibn-hilliza",
  "title": "طَرَقَ الخَيالُ وَلا كَلَيلَةِ مُدلِجِ",
  "meter": "kamil",
  "rawiy": "ج",
  "abyat_in_full": 10,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "طَرَقَ الخَيالُ وَلا كَلَيلَةِ مُدلِجِ",
      "ajuz": "سَدِكاً بِأَرحُلِنا وَلَم يَتَعَرَّجِ"
    },
    {
      "n": 2,
      "sadr": "أَنّى اِهتَدَيتِ وَكُنتِ غَيرَ رَجيلَةٍ",
      "ajuz": "وَالقَومُ قَد قَطَعوا مِتانَ السَّجسَجِ"
    },
    {
      "n": 3,
      "sadr": "وَالقَومُ قَد آنَوا وَكَلَّ مَطِيُّهُم",
      "ajuz": "إِلّا مُواشِكَةَ النَّجا بِالهَودَجِ"
    },
    {
      "n": 4,
      "sadr": "وَمُدامَةٍ قَرَّعتُها بِمُدامَةٍ",
      "ajuz": "وَظِباءِ مَحنِيَةٍ ذَعَرتُ بِسَمحَجِ"
    },
    {
      "n": 5,
      "sadr": "فَكَأَنَّهُنَّ لَآلِئٌ وَكَأَنَّهُ",
      "ajuz": "صَقرٌ يَلوذُ حَمامُهُ بِالعَوسَجِ"
    },
    {
      "n": 6,
      "sadr": "صَقرٌ يَصيدُ بِظُفرِهِ وَجَناحِهِ",
      "ajuz": "فَإِذا أَصابَ حَمامَةً لَم تَدرُجِ"
    },
    {
      "n": 7,
      "sadr": "وَلَئِن سَأَلتِ إِذا الكَتيبَةُ أَجحَمَت",
      "ajuz": "وَتَبَيَّنَت رِعَةُ الجَبانِ الأَهوَجِ"
    },
    {
      "n": 8,
      "sadr": "وَحَسِبتِ وَقعَ سُيوفِنا بِرُؤوسِهِم",
      "ajuz": "وَقعَ السَّحابِ عَلى الطِّرافِ المُشرَجِ"
    },
    {
      "n": 9,
      "sadr": "وَإِذا اللِّقاحُ تَرَوَّحَت بِعَشِيَّةٍ",
      "ajuz": "رَتكَ النَّعامِ إِلى كَنيفِ العَرفَجِ"
    },
    {
      "n": 10,
      "sadr": "أَلفَيتِنا لِلضَّيفِ خَيرَ عِمارَةٍ",
      "ajuz": "إِن لَم يَكُن لَبَنٌ فَعَطفُ المُدمَجِ"
    }
  ]
}
