{
  "id": "mada-li-sabilihi-manun",
  "poet": "marwan-ibn-abi-hafsa",
  "title": "مَضى لِسَبيلِهِ مَعنٌ وَأَبقى",
  "meter": "wafir",
  "rawiy": "ل",
  "abyat_in_full": 54,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "مَضى لِسَبيلِهِ مَعنٌ وَأَبقى",
      "ajuz": "مَكارِمَ لَن تَبيدَ وَلَن تُنالا"
    },
    {
      "n": 2,
      "sadr": "كَأَنَّ الشَّمسَ يَومَ أُصيبَ مَعنٌ",
      "ajuz": "مِنَ الإِظلامِ مُلبَسَةٌ جِلالا"
    },
    {
      "n": 3,
      "sadr": "هُوَ الجَبَلُ الَّذي كانَت نِزارٌ",
      "ajuz": "تَهُدُّ مِنَ العَدُوِّ بِهِ الجِبالا"
    },
    {
      "n": 4,
      "sadr": "وَعُطِّلَتِ الثُّغورُ لِفَقدِ مَعنٍ",
      "ajuz": "وَقَد يُروي بِها الأَسَلَ النِّهالا"
    },
    {
      "n": 5,
      "sadr": "وَأَظلَمَتِ العِراقُ وَأَورَثَتها",
      "ajuz": "مُصيبَتُهُ المُجَلِّلَةُ اِختِلالا"
    },
    {
      "n": 6,
      "sadr": "وَظَلَّ الشّامُ يَرجِفُ جانِباهُ",
      "ajuz": "لِرُكنِ العِزِّ حينَ وَهى فَمالا"
    },
    {
      "n": 7,
      "sadr": "وَكادَت مِن تِهامَةَ كُلُّ أَرضٍ",
      "ajuz": "وَمِن نَجدٍ تَزولُ غَداةَ زالا"
    },
    {
      "n": 8,
      "sadr": "فَإِن يَعلُ البِلادَ لَهُ خُشوعٌ",
      "ajuz": "فَقَد كانَت تَطولُ بِهِ اِختِيالا"
    },
    {
      "n": 9,
      "sadr": "أَصابَ المَوتُ يَومَ أَصابَ مَعناً",
      "ajuz": "مِنَ الأَحياءِ أَكرَمَهُم فَعالا"
    },
    {
      "n": 10,
      "sadr": "وَكانَ النّاسُ كُلُّهُمُ لِمَعنٍ",
      "ajuz": "إِلى أَن زارَ حُفرَتَهُ عِيالا"
    },
    {
      "n": 11,
      "sadr": "وَلَم يَكُ طالِبٌ لِلعُرفِ يَنوي",
      "ajuz": "إِلى غَيرِ اِبنِ زائِدَةَ اِرتِحالا"
    },
    {
      "n": 12,
      "sadr": "مَضى مَن كانَ يَحمِلُ كُلَّ ثِقلٍ",
      "ajuz": "وَيَسبِقُ فَضلُ نائِلِهِ السُّؤالا"
    },
    {
      "n": 13,
      "sadr": "وَما عَمَدَ الوُفودُ لِمِثلِ مَعنٍ",
      "ajuz": "وَلا حَطّوا بِساحَتِهِ الرِّحالا"
    },
    {
      "n": 14,
      "sadr": "وَلا بَلَغَت أَكُفُّ ذَوي العَطايا",
      "ajuz": "يَميناً مِن يَديهِ وَلا شِمالا"
    },
    {
      "n": 15,
      "sadr": "وَما كانَت تَجِفُّ لَهُ حِياضٌ",
      "ajuz": "مِنَ المَعروفِ مُترَعَةٌ سِجالا"
    },
    {
      "n": 16,
      "sadr": "لِأَبيَضَ لا يَعُدُّ المالَ حَتّى",
      "ajuz": "يَعُمَّ بِهِ بُغاةَ الخَيرِ مالا"
    },
    {
      "n": 17,
      "sadr": "فَلَيتَ الشّامِتينَ بِهِ فَدَوهُ",
      "ajuz": "وَلَيتَ العُمرَ مُدَّ لَهُ فَطالا"
    },
    {
      "n": 18,
      "sadr": "وَلَم يَكُ كَنزُهُ ذَهَباً وَلكِن",
      "ajuz": "سُيوفَ الهِندِ وَالحَلَقَ المُذالا"
    },
    {
      "n": 19,
      "sadr": "وَذابِلَةً مِنَ الخَطِّيِّ سُمراً",
      "ajuz": "تَرى فيهِنَّ ليناً وَاِعتِدالا"
    },
    {
      "n": 20,
      "sadr": "وَذُخراً مِن مَحامِدَ باقِياتٍ",
      "ajuz": "وَفَضلَ تُقىً بِهِ التَّفضيلَ نالا"
    },
    {
      "n": 21,
      "sadr": "لَئِن أَمسَت رُوَيداً قَد أُذيلَت",
      "ajuz": "جِياداً كانَ يَكرَهُ أَن تُذالا"
    },
    {
      "n": 22,
      "sadr": "لَقَد كانَت تُصابُ بِهِ وَيَسمو",
      "ajuz": "بِها عُقَباً وَيُرجِعُها حَبالى"
    },
    {
      "n": 23,
      "sadr": "وَقَد حَوَتِ النِّهابَ فَأَحرَزَتهُ",
      "ajuz": "وَقَد غَشِيَت مِنَ المَوتِ الطِّلالا"
    },
    {
      "n": 24,
      "sadr": "مَضى لِسَبيلِهِ مَن كُنتَ تَرجو",
      "ajuz": "بِهِ عَثَراتُ دَهرِكَ أَن تُقالا"
    },
    {
      "n": 25,
      "sadr": "فَلَستَ بِمالِكٍ عَبَراتِ عَينٍ",
      "ajuz": "أَبَت بِدُموعِها إِلّا اِنهِمالا"
    },
    {
      "n": 26,
      "sadr": "وَفي الأَحشاءِ مِنكَ غَليلُ حُزنٍ",
      "ajuz": "كَحَرِّ النّارِ يَشتَعِلُ اِشتِعالا"
    },
    {
      "n": 27,
      "sadr": "كَأَنَّ اللَّيلَ واصَلَ بَعدَ مَعنٍ",
      "ajuz": "لَياليَ قَد قُرِنَّ بِهِ فَطالا"
    },
    {
      "n": 28,
      "sadr": "لَقَد أَورَثتَني وَبَنيَّ هَمّاً",
      "ajuz": "وَأَحزاناً نُطيلُ بِها اِشتِغالا"
    },
    {
      "n": 29,
      "sadr": "وَقائِلَةٍ رَأَت جِسمي وَلَوني",
      "ajuz": "مَعاً عَن عَهدِها قُلِبا فَحالا"
    },
    {
      "n": 30,
      "sadr": "رَأَت رَجُلاً بَراهُ الحُزنُ حَتّى",
      "ajuz": "أَضَرَّ بِهِ وَأَورَثَهُ خَبالا"
    },
    {
      "n": 31,
      "sadr": "أَرى مَروانَ عادَ كَذي نُحولٍ",
      "ajuz": "مِنَ الهِندِيِّ قَد فَقَدَ الصِّقالا"
    },
    {
      "n": 32,
      "sadr": "فَقُلتُ لَها الَّذي أَنكَرتِ مِنّي",
      "ajuz": "لِفَجعِ مُصيبَةٍ أَنكى وَعالا"
    },
    {
      "n": 33,
      "sadr": "وَأَيّامُ المَنونِ لَها صُروفٌ",
      "ajuz": "تَقَلَّبُ بِالفَتى حالاً فَحالا"
    },
    {
      "n": 34,
      "sadr": "يَرانا النّاسُ بَعدَكَ فَلَّ دَهرٍ",
      "ajuz": "أَبى لِجُدودِنا إِلّا اِغتِيالا"
    },
    {
      "n": 35,
      "sadr": "فَنَحنُ كَأَسهُمٍ لَم يُبقِ ريشاً",
      "ajuz": "لَها رَيبُ الزَّمانِ وَلا نِصالا"
    },
    {
      "n": 36,
      "sadr": "وَقَد كُنّا بِحَوضِكَ ذاكَ نَروى",
      "ajuz": "وَلا نَرِدُ المُصَرَّدَةَ السِّحالا"
    },
    {
      "n": 37,
      "sadr": "فَلَهفُ أَبي عَلَيكَ إِذا العَطايا",
      "ajuz": "جُعِلنَ مُنىً كَواذِبَ وَاعتِلالا"
    },
    {
      "n": 38,
      "sadr": "وَلَهفُ أَبي عَلَيكَ إِذا الأَسارى",
      "ajuz": "شَكَوا حَلَقاً بِأَسوُقِهِم ثِقالا"
    },
    {
      "n": 39,
      "sadr": "وَلَهفُ أَبي عَلَيكَ إِذا اليَتامى",
      "ajuz": "غَدَوا شُعثاً كَأَنَّ بِهِم سُلالا"
    },
    {
      "n": 40,
      "sadr": "وَلَهفُ أَبي عَلَيكَ إِذا المَواشي",
      "ajuz": "قَرَت جَدَباً تُماتُ بِهِ هُزالا"
    },
    {
      "n": 41,
      "sadr": "وَلَهفُ أَبي عَلَيكَ لِكُلِّ هَيجا",
      "ajuz": "لَها تُلقي حَوامِلُها السِّخالا"
    },
    {
      "n": 42,
      "sadr": "وَلَهفُ أَبي عَلَيكَ إِذا القَوافي",
      "ajuz": "لِمُمتَدَحٍ بِها ذَهَبَت ضَلالا"
    },
    {
      "n": 43,
      "sadr": "وَلَهفُ أَبي عَلَيكَ لِكُلِّ أَمرٍ",
      "ajuz": "يَقولُ لَهُ النَّجِيُّ أَلا اِحتِيالا"
    },
    {
      "n": 44,
      "sadr": "أَقَمنا بِاليَمامَةِ إِذ يَئِسنا",
      "ajuz": "مُقاماً لا نُريدُ لَهُ زِيالا"
    },
    {
      "n": 45,
      "sadr": "وَقُلنا أَينَ نَرحَلُ بَعدَ مَعنٍ",
      "ajuz": "وَقَد ذَهَبَ النَّوالُ فَلا نَوالا"
    },
    {
      "n": 46,
      "sadr": "فَإِن تَذهَب فَرُبَّ رِعالِ خَيلٍ",
      "ajuz": "عَوابِسَ قَد كَفَفتَ بِها رِعالا"
    },
    {
      "n": 47,
      "sadr": "وَقَومٍ قَد جُعِلتَ لَهُم رَبيعاً",
      "ajuz": "وَقَومٍ قَد جُعِلتَ لَهُم نَكالا"
    },
    {
      "n": 48,
      "sadr": "فَما شَهِدَ الوَقائِعَ مِنكَ أَمضى",
      "ajuz": "وَأَكرَمُ مَحتِداً وَأَشَدُّ بالا"
    },
    {
      "n": 49,
      "sadr": "سَيَذكُرُكَ الخَليفَةُ غَيرَ قالٍ",
      "ajuz": "إِذا هُوَ في الأُمورِ بَلا الرِّجالا"
    },
    {
      "n": 50,
      "sadr": "وَلا يَنسى وَقائِعَكَ اللَّواتي",
      "ajuz": "عَلى أَعدائِهِ جُعِلَت وَبالا"
    },
    {
      "n": 51,
      "sadr": "وَمُعتَرَكاً شَهِدتَ بِهِ حِفاظاً",
      "ajuz": "وَقَد كَرِهَت فَوارِسُهُ النِّزالا"
    },
    {
      "n": 52,
      "sadr": "حَباكَ أَخو أُمَيَّةَ بِالمَراثي",
      "ajuz": "مَعَ المِدَحِ اللَّواتي كانَ قالا"
    },
    {
      "n": 53,
      "sadr": "أَقامَ وَكانَ نَحوَكَ كُلَّ عامٍ",
      "ajuz": "يُطيلُ بِواسِطِ الرَّحلِ اِعتِقالا"
    },
    {
      "n": 54,
      "sadr": "وَأَلقى رَحلَهُ أَسَفاً وَآلى",
      "ajuz": "يَميناً لا يَشُدُّ لَها حِبالا"
    }
  ]
}
