{
  "id": "idha-ghamarta",
  "poet": "al-mutanabbi",
  "title": "إِذا غامَرتَ في شَرَفٍ مَرومِ",
  "meter": "wafir",
  "themes": ["hikma", "hamasa"],
  "rawiy": "م",
  "abyat_in_full": 9,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1, "sadr": "إِذا غامَرتَ في شَرَفٍ مَرومِ", "ajuz": "فَلا تَقنَع بِما دونَ النُّجومِ" },
    { "n": 2, "sadr": "فَطَعمُ المَوتِ في أَمرٍ صَغيرٍ", "ajuz": "كَطَعمِ المَوتِ في أَمرٍ عَظيمِ" },
    { "n": 3, "sadr": "سَتَبكي شَجوَها فَرَسي وَمُهري", "ajuz": "صَفائِحُ دَمعُها ماءُ الجُسومِ" },
    { "n": 4, "sadr": "قَرَبنَ النّارَ ثُمَّ نَشَأنَ فيها", "ajuz": "كَما نَشَأَ العَذارى في النَّعيمِ" },
    { "n": 5, "sadr": "وَفارَقنَ الصَّياقِلَ مُخلَصاتٍ", "ajuz": "وَأَيديها كَثيراتُ الكُلومِ" },
    { "n": 6, "sadr": "يَرى الجُبَناءُ أَنَّ العَجزَ عَقلٌ", "ajuz": "وَتِلكَ خَديعَةُ الطَّبعِ اللَّئيمِ" },
    { "n": 7, "sadr": "وَكُلُّ شَجاعَةٍ في المَرءِ تُغني", "ajuz": "وَلا مِثلَ الشَّجاعَةِ في الحَكيمِ" },
    { "n": 8, "sadr": "وَكَم مِن عائِبٍ قَولاً صَحيحاً", "ajuz": "وَآفَتُهُ مِنَ الفَهمِ السَّقيمِ" },
    { "n": 9, "sadr": "وَلَكِن تَأخُذُ الآذانُ مِنهُ", "ajuz": "عَلى قَدرِ القَرائِحِ وَالعُلومِ" }
  ]
}
