{
  "id": "nubbitu-anna-al-nara",
  "poet": "al-muhalhil",
  "title": "نُبِّئتُ أَنَّ النّارَ بَعدَكَ أوقِدَت",
  "meter": "kamil",
  "rawiy": "س",
  "abyat_in_full": 10,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "نُبِّئتُ أَنَّ النّارَ بَعدَكَ أوقِدَت",
      "ajuz": "وَاستَبَّ بَعدَكَ يا كُلَيبُ المَجلِسُ"
    },
    {
      "n": 2,
      "sadr": "وَتَنازَعوا في كُلِّ أَمرِ عَظيمَةٍ",
      "ajuz": "لَو كُنتَ شاهِدَهُم إِذاً لَم يَنبِسوا"
    },
    {
      "n": 3,
      "sadr": "اِبنَي رَبيعَةَ مَن يَقومُ مَقامَهُ",
      "ajuz": "أَم مَن يَرُدُّ عَلى الضَّريكِ وَيَحبِسُ"
    },
    {
      "n": 4,
      "sadr": "وَتَلَهَّفَ الصُّعلوكُ بَعدَكَ أُمَّهُ",
      "ajuz": "لَمّا اِستَعالَ وَقالَ أَنّى المَجلِسُ"
    },
    {
      "n": 5,
      "sadr": "وَإِذا تَشاءُ رَأَيتَ وَجهاً ناعِماً",
      "ajuz": "وَذِراعَ باكِيَةٍ عَلَيها بُرنُسُ"
    },
    {
      "n": 6,
      "sadr": "جَزَعاً عَلَيكَ وَلَستُ لائِمَ حُرَّةٍ",
      "ajuz": "تَبكي عَلَيكَ بِعَبرَةٍ وَتَنَفَّسُ"
    },
    {
      "n": 7,
      "sadr": "وَلَقَد شَفَيتُ النَّفسَ مِن سَرَواتِهِم",
      "ajuz": "وَالخَيلُ تَعثُرُ في الدِّماءِ وَتَعبِسُ"
    },
    {
      "n": 8,
      "sadr": "وَتَرَكتُ جَسّاساً يَنوءُ بِصَعدَةٍ",
      "ajuz": "سَمراءَ يَقدُمُها سِنانٌ مِدعَسُ"
    },
    {
      "n": 9,
      "sadr": "أَكُلَيبُ لَو حُدِّثتَ كَيفَ عُقوبَتي",
      "ajuz": "عَلِمَت عِظامُكَ إِذ عَلاها المَرمَسُ"
    },
    {
      "n": 10,
      "sadr": "أَن لَستُ زيراً حينَ شُبَّ وَقودُها",
      "ajuz": "في الحَربِ يَومَ عِنانُها لا يَسلُسُ"
    }
  ]
}
