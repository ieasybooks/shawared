{
  "id": "muna-al-nafsi",
  "poet": "al-buhturi",
  "title": "مُنى النَّفسِ في أَسماءَ لَو تَستَطيعُها",
  "meter": "tawil",
  "rawiy": "ع",
  "abyat_in_full": 45,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "مُنى النَّفسِ في أَسماءَ لَو تَستَطيعُها",
      "ajuz": "بِها وَجدُها مِن غادَةٍ وَوَلوعُها"
    },
    {
      "n": 2,
      "sadr": "وَقَد راعَني مِنها الصُّدودُ وَإِنَّما",
      "ajuz": "تَصُدُّ لِشَيبٍ في عِذاري يَروعُها"
    },
    {
      "n": 3,
      "sadr": "حَمَلتُ هَواها يَومَ مُنعَرَجِ اللِّوى",
      "ajuz": "عَلى كَبِدٍ قَد أَوهَنَتها صُدوعُها"
    },
    {
      "n": 4,
      "sadr": "وَكُنتُ تَبيعَ الغانِياتِ وَلَم يَزَل",
      "ajuz": "يَذُمُّ وَفاءَ الغانِياتِ تَبيعُها"
    },
    {
      "n": 5,
      "sadr": "وَحَسناءَ لَم تُحسِن صَنيعاً وَرُبَّما",
      "ajuz": "صَبَوتُ إِلى حَسناءَ سَيِّئٌ صَنيعُها"
    },
    {
      "n": 6,
      "sadr": "عَجِبتُ لَها تُبدي القِلى وَأَوَدُّها",
      "ajuz": "وَلِلنَّفسِ تَعصيني هَوىً وَأُطيعُها"
    },
    {
      "n": 7,
      "sadr": "تَشَكّى الوَجى وَاللَّيلُ مُلتَبِسُ الدُّجى",
      "ajuz": "غُرَيرِيَّةُ الأَنسابِ مَرتٌ بَقيعُها"
    },
    {
      "n": 8,
      "sadr": "وَلَستُ بِزُوّارِ المُلوكِ عَلى الوَجى",
      "ajuz": "لَئِن لَم تَجُل أَغراضُها وَنُسوعُها"
    },
    {
      "n": 9,
      "sadr": "تَؤُمُّ القُصورَ البيضَ مِن أَرضِ بابِلٍ",
      "ajuz": "بِحَيثُ تَلاقى غَردُها وَبَديعُها"
    },
    {
      "n": 10,
      "sadr": "إِذا أَشرَفَ البُرجُ المُطِلُّ رَمَينَهُ",
      "ajuz": "بِأَبصارِ خوصٍ قَد أَرَثَّت قُطوعُها"
    },
    {
      "n": 11,
      "sadr": "يُضيءُ لَها قَصدَ السُّرى لَمَعانُهُ",
      "ajuz": "إِذا اِسوَدَّ مِن ظَلماءِ لَيلٍ هَزيعُها"
    },
    {
      "n": 12,
      "sadr": "تَزورُ أَميرَ المُؤمِنينَ وَدونَهُ",
      "ajuz": "سُهوبُ البِلادِ رَحبُها وَوَسيعُها"
    },
    {
      "n": 13,
      "sadr": "إِذا ما هَبَطنا بَلدَةً كَرَّ أَهلُها",
      "ajuz": "أَحاديثَ إِحسانٍ نَداهُ يُذيعُها"
    },
    {
      "n": 14,
      "sadr": "حَمى حَوزَةَ الإِسلامِ فَاِرتَدَعَ العِدى",
      "ajuz": "وَقَد عَلِموا أَلّا يُرامَ مَنيعُها"
    },
    {
      "n": 15,
      "sadr": "وَلَمّا رَعى سِربَ الرَّعِيَّةِ ذادَها",
      "ajuz": "عَنِ الجَدبِ مُخضَرُّ البِلادِ مَريعُها"
    },
    {
      "n": 16,
      "sadr": "عَلِمتُ يَقيناً مُذ تَوَكَّلَ جَعفَرٌ",
      "ajuz": "عَلى اللَّهِ فيها أَنَّهُ لا يُضيعُها"
    },
    {
      "n": 17,
      "sadr": "جَلا الشَّكَّ عَن أَبصارِنا بِخِلافَةٍ",
      "ajuz": "نَفى الظُّلمَ عَنّا وَالظَّلامَ صَديعُها"
    },
    {
      "n": 18,
      "sadr": "هِيَ الشَّمسُ أَبدى رَونَقَ الحَقِّ نورُها",
      "ajuz": "وَأَشرَقَ في سِرِّ القُلوبِ طُلوعُها"
    },
    {
      "n": 19,
      "sadr": "أَسيتُ لِأَخوالي رَبيعَةَ إِذ عَفَت",
      "ajuz": "مَصانِعُها مِنها وَأَقوَت رُبوعُها"
    },
    {
      "n": 20,
      "sadr": "بِكُرهِيَ أَن باتَت خَلاءً دِيارُها",
      "ajuz": "وَوَحشاً مَغانيها وَشَتّى جَميعُها"
    },
    {
      "n": 21,
      "sadr": "وَأَمسَت تَساقى المَوتَ مِن بَعدِ ما غَدَت",
      "ajuz": "شُروباً تَساقى الرّاحَ رِفهاً شُروعُها"
    },
    {
      "n": 22,
      "sadr": "إِذا اِفتَرَقوا عَن وَقعَةٍ جَمَعَتهُمُ",
      "ajuz": "لِأُخرى دِماءٌ ما يُطَلُّ نَجيعُها"
    },
    {
      "n": 23,
      "sadr": "تَذُمُّ الفَتاةُ الرّودُ شيمَةَ بَعلِها",
      "ajuz": "إِذا باتَ دونَ الثَّأرِ وَهوَ ضَجيعُها"
    },
    {
      "n": 24,
      "sadr": "حَمِيَّةُ شَغبٍ جاهِلِيٍّ وَعِزَّةٌ",
      "ajuz": "كُلَيبِيَّةٌ أَعيا الرِّجالَ خُضوعُها"
    },
    {
      "n": 25,
      "sadr": "وَفُرسانُ هَيجاءَ تَجيشُ صُدورُها",
      "ajuz": "بِأَحقادِها حَتّى تَضيقَ دُروعُها"
    },
    {
      "n": 26,
      "sadr": "تُقَتِّلُ مِن وِترٍ أَعَزَّ نُفوسِها",
      "ajuz": "عَلَيها بِأَيدٍ ما تَكادُ تُطيعُها"
    },
    {
      "n": 27,
      "sadr": "إِذا اِحتَرَبَت يَوماً فَفاضَت دِماؤُها",
      "ajuz": "تَذَكَّرَتِ القُربى فَفاضَت دُموعُها"
    },
    {
      "n": 28,
      "sadr": "شَواجِرُ أَرماحٍ تُقَطِّعُ بَينَهُم",
      "ajuz": "شَواجِرَ أَرحامٍ مَلومٍ قَطوعُها"
    },
    {
      "n": 29,
      "sadr": "فَلَولا أَميرُ المُؤمِنينَ وَطَولُهُ",
      "ajuz": "لَعادَت جُيوبٌ وَالدِّماءُ رُدوعُها"
    },
    {
      "n": 30,
      "sadr": "وَلَاِصطُلِمَت جُرثومَةٌ تَغلِبِيَّةٌ",
      "ajuz": "بِها اِستُبقِيَت أَغصانُها وَفُروعُها"
    },
    {
      "n": 31,
      "sadr": "رَفَعتَ بِضَبعَي تَغلِبَ اِبنَةِ وائِلٍ",
      "ajuz": "وَقَد يَئِسَت أَن يَستَقِلَّ صَريعُها"
    },
    {
      "n": 32,
      "sadr": "فَكُنتَ أَمينَ اللَّهِ مَولى حَياتِها",
      "ajuz": "وَمَولاكَ فَتحٌ يَومَذاكَ شَفيعُها"
    },
    {
      "n": 33,
      "sadr": "لَعَمري لَقَد شَرَّفتَهُ بِصَنيعَةٍ",
      "ajuz": "إِلَيهِم وَنُعمى ظَلَّ فيهِم يُشيعُها"
    },
    {
      "n": 34,
      "sadr": "تَأَلَّفَهُم مِن بَعدِ ما شَرَّدَت بِهِم",
      "ajuz": "حَفائِظُ أَخلاقٍ بَطيءٍ رُجوعُها"
    },
    {
      "n": 35,
      "sadr": "فَأَبصَرَ غاويها المَحَجَّةَ فَاِهتَدى",
      "ajuz": "وَأَقصَرَ غاليها وَدانى شُسوعُها"
    },
    {
      "n": 36,
      "sadr": "وَأَمضى قَضاءً بَينَها فَتَحاجَزَت",
      "ajuz": "وَمَخفوضُها راضٍ بِهِ وَرَفيعُها"
    },
    {
      "n": 37,
      "sadr": "فَقَد رُكِزَت سُمرُ الرِّماحِ وَأُغمِدَت",
      "ajuz": "رِقاقُ الظُّبى مَجفُوُّها وَصَنيعُها"
    },
    {
      "n": 38,
      "sadr": "فَقَرَّت قُلوبٌ كانَ جَمّاً وَجيبُها",
      "ajuz": "وَنامَت عُيونٌ كانَ نَزراً هُجوعُها"
    },
    {
      "n": 39,
      "sadr": "أَتَتكَ وَقَد ثابَت إِلَيها حُلومُها",
      "ajuz": "وَباعَدَها عَمّا كَرِهتَ نُزوعُها"
    },
    {
      "n": 40,
      "sadr": "تُعيدُ وَتُبدي مِن ثَناءٍ كَأَنَّهُ",
      "ajuz": "سَبائِبُ رَوضِ الحَزنِ جادَ رَبيعُها"
    },
    {
      "n": 41,
      "sadr": "تَصُدُّ حَياءً أَن تَراكَ بِأَوجُهٍ",
      "ajuz": "أَتى الذَّنبَ عاصيها فَليمَ مُطيعُها"
    },
    {
      "n": 42,
      "sadr": "وَلا عُذرَ إِلّا أَنَّ حِلمَ حَليمِها",
      "ajuz": "تَسَفَّهَ في شَرٍّ جَناهُ خَليعُها"
    },
    {
      "n": 43,
      "sadr": "وَمُشفِقَةٍ تَخشى الحِمامَ عَلى اِبنِها",
      "ajuz": "لِأَوَّلِ هَيجاءٍ تَلاقى جُموعُها"
    },
    {
      "n": 44,
      "sadr": "رَبَطتَ بِصُلحِ القَومِ نافِرَ جَأشِها",
      "ajuz": "فَقَرَّت حَشاها وَاِطمَأَنَّت ضُلوعُها"
    },
    {
      "n": 45,
      "sadr": "بَقيتَ فَكَم أَبقَيتَ بِالعَفوِ مُحسِناً",
      "ajuz": "عَلى تَغلِبٍ حَتّى اِستَمَرَّ ظَليعُها"
    }
  ]
}
