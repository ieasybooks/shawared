{
  "id": "muallaqat-antara",
  "poet": "antara",
  "title": "مُعَلَّقَةُ عَنتَرَةَ",
  "meter": "kamil",
  "themes": ["fakhr", "ghazal", "hamasa"],
  "rawiy": "م",
  "abyat_in_full": 113,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1,  "sadr": "هَل غادَرَ الشُّعَراءُ مِن مُتَرَدَّمِ", "ajuz": "أَم هَل عَرَفتَ الدّارَ بَعدَ تَوَهُّمِ" },
    { "n": 2,  "sadr": "أَعياكَ رَسمُ الدّارِ لَم يَتَكَلَّمِ", "ajuz": "حَتّى تَكَلَّمَ كَالأَصَمِّ الأَعجَمِ" },
    { "n": 3,  "sadr": "وَلَقَد حَبَستُ بِها طَويلاً ناقَتي", "ajuz": "أَشكو إِلى سُفعٍ رَواكِدَ جُثَّمِ" },
    { "n": 4,  "sadr": "يا دارَ عَبلَةَ بِالجِواءِ تَكَلَّمي", "ajuz": "وَعِمي صَباحاً دارَ عَبلَةَ وَاسلَمي" },
    { "n": 5,  "sadr": "دارٌ لِآنِسَةٍ غَضيضٍ طَرفُها", "ajuz": "طَوعِ العِناقِ لَذيذَةِ المُتَبَسَّمِ" },
    { "n": 6,  "sadr": "فَوَقَفتُ فيها ناقَتي وَكَأَنَّها", "ajuz": "فَدَنٌ لِأَقضِيَ حاجَةَ المُتَلَوِّمِ" },
    { "n": 7,  "sadr": "وَتَحُلُّ عَبلَةُ بِالجِواءِ وَأَهلُنا", "ajuz": "بِالحَزنِ فَالصَّمّانِ فَالمُتَثَلَّمِ" },
    { "n": 8,  "sadr": "حُيّيتَ مِن طَلَلٍ تَقادَمَ عَهدُهُ", "ajuz": "أَقوى وَأَقفَرَ بَعدَ أُمِّ الهَيثَمِ" },
    { "n": 9,  "sadr": "حَلَّت بِأَرضِ الزّائِرينَ فَأَصبَحَت", "ajuz": "عَسِراً عَلَيَّ طِلابُكِ اِبنَةَ مَخرَمِ" },
    { "n": 10, "sadr": "عُلِّقتُها عَرَضاً وَأَقتُلُ قَومَها", "ajuz": "زَعماً لَعَمرُ أَبيكَ لَيسَ بِمَزعَمِ" },
    { "n": 11, "sadr": "وَلَقَد نَزَلتِ فَلا تَظُنّي غَيرَهُ", "ajuz": "مِنّي بِمَنزِلَةِ المُحَبِّ المُكرَمِ" },
    { "n": 12, "sadr": "كَيفَ المَزارُ وَقَد تَرَبَّعَ أَهلُها", "ajuz": "بِعُنَيزَتَينِ وَأَهلُنا بِالغَيلَمِ" },
    { "n": 13, "sadr": "إِن كُنتِ أَزمَعتِ الفِراقَ فَإِنَّما", "ajuz": "زُمَّت رِكابُكُمُ بِلَيلٍ مُظلِمِ" },
    { "n": 14, "sadr": "ما راعَني إِلّا حَمولَةُ أَهلِها", "ajuz": "وَسطَ الدِّيارِ تَسَفُّ حَبَّ الخِمخِمِ" },
    { "n": 15, "sadr": "فيها اِثنَتانِ وَأَربَعونَ حَلوبَةً", "ajuz": "سوداً كَخافِيَةِ الغُرابِ الأَسحَمِ" },
    { "n": 16, "sadr": "إِذ تَستَبيكَ بِذي غُروبٍ واضِحٍ", "ajuz": "عَذبٍ مُقَبَّلُهُ لَذيذِ المَطعَمِ" },
    { "n": 17, "sadr": "وَكَأَنَّما نَظَرَت بِعَينَي شادِنٍ", "ajuz": "رَشَأٍ مِنَ الغِزلانِ لَيسَ بِتَوأَمِ" },
    { "n": 18, "sadr": "وَكَأَنَّ فارَةَ تاجِرٍ بِقَسيمَةٍ", "ajuz": "سَبَقَت عَوارِضَها إِلَيكَ مِنَ الفَمِ" },
    { "n": 19, "sadr": "أَو رَوضَةً أُنُفاً تَضَمَّنَ نَبتَها", "ajuz": "غَيثٌ قَليلُ الدِّمنِ لَيسَ بِمَعلَمِ" },
    { "n": 20, "sadr": "أَو عاتِقاً مِن أَذرِعاتَ مُعَتَّقاً", "ajuz": "مِمّا تُعَتِّقُهُ مُلوكُ الأَعجَمِ" },
    { "n": 21, "sadr": "جادَت عَلَيهِ كُلُّ بِكرٍ حُرَّةٍ", "ajuz": "فَتَرَكنَ كُلَّ قَرارَةٍ كَالدِّرهَمِ" },
    { "n": 22, "sadr": "سَحّاً وَتَسكاباً فَكُلَّ عَشِيَّةٍ", "ajuz": "يَجري عَلَيها الماءُ لَم يَتَصَرَّمِ" },
    { "n": 23, "sadr": "وَخَلا الذُّبابُ بِها فَلَيسَ بِبارِحٍ", "ajuz": "غَرِداً كَفِعلِ الشّارِبِ المُتَرَنِّمِ" },
    { "n": 24, "sadr": "هَزِجاً يَحُكُّ ذِراعَهُ بِذِراعِهِ", "ajuz": "قَدحَ المُكِبِّ عَلى الزِّنادِ الأَجذَمِ" },
    { "n": 25, "sadr": "تُمسي وَتُصبِحُ فَوقَ ظَهرِ حَشِيَّةٍ", "ajuz": "وَأَبيتُ فَوقَ سَراةِ أَدهَمَ مُلجَمِ" },
    { "n": 26, "sadr": "وَحَشِيَّتي سَرجٌ عَلى عَبلِ الشَّوى", "ajuz": "نَهدٍ مَراكِلُهُ نَبيلِ المَحزِمِ" },
    { "n": 27, "sadr": "هَل تُبلِغَنّي دارَها شَدَنِيَّةٌ", "ajuz": "لُعِنَت بِمَحرومِ الشَّرابِ مُصَرَّمِ" },
    { "n": 28, "sadr": "خَطّارَةٌ غِبَّ السُّرى زَيّافَةٌ", "ajuz": "تَطِسُ الإِكامَ بِوَخدِ خُفٍّ ميثَمِ" },
    { "n": 29, "sadr": "فَكَأَنَّما أَقِصُ الإِكامَ عَشِيَّةً", "ajuz": "بِقَريبِ بَينَ المَنسِمَينِ مُصَلَّمِ" },
    { "n": 30, "sadr": "تَأوي لَهُ قُلُصُ النَّعامِ كَما أَوَت", "ajuz": "حِزَقٌ يَمانِيَةٌ لِأَعجَمَ طِمطِمِ" },
    { "n": 31, "sadr": "يَتبَعنَ قُلَّةَ رَأسِهِ وَكَأَنَّهُ", "ajuz": "حَرَجٌ عَلى نَعشٍ لَهُنَّ مُخَيَّمِ" },
    { "n": 32, "sadr": "صَعلٍ يَعودُ بِذي العُشَيرَةِ بَيضَهُ", "ajuz": "كَالعَبدِ ذي الفَروِ الطَّويلِ الأَصلَمِ" },
    { "n": 33, "sadr": "شَرِبَت بِماءِ الدُّحرُضَينِ فَأَصبَحَت", "ajuz": "زَوراءَ تَنفِرُ عَن حِياضِ الدَّيلَمِ" },
    { "n": 34, "sadr": "وَكَأَنَّما تَنأى بِجانِبِ دَفِّها ال", "ajuz": "وَحشِيِّ مِن هَزِجِ العَشِيِّ مُؤَوَّمِ" },
    { "n": 35, "sadr": "هِرٍّ جَنيبٍ كُلَّما عَطَفَت لَهُ", "ajuz": "غَضبى اِتَّقاها بِاليَدَينِ وَبِالفَمِ" },
    { "n": 36, "sadr": "أَبقى لَها طولُ السِّفارِ مُقَرمَداً", "ajuz": "سَنَداً وَمِثلَ دَعائِمِ المُتَخَيِّمِ" },
    { "n": 37, "sadr": "بَرَكَت عَلى جَنبِ الرِّداعِ كَأَنَّما", "ajuz": "بَرَكَت عَلى قَصَبٍ أَجَشَّ مُهَضَّمِ" },
    { "n": 38, "sadr": "وَكَأَنَّ رُبّاً أَو كُحَيلاً مُعقَداً", "ajuz": "حَشَّ الوَقودُ بِهِ جَوانِبَ قُمقُمِ" },
    { "n": 39, "sadr": "يَنباعُ مِن ذِفرى غَضوبٍ جَسرَةٍ", "ajuz": "زَيّافَةٍ مِثلِ الفَنيقِ المُكدَمِ" },
    { "n": 40, "sadr": "إِن تُغدِفي دوني القِناعَ فَإِنَّني", "ajuz": "طَبٌّ بِأَخذِ الفارِسِ المُستَلئِمِ" },
    { "n": 41, "sadr": "أَثني عَلَيَّ بِما عَلِمتِ فَإِنَّني", "ajuz": "سَمحٌ مُخالَطَتي إِذا لَم أُظلَمِ" },
    { "n": 42, "sadr": "فَإِذا ظُلِمتُ فَإِنَّ ظُلمي باسِلٌ", "ajuz": "مُرٌّ مَذاقَتُهُ كَطَعمِ العَلقَمِ" },
    { "n": 43, "sadr": "وَلَقَد شَرِبتُ مِنَ المُدامَةِ بَعدَما", "ajuz": "رَكَدَ الهَواجِرُ بِالمَشوفِ المُعلَمِ" },
    { "n": 44, "sadr": "بِزُجاجَةٍ صَفراءَ ذاتِ أَسِرَّةٍ", "ajuz": "قُرِنَت بِأَزهَرَ في الشِّمالِ مُفَدَّمِ" },
    { "n": 45, "sadr": "فَإِذا شَرِبتُ فَإِنَّني مُستَهلِكٌ", "ajuz": "مالي وَعِرضي وافِرٌ لَم يُكلَمِ" },
    { "n": 46, "sadr": "وَإِذا صَحَوتُ فَما أُقَصِّرُ عَن نَدىً", "ajuz": "وَكَما عَلِمتِ شَمائِلي وَتَكَرُّمي" },
    { "n": 47, "sadr": "وَحَليلِ غانِيَةٍ تَرَكتُ مُجَدَّلاً", "ajuz": "تَمكو فَريصَتُهُ كَشِدقِ الأَعلَمِ" },
    { "n": 48, "sadr": "سَبَقَت يَدايَ لَهُ بِعاجِلِ طَعنَةٍ", "ajuz": "وَرَشاشِ نافِذَةٍ كَلَونِ العَندَمِ" },
    { "n": 49, "sadr": "هَلّا سَأَلتِ الخَيلَ يا اِبنَةَ مالِكٍ", "ajuz": "إِن كُنتِ جاهِلَةً بِما لَم تَعلَمي" },
    { "n": 50, "sadr": "إِذ لا أَزالُ عَلى رِحالَةِ سابِحٍ", "ajuz": "نَهدٍ تَعاوَرُهُ الكُماةُ مُكَلَّمِ" },
    { "n": 51, "sadr": "طَوراً يُجَرَّدُ لِلطِّعانِ وَتارَةً", "ajuz": "يَأوي إِلى حَصِدِ القِسِيِّ عَرَمرَمِ" },
    { "n": 52, "sadr": "يُخبِركِ مَن شَهِدَ الوَقيعَةَ أَنَّني", "ajuz": "أَغشى الوَغى وَأَعِفُّ عِندَ المَغنَمِ" },
    { "n": 53, "sadr": "فَأَرى مَغانِمَ لَو أَشاءُ حَوَيتُها", "ajuz": "فَيَصُدُّني عَنها الحَيا وَتَكَرُّمي" },
    { "n": 54, "sadr": "وَمُدَجَّجٍ كَرِهَ الكُماةُ نِزالَهُ", "ajuz": "لا مُمعِنٍ هَرَباً وَلا مُستَسلِمِ" },
    { "n": 55, "sadr": "جادَت لَهُ كَفّي بِعاجِلِ طَعنَةٍ", "ajuz": "بِمُثَقَّفٍ صَدقِ الكُعوبِ مُقَوَّمِ" },
    { "n": 56, "sadr": "بِرَحيبَةِ الفَرغَينِ يَهدي جَرسُها", "ajuz": "بِاللَّيلِ مُعتَسَّ الذِّئابِ الضُّرَّمِ" },
    { "n": 57, "sadr": "فَشَكَكتُ بِالرُّمحِ الأَصَمِّ ثِيابَهُ", "ajuz": "لَيسَ الكَريمُ عَلى القَنا بِمُحَرَّمِ" },
    { "n": 58, "sadr": "فَتَرَكتُهُ جَزَرَ السِّباعِ يَنُشنَهُ", "ajuz": "يَقضِمنَ حُسنَ بَنانِهِ وَالمِعصَمِ" },
    { "n": 59, "sadr": "وَمِشَكِّ سابِغَةٍ هَتَكتُ فُروجَها", "ajuz": "بِالسَّيفِ عَن حامي الحَقيقَةِ مُعلِمِ" },
    { "n": 60, "sadr": "رَبِذٍ يَداهُ بِالقِداحِ إِذا شَتا", "ajuz": "هَتّاكِ غاياتِ التِّجارِ مُلَوَّمِ" },
    { "n": 61, "sadr": "لَمّا رَآني قَد نَزَلتُ أُريدُهُ", "ajuz": "أَبدى نَواجِذَهُ لِغَيرِ تَبَسُّمِ" },
    { "n": 62, "sadr": "فَطَعَنتُهُ بِالرُّمحِ ثُمَّ عَلَوتُهُ", "ajuz": "بِمُهَنَّدٍ صافي الحَديدَةِ مِخذَمِ" },
    { "n": 63, "sadr": "عَهدي بِهِ مَدَّ النَّهارِ كَأَنَّما", "ajuz": "خُضِبَ البَنانُ وَرَأسُهُ بِالعِظلِمِ" },
    { "n": 64, "sadr": "بَطَلٍ كَأَنَّ ثِيابَهُ في سَرحَةٍ", "ajuz": "يُحذى نِعالَ السِّبتِ لَيسَ بِتَوأَمِ" },
    { "n": 65, "sadr": "يا شاةَ ما قَنَصٍ لِمَن حَلَّت لَهُ", "ajuz": "حَرُمَت عَلَيَّ وَلَيتَها لَم تَحرُمِ" },
    { "n": 66, "sadr": "فَبَعَثتُ جارِيَتي فَقُلتُ لَها اِذهَبي", "ajuz": "فَتَجَسَّسي أَخبارَها لي وَاعلَمي" },
    { "n": 67, "sadr": "قالَت رَأَيتُ مِنَ الأَعادي غِرَّةً", "ajuz": "وَالشّاةُ مُمكِنَةٌ لِمَن هُوَ مُرتَمِ" },
    { "n": 68, "sadr": "وَكَأَنَّما اِلتَفَتَت بِجيدِ جَدايَةٍ", "ajuz": "رَشَأٍ مِنَ الغِزلانِ حُرٍّ أَرثَمِ" },
    { "n": 69, "sadr": "نُبِّئتُ عَمراً غَيرَ شاكِرِ نِعمَتي", "ajuz": "وَالكُفرُ مَخبَثَةٌ لِنَفسِ المُنعِمِ" },
    { "n": 70, "sadr": "وَلَقَد حَفِظتُ وَصاةَ عَمّي بِالضُّحى", "ajuz": "إِذ تَقلِصُ الشَّفَتانِ عَن وَضَحِ الفَمِ" },
    { "n": 71, "sadr": "في حَومَةِ المَوتِ الَّتي لا تَشتَكي", "ajuz": "غَمَراتِها الأَبطالُ غَيرَ تَغَمغُمِ" },
    { "n": 72, "sadr": "إِذ يَتَّقونَ بِيَ الأَسِنَّةَ لَم أَخِم", "ajuz": "عَنها وَلَكِنّي تَضايَقَ مُقدَمي" },
    { "n": 73, "sadr": "لَمّا رَأَيتُ القَومَ أَقبَلَ جَمعُهُم", "ajuz": "يَتَذامَرونَ كَرَرتُ غَيرَ مُذَمَّمِ" },
    { "n": 74, "sadr": "يَدعونَ عَنتَرَ وَالرِّماحُ كَأَنَّها", "ajuz": "أَشطانُ بِئرٍ في لَبانِ الأَدهَمِ" },
    { "n": 75, "sadr": "ما زِلتُ أَرميهِم بِثُغرَةِ نَحرِهِ", "ajuz": "وَلَبانِهِ حَتّى تَسَربَلَ بِالدَّمِ" },
    { "n": 76, "sadr": "فَازوَرَّ مِن وَقعِ القَنا بِلَبانِهِ", "ajuz": "وَشَكا إِلَيَّ بِعَبرَةٍ وَتَحَمحُمِ" },
    { "n": 77, "sadr": "لَو كانَ يَدري ما المُحاوَرَةُ اِشتَكى", "ajuz": "وَلَكانَ لَو عَلِمَ الكَلامَ مُكَلِّمي" },
    { "n": 78, "sadr": "وَلَقَد شَفى نَفسي وَأَبرَأَ سُقمَها", "ajuz": "قيلُ الفَوارِسِ وَيكَ عَنتَرَ أَقدِمِ" },
    { "n": 79, "sadr": "وَالخَيلُ تَقتَحِمُ الخَبارَ عَوابِساً", "ajuz": "مِن بَينِ شَيظَمَةٍ وَأَجرَدَ شَيظَمِ" },
    { "n": 80, "sadr": "ذُلُلٌ رِكابي حَيثُ شِئتُ مُشايِعي", "ajuz": "لُبّي وَأَحفِزُهُ بِأَمرٍ مُبرَمِ" },
    { "n": 81, "sadr": "إِنّي عَداني أَن أَزورَكِ فَاعلَمي", "ajuz": "ما قَد عَلِمتِ وَبَعضُ ما لَم تَعلَمي" },
    { "n": 82, "sadr": "حالَت رِماحُ بَني بَغيضٍ دونَكُم", "ajuz": "وَزَوَت جَواني الحَربِ مَن لَم يُجرِمِ" },
    { "n": 83, "sadr": "وَلَقَد كَرَرتُ المُهرَ يَدمى نَحرُهُ", "ajuz": "حَتّى اِتَّقَتني الخَيلُ بِابنَي حِذيَمِ" },
