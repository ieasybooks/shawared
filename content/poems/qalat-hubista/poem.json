{
  "id": "qalat-hubista",
  "poet": "ali-ibn-al-jahm",
  "title": "قالَت حُبِستَ فَقُلتُ لَيسَ بِضائِرٍ",
  "meter": "kamil",
  "rawiy": "د",
  "abyat_in_full": 28,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "قالَت حُبِستَ فَقُلتُ لَيسَ بِضائِرٍ",
      "ajuz": "حَبسي وَأَيُّ مُهَنَّدٍ لا يُغمَدُ"
    },
    {
      "n": 2,
      "sadr": "أَوَما رَأَيتِ اللَّيثَ يَألَفُ غيلَهُ",
      "ajuz": "كِبراً وَأَوباشُ السِّباعِ تَرَدَّدُ"
    },
    {
      "n": 3,
      "sadr": "وَالشَّمسُ لَولا أَنَّها مَحجوبَةٌ",
      "ajuz": "عَن ناظِرَيكِ لَما أَضاءَ الفَرقَدُ"
    },
    {
      "n": 4,
      "sadr": "وَالبَدرُ يُدرِكُهُ السِّرارُ فَتَنجَلي",
      "ajuz": "أَيّامُهُ وَكَأَنَّهُ مُتَجَدِّدُ"
    },
    {
      "n": 5,
      "sadr": "وَالغَيثُ يَحصُرُهُ الغَمامُ فَما يُرى",
      "ajuz": "إِلّا وَرَيِّقُهُ يُراحُ وَيُرعِدُ"
    },
    {
      "n": 6,
      "sadr": "وَالنّارُ في أَحجارِها مَخبوءَةٌ",
      "ajuz": "لا تُصطَلى إِن لَم تُثِرها الأَزنُدُ"
    },
    {
      "n": 7,
      "sadr": "وَالزّاعِبِيَّةُ لا يُقيمُ كُعوبَها",
      "ajuz": "إِلّا الثِّقافُ وَجَذوَةٌ تَتَوَقَّدُ"
    },
    {
      "n": 8,
      "sadr": "غِيَرُ اللَّيالي بادِئاتٌ عُوَّدٌ",
      "ajuz": "وَالمالُ عارِيَّةٌ يُفادُ وَيَنفَدُ"
    },
    {
      "n": 9,
      "sadr": "وَلِكُلِّ حالٍ مُعقِبٌ وَلَرُبَّما",
      "ajuz": "أَجلى لَكَ المَكروهُ عَمّا يُحمَدُ"
    },
    {
      "n": 10,
      "sadr": "لا يُؤيِسَنَّكَ مِن تَفَرُّجِ كُربَةٍ",
      "ajuz": "خَطبٌ رَماكَ بِهِ الزَّمانُ الأَنكَدُ"
    },
    {
      "n": 11,
      "sadr": "كَم مِن عَليلٍ قَد تَخَطّاهُ الرَّدى",
      "ajuz": "فَنَجا وَماتَ طَبيبُهُ وَالعُوَّدُ"
    },
    {
      "n": 12,
      "sadr": "صَبراً فَإِنَّ الصَّبرَ يُعقِبُ راحَةً",
      "ajuz": "وَيَدُ الخَليفَةِ لا تُطاوِلُها يَدُ"
    },
    {
      "n": 13,
      "sadr": "وَالحَبسُ ما لَم تَغشَهُ لِدَنِيَّةٍ",
      "ajuz": "شَنعاءَ نِعمَ المَنزِلُ المُتَوَرَّدُ"
    },
    {
      "n": 14,
      "sadr": "بَيتٌ يُجَدِّدُ لِلكَريمِ كَرامَةً",
      "ajuz": "وَيُزارُ فيهِ وَلا يَزورُ وَيُحفَدُ"
    },
    {
      "n": 15,
      "sadr": "لَو لَم يَكُن في السِّجنِ إِلّا أَنَّهُ",
      "ajuz": "لا يَستَذِلُّكَ بِالحِجابِ الأَعبُدُ"
    },
    {
      "n": 16,
      "sadr": "يا أَحمَدَ بنَ أَبي دُؤادٍ إِنَّما",
      "ajuz": "تُدعى لِكُلِّ عَظيمَةٍ يا أَحمَدُ"
    },
    {
      "n": 17,
      "sadr": "بَلِّغ أَميرَ المُؤمِنينَ وَدونَهُ",
      "ajuz": "خَوضُ العِدى وَمَخاوِفٌ لا تَنفَدُ"
    },
    {
      "n": 18,
      "sadr": "أَنتُم بَني عَمِّ النَّبِيِّ مُحَمَّدٍ",
      "ajuz": "أَولى بِما شَرَعَ النَّبِيُّ مُحَمَّدُ"
    },
    {
      "n": 19,
      "sadr": "ما كانَ مِن حَسَنٍ فَأَنتُم أَهلُهُ",
      "ajuz": "طابَت مَغارِسُكُم وَطابَ المَحتِدُ"
    },
    {
      "n": 20,
      "sadr": "أَمِنَ السَّوِيَّةِ يا اِبنَ عَمِّ مُحَمَّدٍ",
      "ajuz": "خَصمٌ تُقَرِّبُهُ وَآخَرُ تُبعِدُ"
    },
    {
      "n": 21,
      "sadr": "إِنَّ الَّذينَ سَعَوا إِلَيكَ بِباطِلٍ",
      "ajuz": "أَعداءُ نِعمَتِكَ الَّتي لا تُجحَدُ"
    },
    {
      "n": 22,
      "sadr": "شَهِدوا وَغِبنا عَنهُمُ فَتَحَكَّموا",
      "ajuz": "فينا وَلَيسَ كَغائِبٍ مَن يَشهَدُ"
    },
    {
      "n": 23,
      "sadr": "لَو يَجمَعُ الخَصمَينِ عِندَكَ مَشهَدٌ",
      "ajuz": "يَوماً لَبانَ لَكَ الطَّريقُ الأَقصَدُ"
    },
    {
      "n": 24,
      "sadr": "فَلَئِن بَقيتُ عَلى الزَّمانِ وَكانَ لي",
      "ajuz": "يَوماً مِنَ المَلِكِ الخَليفَةِ مَقعَدُ"
    },
    {
      "n": 25,
      "sadr": "وَاِحتَجَّ خَصمي وَاِحتَجَجتُ بِحُجَّتي",
      "ajuz": "لَفَلَجتُ في حُجَجي وَخابَ الأَبعَدُ"
    },
    {
      "n": 26,
      "sadr": "وَاللَّهُ بالِغُ أَمرِهِ في خَلقِهِ",
      "ajuz": "وَإِلَيهِ مَصدَرُنا غَداً وَالمَورِدُ"
    },
    {
      "n": 27,
      "sadr": "وَلَئِن مَضَيتُ لَقَلَّما يَبقى الَّذي",
      "ajuz": "قَد كادَني وَلَيَجمَعَنّا المَوعِدُ"
    },
    {
      "n": 28,
      "sadr": "فَبِأَيِّ ذَنبٍ أَصبَحَت أَعراضُنا",
      "ajuz": "نَهباً يُشيدُ بِها اللَّئيمُ الأَوغَدُ"
    }
  ]
}
