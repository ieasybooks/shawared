{
  "id": "alam-taghtamid-aynaka",
  "poet": "al-asha",
  "title": "أَلَم تَغتَمِض عَيناكَ لَيلَةَ أَرمَدا",
  "meter": "tawil",
  "rawiy": "د",
  "abyat_in_full": 24,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَلَم تَغتَمِض عَيناكَ لَيلَةَ أَرمَدا",
      "ajuz": "وَعادَكَ ما عادَ السَّليمَ المُسَهَّدا"
    },
    {
      "n": 2,
      "sadr": "وَما ذاكَ مِن عِشقِ النِّساءِ وَإِنَّما",
      "ajuz": "تَناسَيتَ قَبلَ اليَومِ خُلَّةَ مَهدَدا"
    },
    {
      "n": 3,
      "sadr": "وَلَكِن أَرى الدَّهرَ الَّذي هُوَ خاتِرٌ",
      "ajuz": "إِذا أَصلَحَت كَفّايَ عادَ فَأَفسَدا"
    },
    {
      "n": 4,
      "sadr": "شَبابٌ وَشَيبٌ وَافتِقارٌ وَثَروَةٌ",
      "ajuz": "فَلِلَّهِ هَذا الدَّهرُ كَيفَ تَرَدَّدا"
    },
    {
      "n": 5,
      "sadr": "وَما زِلتُ أَبغي المالَ مُذ أَنا يافِعٌ",
      "ajuz": "وَليداً وَكَهلاً حينَ شِبتُ وَأَمرَدا"
    },
    {
      "n": 6,
      "sadr": "وَأَبتَذِلُ العيسَ المَراقيلَ تَغتَلي",
      "ajuz": "مَسافَةَ ما بَينَ النُّجَيرِ فَصَرخَدا"
    },
    {
      "n": 7,
      "sadr": "فَإِن تَسأَلي عَنّي فَيا رُبَّ سائِلٍ",
      "ajuz": "حَفِيٍّ عَنِ الأَعشى بِهِ حَيثُ أَصعَدا"
    },
    {
      "n": 8,
      "sadr": "أَلا أَيُّهَذا السّائِلي أَينَ يَمَّمَت",
      "ajuz": "فَإِنَّ لَها في أَهلِ يَثرِبَ مَوعِدا"
    },
    {
      "n": 9,
      "sadr": "فَأَمّا إِذا ما أَدلَجَت فَتَرى لَها",
      "ajuz": "رَقيبَينِ جَدياً لا يَغيبُ وَفَرقَدا"
    },
    {
      "n": 10,
      "sadr": "وَفيها إِذا ما هَجَّرَت عَجرَفِيَّةٌ",
      "ajuz": "إِذا خِلتَ حِرباءَ الظَّهيرَةِ أَصيَدا"
    },
    {
      "n": 11,
      "sadr": "أَجَدَّت بِرِجلَيها نَجاءً وَراجَعَت",
      "ajuz": "يَداها خِنافاً لَيِّناً غَيرَ أَحرَدا"
    },
    {
      "n": 12,
      "sadr": "فَآلَيتُ لا أَرثي لَها مِن كَلالَةٍ",
      "ajuz": "وَلا مِن حَفىً حَتّى تَزورَ مُحَمَّدا"
    },
    {
      "n": 13,
      "sadr": "مَتى ما تُناخي عِندَ بابِ اِبنِ هاشِمٍ",
      "ajuz": "تُريحي وَتَلقَي مِن فَواضِلِهِ يَدا"
    },
    {
      "n": 14,
      "sadr": "نَبِيٌّ يَرى ما لا تَرَونَ وَذِكرُهُ",
      "ajuz": "أَغارَ لَعَمري في البِلادِ وَأَنجَدا"
    },
    {
      "n": 15,
      "sadr": "لَهُ صَدَقاتٌ ما تُغِبُّ وَنائِلٌ",
      "ajuz": "وَلَيسَ عَطاءُ اليَومِ مانِعَهُ غَدا"
    },
    {
      "n": 16,
      "sadr": "أَجِدَّكَ لَم تَسمَع وَصاةَ مُحَمَّدٍ",
      "ajuz": "نَبِيِّ الإِلَهِ حينَ أَوصى وَأَشهَدا"
    },
    {
      "n": 17,
      "sadr": "إِذا أَنتَ لَم تَرحَل بِزادٍ مِنَ التُّقى",
      "ajuz": "وَلاقَيتَ بَعدَ المَوتِ مَن قَد تَزَوَّدا"
    },
    {
      "n": 18,
      "sadr": "نَدِمتَ عَلى أَن لا تَكونَ كَمِثلِهِ",
      "ajuz": "وَأَنَّكَ لَم تُرصِد لِما كانَ أَرصَدا"
    },
    {
      "n": 19,
      "sadr": "فَإِيّاكَ وَالمَيتاتِ لا تَأكُلَنَّها",
      "ajuz": "وَلا تَأخُذَن سَهماً حَديداً لِتَفصِدا"
    },
    {
      "n": 20,
      "sadr": "وَذا النُّصُبَ المَنصوبَ لا تَنسُكَنَّهُ",
      "ajuz": "وَلا تَعبُدِ الأَوثانَ وَاللَّهَ فَاعبُدا"
    },
    {
      "n": 21,
      "sadr": "وَصَلِّ عَلى حينِ العَشِيّاتِ وَالضُّحى",
      "ajuz": "وَلا تَحمَدِ الشَّيطانَ وَاللَّهَ فَاحمَدا"
    },
    {
      "n": 22,
      "sadr": "وَلا السّائِلَ المَحرومَ لا تَترُكَنَّهُ",
      "ajuz": "لِعاقِبَةٍ وَلا الأَسيرَ المُقَيَّدا"
    },
    {
      "n": 23,
      "sadr": "وَلا تَسخَرَن مِن بائِسٍ ذي ضَرارَةٍ",
      "ajuz": "وَلا تَحسَبَنَّ المَرءَ يَوماً مُخَلَّدا"
    },
    {
      "n": 24,
      "sadr": "وَلا تَقرَبَنَّ جارَةً إِنَّ سِرَّها",
      "ajuz": "عَلَيكَ حَرامٌ فَانكِحَن أَو تَأَبَّدا"
    }
  ]
}
