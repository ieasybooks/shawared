{
  "id": "nama-al-khaliyyu",
  "poet": "al-aswad-ibn-yafur",
  "title": "نامَ الخَلِيُّ وَما أُحِسُّ رُقادي",
  "meter": "kamil",
  "themes": ["shakwa", "shawq"],
  "rawiy": "د",
  "abyat_in_full": 36,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "نامَ الخَلِيُّ وَما أُحِسُّ رُقادي",
      "ajuz": "وَالهَمُّ مُحتَضِرٌ لَدَيَّ وِسادي"
    },
    {
      "n": 2,
      "sadr": "مِن غَيرِ ما سَقَمٍ وَلَكِن شَفَّني",
      "ajuz": "هَمٌّ أَراهُ قَد أَصابَ فُؤادي"
    },
    {
      "n": 3,
      "sadr": "وَمِنَ الحَوادِثِ لا أَبا لَكِ أَنَّني",
      "ajuz": "ضُرِبَت عَلَيَّ الأَرضُ بِالأَسدادِ"
    },
    {
      "n": 4,
      "sadr": "لا أَهتَدي فيها لِمَوضِعِ تَلعَةٍ",
      "ajuz": "بَينَ العِراقِ وَبَينَ أَرضِ مُرادِ"
    },
    {
      "n": 5,
      "sadr": "وَلَقَد عَلِمتُ سِوى الَّذي نَبَّأتِني",
      "ajuz": "أَنَّ السَّبيلَ سَبيلُ ذي الأَعوادِ"
    },
    {
      "n": 6,
      "sadr": "إِنَّ المَنِيَّةَ وَالحُتوفَ كِلاهُما",
      "ajuz": "يوفي المَخارِمَ يَرقُبانِ سَوادي"
    },
    {
      "n": 7,
      "sadr": "لَن يَرضَيا مِنّي وَفاءَ رَهينَةٍ",
      "ajuz": "مِن دونِ نَفسي طارِفي وَتِلادي"
    },
    {
      "n": 8,
      "sadr": "ماذا أُؤَمِّلُ بَعدَ آلِ مُحَرِّقٍ",
      "ajuz": "تَرَكوا مَنازِلَهُم وَبَعدَ إِيادِ"
    },
    {
      "n": 9,
      "sadr": "أَهلِ الخَوَرنَقِ وَالسَّديرِ وَبارِقٍ",
      "ajuz": "وَالقَصرِ ذي الشُّرُفاتِ مِن سِندادِ"
    },
    {
      "n": 10,
      "sadr": "أَرضاً تَخَيَّرَها لِدارِ أَبيهِمُ",
      "ajuz": "كَعبُ بنُ مامَةَ وَابنُ أُمِّ دُؤادِ"
    },
    {
      "n": 11,
      "sadr": "جَرَتِ الرِّياحُ عَلى مَكانِ دِيارِهِم",
      "ajuz": "فَكَأَنَّما كانوا عَلى ميعادِ"
    },
    {
      "n": 12,
      "sadr": "وَلَقَد غَنوا فيها بِأَنعَمِ عيشَةٍ",
      "ajuz": "في ظِلِّ مُلكٍ ثابِتِ الأَوتادِ"
    },
    {
      "n": 13,
      "sadr": "نَزَلوا بِأَنقُرَةٍ يَسيلُ عَلَيهِمُ",
      "ajuz": "ماءُ الفُراتِ يَجيءُ مِن أَطوادِ"
    },
    {
      "n": 14,
      "sadr": "فَإِذا النَّعيمُ وَكُلُّ ما يُلهى بِهِ",
      "ajuz": "يَوماً يَصيرُ إِلى بِلىً وَنَفادِ"
    },
    {
      "n": 15,
      "sadr": "في آلِ غَرفٍ لَو بَغَيتِ لِيَ الأُسى",
      "ajuz": "لَوَجَدتِ فيهِم أُسوَةَ العُدّادِ"
    },
    {
      "n": 16,
      "sadr": "ما بَعدَ زَيدٍ في فَتاةٍ فُرِّقوا",
      "ajuz": "قَتلاً وَنَفياً بَعدَ حُسنِ تَآدي"
    },
    {
      "n": 17,
      "sadr": "فَتَخَيَّروا الأَرضَ الفَضاءَ لِعِزِّهِم",
      "ajuz": "وَيَزيدُ رافِدُهُم عَلى الرُّفّادِ"
    },
    {
      "n": 18,
      "sadr": "إِمّا تَرَيني قَد بَليتُ وَغاضَني",
      "ajuz": "ما نيلَ مِن بَصَري وَمِن أَجلادي"
    },
    {
      "n": 19,
      "sadr": "وَعَصَيتُ أَصحابَ الصَّبابَةِ وَالصِّبا",
      "ajuz": "وَأَطَعتُ عاذِلَتي وَلانَ قِيادي"
    },
    {
      "n": 20,
      "sadr": "فَلَقَد أَروحُ عَلى التِّجارِ مُرَجَّلاً",
      "ajuz": "مَذِلاً بِمالي لَيِّناً أَجيادي"
    },
    {
      "n": 21,
      "sadr": "وَلَقَد لَهَوتُ وَلِلشَّبابِ لَذاذَةٌ",
      "ajuz": "بِسُلافَةٍ مُزِجَت بِماءِ غَوادي"
    },
    {
      "n": 22,
      "sadr": "مِن خَمرِ ذي نَطَفٍ أَغَنَّ مُنَطَّقٍ",
      "ajuz": "وافى بِها لِدَراهِمِ الإِسجادِ"
    },
    {
      "n": 23,
      "sadr": "يَسعى بِها ذو تومَتَينِ مُشَمِّرٌ",
      "ajuz": "قَنَأَت أَنامِلُهُ مِنَ الفِرصادِ"
    },
    {
      "n": 24,
      "sadr": "وَالبيضُ تَمشي كَالبُدورِ وَكَالدُّمى",
      "ajuz": "وَنَواعِمٌ يَمشينَ بِالأَرفادِ"
    },
    {
      "n": 25,
      "sadr": "وَالبيضُ يَرمينَ القُلوبَ كَأَنَّها",
      "ajuz": "أُدحِيُّ بَينِ صَريمَةٍ وَجَمادِ"
    },
    {
      "n": 26,
      "sadr": "يَنطِقنَ مَعروفاً وَهُنَّ نَواعِمٌ",
      "ajuz": "بيضُ الوُجوهِ رَقيقَةُ الأَكبادِ"
    },
    {
      "n": 27,
      "sadr": "يَنطِقنَ مَخفوضَ الحَديثِ تَهامُساً",
      "ajuz": "فَبَلَغنَ ما حاوَلنَ غَيرَ تَنادي"
    },
    {
      "n": 28,
      "sadr": "وَلَقَد غَدَوتُ لِعازِبٍ مُتَناذَرٍ",
      "ajuz": "أَحوى المَذانِبِ مُؤنِقِ الرُّوّادِ"
    },
    {
      "n": 29,
      "sadr": "جادَت سَواريهِ وَآزَرَ نَبتَهُ",
      "ajuz": "نُفَأٌ مِنَ الصَّفراءِ وَالزُّبّادِ"
    },
    {
      "n": 30,
      "sadr": "بِالجَوِّ فَالأَمَراتِ حَولَ مُغامِرٍ",
      "ajuz": "فَبِضارِجٍ فَقَصيمَةِ الطُّرّادِ"
    },
    {
      "n": 31,
      "sadr": "بِمُشَمِّرٍ عَتِدٍ جَهيزٍ شَدُّهُ",
      "ajuz": "قَيدِ الأَوابِدِ وَالرِّهانِ جَوادِ"
    },
    {
      "n": 32,
      "sadr": "يَشوي لَنا الوَحَدَ المُدِلَّ بِحُضرِهِ",
      "ajuz": "بِشَريجِ بَينَ الشَّدِّ وَالإيرادِ"
    },
    {
      "n": 33,
      "sadr": "وَلَقَد تَلَوتُ الظّاعِنينَ بِجَسرَةٍ",
      "ajuz": "أُجُدٍ مُهاجِرَةِ السِّقابِ جَمادِ"
    },
    {
      "n": 34,
      "sadr": "عَيرانَةٍ سَدَّ الرَّبيعُ خَصاصَها",
      "ajuz": "ما يَستَبينُ بِها مَقيلُ قُرادِ"
    },
    {
      "n": 35,
      "sadr": "فَإِذا وَذَلِكَ لا مَهاهَ لِذِكرِهِ",
      "ajuz": "وَالدَّهرُ يُعقِبُ صالِحاً بِفَسادِ"
    }
  ]
}
