{
  "id": "inna-idha-ishtadda-al-zaman",
  "poet": "abu-firas-al-hamdani",
  "title": "إِنّا إِذا اِشتَدَّ الزَّمانُ",
  "meter": "kamil",
  "rawiy": "م",
  "abyat_in_full": 12,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "إِنّا إِذا اِشتَدَّ الزَّما",
      "ajuz": "نُ وَنابَ خَطبٌ وَادلَهَمَّ"
    },
    {
      "n": 2,
      "sadr": "أَلفَيتَ حَولَ بُيوتِنا",
      "ajuz": "عُدَدَ الشَّجاعَةِ وَالكَرَم"
    },
    {
      "n": 3,
      "sadr": "لِلِقا العِدا بيضُ السُّيو",
      "ajuz": "فِ وَلِلنَّدى حُمرُ النَّعَم"
    },
    {
      "n": 4,
      "sadr": "هَذا وَهَذا دَأبُنا",
      "ajuz": "يودى دَمٌ وَيُراقُ دَم"
    },
    {
      "n": 5,
      "sadr": "قُل لِابنِ وَرقا جَعفَرٍ",
      "ajuz": "حَتّى يَقولَ بِما عَلِم"
    },
    {
      "n": 6,
      "sadr": "إِنّي وَإِن شَطَّ المَزا",
      "ajuz": "رُ وَلَم تَكُن داري أَمَم"
    },
    {
      "n": 7,
      "sadr": "أَصبو إِلى تِلكَ الخِلا",
      "ajuz": "لِ وَأَصطَفي تِلكَ الشِّيَم"
    },
    {
      "n": 8,
      "sadr": "وَأَلومُ عادِيَةَ الفِرا",
      "ajuz": "قِ وَبَينَ أَحشائي أَلَم"
    },
    {
      "n": 9,
      "sadr": "وَلَعَلَّ دَهراً يَنثَني",
      "ajuz": "وَلَعَلَّ شَعباً يَلتَئِم"
    },
    {
      "n": 10,
      "sadr": "هَل أَنتَ يَوماً مُنصِفي",
      "ajuz": "مِن ظُلمِ عَمِّكَ يا اِبنَ عَمِّ"
    },
    {
      "n": 11,
      "sadr": "أَبلِغهُ عَنّي ما أَقو",
      "ajuz": "لُ فَأَنتَ مَن لا يُتَّهَم"
    },
    {
      "n": 12,
      "sadr": "أَنّي رَضيتُ وَإِن كَرِه",
      "ajuz": "تَ أَبا مُحَمَّدٍ الحَكَم"
    }
  ]
}
