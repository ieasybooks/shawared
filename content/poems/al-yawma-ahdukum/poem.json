{
  "id": "al-yawma-ahdukum",
  "poet": "al-mutanabbi",
  "title": "اليَومَ عَهدُكُمُ فَأَينَ المَوعِدُ",
  "meter": "kamil",
  "rawiy": "د",
  "abyat_in_full": 40,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "اليَومَ عَهدُكُمُ فَأَينَ المَوعِدُ",
      "ajuz": "هَيهاتَ لَيسَ لِيَومِ عَهدِكُمُ غَدُ"
    },
    {
      "n": 2,
      "sadr": "المَوتُ أَقرَبُ مِخلَباً مِن بَينِكُم",
      "ajuz": "وَالعَيشُ أَبعَدُ مِنكُمُ لا تَبعَدوا"
    },
    {
      "n": 3,
      "sadr": "إِنَّ الَّتي سَفَكَت دَمي بِجُفونِها",
      "ajuz": "لَم تَدرِ أَنَّ دَمي الَّذي تَتَقَلَّدُ"
    },
    {
      "n": 4,
      "sadr": "قالَت وَقَد رَأَتِ اِصفِراري مَن بِهِ",
      "ajuz": "وَتَنَهَّدَت فَأَجَبتُها المُتَنَهِّدُ"
    },
    {
      "n": 5,
      "sadr": "فَمَضَت وَقَد صَبَغَ الحَياءُ بَياضَها",
      "ajuz": "لَوني كَما صَبَغَ اللُّجَينَ العَسجَدُ"
    },
    {
      "n": 6,
      "sadr": "فَرَأَيتُ قَرنَ الشَّمسِ في قَمَرِ الدُّجى",
      "ajuz": "مُتَأَوِّداً غُصنٌ بِهِ يَتَأَوَّدُ"
    },
    {
      "n": 7,
      "sadr": "عَدَوِيَّةٌ بَدَوِيَّةٌ مِن دونِها",
      "ajuz": "سَلبُ النُّفوسِ وَنارُ حَربٍ توقَدُ"
    },
    {
      "n": 8,
      "sadr": "وَهَواجِلٌ وَصَواهِلٌ وَمَناصِلٌ",
      "ajuz": "وَذَوابِلٌ وَتَوَعُّدٌ وَتَهَدُّدُ"
    },
    {
      "n": 9,
      "sadr": "أَبلَت مَوَدَّتَها اللَّيالي بَعدَنا",
      "ajuz": "وَمَشى عَلَيها الدَّهرُ وَهوَ مُقَيَّدُ"
    },
    {
      "n": 10,
      "sadr": "بَرَّحتَ يا مَرَضَ الجُفونِ بِمُمرَضٍ",
      "ajuz": "مَرِضَ الطَّبيبُ لَهُ وَعيدَ العُوَّدُ"
    }
  ]
}
