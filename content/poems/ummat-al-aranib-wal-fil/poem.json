{
  "id": "ummat-al-aranib-wal-fil",
  "poet": "ahmad-shawqi",
  "title": "أُمَّةُ الأَرانِبِ وَالفيلُ",
  "meter": "rajaz",
  "abyat_in_full": 24,
  "added": "2026-11-24",
  "abyat": [
    {"n": 1, "sadr": "يَحكونَ أَنَّ أُمَّةَ الأَرانِبِ", "ajuz": "قَد أَخَذَت مِنَ الثَّرى بِجانِبِ"},
    {"n": 2, "sadr": "وَابتَهَجَت بِالوَطَنِ الكَريمِ", "ajuz": "وَمَوئِلِ العِيالِ وَالحَريمِ"},
    {"n": 3, "sadr": "فَاختارَهُ الفيلُ لَهُ طَريقا", "ajuz": "مُمَزِّقاً أَصحابَنا تَمزيقا"},
    {"n": 4, "sadr": "وَكانَ فيهِم أَرنَبٌ لَبيبُ", "ajuz": "أَذهَبَ جُلَّ صوفِهِ التَّجريبُ"},
    {"n": 5, "sadr": "نادى بِهِم يا مَعشَرَ الأَرانِبِ", "ajuz": "مِن عالِمٍ وَشاعِرٍ وَكاتِبِ"},
    {"n": 6, "sadr": "اِتَّحِدوا ضِدَّ العَدُوِّ الجافي", "ajuz": "فَالاِتِّحادُ قُوَّةُ الضِّعافِ"},
    {"n": 7, "sadr": "فَأَقبَلوا مُستَصوِبينَ رَأيَهُ", "ajuz": "وَعَقَدوا لِلاجتِماعِ رايَةً"},
    {"n": 8, "sadr": "وَانتَخَبوا مِن بَينِهِم ثَلاثَةً", "ajuz": "لا هَرَماً راعَوا وَلا حَداثَةً"},
    {"n": 9, "sadr": "بَل نَظَروا إِلى كَمالِ العَقلِ", "ajuz": "وَاعتَبَروا في ذاكَ سِنَّ الفَضلِ"},
    {"n": 10, "sadr": "فَنَهَضَ الأَوَّلُ لِلخِطابِ", "ajuz": "فَقالَ إِنَّ الرَّأيَ ذا الصَّوابِ"},
    {"n": 11, "sadr": "أَن تُترَكَ الأَرضُ لِذي الخُرطومِ", "ajuz": "كَي نَستَريحَ مِن أَذى الغَشومِ"},
    {"n": 12, "sadr": "فَصاحَتِ الأَرانِبُ الغَوالي", "ajuz": "هَذا أَضَرُّ مِن أَبي الأَهوالِ"},
    {"n": 13, "sadr": "وَوَثَبَ الثّاني فَقالَ إِنّي", "ajuz": "أَعهَدُ في الثَّعلَبِ شَيخَ الفَنِّ"},
    {"n": 14, "sadr": "فَلنَدعُهُ يُمِدَّنا بِحِكمَتِهِ", "ajuz": "وَيَأخُذَ اِثنَينِ جَزاءَ خِدمَتِهِ"},
    {"n": 15, "sadr": "فَقيلَ لا يا صاحِبَ السُّمُوِّ", "ajuz": "لا يُدفَعُ العَدُوُّ بِالعَدُوِّ"},
    {"n": 16, "sadr": "وَانتَدَبَ الثّالِثُ لِلكَلامِ", "ajuz": "فَقالَ يا مَعاشِرَ الأَقوامِ"},
    {"n": 17, "sadr": "اِجتَمِعوا فَالاِجتِماعُ قُوَّةٌ", "ajuz": "ثُمَّ اِحفِروا عَلى الطَّريقِ هُوَّةً"},
    {"n": 18, "sadr": "يَهوي إِلَيها الفيلُ في مُرورِهِ", "ajuz": "فَنَستَريحُ الدَّهرَ مِن شُرورِهِ"},
    {"n": 19, "sadr": "ثُمَّ يَقولُ الجيلُ بَعدَ الجيلِ", "ajuz": "قَد أَكَلَ الأَرنَبُ عَقلَ الفيلِ"},
    {"n": 20, "sadr": "فَاستَصوَبوا مَقالَهُ وَاستَحسَنوا", "ajuz": "وَعَمِلوا مِن فَورِهِم فَأَحسَنوا"},
    {"n": 21, "sadr": "وَهَلَكَ الفيلُ الرَّفيعُ الشّانِ", "ajuz": "فَأَمسَتِ الأُمَّةُ في أَمانِ"},
    {"n": 22, "sadr": "وَأَقبَلَت لِصاحِبِ التَّدبيرِ", "ajuz": "ساعِيَةً بِالتّاجِ وَالسَّريرِ"},
    {"n": 23, "sadr": "فَقالَ مَهلاً يا بَني الأَوطانِ", "ajuz": "إِنَّ مَحَلّي لَلمَحَلُّ الثّاني"},
    {"n": 24, "sadr": "فَصاحِبُ الصَّوتِ القَوِيِّ الغالِبِ", "ajuz": "مَن قَد دَعا يا مَعشَرَ الأَرانِبِ"}
  ]
}
