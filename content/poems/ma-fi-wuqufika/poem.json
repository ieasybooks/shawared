{
  "id": "ma-fi-wuqufika",
  "poet": "abu-tammam",
  "title": "ما في وُقوفِكَ ساعَةً مِن باسِ",
  "meter": "kamil",
  "themes": ["madh"],
  "rawiy": "س",
  "abyat_in_full": 34,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "ما في وُقوفِكَ ساعَةً مِن باسِ",
      "ajuz": "نَقضي ذِمامَ الأَربُعِ الأَدراسِ"
    },
    {
      "n": 2,
      "sadr": "فَلَعَلَّ عَينَكَ أَن تُعينَ بِمائِها",
      "ajuz": "وَالدَّمعُ مِنهُ خاذِلٌ وَمُواسِ"
    },
    {
      "n": 3,
      "sadr": "لا يُسعِدُ المُشتاقَ وَسنانُ الهَوى",
      "ajuz": "يَبِسُ المَدامِعِ بارِدُ الأَنفاسِ"
    },
    {
      "n": 4,
      "sadr": "إِنَّ المَنازِلَ ساوَرَتها فُرقَةٌ",
      "ajuz": "أَخلَت مِنَ الآرامِ كُلَّ كِناسِ"
    },
    {
      "n": 5,
      "sadr": "مِن كُلِّ ضاحِكَةِ التَّرائِبِ أُرهِفَت",
      "ajuz": "إِرهافَ خوطِ البانَةِ المَيّاسِ"
    },
    {
      "n": 6,
      "sadr": "بَدرٌ أَطاعَت فيكَ بادِرَةَ النَّوى",
      "ajuz": "وَلَعاً وَشَمسٌ أولِعَت بِشِماسِ"
    },
    {
      "n": 7,
      "sadr": "بِكرٌ إِذا اِبتَسَمَت أَراكَ وَميضُها",
      "ajuz": "نَورَ الأَقاحي في ثَرىً ميعاسِ"
    },
    {
      "n": 8,
      "sadr": "وَإِذا مَشَت تَرَكَت بِصَدرِكَ ضِعفَ ما",
      "ajuz": "بِحُلِيِّها مِن كَثرَةِ الوَسواسِ"
    },
    {
      "n": 9,
      "sadr": "قالَت وَقَد حُمَّ الفِراقُ فَكَأسُهُ",
      "ajuz": "قَد خولِطَ الساقي بِها وَالحاسي"
    },
    {
      "n": 10,
      "sadr": "لا تَنسَيَنَّ تِلكَ العُهودَ فَإِنَّما",
      "ajuz": "سُمّيتَ إِنساناً لِأَنَّكَ ناسي"
    },
    {
      "n": 11,
      "sadr": "إِنَّ الَّذي خَلَقَ الخَلائِقَ قاتَها",
      "ajuz": "أَقواتَها لِتَصَرُّفِ الأَحراسِ"
    },
    {
      "n": 12,
      "sadr": "فَالأَرضُ مَعروفُ السَّماءِ قِرىً لَها",
      "ajuz": "وَبَنو الرَّجاءِ لَهُم بَنو العَبّاسِ"
    },
    {
      "n": 13,
      "sadr": "القَومُ ظِلُّ اللَّهِ أَسكَنَ دينَهُ",
      "ajuz": "فيهِم وَهُم جَبَلُ المُلوكِ الراسي"
    },
    {
      "n": 14,
      "sadr": "في كُلِّ جَوهَرَةٍ فِرِندٌ مُشرِقٌ",
      "ajuz": "وَهُمُ الفِرِندُ لِهَؤُلاءِ النّاسِ"
    },
    {
      "n": 15,
      "sadr": "هَدَأَت عَلى تَأميلِ أَحمَدَ هِمَّتي",
      "ajuz": "وَأَطافَ تَقليدي بِهِ وَقِياسي"
    },
    {
      "n": 16,
      "sadr": "بِالمُجتَبى وَالمُصطَفى وَالمُستَرى",
      "ajuz": "لِلحَمدِ وَالحالي بِهِ وَالكاسي"
    },
    {
      "n": 17,
      "sadr": "وَالحَمدُ بُردُ جَمالٍ اِختالَت بِهِ",
      "ajuz": "غُرَرُ الفَعالِ وَلَيسَ بُردَ لِباسِ"
    },
    {
      "n": 18,
      "sadr": "فَرعٌ نَما مِن هاشِمٍ في تُربَةٍ",
      "ajuz": "كانَ الكَفيءَ لَها مِنَ الأَغراسِ"
    },
    {
      "n": 19,
      "sadr": "لا تَهجُرُ الأَنواءُ مَنبِتَها وَلا",
      "ajuz": "قَلبُ الثَّرى القاسي عَلَيها قاسي"
    },
    {
      "n": 20,
      "sadr": "وَكَأَنَّ بَينَهُما رَضاعَ الثَّدي مِن",
      "ajuz": "فَرطِ التَّصافي أَو رَضاعَ الكاسِ"
    },
    {
      "n": 21,
      "sadr": "نَورُ العَرارَةِ نَورُهُ وَنَسيمُهُ",
      "ajuz": "نَشرُ الخُزامى في اِخضِرارِ الآسِ"
    },
    {
      "n": 22,
      "sadr": "أَبلَيتَ هَذا المَجدَ أَبعَدَ غايَةٍ",
      "ajuz": "فيهِ وَأَكرَمَ شيمَةٍ وَنِحاسِ"
    },
    {
      "n": 23,
      "sadr": "إِقدامُ عَمرٍو في سَماحَةِ حاتِمٍ",
      "ajuz": "في حِلمِ أَحنَفَ في ذَكاءِ إِياسِ"
    },
    {
      "n": 24,
      "sadr": "لا تُنكِروا ضَربي لَهُ مِن دونِهِ",
      "ajuz": "مَثَلاً شَروداً في النَّدى وَالباسِ"
    },
    {
      "n": 25,
      "sadr": "فَاللَّهُ قَد ضَرَبَ الأَقَلَّ لِنورِهِ",
      "ajuz": "مَثَلاً مِنَ المِشكاةِ وَالنِّبراسِ"
    },
    {
      "n": 26,
      "sadr": "إِن تَحوِ خَصلَ المَجدِ في أَنفِ الصِّبا",
      "ajuz": "يا اِبنَ الخَليفَةِ يا أَبا العَبّاسِ"
    },
    {
      "n": 27,
      "sadr": "فَلَرُبَّ نارٍ مِنكُمُ قَد أُنتِجَت",
      "ajuz": "في اللَّيلِ مِن قَبَسٍ مِنَ الأَقباسِ"
    },
    {
      "n": 28,
      "sadr": "وَلَرُبَّ كِفلٍ في الخُطوبِ تَرَكتَهُ",
      "ajuz": "لِصِعابِها حِلساً مِنَ الأَحلاسِ"
    },
    {
      "n": 29,
      "sadr": "أَمدَدتَهُ في العُدمِ وَالعُدمُ الجَوى",
      "ajuz": "بِالجودِ وَالجودُ الطَّبيبُ الآسي"
    },
    {
      "n": 30,
      "sadr": "آنَستَهُ بِالدَّهرِ حَتّى إِنَّهُ",
      "ajuz": "لَيَظُنُّهُ عُرساً مِنَ الأَعراسِ"
    },
    {
      "n": 31,
      "sadr": "غَلَبَ السُّرورُ عَلى هُمومي بِالَّذي",
      "ajuz": "أَظهَرتَ مِن بِرّي وَمِن إيناسي"
    },
    {
      "n": 32,
      "sadr": "عَدَلَ المَشيبُ عَلى الشَّبابِ وَلَم يَكُن",
      "ajuz": "مِن كَبرَةٍ لَكِنَّهُ مِن ياسِ"
    },
    {
      "n": 33,
      "sadr": "أَثَرُ المَطالِبِ في الفُؤادِ وَإِنَّما",
      "ajuz": "أَثَرُ السِّنينَ وَوَسمُها في الرّاسِ"
    },
    {
      "n": 34,
      "sadr": "فَالآنَ حينَ غَرَستُ في كَرَمِ الثَّرى",
      "ajuz": "تِلكَ المُنى وَبَنَيتُ فَوقَ أَساسِ"
    }
  ]
}
