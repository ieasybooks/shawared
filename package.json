{
  "name": "shawared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run content:build && bun run --cwd apps/app dev",
    "web:build": "bun run content:build && bun run --cwd apps/app export:web",
    "web:serve": "caddy run --config Caddyfile --adapter caddyfile",
    "content:check": "bun scripts/check.ts",
    "content:build": "bun scripts/build-content.ts",
    "content:preview": "bun scripts/preview.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/app/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "bun run content:check && bun run typecheck && bun run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@shawared/contracts": "workspace:*",
    "@shawared/design": "workspace:*",
    "@shawared/listening": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/node": "24",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
