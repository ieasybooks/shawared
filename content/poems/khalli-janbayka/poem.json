{
  "id": "khalli-janbayka",
  "poet": "abu-nuwas",
  "title": "خَلِّ جَنبَيكَ لِرامٍ",
  "meter": "ramal",
  "rawiy": "م",
  "abyat_in_full": 9,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "خَلِّ جَنبَيكَ لِرامٍ",
      "ajuz": "وَامضِ عَنهُ بِسَلامِ"
    },
    {
      "n": 2,
      "sadr": "مُت بِداءِ الصَّمتِ خَيرٌ",
      "ajuz": "لَكَ مِن داءِ الكَلامِ"
    },
    {
      "n": 3,
      "sadr": "رُبَّما اِستَفتَحتَ بِالمَز",
      "ajuz": "حِ مَغاليقَ الحِمامِ"
    },
    {
      "n": 4,
      "sadr": "رُبَّ لَفظٍ ساقَ آجا",
      "ajuz": "لَ فِئامٍ وَفِئامِ"
    },
    {
      "n": 5,
      "sadr": "إِنَّما السّالِمُ مَن أَل",
      "ajuz": "جَمَ فاهُ بِلِجامِ"
    },
    {
      "n": 6,
      "sadr": "فَالبَسِ النّاسَ عَلى الصِّح",
      "ajuz": "حَةِ مِنهُم وَالسَّقامِ"
    },
    {
      "n": 7,
      "sadr": "وَعَلَيكَ القَصدَ إِنَّ ال",
      "ajuz": "قَصدَ أَبقى لِلجِمامِ"
    },
    {
      "n": 8,
      "sadr": "شِبتَ يا هَذا وَما تَت",
      "ajuz": "رُكُ أَخلاقَ الغُلامِ"
    },
    {
      "n": 9,
      "sadr": "وَالمَنايا آكِلاتٌ",
      "ajuz": "شارِباتٌ لِلأَنامِ"
    }
  ]
}
