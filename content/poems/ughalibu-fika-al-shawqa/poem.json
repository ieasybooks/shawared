{
  "id": "ughalibu-fika-al-shawqa",
  "poet": "al-mutanabbi",
  "title": "أُغالِبُ فيكَ الشَّوقَ وَالشَّوقُ أَغلَبُ",
  "meter": "tawil",
  "themes": ["madh"],
  "rawiy": "ب",
  "abyat_in_full": 47,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أُغالِبُ فيكَ الشَّوقَ وَالشَّوقُ أَغلَبُ",
      "ajuz": "وَأَعجَبُ مِن ذا الهَجرِ وَالوَصلُ أَعجَبُ"
    },
    {
      "n": 2,
      "sadr": "أَما تَغلَطُ الأَيّامُ فِيَّ بِأَن أَرى",
      "ajuz": "بَغيضاً تُنائي أَو حَبيباً تُقَرِّبُ"
    },
    {
      "n": 3,
      "sadr": "وَلِلَّهِ سَيري ما أَقَلَّ تَئِيَّةً",
      "ajuz": "عَشِيَّةَ شَرقِيَّ الحَدالى وَغُرَّبُ"
    },
    {
      "n": 4,
      "sadr": "عَشِيَّةَ أَحفى النّاسِ بي مَن جَفَوتُهُ",
      "ajuz": "وَأَهدى الطَّريقَينِ الَّتي أَتَجَنَّبُ"
    },
    {
      "n": 5,
      "sadr": "وَكَم لِظَلامِ اللَّيلِ عِندَكَ مِن يَدٍ",
      "ajuz": "تُخَبِّرُ أَنَّ المانَوِيَّةَ تَكذِبُ"
    },
    {
      "n": 6,
      "sadr": "وَقاكَ رَدى الأَعداءِ تَسري إِلَيهِمُ",
      "ajuz": "وَزارَكَ فيهِ ذو الدَّلالِ المُحَجَّبُ"
    },
    {
      "n": 7,
      "sadr": "وَيَومٍ كَلَيلِ العاشِقينَ كَمَنتُهُ",
      "ajuz": "أُراقِبُ فيهِ الشَّمسَ أَيّانَ تَغرُبُ"
    },
    {
      "n": 8,
      "sadr": "وَعَيني إِلى أُذنَي أَغَرَّ كَأَنَّهُ",
      "ajuz": "مِنَ اللَّيلِ باقٍ بَينَ عَينَيهِ كَوكَبُ"
    },
    {
      "n": 9,
      "sadr": "لَهُ فَضلَةٌ عَن جِسمِهِ في إِهابِهِ",
      "ajuz": "تَجيءُ عَلى صَدرٍ رَحيبٍ وَتَذهَبُ"
    },
    {
      "n": 10,
      "sadr": "شَقَقتُ بِهِ الظَّلماءَ أُدني عِنانَهُ",
      "ajuz": "فَيَطغى وَأُرخيهِ مِراراً فَيَلعَبُ"
    },
    {
      "n": 11,
      "sadr": "وَأَصرَعُ أَيَّ الوَحشِ قَفَّيتُهُ بِهِ",
      "ajuz": "وَأَنزِلُ عَنهُ مِثلَهُ حينَ أَركَبُ"
    },
    {
      "n": 12,
      "sadr": "وَما الخَيلُ إِلّا كَالصَّديقِ قَليلَةٌ",
      "ajuz": "وَإِن كَثُرَت في عَينِ مَن لا يُجَرِّبُ"
    },
    {
      "n": 13,
      "sadr": "إِذا لَم تُشاهِد غَيرَ حُسنِ شِياتِها",
      "ajuz": "وَأَعضائِها فَالحُسنُ عَنكَ مُغَيَّبُ"
    },
    {
      "n": 14,
      "sadr": "لَحا اللَّهُ ذي الدُّنيا مُناخاً لِراكِبٍ",
      "ajuz": "فَكُلُّ بَعيدِ الهَمِّ فيها مُعَذَّبُ"
    },
    {
      "n": 15,
      "sadr": "أَلا لَيتَ شِعري هَل أَقولُ قَصيدَةً",
      "ajuz": "فَلا أَشتَكي فيها وَلا أَتَعَتَّبُ"
    },
    {
      "n": 16,
      "sadr": "وَبي ما يَذودُ الشِّعرَ عَنّي أَقَلُّهُ",
      "ajuz": "وَلَكِنَّ قَلبي يا اِبنَةَ القَومِ قُلَّبُ"
    },
    {
      "n": 17,
      "sadr": "وَأَخلاقُ كافورٍ إِذا شِئتُ مَدحَهُ",
      "ajuz": "وَإِن لَم أَشَأ تُملي عَلَيَّ وَأَكتُبُ"
    },
    {
      "n": 18,
      "sadr": "إِذا تَرَكَ الإِنسانُ أَهلاً وَراءَهُ",
      "ajuz": "وَيَمَّمَ كافوراً فَما يَتَغَرَّبُ"
    },
    {
      "n": 19,
      "sadr": "فَتىً يَملَأُ الأَفعالَ رَأياً وَحِكمَةً",
      "ajuz": "وَنادِرَةً أَحيانَ يَرضى وَيَغضَبُ"
    },
    {
      "n": 20,
      "sadr": "إِذا ضَرَبَت في الحَربِ بِالسَّيفِ كَفُّهُ",
      "ajuz": "تَبَيَّنتَ أَنَّ السَّيفَ بِالكَفِّ يَضرِبُ"
    },
    {
      "n": 21,
      "sadr": "تَزيدُ عَطاياهُ عَلى اللَّبثِ كَثرَةً",
      "ajuz": "وَتَلبَثُ أَمواهُ السَّحابِ فَتَنضَبُ"
    },
    {
      "n": 22,
      "sadr": "أَبا المِسكِ هَل في الكَأسِ فَضلٌ أَنالُهُ",
      "ajuz": "فَإِنّي أُغَنّي مُنذُ حينٍ وَتَشرَبُ"
    },
    {
      "n": 23,
      "sadr": "وَهَبتَ عَلى مِقدارِ كَفَّي زَمانِنا",
      "ajuz": "وَنَفسي عَلى مِقدارِ كَفَّيكَ تَطلُبُ"
    },
    {
      "n": 24,
      "sadr": "إِذا لَم تَنُط بي ضَيعَةً أَو وِلايَةً",
      "ajuz": "فَجودُكَ يَكسوني وَشُغلُكَ يَسلُبُ"
    },
    {
      "n": 25,
      "sadr": "يُضاحِكُ في ذا العيدِ كُلٌّ حَبيبَهُ",
      "ajuz": "حِذائي وَأَبكي مَن أُحِبُّ وَأَندُبُ"
    },
    {
      "n": 26,
      "sadr": "أَحِنُّ إِلى أَهلي وَأَهوى لِقاءَهُم",
      "ajuz": "وَأَينَ مِنَ المُشتاقِ عَنقاءُ مُغرِبُ"
    },
    {
      "n": 27,
      "sadr": "فَإِن لَم يَكُن إِلّا أَبو المِسكِ أَو هُمُ",
      "ajuz": "فَإِنَّكَ أَحلى في فُؤادي وَأَعذَبُ"
    },
    {
      "n": 28,
      "sadr": "وَكُلُّ اِمرِئٍ يولي الجَميلَ مُحَبَّبٌ",
      "ajuz": "وَكُلُّ مَكانٍ يُنبِتُ العِزَّ طَيِّبُ"
    },
    {
      "n": 29,
      "sadr": "يُريدُ بِكَ الحُسّادُ ما اللَّهُ دافِعٌ",
      "ajuz": "وَسُمرُ العَوالي وَالحَديدُ المُذَرَّبُ"
    },
    {
      "n": 30,
      "sadr": "وَدونَ الَّذي يَبغونَ ما لَو تَخَلَّصوا",
      "ajuz": "إِلى المَوتِ مِنهُ عِشتَ وَالطِّفلُ أَشيَبُ"
    },
    {
      "n": 31,
      "sadr": "إِذا طَلَبوا جَدواكَ أُعطوا وَحُكِّموا",
      "ajuz": "وَإِن طَلَبوا الفَضلَ الَّذي فيكَ خُيِّبوا"
    },
    {
      "n": 32,
      "sadr": "وَلَو جازَ أَن يَحووا عُلاكَ وَهَبتَها",
      "ajuz": "وَلَكِن مِنَ الأَشياءِ ما لَيسَ يوهَبُ"
    },
    {
      "n": 33,
      "sadr": "وَأَظلَمُ أَهلِ الظُّلمِ مَن باتَ حاسِداً",
      "ajuz": "لِمَن باتَ في نَعمائِهِ يَتَقَلَّبُ"
    },
    {
      "n": 34,
      "sadr": "وَأَنتَ الَّذي رَبَّيتَ ذا المُلكِ مُرضَعاً",
      "ajuz": "وَلَيسَ لَهُ أُمٌّ سِواكَ وَلا أَبُ"
    },
    {
      "n": 35,
      "sadr": "وَكُنتَ لَهُ لَيثَ العَرينِ لِشِبلِهِ",
      "ajuz": "وَما لَكَ إِلّا الهِندُوانِيَّ مِخلَبُ"
    },
    {
      "n": 36,
      "sadr": "لَقيتَ القَنا عَنهُ بِنَفسٍ كَريمَةٍ",
      "ajuz": "إِلى المَوتِ في الهَيجا مِنَ العارِ تَهرُبُ"
    },
    {
      "n": 37,
      "sadr": "وَقَد يَترَكُ النَّفسَ الَّتي لا تَهابُهُ",
      "ajuz": "وَيَختَرِمُ النَّفسَ الَّتي تَتَهَيَّبُ"
    },
    {
      "n": 38,
      "sadr": "وَما عَدِمَ اللّاقوكَ بَأساً وَشِدَّةً",
      "ajuz": "وَلَكِنَّ مَن لاقَوا أَشَدُّ وَأَنجَبُ"
    },
    {
      "n": 39,
      "sadr": "ثَناهُم وَبَرقُ البيضِ في البَيضِ صادِقٌ",
      "ajuz": "عَلَيهِم وَبَرقُ البَيضِ في البيضِ خُلَّبُ"
    },
    {
      "n": 40,
      "sadr": "سَلَلتَ سُيوفاً عَلَّمَت كُلَّ خاطِبٍ",
      "ajuz": "عَلى كُلِّ عودٍ كَيفَ يَدعو وَيَخطُبُ"
    },
    {
      "n": 41,
      "sadr": "وَيُغنيكَ عَمّا يَنسُبُ النّاسُ أَنَّهُ",
      "ajuz": "إِلَيكَ تَناهى المَكرُماتُ وَتُنسَبُ"
    },
    {
      "n": 42,
      "sadr": "وَأَيُّ قَبيلٍ يَستَحِفُّكَ قَدرُهُ",
      "ajuz": "مَعَدُّ بنُ عَدنانَ فِداكَ وَيَعرُبُ"
    },
    {
      "n": 43,
      "sadr": "وَما طَرَبي لَمّا رَأَيتُكَ بِدعَةً",
      "ajuz": "لَقَد كُنتُ أَرجو أَن أَراكَ فَأَطرَبُ"
    },
    {
      "n": 44,
      "sadr": "وَتَعذِلُني فيكَ القَوافي وَهِمَّتي",
      "ajuz": "كَأَنّي بِمَدحٍ قَبلَ مَدحِكَ مُذنِبُ"
    },
    {
      "n": 45,
      "sadr": "وَلَكِنَّهُ طالَ الطَّريقُ وَلَم أَزَل",
      "ajuz": "أُفَتَّشُ عَن هَذا الكَلامِ وَيُنهَبُ"
    },
    {
      "n": 46,
      "sadr": "فَشَرَّقَ حَتّى لَيسَ لِلشَّرقِ مَشرِقٌ",
      "ajuz": "وَغَرَّبَ حَتّى لَيسَ لِلغَربِ مَغرِبُ"
    },
    {
      "n": 47,
      "sadr": "إِذا قُلتُهُ لَم يَمتَنِع مِن وُصولِهِ",
      "ajuz": "جِدارٌ مُعَلّى أَو خِباءٌ مُطَنَّبُ"
    }
  ]
}
