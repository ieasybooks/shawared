{
  "id": "maqsurat-ibn-durayd",
  "poet": "ibn-durayd",
  "title": "مَقصورَةُ اِبنِ دُرَيدٍ",
  "meter": "rajaz",
  "rawiy": "ا",
  "abyat_in_full": 255,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,   "sadr": "يا ظَبيَةً أَشبَهَ شَيءٍ بِالمَها",        "ajuz": "تَرعى الخُزامى بَينَ أَشجارِ النَّقا" },
    { "n": 2,   "sadr": "إِمّا تَرَي رَأسِيَ حاكى لَونُهُ",         "ajuz": "طُرَّةَ صُبحٍ تَحتَ أَذيالِ الدُّجى" },
    { "n": 3,   "sadr": "وَاشتَعَلَ المُبيَضُّ في مُسوَدِّهِ",      "ajuz": "مِثلَ اِشتِعالِ النّارِ في جَزلِ الغَضا" },
    { "n": 4,   "sadr": "فَكانَ كَاللَّيلِ البَهيمِ حَلَّ في",      "ajuz": "أَرجائِهِ ضَوءُ صَباحٍ فَانجَلى" },
    { "n": 5,   "sadr": "وَغاضَ ماءَ شِرَّتي دَهرٌ رَمى",           "ajuz": "خَواطِرَ القَلبِ بِتَبريحِ الجَوى" },
    { "n": 6,   "sadr": "وَآضَ رَوضُ اللَّهوِ يَبساً ذاوِياً",      "ajuz": "مِن بَعدِ ما قَد كانَ مَجّاجَ الثَّرى" },
    { "n": 7,   "sadr": "وَضَرَّمَ النَّأيُ المُشِتُّ جَذوَةً",     "ajuz": "ما تَأتَلي تَسفَعُ أَثناءَ الحَشا" },
    { "n": 8,   "sadr": "وَاتَّخَذَ التَّسهيدُ عَيني مَألَفاً",     "ajuz": "لَمّا جَفا أَجفانَها طَيفُ الكَرى" },
    { "n": 9,   "sadr": "فَكُلُّ ما لاقَيتُهُ مُغتَفَرٌ",           "ajuz": "في جَنبِ ما أَسأَرَهُ شَحطُ النَّوى" },
    { "n": 10,  "sadr": "لَو لابَسَ الصَّخرَ الأَصَمَّ بَعضُ ما",   "ajuz": "يَلقاهُ قَلبي فَضَّ أَصلادَ الصَّفا" },
    { "n": 11,  "sadr": "إِذا ذَوى الغُصنُ الرَّطيبُ فَاعلَمَن",    "ajuz": "أَنَّ قُصاراهُ نَفادٌ وَتَوى" },
    { "n": 12,  "sadr": "شَجيتُ لا بَل أَجرَضَتني غُصَّةٌ",         "ajuz": "عَنودُها أَقتَلُ لي مِنَ الشَّجا" },
    { "n": 13,  "sadr": "إِن يَحمِ عَن عَيني البُكا تَجَلُّدي",     "ajuz": "فَالقَلبُ مَوقوفٌ عَلى سُبلِ البُكا" },
    { "n": 14,  "sadr": "لَو كانَتِ الأَحلامُ ناجَتني بِما",        "ajuz": "أَلقاهُ يَقظانَ لَأَصماني الرَّدى" },
    { "n": 15,  "sadr": "مَنزِلَةٌ ما خِلتُها يَرضى بِها",          "ajuz": "لِنَفسِهِ ذو أَرَبٍ وَلا حِجا" },
    { "n": 16,  "sadr": "شَيمُ سَحابٍ خُلَّبٍ بارِقُهُ",            "ajuz": "وَمَوقِفٌ بَينَ اِرتِجاءٍ وَمُنى" },
    { "n": 17,  "sadr": "في كُلِّ يَومٍ مَنزِلٌ مُستَوبِلٌ",        "ajuz": "يَشتَفُّ ماءَ مُهجَتي أَو مُجتَوى" },
    { "n": 18,  "sadr": "ما خِلتُ أَنَّ الدَّهرَ يَثنيني عَلى",     "ajuz": "ضَرّاءَ لا يَرضى بِها ضَبُّ الكُدى" },
    { "n": 19,  "sadr": "أُرَمِّقُ العَيشَ عَلى بَرضٍ فَإِن",       "ajuz": "رُمتُ اِرتِشافاً رُمتُ صَعبَ المُنتَشى" },
    { "n": 20,  "sadr": "أَراجِعٌ لي الدَّهرُ حَولاً كامِلاً",      "ajuz": "إِلى الَّذي عَوَّدَ أَم لا يُرتَجى" },
    { "n": 21,  "sadr": "يا دَهرُ إِن لَم تَكُ عُتبى فَاتَّئِد",    "ajuz": "فَإِنَّ إِروادَكَ وَالعُتبى سَوا" },
    { "n": 22,  "sadr": "رَفِّه عَلَيَّ طالَما أَنصَبتَني",         "ajuz": "وَاستَبقِ بَعضَ ماءِ غُصنٍ مُلتَحى" },
    { "n": 23,  "sadr": "لا تَحسَبَن يا دَهرُ أَنّي ضارِعٌ",        "ajuz": "لِنَكبَةٍ تَعرُقُني عَرقَ المُدى" },
    { "n": 24,  "sadr": "مارَستَ مَن لَو هَوَتِ الأَفلاكُ مِن",     "ajuz": "جَوانِبِ الجَوِّ عَلَيهِ ما شَكا" },
    { "n": 25,  "sadr": "لَكِنَّها نَفثَةُ مَصدورٍ إِذا",           "ajuz": "جاشَ لُغامٌ مِن نَواحيها غَما" },
    { "n": 26,  "sadr": "رَضيتُ قَسراً وَعَلى القَسرِ رِضا",        "ajuz": "مَن كانَ ذا سُخطٍ عَلى صَرفِ القَضا" },
    { "n": 27,  "sadr": "إِنَّ الجَديدَينِ إِذا ما اِستَولَيا",     "ajuz": "عَلى جَديدٍ أَدنَياهُ لِلبِلى" },
    { "n": 28,  "sadr": "ما كُنتُ أَدري وَالزَّمانُ مولَعٌ",        "ajuz": "بِشَتِّ مَلمومٍ وَتَنكيثِ قُوى" },
    { "n": 29,  "sadr": "أَنَّ القَضاءَ قاذِفي في هُوَّةٍ",         "ajuz": "لا تَستَبِلُّ نَفسُ مَن فيها هَوى" },
    { "n": 30,  "sadr": "فَإِن عَثَرتُ بَعدَها إِن وَأَلَت",        "ajuz": "نَفسِيَ مِن هاتا فَقولا لا لَعا" },
    { "n": 31,  "sadr": "وَإِن تَكُن مُدَّتُها مَوصولَةً",          "ajuz": "بِالحَتفِ سَلَّطتُ الأُسا عَلى الأَسى" },
    { "n": 32,  "sadr": "إِنَّ اِمرَأَ القَيسِ جَرى إِلى مَدىً",    "ajuz": "فَاعتاقَهُ حِمامُهُ دونَ المَدى" },
    { "n": 33,  "sadr": "وَخامَرَت نَفسُ أَبي الجَبرِ الجَوى",      "ajuz": "حَتّى حَواهُ الحَتفُ فيمَن قَد حَوى" },
    { "n": 34,  "sadr": "وَابنُ الأَشَجِّ القَيلُ ساقَ نَفسَهُ",    "ajuz": "إِلى الرَّدى حِذارَ إِشماتِ العِدى" },
    { "n": 35,  "sadr": "وَاختَرَمَ الوَضّاحَ مِن دونِ الَّتي",     "ajuz": "أَمَّلَها سَيفُ الحِمامِ المُنتَضى" },
    { "n": 36,  "sadr": "فَقَد سَما قَبلي يَزيدٌ طالِباً",          "ajuz": "شَأوَ العُلا فَما وَهى وَلا وَنى" },
    { "n": 37,  "sadr": "فَاعتَرَضَت دونَ الَّذي رامَ وَقَد",       "ajuz": "جَدَّ بِهِ الجِدُّ اللُّهَيمُ الأُرَبى" },
    { "n": 38,  "sadr": "هَل أَنا بِدعٌ مِن عَرانينِ عُلاً",        "ajuz": "جارَ عَلَيهِم صَرفُ دَهرٍ وَاعتَدى" },
    { "n": 39,  "sadr": "فَإِن أَنالَتني المَقاديرُ الَّذي",        "ajuz": "أَكيدُهُ لَم آلُ في رَأبِ الثَّأى" },
    { "n": 40,  "sadr": "وَقَد سَما عَمرٌو إِلى أَوتارِهِ",         "ajuz": "فَاحتَطَّ مِنها كُلَّ عالي المُستَمى" },
    { "n": 41,  "sadr": "فَاستَنزَلَ الزَّبّاءَ قَسراً وَهيَ مِن",  "ajuz": "عُقابِ لوحِ الجَوِّ أَعلى مُنتَمى" },
    { "n": 42,  "sadr": "وَسَيفٌ اِستَعلَت بِهِ هِمَّتُهُ",         "ajuz": "حَتّى رَمى أَبعَدَ شَأوِ المُرتَمى" },
    { "n": 43,  "sadr": "فَجَرَّعَ الأُحبوشَ سُمّاً ناقِعاً",       "ajuz": "وَاحتَلَّ مِن غُمدانَ مِحرابَ الدُّمى" },
    { "n": 44,  "sadr": "ثُمَّ اِبنُ هِندٍ باشَرَت نيرانُهُ",       "ajuz": "يَومَ أُواراتٍ تَميماً بِالصَّلى" },
    { "n": 45,  "sadr": "ما اِعتَنَّ لي يَأسٌ يُناجي هِمَّتي",      "ajuz": "إِلّا تَحَدّاهُ رَجاءٌ فَاكتَمى" },
    { "n": 46,  "sadr": "أَلِيَّةً بِاليَعمَلاتِ يَرتَمي",          "ajuz": "بِها النَّجاءُ بَينَ أَجوازِ الفَلا" },
    { "n": 47,  "sadr": "خوصٍ كَأَشباحِ الحَنايا ضُمَّرٍ",          "ajuz": "يَرعُفنَ بِالأَمشاجِ مِن جَذبِ البُرى" },
    { "n": 48,  "sadr": "يَرسُبنَ في بَحرِ الدُّجى وَبِالضُّحى",    "ajuz": "يَطفونَ في الآلِ إِذا الآلُ طَفا" },
    { "n": 49,  "sadr": "أَخفافُهُنَّ مِن حَفاً وَمِن وَجىً",       "ajuz": "مَرثومَةٌ تَخضِبُ مُبيَضَّ الحَصى" },
    { "n": 50,  "sadr": "يَحمِلنَ كُلَّ شاحِبٍ مُحقَوقِفٍ",         "ajuz": "مِن طولِ تَدآبِ الغُدُوِّ وَالسُّرى" },
    { "n": 51,  "sadr": "بَرٍّ بَرى طولُ الطَّوى جُثمانَهُ",        "ajuz": "فَهوَ كَقِدحِ النَّبعِ مَحنِيُّ القَرا" },
    { "n": 52,  "sadr": "يَنوي الَّتي فَضَّلَها رَبُّ العُلا",      "ajuz": "لَمّا دَحا تُربَتَها عَلى البُنى" },
    { "n": 53,  "sadr": "حَتّى إِذا قابَلَها اِستَعبَرَ لا",        "ajuz": "يَملِكُ دَمعَ العَينِ مِن حَيثُ جَرى" },
    { "n": 54,  "sadr": "ثُمَّتَ طافَ وَانثَنى مُستَلِماً",         "ajuz": "ثُمَّتَ جاءَ المَروَتَينِ فَسَعى" },
    { "n": 55,  "sadr": "وَأَوجَبَ الحَجَّ وَثَنّى عُمرَةً",        "ajuz": "مِن بَعدِ ما عَجَّ وَلَبّى وَدَعا" },
    { "n": 56,  "sadr": "ثُمَّتَ راحَ في المُلَبّينَ إِلى",         "ajuz": "حَيثُ تَحَجّى المَأزِمانِ وَمِنى" },
    { "n": 57,  "sadr": "ثُمَّ أَتى التَّعريفَ يَقرو مُخبِتاً",     "ajuz": "مَواقِفاً بَينَ أَلالٍ فَالنَّقا" },
    { "n": 58,  "sadr": "وَاستَأنَفَ السَّبعَ وَسَبعاً بَعدَها",    "ajuz": "وَالسَّبعُ ما بَينَ العِقابِ وَالصُّوى" },
    { "n": 59,  "sadr": "وَراحَ لِلتَّوديعِ فيمَن راحَ قَد",        "ajuz": "أَحرَزَ أَجراً وَقَلى هُجرَ اللَّغا" },
    { "n": 60,  "sadr": "بِذاكَ أَم بِالخَيلِ تَعدو المَرَطى",      "ajuz": "ناشِزَةً أَكتادُها قُبَّ الكُلى" },
    { "n": 61,  "sadr": "شُعثاً تَعادى كَسَراحينِ الغَضا",          "ajuz": "ميلَ الحَماليقِ يُبارينَ الشَّبا" },
    { "n": 62,  "sadr": "يَحمِلنَ كُلَّ شَمَّرِيٍّ باسِلٍ",         "ajuz": "شَهمِ الجَنانِ خائِضٍ غَمرَ الوَغى" },
    { "n": 63,  "sadr": "يَغشى صَلى الحَربِ بِخَدَّيهِ إِذا",       "ajuz": "كانَ لَظى الحَربِ كَريهَ المُصطَلى" },
    { "n": 64,  "sadr": "لَو مُثِّلَ الحَتفُ لَهُ قِرناً لَما",     "ajuz": "صَدَّتهُ عَنهُ هَيبَةٌ وَلا اِنثَنى" },
    { "n": 65,  "sadr": "وَلَو حَمى المِقدارُ عَنهُ مُهجَةً",       "ajuz": "لَرامَها أَو يَستَبيحَ ما حَمى" },
    { "n": 66,  "sadr": "تَغدو المَنايا طائِعاتٍ أَمرَهُ",          "ajuz": "تَرضى الَّذي يَرضى وَتَأبى ما أَبى" },
    { "n": 67,  "sadr": "بَل قَسَماً بِالشُّمِّ مِن يَعرُبَ هَل",   "ajuz": "لِمُقسِمٍ مِن بَعدِ هَذا مُنتَهى" },
    { "n": 68,  "sadr": "هُمُ الأُلى إِن فاخَروا قالَ العُلا",      "ajuz": "بِفي اِمرِئٍ فاخَرَكُم عَفرُ البَرى" },
    { "n": 69,  "sadr": "هُمُ الأُلى أَجرَوا يَنابيعَ النَّدى",     "ajuz": "هامِيَةً لِمَن عَرا أَوِ اِعتَفى" },
    { "n": 70,  "sadr": "هُمُ الَّذينَ دَوَّخوا مَنِ اِنتَخى",      "ajuz": "وَقَوَّموا مِن صَعَرٍ وَمَن صَغا" },
    { "n": 71,  "sadr": "هُمُ الَّذينَ جَرَّعوا مَن ماحَلوا",       "ajuz": "أَفاوِقَ الضَّيمِ مُمَرّاتِ الحُسا" },
    { "n": 72,  "sadr": "أَزالُ حَشوَ نَثرَةٍ مَوضونَةٍ",           "ajuz": "حَتّى أُوارى بَينَ أَثناءِ الجُثا" },
    { "n": 73,  "sadr": "وَصاحِبَيَّ صارِمٌ في مَتنِهِ",             "ajuz": "مِثلُ مَدَبِّ النَّملِ يَعلو في الرُّبا" },
    { "n": 74,  "sadr": "أَبيَضُ كَالمِلحِ إِذا اِنتَضَيتَهُ",      "ajuz": "لَم يَلقَ شَيئاً حَدُّهُ إِلّا فَرى" },
    { "n": 75,  "sadr": "كَأَنَّ بَينَ عَيرِهِ وَغَربِهِ",          "ajuz": "مُفتَأَداً تَأَكَّلَت فيهِ الجُذا" },
    { "n": 76,  "sadr": "يُري المَنونَ حينَ تَقفو أَثرَهُ",         "ajuz": "في ظُلَمِ الأَكبادِ سُبلاً لا تُرى" },
    { "n": 77,  "sadr": "إِذا هَوى في جُثَّةٍ غادَرَها",            "ajuz": "مِن بَعدِ ما كانَت خَساً وَهيَ زَكا" },
    { "n": 78,  "sadr": "وَمُشرِفُ الأَقطارِ خاظٍ نَحضُهُ",         "ajuz": "حابي القُصَيرى جُرشُعٌ عَردُ النَّسا" },
    { "n": 79,  "sadr": "قَريبُ ما بَينَ القَطاةِ وَالمَطا",        "ajuz": "بَعيدُ ما بَينَ القَذالِ وَالصَّلا" },
    { "n": 80,  "sadr": "سامي التَّليلِ في دَسيعٍ مُفعَمٍ",         "ajuz": "رَحبُ اللَّبانِ في أَميناتِ العُجى" },
    { "n": 81,  "sadr": "رُكِّبنَ في حَواشِبٍ مُكتَنَّةٍ",          "ajuz": "إِلى نُسورٍ مِثلِ مَلفوظِ النَّوى" },
    { "n": 82,  "sadr": "يَرضَخُ بِالبيدِ الحَصى فَإِن رَقا",       "ajuz": "إِلى الرُّبا أَورى بِها نارَ الحُبا" },
    { "n": 83,  "sadr": "يُديرُ إِعليطَينِ في مَلمومَةٍ",           "ajuz": "إِلى لَموحَينِ بِأَلحاظِ اللَّأى" },
    { "n": 84,  "sadr": "مُداخِلُ الخَلقِ رَحيبٌ شَجرُهُ",          "ajuz": "مُخلَولِقُ الصَّهوَةِ مَمسودٌ وَأى" },
    { "n": 85,  "sadr": "لا صَكَكٌ يَشينُهُ وَلا فَجاً",            "ajuz": "وَلا دَخيسٌ واهِنٌ وَلا شَظى" },
    { "n": 86,  "sadr": "لَوِ اِعتَسَفتَ الأَرضَ فَوقَ مَتنِهِ",    "ajuz": "يَجوبُها ما خِفتَ أَن يَشكو الوَجى" },
    { "n": 87,  "sadr": "يَجري فَتَكبو الرّيحُ في غاياتِهِ",        "ajuz": "حَسرى تَلوذُ بِجَراثيمِ السَّحا" },
    { "n": 88,  "sadr": "تَظُنُّهُ وَهوَ يُرى مُحتَجِباً",          "ajuz": "عَنِ العُيونِ إِن ذَأى وَإِن رَدى" },
    { "n": 89,  "sadr": "إِذا اِجتَهَدتَ نَظَراً في إِثرِهِ",       "ajuz": "قُلتَ سَناً أَومَضَ أَو بَرقٌ خَفا" },
    { "n": 90,  "sadr": "كَأَنَّما الجَوزاءُ في أَرساغِهِ",         "ajuz": "وَالنَّجمُ في جَبهَتِهِ إِذا بَدا" },
    { "n": 91,  "sadr": "هُما عَتادي الكافِيانِ فَقدَ مَن",         "ajuz": "أَعدَدتُهُ فَليَنأَ عَنّي مَن نَأى" },
    { "n": 92,  "sadr": "فَإِن سَمِعتَ بِرَحىً مَنصوبَةٍ",          "ajuz": "لِلحَربِ فَاعلَم أَنَّني قُطبُ الرَّحى" },
    { "n": 93,  "sadr": "وَإِن رَأَيتَ نارَ حَربٍ تَلتَظي",         "ajuz": "فَاعلَم بِأَنّي مُسعِرٌ ذاكَ اللَّظى" },
    { "n": 94,  "sadr": "خَيرُ النُّفوسِ السّائِلاتُ جَهرَةً",      "ajuz": "عَلى ظُباتِ المُرهَفاتِ وَالقَنا" },
    { "n": 95,  "sadr": "إِنَّ العِراقَ لَم أُفارِق أَهلَهُ",       "ajuz": "عَن شَنَأٍ أَصَدَّني وَلا قِلى" },
    { "n": 96,  "sadr": "وَلا اِطَّبى عَينَيَّ مُذ فارَقتُهُم",     "ajuz": "شَيءٌ يَروقُ الطَّرفَ مِن هَذا الوَرى" },
    { "n": 97,  "sadr": "هُمُ الشَّناخيبُ المُنيفاتُ الذُّرا",      "ajuz": "وَالنّاسُ أَدحالٌ سِواهُم وَهُوى" },
    { "n": 98,  "sadr": "هُمُ البُحورُ زاخِرٌ آذِيُّها",            "ajuz": "وَالنّاسُ ضَحضاحٌ ثِغابٌ وَأَضا" },
    { "n": 99,  "sadr": "إِن كُنتُ أَبصَرتُ لَهُم مِن بَعدِهِم",    "ajuz": "مِثلاً فَأَغضَيتُ عَلى وَخزِ السَّفا" },
    { "n": 100, "sadr": "حاشا الأَميرَينِ اللَّذَينِ أَوفَدا",      "ajuz": "عَلَيَّ ظِلّاً مِن نَعيمٍ قَد ضَفا" },
    { "n": 101, "sadr": "هُما اللَّذانِ أَثبَتا لي أَمَلاً",        "ajuz": "قَد وَقَفَ اليَأسُ بِهِ عَلى شَفا" },
    { "n": 102, "sadr": "تَلافَيا العَيشَ الَّذي رَنَّقَهُ",        "ajuz": "صَرفُ الزَّمانِ فَاستَساغَ وَصَفا" },
    { "n": 103, "sadr": "وَأَجرَيا ماءَ الحَيا لي رَغَداً",         "ajuz": "فَاهتَزَّ غُصني بَعدَ ما كانَ ذَوى" },
    { "n": 104, "sadr": "هُما اللَّذانِ سَمَوا بِناظِري",           "ajuz": "مِن بَعدِ إِغضائي عَلى لَذعِ القَذى" },
    { "n": 105, "sadr": "هُما اللَّذانِ عَمَّرا لي جانِباً",        "ajuz": "مِنَ الرَّجاءِ كانَ قِدماً قَد عَفا" },
    { "n": 106, "sadr": "وَقَلَّداني مِنَّةً لَو قُرِنَت",          "ajuz": "بِشُكرِ أَهلِ الأَرضِ عَنّي ما وَفى" },
    { "n": 107, "sadr": "بِالعُشرِ مِن مِعشارِها وَكانَ كَال",           "ajuz": "حَسوَةِ في آذِيِّ بَحرٍ قَد طَما" },
    { "n": 108, "sadr": "إِنَّ اِبنَ ميكالَ الأَميرَ اِنتاشَني",    "ajuz": "مِن بَعدِ ما قَد كُنتُ كَالشَّيءِ اللَّقى" },
    { "n": 109, "sadr": "وَمَدَّ ضَبعَيَّ أَبو العَبّاسِ مِن",      "ajuz": "بَعدِ اِنقِباضِ الذَّرعِ وَالباعِ الوَزى" },
    { "n": 110, "sadr": "ذاكَ الَّذي ما زالَ يَسمو لِلعُلا",        "ajuz": "بِفِعلِهِ حَتّى عَلا فَوقَ العُلا" },
    { "n": 111, "sadr": "لَو كانَ يَرقى أَحَدٌ بِجودِهِ",           "ajuz": "وَمَجدِهِ إِلى السَّماءِ لَارتَقى" },
    { "n": 112, "sadr": "ما إِن أَتى بَحرَ نَداهُ مُعتَفٍ",         "ajuz": "عَلى أُوارِ عَيمَةٍ إِلّا اِرتَوى" },
    { "n": 113, "sadr": "نَفسي الفِداءُ لِأَميرَيَّ وَمَن",         "ajuz": "تَحتَ السَّماءِ لِأَميرَيَّ الفِدى" },
    { "n": 114, "sadr": "لا زالَ شُكري لَهُما مُواصِلاً",           "ajuz": "لَفظِيَ أَو يَعتاقَني صَرفُ المَنا" },
    { "n": 115, "sadr": "إِنَّ الأُلى فارَقتُ مِن غَيرِ قِلىً",     "ajuz": "ما زاغَ قَلبي عَنهُمُ وَلا هَفا" },
    { "n": 116, "sadr": "لَكِنَّ لي عَزماً إِذا اِمتَطَيتُهُ",      "ajuz": "لِمُبهَمِ الخَطبِ فَآهُ فَانفَأى" },
    { "n": 117, "sadr": "وَلَو أَشاءُ مَدَّ قُطرَيهِ الصِّبا",      "ajuz": "عَلَيَّ في ظِلِّ نَعيمٍ وَغِنى" },
    { "n": 118, "sadr": "وَلاعَبَتني غادَةٌ وَهنانَةٌ",             "ajuz": "تُضني وَفي تَرشافِها بُرءُ الضَّنى" },
    { "n": 119, "sadr": "تَفري بِسَيفِ لَحظِها إِن نَظَرَت",        "ajuz": "نَظرَةَ غَضبى مِنكَ أَثناءَ الحَشا" },
    { "n": 120, "sadr": "في خَدِّها رَوضٌ مِنَ الوَردِ عَلى",       "ajuz": "النِّسرينِ بِالأَلحاظِ مِنها يُجتَنى" },
    { "n": 121, "sadr": "لَو ناجَتِ الأَعصَمَ لَانحَطَّ لَها",      "ajuz": "طَوعَ القِيادِ مِن شَماريخِ الذُّرا" },
    { "n": 122, "sadr": "أَو صابَتِ القانِتَ في مُخلَولِقٍ",        "ajuz": "مُستَصعَبِ المَسلَكِ وَعرِ المُرتَقى" },
    { "n": 123, "sadr": "أَلهاهُ عَن تَسبيحِهِ وَدينِهِ",           "ajuz": "تَأنيسُها حَتّى تَراهُ قَد صَبا" },
    { "n": 124, "sadr": "كَأَنَّما الصَّهباءُ مَقطوبٌ بِها",        "ajuz": "ماءُ جَنى وَردٍ إِذا اللَّيلُ عَسا" },
    { "n": 125, "sadr": "يَمتاحُهُ راشِفُ بَردِ ريقِها",            "ajuz": "بَينَ بَياضِ الظَّلمِ مِنها وَاللَّمى" },
    { "n": 126, "sadr": "سَقى العَقيقَ فَالحَزيزَ فَالمَلا",        "ajuz": "إِلى النَّحيتِ فَالقُرَيّاتِ الدُّنى" },
    { "n": 127, "sadr": "فَالمِربَدِ الأَعلى الَّذي تَلقى بِهِ",    "ajuz": "مَصارِعَ الأُسدِ بِأَلحاظِ المَها" },
    { "n": 128, "sadr": "مَحَلَّ كُلِّ مُقرَمٍ سَمَت بِهِ",         "ajuz": "مَآثِرُ الآباءِ في فَرعِ العُلا" },
    { "n": 129, "sadr": "مِنَ الأُلى جَوهَرُهُم إِذا اِعتَزَوا",    "ajuz": "مِن جَوهَرٍ مِنهُ النَّبِيُّ المُصطَفى" },
    { "n": 130, "sadr": "صَلّى عَلَيهِ اللَّهُ ما جَنَّ الدُّجى",   "ajuz": "وَما جَرَت في فَلَكٍ شَمسُ الضُّحى" },
    { "n": 131, "sadr": "جَونٌ أَعارَتهُ الجَنوبُ جانِباً",         "ajuz": "مِنها وَواصَت صَوبَهُ يَدُ الصَّبا" },
    { "n": 132, "sadr": "نَأى يَمانِياً فَلَمّا اِنتَشَرَت",        "ajuz": "أَحضانُهُ وَامتَدَّ كِسراهُ غَطا" },
    { "n": 133, "sadr": "فَجَلَّلَ الأُفقَ فَكُلُّ جانِبٍ",         "ajuz": "مِنها كَأَن مِن قُطرِهِ المُزنُ حَبا" },
    { "n": 134, "sadr": "وَطَبَّقَ الأَرضَ فَكُلُّ بُقعَةٍ",        "ajuz": "مِنها تَقولُ الغَيثُ في هاتا ثَوى" },
    { "n": 135, "sadr": "إِذا خَبَت بُروقُهُ عَنَّت لَها",          "ajuz": "ريحُ الصَّبا تَشُبُّ مِنها ما خَبا" },
    { "n": 136, "sadr": "وَإِن وَنَت رُعودُهُ حَدا بِها",           "ajuz": "حادي الجَنوبِ فَحَدَت كَما حَدا" },
    { "n": 137, "sadr": "كَأَنَّ في أَحضانِهِ وَبَركِهِ",           "ajuz": "بَركاً تَداعى بَينَ سَجرٍ وَوَحى" },
    { "n": 138, "sadr": "لَم أَرَ كَالمُزنِ سَواماً بُهَّلاً",      "ajuz": "تَحسَبُها مَرعِيَّةً وَهيَ سُدى" },
    { "n": 139, "sadr": "تَقولُ لِلأَجرازِ لَمّا اِستَوسَقَت",      "ajuz": "بِسَوقِهِ ثِقي بِرِيٍّ وَحَيا" },
    { "n": 140, "sadr": "فَأَوسَعَ الأَحدابَ سَيباً مُحسِباً",      "ajuz": "وَطَبَّقَ البُطنانَ بِالماءِ الرِّوى" },
    { "n": 141, "sadr": "كَأَنَّما البَيداءُ غِبَّ صَوبِهِ",        "ajuz": "بَحرٌ طَما تَيّارُهُ ثُمَّ سَجا" },
    { "n": 142, "sadr": "ذاكَ الجَدا لا زالَ مَخصوصاً بِهِ",        "ajuz": "قَومٌ هُمُ لِلأَرضِ غَيثٌ وَجَدا" },
    { "n": 143, "sadr": "لَستُ إِذا ما بَهَظَتني غَمرَةٌ",          "ajuz": "مِمَّن يَقولُ بَلَغَ السَّيلُ الزُّبى" },
    { "n": 144, "sadr": "وَإِن ثَوَت تَحتَ ضُلوعي زَفرَةٌ",         "ajuz": "تَملَأُ ما بَينَ الرَّجا إِلى الرَّجا" },
    { "n": 145, "sadr": "نَهنَهتُها مَكظومَةً حَتّى يُرى",          "ajuz": "مُخضَوضِعاً مِنها الَّذي كانَ طَغى" },
    { "n": 146, "sadr": "وَلا أَقولُ إِن عَرَتني نَكبَةٌ",          "ajuz": "قَولَ القَنوطِ اِنقَدَّ في البَطنِ السَّلى" },
    { "n": 147, "sadr": "قَد مارَسَت مِنّي الخُطوبُ مَرِساً",       "ajuz": "يُساوِرُ الهَولَ إِذا الهَولُ عَلا" },
    { "n": 148, "sadr": "لِيَ اِلتِواءٌ إِن مُعادِيَّ اِلتَوى",     "ajuz": "وَلي اِستِواءٌ إِن مُوالِيَّ اِستَوى" },
    { "n": 149, "sadr": "طَعمِيَ شَريٌ لِلعَدُوِّ تارَةً",          "ajuz": "وَالأَريُ بِالرّاحِ لِمَن وُدّي اِبتَغى" },
    { "n": 150, "sadr": "لَدنٌ إِذا لويِنتُ سَهلٌ مَعطِفي",         "ajuz": "أَلوى إِذا خوشِنتُ مَرهوبُ الشَّذا" },
    { "n": 151, "sadr": "يَعتَصِمُ الحِلمُ بِجَنبَي حِبوَتي",       "ajuz": "إِذا رِياحُ الطَّيشِ طارَت بِالحُبا" },
    { "n": 152, "sadr": "لا يَطَّبيني طَمَعٌ مُدَنِّسٌ",            "ajuz": "إِذا اِستَمالَ طَمَعٌ أَوِ اِطَّبى" },
    { "n": 153, "sadr": "وَقَد عَلَت بي رُتَباً تَجارِبي",          "ajuz": "أَشفَينَ بي مِنها عَلى سُبلِ النُّهى" },
    { "n": 154, "sadr": "إِذا اِمرُؤٌ خيفَ لِإِفراطِ الأَذى",       "ajuz": "لَم يُخشَ مِنّي نَزَقٌ وَلا أَذى" },
    { "n": 155, "sadr": "مِن غَيرِ ما وَهنٍ وَلَكِنّي اِمرُؤٌ",     "ajuz": "أَصونُ عِرضاً لَم يُدَنِّسهُ الطَّخا" },
    { "n": 156, "sadr": "وَصَونُ عِرضِ المَرءِ أَن يَبذُلَ ما",     "ajuz": "ضُنَّ بِهِ مِمّا حَواهُ وَانتَصى" },
    { "n": 157, "sadr": "وَالحَمدُ خَيرُ ما اِتَّخَذتَ جُنَّةً",    "ajuz": "وَأَنفَسُ الأَذخارِ مِن بَعدِ التُّقى" },
    { "n": 158, "sadr": "وَكُلُّ قَرنٍ ناجِمٍ في زَمَنٍ",           "ajuz": "فَهوَ شَبيهُ زَمَنٍ فيهِ بَدا" },
    { "n": 159, "sadr": "وَالنّاسُ كَالنَّبتِ فَمِنهُ رائِقٌ",      "ajuz": "غَضٌّ نَضيرٌ عودُهُ مُرُّ الجَنى" },
    { "n": 160, "sadr": "وَمِنهُ ما تَقتَحِمُ العَينُ فَإِن",       "ajuz": "ذُقتَ جَناهُ اِنساغَ عَذباً في اللَّها" },
    { "n": 161, "sadr": "يُقَوَّمُ الشّارِخُ مِن زَيغانِهِ",        "ajuz": "فَيَستَوي ما اِنعاجَ مِنهُ وَانحَنى" },
    { "n": 162, "sadr": "وَالشَّيخُ إِن قَوَّمتَهُ مِن زَيغِهِ",    "ajuz": "لَم يُقِمِ التَّثقيفُ مِنهُ ما اِلتَوى" },
    { "n": 163, "sadr": "كَذَلِكَ الغُصنُ يَسيرٌ عَطفُهُ",          "ajuz": "لَدناً شَديدٌ غَمزُهُ إِذا عَسا" },
    { "n": 164, "sadr": "مَن ظَلَمَ النّاسَ تَحامَوا ظُلمَهُ",      "ajuz": "وَعَزَّ فيهِم جانِباهُ وَاحتَمى" },
    { "n": 165, "sadr": "وَهُم لِمَن لانَ لَهُم جانِبُهُ",          "ajuz": "أَظلَمُ مِن حَيّاتِ أَنباثِ السَّفا" },
    { "n": 166, "sadr": "وَالنّاسُ كُلّاً إِن فَحَصتَ عَنهُمُ",     "ajuz": "جَميعَ أَقطارِ البِلادِ وَالقُرى" },
    { "n": 167, "sadr": "عَبيدُ ذي المالِ وَإِن لَم يَطمَعوا",      "ajuz": "مِن غَمرِهِ في جُرعَةٍ تَشفي الصَّدى" },
    { "n": 168, "sadr": "وَهُم لِمَن أَملَقَ أَعداءٌ وَإِن",        "ajuz": "شارَكَهُم فيما أَفادَ وَحَوى" },
    { "n": 169, "sadr": "عاجَمتُ أَيّامي وَما الغِرُّ كَمَن",       "ajuz": "تَأَزَّرَ الدَّهرُ عَلَيهِ وَارتَدى" },
    { "n": 170, "sadr": "لا يَنفَعُ اللُّبُّ بِلا جَدٍّ وَلا",      "ajuz": "يَحُطُّكَ الجَهلُ إِذا الجَدُّ عَلا" },
    { "n": 171, "sadr": "مَن لَم يَعِظهُ الدَّهرُ لَم يَنفَعهُ ما", "ajuz": "راحَ بِهِ الواعِظُ يَوماً أَو غَدا" },
    { "n": 172, "sadr": "مَن لَم تُفِدهُ عِبَراً أَيّامُهُ",        "ajuz": "كانَ العَمى أَولى بِهِ مِنَ الهُدى" },
    { "n": 173, "sadr": "مَن قاسَ ما لَم يَرَهُ بِما رَأى",         "ajuz": "أَراهُ ما يَدنو إِلَيهِ ما نَأى" },
    { "n": 174, "sadr": "مَن مَلَّكَ الحِرصَ القِيادَ لَم يَزَل",   "ajuz": "يَكرَعُ في ماءٍ مِنَ الذُّلِّ صَرى" },
    { "n": 175, "sadr": "مَن عارَضَ الأَطماعَ بِاليَأسِ رَنَت",     "ajuz": "إِلَيهِ عَينُ العِزِّ مِن حَيثُ رَنا" },
    { "n": 176, "sadr": "مَن عَطَّفَ النَّفسَ عَلى مَكروهِها",      "ajuz": "كانَ الغِنى قَرينَهُ حَيثُ اِنتَوى" },
    { "n": 177, "sadr": "مَن لَم يَقِف عِندَ اِنتِهاءِ قَدرِهِ",    "ajuz": "تَقاصَرَت عَنهُ فَسيحاتُ الخُطا" },
    { "n": 178, "sadr": "مَن ضَيَّعَ الحَزمَ جَنى لِنَفسِهِ",       "ajuz": "نَدامَةً أَلذَعَ مِن سَفعِ الذَّكا" },
    { "n": 179, "sadr": "مَن ناطَ بِالعُجبِ عُرا أَخلاقِهِ",        "ajuz": "نيطَت عُرا المَقتِ إِلى تِلكَ العُرا" },
    { "n": 180, "sadr": "مَن طالَ فَوقَ مُنتَهى بَسطَتِهِ",         "ajuz": "أَعجَزَهُ نَيلُ الدُّنى بَلهَ القُصا" },
    { "n": 181, "sadr": "مَن رامَ ما يَعجِزُ عَنهُ طَوقُهُ",        "ajuz": "مِلعِبءِ يَوماً آضَ مَخزولَ المَطا" },
    { "n": 182, "sadr": "وَالنّاسُ أَلفٌ مِنهُمُ كَواحِدٍ",         "ajuz": "وَواحِدٌ كَالأَلفِ إِن أَمرٌ عَنا" },
    { "n": 183, "sadr": "وَلِلفَتى مِن مالِهِ ما قَدَّمَت",         "ajuz": "يَداهُ قَبلَ مَوتِهِ لا ما اِقتَنى" },
    { "n": 184, "sadr": "وَإِنَّما المَرءُ حَديثٌ بَعدَهُ",         "ajuz": "فَكُن حَديثاً حَسَناً لِمَن وَعى" },
    { "n": 185, "sadr": "إِنّي حَلَبتُ الدَّهرَ شَطرَيهِ فَقَد",    "ajuz": "أَمَرَّ لي حيناً وَأَحياناً حَلا" },
    { "n": 186, "sadr": "وَفُرَّ عَن تَجرِبَةٍ نابي فَقُل",         "ajuz": "في بازِلٍ راضَ الخُطوبَ وَامتَطى" },
    { "n": 187, "sadr": "وَالنّاسُ لِلمَوتِ خَلىً يَلُسُّهُم",      "ajuz": "وَقَلَّما يَبقى عَلى اللَّسِّ الخَلى" },
    { "n": 188, "sadr": "عَجِبتُ مِن مُستَيقِنٍ أَنَّ الرَّدى",     "ajuz": "إِذا أَتاهُ لا يُداوى بِالرُّقى" },
    { "n": 189, "sadr": "وَهوَ مِنَ الغَفلَةِ في أُهوِيَّةٍ",       "ajuz": "كَخابِطٍ بَينَ ظَلامٍ وَعَشا" },
    { "n": 190, "sadr": "نَحنُ وَلا كُفرانَ لِلَّهِ كَما",          "ajuz": "قَد قيلَ لِلسّارِبِ أَخلى فَارتَعى" },
    { "n": 191, "sadr": "إِذا أَحَسَّ نَبأَةً ريعَ وَإِن",          "ajuz": "تَطامَنَت عَنهُ تَمادى وَلَها" },
    { "n": 192, "sadr": "كَثَلَّةٍ ريعَت لِلَيثٍ فَانزَوَت",        "ajuz": "حَتّى إِذا غابَ اِطمَأَنَّت أَن مَضى" },
    { "n": 193, "sadr": "نُهالُ لِلأَمرِ الَّذي يَروعُنا",          "ajuz": "وَنَرتَعي في غَفلَةٍ إِذا اِنقَضى" },
    { "n": 194, "sadr": "إِنَّ الشَّقاءَ بِالشَّقِيِّ مولَعٌ",      "ajuz": "لا يَملِكُ الرَّدَّ لَهُ إِذا أَتى" },
    { "n": 195, "sadr": "وَاللَّومُ لِلحُرِّ مُقيمٌ رادِعٌ",        "ajuz": "وَالعَبدُ لا تَردَعُهُ إِلّا العَصا" },
    { "n": 196, "sadr": "وَآفَةُ العَقلِ الهَوى فَمَن عَلا",        "ajuz": "عَلى هَواهُ عَقلُهُ فَقَد نَجا" },
    { "n": 197, "sadr": "كَم مِن أَخٍ مَسخوطَةٍ أَخلاقُهُ",         "ajuz": "أَصفَيتُهُ الوُدَّ بِخُلقٍ مُرتَضى" },
    { "n": 198, "sadr": "إِذا بَلَوتَ السَّيفَ مَحموداً فَلا",      "ajuz": "تَذمُمهُ يَوماً أَن تَراهُ قَد نَبا" },
    { "n": 199, "sadr": "وَالطِّرفُ يَحتازُ المَدى وَرُبَّما",      "ajuz": "عَنَّ لِمَعداهُ عِثارٌ فَكَبا" },
    { "n": 200, "sadr": "مَن لَكَ بِالمُهَذَّبِ النَّدبِ الَّذي",   "ajuz": "لا يَجِدُ العَيبُ إِلَيهِ مُختَطى" },
    { "n": 201, "sadr": "إِذا تَصَفَّحتَ أُمورَ النّاسِ لَم",       "ajuz": "تُلفِ اِمرَأً حازَ الكَمالَ فَاكتَفى" },
    { "n": 202, "sadr": "عَوِّل عَلى الصَّبرِ الجَميلِ إِنَّهُ",    "ajuz": "أَمنَعُ ما لاذَ بِهِ أُولو الحِجا" },
    { "n": 203, "sadr": "وَعَطِّفِ النَّفسَ عَلى سُبلِ الأُسا",     "ajuz": "إِنِ اِستَفَزَّ القَلبَ تَبريحُ الأَسى" },
    { "n": 204, "sadr": "وَالدَّهرُ يَكبو بِالفَتى وَتارَةً",       "ajuz": "يُنهِضُهُ مِن عَثرَةٍ إِذا كَبا" },
    { "n": 205, "sadr": "لا تَعجَبَن مِن هالِكٍ كَيفَ هَوى",        "ajuz": "بَل فَاعجَبَن مِن سالِمٍ كَيفَ نَجا" },
    { "n": 206, "sadr": "إِنَّ نُجومَ المَجدِ أَمسَت أُفَّلاً",     "ajuz": "وَظِلُّهُ القالِصُ أَضحى قَد أَزى" },
    { "n": 207, "sadr": "إِلّا بَقايا مِن أُناسٍ بِهِمُ",           "ajuz": "إِلى سَبيلِ المَكرُماتِ يُقتَدى" },
    { "n": 208, "sadr": "إِذا الأَحاديثُ اِنتَضَت أَنباءَهُم",      "ajuz": "كانَت كَنَشرِ الرَّوضِ غاداهُ السَّدى" },
    { "n": 209, "sadr": "لا يَسمَعُ السّامِعُ في مَجلِسِهِم",       "ajuz": "هُجراً إِذا جالَسَهُم وَلا خَنا" },
    { "n": 210, "sadr": "ما أَنعَمَ العيشَةَ لَو أَنَّ الفَتى",     "ajuz": "يَقبَلُ مِنهُ مَوتُهُ أَسنى الرُّشا" },
    { "n": 211, "sadr": "أَو لَو تَحَلّى بِالشَّبابِ عُمرَهُ",      "ajuz": "لَم يَستَلِبهُ الشَّيبُ هاتيكَ الحُلى" },
    { "n": 212, "sadr": "هَيهاتَ مَهما يُستَعَر مُستَرجَعٌ",        "ajuz": "وَفي خُطوبِ الدَّهرِ لِلنّاسِ أُسا" },
    { "n": 213, "sadr": "وَفِتيَةٍ سامَرَهُم طَيفُ الكَرى",         "ajuz": "فَسامَروا النَّومَ وَهُم غيدُ الطُّلى" },
    { "n": 214, "sadr": "وَاللَّيلُ مُلقٍ بِالمَوامي بَركَهُ",      "ajuz": "وَالعيسُ يَنبُثنَ أَفاحيصَ القَطا" },
    { "n": 215, "sadr": "بِحَيثُ لا تُهدى لِسَمعٍ نَبأَةٌ",         "ajuz": "إِلّا نَئيمُ البومِ أَو صَوتُ الصَّدى" },
    { "n": 216, "sadr": "شايَعتُهُم عَلى السُّرى حَتّى إِذا",       "ajuz": "مالَت أَداةُ الرَّحلِ بِالجِبسِ الدَّوى" },
    { "n": 217, "sadr": "قُلتُ لَهُم إِنَّ الهُوَينى غِبُّها",      "ajuz": "وَهنٌ فَجِدّوا تَحمَدوا غِبَّ السُّرى" },
    { "n": 218, "sadr": "وَموحِشِ الأَقطارِ طامٍ ماؤُهُ",           "ajuz": "مُدَعثَرِ الأَعضادِ مَهزومِ الجَبى" },
    { "n": 219, "sadr": "كَأَنَّما الرّيشُ عَلى أَرجائِهِ",         "ajuz": "زُرقُ نِصالٍ أُرهِفَت لِتُمتَهى" },
    { "n": 220, "sadr": "وَرَدتُهُ وَالذِّئبُ يَعوي حَولَهُ",       "ajuz": "مُستَكَّ سَمِّ السَّمعِ مِن طولِ الطَّوى" },
    { "n": 221, "sadr": "وَمُنتَجٍ أُمُّ أَبيهِ أُمُّهُ",           "ajuz": "لَم يَتَخَوَّن جِسمَهُ مَسُّ الضَّوى" },
    { "n": 222, "sadr": "أَفرَشتُهُ بِنتَ أَخيهِ فَانثَنَت",        "ajuz": "عَن وَلَدٍ يورى بِهِ وَيُشتَوى" },
    { "n": 223, "sadr": "وَمَرقَبٍ مُخلَولِقٍ أَرجاؤُهُ",           "ajuz": "مُستَصعَبِ المَسلَكِ وَعرِ المُرتَقى" },
    { "n": 224, "sadr": "وَالشَّخصُ في الآلِ يُرى لِناظِرٍ",        "ajuz": "تَرمُقُهُ حيناً وَحيناً لا يُرى" },
    { "n": 225, "sadr": "أَوفَيتُ وَالشَّمسُ تَمُجُّ ريقَها",       "ajuz": "وَالظِّلُّ مِن تَحتِ الحِذاءِ مُحتَذى" },
    { "n": 226, "sadr": "وَطارِقٍ يُؤنِسُهُ الذِّئبُ إِذا",         "ajuz": "تَضَوَّرَ الذِّئبُ عِشاءً وَعَوى" },
    { "n": 227, "sadr": "أَوى إِلى نارِيَ وَهيَ مَألَفٌ",           "ajuz": "يَدعو العُفاةَ ضَوءُها إِلى القِرى" },
    { "n": 228, "sadr": "لِلَّهِ ما طَيفُ خَيالٍ زائِرٍ",           "ajuz": "تَزُفُّهُ لِلقَلبِ أَحلامُ الرُّؤى" },
    { "n": 229, "sadr": "يَجوبُ أَجوازَ الفَلا مُحتَقِراً",         "ajuz": "هَولَ دُجى اللَّيلِ إِذا اللَّيلُ اِنبَرى" },
    { "n": 230, "sadr": "سائِلهُ إِن أَفصَحَ عَن أَنبائِهِ",        "ajuz": "أَنّى تَسَدّى اللَّيلَ أَم أَنّى اِهتَدى" },
    { "n": 231, "sadr": "أَو كانَ يَدري قَبلَها ما فارِسٌ",         "ajuz": "وَما مَواميها القِفارُ وَالقُرى" },
    { "n": 232, "sadr": "وَسائِلي بِمُزعِجي عَن وَطَنٍ",            "ajuz": "ما ضاقَ بي جَنابُهُ وَلا نَبا" },
    { "n": 233, "sadr": "قُلتُ القَضاءُ مالِكٌ أَمرَ الفَتى",       "ajuz": "مِن حَيثُ لا يَدري وَمِن حَيثُ دَرى" },
    { "n": 234, "sadr": "لا تَسأَلَنّي وَاسأَلِ المِقدارَ هَل",     "ajuz": "يَعصِمُ مِنهُ وَزَرٌ أَو مُدَّرى" },
    { "n": 235, "sadr": "لا بُدَّ أَن يَلقى اِمرُؤٌ ما خَطَّهُ",    "ajuz": "ذو العَرشِ مِمّا هُوَ لاقٍ وَوَحى" },
    { "n": 236, "sadr": "لا غَروَ أَن لَجَّ زَمانٌ جائِرٌ",         "ajuz": "فَاعتَرَقَ العَظمَ المُمِخَّ وَانتَقى" },
    { "n": 237, "sadr": "فَقَد تَرى القاحِلَ مُخضَرّاً وَقَد",      "ajuz": "تَلقى أَخا الإِقتارِ يَوماً قَد نَما" },
    { "n": 238, "sadr": "يا هَؤُلَيّا هَل نَشَدتُنَّ لَنا",         "ajuz": "ثاقِبَةَ البُرقُعِ عَن عَينَي طَلا" },
    { "n": 239, "sadr": "ما أَنصَفَت أُمُّ الصَّبِيَّينِ الَّتي",   "ajuz": "أَصبَت أَخا الحِلمِ وَلَمّا يُصطَبى" },
    { "n": 240, "sadr": "اِستَحيِ بيضاً بَينَ أَفوادِكَ أَن",       "ajuz": "يَقتادَكَ البيضُ اِقتِيادَ المُهتَدى" },
    { "n": 241, "sadr": "هَيهاتَ ما أَشنَعَ هاتا زَلَّةً",          "ajuz": "أَطَرَباً بَعدَ المَشيبِ وَالجَلا" },
    { "n": 242, "sadr": "يا رُبَّ لَيلٍ جَمَعَت قُطرَيهِ لي",       "ajuz": "بِنتُ ثَمانينَ عَروساً تُجتَلى" },
    { "n": 243, "sadr": "لَم يَملِكِ الماءُ عَلَيها أَمرَها",       "ajuz": "وَلَم يُدَنِّسها الضِّرامُ المُحتَضى" },
    { "n": 244, "sadr": "حيناً هِيَ الدّاءُ وَأَحياناً بِها",       "ajuz": "مِن دائِها إِذا يَهيجُ يُشتَفى" },
    { "n": 245, "sadr": "قَد صانَها الخَمّارُ لَمّا اِختارَها",     "ajuz": "ضَنّاً بِها عَلى سِواهُ وَاختَبى" },
    { "n": 246, "sadr": "فَهيَ تُرى مِن طولِ عَهدٍ إِن بَدَت",      "ajuz": "في كَأسِها في أَعيُنِ النّاسِ كَلا" },
    { "n": 247, "sadr": "كَأَنَّ قَرنَ الشَّمسِ في ذُرورِها",       "ajuz": "بِفِعلِها في الصَّحنِ وَالكَأسِ اِقتَدى" },
    { "n": 248, "sadr": "نازَعتُها أَروَعَ لا تَسطو عَلى",          "ajuz": "نَديمِهِ شِرَّتُهُ إِذا اِنتَشى" },
    { "n": 249, "sadr": "كَأَنَّ نَورَ الرَّوضِ نَظمُ لَفظِهِ",     "ajuz": "مُرتَجِلاً أَو مُنشِداً أَو إِن شَدا" },
    { "n": 250, "sadr": "مِن كُلِّ ما نالَ الفَتى قَد نِلتُهُ",     "ajuz": "وَالمَرءُ يَبقى بَعدَهُ حُسنُ الثَّنا" },
    { "n": 251, "sadr": "فَإِن أَمُت فَقَد تَناهَت لَذَّتي",        "ajuz": "وَكُلُّ شَيءٍ بَلَغَ الحَدَّ اِنتَهى" },
    { "n": 252, "sadr": "وَإِن أَعِش صاحَبتُ دَهري عالِماً",        "ajuz": "بِما اِنطَوى مِن صَرفِهِ وَما اِنتَشى" },
    { "n": 253, "sadr": "حاشا لِما أَسأَرَهُ فِيَّ الحِجا",         "ajuz": "وَالحِلمُ أَن أَتبَعَ رُوّادَ الخَنا" },
    { "n": 254, "sadr": "أَو أَن أُرى لِنَكبَةٍ مُختَضِعاً",        "ajuz": "أَو لِابتِهاجٍ فَرِحاً وَمُزدَهى" }
  ]
}
