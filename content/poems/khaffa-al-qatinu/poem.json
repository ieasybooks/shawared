{
  "id": "khaffa-al-qatinu",
  "poet": "al-akhtal",
  "title": "خَفَّ القَطينُ فَراحوا مِنكَ أَو بَكَروا",
  "meter": "basit",
  "themes": ["madh", "politics", "hija"],
  "rawiy": "ر",
  "abyat_in_full": 84,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "خَفَّ القَطينُ فَراحوا مِنكَ أَو بَكَروا",
      "ajuz": "وَأَزعَجَتهُم نَوىً في صَرفِها غِيَرُ"
    },
    {
      "n": 2,
      "sadr": "كَأَنَّني شارِبٌ يَومَ اِستُبِدَّ بِهِم",
      "ajuz": "مِن قَرقَفٍ ضُمِّنَتها حِمصُ أَو جَدَرُ"
    },
    {
      "n": 3,
      "sadr": "جادَت بِها مِن ذَواتِ القارِ مُترَعَةٌ",
      "ajuz": "كَلفاءُ يَنحَتُّ عَن خُرطومِها المَدَرُ"
    },
    {
      "n": 4,
      "sadr": "لَذٌّ أَصابَت حُمَيّاها مُقاتِلَهُ",
      "ajuz": "فَلَم تَكَد تَنجَلي عَن قَلبِهِ الخُمَرُ"
    },
    {
      "n": 5,
      "sadr": "كَأَنَّني ذاكَ أَو ذو لَوعَةٍ خَبَلَت",
      "ajuz": "أَوصالَهُ أَو أَصابَت قَلبَهُ النُّشَرُ"
    },
    {
      "n": 6,
      "sadr": "شَوقاً إِلَيهِم وَوَجداً يَومَ أُتبِعُهُم",
      "ajuz": "طَرفي وَمِنهُم بِجَنبَي كَوكَبٍ زُمَرُ"
    },
    {
      "n": 7,
      "sadr": "حَثّوا المَطِيَّ فَوَلَّتنا مَناكِبُها",
      "ajuz": "وَفي الخُدورِ إِذا باغَمتَها الصُّوَرُ"
    },
    {
      "n": 8,
      "sadr": "يُبرِقنَ لِلقَومِ حَتّى يَختَبِلنَهُمُ",
      "ajuz": "وَرَأيُهُنَّ ضَعيفٌ حينَ يُختَبَرُ"
    },
    {
      "n": 9,
      "sadr": "يا قاتَلَ اللَّهُ وَصلَ الغانِياتِ إِذا",
      "ajuz": "أَيقَنَّ أَنَّكَ مِمَّن قَد زَها الكِبَرُ"
    },
    {
      "n": 10,
      "sadr": "أَعرَضنَ لَمّا حَنى قَوسي مُوَتِّرُها",
      "ajuz": "وَابيَضَّ بَعدَ سَوادِ اللِّمَّةِ الشَّعَرُ"
    },
    {
      "n": 11,
      "sadr": "ما يَرعَوينَ إِلى داعٍ لِحاجَتِهِ",
      "ajuz": "وَلا لَهُنَّ إِلى ذي شَيبَةٍ وَطَرُ"
    },
    {
      "n": 12,
      "sadr": "شَرَّقنَ إِذ عَصَرَ العيدانَ بارِحُها",
      "ajuz": "وَأَيبَسَت غَيرَ مَجرى السِّنَّةِ الخُضَرُ"
    },
    {
      "n": 13,
      "sadr": "فَالعَينُ عانِيَةٌ بِالماءِ تَسفَحُهُ",
      "ajuz": "مِن نِيَّةٍ في تَلاقي أَهلِها ضَرَرُ"
    },
    {
      "n": 14,
      "sadr": "مُنقَضِبينَ اِنقِضابَ الحَبلِ يَتبَعُهُم",
      "ajuz": "بَينَ الشَّقيقِ وَعَينِ المَقسِمِ البَصَرُ"
    },
    {
      "n": 15,
      "sadr": "حَتّى هَبَطنَ مِنَ الوادي لِغَضبَتِهِ",
      "ajuz": "أَرضاً تَحُلُّ بِها شَيبانُ أَو غُبَرُ"
    },
    {
      "n": 16,
      "sadr": "حَتّى إِذا هُنَّ وَرَّكنَ القَصيمَ وَقَد",
      "ajuz": "أَشرَفنَ أَو قُلنَ هَذا الخَندَقُ الحَفَرُ"
    },
    {
      "n": 17,
      "sadr": "وَقَعنَ أُصُلاً وَعُجنا مِن نَجائِبِنا",
      "ajuz": "وَقَد تُحُيِّنَ مِن ذي حاجَةٍ سَفَرُ"
    },
    {
      "n": 18,
      "sadr": "إِلى اِمرِئٍ لا تُعَرّينا نَوافِلُهُ",
      "ajuz": "أَظفَرَهُ اللَّهُ فَليَهنِئ لَهُ الظَّفَرُ"
    },
    {
      "n": 19,
      "sadr": "الخائِضِ الغَمرَ وَالمَيمونِ طائِرُهُ",
      "ajuz": "خَليفَةِ اللَّهِ يُستَسقى بِهِ المَطَرُ"
    },
    {
      "n": 20,
      "sadr": "وَالهَمُّ بَعدَ نَجِيِّ النَّفسِ يَبعَثُهُ",
      "ajuz": "بِالحَزمِ وَالأَصمَعانِ القَلبُ وَالحَذَرُ"
    },
    {
      "n": 21,
      "sadr": "وَالمُستَمِرِّ بِهِ أَمرُ الجَميعِ فَما",
      "ajuz": "يَغتَرُّهُ بَعدَ تَوكيدٍ لَهُ غَرَرُ"
    },
    {
      "n": 22,
      "sadr": "وَما الفُراتُ إِذا جاشَت حَوالِبُهُ",
      "ajuz": "في حافَتَيهِ وَفي أَوساطِهِ العُشَرُ"
    },
    {
      "n": 23,
      "sadr": "وَذَعذَعَتهُ رِياحُ الصَّيفِ وَاضطَرَبَت",
      "ajuz": "فَوقَ الجَآجِئِ مِن آذِيِّهِ غُدُرُ"
    },
    {
      "n": 24,
      "sadr": "مُسحَنفِراً مِن جِبالِ الرّومِ تَستُرُهُ",
      "ajuz": "مِنها أَكافيفُ فيها دونَهُ زُوَرُ"
    },
    {
      "n": 25,
      "sadr": "يَوماً بِأَجوَدَ مِنهُ حينَ تَسأَلُهُ",
      "ajuz": "وَلا بِأَجهَرَ مِنهُ حينَ يُجتَهَرُ"
    },
    {
      "n": 26,
      "sadr": "وَلَم يَزَل بِكَ واشيهِم وَمَكرُهُمُ",
      "ajuz": "حَتّى أَشاطوا بِغَيبٍ لَحمَ مَن يَسَروا"
    },
    {
      "n": 27,
      "sadr": "فَمَن يَكُن طاوِياً عَنّا نَصيحَتَهُ",
      "ajuz": "وَفي يَدَيهِ بِدُنيا غَيرِنا حَصَرُ"
    },
    {
      "n": 28,
      "sadr": "فَهوَ فِداءُ أَميرِ المُؤمِنينَ إِذا",
      "ajuz": "أَبدى النَّواجِذَ يَومٌ باسِلٌ ذَكَرُ"
    },
    {
      "n": 29,
      "sadr": "مُفتَرِشٌ كَاِفتِراشِ اللَّيثِ كَلكَلَهُ",
      "ajuz": "لِوَقعَةٍ كائِنٍ فيها لَهُ جَزَرُ"
    },
    {
      "n": 30,
      "sadr": "مُقَدِّمٌ مِائَتَي أَلفٍ لِمَنزِلَةٍ",
      "ajuz": "ما إِن رَأى مِثلَهُم جِنٌّ وَلا بَشَرُ"
    },
    {
      "n": 31,
      "sadr": "يَغشى القَناطِرَ يَبنيها وَيَهدِمُها",
      "ajuz": "مُسَوِّمٌ فَوقَهُ الرّاياتُ وَالقَتَرُ"
    },
    {
      "n": 32,
      "sadr": "حَتّى تَكونَ لَهُم بِالطَّفِّ مَلحَمَةٌ",
      "ajuz": "وَبِالثَّوِيَّةِ لَم يُنبَض بِها وَتَرُ"
    },
    {
      "n": 33,
      "sadr": "وَتَستَبينَ لِأَقوامٍ ضَلالَتُهُم",
      "ajuz": "وَيَستَقيمَ الَّذي في خَدِّهِ صَعَرُ"
    },
    {
      "n": 34,
      "sadr": "وَالمُستَقِلُّ بِأَثقالِ العِراقِ وَقَد",
      "ajuz": "كانَت لَهُ نِعمَةٌ فيهِم وَمُدَّخَرُ"
    },
    {
      "n": 35,
      "sadr": "في نَبعَةٍ مِن قُرَيشٍ يَعصِبونَ بِها",
      "ajuz": "ما إِن يُوازى بِأَعلى نَبتِها الشَّجَرُ"
    },
    {
      "n": 36,
      "sadr": "تَعلو الهِضابَ وَحَلّوا في أَرومَتِها",
      "ajuz": "أَهلُ الرِّباءِ وَأَهلُ الفَخرِ إِن فَخَروا"
    },
    {
      "n": 37,
      "sadr": "حُشدٌ عَلى الحَقِّ عَيّافو الخَنا أُنُفٌ",
      "ajuz": "إِذا أَلَمَّت بِهِم مَكروهَةٌ صَبَروا"
    },
    {
      "n": 38,
      "sadr": "وَإِن تَدَجَّت عَلى الآفاقِ مُظلِمَةٌ",
      "ajuz": "كانَ لَهُم مَخرَجٌ مِنها وَمُعتَصَرُ"
    },
    {
      "n": 39,
      "sadr": "أَعطاهُمُ اللَّهُ جَدّاً يُنصَرونَ بِهِ",
      "ajuz": "لا جَدَّ إِلّا صَغيرٌ بَعدُ مُحتَقَرُ"
    },
    {
      "n": 40,
      "sadr": "لَم يَأشَروا فيهِ إِذ كانوا مَوالِيَهُ",
      "ajuz": "وَلَو يَكونُ لِقَومٍ غَيرِهِم أَشِروا"
    },
    {
      "n": 41,
      "sadr": "شُمسُ العَداوَةِ حَتّى يُستَقادَ لَهُم",
      "ajuz": "وَأَعظَمُ النّاسِ أَحلاماً إِذا قَدَروا"
    },
    {
      "n": 42,
      "sadr": "لا يَستَقِلُّ ذَوو الأَضغانِ حَربَهُمُ",
      "ajuz": "وَلا يَبينُ في عيدانِهِم خَوَرُ"
    },
    {
      "n": 43,
      "sadr": "هُمُ الَّذينَ يُبارونَ الرِّياحَ إِذا",
      "ajuz": "قَلَّ الطَّعامُ عَلى العافينَ أَو قَتَروا"
    },
    {
      "n": 44,
      "sadr": "بَني أُمَيَّةَ نُعماكُم مُجَلِّلَةٌ",
      "ajuz": "تَمَّت فَلا مِنَّةٌ فيها وَلا كَدَرُ"
    },
    {
      "n": 45,
      "sadr": "بَني أُمَيَّةَ قَد ناضَلتُ دونَكُمُ",
      "ajuz": "أَبناءَ قَومٍ هُمُ آوَوا وَهُم نَصَروا"
    },
    {
      "n": 46,
      "sadr": "أَفحَمتُ عَنكُم بَني النَّجّارِ قَد عَلِمَت",
      "ajuz": "عُليا مَعَدٍّ وَكانوا طالَما هَدَروا"
    },
    {
      "n": 47,
      "sadr": "حَتّى اِستَكانوا وَهُم مِنّي عَلى مَضَضٍ",
      "ajuz": "وَالقَولُ يَنفُذُ ما لا تَنفُذُ الإِبَرُ"
    },
    {
      "n": 48,
      "sadr": "بَني أُمَيَّةَ إِنّي ناصِحٌ لَكُمُ",
      "ajuz": "فَلا يَبيتَنَّ فيكُم آمِناً زُفَرُ"
    },
    {
      "n": 49,
      "sadr": "وَاتَّخِذوهُ عَدُوّاً إِنَّ شاهِدَهُ",
      "ajuz": "وَما تَغَيَّبَ مِن أَخلاقِهِ دَعَرُ"
    },
    {
      "n": 50,
      "sadr": "إِنَّ الضَّغينَةَ تَلقاها وَإِن قَدُمَت",
      "ajuz": "كَالعَرِّ يَكمُنُ حيناً ثُمَّ يَنتَشِرُ"
    },
    {
      "n": 51,
      "sadr": "وَقَد نُصِرتَ أَميرَ المُؤمِنينَ بِنا",
      "ajuz": "لَمّا أَتاكَ بِبَطنِ الغوطَةِ الخَبَرُ"
    },
    {
      "n": 52,
      "sadr": "يُعَرِّفونَكَ رَأسَ اِبنِ الحُبابِ وَقَد",
      "ajuz": "أَضحى وَلِلسَّيفِ في خَيشومِهِ أَثَرُ"
    },
    {
      "n": 53,
      "sadr": "لا يَسمَعُ الصَّوتَ مُستَكّاً مَسامِعُهُ",
      "ajuz": "وَلَيسَ يَنطِقُ حَتّى يَنطِقَ الحَجَرُ"
    },
    {
      "n": 54,
      "sadr": "أَمسَت إِلى جانِبِ الحَشّاكِ جيفَتُهُ",
      "ajuz": "وَرَأسُهُ دونَهُ اليَحمومُ وَالصِّوَرُ"
    },
    {
      "n": 55,
      "sadr": "يَسأَلُهُ الصُّبرُ مِن غَسّانَ إِذ حَضَروا",
      "ajuz": "وَالحَزنُ كَيفَ قَراكَ الغِلمَةُ الجَشَرُ"
    },
    {
      "n": 56,
      "sadr": "وَالحارِثَ اِبنَ أَبي عَوفٍ لَعِبنَ بِهِ",
      "ajuz": "حَتّى تَعاوَرَهُ العِقبانُ وَالسُّبَرُ"
    },
    {
      "n": 57,
      "sadr": "وَقَيسَ عَيلانَ حَتّى أَقبَلوا رَقَصاً",
      "ajuz": "فَبايَعوكَ جِهاراً بَعدَ ما كَفَروا"
    },
    {
      "n": 58,
      "sadr": "فَلا هَدى اللَّهُ قَيساً مِن ضَلالَتِهِم",
      "ajuz": "وَلا لَعاً لِبَني ذَكوانَ إِذ عَثَروا"
    },
    {
      "n": 59,
      "sadr": "ضَجّوا مِنَ الحَربِ إِذ عَضَّت غَوارِبَهُم",
      "ajuz": "وَقَيسُ عَيلانَ مِن أَخلاقِها الضَّجَرُ"
    },
    {
      "n": 60,
      "sadr": "كانوا ذَوي إِمَّةٍ حَتّى إِذا عَلِقَت",
      "ajuz": "بِهِم حَبائِلُ لِلشَّيطانِ وَابتَهَروا"
    },
    {
      "n": 61,
      "sadr": "صُكّوا عَلى شارِفٍ صَعبٍ مَراكِبُها",
      "ajuz": "حَصّاءَ لَيسَ لَها هُلبٌ وَلا وَبَرُ"
    },
    {
      "n": 62,
      "sadr": "وَلَم يَزَل بِسُلَيمٍ أَمرُ جاهِلِها",
      "ajuz": "حَتّى تَعَيّا بِها الإيرادُ وَالصَّدَرُ"
    },
    {
      "n": 63,
      "sadr": "إِذ يَنظُرونَ وَهُم يَجنونَ حَنظَلَهُم",
      "ajuz": "إِلى الزَّوابي فَقُلنا بَعدَ ما نَظَروا"
    },
    {
      "n": 64,
      "sadr": "كَرّوا إِلى حَرَّتَيهِم يَعمُرونَهُما",
      "ajuz": "كَما تَكُرُّ إِلى أَوطانِها البَقَرُ"
    },
    {
      "n": 65,
      "sadr": "فَأَصبَحَت مِنهُمُ سِنجارُ خالِيَةً",
      "ajuz": "فَالمَحلَبِيّاتُ فَالخابورُ فَالسُّرَرُ"
    },
    {
      "n": 66,
      "sadr": "وَما يُلاقونَ فَرّاصاً إِلى نَسَبٍ",
      "ajuz": "حَتّى يُلاقِيَ جَديَ الفَرقَدِ القَمَرُ"
    },
    {
      "n": 67,
      "sadr": "وَلا الضَّبابَ إِذا اِخضَرَّت عُيونُهُمُ",
      "ajuz": "وَلا عُصَيَّةَ إِلّا أَنَّهُم بَشَرُ"
    },
    {
      "n": 68,
      "sadr": "وَما سَعى مِنهُمُ ساعٍ لِيُدرِكَنا",
      "ajuz": "إِلّا تَقاصَرَ عَنّا وَهوَ مُنبَهِرُ"
    },
    {
      "n": 69,
      "sadr": "وَقَد أَصابَت كِلاباً مِن عَداوَتِنا",
      "ajuz": "إِحدى الدَّواهي الَّتي تُخشى وَتُنتَظَرُ"
    },
    {
      "n": 70,
      "sadr": "وَقَد تَفاقَمَ أَمرٌ غَيرُ مُلتَئِمٍ",
      "ajuz": "ما بَينَنا فيهِ أَرحامٌ وَلا عِذَرُ"
    },
    {
      "n": 71,
      "sadr": "أَمّا كُلَيبُ اِبنُ يَربوعٍ فَلَيسَ لَهُم",
      "ajuz": "عِندَ المَكارِمِ لا وِردٌ وَلا صَدَرُ"
    },
    {
      "n": 72,
      "sadr": "مُخَلَّفونَ وَيَقضي النّاسُ أَمرَهُمُ",
      "ajuz": "وَهُم بِغَيبٍ وَفي عَمياءَ ما شَعَروا"
    },
    {
      "n": 73,
      "sadr": "مُلَطَّمونَ بِأَعقارِ الحِياضِ فَما",
      "ajuz": "يَنفَكُّ مِن دارِمِيٍّ فيهِمِ أَثَرُ"
    },
    {
      "n": 74,
