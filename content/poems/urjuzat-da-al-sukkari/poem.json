{
  "id": "urjuzat-da-al-sukkari",
  "poet": "husam-al-dosari",
  "title": "أُرجوزَةُ داءِ السُّكَّرِيِّ",
  "meter": "rajaz",
  "themes": ["didactic"],
  "abyat_in_full": 70,
  "added": "2026-11-19",
  "abyat": [
    {"n": 1, "sadr": "بِسمِ الرَّحيمِ رافِعِ السَّماءِ", "ajuz": "وَمُنزِلِ الشِّفاءِ وَالدَّواءِ"},
    {"n": 2, "sadr": "أَحمَدُهُ عَلى عَظيمِ فَضلِهِ", "ajuz": "وَلُطفِهِ بِحالِنا وَعَدلِهِ"},
    {"n": 3, "sadr": "ثُمَّ الصَّلاةُ بَعدَها السَّلامُ", "ajuz": "عَلى النَّبِيِّ ما عَلا غَمامُ"},
    {"n": 4, "sadr": "فَهَذِهِ أُرجوزَةٌ نَظَمتُها", "ajuz": "بَذَلتُ ما في الوُسعِ إِذ لَمَمتُها"},
    {"n": 5, "sadr": "كَتَبتُ عَن داءٍ فَشا وَشاعا", "ajuz": "فَذاعَ صيتُهُ عَلا وَفاعا"},
    {"n": 6, "sadr": "سَمَّوهُ داءَ السُّكَّرِيِّ قالوا", "ajuz": "في وَصفِهِ تَنَوَّعَ المَقالُ"},
    {"n": 7, "sadr": "أَصنافُهُ عَديدَةٌ مُنَوَّعَة", "ajuz": "قَد أَحسَنوا إِذ أَجمَلوا بِأَربَعَة"},
    {"n": 8, "sadr": "فَأَشهَرُ الأَصنافِ في زَماني", "ajuz": "نَوعانِ شاعا أَوَّلٌ وَثانِ"},
    {"n": 9, "sadr": "فَالأَوَّلُ اِصطَفى لَهُ الأَطفالا", "ajuz": "وَنالَ مِن صَمّائِهِم ما نالا"},
    {"n": 10, "sadr": "لَكِنَّهُ إِذا اِنكَمى وَحادا", "ajuz": "صارَ اِسمُهُ عِندَ الكِبارِ لادا"},
    {"n": 11, "sadr": "وَثانِيَ الأَنواعِ في تَنامِ", "ajuz": "قَد طافَ في الدُّنا بِلا زِمامِ"},
    {"n": 12, "sadr": "وَثالِثُ الأَصنافِ يَغشى الحُبلى", "ajuz": "وَيَنقَضي إِذا قَطَعنَ الحَبلا"},
    {"n": 13, "sadr": "لَكِنَّهُ حيناً يَقَرُّ ما أَلا", "ajuz": "وَقَد يَزورُ بَعدَ ما لَها قَلى"},
    {"n": 14, "sadr": "وَرابِعُ الأَصنافِ فيهِ أَسهَبوا", "ajuz": "وَعَدَّدوا أَنواعَهُ فَأَطنَبوا"},
    {"n": 15, "sadr": "عَلى سَبيلِ الضَّربِ لا التَّحديدِ", "ajuz": "نَوعُ الشَّبابِ هَكَذا قُل مودي"},
    {"n": 16, "sadr": "أَو في تَلازُمٍ كَحالِ وُلكُت", "ajuz": "قُل بَعدَها رالِسُن أَوِ اُسكُت"},
    {"n": 17, "sadr": "وَغَيرُها العَديدُ وَالفَريدُ", "ajuz": "كَأَنَّها في شِعرِنا المَديدُ"},
    {"n": 18, "sadr": "وَكُلُّها اِرتَضَت لَها خِصالا", "ajuz": "إِن نالَتِ الفَتى ظَمي وَبالا"},
    {"n": 19, "sadr": "وَاسمَع لِنُصحي إِن دَهى وَارتَبتَ بِه", "ajuz": "أَأَوَّلٌ أَم ذاكَ ثانٍ فَانتَبِه"},
    {"n": 20, "sadr": "فَقَد رَوى لَنا هُنا الحُذّاقُ", "ajuz": "نَوعاً هَجيناً ما لَهُ مِصداقُ"},
    {"n": 21, "sadr": "تَداخَلَت فيهِ الصِّفاتُ فَادَّعى", "ajuz": "بِأَنَّهُ ثانٍ وَأَوَّلٌ مَعا"},
    {"n": 22, "sadr": "فَحارَ في أَمرِ الفَتى الطَّبيبُ", "ajuz": "أَيُخفِقُ العِلاجُ أَم يُصيبُ"},
    {"n": 23, "sadr": "وَصارَ يَهذي مِن فِرى الأَخلاطِ", "ajuz": "مُحَدِّقاً بِالجيدِ وَالآباطِ"},
    {"n": 24, "sadr": "فَإِن دَهاكَ لا أَبا لَكَ العَجَب", "ajuz": "فَراقِبِ المَريضَ ذاكَ عَن كَثَب"},
    {"n": 25, "sadr": "وَالنَّفسَ عَلِّل إِن أَتَت مُؤاخِذَة", "ajuz": "فَمِثلُهُ قَد حَيَّرَ الجَهابِذَة"},
    {"n": 26, "sadr": "ثُمَّ اِتَّكِل عَلى إِلَهِنا الصَّمَد", "ajuz": "بِهِ اِستَعِن وَمِنهُ فَاطلُبِ المَدَد"},
    {"n": 27, "sadr": "وَقَد يَصِحُّ أَن تُعالِجَ الرِّيَب", "ajuz": "بِالإِنسُلينِ إِن أَرابَكَ السَّبَب"},
    {"n": 28, "sadr": "فَإِنَّهُ قَد نَفَعَ السِّقاما", "ajuz": "بِإِذنِ رَبِّنا فَكُن هُماما"},
    {"n": 29, "sadr": "وَقَبلَهُ كانوا إِذا الدّاءُ اِبتَدا", "ajuz": "لَم يَفدِهِم مِن سُقمِهِم إِلّا الرَّدى"},
    {"n": 30, "sadr": "فَشاءَ رَبُّنا القَديرُ لِلوَرى", "ajuz": "أَن يَنجَلي الغَمُّ وَهاكَ ما جَرى"},
    {"n": 31, "sadr": "في بَلدَةٍ خَلفَ أَقاصي الأُفُقِ", "ajuz": "أَصحابُها قَد أُولِعوا بِالسَّبقِ"},
    {"n": 32, "sadr": "مِن بَردِها تَلَفَّعوا بِالشّالِ", "ajuz": "وَلُثمِهِم في الحِلِّ وَالتِّرحالِ"},
    {"n": 33, "sadr": "باهوا قُرى الدُّنيا بِها تورُنتو", "ajuz": "بِضَمِّ رائِها كَما في رُمتُ"},
    {"n": 34, "sadr": "في قَرنِنا الماضي إِذا مِنهُ خَلَت", "ajuz": "عَشرٌ فَعَشرٌ بَعدَ عامَينِ اِنقَضَت"},
    {"n": 35, "sadr": "في عَنبَرٍ في أَحَدِ المَشافي", "ajuz": "رُقِّدَ قَد أُصيبَ بِالجَفافِ"},
    {"n": 36, "sadr": "فَتىً عَليلٌ بِالسَّقامِ مُثخَن", "ajuz": "يُلَقِّبونَهُ لِنَردَ ثُمسَن"},
    {"n": 37, "sadr": "ذاكَ اِسمُهُ وَتِلكَ دالٌ مُهمَلَة", "ajuz": "ساكِنَةٌ حَرَّكتُها لِلسَّلسَلَة"},
    {"n": 38, "sadr": "يُصارِعُ المَوتَ بِلا سِنانِ", "ajuz": "مُمَدَّدٌ مُضطَرِبُ الجَنانِ"},
    {"n": 39, "sadr": "فَالسُّكَّرِيُّ كانَ قَد جازَ المَدى", "ajuz": "فَناصَبوهُ حَربَهُم كَي يَبعُدا"},
    {"n": 40, "sadr": "وَأُمُّهُ بَدا عَلَيها الغَمُّ", "ajuz": "تَحضُنُهُ وَقَد كَساها الهَمُّ"},
    {"n": 41, "sadr": "وَكانَ أَهلُ الطِّبِّ في زَمانِهِ", "ajuz": "قَد أَخرَجوا الهُرمونَ مِن كِنانِهِ"},
    {"n": 42, "sadr": "فَاستَخلَصوهُ مِن حَشى الكِلابِ", "ajuz": "وَغَيرِها مِن طَيِّبٍ وَنابِ"},
    {"n": 43, "sadr": "وَجَرَّبوا أَن يَحقِنوا السِّباعا", "ajuz": "فَصارَ في عُروقِها مُطاعا"},
    {"n": 44, "sadr": "فَأَزمَعوا هُنا عَلى حَقنِ الفَتى", "ajuz": "فَدَورُ إِنسُلينِهِم ها قَد أَتى"},
    {"n": 45, "sadr": "وَقَد غَدا مِنَ الهُزالِ مُهتَرِئ", "ajuz": "وَبَعدَ حَقنِهِ كَأَنَّهُ بَرِئ"},
    {"n": 46, "sadr": "وَعاشَ بَينَهُم مُعافىً دَهرا", "ajuz": "سُبحانَ مَن بِأَمرِهِ قَد أَبرا"},
    {"n": 47, "sadr": "فَافتَخَروا بِسَبقِهِم حُقَّ لَهُم", "ajuz": "سُبحانَ مَن بِسَبقِهِم كَلَّلَهُم"},
    {"n": 48, "sadr": "وَخَلَّدوا ذاكَ عَلى الدّولارِ", "ajuz": "في مِائَةٍ رَفيعَةِ المِقدارِ"},
    {"n": 49, "sadr": "بِرَسمِ حُنجورٍ لِذا التِّرياقِ", "ajuz": "مُخَصَّرٍ مُخَمَّرٍ بَرّاقِ"},
    {"n": 50, "sadr": "وَالإِنسُلينُ في زَمانِنا وَلَد", "ajuz": "فَأَنجَبَ السَّريعَ را مِنَ الوَلَد"},
    {"n": 51, "sadr": "وَأَنجَبَ البَطيءَ لو إِذا سَرى", "ajuz": "كَأَنَّهُ مُفَتَّرٌ مِنَ الكَرى"},
    {"n": 52, "sadr": "وَقَد تَنَوَّعَت لَنا أَشكالُهُ", "ajuz": "وَصَدَّقَت أَقوالَهُ أَفعالُهُ"},
    {"n": 53, "sadr": "وَاليَومَ قَد حاكَوهُ في المُختَبَرِ", "ajuz": "كَأَنَّهُ مُستَخلَصٌ مِن بَشَرِ"},
    {"n": 54, "sadr": "فَالحَمدُ لِلَّهِ عَلى إِنعامِهِ", "ajuz": "وَالشُّكرُ لِلَّهِ عَلى إِكرامِهِ"},
    {"n": 55, "sadr": "وَقَبلَ أَن نَختَتِمَ الكَلاما", "ajuz": "لَعَلَّنا نُنَبِّهُ الأَناما"},
    {"n": 56, "sadr": "لا تَأخُذِ الطِّبَّ مِنَ الشِّباكِ", "ajuz": "فَالعَنكَبوتُ سَيِّدُ الشِّراكِ"},
    {"n": 57, "sadr": "فَفي زَمانِنا حَدا الطِّبابَة", "ajuz": "عِلمٌ فَحَثَّها عَلى الإِصابَة"},
    {"n": 58, "sadr": "وَلَيسَ كُلُّ ما ذَكَرتُ ها هُنا", "ajuz": "يَصلُحُ لِلجَميعِ أَو يَنالُنا"},
    {"n": 59, "sadr": "وَسَل طَبيباً حاذِقاً ذا حِرصِ", "ajuz": "عَن حُقَنٍ مَضَخَّةٍ أَو قُرصِ"},
    {"n": 60, "sadr": "وَلَيسَ كُلُّ الحَقنِ إِنسُلينا", "ajuz": "فَسَل إِذا شَكَكتَ مُستَبينا"},
    {"n": 61, "sadr": "رَأسُ الدَّواءِ حِميَةٌ كَما تَرى", "ajuz": "قَد قالَها أَسلافُنا كَما جَرى"},
    {"n": 62, "sadr": "بِالحِميَةِ المَوزونَةِ اِستَقاما", "ajuz": "أَمرُ العَليلِ إِن مَشى وَقاما"},
    {"n": 63, "sadr": "وَلا يَفُتكَ أَن تُراقِبَ العِلَل", "ajuz": "إِن صاحَبَت أَو لاحَقَت مِنَ الزَّلَل"},
    {"n": 64, "sadr": "وَخَطَّطَ العِلاجَ ذا فَريقُ", "ajuz": "يَرأَسُهُ المَريضُ وَالرَّفيقُ"},
    {"n": 65, "sadr": "وَنَسأَلُ اللَّهَ الشِّفاءَ لِلبَشَر", "ajuz": "وَأَن يَعُمَّنا وَكُلَّ مَن شَكَر"},
    {"n": 66, "sadr": "لَعَلَّهُ قَد لاحَ في الآفاقِ", "ajuz": "ما يَبعَثُ السُّرورَ في الأَعماقِ"},
    {"n": 67, "sadr": "وَالسُّكَّرِيُّ إِذ حَكى الثِّقاتُ", "ajuz": "قَد صُنِّفَت فيهِ مُجَلَّداتُ"},
    {"n": 68, "sadr": "فَما ذَكَرتُ ها هُنا مِن غَيضِ", "ajuz": "نَزرٌ يَسيرٌ مِن غَزيرِ الفَيضِ"},
    {"n": 69, "sadr": "وَالحَمدُ لِلَّهِ عَلى ما يَسَّر", "ajuz": "وَالشُّكرُ ما لَيلٌ سَرى أَو أَدبَر"},
    {"n": 70, "sadr": "خَتَمتُ بِالصَّلاةِ وَالسَّلامِ", "ajuz": "عَلى النَّبِيِّ سَيِّدِ الأَنامِ"}
  ]
}
