{
  "id": "arafa-al-habibu-makanahu",
  "poet": "baha-al-din-zuhayr",
  "title": "عَرَفَ الحَبيبُ مَكانَهُ فَتَدَلَّلا",
  "meter": "kamil",
  "rawiy": "ل",
  "abyat_in_full": 40,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "عَرَفَ الحَبيبُ مَكانَهُ فَتَدَلَّلا", "ajuz": "وَقَنِعتُ مِنهُ بِمَوعِدٍ فَتَعَلَّلا" },
    { "n": 2,  "sadr": "وَأَتى الرَّسولُ وَلَم أَجِد في وَجهِهِ", "ajuz": "بِشراً كَما قَد كُنتُ أَعهَدُ أَوَّلا" },
    { "n": 3,  "sadr": "فَقَطَعتُ يَومي كُلَّهُ مُتَفَكِّراً", "ajuz": "وَسَهِرتُ لَيلي كُلَّهُ مُتَمَلمِلا" },
    { "n": 4,  "sadr": "وَأَخَذتُ أَحسِبُ كُلَّ شَيءٍ لَم يَكُن", "ajuz": "مُتَجَلِّياً في فِكرَتي مُتَخَيَّلا" },
    { "n": 5,  "sadr": "فَلَعَلَّ طَيفاً مِنهُ زارَ فَرَدَّهُ", "ajuz": "سَهَري فَعادَ بِغَيظِهِ فَتَقَوَّلا" },
    { "n": 6,  "sadr": "وَعَسى نَسيمٌ بِتُّ أَكتُمُ سِرَّنا", "ajuz": "عَنهُ فَراحَ يَقولُ عَنّي قَد سَلا" },
    { "n": 7,  "sadr": "وَلَقَد خَشيتُ بِأَن يَكونَ أَمالَهُ", "ajuz": "غَيري وَطَبعُ الغُصنِ أَن يَتَمَيَّلا" },
    { "n": 8,  "sadr": "وَأَظُنُّهُ طَلَبَ الجَديدَ وَطالَما", "ajuz": "عَتَقَ القَميصُ عَلى اِمرِئٍ فَتَبَدَّلا" },
    { "n": 9,  "sadr": "أَبَداً يَرى بُعدي وَأَطلُبُ قُربَهُ", "ajuz": "وَلَوَ اَنَّني جارٌ لَهُ لَتَحَوَّلا" },
    { "n": 10, "sadr": "وَعَلِقتُهُ كَالغُصنِ أَسمَرَ أَهيَفاً", "ajuz": "وَعَشِقتُهُ كَالظَّبيِ أَحوَرَ أَكحَلا" },
    { "n": 11, "sadr": "فَضَحَ الغَزالَةَ وَالغَزالَ فَتِلكَ في", "ajuz": "وَسَطِ السَّماءِ وَذاكَ في وَسَطِ الفَلا" },
    { "n": 12, "sadr": "عَجَباً لِقَلبٍ ما خَلا مِن لَوعَةٍ", "ajuz": "أَبَداً يَحِنُّ إِلى زَمانٍ قَد خَلا" },
    { "n": 13, "sadr": "وَرُسومِ جِسمٍ كادَ يُحرِقُهُ الجَوى", "ajuz": "لَو لَم تَدارَكهُ الدُّموعُ لَأُشعِلا" },
    { "n": 14, "sadr": "وَهَوىً حَفِظتُ حَديثَهُ وَكَتَمتُهُ", "ajuz": "فَوَجَدتُ دَمعي قَد رَواهُ مُسَلسَلا" },
    { "n": 15, "sadr": "أَهوى التَّذَلُّلَ في الغَرامِ وَإِنَّما", "ajuz": "يَأبى صَلاحُ الدّينِ أَن أَتَذَلَّلا" },
    { "n": 16, "sadr": "مَهَّدتُ بِالغَزَلِ الرَّقيقِ لِمَدحِهِ", "ajuz": "وَأَرَدتُ قَبلَ الفَرضِ أَن أَتَنَفَّلا" },
    { "n": 17, "sadr": "مَلِكٌ شَمَختُ عَلى المُلوكِ بِقُربِهِ", "ajuz": "وَلَبِستُ ثَوبَ العِزِّ مِنهُ مُسبَلا" },
    { "n": 18, "sadr": "وَرَفَعتُ صَوتي قائِلاً يا يوسُفٌ", "ajuz": "فَأَجابَني مَلِكٌ أَطالَ وَأَجزَلا" },
    { "n": 19, "sadr": "ثُمَّ اِلتَفَتُّ وَجَدتُ حَولي أَنعُماً", "ajuz": "ما كانَ أَسرَعَها إِلَيَّ وَأَعجَلا" },
    { "n": 20, "sadr": "وَهَصَرتُ أَغصانَ المَطالِبِ مُيَّساً", "ajuz": "وَمَرَيتُ أَخلافَ المَواهِبِ حُفَّلا" },
    { "n": 21, "sadr": "قَهَرَ الزَّمانَ وَقَد عَراني صَرفُهُ", "ajuz": "حَتّى مَشى في خِدمَتي مُتَرَجِّلا" },
    { "n": 22, "sadr": "وَإِذا نَظَرتُ وَجَدتُ بَعضَ هِباتِهِ", "ajuz": "فيها المَفاخِرُ وَالمَآثِرُ وَالعُلا" },
    { "n": 23, "sadr": "يُروى حَديثُ الجودِ عَنهُ مُسنَداً", "ajuz": "فَعَلامَ تَرويهِ السَّحائِبُ مُرسَلا" },
    { "n": 24, "sadr": "مِن مَعشَرٍ فاقوا المُلوكَ سِيادَةً", "ajuz": "وَسَعادَةً وَتَطَوُّلاً وَتَفَضُّلا" },
    { "n": 25, "sadr": "وَكَأَنَّ مَتنَ الأَرضِ يَومَ رُكوبِهِم", "ajuz": "يَكسونَهُ بُرداً عَلَيهِ مُهَلهَلا" },
    { "n": 26, "sadr": "مِن كُلِّ أَغلَبَ في الهِياجِ كَأَنَّما", "ajuz": "لَبِسَ الغَديرَ وَهَزَّ مِنهُ جَدوَلا" },
    { "n": 27, "sadr": "وَإِذا سَأَلتَ سَأَلتَ غَيثاً مُسبَلاً", "ajuz": "وَإِذا لَقيتَ لَقيتَ لَيثاً مُشبِلا" },
    { "n": 28, "sadr": "مَولايَ قَد أَهدَيتُها لَكَ كاعِباً", "ajuz": "عَذراءَ تُبدي عُذرَةً وَتَنَصُّلا" },
    { "n": 29, "sadr": "حَمَلَت ثَناءً كَالهِضابِ فَأَبطَأَت", "ajuz": "فَاعذِر بَطيئاً قَد أَتى لَكَ مُثقَلا" },
    { "n": 30, "sadr": "عَرَفَت مَحَبَّتَها لَدَيكَ وَحُسنَها", "ajuz": "فَأَتَت تُريكَ تَدَلُّلاً وَتَعَسُّلا" },
    { "n": 31, "sadr": "بَدَوِيَّةٌ إِن شِئتَ أَو حَضَرِيَّةٌ", "ajuz": "جَمَعَ الخُزامى نَشرُها وَالمَندَلا" },
    { "n": 32, "sadr": "وَلَوَ اَنَّها مِمَّن تَقَدَّمَ عَصرُهُ", "ajuz": "مَنَعَت زِياداً أَن يَقولَ وَجَروَلا" },
    { "n": 33, "sadr": "غَزَلٌ وَمَدحٌ بِتُّ أَغرَقُ فيهِما", "ajuz": "كَالخَمرِ مازَجَتِ الزُّلالَ السَّلسَلا" },
    { "n": 34, "sadr": "فَتَأَلَّفَت عِقداً يَروقُ نِظامُهُ", "ajuz": "وَالعِقدُ أَحسَنُ ما يَكونُ مُفَصَّلا" },
    { "n": 35, "sadr": "يا مَن مَديحي فيهِ صِدقٌ كُلُّهُ", "ajuz": "فَكَأَنَّما أَتلو كِتاباً مُنزَلا" },
    { "n": 36, "sadr": "يا مَن وَلائي فيهِ نَصٌّ بَيِّنٌ", "ajuz": "وَالنَّصُّ عِندَ القَومِ لَن يَتَأَوَّلا" },
    { "n": 37, "sadr": "وَلَقَد حَلا عَيشي لَدَيكَ وَلَم أُرِد", "ajuz": "عَيشاً سِواهُ وَإِن أَرَدتُ فَلا حَلا" },
    { "n": 38, "sadr": "وَشَكَرتُ جودَكَ كُلَّ شُكرٍ عالِماً", "ajuz": "أَلّا أَقومَ بِبَعضِ ذاكَ وَلا وَلا" }
  ]
}
