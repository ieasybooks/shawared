{
  "id": "taqulu-buthaynatu",
  "poet": "jamil-buthayna",
  "title": "تَقولُ بُثَينَةُ لَمّا رَأَت",
  "meter": "mutaqarib",
  "rawiy": "ر",
  "abyat_in_full": 10,
  "added": "2026-11-16",
  "abyat": [
    { "n": 1,  "sadr": "تَقولُ بُثَينَةُ لَمّا رَأَت", "ajuz": "فُنوناً مِنَ الشَّعَرِ الأَحمَرِ" },
    { "n": 2,  "sadr": "كَبِرتَ جَميلُ وَأَودى الشَّبابُ", "ajuz": "فَقُلتُ بُثَينُ أَلا فَاقصُري" },
    { "n": 3,  "sadr": "أَتَنسَينَ أَيّامَنا بِاللِّوى", "ajuz": "وَأَيّامَنا بِذَوي الأَجفَرِ" },
    { "n": 4,  "sadr": "أَما كُنتِ أَبصَرتِني مَرَّةً", "ajuz": "لَيالِيَ نَحنُ بِذي جَهوَرِ" },
    { "n": 5,  "sadr": "لَيالِيَ أَنتُم لَنا جيرَةٌ", "ajuz": "أَلا تَذكُرينَ بَلى فَاذكُري" },
    { "n": 6,  "sadr": "وَإِذ أَنا أَغيَدُ غَضُّ الشَّبابِ", "ajuz": "أَجُرُّ الرِّداءَ مَعَ المِئزَرِ" },
    { "n": 7,  "sadr": "وَإِذ لَمَّتي كَجَناحِ الغُرابِ", "ajuz": "تُرَجَّلُ بِالمِسكِ وَالعَنبَرِ" },
    { "n": 8,  "sadr": "فَغَيَّرَ ذَلِكَ ما تَعلَمينَ", "ajuz": "تَغَيُّرَ ذا الزَّمَنِ المُنكَرِ" },
    { "n": 9,  "sadr": "وَأَنتِ كَلُؤلُؤَةِ المَرزَبانِ", "ajuz": "بِماءِ شَبابِكِ لَم تُعصَري" },
    { "n": 10, "sadr": "قَريبانِ مَربَعُنا واحِدٌ", "ajuz": "فَكَيفَ كَبِرتُ وَلَم تَكبُري" }
  ]
}
