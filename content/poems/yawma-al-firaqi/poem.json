{
  "id": "yawma-al-firaqi",
  "poet": "abu-tammam",
  "title": "يَومَ الفِراقِ لَقَد خُلِقتَ طَويلا",
  "meter": "kamil",
  "rawiy": "ل",
  "abyat_in_full": 30,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "يَومَ الفِراقِ لَقَد خُلِقتَ طَويلا",
      "ajuz": "لَم تُبقِ لي جَلداً وَلا مَعقولا"
    },
    {
      "n": 2,
      "sadr": "لَو حارَ مُرتادُ المَنِيَّةِ لَم يُرِد",
      "ajuz": "إِلّا الفِراقَ عَلى النُّفوسِ دَليلا"
    },
    {
      "n": 3,
      "sadr": "قالوا الرَّحيلُ فَما شَكَكتُ بِأَنَّها",
      "ajuz": "نَفسي عَنِ الدُّنيا تُريدُ رَحيلا"
    },
    {
      "n": 4,
      "sadr": "الصَّبرُ أَجمَلُ غَيرَ أَن تَلَدُّداً",
      "ajuz": "في الحُبِّ أَحرى أَن يَكونَ جَميلا"
    },
    {
      "n": 5,
      "sadr": "أَتَظُنُّني أَجِدُ السَّبيلَ إِلى العَزا",
      "ajuz": "وَجَدَ الحِمامُ إِذاً إِلَيَّ سَبيلا"
    },
    {
      "n": 6,
      "sadr": "رَدُّ الجَموحِ الصَّعبِ أَسهَلُ مَطلَباً",
      "ajuz": "مِن رَدِّ دَمعٍ قَد أَصابَ مَسيلا"
    },
    {
      "n": 7,
      "sadr": "ذَكَرَتكُمُ الأَنواءُ ذِكرِيَ بَعضَكُم",
      "ajuz": "فَبَكَت عَلَيكُم بُكرَةً وَأَصيلا"
    },
    {
      "n": 8,
      "sadr": "وَبِنَفسِيَ القَمَرُ الَّذي بِمُحَجَّرٍ",
      "ajuz": "أَمسى مَصوناً لِلنَّوى مَبذولا"
    },
    {
      "n": 9,
      "sadr": "إِنّي تَأَمَّلتُ النَّوى فَوَجَدتُها",
      "ajuz": "سَيفاً عَلَيَّ مَعَ الهَوى مَسلولا"
    },
    {
      "n": 10,
      "sadr": "لا تَأخُذيني بِالزَّمانِ فَلَيسَ لي",
      "ajuz": "تَبَعاً وَلَستُ عَلى الزَّمانِ كَفيلا"
    },
    {
      "n": 11,
      "sadr": "مَن زاحَفَ الأَيّامَ ثُمَّ عَبا لَها",
      "ajuz": "غَيرَ القَناعَةِ لَم يَزَل مَفلولا"
    },
    {
      "n": 12,
      "sadr": "مَن كانَ مَرعى عَزمِهِ وَهُمومِهِ",
      "ajuz": "رَوضُ الأَماني لَم يَزَل مَهزولا"
    },
    {
      "n": 13,
      "sadr": "لَو جازَ سُلطانُ القُنوعِ وَحُكمُهُ",
      "ajuz": "في الخَلقِ ما كانَ القَليلُ قَليلا"
    },
    {
      "n": 14,
      "sadr": "الرِّزقَ لا تَكمَد عَلَيهِ فَإِنَّهُ",
      "ajuz": "يَأتي وَلَم تَبعَث إِلَيهِ رَسولا"
    },
    {
      "n": 15,
      "sadr": "لِلَّهِ دَرُّكِ أَيَّ مَعبَرِ قَفرَةٍ",
      "ajuz": "لا يوحِشُ اِبنَ البَيضَةِ الإِجفيلا"
    },
    {
      "n": 16,
      "sadr": "بِنتُ الفَضاءِ مَتى تَخِد بِكَ لا تَدَع",
      "ajuz": "في الصَّدرِ مِنكَ عَلى الفَلاةِ غَليلا"
    },
    {
      "n": 17,
      "sadr": "أَوَ ما تَراها ما تَراها هِزَّةً",
      "ajuz": "تَشأى العُيونَ تَعَجرُفاً وَذَميلا"
    },
    {
      "n": 18,
      "sadr": "لَو كانَ كَلَّفَها عُبَيدٌ حاجَةً",
      "ajuz": "يَوماً لَأُنسِيَ شَدقَماً وَجَديلا"
    },
    {
      "n": 19,
      "sadr": "بِالسَّكسَكِيِّ الماتِعِيِّ تَمَتَّعَت",
      "ajuz": "هِمَمٌ ثَنَت طَرفَ الزَّمانِ كَليلا"
    },
    {
      "n": 20,
      "sadr": "لا تَدعُوَنَّ نوحَ بنَ عَمرٍو دَعوَةً",
      "ajuz": "لِلخَطبِ إِلّا أَن يَكونَ جَليلا"
    },
    {
      "n": 21,
      "sadr": "يَقِظٌ إِذا ما المُشكِلاتُ عَرَونَهُ",
      "ajuz": "أَلفَينَهُ المُتَبَسِّمَ البُهلولا"
    },
    {
      "n": 22,
      "sadr": "ما زالَ يُبرِمُهُنَّ حَتّى إِنَّهُ",
      "ajuz": "لَيُقالُ ما خَلَقَ الإِلَهُ سَحيلا"
    },
    {
      "n": 23,
      "sadr": "ثَبتُ المَقامِ يَرى القَبيلَةَ واحِداً",
      "ajuz": "وَيُرى فَيَحسَبُهُ القَبيلُ قَبيلا"
    },
    {
      "n": 24,
      "sadr": "كَم وَقعَةٍ لَكَ في المَكارِمِ فَخمَةٍ",
      "ajuz": "غادَرتَ فيها ما مَلَكتَ قَتيلا"
    },
    {
      "n": 25,
      "sadr": "أَوطَأتَ أَرضَ البُخلِ فيها غارَةً",
      "ajuz": "تَرَكَت حُزونَ الحادِثاتِ سُهولا"
    },
    {
      "n": 26,
      "sadr": "فَرَأَيتَ أَكثَرَ ما حَبَوتَ مِنَ اللُّهى",
      "ajuz": "نَزراً وَأَصغَرَ ما شُكِرتَ جَزيلا"
    },
    {
      "n": 27,
      "sadr": "لَم يَتَّرِك في المَجدِ مَن جَعَلَ النَّدى",
      "ajuz": "في مالِهِ لِلمُعتَفينَ وَكيلا"
    },
    {
      "n": 28,
      "sadr": "أَوَلَيسَ عَمرٌو بَثَّ في النّاسِ النَّدى",
      "ajuz": "حَتّى اِشتَهَينا أَن نُصيبَ بَخيلا"
    },
    {
      "n": 29,
      "sadr": "اُشدُد يَدَيكَ بِحَبلِ نوحٍ مُعصِماً",
      "ajuz": "تَلقاهُ حَبلاً بِالنَّدى مَوصولا"
    },
    {
      "n": 30,
      "sadr": "ذاكَ الَّذي إِن كانَ خِلَّكَ لَم تَقُل",
      "ajuz": "يا لَيتَني لَم أَتَّخِذهُ خَليلا"
    }
  ]
}
