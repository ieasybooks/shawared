{
  "id": "ashibta-fatan",
  "poet": "ihab-al-shabatat",
  "title": "أَشِبتَ فَتىً وَقَبلَ ضُحى المَشيبِ",
  "meter": "wafir",
  "themes": ["shakwa"],
  "rawiy": "ب",
  "abyat_in_full": 27,
  "added": "2026-11-19",
  "abyat": [
    {"n": 1, "sadr": "أَشِبتَ فَتىً وَقَبلَ ضُحى المَشيبِ", "ajuz": "بَياضُ الفَجرِ آتٍ أَم مَغيبي"},
    {"n": 2, "sadr": "وَما كُرهاً سَعَيتُ لِذي خِصامٍ", "ajuz": "وَما كَرهاً بَدا حِلماً وَجيبي"},
    {"n": 3, "sadr": "فَطَيرٌ طارَ في عالي سَماءٍ", "ajuz": "كَقَلبي حينَ يَخفِقُ في السُّهوبِ"},
    {"n": 4, "sadr": "كَرَيحانٍ تُداعِبُهُ رِياحٌ", "ajuz": "فَيُهدي ريحَهُ وَقتَ الغُروبِ"},
    {"n": 5, "sadr": "كَقَطرَةِ ماءِ نَبعٍ في مُروجٍ", "ajuz": "تَطيرُ نَدىً بِصَوتِ العَندَليبِ"},
    {"n": 6, "sadr": "كَمَوجِ البَحرِ يَعلو مِن بَعيدٍ", "ajuz": "أَمامَ رِمالِ بَيداءٍ قَريبِ"},
    {"n": 7, "sadr": "كَلَيلٍ صامِتٍ يُلقي سُكوناً", "ajuz": "يُنيرُ نُجومَ أَكوانٍ رَحيبِ"},
    {"n": 8, "sadr": "وَما كُلُّ السُّكوتِ جَهالَةً قَد", "ajuz": "يَكونُ الصَّمتُ أَفصَحَ مِن أَديبِ"},
    {"n": 9, "sadr": "وَلَم أَعجَب كَظَنِّ النّاسِ حيناً", "ajuz": "خِصالَ السّابِقينَ مِنَ العُيوبِ"},
    {"n": 10, "sadr": "أَديمُ الأَرضِ تَصفَعُهُ المَنايا", "ajuz": "وَفيهِ أُمَّتي أَثَرُ النُّدوبِ"},
    {"n": 11, "sadr": "وَقَد كانَت كَعَذراءٍ صَبوحٍ", "ajuz": "لَعَمرُ أَبيكَ لَيسَت بِالمَعيبِ"},
    {"n": 12, "sadr": "أَلا يا أُختَ هارونَ الَّتي ما", "ajuz": "بَدَت مِن بَدئِها بِكرَ الخُطوبِ"},
    {"n": 13, "sadr": "أَجالَت في اللَّيالي عادِياتٌ", "ajuz": "لِتَغتَسِلي عَلى ماءِ الغَريبِ"},
    {"n": 14, "sadr": "مَآسينا كَعَنقاءٍ تَباهَت", "ajuz": "بِأَنَّ رَمادَها عَجبُ الحُروبِ"},
    {"n": 15, "sadr": "وَتَرشِفُ مِن غَضيضِ دَمٍ شَذانا", "ajuz": "تُحَلِّقُ فَوقَ خَضراءِ الدُّروبِ"},
    {"n": 16, "sadr": "تُلَوِّنُ ريشَها حيناً بِماءٍ", "ajuz": "أَسالَتهُ دَياجيرُ الشُّحوبِ"},
    {"n": 17, "sadr": "فَلا تُرِني جَمالاً في وُجوهٍ", "ajuz": "لِحُسنٍ لا يَبينُ مَعَ القُلوبِ"},
    {"n": 18, "sadr": "طَواحينُ الحَياةِ تَفيضُ ناساً", "ajuz": "وَريحُ الأَرضِ دارَت بِالحُبوبِ"},
    {"n": 19, "sadr": "وَهَمسُ اللَّيلِ أَنَّ الحَقَّ دُرٌّ", "ajuz": "تَناثَرَ شاهِداً بِدَمٍ رَطيبِ"},
    {"n": 20, "sadr": "أَلا لا تَلحَقي دَمعي بِعَينٍ", "ajuz": "لَقَد تاهَت دُموعي في الجُنوبِ"},
    {"n": 21, "sadr": "تَهُزُّ بِجِذعِ أَحشائي هُمومي", "ajuz": "وَمُؤقُ العَينِ دائِمَةُ السُّكوبِ"},
    {"n": 22, "sadr": "وَلَم أَجزَع عَلى الأَيّامِ لَكِن", "ajuz": "رَأَيتُ الرَّحلَ تَقطُرُ مِن ذُنوبي"},
    {"n": 23, "sadr": "وَسِرتُ مَعَ الدُّجى مُتَأَمِّلاً في", "ajuz": "ذُرى هَوَسي لِشَمسٍ في غُيوبِ"},
    {"n": 24, "sadr": "هَلِ الدُّنيا سَتَكشِفُ لي حِجاباً", "ajuz": "وَكُنهاً سالِفَ الأَرضِ اللَّغوبِ"},
    {"n": 25, "sadr": "أَرى ناساً رَدىً يَبكونَ نَفساً", "ajuz": "كَأَنَّ الدَّمعَ يَأتي مِن ضَريبِ"},
    {"n": 26, "sadr": "فَكَم أَحيا إِلَهي مِن رَميمٍ", "ajuz": "وَكَم أَفنى إِلَهي مِن طَبيبِ"},
    {"n": 27, "sadr": "هَديلُ حَمامَةٍ وَزَئيرُ أُسدٍ", "ajuz": "كَمالُ الغابِ في جَوٍّ عَجيبِ"}
  ]
}
