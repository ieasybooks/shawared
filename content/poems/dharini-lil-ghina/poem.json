{
  "id": "dharini-lil-ghina",
  "poet": "urwa-ibn-al-ward",
  "title": "ذَريني لِلغِنى أَسعى فَإِنّي",
  "meter": "wafir",
  "rawiy": "ر",
  "abyat_in_full": 5,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "ذَريني لِلغِنى أَسعى فَإِنّي",
      "ajuz": "رَأَيتُ النّاسَ شَرُّهُمُ الفَقيرُ"
    },
    {
      "n": 2,
      "sadr": "وَأَهوَنُهُم وَأَحقَرُهُم لَدَيهِم",
      "ajuz": "وَإِن أَمسى لَهُ كَرَمٌ وَخيرُ"
    },
    {
      "n": 3,
      "sadr": "وَيُقصى في النَّدِيِّ وَتَزدَريهِ",
      "ajuz": "حَليلَتُهُ وَيَنهَرُهُ الصَّغيرُ"
    },
    {
      "n": 4,
      "sadr": "وَتَلقى ذا الغِنى وَلَهُ جَلالٌ",
      "ajuz": "يَكادُ فُؤادُ صاحِبِهِ يَطيرُ"
    },
    {
      "n": 5,
      "sadr": "قَليلٌ ذَنبُهُ وَالذَّنبُ جَمٌّ",
      "ajuz": "وَلَكِنَّ الغِنى رَبٌّ غَفورُ"
    }
  ]
}
