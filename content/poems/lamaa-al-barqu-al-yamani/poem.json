{
  "id": "lamaa-al-barqu-al-yamani",
  "poet": "bulbul-al-gharam-al-hajiri",
  "title": "لَمَعَ البَرقُ اليَماني",
  "meter": "ramal",
  "rawiy": "ن",
  "abyat_in_full": 19,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "لَمَعَ البَرقُ اليَماني",
      "ajuz": "فَشَجاني ما شَجاني"
    },
    {
      "n": 2,
      "sadr": "ذِكرُ دَهري وَزَماني",
      "ajuz": "بِالحِمى أَيَّ زَمانِ"
    },
    {
      "n": 3,
      "sadr": "يا وَميضَ البَرقِ هَل تَر",
      "ajuz": "جِعُ أَوقاتُ التَّداني"
    },
    {
      "n": 4,
      "sadr": "وَتَرى يَجتَمِعُ الشَّم",
      "ajuz": "لُ وَأَحظى بِالأَماني"
    },
    {
      "n": 5,
      "sadr": "أَيَّ سَهمٍ فَوَّقَ البَي",
      "ajuz": "نُ مُصيباً وَرَماني"
    },
    {
      "n": 6,
      "sadr": "وَمَراراتِ كُؤوسٍ",
      "ajuz": "مِن تَجَنّيهِ سَقاني"
    },
    {
      "n": 7,
      "sadr": "أَبعَدَ الأَحبابَ عَنّي",
      "ajuz": "وَأَراني ما أَراني"
    },
    {
      "n": 8,
      "sadr": "يا خَليلَيَّ إِذا لَم",
      "ajuz": "تُسعِداني فَذَراني"
    },
    {
      "n": 9,
      "sadr": "هَذِهِ أَطلالُ سُعدى",
      "ajuz": "وَالحِمى وَالعَلَمانِ"
    },
    {
      "n": 10,
      "sadr": "أَينَ أَيّامُ التَّصابي",
      "ajuz": "وَالشَّبابِ العُنفُوانِ"
    },
    {
      "n": 11,
      "sadr": "حَيثُ مَجرى اللَّهوِ رَحبٌ",
      "ajuz": "وَالهَوى طَلقُ العِنانِ"
    },
    {
      "n": 12,
      "sadr": "وَالأَماني في أَمانٍ",
      "ajuz": "مِن صُروفِ الحَدَثانِ"
    },
    {
      "n": 13,
      "sadr": "ذَهَبَت تِلكَ البَشاشا",
      "ajuz": "تُ مَعَ الغيدِ الحِسانِ"
    },
    {
      "n": 14,
      "sadr": "وَأَمَرُّ العَيشِ عَيشٌ",
      "ajuz": "ذاهِبٌ بِالبُعدِ فانِ"
    },
    {
      "n": 15,
      "sadr": "مَن لِمَرعوبٍ طَليقِ ال",
      "ajuz": "دَّمعِ مَأسورِ الجَنانِ"
    },
    {
      "n": 16,
      "sadr": "دائِمِ الحُزنِ فَريدٍ",
      "ajuz": "في أَعالي حَفتَيانِ"
    }
  ]
}
