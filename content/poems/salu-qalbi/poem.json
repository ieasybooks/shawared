{
  "id": "salu-qalbi",
  "poet": "ahmad-shawqi",
  "title": "ذِكرى المَولِد",
  "meter": "wafir",
  "rawiy": "ب",
  "abyat_in_full": 71,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "سَلوا قَلبي غَداةَ سَلا وَثابا",
      "ajuz": "لَعَلَّ عَلى الجَمالِ لَهُ عِتابا"
    },
    {
      "n": 2,
      "sadr": "وَيُسأَلُ في الحَوادِثِ ذو صَوابٍ",
      "ajuz": "فَهَل تَرَكَ الجَمالُ لَهُ صَوابا"
    },
    {
      "n": 3,
      "sadr": "وَكُنتُ إِذا سَأَلتُ القَلبَ يَوماً",
      "ajuz": "تَوَلّى الدَّمعُ عَن قَلبي الجَوابا"
    },
    {
      "n": 4,
      "sadr": "وَلي بَينَ الضُّلوعِ دَمٌ وَلَحمٌ",
      "ajuz": "هُما الواهي الَّذي ثَكِلَ الشَّبابا"
    },
    {
      "n": 5,
      "sadr": "تَسَرَّبَ في الدُّموعِ فَقُلتُ وَلّى",
      "ajuz": "وَصَفَّقَ في الضُّلوعِ فَقُلتُ ثابا"
    },
    {
      "n": 6,
      "sadr": "وَلَو خُلِقَت قُلوبٌ مِن حَديدٍ",
      "ajuz": "لَما حَمَلَت كَما حَمَلَ العَذابا"
    },
    {
      "n": 7,
      "sadr": "وَأَحبابٍ سُقيتُ بِهِم سُلافاً",
      "ajuz": "وَكانَ الوَصلُ مِن قِصَرٍ حَبابا"
    },
    {
      "n": 8,
      "sadr": "وَنادَمنا الشَّبابَ عَلى بِساطٍ",
      "ajuz": "مِنَ اللَّذّاتِ مُختَلِفٍ شَرابا"
    },
    {
      "n": 9,
      "sadr": "وَكُلُّ بِساطِ عَيشٍ سَوفَ يُطوى",
      "ajuz": "وَإِن طالَ الزَّمانُ بِهِ وَطابا"
    },
    {
      "n": 10,
      "sadr": "كَأَنَّ القَلبَ بَعدَهُمُ غَريبٌ",
      "ajuz": "إِذا عادَتهُ ذِكرى الأَهلِ ذابا"
    },
    {
      "n": 11,
      "sadr": "وَلا يُنبيكَ عَن خُلُقِ اللَّيالي",
      "ajuz": "كَمَن فَقَدَ الأَحِبَّةَ وَالصَّحابا"
    },
    {
      "n": 12,
      "sadr": "أَخا الدُّنيا أَرى دُنياكَ أَفعى",
      "ajuz": "تُبَدِّلُ كُلَّ آوِنَةٍ إِهابا"
    }
  ]
}
