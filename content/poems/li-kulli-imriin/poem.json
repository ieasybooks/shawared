{
  "id": "li-kulli-imriin",
  "poet": "al-mutanabbi",
  "title": "لِكُلِّ اِمرِئٍ مِن دَهرِهِ ما تَعَوَّدا",
  "meter": "tawil",
  "rawiy": "د",
  "abyat_in_full": 42,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "لِكُلِّ اِمرِئٍ مِن دَهرِهِ ما تَعَوَّدا",
      "ajuz": "وَعادَةُ سَيفِ الدَّولَةِ الطَّعنُ في العِدا"
    },
    {
      "n": 2,
      "sadr": "وَأَن يُكذِبَ الإِرجافَ عَنهُ بِضِدِّهِ",
      "ajuz": "وَيُمسي بِما تَنوي أَعاديهِ أَسعَدا"
    },
    {
      "n": 3,
      "sadr": "وَرُبَّ مُريدٍ ضَرَّهُ ضَرَّ نَفسَهُ",
      "ajuz": "وَهادٍ إِلَيهِ الجَيشَ أَهدى وَما هَدى"
    },
    {
      "n": 4,
      "sadr": "وَمُستَكبِرٍ لَم يَعرِفِ اللَّهَ ساعَةً",
      "ajuz": "رَأى سَيفَهُ في كَفِّهِ فَتَشَهَّدا"
    },
    {
      "n": 5,
      "sadr": "هُوَ البَحرُ غُص فيهِ إِذا كانَ ساكِناً",
      "ajuz": "عَلى الدُّرِّ وَاحذَرهُ إِذا كانَ مُزبِدا"
    },
    {
      "n": 6,
      "sadr": "فَإِنّي رَأَيتُ البَحرَ يَعثُرُ بِالفَتى",
      "ajuz": "وَهَذا الَّذي يَأتي الفَتى مُتَعَمِّدا"
    },
    {
      "n": 7,
      "sadr": "تَظَلُّ مُلوكُ الأَرضِ خاشِعَةً لَهُ",
      "ajuz": "تُفارِقُهُ هَلكى وَتَلقاهُ سُجَّدا"
    },
    {
      "n": 8,
      "sadr": "وَتُحيي لَهُ المالَ الصَّوارِمُ وَالقَنا",
      "ajuz": "وَيَقتُلُ ما يُحيي التَّبَسُّمُ وَالجَدا"
    },
    {
      "n": 9,
      "sadr": "ذَكيٌّ تَظَنّيهِ طَليعَةُ عَينِهِ",
      "ajuz": "يَرى قَلبُهُ في يَومِهِ ما تَرى غَدا"
    },
    {
      "n": 10,
      "sadr": "وَصولٌ إِلى المُستَصعَباتِ بِخَيلِهِ",
      "ajuz": "فَلَو كانَ قَرنُ الشَّمسِ ماءً لَأَورَدا"
    },
    {
      "n": 11,
      "sadr": "لِذَلِكَ سَمّى اِبنُ الدُّمُستُقِ يَومَهُ",
      "ajuz": "مَماتاً وَسَمّاهُ الدُّمُستُقُ مَولِدا"
    },
    {
      "n": 12,
      "sadr": "سَرَيتَ إِلى جَيحانَ مِن أَرضِ آمِدٍ",
      "ajuz": "ثَلاثاً لَقَد أَدناكَ رَكضٌ وَأَبعَدا"
    },
    {
      "n": 13,
      "sadr": "فَوَلّى وَأَعطاكَ اِبنَهُ وَجُيوشَهُ",
      "ajuz": "جَميعاً وَلَم يُعطِ الجَميعَ لِيُحمَدا"
    },
    {
      "n": 14,
      "sadr": "عَرَضتَ لَهُ دونَ الحَياةِ وَطَرفِهِ",
      "ajuz": "وَأَبصَرَ سَيفَ اللَّهِ مِنكَ مُجَرَّدا"
    },
    {
      "n": 15,
      "sadr": "وَما طَلَبَت زُرقُ الأَسِنَّةِ غَيرَهُ",
      "ajuz": "وَلَكِنَّ قُسطَنطينَ كانَ لَهُ الفِدا"
    },
    {
      "n": 16,
      "sadr": "فَأَصبَحَ يَجتابُ المُسوحَ مَخافَةً",
      "ajuz": "وَقَد كانَ يَجتابُ الدِّلاصَ المُسَرَّدا"
    },
    {
      "n": 17,
      "sadr": "وَيَمشي بِهِ العُكّازُ في الدَّيرِ تائِباً",
      "ajuz": "وَما كانَ يَرضى مَشيَ أَشقَرَ أَجرَدا"
    },
    {
      "n": 18,
      "sadr": "وَما تابَ حَتّى غادَرَ الكَرُّ وَجهَهُ",
      "ajuz": "جَريحاً وَخَلّى جَفنَهُ النَّقعُ أَرمَدا"
    },
    {
      "n": 19,
      "sadr": "فَلَو كانَ يُنجي مِن عَليٍّ تَرَهُّبٌ",
      "ajuz": "تَرَهَّبَتِ الأَملاكُ مَثنى وَمَوحَدا"
    },
    {
      "n": 20,
      "sadr": "وَكُلُّ اِمرِئٍ في الشَّرقِ وَالغَربِ بَعدَها",
      "ajuz": "يُعِدُّ لَهُ ثَوباً مِنَ الشَّعرِ أَسوَدا"
    },
    {
      "n": 21,
      "sadr": "هَنيئاً لَكَ العيدُ الَّذي أَنتَ عيدُهُ",
      "ajuz": "وَعيدٌ لِمَن سَمّى وَضَحّى وَعَيَّدا"
    },
    {
      "n": 22,
      "sadr": "وَلا زالَتِ الأَعيادُ لُبسَكَ بَعدَهُ",
      "ajuz": "تُسَلِّمُ مَخروقاً وَتُعطى مُجَدَّدا"
    },
    {
      "n": 23,
      "sadr": "فَذا اليَومُ في الأَيّامِ مِثلُكَ في الوَرى",
      "ajuz": "كَما كُنتَ فيهِم أَوحَداً كانَ أَوحَدا"
    },
    {
      "n": 24,
      "sadr": "هُوَ الجَدُّ حَتّى تَفضُلَ العَينُ أُختَها",
      "ajuz": "وَحَتّى يَصيرَ اليَومُ لِليَومِ سَيِّدا"
    },
    {
      "n": 25,
      "sadr": "فَيا عَجَباً مِن دائِلٍ أَنتَ سَيفُهُ",
      "ajuz": "أَما يَتَوَقّى شَفرَتَي ما تَقَلَّدا"
    },
    {
      "n": 26,
      "sadr": "وَمَن يَجعَلِ الضِّرغامَ بازاً لِصَيدِهِ",
      "ajuz": "تَصَيَّدَهُ الضِّرغامُ فيما تَصَيَّدا"
    },
    {
      "n": 27,
      "sadr": "رَأَيتُكَ مَحضَ الحِلمِ في مَحضِ قُدرَةٍ",
      "ajuz": "وَلَو شِئتَ كانَ الحِلمُ مِنكَ المُهَنَّدا"
    },
    {
      "n": 28,
      "sadr": "وَما قَتَلَ الأَحرارَ كَالعَفوِ عَنهُمُ",
      "ajuz": "وَمَن لَكَ بِالحُرِّ الَّذي يَحفَظُ اليَدا"
    },
    {
      "n": 29,
      "sadr": "إِذا أَنتَ أَكرَمتَ الكَريمَ مَلَكتَهُ",
      "ajuz": "وَإِن أَنتَ أَكرَمتَ اللَّئيمَ تَمَرَّدا"
    },
    {
      "n": 30,
      "sadr": "وَوَضعُ النَّدى في مَوضِعِ السَّيفِ بِالعُلا",
      "ajuz": "مُضِرٌّ كَوَضعِ السَّيفِ في مَوضِعِ النَّدى"
    },
    {
      "n": 31,
      "sadr": "وَلَكِن تَفوقُ النّاسَ رَأياً وَحِكمَةً",
      "ajuz": "كَما فُقتَهُم حالاً وَنَفساً وَمَحتِدا"
    },
    {
      "n": 32,
      "sadr": "يَدِقُّ عَلى الأَفكارِ ما أَنتَ فاعِلٌ",
      "ajuz": "فَيُترَكُ ما يَخفى وَيُؤخَذُ ما بَدا"
    },
    {
      "n": 33,
      "sadr": "أَزِل حَسَدَ الحُسّادِ عَنّي بِكَبتِهِم",
      "ajuz": "فَأَنتَ الَّذي صَيَّرتَهُم لِيَ حُسَّدا"
    },
    {
      "n": 34,
      "sadr": "إِذا شَدَّ زَندي حُسنُ رَأيِكَ فيهِمِ",
      "ajuz": "ضَرَبتُ بِسَيفٍ يَقطَعُ الهامَ مُغمَدا"
    },
    {
      "n": 35,
      "sadr": "وَما أَنا إِلّا سَمهَرِيٌّ حَمَلتَهُ",
      "ajuz": "فَزَيَّنَ مَعروضاً وَراعَ مُسَدَّدا"
    },
    {
      "n": 36,
      "sadr": "وَما الدَّهرُ إِلّا مِن رُواةِ قَصائِدي",
      "ajuz": "إِذا قُلتُ شِعراً أَصبَحَ الدَّهرُ مُنشِدا"
    },
    {
      "n": 37,
      "sadr": "فَسارَ بِهِ مَن لا يَسيرُ مُشَمِّرا",
      "ajuz": "وَغَنّى بِهِ مَن لا يُغَنّي مُغَرِّدا"
    },
    {
      "n": 38,
      "sadr": "أَجِزني إِذا أُنشِدتَ شِعراً فَإِنَّما",
      "ajuz": "بِشِعري أَتاكَ المادِحونَ مُرَدَّدا"
    },
    {
      "n": 39,
      "sadr": "وَدَع كُلَّ صَوتٍ غَيرَ صَوتي فَإِنَّني",
      "ajuz": "أَنا الصّائِحُ المَحكِيُّ وَالآخَرُ الصَّدى"
    },
    {
      "n": 40,
      "sadr": "تَرَكتُ السُّرى خَلفي لِمَن قَلَّ مالُهُ",
      "ajuz": "وَأَنعَلتُ أَفراسي بِنُعماكَ عَسجَدا"
    },
    {
      "n": 41,
      "sadr": "وَقَيَّدتُ نَفسي في ذَراكَ مَحَبَّةً",
      "ajuz": "وَمَن وَجَدَ الإِحسانَ قَيداً تَقَيَّدا"
    },
    {
      "n": 42,
      "sadr": "إِذا سَأَلَ الإِنسانُ أَيّامَهُ الغِنى",
      "ajuz": "وَكُنتَ عَلى بُعدٍ جَعَلنَكَ مَوعِدا"
    }
  ]
}
