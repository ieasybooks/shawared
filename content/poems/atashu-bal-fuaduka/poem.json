{
  "id": "atashu-bal-fuaduka",
  "poet": "jarir",
  "title": "أَتَصحو بَل فُؤادُكَ غَيرُ صاحِ",
  "meter": "wafir",
  "rawiy": "ح",
  "abyat_in_full": 22,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَتَصحو بَل فُؤادُكَ غَيرُ صاحِ",
      "ajuz": "عَشِيَّةَ هَمَّ صَحبُكَ بِالرَّواحِ"
    },
    {
      "n": 2,
      "sadr": "يَقولُ العاذِلاتُ عَلاكَ شَيبٌ",
      "ajuz": "أَهَذا الشَّيبُ يَمنَعُني مِراحي"
    },
    {
      "n": 3,
      "sadr": "يُكَلِّفُني فُؤادي مِن هَواهُ",
      "ajuz": "ظَعائِنَ يَجتَزِعنَ عَلى رُماحِ"
    },
    {
      "n": 4,
      "sadr": "ظَعائِنَ لَم يَدِنَّ مَعَ النَّصارى",
      "ajuz": "وَلا يَدرينَ ما سَمَكُ القَراحِ"
    },
    {
      "n": 5,
      "sadr": "فَبَعضُ الماءِ ماءُ رَبابِ مُزنٍ",
      "ajuz": "وَبَعضُ الماءِ مِن سَبَخٍ مِلاحِ"
    },
    {
      "n": 6,
      "sadr": "سَيَكفيكَ العَواذِلَ أَرحَبِيٌّ",
      "ajuz": "هِجانُ اللَّونِ كَالفَرَدِ اللَّياحِ"
    },
    {
      "n": 7,
      "sadr": "يَعُزُّ عَلى الطَّريقِ بِمَنكِبَيهِ",
      "ajuz": "كَما اِبتَرَكَ الخَليعُ عَلى القِداحِ"
    },
    {
      "n": 8,
      "sadr": "تَعَزَّت أُمُّ حَزرَةَ ثُمَّ قالَت",
      "ajuz": "رَأَيتُ الوارِدينَ ذَوي اِمتِناحِ"
    },
    {
      "n": 9,
      "sadr": "تُعَلِّلُ وَهيَ ساغِبَةٌ بَنيها",
      "ajuz": "بِأَنفاسٍ مِنَ الشَّبِمِ القَراحِ"
    },
    {
      "n": 10,
      "sadr": "سَأَمتاحُ البُحورَ فَجَنِّبيني",
      "ajuz": "أَذاةَ اللَّومِ وَانتَظِري اِمتِياحي"
    },
    {
      "n": 11,
      "sadr": "ثِقي بِاللَّهِ لَيسَ لَهُ شَريكٌ",
      "ajuz": "وَمِن عِندِ الخَليفَةِ بِالنَّجاحِ"
    },
    {
      "n": 12,
      "sadr": "أَغِثني يا فِداكَ أَبي وَأُمّي",
      "ajuz": "بِسَيبٍ مِنكَ إِنَّكَ ذو اِرتِياحِ"
    },
    {
      "n": 13,
      "sadr": "فَإِنّي قَد رَأَيتُ عَلَيَّ حَقّاً",
      "ajuz": "زِيارَتِيَ الخَليفَةَ وَامتِداحي"
    },
    {
      "n": 14,
      "sadr": "سَأَشكُرُ أَن رَدَدتَ عَلَيَّ ريشي",
      "ajuz": "وَأَثبَتَّ القَوادِمَ في جَناحي"
    },
    {
      "n": 15,
      "sadr": "أَلَستُم خَيرَ مَن رَكِبَ المَطايا",
      "ajuz": "وَأَندى العالَمينَ بُطونَ راحِ"
    },
    {
      "n": 16,
      "sadr": "وَقَومٍ قَد سَمَوتَ لَهُم فَدانوا",
      "ajuz": "بِدُهمٍ في مُلَملَمَةٍ رَداحِ"
    },
    {
      "n": 17,
      "sadr": "أَبَحتَ حِمى تِهامَةَ بَعدَ نَجدٍ",
      "ajuz": "وَما شَيءٌ حَمَيتَ بِمُستَباحِ"
    },
    {
      "n": 18,
      "sadr": "لَكُم شُمُّ الجِبالِ مِنَ الرَّواسي",
      "ajuz": "وَأَعظَمُ سَيلِ مُعتَلِجِ البِطاحِ"
    },
    {
      "n": 19,
      "sadr": "دَعَوتَ المُلحِدينَ أَبا خُبَيبٍ",
      "ajuz": "جِماحاً هَل شُفيتَ مِنَ الجِماحِ"
    },
    {
      "n": 20,
      "sadr": "فَقَد وَجَدوا الخَليفَةَ هِبرِزِيّاً",
      "ajuz": "أَلَفَّ العيصِ لَيسَ مِنَ النَّواحي"
    },
    {
      "n": 21,
      "sadr": "فَما شَجَراتُ عيصِكَ في قُرَيشٍ",
      "ajuz": "بِعَشّاتِ الفُروعِ وَلا ضَواحي"
    },
    {
      "n": 22,
      "sadr": "رَأى النّاسُ البَصيرَةَ فَاستَقاموا",
      "ajuz": "وَبَيَّنتَ المِراضَ مِنَ الصِّحاحِ"
    }
  ]
}
