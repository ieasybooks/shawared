{
  "id": "khalilayya-ma-lil-hubbi",
  "poet": "ali-ibn-al-jahm",
  "title": "خَليلَيَّ ما لِلحُبِّ يَزدادُ جِدَّةً",
  "meter": "tawil",
  "themes": ["ghazal", "shawq"],
  "rawiy": "د",
  "abyat_in_full": 10,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "خَليلَيَّ ما لِلحُبِّ يَزدادُ جِدَّةً",
      "ajuz": "عَلى الدَّهرِ وَالأَيّامُ يَبلى جَديدُها"
    },
    {
      "n": 2,
      "sadr": "وَما لِعُهودِ الغانِياتِ ذَميمَةٌ",
      "ajuz": "وَلَيلى حَرامٌ أَن تُذَمَّ عُهودُها"
    },
    {
      "n": 3,
      "sadr": "أَلَمَّت وَجُنحُ اللَّيلِ مُرخٍ سُدولَهُ",
      "ajuz": "وَلِلسِّجنِ أَحراسٌ قَليلٌ هُجودُها"
    },
    {
      "n": 4,
      "sadr": "فَقُلتُ لَها أَنّى تَجَشَّمتِ خُطَّةً",
      "ajuz": "يُحَرِّجُ أَنفاسَ الرِّياحِ وُرودُها"
    },
    {
      "n": 5,
      "sadr": "فَقالَت أَطَعنا الشَّوقَ بَعدَ تَجَلُّدٍ",
      "ajuz": "وَشَرُّ قُلوبِ العاشِقينَ جَليدُها"
    },
    {
      "n": 6,
      "sadr": "وَأَعلَنتِ الشَّكوى وَجالَت دُموعُها",
      "ajuz": "عَلى الخَدِّ لَمّا اِلتَفَّ بِالجيدِ جيدُها"
    },
    {
      "n": 7,
      "sadr": "فَقُلتُ لَها وَالدَّمعُ شَتّى طَريقُهُ",
      "ajuz": "وَنارُ الهَوى بِالشَّوقِ يُذكى وُقودُها"
    },
    {
      "n": 8,
      "sadr": "إِذا سَلِمَت نَفسُ الحَبيبِ تَشابَهَت",
      "ajuz": "صُروفُ اللَّيالي سَهلُها وَشَديدُها"
    },
    {
      "n": 9,
      "sadr": "فَلا تَجزَعي إِمّا رَأَيتِ قُيودَهُ",
      "ajuz": "فَإِنَّ خَلاخيلَ الرِّجالِ قُيودُها"
    },
    {
      "n": 10,
      "sadr": "وَلا تُنكِري حالَ الرَّخاءِ وَفَوتَهُ",
      "ajuz": "فَإِنَّ أَميرَ المُؤمِنينَ يُعيدُها"
    }
  ]
}
