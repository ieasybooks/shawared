{
  "id": "sali-al-rimaha",
  "poet": "safi-al-din-al-hilli",
  "title": "سَلي الرِّماحَ العَوالي عَن مَعالينا",
  "meter": "basit",
  "rawiy": "ن",
  "abyat_in_full": 33,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "سَلي الرِّماحَ العَوالي عَن مَعالينا", "ajuz": "وَاستَشهِدي البيضَ هَل خابَ الرَّجا فينا" },
    { "n": 2,  "sadr": "وَسائِلي العُربَ وَالأَتراكَ ما فَعَلَت", "ajuz": "في أَرضِ قَبرِ عُبَيدِ اللَّهِ أَيدينا" },
    { "n": 3,  "sadr": "لَمّا سَعَينا فَما رَقَّت عَزائِمُنا", "ajuz": "عَمّا نَرومُ وَلا خابَت مَساعينا" },
    { "n": 4,  "sadr": "يا يَومَ وَقعَةِ زَوراءِ العِراقِ وَقَد", "ajuz": "دِنّا الأَعادي كَما كانوا يَدينونا" },
    { "n": 5,  "sadr": "بِضُمَّرٍ ما رَبَطناها مُسَوَّمَةً", "ajuz": "إِلّا لِنَغزو بِها مَن باتَ يَغزونا" },
    { "n": 6,  "sadr": "وَفِتيَةٍ إِن نَقُل أَصغَوا مَسامِعَهُم", "ajuz": "لِقَولِنا أَو دَعَوناهُم أَجابونا" },
    { "n": 7,  "sadr": "قَومٌ إِذا اُستُخصِموا كانوا فَراعِنَةً", "ajuz": "يَوماً وَإِن حُكِّموا كانوا مَوازينا" },
    { "n": 8,  "sadr": "تَدَرَّعوا العَقلَ جِلباباً فَإِن حَمِيَت", "ajuz": "نارُ الوَغى خِلتَهُم فيها مَجانينا" },
    { "n": 9,  "sadr": "إِذا اِدَّعَوا جاءَتِ الدُّنيا مُصَدِّقَةً", "ajuz": "وَإِن دَعَوا قالَتِ الأَيّامُ آمينا" },
    { "n": 10, "sadr": "إِنَّ الزَّرازيرَ لَمّا قامَ قائِمُها", "ajuz": "تَوَهَّمَت أَنَّها صارَت شَواهينا" },
    { "n": 11, "sadr": "ظَنَّت تَأَنّي البُزاةِ الشُّهبِ عَن جَزَعٍ", "ajuz": "وَما دَرَت أَنَّهُ قَد كانَ تَهوينا" },
    { "n": 12, "sadr": "بَيادِقٌ ظَفِرَت أَيدي الرِّخاخِ بِها", "ajuz": "وَلَو تَرَكناهُمُ صادوا فَرازينا" },
    { "n": 13, "sadr": "ذَلّوا بِأَسيافِنا طولَ الزَّمانِ فَمُذ", "ajuz": "تَحَكَّموا أَظهَروا أَحقادَهُم فينا" },
    { "n": 14, "sadr": "لَم يُغنِهِم مالُنا عَن نَهبِ أَنفُسِنا", "ajuz": "كَأَنَّهُم في أَمانٍ مِن تَقاضينا" },
    { "n": 15, "sadr": "أَخلَوا المَساجِدَ مِن أَشياخِنا وَبَغَوا", "ajuz": "حَتّى حَمَلنا فَأَخلَينا الدَّواوينا" },
    { "n": 16, "sadr": "ثُمَّ اِنثَنَينا وَقَد ظَلَّت صَوارِمُنا", "ajuz": "تَميسُ عُجباً وَيَهتَزُّ القَنا لينا" },
    { "n": 17, "sadr": "وَلِلدِّماءِ عَلى أَثوابِنا عَلَقٌ", "ajuz": "بِنَشرِهِ عَن عَبيرِ المِسكِ يُغنينا" },
    { "n": 18, "sadr": "فَيا لَها دَعوَةً في الأَرضِ سائِرَةً", "ajuz": "قَد أَصبَحَت في فَمِ الأَيّامِ تَلقينا" },
    { "n": 19, "sadr": "إِنّا لَقَومٌ أَبَت أَخلاقُنا شَرَفاً", "ajuz": "أَن نَبتَدي بِالأَذى مَن لَيسَ يُؤذينا" },
    { "n": 20, "sadr": "بيضٌ صَنائِعُنا سودٌ وَقائِعُنا", "ajuz": "خُضرٌ مَرابِعُنا حُمرٌ مَواضينا" },
    { "n": 21, "sadr": "لا يَظهَرُ العَجزُ مِنّا دونَ نَيلِ مُنىً", "ajuz": "وَلَو رَأَينا المَنايا في أَمانينا" },
    { "n": 22, "sadr": "ما أَعوَزَتنا فَرامينٌ نَصولُ بِها", "ajuz": "إِلّا جَعَلنا مَواضينا فَرامينا" },
    { "n": 23, "sadr": "إِذا جَرَينا إِلى سَبقِ العُلى طَلَقاً", "ajuz": "إِن لَم نَكُن سُبَّقاً كُنّا مُصَلّينا" },
    { "n": 24, "sadr": "تُدافِعُ القَدَرَ المَحتومَ هِمَّتُنا", "ajuz": "عَنّا وَنَخصِمُ صَرفَ الدَّهرِ لَو شينا" },
    { "n": 25, "sadr": "نَغشى الخُطوبَ بِأَيدينا فَنَدفَعُها", "ajuz": "وَإِن دَهَتنا دَفَعناها بِأَيدينا" },
    { "n": 26, "sadr": "مُلكٌ إِذا فُوِّقَت نَبلُ العَدُوِّ لَنا", "ajuz": "رَمَت عَزائِمُهُ مَن باتَ يَرمينا" },
    { "n": 27, "sadr": "عَزائِمٌ كَالنُّجومِ الشُّهبِ ثاقِبَةً", "ajuz": "ما زالَ يُحرِقُ مِنهُنَّ الشَّياطينا" },
    { "n": 28, "sadr": "أَعطى فَلا جودُهُ قَد كانَ عَن غَلَطٍ", "ajuz": "مِنهُ وَلا أَجرُهُ قَد كانَ مَمنونا" },
    { "n": 29, "sadr": "كَم مِن عَدُوٍّ لَنا أَمسى بِسَطوَتِهِ", "ajuz": "يُبدي الخُضوعَ لَنا خَتلاً وَتَسكينا" },
    { "n": 30, "sadr": "كَالصِّلِّ يُظهِرُ ليناً عِندَ مَلمَسِهِ", "ajuz": "حَتّى يُصادِفَ في الأَعضاءِ تَمكينا" },
    { "n": 31, "sadr": "يَطوي لَنا الغَدرَ في نُصحٍ يُشيرُ بِهِ", "ajuz": "وَيَمزُجُ السُّمَّ في شَهدٍ وَيَسقينا" },
    { "n": 32, "sadr": "وَقَد نَغُضُّ وَنُغضي عَن قَبائِحِهِ", "ajuz": "وَلَم يَكُن عَجَزاً عَنهُ تَغاضينا" }
  ]
}
