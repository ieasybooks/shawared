    { "n": 97,  "sadr": "وَدَنَّسَ ما تَطَهَّرَ مِنكَ حَتّى",      "ajuz": "كَأَنَّكَ قَبلَ ذَلِكَ ما طَهَرتا" },
    { "n": 98,  "sadr": "وَصِرتَ أَسيرَ ذَنبِكَ في وَثاقٍ",      "ajuz": "وَكَيفَ لَكَ الفَكاكُ وَقَد أُسِرتا" },
    { "n": 99,  "sadr": "وَخَف أَبناءَ جِنسِكَ وَاخشَ مِنهُم", "ajuz": "كَما تَخشى الضَّراغِمَ وَالسَّبَنتى" },
    { "n": 100, "sadr": "وَخالِطهُم وَزايِلهُم حِذاراً",       "ajuz": "وَكُن كَالسّامِرِيِّ إِذا لُمِستا" },
    { "n": 101, "sadr": "وَإِن جَهِلوا عَلَيكَ فَقُل سَلاماً",   "ajuz": "لَعَلَّكَ سَوفَ تَسلَمُ إِن فَعَلتا" },
    { "n": 102, "sadr": "وَمَن لَكَ بِالسَّلامَةِ في زَمانٍ",     "ajuz": "يَنالُ العُصمَ إِلّا إِن عُصِمتا" },
    { "n": 103, "sadr": "وَلا تَلبَث بِحَيٍّ فيهِ ضَيمٌ",        "ajuz": "يُميتُ القَلبَ إِلّا إِن كُبِلتا" },
    { "n": 104, "sadr": "وَغَرِّب فَالغَريبُ لَهُ نَفاقٌ",         "ajuz": "وَشَرِّق إِن بِريقِكَ قَد شَرِقتا" },
    { "n": 105, "sadr": "فَلَيسَ الزُّهدُ في الدُّنيا خُمولاً", "ajuz": "لَأَنتَ بِها الأَميرُ إِذا زَهِدتا" },
    { "n": 106, "sadr": "وَلَو فَوقَ الأَميرِ تَكونُ فيها",     "ajuz": "سُمُوّاً وَافتِخاراً كُنتَ أَنتا" },
    { "n": 107, "sadr": "وَإِن فَرَّقتَها وَخَرَجتَ مِنها",     "ajuz": "إِلى دارِ السَّلامِ فَقَد سَلِمتا" },
