{
  "id": "a-min-al-manuni",
  "poet": "abu-dhuayb-al-hudhali",
  "title": "أَمِنَ المَنونِ وَرَيبِها تَتَوَجَّعُ",
  "meter": "kamil",
  "themes": ["ritha", "hikma"],
  "rawiy": "ع",
  "abyat_in_full": 69,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَمِنَ المَنونِ وَرَيبِها تَتَوَجَّعُ",
      "ajuz": "وَالدَّهرُ لَيسَ بِمُعتِبٍ مَن يَجزَعُ"
    },
    {
      "n": 2,
      "sadr": "قالَت أُمَيمَةُ ما لِجِسمِكَ شاحِباً",
      "ajuz": "مُنذُ اِبتَذَلتَ وَمِثلُ مالِكَ يَنفَعُ"
    },
    {
      "n": 3,
      "sadr": "أَم ما لِجَنبِكَ لا يُلائِمُ مَضجَعاً",
      "ajuz": "إِلّا أَقَضَّ عَلَيكَ ذاكَ المَضجَعُ"
    },
    {
      "n": 4,
      "sadr": "فَأَجَبتُها أَن ما لِجِسمِيَ أَنَّهُ",
      "ajuz": "أَودى بَنِيَّ مِنَ البِلادِ وَوَدَّعوا"
    },
    {
      "n": 5,
      "sadr": "أَودى بَنِيَّ وَأَعقَبوني غُصَّةً",
      "ajuz": "بَعدَ الرُّقادِ وَعَبرَةً لا تُقلِعُ"
    },
    {
      "n": 6,
      "sadr": "سَبَقوا هَوَيَّ وَأَعنَقوا لِهَواهُمُ",
      "ajuz": "فَتُخُرِّموا وَلِكُلِّ جَنبٍ مَصرَعُ"
    },
    {
      "n": 7,
      "sadr": "فَغَبَرتُ بَعدَهُمُ بِعَيشٍ ناصِبٍ",
      "ajuz": "وَإِخالُ أَنّي لاحِقٌ مُستَتبَعُ"
    },
    {
      "n": 8,
      "sadr": "وَلَقَد حَرِصتُ بِأَن أُدافِعَ عَنهُمُ",
      "ajuz": "فَإِذا المَنِيَّةُ أَقبَلَت لا تُدفَعُ"
    },
    {
      "n": 9,
      "sadr": "وَإِذا المَنِيَّةُ أَنشَبَت أَظفارَها",
      "ajuz": "أَلفَيتَ كُلَّ تَميمَةٍ لا تَنفَعُ"
    },
    {
      "n": 10,
      "sadr": "فَالعَينُ بَعدَهُمُ كَأَنَّ حِداقَها",
      "ajuz": "سُمِلَت بِشَوكٍ فَهيَ عورٌ تَدمَعُ"
    },
    {
      "n": 11,
      "sadr": "حَتّى كَأَنّي لِلحَوادِثِ مَروَةٌ",
      "ajuz": "بِصَفا المُشَرَّقِ كُلَّ يَومٍ تُقرَعُ"
    },
    {
      "n": 12,
      "sadr": "لا بُدَّ مِن تَلَفٍ مُقيمٍ فَانتَظِر",
      "ajuz": "أَبِأَرضِ قَومِكَ أَم بِأُخرى المَصرَعُ"
    },
    {
      "n": 13,
      "sadr": "وَلَقَد أَرى أَنَّ البُكاءَ سَفاهَةٌ",
      "ajuz": "وَلَسَوفَ يولَعُ بِالبُكا مَن يُفجَعُ"
    },
    {
      "n": 14,
      "sadr": "وَلَيَأتِيَنَّ عَلَيكَ يَومٌ مَرَّةً",
      "ajuz": "يُبكى عَلَيكَ مُقَنَّعاً لا تَسمَعُ"
    },
    {
      "n": 15,
      "sadr": "وَتَجَلُّدي لِلشّامِتينَ أُريهِمُ",
      "ajuz": "أَنّي لِرَيبِ الدَّهرِ لا أَتَضَعضَعُ"
    },
    {
      "n": 16,
      "sadr": "وَالنَّفسُ راغِبَةٌ إِذا رَغَّبتَها",
      "ajuz": "فَإِذا تُرَدُّ إِلى قَليلٍ تَقنَعُ"
    },
    {
      "n": 17,
      "sadr": "كَم مِن جَميعِ الشَّملِ مُلتَئِمِ الهَوى",
      "ajuz": "باتوا بِعَيشٍ ناعِمٍ فَتَصَدَّعوا"
    },
    {
      "n": 18,
      "sadr": "فَلَئِن بِهِم فَجَعَ الزَّمانُ وَرَيبُهُ",
      "ajuz": "إِنّي بِأَهلِ مَوَدَّتي لَمُفَجَّعُ"
    },
    {
      "n": 19,
      "sadr": "وَالدَّهرُ لا يَبقى عَلى حَدَثانِهِ",
      "ajuz": "في رَأسِ شاهِقَةٍ أَعَزُّ مُمَنَّعُ"
    },
    {
      "n": 20,
      "sadr": "وَالدَّهرُ لا يَبقى عَلى حَدَثانِهِ",
      "ajuz": "جَونُ السَّراةِ لَهُ جَدائِدُ أَربَعُ"
    },
    {
      "n": 21,
      "sadr": "صَخِبُ الشَّوارِبِ لا يَزالُ كَأَنَّهُ",
      "ajuz": "عَبدٌ لِآلِ أَبي رَبيعَةَ مُسبَعُ"
    },
    {
      "n": 22,
      "sadr": "أَكَلَ الجَميمَ وَطاوَعَتهُ سَمحَجٌ",
      "ajuz": "مِثلُ القَناةِ وَأَزعَلَتهُ الأَمرُعُ"
    },
    {
      "n": 23,
      "sadr": "بِقَرارِ قيعانٍ سَقاها وابِلٌ",
      "ajuz": "واهٍ فَأَثجَمَ بُرهَةً لا يُقلِعُ"
    },
    {
      "n": 24,
      "sadr": "فَلَبِثنَ حيناً يَعتَلِجنَ بِرَوضَةٍ",
      "ajuz": "فَيَجِدُّ حيناً في العِلاجِ وَيَشمَعُ"
    },
    {
      "n": 25,
      "sadr": "حَتّى إِذا جَزَرَت مِياهُ رُزونِهِ",
      "ajuz": "وَبِأَيِّ حينِ مِلاوَةٍ تَتَقَطَّعُ"
    },
    {
      "n": 26,
      "sadr": "ذَكَرَ الوُرودَ بِها وَشاقى أَمرَهُ",
      "ajuz": "شُؤمٌ وَأَقبَلَ حَينُهُ يَتَتَبَّعُ"
    },
    {
      "n": 27,
      "sadr": "فَافتَنَّهُنَّ مِنَ السَّواءِ وَماؤُهُ",
      "ajuz": "بَثرٌ وَعانَدَهُ طَريقٌ مَهيَعُ"
    },
    {
      "n": 28,
      "sadr": "فَكَأَنَّها بِالجِزعِ بَينَ يُنابِعٍ",
      "ajuz": "وَأُولاتِ ذي العَرجاءِ نَهبٌ مُجمَعُ"
    },
    {
      "n": 29,
      "sadr": "وَكَأَنَّهُنَّ رِبابَةٌ وَكَأَنَّهُ",
      "ajuz": "يَسَرٌ يُفيضُ عَلى القِداحِ وَيَصدَعُ"
    },
    {
      "n": 30,
      "sadr": "وَكَأَنَّما هُوَ مِدوَسٌ مُتَقَلِّبٌ",
      "ajuz": "في الكَفِّ إِلّا أَنَّهُ هُوَ أَضلَعُ"
    },
    {
      "n": 31,
      "sadr": "فَوَرَدنَ وَالعَيّوقُ مَقعَدَ رابِئِ",
      "ajuz": "الضُّرَباءِ فَوقَ النَّظمِ لا يَتَتَلَّعُ"
    },
    {
      "n": 32,
      "sadr": "فَشَرَعنَ في حَجَراتِ عَذبٍ بارِدٍ",
      "ajuz": "حَصِبِ البِطاحِ تَغيبُ فيهِ الأَكرُعُ"
    },
    {
      "n": 33,
      "sadr": "فَشَرِبنَ ثُمَّ سَمِعنَ حِسّاً دونَهُ",
      "ajuz": "شَرَفُ الحِجابِ وَرَيبَ قَرعٍ يُقرَعُ"
    },
    {
      "n": 34,
      "sadr": "وَنَميمَةً مِن قانِصٍ مُتَلَبِّبٍ",
      "ajuz": "في كَفِّهِ جَشءٌ أَجَشُّ وَأَقطُعُ"
    },
    {
      "n": 35,
      "sadr": "فَنَكِرنَهُ فَنَفَرنَ وَامتَرَسَت بِهِ",
      "ajuz": "سَطعاءُ هادِيَةٌ وَهادٍ جُرشُعُ"
    },
    {
      "n": 36,
      "sadr": "فَرَمى فَأَنفَذَ في نَجودٍ عائِطٍ",
      "ajuz": "سَهماً فَخَرَّ وَريشُهُ مُتَصَمِّعُ"
    },
    {
      "n": 37,
      "sadr": "فَبَدا لَهُ أَقرابُ هَذا رائِغاً",
      "ajuz": "عَجِلاً فَعَيَّثَ في الكِنانَةِ يُرجِعُ"
    },
    {
      "n": 38,
      "sadr": "فَرَمى فَأَلحَقَ صاعِدِيّاً مِطحَراً",
      "ajuz": "بِالكَشحِ فَاشتَمَلَت عَلَيهِ الأَضلُعُ"
    },
    {
      "n": 39,
      "sadr": "فَأَبَدَّهُنَّ حُتوفَهُنَّ فَهارِبٌ",
      "ajuz": "بِذَمائِهِ أَو بارِكٌ مُتَجَعجِعُ"
    },
    {
      "n": 40,
      "sadr": "يَعثُرنَ في حَدِّ الظُّباتِ كَأَنَّما",
      "ajuz": "كُسِيَت بُرودَ بَني يَزيدَ الأَذرُعُ"
    },
    {
      "n": 41,
      "sadr": "وَالدَّهرُ لا يَبقى عَلى حَدَثانِهِ",
      "ajuz": "شَبَبٌ أَفَزَّتهُ الكِلابُ مُرَوَّعُ"
    },
    {
      "n": 42,
      "sadr": "شَعَفَ الكِلابُ الضّارِياتُ فُؤادَهُ",
      "ajuz": "فَإِذا يَرى الصُّبحَ المُصَدَّقَ يَفزَعُ"
    },
    {
      "n": 43,
      "sadr": "وَيَعوذُ بِالأَرطى إِذا ما شَفَّهُ",
      "ajuz": "قَطرٌ وَراحَتهُ بَليلٌ زَعزَعُ"
    },
    {
      "n": 44,
      "sadr": "يَرمي بِعَينَيهِ الغُيوبَ وَطَرفُهُ",
      "ajuz": "مُغضٍ يُصَدِّقُ طَرفُهُ ما يَسمَعُ"
    },
    {
      "n": 45,
      "sadr": "فَغَدا يُشَرِّقُ مَتنَهُ فَبَدا لَهُ",
      "ajuz": "أُولى سَوابِقِها قَريباً توزَعُ"
    },
    {
      "n": 46,
      "sadr": "فَاهتاجَ مِن فَزَعٍ وَسَدَّ فُروجَهُ",
      "ajuz": "غُبرٌ ضَوارٍ وافِيانِ وَأَجدَعُ"
    },
    {
      "n": 47,
      "sadr": "يَنهَشنَهُ وَيَذُبُّهُنَّ وَيَحتَمي",
      "ajuz": "عَبلُ الشَّوى بِالطُّرَّتَينِ مُوَلَّعُ"
    },
    {
      "n": 48,
      "sadr": "فَنَحا لَها بِمُذَلَّقَينِ كَأَنَّما",
      "ajuz": "بِهِما مِنَ النَّضحِ المُجَدَّحِ أَيدَعُ"
    },
    {
      "n": 49,
      "sadr": "فَكَأَنَّ سَفّودَينِ لَمّا يُقتَرا",
      "ajuz": "عَجِلا لَهُ بِشِواءِ شَربٍ يُنزَعُ"
    },
    {
      "n": 50,
      "sadr": "فَصَرَعنَهُ تَحتَ الغُبارِ وَجَنبُهُ",
      "ajuz": "مُتَتَرِّبٌ وَلِكُلِّ جَنبٍ مَصرَعُ"
    },
    {
      "n": 51,
      "sadr": "حَتّى إِذا اِرتَدَّت وَأَقصَدَ عُصبَةً",
      "ajuz": "مِنها وَقامَ شَريدُها يَتَضَرَّعُ"
    },
    {
      "n": 52,
      "sadr": "فَبَدا لَهُ رَبُّ الكِلابِ بِكَفِّهِ",
      "ajuz": "بيضٌ رِهافٌ ريشُهُنَّ مُقَزَّعُ"
    },
    {
      "n": 53,
      "sadr": "فَرَمى لِيُنقِذَ فَرَّها فَهَوى لَها",
      "ajuz": "سَهمٌ فَأَنفَذَ طُرَّتَيهِ المِنزَعُ"
    },
    {
      "n": 54,
      "sadr": "فَكَبا كَما يَكبو فَنيقٌ تارِزٌ",
      "ajuz": "بِالخَبتِ إِلّا أَنَّهُ هُوَ أَبرَعُ"
    },
    {
      "n": 55,
      "sadr": "وَالدَّهرُ لا يَبقى عَلى حَدَثانِهِ",
      "ajuz": "مُستَشعِرٌ حَلَقَ الحَديدِ مُقَنَّعُ"
    },
    {
      "n": 56,
      "sadr": "حَمِيَت عَلَيهِ الدِّرعُ حَتّى وَجهُهُ",
      "ajuz": "مِن حَرِّها يَومَ الكَريهَةِ أَسفَعُ"
    },
    {
      "n": 57,
      "sadr": "تَعدو بِهِ خَوصاءُ يَفصِمُ جَريُها",
      "ajuz": "حَلَقَ الرِّحالَةِ فَهِيَ رِخوٌ تَمزَعُ"
    },
    {
      "n": 58,
      "sadr": "قَصَرَ الصَّبوحَ لَها فَشَرَّجَ لَحمَها",
      "ajuz": "بِالنَّيِّ فَهيَ تَثوخُ فيها الإِصبَعُ"
    },
    {
      "n": 59,
      "sadr": "مُتَفَلِّقٌ أَنساؤُها عَن قانِئٍ",
      "ajuz": "كَالقُرطِ صاوٍ غُبرُهُ لا يُرضَعُ"
    },
    {
      "n": 60,
      "sadr": "تَأبى بِدِرَّتِها إِذا ما اُستُكرِهَت",
      "ajuz": "إِلّا الحَميمَ فَإِنَّهُ يَتَبَضَّعُ"
    },
    {
      "n": 61,
      "sadr": "بَينا تَعَنُّقِهِ الكُماةَ وَرَوغِهِ",
      "ajuz": "يَوماً أُتيحَ لَهُ جَريءٌ سَلفَعُ"
    },
    {
      "n": 62,
      "sadr": "يَعدو بِهِ نَهِشُ المُشاشِ كَأَنَّهُ",
      "ajuz": "صَدَعٌ سَليمٌ رَجعُهُ لا يَظلَعُ"
    },
    {
      "n": 63,
      "sadr": "فَتَنادَيا وَتَواقَفَت خَيلاهُما",
      "ajuz": "وَكِلاهُما بَطَلُ اللِّقاءِ مُخَدَّعُ"
    },
    {
      "n": 64,
      "sadr": "مُتَحامِيَينِ المَجدَ كُلٌّ واثِقٌ",
      "ajuz": "بِبَلائِهِ وَاليَومُ يَومٌ أَشنَعُ"
    },
    {
      "n": 65,
      "sadr": "وَعَلَيهِما مَسرودَتانِ قَضاهُما",
      "ajuz": "داوودُ أَو صَنَعُ السَّوابِغِ تُبَّعُ"
    },
    {
      "n": 66,
      "sadr": "وَكِلاهُما في كَفِّهِ يَزَنِيَّةٌ",
      "ajuz": "فيها سِنانٌ كَالمَنارَةِ أَصلَعُ"
    },
    {
      "n": 67,
      "sadr": "وَكِلاهُما مُتَوَشِّحٌ ذا رَونَقٍ",
      "ajuz": "عَضباً إِذا مَسَّ الضَّريبَةَ يَقطَعُ"
    },
    {
      "n": 68,
      "sadr": "فَتَخالَسا نَفسَيهِما بِنَوافِذٍ",
      "ajuz": "كَنَوافِذِ العُبُطِ الَّتي لا تُرقَعُ"
    },
    {
      "n": 69,
      "sadr": "وَكِلاهُما قَد عاشَ عيشَةَ ماجِدٍ",
      "ajuz": "وَجَنى العَلاءَ لَو أَنَّ شَيئاً يَنفَعُ"
    }
  ]
}
