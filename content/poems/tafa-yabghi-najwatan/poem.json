{
  "id": "tafa-yabghi-najwatan",
  "poet": "al-sulaka",
  "title": "طافَ يَبغي نَجوَةً",
  "meter": "ramal",
  "themes": ["ritha", "hikma"],
  "rawiy": "ك",
  "abyat_in_full": 12,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "طافَ يَبغي نَجوَةً",
      "ajuz": "مِن هَلاكٍ فَهَلَك"
    },
    {
      "n": 2,
      "sadr": "لَيتَ شِعري ضَلَّةً",
      "ajuz": "أَيُّ شَيءٍ قَتَلَك"
    },
    {
      "n": 3,
      "sadr": "أَمَريضٌ لَم تُعَد",
      "ajuz": "أَم عَدُوٌّ خَتَلَك"
    },
    {
      "n": 4,
      "sadr": "أَم تَوَلّى بِكَ ما",
      "ajuz": "غالَ في الدَّهرِ السُّلَك"
    },
    {
      "n": 5,
      "sadr": "وَالمَنايا رَصَدٌ",
      "ajuz": "لِلفَتى حَيثُ سَلَك"
    },
    {
      "n": 6,
      "sadr": "أَيُّ شَيءٍ حَسَنٍ",
      "ajuz": "لِفَتىً لَم يَكُ لَك"
    },
    {
      "n": 7,
      "sadr": "كُلُّ شَيءٍ قاتِلٌ",
      "ajuz": "حينَ تَلقى أَجَلَك"
    },
    {
      "n": 8,
      "sadr": "طالَما قَد نِلتَ في",
      "ajuz": "غَيرِ كَدٍّ أَمَلَك"
    },
    {
      "n": 9,
      "sadr": "إِنَّ أَمراً فادِحاً",
      "ajuz": "عَن جَوابي شَغَلَك"
    },
    {
      "n": 10,
      "sadr": "سَأُعَزّي النَّفسَ إِذ",
      "ajuz": "لَم تُجِب مَن سَأَلَك"
    },
    {
      "n": 11,
      "sadr": "لَيتَ قَلبي ساعَةً",
      "ajuz": "صَبرَهُ عَنكَ مَلَك"
    },
    {
      "n": 12,
      "sadr": "لَيتَ نَفسي قُدِّمَت",
      "ajuz": "لِلمَنايا قِبَلَك"
    }
  ]
}
