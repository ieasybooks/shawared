{
  "id": "ala-la-ala-al-ashiqin",
  "poet": "ihab-al-shabatat",
  "title": "أَلا لا عَلى العاشِقينَ جُناحُ",
  "meter": "mutaqarib",
  "rawiy": "ح",
  "abyat_in_full": 40,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "أَلا لا عَلى العاشِقينَ جُناحُ",      "ajuz": "سَواءٌ أَسَرّوا الهَوى أَم أَباحوا" },
    { "n": 2,  "sadr": "أَسَرَّ اللِّسانُ فَأَنّى العُيونُ",  "ajuz": "إِذا مَرَّ طَيفُ الحَبيبِ تُشاحُ" },
    { "n": 3,  "sadr": "تَثَنَّت أَمامي بِداجِيَةٍ",          "ajuz": "وَفَوقي لَها بِالخُسوفِ جَناحُ" },
    { "n": 4,  "sadr": "لِأَشهَدَ شَمساً بِلَيلٍ تُزانُ",     "ajuz": "كَأَنَّ اللَّيالي لِجيدٍ وِشاحُ" },
    { "n": 5,  "sadr": "لَها ريحُ وَردٍ بِقَطرِ النَّدى",     "ajuz": "فَجاءَ قُبَيلَ الصَّباحِ صَباحُ" },
    { "n": 6,  "sadr": "تَسيرُ الهُوَينى بِهَدءِ المَساءِ",   "ajuz": "وَتَعصِفُ وَجداً بِقَلبي الرِّياحُ" },
    { "n": 7,  "sadr": "وَسَلَّمَ كَفٌّ وَعَينٌ رَمَت",       "ajuz": "أَبَعدَ السَّلامِ دِمائي تُباحُ" },
    { "n": 8,  "sadr": "كَأَنَّ عُيونَ الغَواني حِمىً",       "ajuz": "عَزيزٌ حَوالَيهِ تُرمى الرِّماحُ" },
    { "n": 9,  "sadr": "رُميتُ بِكُلِّ البَلايا فَما",        "ajuz": "كَجُرحِ الهَوى رافَقَتني جِراحُ" },
    { "n": 10, "sadr": "وَأَذنَبتُ جُلَّ الذُّنوبِ وَتُبتُ",  "ajuz": "وَتَوبُ الهَوى لَيسَ فيهِ سَماحُ" },
    { "n": 11, "sadr": "فَأَمّا هَوى اِبنِ أَخي حَمزَةٍ",      "ajuz": "فَإِنَّ المُقامَ عَلَيهِ فَلاحُ" },
    { "n": 12, "sadr": "ذَروني وَهَمّي فَإِنَّ الجُفونَ",     "ajuz": "سَحابٌ حَياها عَلَيهِ شَحاحُ" },
    { "n": 13, "sadr": "وَأَندى عُيوني نَوى الظّاعِنينَ",     "ajuz": "وَحَرَّ كُبَيدي إِذا هُم أَلاحوا" },
    { "n": 14, "sadr": "إِذا ما تَذَكَّرتُ رَكباً مَضى",      "ajuz": "بَدا المُصطَفى قَبلَ مَن فيهِ راحوا" },
    { "n": 15, "sadr": "رَسولٌ مِنَ اللَّهِ بِالحَقِّ سارَ",  "ajuz": "فَصابَ البَواطِلَ مِنهُ كُساحُ" },
    { "n": 16, "sadr": "بَريءُ العُيوبِ جَريءُ الحُروبِ",     "ajuz": "عَلى أَنَّ عُقبى الغِلابِ صِفاحُ" },
    { "n": 17, "sadr": "أَذَلَّ الطُّغاةَ بِسَيفٍ وَحازَ",    "ajuz": "قُلوباً وَما في يَدَيهِ سِلاحُ" },
    { "n": 18, "sadr": "فَما دَمِيَ الحَقُّ إِلّا ظَنَنتُ",   "ajuz": "بِأَنَّ دِما أَصغَرَيهِ تُساحُ" },
    { "n": 19, "sadr": "فَدَيتُ القُلوبَ الَّتي مَسَّها",     "ajuz": "زِنادٌ مِنَ الحَقِّ فيها اِقتِداحُ" },
    { "n": 20, "sadr": "كَأَنّا بُعَيدَ وِلادَتِهِ",          "ajuz": "مُيَأَّسُ طِبٍّ شَفاهُ لِقاحُ" },
    { "n": 21, "sadr": "كَأَنّا بُعَيدَ مَنِيَّتِهِ",         "ajuz": "دِيارٌ تَأَبَّدَ عَنها اِصطِباحُ" },
    { "n": 22, "sadr": "فَكَم حَمِيَت فَوقَهُ غَيمَةٌ",       "ajuz": "رَأَت خُفَّهُ بَرَّدَتهُ البِطاحُ" },
    { "n": 23, "sadr": "مِنَ الإِنسِ لَكِن نُقاوَتُهُم",      "ajuz": "فَبَعضُ حَشا النَّحلِ شَهدٌ قَراحُ" },
    { "n": 24, "sadr": "نَبِيَّ الهُدى في الفُؤادِ هَواكَ",   "ajuz": "فَما أَلسُنُ الإِنسِ فيهِ فِساحُ" },
    { "n": 25, "sadr": "أَلا اِعذِر بَناتِ لِساني إِذا",       "ajuz": "وَصَلنَ إِلَيكَ وَهُنَّ قِباحُ" },
    { "n": 26, "sadr": "بَلاغَةُ وَحيَينِ حُسناً عَلَت",      "ajuz": "وَمِن فَرطِ حُسنٍ قَبُحنَ المِلاحُ" },
    { "n": 27, "sadr": "وَبَيضاءَ سُبلٍ تَرَكتَ لَنا",        "ajuz": "وَفيها الدُّجى كَالنَّهارِ صِراحُ" },
    { "n": 28, "sadr": "وَبَيضاءُ ما مَدحُها وَشيُها",        "ajuz": "وَلَكِن بِها السّائِرونَ صِباحُ" },
    { "n": 29, "sadr": "فَما زانَ غَيماً وَلا شانَهُ",        "ajuz": "تَلَوُّنُهُ وَالغُيوثُ سِحاحُ" },
    { "n": 30, "sadr": "وَلَولا سَوادٌ يَسودُ القُلوبَ",      "ajuz": "لَما أُخطِئَت في العُيونِ الصِّحاحُ" },
    { "n": 31, "sadr": "بَلَغتَ مِنَ الحَقِّ أَجلى السَّنا",  "ajuz": "بِكَرِّ الجَديدَينِ شَمساً تُتاحُ" },
    { "n": 32, "sadr": "حَييتَ فَقيداً وَظَلَّ هُداكَ",       "ajuz": "شَذاهُ بِمَرِّ العُصورِ يُفاحُ" },
    { "n": 33, "sadr": "أَلَيسَ الحَياءُ عَلى المُتَّقينَ",   "ajuz": "نَداكَ لَهُ في الوُجوهِ اِرتِشاحُ" },
    { "n": 34, "sadr": "أَلانَت يَداكَ نُفوساً قَسَت",        "ajuz": "فَلانَ الشَّكيمُ وَزالَ الجِماحُ" },
    { "n": 35, "sadr": "لِجامُ الهُدى رَدَّ أَفئِدَةً",       "ajuz": "فَتَمَّ لَنا لا عَلَينا الرَّباحُ" },
    { "n": 36, "sadr": "خُطى الأَنبِياءِ بِقَفوِ الصِّحابِ",  "ajuz": "مَنائِرُ لَيلٍ كَساها لِياحُ" },
    { "n": 37, "sadr": "صِحابُكَ أَولى بِذِكرٍ إِذا",         "ajuz": "أَتى صاحِبٌ أَو دَعاهُ بَراحُ" },
    { "n": 38, "sadr": "هُمُ النَّبلُ في قَوسِ خَيرِ الوَرى", "ajuz": "يَدُ اللَّهِ تَرمي فَنيلَ الصَّلاحُ" },
    { "n": 39, "sadr": "بِبيضِ السُّيوفِ وَسودِ المُتونِ",    "ajuz": "ظَلاماً عَنِ المَشرِقَينِ أَزاحوا" },
    { "n": 40, "sadr": "سَلامُ السَّلامِ عَلى المُصطَفى",     "ajuz": "وَعَلَّ السَّلامَ إِلَينا رَواحُ" }
  ]
}
