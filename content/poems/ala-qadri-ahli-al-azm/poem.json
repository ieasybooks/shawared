{
  "id": "ala-qadri-ahli-al-azm",
  "poet": "al-mutanabbi",
  "title": "عَلى قَدرِ أَهلِ العَزمِ تَأتي العَزائِمُ",
  "meter": "tawil",
  "themes": ["madh", "hamasa"],
  "rawiy": "م",
  "abyat_in_full": 46,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "عَلى قَدرِ أَهلِ العَزمِ تَأتي العَزائِمُ", "ajuz": "وَتَأتي عَلى قَدرِ الكِرامِ المَكارِمُ" },
    { "n": 2,  "sadr": "وَتَعظُمُ في عَينِ الصَّغيرِ صِغارُها", "ajuz": "وَتَصغُرُ في عَينِ العَظيمِ العَظائِمُ" },
    { "n": 3,  "sadr": "يُكَلِّفُ سَيفُ الدَّولَةِ الجَيشَ هَمَّهُ", "ajuz": "وَقَد عَجَزَت عَنهُ الجُيوشُ الخَضارِمُ" },
    { "n": 4,  "sadr": "وَيَطلُبُ عِندَ النّاسِ ما عِندَ نَفسِهِ", "ajuz": "وَذَلِكَ ما لا تَدَّعيهِ الضَّراغِمُ" },
    { "n": 5,  "sadr": "يُفَدّي أَتَمُّ الطَّيرِ عُمراً سِلاحَهُ", "ajuz": "نُسورُ المَلا أَحداثُها وَالقَشاعِمُ" },
    { "n": 6,  "sadr": "وَما ضَرَّها خَلقٌ بِغَيرِ مَخالِبٍ", "ajuz": "وَقَد خُلِقَت أَسيافُهُ وَالقَوائِمُ" },
    { "n": 7,  "sadr": "هَلِ الحَدَثُ الحَمراءُ تَعرِفُ لَونَها", "ajuz": "وَتَعلَمُ أَيُّ السّاقِيَينِ الغَمائِمُ" },
    { "n": 8,  "sadr": "سَقَتها الغَمامُ الغُرُّ قَبلَ نُزولِهِ", "ajuz": "فَلَمّا دَنا مِنها سَقَتها الجَماجِمُ" },
    { "n": 9,  "sadr": "بَناها فَأَعلى وَالقَنا تَقرَعُ القَنا", "ajuz": "وَمَوجُ المَنايا حَولَها مُتَلاطِمُ" },
    { "n": 10, "sadr": "وَكانَ بِها مِثلُ الجُنونِ فَأَصبَحَت", "ajuz": "وَمِن جُثَثِ القَتلى عَلَيها تَمائِمُ" },
    { "n": 11, "sadr": "طَريدَةُ دَهرٍ ساقَها فَرَدَدتَها", "ajuz": "عَلى الدّينِ بِالخَطِّيِّ وَالدَّهرُ راغِمُ" },
    { "n": 12, "sadr": "تُفيتُ اللَّيالي كُلَّ شَيءٍ أَخَذتَهُ", "ajuz": "وَهُنَّ لِما يَأخُذنَ مِنكَ غَوارِمُ" },
    { "n": 13, "sadr": "إِذا كانَ ما تَنويهِ فِعلاً مُضارِعاً", "ajuz": "مَضى قَبلَ أَن تُلقى عَلَيهِ الجَوازِمُ" },
    { "n": 14, "sadr": "وَكَيفَ تُرَجّي الرّومُ وَالرّوسُ هَدمَها", "ajuz": "وَذا الطَّعنُ آساسٌ لَها وَدَعائِمُ" },
    { "n": 15, "sadr": "وَقَد حاكَموها وَالمَنايا حَواكِمٌ", "ajuz": "فَما ماتَ مَظلومٌ وَلا عاشَ ظالِمُ" },
    { "n": 16, "sadr": "أَتَوكَ يَجُرّونَ الحَديدَ كَأَنَّهُم", "ajuz": "سَرَوا بِجِيادٍ ما لَهُنَّ قَوائِمُ" },
    { "n": 17, "sadr": "إِذا بَرَقوا لَم تُعرَفِ البيضُ مِنهُمُ", "ajuz": "ثِيابُهُمُ مِن مِثلِها وَالعَمائِمُ" },
    { "n": 18, "sadr": "خَميسٌ بِشَرقِ الأَرضِ وَالغَربِ زَحفُهُ", "ajuz": "وَفي أُذُنِ الجَوزاءِ مِنهُ زَمازِمُ" },
    { "n": 19, "sadr": "تَجَمَّعَ فيهِ كُلُّ لِسنٍ وَأُمَّةٍ", "ajuz": "فَما تُفهِمُ الحُدّاثَ إِلّا التَّراجِمُ" },
    { "n": 20, "sadr": "فَلِلَّهِ وَقتٌ ذَوَّبَ الغِشَّ نارُهُ", "ajuz": "فَلَم يَبقَ إِلّا صارِمٌ أَو ضُبارِمُ" },
    { "n": 21, "sadr": "تَقَطَّعَ ما لا يَقطَعُ الدِّرعَ وَالقَنا", "ajuz": "وَفَرَّ مِنَ الأَبطالِ مَن لا يُصادِمُ" },
    { "n": 22, "sadr": "وَقَفتَ وَما في المَوتِ شَكٌّ لِواقِفٍ", "ajuz": "كَأَنَّكَ في جَفنِ الرَّدى وَهوَ نائِمُ" },
    { "n": 23, "sadr": "تَمُرُّ بِكَ الأَبطالُ كَلمى هَزيمَةً", "ajuz": "وَوَجهُكَ وَضّاحٌ وَثَغرُكَ باسِمُ" },
    { "n": 24, "sadr": "تَجاوَزتَ مِقدارَ الشَّجاعَةِ وَالنُّهى", "ajuz": "إِلى قَولِ قَومٍ أَنتَ بِالغَيبِ عالِمُ" },
    { "n": 25, "sadr": "ضَمَمتَ جَناحَيهِم عَلى القَلبِ ضَمَّةً", "ajuz": "تَموتُ الخَوافي تَحتَها وَالقَوادِمُ" },
    { "n": 26, "sadr": "بِضَربٍ أَتى الهاماتِ وَالنَّصرُ غائِبٌ", "ajuz": "وَصارَ إِلى اللَّبّاتِ وَالنَّصرُ قادِمُ" },
    { "n": 27, "sadr": "حَقَرتَ الرُّدَينِيّاتِ حَتّى طَرَحتَها", "ajuz": "وَحَتّى كَأَنَّ السَّيفَ لِلرُّمحِ شاتِمُ" },
    { "n": 28, "sadr": "وَمَن طَلَبَ الفَتحَ الجَليلَ فَإِنَّما", "ajuz": "مَفاتيحُهُ البيضُ الخِفافُ الصَّوارِمُ" },
    { "n": 29, "sadr": "نَثَرتَهُمُ فَوقَ الأُحَيدِبِ كُلِّهِ", "ajuz": "كَما نُثِرَت فَوقَ العَروسِ الدَّراهِمُ" },
    { "n": 30, "sadr": "تَدوسُ بِكَ الخَيلُ الوُكورَ عَلى الذُّرا", "ajuz": "وَقَد كَثُرَت حَولَ الوُكورِ المَطاعِمُ" },
    { "n": 31, "sadr": "تَظُنُّ فِراخُ الفُتخِ أَنَّكَ زُرتَها", "ajuz": "بِأُمّاتِها وَهيَ العِتاقُ الصَّلادِمُ" },
    { "n": 32, "sadr": "إِذا زَلِقَت مَشَّيتَها بِبُطونِها", "ajuz": "كَما تَتَمَشّى في الصَّعيدِ الأَراقِمُ" },
    { "n": 33, "sadr": "أَفي كُلِّ يَومٍ ذا الدُّمُستُقُ مُقدِمٌ", "ajuz": "قَفاهُ عَلى الإِقدامِ لِلوَجهِ لائِمُ" },
    { "n": 34, "sadr": "أَيُنكِرُ ريحَ اللَّيثِ حَتّى يَذوقَهُ", "ajuz": "وَقَد عَرَفَت ريحَ اللُّيوثِ البَهائِمُ" },
    { "n": 35, "sadr": "وَقَد فَجَعَتهُ بِابنِهِ وَابنِ صِهرِهِ", "ajuz": "وَبِالصِّهرِ حَملاتُ الأَميرِ الغَواشِمُ" },
    { "n": 36, "sadr": "مَضى يَشكُرُ الأَصحابَ في فَوتِهِ الظُّبا", "ajuz": "بِما شَغَلَتها هامُهُم وَالمَعاصِمُ" },
    { "n": 37, "sadr": "وَيَفهَمُ صَوتَ المَشرَفِيَّةِ فيهِمُ", "ajuz": "عَلى أَنَّ أَصواتَ السُّيوفِ أَعاجِمُ" },
    { "n": 38, "sadr": "يُسَرُّ بِما أَعطاكَ لا عَن جَهالَةٍ", "ajuz": "وَلَكِنَّ مَغنوماً نَجا مِنكَ غانِمُ" },
    { "n": 39, "sadr": "وَلَستَ مَليكاً هازِماً لِنَظيرِهِ", "ajuz": "وَلَكِنَّكَ التَّوحيدُ لِلشِّركِ هازِمُ" },
    { "n": 40, "sadr": "تَشَرَّفُ عَدنانٌ بِهِ لا رَبيعَةٌ", "ajuz": "وَتَفتَخِرُ الدُّنيا بِهِ لا العَواصِمُ" },
    { "n": 41, "sadr": "لَكَ الحَمدُ في الدُّرِّ الَّذي لِيَ لَفظُهُ", "ajuz": "فَإِنَّكَ مُعطيهِ وَإِنِّيَ ناظِمُ" },
    { "n": 42, "sadr": "وَإِنّي لَتَعدو بي عَطاياكَ في الوَغى", "ajuz": "فَلا أَنا مَذمومٌ وَلا أَنتَ نادِمُ" },
    { "n": 43, "sadr": "عَلى كُلِّ طَيّارٍ إِلَيها بِرِجلِهِ", "ajuz": "إِذا وَقَعَت في مِسمَعَيهِ الغَماغِمُ" },
    { "n": 44, "sadr": "أَلا أَيُّها السَّيفُ الَّذي لَيسَ مُغمَداً", "ajuz": "وَلا فيهِ مُرتابٌ وَلا مِنهُ عاصِمُ" },
    { "n": 45, "sadr": "هَنيئاً لِضَربِ الهامِ وَالمَجدِ وَالعُلا", "ajuz": "وَراجيكَ وَالإِسلامِ أَنَّكَ سالِمُ" },
    { "n": 46, "sadr": "وَلِم لا يَقي الرَّحمَنُ حَدَّيكَ ما وَقى", "ajuz": "وَتَفليقُهُ هامَ العِدا بِكَ دائِمُ" }
  ]
}
