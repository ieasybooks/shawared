{
  "id": "qattatu-minki-habaila-al-amal",
  "poet": "abu-al-atahiya",
  "title": "قَطَّعتُ مِنكِ حَبائِلَ الآمالِ",
  "meter": "kamil",
  "themes": ["zuhd"],
  "rawiy": "ل",
  "abyat_in_full": 47,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "قَطَّعتُ مِنكِ حَبائِلَ الآمالِ",
      "ajuz": "وَحَطَطتُ عَن ظَهرِ المَطِيِّ رِحالي"
    },
    {
      "n": 2,
      "sadr": "وَيَئِستُ أَن أَبقى لِشَيءٍ نِلتُ مِم",
      "ajuz": "ما فيكِ يا دُنيا وَأَن يَبقى لي"
    },
    {
      "n": 3,
      "sadr": "وَوَجَدتُ بَردَ اليَأسِ بَينَ جَوانِحي",
      "ajuz": "وَأَرَحتُ مِن حِلّي وَمِن تَرحالي"
    },
    {
      "n": 4,
      "sadr": "وَلَئِن طَمِعتُ لَرُبَّ بَرقَةِ خُلَّبٍ",
      "ajuz": "بَرَقَت لِذي طَمَعٍ وَلَمعَةِ آلِ"
    },
    {
      "n": 5,
      "sadr": "ما كانَ أَشأَمَ إِذ رَجاؤكِ قاتِلي",
      "ajuz": "وَبَناتُ وَعدِكِ يَعتَلِجنَ بِبالي"
    },
    {
      "n": 6,
      "sadr": "الآنَ يا دُنيا عَرَفتُكِ فَاِذهَبي",
      "ajuz": "يا دارَ كُلِّ تَشَتُّتٍ وَزَوالِ"
    },
    {
      "n": 7,
      "sadr": "وَالآنَ صارَ لِيَ الزَّمانُ مُؤَدِّباً",
      "ajuz": "فَغَدا عَلَيَّ وَراحَ بِالأَمثالِ"
    },
    {
      "n": 8,
      "sadr": "وَالآنَ أَبصَرتُ السَّبيلَ إِلى الهُدى",
      "ajuz": "وَتَفَرَّغَت هِمَمي عَنِ الأَشغالِ"
    },
    {
      "n": 9,
      "sadr": "وَلَقَد أَقامَ لِيَ المَشيبُ نُعاتَهُ",
      "ajuz": "يُفضي إِلَيَّ بِمَفرَقٍ وَقَذالِ"
    },
    {
      "n": 10,
      "sadr": "وَلَقَد رَأَيتُ المَوتَ يَبرُقُ سَيفُهُ",
      "ajuz": "بِيَدِ المَنِيَّةِ حَيثُ كُنتُ حِيالي"
    },
    {
      "n": 11,
      "sadr": "وَلَقَد رَأَيتُ عُرى الحَياةِ تَخَرَّمَت",
      "ajuz": "وَلَقَد تَصَدّى الوارِثونَ لِمالي"
    },
    {
      "n": 12,
      "sadr": "وَلَقَد رَأَيتُ عَلى الفَناءِ أَدِلَّةً",
      "ajuz": "فيما تَنَكَّرَ مِن تَصَرُّفِ حالي"
    },
    {
      "n": 13,
      "sadr": "وَإِذا اِعتَبَرتُ رَأَيتُ حَطَّ حَوادِثٍ",
      "ajuz": "يَجرينَ بِالأَرزاقِ وَالآجالِ"
    },
    {
      "n": 14,
      "sadr": "وَإِذا تَناسَبَتِ الرِّجالُ فَما أَرى",
      "ajuz": "نَسَباً يُقاسُ بِصالِحِ الأَعمالِ"
    },
    {
      "n": 15,
      "sadr": "وَإِذا بَحَثتُ عَنِ التَّقِيِّ وَجَدتُهُ",
      "ajuz": "رَجُلاً يُصَدِّقُ قَولَهُ بِفِعالِ"
    },
    {
      "n": 16,
      "sadr": "وَإِذا اِتَّقى اللَّهَ اِمرُؤٌ وَأَطاعَهُ",
      "ajuz": "فَتَراهُ بَينَ مَكارِمٍ وَمَعالِ"
    },
    {
      "n": 17,
      "sadr": "وَعَلى التَّقِيِّ إِذا تَرَسَّخَ في التُّقى",
      "ajuz": "تاجانِ تاجُ سَكينَةٍ وَجَلالِ"
    },
    {
      "n": 18,
      "sadr": "وَاللَّيلُ يَذهَبُ وَالنَّهارُ تَعاوُراً",
      "ajuz": "بِالخَلقِ في الإِدبارِ وَالإِقبالِ"
    },
    {
      "n": 19,
      "sadr": "وَبِحَسبِ مَن تُنعى إِلَيهِ نَفسُهُ",
      "ajuz": "مِنهُم بِأَيّامٍ خَلَت وَلَيالِ"
    },
    {
      "n": 20,
      "sadr": "اِضرِب بِطَرفِكَ حَيثُ شِئتَ فَأَنتَ في",
      "ajuz": "عِبَرٍ لَهُنَّ تَدارُكٌ وَتَوالِ"
    },
    {
      "n": 21,
      "sadr": "يَبلى الجَديدُ وَأَنتَ في تَجديدِهِ",
      "ajuz": "وَجَميعُ ما جَدَّدتَ مِنهُ فَبالِ"
    },
    {
      "n": 22,
      "sadr": "يا أَيُّها البَطِرُ الَّذي هُوَ مِن غَدٍ",
      "ajuz": "في قَبرِهِ مُتَفَرِّقُ الأَوصالِ"
    },
    {
      "n": 23,
      "sadr": "حَذَفَ المُنى عَنهُ المُشَمِّرُ في الهُدى",
      "ajuz": "وَأَرى مُناكَ طَويلَةَ الأَذيالِ"
    },
    {
      "n": 24,
      "sadr": "وَلَقَلَّ ما تَلقى أَغَرَّ لِنَفسِهِ",
      "ajuz": "مِن لاعِبٍ مَرِحٍ بِها مُختالِ"
    },
    {
      "n": 25,
      "sadr": "يا تاجِرَ الغَيِّ المُضِرَّ بِرُشدِهِ",
      "ajuz": "حَتّى مَتى بِالغَيِّ أَنتَ تُغالي"
    },
    {
      "n": 26,
      "sadr": "الحَمدُ لِلَّهِ الحَميدِ بِمَنِّهِ",
      "ajuz": "خَسِرَت وَلَم تَربَح يَدُ البَطّالِ"
    },
    {
      "n": 27,
      "sadr": "لِلَّهِ يَومٌ تَقشَعِرُّ جُلودُهُم",
      "ajuz": "وَتَشيبُ مِنهُ ذَوائِبُ الأَطفالِ"
    },
    {
      "n": 28,
      "sadr": "يَومُ النَّوازِلِ وَالزَّلازِلِ وَالحَوا",
      "ajuz": "مِلِ فيهِ إِذ يَقذِفنَ بِالأَحمالِ"
    },
    {
      "n": 29,
      "sadr": "يَومُ التَّغابُنِ وَالتَّبايُنِ وَالتَّوا",
      "ajuz": "زُنِ وَالأُمورِ عَظيمَةِ الأَهوالِ"
    },
    {
      "n": 30,
      "sadr": "يَومٌ يُنادى فيهِ كُلُّ مُضَلَّلٍ",
      "ajuz": "بِمُقَطَّعاتِ النّارِ وَالأَغلالِ"
    },
    {
      "n": 31,
      "sadr": "لِلمُتَّقينَ هُناكَ نُزُلُ كَرامَةٍ",
      "ajuz": "عَلَتِ الوُجوهَ بِنَضرَةٍ وَجَمالِ"
    },
    {
      "n": 32,
      "sadr": "زُمَرٌ أَضاءَت لِلحِسابِ وُجوهُها",
      "ajuz": "فَلَها بَريقٌ عِندَهُ وَتَلالي"
    },
    {
      "n": 33,
      "sadr": "وَسَوابِقٌ غُرٌّ مُحَجَّلَةٌ جَرَت",
      "ajuz": "خُمصَ البُطونِ خَفيفَةَ الأَثقالِ"
    },
    {
      "n": 34,
      "sadr": "مِن كُلِّ أَشعَثَ كانَ أَغبَرَ ناحِلاً",
      "ajuz": "خَلَقِ الرِّداءِ مُرَقَّعِ السِّربالِ"
    },
    {
      "n": 35,
      "sadr": "نَزَلوا بِأَكرَمِ سَيِّدٍ فَأَظَلَّهُم",
      "ajuz": "في دارِ مُلكِ جَلالَةٍ وَظِلالِ"
    },
    {
      "n": 36,
      "sadr": "حِيَلُ اِبنِ آدَمَ في الأُمورِ كَثيرَةٌ",
      "ajuz": "وَالمَوتُ يَقطَعُ حيلَةَ المُحتالِ"
    },
    {
      "n": 37,
      "sadr": "وَمِنَ النُّعاةِ إِلى اِبنِ آدَمَ نَفسَهُ",
      "ajuz": "حَرَكُ الخُطى وَطُلوعُ كُلِّ هِلالِ"
    },
    {
      "n": 38,
      "sadr": "ما لي أَراكَ لِحُرِّ وَجهِكَ مُخلِقاً",
      "ajuz": "أَخلَقتِ يا دُنيا وُجوهَ رِجالِ"
    },
    {
      "n": 39,
      "sadr": "قِستُ السُّؤالَ فَكانَ أَعظَمَ قيمَةً",
      "ajuz": "مِن كُلِّ عارِفَةٍ أَتَت بِسُؤالِ"
    },
    {
      "n": 40,
      "sadr": "كُن بِالسُّؤالِ أَشَدَّ عَقدَ ضَنانَةٍ",
      "ajuz": "مِمَّن يَضِنُّ عَلَيكَ بِالأَموالِ"
    },
    {
      "n": 41,
      "sadr": "وَصُنِ المَحامِدَ ما اِستَطَعتَ فَإِنَّها",
      "ajuz": "في الوَزنِ تَرجُحُ بَذلَ كُلِّ نَوالِ"
    },
    {
      "n": 42,
      "sadr": "وَلَقَد عَجِبتُ مِنَ المُثَمِّرِ مالَهُ",
      "ajuz": "نَسِيَ المُثَمِّرُ زينَةَ الإِقلالِ"
    },
    {
      "n": 43,
      "sadr": "وَإِذا اِمرُؤٌ لَبِسَ الشُّكوكَ بِعَزمِهِ",
      "ajuz": "سَلَكَ الطَّريقَ عَلى قَعودِ ضَلالِ"
    },
    {
      "n": 44,
      "sadr": "وَإِذا دَعَت خُدَعُ الحَوادِثِ دَعوَةً",
      "ajuz": "شَهِدَت لَهُنَّ مَصارِعُ الأَبطالِ"
    },
    {
      "n": 45,
      "sadr": "وَإِذا اِبتُليتَ بِبَذلِ وَجهِكَ سائِلاً",
      "ajuz": "فَابذُلهُ لِلمُتَكَرِّمِ المِفضالِ"
    },
    {
      "n": 46,
      "sadr": "وَإِذا خَشيتَ تَعَذُّراً في بَلدَةٍ",
      "ajuz": "فَاِشدُد يَدَيكَ بِعاجِلِ التَّرحالِ"
    },
    {
      "n": 47,
      "sadr": "وَاصبِر عَلى غِيَرِ الزَّمانِ فَإِنَّما",
      "ajuz": "فَرَجُ الشَّدائِدِ مِثلُ حَلِّ عِقالِ"
    }
  ]
}
