{
  "id": "idha-ma-shita",
  "poet": "al-abbas-ibn-al-ahnaf",
  "title": "إِذا ما شِئتَ أَن تَصنَعَ",
  "meter": "hazaj",
  "themes": ["ghazal"],
  "rawiy": "س",
  "abyat_in_full": 6,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "إِذا ما شِئتَ أَن تَصنَ",
      "ajuz": "عَ شَيئاً يُعجِبُ النّاسا"
    },
    {
      "n": 2,
      "sadr": "وَتَدري كَيفَ مَعشوقٌ",
      "ajuz": "تَحَسّى في الهَوى كاسا"
    },
    {
      "n": 3,
      "sadr": "فَصَوِّر هاهُنا فَوزاً",
      "ajuz": "وَصَوِّر ثَمَّ عَبّاسا"
    },
    {
      "n": 4,
      "sadr": "وَقِس بَينَهُما شِبراً",
      "ajuz": "فَإِن زِدتَ فَلا باسا"
    },
    {
      "n": 5,
      "sadr": "فَإِن لَم يَدنوا حَتّى",
      "ajuz": "تَرى رَأسَيهِما راسا"
    },
    {
      "n": 6,
      "sadr": "فَكَذِّبها بِما قاسَت",
      "ajuz": "وَكَذِّبهُ بِما قاسى"
    }
  ]
}
