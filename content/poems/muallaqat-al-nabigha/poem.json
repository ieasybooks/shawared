{
  "id": "muallaqat-al-nabigha",
  "poet": "al-nabigha-al-dhubyani",
  "title": "مُعَلَّقَةُ النّابِغَةِ الذُّبيانيِّ",
  "meter": "basit",
  "rawiy": "د",
  "abyat_in_full": 49,
  "added": "2026-11-24",
  "abyat": [
    {"n": 1, "sadr": "يا دارَ مَيَّةَ بِالعَلياءِ فَالسَّنَدِ", "ajuz": "أَقوَت وَطالَ عَلَيها سالِفُ الأَبَدِ"},
    {"n": 2, "sadr": "وَقَفتُ فيها أُصَيلاناً أُسائِلُها", "ajuz": "عَيَّت جَواباً وَما بِالرَّبعِ مِن أَحَدِ"},
    {"n": 3, "sadr": "إِلّا الأَواريَّ لَأياً ما أُبَيِّنُها", "ajuz": "وَالنُّؤيَ كَالحَوضِ بِالمَظلومَةِ الجَلَدِ"},
    {"n": 4, "sadr": "رَدَّت عَلَيهِ أَقاصيهِ وَلَبَّدَهُ", "ajuz": "ضَربُ الوَليدَةِ بِالمِسحاةِ في الثَّأَدِ"},
    {"n": 5, "sadr": "خَلَّت سَبيلَ أَتِيٍّ كانَ يَحبِسُهُ", "ajuz": "وَرَفَّعَتهُ إِلى السِّجفَينِ فَالنَّضَدِ"},
    {"n": 6, "sadr": "أَمسَت خَلاءً وَأَمسى أَهلُها اِحتَمَلوا", "ajuz": "أَخنى عَلَيها الَّذي أَخنى عَلى لُبَدِ"},
    {"n": 7, "sadr": "فَعَدِّ عَمّا تَرى إِذ لا اِرتِجاعَ لَهُ", "ajuz": "وَانمِ القُتودَ عَلى عَيرانَةٍ أُجُدِ"},
    {"n": 8, "sadr": "مَقذوفَةٍ بِدَخيسِ النَّحضِ بازِلُها", "ajuz": "لَهُ صَريفٌ صَريفُ القَعوِ بِالمَسَدِ"},
    {"n": 9, "sadr": "كَأَنَّ رَحلي وَقَد زالَ النَّهارُ بِنا", "ajuz": "يَومَ الجَليلِ عَلى مُستَأنِسٍ وَحَدِ"},
    {"n": 10, "sadr": "مِن وَحشِ وَجرَةَ مَوشِيٍّ أَكارِعُهُ", "ajuz": "طاوي المَصيرِ كَسَيفِ الصَّيقَلِ الفَرَدِ"},
    {"n": 11, "sadr": "أَسرَت عَلَيهِ مِنَ الجَوزاءِ سارِيَةٌ", "ajuz": "تُزجي الشَّمالُ عَلَيهِ جامِدَ البَرَدِ"},
    {"n": 12, "sadr": "فَارتاعَ مِن صَوتِ كَلّابٍ فَباتَ لَهُ", "ajuz": "طَوعُ الشَّوامِتِ مِن خَوفٍ وَمِن صَرَدِ"},
    {"n": 13, "sadr": "فَبَثَّهُنَّ عَلَيهِ وَاستَمَرَّ بِهِ", "ajuz": "صُمعُ الكُعوبِ بَريئاتٌ مِنَ الحَرَدِ"},
    {"n": 14, "sadr": "وَكانَ ضُمرانُ مِنهُ حَيثُ يوزِعُهُ", "ajuz": "طَعنَ المُعارِكِ عِندَ المُحجَرِ النَّجُدِ"},
    {"n": 15, "sadr": "شَكَّ الفَريصَةَ بِالمِدرى فَأَنفَذَها", "ajuz": "طَعنَ المُبَيطِرِ إِذ يَشفي مِنَ العَضَدِ"},
    {"n": 16, "sadr": "كَأَنَّهُ خارِجاً مِن جَنبِ صَفحَتِهِ", "ajuz": "سَفّودُ شَربٍ نَسوهُ عِندَ مُفتَأَدِ"},
    {"n": 17, "sadr": "فَظَلَّ يَعجُمُ أَعلى الرَّوقِ مُنقَبِضاً", "ajuz": "في حالِكِ اللَّونِ صَدقٍ غَيرِ ذي أَوَدِ"},
    {"n": 18, "sadr": "لَمّا رَأى واشِقٌ إِقعاصَ صاحِبِهِ", "ajuz": "وَلا سَبيلَ إِلى عَقلٍ وَلا قَوَدِ"},
    {"n": 19, "sadr": "قالَت لَهُ النَّفسُ إِنّي لا أَرى طَمَعاً", "ajuz": "وَإِنَّ مَولاكَ لَم يَسلَم وَلَم يَصِدِ"},
    {"n": 20, "sadr": "فَتِلكَ تُبلِغُني النُّعمانَ إِنَّ لَهُ", "ajuz": "فَضلاً عَلى النّاسِ في الأَدنى وَفي البَعَدِ"},
    {"n": 21, "sadr": "وَلا أَرى فاعِلاً في النّاسِ يُشبِهُهُ", "ajuz": "وَلا أُحاشي مِنَ الأَقوامِ مِن أَحَدِ"},
    {"n": 22, "sadr": "إِلّا سُلَيمانَ إِذ قالَ الإِلَهُ لَهُ", "ajuz": "قُم في البَرِيَّةِ فَاحدُدها عَنِ الفَنَدِ"},
    {"n": 23, "sadr": "وَخَيِّسِ الجِنَّ إِنّي قَد أَذِنتُ لَهُم", "ajuz": "يَبنونَ تَدمُرَ بِالصُّفّاحِ وَالعَمَدِ"},
    {"n": 24, "sadr": "فَمَن أَطاعَكَ فَانفَعهُ بِطاعَتِهِ", "ajuz": "كَما أَطاعَكَ وَادلُلهُ عَلى الرَّشَدِ"},
    {"n": 25, "sadr": "وَمَن عَصاكَ فَعاقِبهُ مُعاقَبَةً", "ajuz": "تَنهى الظَّلومَ وَلا تَقعُد عَلى ضَمَدِ"},
    {"n": 26, "sadr": "إِلّا لِمِثلِكَ أَو مَن أَنتَ سابِقُهُ", "ajuz": "سَبقَ الجَوادِ إِذا اِستَولى عَلى الأَمَدِ"},
    {"n": 27, "sadr": "أَعطى لِفارِهَةٍ حُلوٍ تَوابِعُها", "ajuz": "مِنَ المَواهِبِ لا تُعطى عَلى نَكَدِ"},
    {"n": 28, "sadr": "الواهِبُ المِئَةَ المِعكاءَ زَيَّنَها", "ajuz": "سَعدانُ توضِحَ في أَوبارِها اللِّبَدِ"},
    {"n": 29, "sadr": "وَالأُدمَ قَد خُيِّسَت فُتلاً مَرافِقُها", "ajuz": "مَشدودَةً بِرِحالِ الحيرَةِ الجُدُدِ"},
    {"n": 30, "sadr": "وَالرّاكِضاتِ ذُيولَ الرَّيطِ فانَقَها", "ajuz": "بَردُ الهَواجِرِ كَالغِزلانِ بِالجَرَدِ"},
    {"n": 31, "sadr": "وَالخَيلَ تَمزَعُ غَرباً في أَعِنَّتِها", "ajuz": "كَالطَّيرِ تَنجو مِنَ الشُّؤبوبِ ذي البَرَدِ"},
    {"n": 32, "sadr": "اُحكُم كَحُكمِ فَتاةِ الحَيِّ إِذ نَظَرَت", "ajuz": "إِلى حَمامٍ شِراعٍ وارِدِ الثَّمَدِ"},
    {"n": 33, "sadr": "يَحُفُّهُ جانِبا نيقٍ وَتُتبِعُهُ", "ajuz": "مِثلَ الزُّجاجَةِ لَم تُكحَل مِنَ الرَّمَدِ"},
    {"n": 34, "sadr": "قالَت أَلا لَيتَما هَذا الحَمامُ لَنا", "ajuz": "إِلى حَمامَتِنا وَنِصفُهُ فَقَدِ"},
    {"n": 35, "sadr": "فَحَسَّبوهُ فَأَلفَوهُ كَما حَسَبَت", "ajuz": "تِسعاً وَتِسعينَ لَم تَنقُص وَلَم تَزِدِ"},
    {"n": 36, "sadr": "فَكَمَّلَت مِئَةً فيها حَمامَتُها", "ajuz": "وَأَسرَعَت حِسبَةً في ذَلِكَ العَدَدِ"},
    {"n": 37, "sadr": "فَلا لَعَمرُ الَّذي مَسَّحتُ كَعبَتَهُ", "ajuz": "وَما هُريقَ عَلى الأَنصابِ مِن جَسَدِ"},
    {"n": 38, "sadr": "وَالمُؤمِنِ العائِذاتِ الطَّيرَ يَمسَحُها", "ajuz": "رُكبانُ مَكَّةَ بَينَ الغَيلِ وَالسَّعَدِ"},
    {"n": 39, "sadr": "ما قُلتُ مِن سَيِّئٍ مِمّا أُتيتَ بِهِ", "ajuz": "إِذاً فَلا رَفَعَت سَوطي إِلَيَّ يَدي"},
    {"n": 40, "sadr": "إِلّا مَقالَةَ أَقوامٍ شَقيتُ بِها", "ajuz": "كانَت مَقالَتُهُم قَرعاً عَلى الكَبِدِ"},
    {"n": 41, "sadr": "أُنبِئتُ أَنَّ أَبا قابوسَ أَوعَدَني", "ajuz": "وَلا قَرارَ عَلى زَأرٍ مِنَ الأَسَدِ"},
    {"n": 42, "sadr": "مَهلاً فِداءً لَكَ الأَقوامُ كُلُّهُمُ", "ajuz": "وَما أُثَمِّرُ مِن مالٍ وَمِن وَلَدِ"},
    {"n": 43, "sadr": "لا تَقذِفَنّي بِرُكنٍ لا كِفاءَ لَهُ", "ajuz": "وَإِن تَأَثَّفَكَ الأَعداءُ بِالرِّفَدِ"},
    {"n": 44, "sadr": "فَما الفُراتُ إِذا هَبَّ الرِّياحُ لَهُ", "ajuz": "تَرمي غَوارِبُهُ العِبرَينِ بِالزَّبَدِ"},
    {"n": 45, "sadr": "يَمُدُّهُ كُلُّ وادٍ مُترَعٍ لَجِبٍ", "ajuz": "فيهِ رُكامٌ مِنَ اليَنبوتِ وَالخَضَدِ"},
    {"n": 46, "sadr": "يَظَلُّ مِن خَوفِهِ المَلّاحُ مُعتَصِماً", "ajuz": "بِالخَيزُرانَةِ بَعدَ الأَينِ وَالنَّجَدِ"},
    {"n": 47, "sadr": "يَوماً بِأَجوَدَ مِنهُ سَيبَ نافِلَةٍ", "ajuz": "وَلا يَحولُ عَطاءُ اليَومِ دونَ غَدِ"},
    {"n": 48, "sadr": "هَذا الثَّناءُ فَإِن تَسمَع بِهِ حَسَناً", "ajuz": "فَلَم أُعَرِّض أَبَيتَ اللَّعنَ بِالصَّفَدِ"},
    {"n": 49, "sadr": "ها إِنَّ ذي عِذرَةٌ إِلّا تَكُن نَفَعَت", "ajuz": "فَإِنَّ صاحِبَها مُشارِكُ النَّكَدِ"}
  ]
}
