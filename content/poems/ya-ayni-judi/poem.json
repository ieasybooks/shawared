{
  "id": "ya-ayni-judi",
  "poet": "al-khansa",
  "title": "يا عَينِ جودي بِالدُّموعِ",
  "meter": "kamil",
  "rawiy": "ح",
  "abyat_in_full": 20,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "يا عَينِ جودي بِالدُّمو",
      "ajuz": "عِ المُستَهِلّاتِ السَّوافِح"
    },
    {
      "n": 2,
      "sadr": "فَيضاً كَما فاضَت غُرو",
      "ajuz": "بُ المُترَعاتِ مِنَ النَّواضِح"
    },
    {
      "n": 3,
      "sadr": "وَابكي لِصَخرٍ إِذ ثَوى",
      "ajuz": "بَينَ الضَّريحَةِ وَالصَّفائِح"
    },
    {
      "n": 4,
      "sadr": "رَمساً لَدى جَدَثٍ تُذي",
      "ajuz": "عُ بِتُربِهِ هوجُ النَّوافِح"
    },
    {
      "n": 5,
      "sadr": "السَّيِّدُ الجَحجاحُ وَاب",
      "ajuz": "نُ السّادَةِ الشُّمِّ الجَحاجِح"
    },
    {
      "n": 6,
      "sadr": "الحامِلُ الثِّقَلَ المُهِم",
      "ajuz": "مَ مِنَ المُلِمّاتِ الفَوادِح"
    },
    {
      "n": 7,
      "sadr": "الجابِرُ العَظمَ الكَسي",
      "ajuz": "رَ مِنَ المُهاصِرِ وَالمُمانِح"
    },
    {
      "n": 8,
      "sadr": "الواهِبُ المِئَةَ الهِجا",
      "ajuz": "نَ مِنَ الخَناذيذِ السَّوابِح"
    },
    {
      "n": 9,
      "sadr": "الغافِرُ الذَّنبَ العَظي",
      "ajuz": "مَ لِذي القَرابَةِ وَالمُمالِح"
    },
    {
      "n": 10,
      "sadr": "بِتَعَمُّدٍ مِنهُ وَحِلمٍ",
      "ajuz": "حينَ يَبغي الحِلمَ راجِح"
    },
    {
      "n": 11,
      "sadr": "ذاكَ الَّذي كُنّا بِهِ",
      "ajuz": "نَشفي المِراضَ مِنَ الجَوانِح"
    },
    {
      "n": 12,
      "sadr": "وَيَرُدُّ بادِرَةَ العَدو",
      "ajuz": "وِ وَنَخوَةَ الشَّنِفِ المُكاشِح"
    },
    {
      "n": 13,
      "sadr": "فَأَصابَنا رَيبُ الزَّما",
      "ajuz": "نِ فَنالَنا مِنهُ بِناطِح"
    },
    {
      "n": 14,
      "sadr": "فَكَأَنَّما أَمَّ الزَّما",
      "ajuz": "نُ نُحورَنا بِمُدى الذَّبائِح"
    },
    {
      "n": 15,
      "sadr": "فَنِساؤُنا يَندُبنَ نَوحاً",
      "ajuz": "بَعدَ هادِيَةِ النَّوائِح"
    },
    {
      "n": 16,
      "sadr": "يَحنُنَّ بَعدَ كَرى العُيو",
      "ajuz": "نِ حَنينَ والِهَةٍ قَوامِح"
    },
    {
      "n": 17,
      "sadr": "شَعِثَت شَواحِبُ لا يَني",
      "ajuz": "نَ إِذا وَنى لَيلُ النَّوائِح"
    },
    {
      "n": 18,
      "sadr": "يَندُبنَ فَقدَ أَخي النَّدى",
      "ajuz": "وَالخَيرِ وَالشِّيَمِ الصَّوالِح"
    },
    {
      "n": 19,
      "sadr": "وَالجودِ وَالأَيدي الطِّوا",
      "ajuz": "لِ المُستَفيضاتِ السَّوامِح"
    },
    {
      "n": 20,
      "sadr": "فَالآنَ نَحنُ وَمَن سِوانا",
      "ajuz": "مِثلُ أَسنانِ القَوارِح"
    }
  ]
}
