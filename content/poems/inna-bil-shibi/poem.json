{
  "id": "inna-bil-shibi",
  "poet": "ibn-ukht-taabbata-sharran",
  "title": "إِنَّ بِالشِّعبِ الَّذي دونَ سَلعٍ",
  "meter": "madid",
  "themes": ["ritha", "hamasa"],
  "rawiy": "ل",
  "abyat_in_full": 27,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "إِنَّ بِالشِّعبِ الَّذي دونَ سَلعٍ",
      "ajuz": "لَقَتيلاً دَمُهُ ما يُطَلُّ"
    },
    {
      "n": 2,
      "sadr": "خَلَّفَ العِبءَ عَلَيَّ وَوَلّى",
      "ajuz": "أَنا بِالعِبءِ لَهُ مُستَقِلُّ"
    },
    {
      "n": 3,
      "sadr": "وَوَراءَ الثَّأرِ مِنّي اِبنُ أُختٍ",
      "ajuz": "مَصِعٌ عُقدَتُهُ ما تُحَلُّ"
    },
    {
      "n": 4,
      "sadr": "مُطرِقٌ يَرشَحُ سَمّاً كَما أَطرَقَ",
      "ajuz": "أَفعى يَنفُثُ السَّمَّ صِلُّ"
    },
    {
      "n": 5,
      "sadr": "خَبَرٌ ما جاءَنا مُصمَئِلٌّ",
      "ajuz": "جَلَّ حَتّى دَقَّ فيهِ الأَجَلُّ"
    },
    {
      "n": 6,
      "sadr": "بَزَّني الدَّهرُ وَكانَ غَشوماً",
      "ajuz": "بِأَبِيٍّ جارُهُ ما يُذَلُّ"
    },
    {
      "n": 7,
      "sadr": "شامِسٌ في القُرِّ حَتّى إِذا ما",
      "ajuz": "ذَكَتِ الشِّعرى فَبَردٌ وَظِلُّ"
    },
    {
      "n": 8,
      "sadr": "يابِسُ الجَنبَينِ مِن غَيرِ بُؤسٍ",
      "ajuz": "وَنَدِيُّ الكَفَّينِ شَهمٌ مُدِلُّ"
    },
    {
      "n": 9,
      "sadr": "ظاعِنٌ بِالحَزمِ حَتّى إِذا ما",
      "ajuz": "حَلَّ حَلَّ الحَزمُ حَيثُ يَحُلُّ"
    },
    {
      "n": 10,
      "sadr": "وَلَهُ طَعمانِ أَريٌ وَشَريٌ",
      "ajuz": "وَكِلا الطَّعمَينِ قَد ذاقَ كُلُّ"
    },
    {
      "n": 11,
      "sadr": "مُسبِلٌ في الحَيِّ أَحوى رِفَلٌّ",
      "ajuz": "وَإِذا يَغزو فَسِمعٌ أَزَلُّ"
    },
    {
      "n": 12,
      "sadr": "غَيثُ مُزنٍ غامِرٌ حينَ يُجدي",
      "ajuz": "وَإِذا يَسطو فَلَيثٌ أَبَلُّ"
    },
    {
      "n": 13,
      "sadr": "يَركَبُ الهَولَ وَحيداً وَلا",
      "ajuz": "يَصحَبُهُ إِلّا اليَماني الأَفَلُّ"
    },
    {
      "n": 14,
      "sadr": "فَلَئِن فَلَّت هُذَيلٌ شَباهُ",
      "ajuz": "لَبِما كانَ هُذَيلاً يَفُلُّ"
    },
    {
      "n": 15,
      "sadr": "وَبِما أَبرَكَها في مُناخٍ",
      "ajuz": "جَعجَعٍ يَنقَبُ فيهِ الأَظَلُّ"
    },
    {
      "n": 16,
      "sadr": "صَلِيَت مِنّي هُذَيلٌ بِخِرقٍ",
      "ajuz": "لا يَمَلُّ الشَّرَّ حَتّى يَمَلّوا"
    },
    {
      "n": 17,
      "sadr": "يورِدُ الأَلَّةَ حَتّى إِذا ما",
      "ajuz": "نَهِلَت كانَ لَها مِنهُ عَلُّ"
    },
    {
      "n": 18,
      "sadr": "تَضحَكُ الضَّبعُ لِقَتلى هُذَيلٍ",
      "ajuz": "وَتَرى الذِّئبَ لَها يَستَهِلُّ"
    },
    {
      "n": 19,
      "sadr": "وَعِتاقُ الطَّيرِ تَمشي بِطاناً",
      "ajuz": "تَتَخَطّاهُم فَما تَستَقِلُّ"
    },
    {
      "n": 20,
      "sadr": "وَفُتُوٍّ هَجَّروا ثُمَّ أَسرَوا",
      "ajuz": "لَيلَهُم حَتّى إِذا اِنجابَ حَلّوا"
    },
    {
      "n": 21,
      "sadr": "فَاحتَسَوا أَنفاسَ نَومٍ فَلَمّا",
      "ajuz": "هَوَّموا رُعتُهُم فَاشمَعَلّوا"
    },
    {
      "n": 22,
      "sadr": "كُلُّ ماضٍ قَد تَرَدّى بِماضٍ",
      "ajuz": "كَسَنا البَرقِ إِذا ما يُسَلُّ"
    },
    {
      "n": 23,
      "sadr": "فَسَقَينا كَأسَ حَتفٍ هُذَيلاً",
      "ajuz": "عُقبُها خِزيٌ وَعارٌ وَذُلُّ"
    },
    {
      "n": 24,
      "sadr": "فَادَّرَكنا الثَّأرَ مِنهُم وَلَمّا",
      "ajuz": "يَنجُ مِن لِحيانَ إِلّا الأَقَلُّ"
    },
    {
      "n": 25,
      "sadr": "مَطلِعَ الشَّمسِ فَلَمّا اِستَحَرَّت",
      "ajuz": "أَدبَروا مِن فَورِهِم فَاجفَأَلّوا"
    },
    {
      "n": 26,
      "sadr": "حَلَّتِ الخَمرُ وَكانَت حَراماً",
      "ajuz": "وَبِلَأيٍ ما أَلَمَّت تَحِلُّ"
    },
    {
      "n": 27,
      "sadr": "فَاسقِنيها يا سَوادَ اِبنَ عَمرٍو",
      "ajuz": "إِنَّ جِسمي بَعدَ خالي لَخَلُّ"
    }
  ]
}
