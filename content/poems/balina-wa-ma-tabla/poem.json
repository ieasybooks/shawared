{
  "id": "balina-wa-ma-tabla",
  "poet": "labid-ibn-rabia",
  "title": "بَلينا وَما تَبلى النُّجومُ الطَّوالِعُ",
  "meter": "tawil",
  "rawiy": "ع",
  "abyat_in_full": 20,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "بَلينا وَما تَبلى النُّجومُ الطَّوالِعُ",
      "ajuz": "وَتَبقى الجِبالُ بَعدَنا وَالمَصانِعُ"
    },
    {
      "n": 2,
      "sadr": "وَقَد كُنتُ في أَكنافِ جارِ مَضِنَّةٍ",
      "ajuz": "فَفارَقَني جارٌ بِأَربَدَ نافِعُ"
    },
    {
      "n": 3,
      "sadr": "فَلا جَزِعٌ إِن فَرَّقَ الدَّهرُ بَينَنا",
      "ajuz": "وَكُلُّ فَتىً يَوماً بِهِ الدَّهرُ فاجِعُ"
    },
    {
      "n": 4,
      "sadr": "فَلا أَنا يَأتيني طَريفٌ بِفَرحَةٍ",
      "ajuz": "وَلا أَنا مِمّا أَحدَثَ الدَّهرُ جازِعُ"
    },
    {
      "n": 5,
      "sadr": "وَما النّاسُ إِلّا كَالدِّيارِ وَأَهلُها",
      "ajuz": "بِها يَومَ حَلّوها وَغَدواً بَلاقِعُ"
    },
    {
      "n": 6,
      "sadr": "وَما المَرءُ إِلّا كَالشِّهابِ وَضَوئِهِ",
      "ajuz": "يَحورُ رَماداً بَعدَ إِذ هُوَ ساطِعُ"
    },
    {
      "n": 7,
      "sadr": "وَما البِرُّ إِلّا مُضمَراتٌ مِنَ التُّقى",
      "ajuz": "وَما المالُ إِلّا مُعمَراتٌ وَدائِعُ"
    },
    {
      "n": 8,
      "sadr": "وَما المالُ وَالأَهلونَ إِلّا وَديعَةٌ",
      "ajuz": "وَلا بُدَّ يَوماً أَن تُرَدَّ الوَدائِعُ"
    },
    {
      "n": 9,
      "sadr": "وَيَمضونَ أَرسالاً وَتُخلَفُ بَعدَهُم",
      "ajuz": "كَما ضَمَّ أُخرى التّالِياتِ المُشايِعُ"
    },
    {
      "n": 10,
      "sadr": "وَما النّاسُ إِلّا عامِلانِ فَعامِلٌ",
      "ajuz": "يُتَبِّرُ ما يَبني وَآخَرُ رافِعُ"
    },
    {
      "n": 11,
      "sadr": "فَمِنهُم سَعيدٌ آخِذٌ لِنَصيبِهِ",
      "ajuz": "وَمِنهُم شَقِيٌّ بِالمَعيشَةِ قانِعُ"
    },
    {
      "n": 12,
      "sadr": "أَلَيسَ وَرائي إِن تَراخَت مَنِيَّتي",
      "ajuz": "لُزومُ العَصا تُحنى عَلَيها الأَصابِعُ"
    },
    {
      "n": 13,
      "sadr": "أُخَبِّرُ أَخبارَ القُرونِ الَّتي مَضَت",
      "ajuz": "أَدِبُّ كَأَنّي كُلَّما قُمتُ راكِعُ"
    },
    {
      "n": 14,
      "sadr": "فَأَصبَحتُ مِثلَ السَّيفِ غَيَّرَ جَفنَهُ",
      "ajuz": "تَقادُمُ عَهدِ القَينِ وَالنَّصلُ قاطِعُ"
    },
    {
      "n": 15,
      "sadr": "فَلا تَبعَدَن إِنَّ المَنِيَّةَ مَوعِدٌ",
      "ajuz": "عَلَيكَ فَدانٍ لِلطُّلوعِ وَطالِعُ"
    },
    {
      "n": 16,
      "sadr": "أَعاذِلَ ما يُدريكِ إِلّا تَظَنِّياً",
      "ajuz": "إِذا اِرتَحَلَ الفِتيانُ مَن هُوَ راجِعُ"
    },
    {
      "n": 17,
      "sadr": "تُبَكّي عَلى إِثرِ الشَّبابِ الَّذي مَضى",
      "ajuz": "أَلا إِنَّ أَخدانَ الشَّبابِ الرَّعارِعُ"
    },
    {
      "n": 18,
      "sadr": "أَتَجزَعُ مِمّا أَحدَثَ الدَّهرُ بِالفَتى",
      "ajuz": "وَأَيُّ كَريمٍ لَم تُصِبهُ القَوارِعُ"
    },
    {
      "n": 19,
      "sadr": "لَعَمرُكَ ما تَدري الضَّوارِبُ بِالحَصى",
      "ajuz": "وَلا زاجِراتُ الطَّيرِ ما اللَّهُ صانِعُ"
    },
    {
      "n": 20,
      "sadr": "سَلوهُنَّ إِن كَذَّبتُموني مَتى الفَتى",
      "ajuz": "يَذوقُ المَنايا أَو مَتى الغَيثُ واقِعُ"
    }
  ]
}
