{
  "id": "ala-fi-sabili-al-majd",
  "poet": "abu-al-ala-al-maarri",
  "title": "أَلا في سَبيلِ المَجدِ ما أَنا فاعِلُ",
  "meter": "tawil",
  "rawiy": "ل",
  "abyat_in_full": 41,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَلا في سَبيلِ المَجدِ ما أَنا فاعِلُ",
      "ajuz": "عَفافٌ وَإِقدامٌ وَحَزمٌ وَنائِلُ"
    },
    {
      "n": 2,
      "sadr": "أَعِندي وَقَد مارَستُ كُلَّ خَفِيَّةٍ",
      "ajuz": "يُصَدَّقُ واشٍ أَو يُخَيَّبُ سائِلُ"
    },
    {
      "n": 3,
      "sadr": "أَقَلُّ صُدودي أَنَّني لَكَ مُبغِضٌ",
      "ajuz": "وَأَيسَرُ هَجري أَنَّني عَنكَ راحِلُ"
    },
    {
      "n": 4,
      "sadr": "إِذا هَبَّتِ النَّكباءُ بَيني وَبَينَكُم",
      "ajuz": "فَأَهوَنُ شَيءٍ ما تَقولُ العَواذِلُ"
    },
    {
      "n": 5,
      "sadr": "تُعَدُّ ذُنوبي عِندَ قَومٍ كَثيرَةً",
      "ajuz": "وَلا ذَنبَ لي إِلّا العُلا وَالفَواضِلُ"
    },
    {
      "n": 6,
      "sadr": "كَأَنّي إِذا طُلتُ الزَّمانَ وَأَهلَهُ",
      "ajuz": "رَجَعتُ وَعِندي لِلأَنامِ طَوائِلُ"
    },
    {
      "n": 7,
      "sadr": "وَقَد سارَ ذِكري في البِلادِ فَمَن لَهُم",
      "ajuz": "بِإِخفاءِ شَمسٍ ضَوؤُها مُتَكامِلُ"
    },
    {
      "n": 8,
      "sadr": "يُهِمُّ اللَّيالي بَعضُ ما أَنا مُضمِرٌ",
      "ajuz": "وَيُثقِلُ رَضوى دونَ ما أَنا حامِلُ"
    },
    {
      "n": 9,
      "sadr": "وَإِنّي وَإِن كُنتُ الأَخيرَ زَمانُهُ",
      "ajuz": "لَآتٍ بِما لَم تَستَطِعهُ الأَوائِلُ"
    },
    {
      "n": 10,
      "sadr": "وَأَغدو وَلَو أَنَّ الصَّباحَ صَوارِمٌ",
      "ajuz": "وَأَسري وَلَو أَنَّ الظَّلامَ جَحافِلُ"
    },
    {
      "n": 11,
      "sadr": "وَإِنّي جَوادٌ لَم يُحَلَّ لِجامُهُ",
      "ajuz": "وَنِضوٌ يَمانٍ أَغفَلَتهُ الصَّياقِلُ"
    },
    {
      "n": 12,
      "sadr": "وَإِن كانَ في لُبسِ الفَتى شَرَفٌ لَهُ",
      "ajuz": "فَما السَّيفُ إِلّا غِمدُهُ وَالحَمائِلُ"
    },
    {
      "n": 13,
      "sadr": "وَلي مَنطِقٌ لَم يَرضَ لي كُنهَ مَنزِلي",
      "ajuz": "عَلى أَنَّني بَينَ السِّماكَينِ نازِلُ"
    },
    {
      "n": 14,
      "sadr": "لَدى مَوطِنٍ يَشتاقُهُ كُلُّ سَيِّدٍ",
      "ajuz": "وَيَقصُرُ عَن إِدراكِهِ المُتَناوِلُ"
    },
    {
      "n": 15,
      "sadr": "وَلَمّا رَأَيتُ الجَهلَ في النّاسِ فاشِياً",
      "ajuz": "تَجاهَلتُ حَتّى ظُنَّ أَنِّيَ جاهِلُ"
    },
    {
      "n": 16,
      "sadr": "فَوا عَجَباً كَم يَدَّعي الفَضلَ ناقِصٌ",
      "ajuz": "وَوا أَسَفاً كَم يُظهِرُ النَّقصَ فاضِلُ"
    },
    {
      "n": 17,
      "sadr": "وَكَيفَ تَنامُ الطَّيرُ في وُكُناتِها",
      "ajuz": "وَقَد نُصِبَت لِلفَرقَدَينِ الحَبائِلُ"
    },
    {
      "n": 18,
      "sadr": "يُنافِسُ يَومي فِيَّ أَمسي تَشَرُّفاً",
      "ajuz": "وَتَحسُدُ أَسحاري عَلَيَّ الأَصائِلُ"
    },
    {
      "n": 19,
      "sadr": "وَطالَ اِعتِرافي بِالزَّمانِ وَصَرفِهِ",
      "ajuz": "فَلَستُ أُبالي مَن تَغولُ الغَوائِلُ"
    },
    {
      "n": 20,
      "sadr": "فَلَو بانَ عَضدي ما تَأَسَّفَ مَنكِبي",
      "ajuz": "وَلَو ماتَ زَندي ما بَكَتهُ الأَنامِلُ"
    },
    {
      "n": 21,
      "sadr": "إِذا وَصَفَ الطّائِيَّ بِالبُخلِ مادِرٌ",
      "ajuz": "وَعَيَّرَ قُسّاً بِالفَهاهَةِ باقِلُ"
    },
    {
      "n": 22,
      "sadr": "وَقالَ السُّهى لِلشَّمسِ أَنتِ خَفِيَّةٌ",
      "ajuz": "وَقالَ الدُّجى يا صُبحُ لَونُكَ حائِلُ"
    },
    {
      "n": 23,
      "sadr": "وَطاوَلَتِ الأَرضُ السَّماءَ سَفاهَةً",
      "ajuz": "وَفاخَرَتِ الشُّهبَ الحَصى وَالجَنادِلُ"
    },
    {
      "n": 24,
      "sadr": "فَيا مَوتُ زُر إِنَّ الحَياةَ ذَميمَةٌ",
      "ajuz": "وَيا نَفسُ جِدّي إِنَّ دَهرَكِ هازِلُ"
    },
    {
      "n": 25,
      "sadr": "وَقَد أَغتَدي وَاللَّيلُ يَبكي تَأَسُّفاً",
      "ajuz": "عَلى نَفسِهِ وَالنَّجمُ في الغَربِ مائِلُ"
    },
    {
      "n": 26,
      "sadr": "بِريحٍ أُعيرَت حافِراً مِن زَبَرجَدٍ",
      "ajuz": "لَها التِّبرُ جِسمٌ وَاللُّجَينُ خَلاخِلُ"
    },
    {
      "n": 27,
      "sadr": "كَأَنَّ الصَّبا أَلقَت إِلَيَّ عِنانَها",
      "ajuz": "تَخُبُّ بِسَرجي مَرَّةً وَتُناقِلُ"
    },
    {
      "n": 28,
      "sadr": "إِذا اِشتاقَتِ الخَيلُ المَناهِلَ أَعرَضَت",
      "ajuz": "عَنِ الماءِ فَاشتاقَت إِلَيها المَناهِلُ"
    },
    {
      "n": 29,
      "sadr": "وَلَيلانِ حالٍ بِالكَواكِبِ جَوزُهُ",
      "ajuz": "وَآخَرُ مِن حَليِ الكَواكِبِ عاطِلُ"
    },
    {
      "n": 30,
      "sadr": "كَأَنَّ دُجاهُ الهَجرُ وَالصُّبحُ مَوعِدٌ",
      "ajuz": "بِوَصلٍ وَضَوءُ الفَجرِ حِبٌّ مُماطِلُ"
    },
    {
      "n": 31,
      "sadr": "قَطَعتُ بِهِ بَحراً يَعُبُّ عُبابُهُ",
      "ajuz": "وَلَيسَ لَهُ إِلّا التَّبَلُّجَ ساحِلُ"
    },
    {
      "n": 32,
      "sadr": "وَيُؤنِسُني في قَلبِ كُلِّ مَخوفَةٍ",
      "ajuz": "حَليفُ سُرىً لَم تَصحُ مِنهُ الشَّمائِلُ"
    },
    {
      "n": 33,
      "sadr": "مِنَ الزِّنجِ كَهلٌ شابَ مَفرِقُ رَأسِهِ",
      "ajuz": "وَأوثِقَ حَتّى نَهضُهُ مُتَثاقِلُ"
    },
    {
      "n": 34,
      "sadr": "كَأَنَّ الثُّرَيّا وَالصَّباحُ يَروعُها",
      "ajuz": "أَخو سَقطَةٍ أَو ظالِعٌ مُتَحامِلُ"
    },
    {
      "n": 35,
      "sadr": "إِذا أَنتَ أُعطيتَ السَّعادَةَ لَم تُبَل",
      "ajuz": "وَإِن نَظَرَت شَزراً إِلَيكَ القَبائِلُ"
    },
    {
      "n": 36,
      "sadr": "تَقَتكَ عَلى أَكتافِ أَبطالِها القَنا",
      "ajuz": "وَهابَتكَ في أَغمادِهِنَّ المَناصِلُ"
    },
    {
      "n": 37,
      "sadr": "وَإِن سَدَّدَ الأَعداءُ نَحوَكَ أَسهُماً",
      "ajuz": "نَكَصنَ عَلى أَفواقِهِنَّ المَعابِلُ"
    },
    {
      "n": 38,
      "sadr": "تَحامى الرَّزايا كُلَّ خُفٍّ وَمَنسِمٍ",
      "ajuz": "وَتَلقى رَداهُنَّ الذُّرى وَالكَواهِلُ"
    },
    {
      "n": 39,
      "sadr": "وَتَرجِعُ أَعقابُ الرِّماحِ سَليمَةً",
      "ajuz": "وَقَد حُطِمَت في الدّارِعينَ العَوامِلُ"
    },
    {
      "n": 40,
      "sadr": "فَإِن كُنتَ تَبغي العِزَّ فَابغِ تَوَسُّطاً",
      "ajuz": "فَعِندَ التَّناهي يَقصُرُ المُتَطاوِلُ"
    },
    {
      "n": 41,
      "sadr": "تَوَقّى البُدورُ النَّقصَ وَهيَ أَهِلَّةٌ",
      "ajuz": "وَيُدرِكُها النُّقصانُ وَهيَ كَوامِلُ"
    }
  ]
}
