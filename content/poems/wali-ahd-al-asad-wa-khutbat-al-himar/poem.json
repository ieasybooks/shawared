{
  "id": "wali-ahd-al-asad-wa-khutbat-al-himar",
  "poet": "ahmad-shawqi",
  "title": "وَلِيُّ عَهدِ الأَسَدِ وَخُطبَةُ الحِمارِ",
  "meter": "rajaz",
  "themes": ["fables", "politics"],
  "abyat_in_full": 15,
  "added": "2026-11-24",
  "abyat": [
    {"n": 1, "sadr": "لَمّا دَعا داعي أَبي الأَشبالِ", "ajuz": "مُبَشِّراً بِأَوَّلِ الأَنجالِ"},
    {"n": 2, "sadr": "سَعَت سِباعُ الأَرضِ وَالسَّماءِ", "ajuz": "وَانعَقَدَ المَجلِسُ لِلهَناءِ"},
    {"n": 3, "sadr": "وَصَدَرَ المَرسومُ بِالأَمانِ", "ajuz": "في الأَرضِ لِلقاصي بِها وَالدّاني"},
    {"n": 4, "sadr": "فَضاقَ بِالذُّيولِ صَحنُ الدّارِ", "ajuz": "مِن كُلِّ ذي صوفٍ وَذي مِنقارِ"},
    {"n": 5, "sadr": "حَتّى إِذا اِستَكمَلَتِ الجَمعِيَّةُ", "ajuz": "نادى مُنادي اللَّيثِ في المَعِيَّةِ"},
    {"n": 6, "sadr": "هَل مِن خَطيبٍ مُحسِنٍ خَبيرِ", "ajuz": "يَدعو بِطولِ العُمرِ لِلأَميرِ"},
    {"n": 7, "sadr": "فَنَهَضَ الفيلُ المُشيرُ السّامي", "ajuz": "وَقالَ ما يَليقُ بِالمَقامِ"},
    {"n": 8, "sadr": "ثُمَّ تَلاهُ الثَّعلَبُ السَّفيرُ", "ajuz": "يُنشِدُ حَتّى قيلَ ذا جَريرُ"},
    {"n": 9, "sadr": "وَاندَفَعَ القِردُ مُديرُ الكاسِ", "ajuz": "فَقيلَ أَحسَنتَ أَبا نُواسِ"},
    {"n": 10, "sadr": "وَأَومَأَ الحِمارُ بِالعَقيرَةِ", "ajuz": "يُريدُ أَن يُشَرِّفَ العَشيرَةَ"},
    {"n": 11, "sadr": "فَقالَ بِاسمِ خالِقِ الشَّعيرِ", "ajuz": "وَباعِثِ العَصا إِلى الحَميرِ"},
    {"n": 12, "sadr": "فَأَزعَجَ الصَّوتُ وَلِيَّ العَهدِ", "ajuz": "فَماتَ مِن رِعدَتِهِ في المَهدِ"},
    {"n": 13, "sadr": "فَحَمَلَ القَومُ عَلى الحِمارِ", "ajuz": "بِجُملَةِ الأَنيابِ وَالأَظفارِ"},
    {"n": 14, "sadr": "وَانتُدِبَ الثَّعلَبُ لِلتَّأبينِ", "ajuz": "فَقالَ في التَّعريضِ بِالمِسكينِ"},
    {"n": 15, "sadr": "لا جَعَلَ اللَّهُ لَهُ قَرارا", "ajuz": "عاشَ حِماراً وَمَضى حِمارا"}
  ]
}
