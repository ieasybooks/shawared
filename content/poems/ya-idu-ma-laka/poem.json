{
  "id": "ya-idu-ma-laka",
  "poet": "taabbata-sharran",
  "title": "يا عيدُ ما لَكَ مِن شَوقٍ وَإيراقِ",
  "meter": "basit",
  "themes": ["fakhr", "hamasa"],
  "rawiy": "ق",
  "abyat_in_full": 31,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "يا عيدُ ما لَكَ مِن شَوقٍ وَإيراقِ",
      "ajuz": "وَمَرِّ طَيفٍ عَلى الأَهوالِ طَرّاقِ"
    },
    {
      "n": 2,
      "sadr": "يَسري عَلى الأَينِ وَالحَيّاتِ مُحتَفِياً",
      "ajuz": "نَفسي فِداؤُكَ مِن سارٍ عَلى ساقِ"
    },
    {
      "n": 3,
      "sadr": "طَيفِ اِبنَةِ الحُرِّ إِذ كُنّا نُواصِلُها",
      "ajuz": "ثُمَّ اِجتُنِنتَ بِها بَعدَ التِّفِرّاقِ"
    },
    {
      "n": 4,
      "sadr": "تَاللَّهِ آمَنُ أُنثى بَعدَما حَلَفَت",
      "ajuz": "أَسماءُ بِاللَّهِ مِن عَهدٍ وَميثاقِ"
    },
    {
      "n": 5,
      "sadr": "تُعطيكَ وَعدَ أَمانِيٍّ تَغُرُّ بِهِ",
      "ajuz": "كَالقَطرِ مَرَّ عَلى ضَجنانَ بَرّاقِ"
    },
    {
      "n": 6,
      "sadr": "إِنّي إِذا خُلَّةٌ ضَنَّت بِنائِلِها",
      "ajuz": "وَأَمسَكَت بِضَعيفِ الوَصلِ أَحذاقِ"
    },
    {
      "n": 7,
      "sadr": "نَجَوتُ مِنها نَجائي مِن بَجيلَةَ إِذ",
      "ajuz": "أَلقَيتُ لَيلَةَ خَبتِ الرَّهطِ أَرواقي"
    },
    {
      "n": 8,
      "sadr": "لَيلَةَ صاحوا وَأَغرَوا بي سِراعَهُمُ",
      "ajuz": "بِالعَيكَتَينِ لَدى مَعدى اِبنِ بَرّاقِ"
    },
    {
      "n": 9,
      "sadr": "كَأَنَّما حَثحَثوا حُصّاً قَوادِمُهُ",
      "ajuz": "أَو أُمَّ خِشفٍ بِذي شَثٍّ وَطُبّاقِ"
    },
    {
      "n": 10,
      "sadr": "لا شَيءَ أَسرَعُ مِنّي لَيسَ ذا عُذَرٍ",
      "ajuz": "وَذا جَناحٍ بِجَنبِ الرَّيدِ خَفّاقِ"
    },
    {
      "n": 11,
      "sadr": "حَتّى نَجَوتُ وَلَمّا يَنزِعوا سَلَبي",
      "ajuz": "بِوالِهٍ مِن قَبيضِ الشَّدِّ غَيداقِ"
    },
    {
      "n": 12,
      "sadr": "وَلا أَقولُ إِذا ما خُلَّةٌ صَرَمَت",
      "ajuz": "يا وَيحَ نَفسِيَ مِن شَوقٍ وَإِشفاقِ"
    },
    {
      "n": 13,
      "sadr": "لَكِنَّما عِوَلي إِن كُنتُ ذا عِوَلٍ",
      "ajuz": "عَلى بَصيرٍ بِكَسبِ الحَمدِ سَبّاقِ"
    },
    {
      "n": 14,
      "sadr": "سَبّاقِ غاياتِ مَجدٍ في عَشيرَتِهِ",
      "ajuz": "مُرَجِّعِ الصَّوتِ هَدّاً بَينَ أَرفاقِ"
    },
    {
      "n": 15,
      "sadr": "عاري الظَّنابيبِ مُمتَدٍّ نَواشِرُهُ",
      "ajuz": "مِدلاجِ أَدهَمَ واهي الماءِ غَسّاقِ"
    },
    {
      "n": 16,
      "sadr": "حَمّالِ أَلوِيَةٍ شَهّادِ أَندِيَةٍ",
      "ajuz": "قَوّالِ مُحكَمَةٍ جَوّابِ آفاقِ"
    },
    {
      "n": 17,
      "sadr": "فَذاكَ هَمّي وَغَزوي أَستَغيثُ بِهِ",
      "ajuz": "إِذا اِستَغَثتُ بِضافي الرَّأسِ نَغّاقِ"
    },
    {
      "n": 18,
      "sadr": "كَالحِقفِ حَدَّأَهُ النّامونَ قُلتُ لَهُ",
      "ajuz": "ذو ثَلَّتَينِ وَذو بَهمٍ وَأَرباقِ"
    },
    {
      "n": 19,
      "sadr": "وَقُلَّةٍ كَسِنانِ الرُّمحِ بارِزَةٍ",
      "ajuz": "ضَحيانَةٍ في شُهورِ الصَّيفِ مِحراقِ"
    },
    {
      "n": 20,
      "sadr": "بادَرتُ قُنَّتَها صَحبي وَما كَسِلوا",
      "ajuz": "حَتّى نَمَيتُ إِلَيها بَعدَ إِشراقِ"
    },
    {
      "n": 21,
      "sadr": "لا شَيءَ في رَيدِها إِلّا نَعامَتُها",
      "ajuz": "مِنها هَزيمٌ وَمِنها قائِمٌ باقِ"
    },
    {
      "n": 22,
      "sadr": "بِشَرثَةٍ خَلَقٍ يوقى البَنانُ بِها",
      "ajuz": "شَدَدتُ فيها سَريحاً بَعدَ إِطراقِ"
    },
    {
      "n": 23,
      "sadr": "يا مَن لِعَذّالَةٍ خَذّالَةٍ أَشِبٍ",
      "ajuz": "حَرَّقَ بِاللَّومِ جِلدي أَيَّ تَحراقِ"
    },
    {
      "n": 24,
      "sadr": "يَقولُ أَهلَكتَ مالاً لَو قَنِعتَ بِهِ",
      "ajuz": "مِن ثَوبِ صِدقٍ وَمِن بَزٍّ وَأَعلاقِ"
    },
    {
      "n": 25,
      "sadr": "عاذِلَتي إِنَّ بَعضَ اللَّومِ مَعنَفَةٌ",
      "ajuz": "وَهَل مَتاعٌ وَإِن أَبقَيتَهُ باقِ"
    },
    {
      "n": 26,
      "sadr": "إِنّي زَعيمٌ لَئِن لَم تَترُكي عَذَلي",
      "ajuz": "أَن يَسأَلَ الحَيُّ عَنّي أَهلَ آفاقِ"
    },
    {
      "n": 27,
      "sadr": "أَن يَسأَلَ القَومُ عَنّي أَهلَ مَعرِفَةٍ",
      "ajuz": "فَلا يُخَبِّرُهُم عَن ثابِتٍ لاقِ"
    },
    {
      "n": 28,
      "sadr": "سَدِّد خِلالَكَ مِن مالٍ تُجَمِّعُهُ",
      "ajuz": "حَتّى تُلاقي الَّذي كُلُّ اِمرِئٍ لاقِ"
    },
    {
      "n": 29,
      "sadr": "لَتَقرَعَنَّ عَلَيَّ السِّنَّ مِن نَدَمٍ",
      "ajuz": "إِذا تَذَكَّرتَ يَوماً بَعضَ أَخلاقي"
    }
  ]
}
