{
  "id": "ana-man-mata",
  "poet": "ahmad-shawqi",
  "title": "سَأَلوني لِمَ لَم أَرثِ أَبي",
  "meter": "ramal",
  "themes": ["ritha"],
  "rawiy": "ن",
  "abyat_in_full": 31,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1,  "sadr": "إِنَّ لِلمَوتِ يَداً إِن ضَرَبَت", "ajuz": "أَوشَكَت تَصدَعُ شَملَ الفَرقَدَين" },
    { "n": 2,  "sadr": "تَنفُذُ الجَوَّ عَلى عِقبانِهِ", "ajuz": "وَتُلاقي اللَّيثَ بَينَ الجَبَلَين" },
    { "n": 3,  "sadr": "أَنا مَن ماتَ وَمَن ماتَ أَنا", "ajuz": "لَقِيَ المَوتَ كِلانا مَرَّتَين" },
    { "n": 4,  "sadr": "نَحنُ كُنّا مُهجَةً في بَدَنٍ", "ajuz": "ثُمَّ صِرنا مُهجَةً في بَدَنَين" },
    { "n": 5,  "sadr": "ثُمَّ عُدنا مُهجَةً في بَدَنٍ", "ajuz": "ثُمَّ نُلقى جُثَّةً في كَفَنَين" },
    { "n": 6,  "sadr": "اُنظُرِ الكَونَ وَقُل في وَصفِهِ", "ajuz": "كُلُّ هَذا أَصلُهُ مِن أَبَوَين" },
    { "n": 7,  "sadr": "فَإِذا ما قيلَ ما أَصلُهُما", "ajuz": "قُل هُما الرَّحمَةُ في مَرحَمَتَين" },
    { "n": 8,  "sadr": "فَقَدا الجَنَّةَ في إيجادِنا", "ajuz": "وَنَعِمنا مِنهُما في جَنَّتَين" },
    { "n": 9,  "sadr": "وَهُما العُذرُ إِذا ما أُغضِبا", "ajuz": "وَهُما الصَّفحُ لَنا مُستَرضَيَين" },
    { "n": 10, "sadr": "لَيتَ شِعري أَيُّ حَيٍّ لَم يَدِن", "ajuz": "بِالَّذي دانا بِهِ مُبتَدِئَين" },
    { "n": 11, "sadr": "وَقَفَ اللَّهُ بِنا حَيثُ هُما", "ajuz": "وَأَماتَ الرُّسلَ إِلّا الوالِدَين" },
    { "n": 12, "sadr": "ما أَبي إِلّا أَخٌ فارَقتُهُ", "ajuz": "وُدُّهُ الصِّدقُ وَوُدُّ النّاسِ مَين" },
    { "n": 13, "sadr": "طالَما قُمنا إِلى مائِدَةٍ", "ajuz": "كانَتِ الكِسرَةُ فيها كِسرَتَين" },
    { "n": 14, "sadr": "وَشَرِبنا مِن إِناءٍ واحِدٍ", "ajuz": "وَغَسَلنا بَعدَ ذا فيهِ اليَدَين" },
    { "n": 15, "sadr": "وَتَمَشَّينا يَدي في يَدِهِ", "ajuz": "مَن رَآنا قالَ عَنّا أَخَوَين" },
    { "n": 16, "sadr": "نَظَرَ الدَّهرُ إِلَينا نَظرَةً", "ajuz": "سَوَّتِ الشَّرَّ فَكانَت نَظرَتَين" },
    { "n": 17, "sadr": "يا أَبي وَالمَوتُ كَأسٌ مُرَّةٌ", "ajuz": "لا تَذوقُ النَّفسُ مِنها مَرَّتَين" },
    { "n": 18, "sadr": "كَيفَ كانَت ساعَةٌ قَضَّيتَها", "ajuz": "كُلُّ شَيءٍ قَبلَها أَو بَعدُ هَين" },
    { "n": 19, "sadr": "أَشَرِبتَ المَوتَ فيها جُرعَةً", "ajuz": "أَم شَرِبتَ المَوتَ فيها جُرعَتَين" },
    { "n": 20, "sadr": "لا تَخَف بَعدَكَ حُزناً أَو بُكاً", "ajuz": "جَمَدَت مِنّي وَمِنكَ اليَومَ عَين" },
    { "n": 21, "sadr": "أَنتَ قَد عَلَّمتَني تَركَ الأَسى", "ajuz": "كُلُّ زَينٍ مُنتَهاهُ المَوتُ شَين" },
    { "n": 22, "sadr": "لَيتَ شِعري هَل لَنا أَن نَلتَقي", "ajuz": "مَرَّةً أَم ذا اِفتِراقُ المَلَوَين" },
    { "n": 23, "sadr": "وَإِذا مُتُّ وَأودِعتُ الثَّرى", "ajuz": "أَنُلَقّى حُفرَةً أَو حُفرَتَين" }
  ]
}
