{
  "id": "nuiddu-al-mashrafiyya",
  "poet": "al-mutanabbi",
  "title": "نُعِدُّ المَشرَفِيَّةَ وَالعَوالي",
  "meter": "wafir",
  "rawiy": "ل",
  "abyat_in_full": 45,
  "added": "2026-11-19",
  "abyat": [
    { "n": 1, "sadr": "نُعِدُّ المَشرَفِيَّةَ وَالعَوالي", "ajuz": "وَتَقتُلُنا المَنونُ بِلا قِتالِ" },
    { "n": 2, "sadr": "وَنَرتَبِطُ السَّوابِقَ مُقرَباتٍ", "ajuz": "وَما يُنجينَ مِن خَبَبِ اللَّيالي" },
    { "n": 3, "sadr": "وَمَن لَم يَعشَقِ الدُّنيا قَديماً", "ajuz": "وَلَكِن لا سَبيلَ إِلى الوِصالِ" },
    { "n": 4, "sadr": "نَصيبُكَ في حَياتِكَ مِن حَبيبٍ", "ajuz": "نَصيبُكَ في مَنامِكَ مِن خَيالِ" },
    { "n": 5, "sadr": "رَماني الدَّهرُ بِالأَرزاءِ حَتّى", "ajuz": "فُؤادي في غِشاءٍ مِن نِبالِ" },
    { "n": 6, "sadr": "فَصِرتُ إِذا أَصابَتني سِهامٌ", "ajuz": "تَكَسَّرَتِ النِّصالُ عَلى النِّصالِ" },
    { "n": 7, "sadr": "وَهانَ فَما أُبالي بِالرَّزايا", "ajuz": "لِأَنّي ما اِنتَفَعتُ بِأَن أُبالي" },
    { "n": 8, "sadr": "وَهَذا أَوَّلُ النّاعينَ طُرّاً", "ajuz": "لِأَوَّلِ مَيتَةٍ في ذا الجَلالِ" },
    { "n": 9, "sadr": "كَأَنَّ المَوتَ لَم يَفجَع بِنَفسٍ", "ajuz": "وَلَم يَخطُر لِمَخلوقٍ بِبالِ" },
    { "n": 10, "sadr": "صَلاةُ اللَّهِ خالِقِنا حَنوطٌ", "ajuz": "عَلى الوَجهِ المُكَفَّنِ بِالجَمالِ" },
    { "n": 11, "sadr": "عَلى المَدفونِ قَبلَ التُّربِ صَوناً", "ajuz": "وَقَبلَ اللَّحدِ في كَرَمِ الخِلالِ" },
    { "n": 12, "sadr": "فَإِنَّ لَهُ بِبَطنِ الأَرضِ شَخصاً", "ajuz": "جَديداً ذِكرُناهُ وَهوَ بالي" },
    { "n": 13, "sadr": "وَما أَحَدٌ يُخَلَّدُ في البَرايا", "ajuz": "بَلِ الدُّنيا تَؤولُ إِلى زَوالِ" },
    { "n": 14, "sadr": "أَطابَ النَّفسَ أَنَّكَ مُتَّ مَوتاً", "ajuz": "تَمَنَّتهُ البَواقي وَالخَوالي" },
    { "n": 15, "sadr": "وَزُلتَ وَلَم تَرى يَوماً كَريهاً", "ajuz": "يُسَرُّ الرّوحُ فيهِ بِالزَّوالِ" },
    { "n": 16, "sadr": "سَقى مَثواكَ غادٍ في الغَوادي", "ajuz": "نَظيرُ نَوالِ كَفِّكَ في النَّوالِ" }
  ]
}
