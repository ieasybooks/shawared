  "abyat": [
    { "n": 1,  "sadr": "يُسلِمُ المَرءَ أَخوهُ", "ajuz": "لِلمَنايا وَأَبوهُ" },
    { "n": 2,  "sadr": "وَأَبو الأَبناءِ لا يَب", "ajuz": "قى وَلا يَبقى بَنوهُ" },
    { "n": 3,  "sadr": "رُبَّ مَذكورٍ لِقَومٍ", "ajuz": "غابَ عَنهُم فَنَسوهُ" },
    { "n": 4,  "sadr": "وَإِذا أَفنى سِنيهِ ال", "ajuz": "مَرءُ أَفنَتهُ سِنوهُ" },
    { "n": 5,  "sadr": "وَكَأَن بِالمَرءِ قَد يَب", "ajuz": "كي عَلَيهِ أَقرَبوهُ" },
    { "n": 6,  "sadr": "وَكَأَنَّ القَومَ قَد قا", "ajuz": "موا فَقالوا أَدرِكوهُ" },
    { "n": 7,  "sadr": "سائِلوهُ كَلِّموهُ", "ajuz": "حَرِّكوهُ لَقِّنوهُ" },
    { "n": 8,  "sadr": "فَإِذا اِستَيأَسَ مِنهُ ال", "ajuz": "قَومُ قالوا حَرِّفوهُ" },
    { "n": 9,  "sadr": "حَرِّفوهُ وَجِّهوهُ", "ajuz": "مَدِّدوهُ غَمِّضوهُ" },
    { "n": 10, "sadr": "عَجِّلوهُ لِرَحيلٍ", "ajuz": "عَجِّلوا لا تَحبِسوهُ" },
    { "n": 11, "sadr": "اِرفَعوهُ غَسِّلوهُ", "ajuz": "كَفِّنوهُ حَنِّطوهُ" },
    { "n": 12, "sadr": "فَإِذا ما لُفَّ في الأَك", "ajuz": "فانِ قالوا فَاحمِلوهُ" },
    { "n": 13, "sadr": "أَخرِجوهُ فَوقَ أَعوا", "ajuz": "دِ المَنايا شَيِّعوهُ" },
    { "n": 14, "sadr": "فَإِذا صَلَّوا عَلَيهِ", "ajuz": "قيلَ هاتوا وَاقبِروهُ" },
    { "n": 15, "sadr": "فَإِذا ما اِستَودَعوهُ ال", "ajuz": "أَرضَ رَهناً تَرَكوهُ" },
    { "n": 16, "sadr": "خَلَّفوهُ تَحتَ رَدمٍ", "ajuz": "أَوقَروهُ أَثقَلوهُ" },
    { "n": 17, "sadr": "أَبعَدوهُ أَسحَقوهُ", "ajuz": "أَوحَدوهُ أَفرَدوهُ" },
    { "n": 18, "sadr": "وَدَّعوهُ فارَقوهُ", "ajuz": "أَسلَموهُ خَلَّفوهُ" },
    { "n": 19, "sadr": "وَانثَنَوا عَنهُ وَخَلَّو", "ajuz": "هُ كَأَن لَم يَعرِفوهُ" },
    { "n": 20, "sadr": "وَكَأَنَّ القَومَ فيما", "ajuz": "كانَ فيهِ لَم يَلوهُ" },
    { "n": 21, "sadr": "اِبتَنى النّاسُ مِنَ البُن", "ajuz": "يانِ ما لَم يَسكُنوهُ" },
    { "n": 22, "sadr": "جَمَعَ النّاسُ مِنَ الأَم", "ajuz": "والِ ما لَم يَأكُلوهُ" },
    { "n": 23, "sadr": "طَلَبَ النّاسُ مِنَ الآ", "ajuz": "مالِ ما لَم يُدرِكوهُ" },
    { "n": 24, "sadr": "كُلُّ مَن لَم يَجعَلِ النّا", "ajuz": "سَ إِماماً تَرَكوهُ" },
    { "n": 25, "sadr": "ظَعَنَ المَوتى إِلى ما", "ajuz": "قَدَّموهُ وَجَدوهُ" },
    { "n": 26, "sadr": "طابَ عَيشُ القَومِ ما كا", "ajuz": "نَ إِذا القَومُ رَضوهُ" },
    { "n": 27, "sadr": "عِش بِما شِئتَ فَمَن تَس", "ajuz": "رُرهُ دُنياهُ تَسوهُ" },
    { "n": 28, "sadr": "وَإِذا لَم يُكرِمِ النّا", "ajuz": "سَ اِمرُؤٌ لَم يُكرِموهُ" },
    { "n": 29, "sadr": "كُلُّ مَن لَم يَحتَجِ النّا", "ajuz": "سُ إِلَيهِ صَغَّروهُ" },
    { "n": 30, "sadr": "وَإِلى مَن رَغِبَ النّا", "ajuz": "سُ إِلَيهِ أَكبَروهُ" },
    { "n": 31, "sadr": "مَن تَصَدّى لِأَخيهِ", "ajuz": "بِالغِنى فَهوَ أَخوهُ" },
    { "n": 32, "sadr": "فَهوَ إِن يَنظُر إِلَيهِ", "ajuz": "يَرأَ مِنهُ ما يَسوهُ" },
    { "n": 33, "sadr": "يُكرَمُ المَرءُ وَإِن أَم", "ajuz": "لَقَ أَقصاهُ بَنوهُ" },
    { "n": 34, "sadr": "لَو رَأى النّاسُ نَبِيّاً", "ajuz": "سائِلاً ما وَصَلوهُ" },
    { "n": 35, "sadr": "وَهُمُ إِن طَمِعوا في", "ajuz": "زادِ كَلبٍ أَكَلوهُ" },
    { "n": 36, "sadr": "لا تَراني آخِرَ الدَّه", "ajuz": "رِ بِتَسآلٍ أَفوهُ" },
    { "n": 37, "sadr": "إِنَّما يُعرَفُ بِالفَض", "ajuz": "لِ مِنَ النّاسِ ذَووهُ" },
    { "n": 38, "sadr": "أَفضَلُ المَعروفِ ما لَم", "ajuz": "تُبتَذَل فيهِ الوُجوهُ" },
    { "n": 39, "sadr": "أَنتَ ما اِستَغنَيتَ عَن صا", "ajuz": "حِبِكَ الدَّهرَ أَخوهُ" },
    { "n": 40, "sadr": "فَإِذا اِحتَجتَ إِلَيهِ", "ajuz": "ساعَةً مَجَّكَ فوهُ" }
  ]
}
