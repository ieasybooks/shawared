{
  "id": "ajaratana-inna-al-khutuba",
  "poet": "imru-al-qays",
  "title": "أَجارَتَنا إِنَّ الخُطوبَ تَنوبُ",
  "meter": "tawil",
  "rawiy": "ب",
  "abyat_in_full": 5,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَجارَتَنا إِنَّ الخُطوبَ تَنوبُ",
      "ajuz": "وَإِنّي مُقيمٌ ما أَقامَ عَسيبُ"
    },
    {
      "n": 2,
      "sadr": "أَجارَتَنا إِنّا غَريبانِ هَهُنا",
      "ajuz": "وَكُلُّ غَريبٍ لِلغَريبِ نَسيبُ"
    },
    {
      "n": 3,
      "sadr": "فَإِن تَصِلينا فَالقَرابَةُ بَينَنا",
      "ajuz": "وَإِن تَصرِمينا فَالغَريبُ غَريبُ"
    },
    {
      "n": 4,
      "sadr": "أَجارَتَنا ما فاتَ لَيسَ يَؤوبُ",
      "ajuz": "وَما هُوَ آتٍ في الزَّمانِ قَريبُ"
    },
    {
      "n": 5,
      "sadr": "وَلَيسَ غَريباً مَن تَناءَت دِيارُهُ",
      "ajuz": "وَلَكِنَّ مَن وارى التُّرابُ غَريبُ"
    }
  ]
}
