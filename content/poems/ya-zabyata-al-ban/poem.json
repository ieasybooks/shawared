{
  "id": "ya-zabyata-al-ban",
  "poet": "al-sharif-al-radi",
  "title": "يا ظَبيَةَ البانِ تَرعى في خَمائِلِهِ",
  "meter": "basit",
  "themes": ["ghazal", "shawq"],
  "rawiy": "ك",
  "abyat_in_full": 18,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "يا ظَبيَةَ البانِ تَرعى في خَمائِلِهِ",
      "ajuz": "لِيَهنَكِ اليَومَ أَنَّ القَلبَ مَرعاكِ"
    },
    {
      "n": 2,
      "sadr": "الماءُ عِندَكِ مَبذولٌ لِشارِبِهِ",
      "ajuz": "وَلَيسَ يُرويكِ إِلّا مَدمَعيَ الباكي"
    },
    {
      "n": 3,
      "sadr": "هَبَّت لَنا مِن رِياحِ الغَورِ رائِحَةٌ",
      "ajuz": "بَعدَ الرُّقادِ عَرَفناها بِرَيّاكِ"
    },
    {
      "n": 4,
      "sadr": "ثُمَّ اِنثَنَينا إِذا ما هَزَّنا طَرَبٌ",
      "ajuz": "عَلى الرِّحالِ تَعَلَّلنا بِذِكراكِ"
    },
    {
      "n": 5,
      "sadr": "سَهمٌ أَصابَ وَراميهِ بِذي سَلَمٍ",
      "ajuz": "مَن بِالعِراقِ لَقَد أَبعَدتِ مَرماكِ"
    },
    {
      "n": 6,
      "sadr": "وَعدٌ لِعَينَيكِ عِندي ما وَفَيتِ بِهِ",
      "ajuz": "يا قُربَ ما كَذَبَت عَينَيَّ عَيناكِ"
    },
    {
      "n": 7,
      "sadr": "حَكَت لِحاظُكِ ما في الرّيمِ مِن مُلَحٍ",
      "ajuz": "يَومَ اللِّقاءِ فَكانَ الفَضلُ لِلحاكي"
    },
    {
      "n": 8,
      "sadr": "كَأَنَّ طَرفَكِ يَومَ الجِزعِ يُخبِرُنا",
      "ajuz": "بِما طَوى عَنكِ مِن أَسماءِ قَتلاكِ"
    },
    {
      "n": 9,
      "sadr": "أَنتِ النَّعيمُ لِقَلبي وَالعَذابُ لَهُ",
      "ajuz": "فَما أَمَرَّكِ في قَلبي وَأَحلاكِ"
    },
    {
      "n": 10,
      "sadr": "عِندي رَسائِلُ شَوقٍ لَستُ أَذكُرُها",
      "ajuz": "لَولا الرَّقيبُ لَقَد بَلَّغتُها فاكِ"
    },
    {
      "n": 11,
      "sadr": "سَقى مِنىً وَلَيالي الخَيفِ ما شَرِبَت",
      "ajuz": "مِنَ الغَمامِ وَحَيّاها وَحَيّاكِ"
    },
    {
      "n": 12,
      "sadr": "إِذ يَلتَقي كُلُّ ذي دَينٍ وَماطِلُهُ",
      "ajuz": "مِنّا وَيَجتَمِعُ المَشكُوُّ وَالشّاكي"
    },
    {
      "n": 13,
      "sadr": "لَمّا غَدا السِّربُ يَعطو بَينَ أَرحُلِنا",
      "ajuz": "ما كانَ فيهِ غَريمُ القَلبِ إِلّاكِ"
    },
    {
      "n": 14,
      "sadr": "هامَت بِكِ العَينُ لَم تَتبَع سِواكِ هَوىً",
      "ajuz": "مَن عَلَّمَ البَينَ أَنَّ القَلبَ يَهواكِ"
    },
    {
      "n": 15,
      "sadr": "حَتّى دَنا السِّربُ ما أَحيَيتِ مِن كَمَدٍ",
      "ajuz": "قَتلى هَواكِ وَلا فادَيتِ أَسراكِ"
    },
    {
      "n": 16,
      "sadr": "يا حَبَّذا نَفحَةٌ مَرَّت بِفيكِ لَنا",
      "ajuz": "وَنُطفَةٌ غُمِسَت فيها ثَناياكِ"
    },
    {
      "n": 17,
      "sadr": "وَحَبَّذا وَقفَةٌ وَالرَّكبُ مُغتَفِلٌ",
      "ajuz": "عَلى ثَرىً وَخَدَت فيهِ مَطاياكِ"
    },
    {
      "n": 18,
      "sadr": "لَو كانَتِ اللِّمَّةُ السَّوداءُ مِن عُدَدي",
      "ajuz": "يَومَ الغَميمِ لَما أَفلَتِّ أَشراكي"
    }
  ]
}
