{
  "id": "aqulu-wa-qad-nahat",
  "poet": "abu-firas-al-hamdani",
  "title": "أَقولُ وَقَد ناحَت بِقُربي حَمامَةٌ",
  "meter": "tawil",
  "rawiy": "ل",
  "abyat_in_full": 7,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1, "sadr": "أَقولُ وَقَد ناحَت بِقُربي حَمامَةٌ", "ajuz": "أَيا جارَتا هَل تَشعُرينَ بِحالي" },
    { "n": 2, "sadr": "مَعاذَ الهَوى ما ذُقتِ طارِقَةَ النَّوى", "ajuz": "وَلا خَطَرَت مِنكِ الهُمومُ بِبالِ" },
    { "n": 3, "sadr": "أَتَحمِلُ مَحزونَ الفُؤادِ قَوادِمٌ", "ajuz": "عَلى غُصُنٍ نائي المَسافَةِ عالِ" },
    { "n": 4, "sadr": "أَيا جارَتا هَل أَنصَفَ الدَّهرُ بَينَنا", "ajuz": "تَعالي أُقاسِمكِ الهُمومَ تَعالي" },
    { "n": 5, "sadr": "تَعالَي تَرَي روحاً لَدَيَّ ضَعيفَةً", "ajuz": "تَرَدَّدُ في جِسمٍ يُعَذَّبُ بالِ" },
    { "n": 6, "sadr": "أَيَضحَكُ مَأسورٌ وَتَبكي طَليقَةٌ", "ajuz": "وَيَسكُتُ مَحزونٌ وَيَندُبُ سالِ" },
    { "n": 7, "sadr": "لَقَد كُنتُ أَولى مِنكِ بِالدَّمعِ مُقلَةً", "ajuz": "وَلَكِنَّ دَمعي في الحَوادِثِ غالِ" }
  ]
}
