{
  "id": "la-taqulanna",
  "poet": "al-muthaqqib-al-abdi",
  "title": "لا تَقولَنَّ إِذا ما لَم تُرِد",
  "meter": "ramal",
  "themes": ["advice", "madh"],
  "rawiy": "م",
  "abyat_in_full": 18,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "لا تَقولَنَّ إِذا ما لَم تُرِد",
      "ajuz": "أَن تُتِمَّ الوَعدَ في شَيءٍ نَعَم"
    },
    {
      "n": 2,
      "sadr": "حَسَنٌ قَولُ نَعَم مِن بَعدِ لا",
      "ajuz": "وَقَبيحٌ قَولُ لا بَعدَ نَعَم"
    },
    {
      "n": 3,
      "sadr": "إِنَّ لا بَعدَ نَعَم فاحِشَةٌ",
      "ajuz": "فَبِلا فَابدَأ إِذا خِفتَ النَّدَم"
    },
    {
      "n": 4,
      "sadr": "فَإِذا قُلتَ نَعَم فَاصبِر لَها",
      "ajuz": "بِنَجاحِ القَولِ إِنَّ الخُلفَ ذَمٌّ"
    },
    {
      "n": 5,
      "sadr": "وَاعلَمَ أَنَّ الذَّمَّ نَقصٌ لِلفَتى",
      "ajuz": "وَمَتى لا يَتَّقِ الذَّمَّ يُذَمَّ"
    },
    {
      "n": 6,
      "sadr": "أُكرِمُ الجارَ وَأَرعى حَقَّهُ",
      "ajuz": "إِنَّ عِرفانَ الفَتى الحَقَّ كَرَم"
    },
    {
      "n": 7,
      "sadr": "لا تَراني راتِعاً في مَجلِسٍ",
      "ajuz": "في لُحومِ النّاسِ كَالسَّبعِ الضَّرِم"
    },
    {
      "n": 8,
      "sadr": "إِنَّ شَرَّ النّاسِ مَن يَكشِرُ لي",
      "ajuz": "حينَ يَلقاني وَإِن غِبتُ شَتَم"
    },
    {
      "n": 9,
      "sadr": "وَكَلامٍ سَيِّئٍ قَد وُقِرَت",
      "ajuz": "أُذُني عَنهُ وَما بي مِن صَمَم"
    },
    {
      "n": 10,
      "sadr": "فَتَعَزَّيتُ خَشاةً أَن يَرى",
      "ajuz": "جاهِلٌ أَنّي كَما كانَ زَعَم"
    },
    {
      "n": 11,
      "sadr": "وَلَبَعضُ الصَّفحِ وَالإِعراضِ عَن",
      "ajuz": "ذي الخَنا أَبقى وَإِن كانَ ظَلَم"
    },
    {
      "n": 12,
      "sadr": "إِنَّما جادَ بِشَأسٍ خالِدٌ",
      "ajuz": "بَعدَ ما حاقَت بِهِ إِحدى الظُّلَم"
    },
    {
      "n": 13,
      "sadr": "مِن مَنايا يَتَخاسَينَ بِهِ",
      "ajuz": "يَبتَدِرنَ الشَّخصَ مِن لَحمٍ وَدَم"
    },
    {
      "n": 14,
      "sadr": "مُترَعُ الجَفنَةِ رِبعِيُّ النَّدى",
      "ajuz": "حَسَنٌ مَجلِسُهُ غَيرُ لُطَم"
    },
    {
      "n": 15,
      "sadr": "يَجعَلُ الهَنءَ عَطايا جَمَّةً",
      "ajuz": "إِنَّ بَعضَ المالِ في العِرضِ أَمَم"
    },
    {
      "n": 16,
      "sadr": "لا يُبالي طَيِّبُ النَّفسِ بِهِ",
      "ajuz": "تَلَفَ المالِ إِذِ العِرضُ سَلِم"
    }
  ]
}
