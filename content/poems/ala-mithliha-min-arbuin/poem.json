{
  "id": "ala-mithliha-min-arbuin",
  "poet": "abu-tammam",
  "title": "عَلى مِثلِها مِن أَربُعٍ وَمَلاعِبِ",
  "meter": "tawil",
  "rawiy": "ب",
  "abyat_in_full": 45,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "عَلى مِثلِها مِن أَربُعٍ وَمَلاعِبِ",
      "ajuz": "أُذيلَت مَصوناتُ الدُّموعِ السَّواكِبِ"
    },
    {
      "n": 2,
      "sadr": "أَقولُ لِقُرحانٍ مِنَ البَينِ لَم يُضِف",
      "ajuz": "رَسيسَ الهَوى بَينَ الحَشا وَالتَّرائِبِ"
    },
    {
      "n": 3,
      "sadr": "أَعِنّي أُفَرِّق شَملَ دَمعي فَإِنَّني",
      "ajuz": "أَرى الشَّملَ مِنهُم لَيسَ بِالمُتَقارِبِ"
    },
    {
      "n": 4,
      "sadr": "وَما زالَ يَومَ الدّارِ عَذلُكَ كُلُّهُ",
      "ajuz": "عَدُوِّيَ حَتّى صارَ جَهلُكَ صاحِبي"
    },
    {
      "n": 5,
      "sadr": "وَما بِكَ إِركابي مِنَ الرُّشدِ مَركَباً",
      "ajuz": "أَلا إِنَّما حاوَلتَ رُشدَ الرَّكائِبِ"
    },
    {
      "n": 6,
      "sadr": "فَكِلني إِلى شَوقي وَسِر يَسِرِ الهَوى",
      "ajuz": "إِلى حُرُقاتي بِالدُّموعِ السَّوارِبِ"
    },
    {
      "n": 7,
      "sadr": "أَمَيدانَ لَهوي مَن أَتاحَ لَكَ البِلى",
      "ajuz": "فَأَصبَحتَ مَيدانَ الصَّبا وَالجَنائِبِ"
    },
    {
      "n": 8,
      "sadr": "أَصابَتكَ أَبكارُ الخُطوبِ فَشَتَّتَت",
      "ajuz": "هَوايَ بِأَبكارِ الظِّباءِ الكَواعِبِ"
    },
    {
      "n": 9,
      "sadr": "وَرَكبٍ يُساقونَ الرِّكابَ زُجاجَةً",
      "ajuz": "مِنَ السَّيرِ لَم تَقصِد لَها كَفُّ قاطِبِ"
    },
    {
      "n": 10,
      "sadr": "فَقَد أَكَلوا مِنها الغَوارِبَ بِالسُّرى",
      "ajuz": "فَصارَت لَها أَشباحُهُم كَالغَوارِبِ"
    },
    {
      "n": 11,
      "sadr": "يُصَرِّفُ مَسراها جُذَيلُ مَشارِقٍ",
      "ajuz": "إِذا آبَهُ هَمٌّ عُذَيقُ مَغارِبِ"
    },
    {
      "n": 12,
      "sadr": "يَرى بِالكَعابِ الرّودِ طَلعَةَ ثائِرٍ",
      "ajuz": "وَبِالعِرمِسِ الوَجناءِ غُرَّةَ آيِبِ"
    },
    {
      "n": 13,
      "sadr": "كَأَنَّ بِهِ ضِغناً عَلى كُلِّ جانِبٍ",
      "ajuz": "مِنَ الأَرضِ أَو شَوقاً إِلى كُلِّ جانِبِ"
    },
    {
      "n": 14,
      "sadr": "إِذا العيسُ لاقَت بي أَبا دُلَفٍ فَقَد",
      "ajuz": "تَقَطَّعَ ما بَيني وَبَينَ النَّوائِبِ"
    },
    {
      "n": 15,
      "sadr": "هُنالِكَ تَلقى الجودَ حَيثُ تَقَطَّعَت",
      "ajuz": "تَمائِمُهُ وَالمَجدَ مُرخى الذَّوائِبِ"
    },
    {
      "n": 16,
      "sadr": "تَكادُ عَطاياهُ يُجَنُّ جُنونُها",
      "ajuz": "إِذا لَم يُعَوِّذها بِنَغمَةِ طالِبِ"
    },
    {
      "n": 17,
      "sadr": "إِذا حَرَّكَتهُ هِزَّةُ المَجدِ غَيَّرَت",
      "ajuz": "عَطاياهُ أَسماءَ الأَماني الكَواذِبِ"
    },
    {
      "n": 18,
      "sadr": "تَكادُ مَغانيهِ تَهِشُّ عِراصُها",
      "ajuz": "فَتَركَبُ مِن شَوقٍ إِلى كُلِّ راكِبِ"
    },
    {
      "n": 19,
      "sadr": "إِذا ما غَدا أَغدى كَريمَةَ مالِهِ",
      "ajuz": "هَدِيّاً وَلَو زُفَّت لِأَلأَمِ خاطِبِ"
    },
    {
      "n": 20,
      "sadr": "يَرى أَقبَحَ الأَشياءِ أَوبَةَ آيِبٍ",
      "ajuz": "كَسَتهُ يَدُ المَأمولِ حُلَّةَ خائِبِ"
    },
    {
      "n": 21,
      "sadr": "وَأَحسَنُ مِن نَورٍ تُفَتِّحُهُ الصَّبا",
      "ajuz": "بَياضُ العَطايا في سَوادِ المَطالِبِ"
    },
    {
      "n": 22,
      "sadr": "إِذا أَلجَمَت يَوماً لُجَيمٌ وَحَولَها",
      "ajuz": "بَنو الحِصنِ نَجلُ المُحصَناتِ النَّجائِبِ"
    },
    {
      "n": 23,
      "sadr": "فَإِنَّ المَنايا وَالصَّوارِمَ وَالقَنا",
      "ajuz": "أَقارِبُهُم في الرَّوعِ دونَ الأَقارِبِ"
    },
    {
      "n": 24,
      "sadr": "جَحافِلُ لا يَترُكنَ ذا جَبرِيَّةٍ",
      "ajuz": "سَليماً وَلا يَحرُبنَ مَن لَم يُحارِبِ"
    },
    {
      "n": 25,
      "sadr": "يَمُدّونَ مِن أَيدٍ عَواصٍ عَواصِمٍ",
      "ajuz": "تَصولُ بِأَسيافٍ قَواضٍ قَواضِبِ"
    },
    {
      "n": 26,
      "sadr": "إِذا الخَيلُ جابَت قَسطَلَ الحَربِ صَدَّعوا",
      "ajuz": "صُدورَ العَوالي في صُدورِ الكَتائِبِ"
    },
    {
      "n": 27,
      "sadr": "إِذا اِفتَخَرَت يَوماً تَميمٌ بِقَوسِها",
      "ajuz": "وَزادَت عَلى ما وَطَّدَت مِن مَناقِبِ"
    },
    {
      "n": 28,
      "sadr": "فَأَنتُم بِذي قارٍ أَمالَت سُيوفُكُم",
      "ajuz": "عُروشَ الَّذينَ اِستَرهَنوا قَوسَ حاجِبِ"
    },
    {
      "n": 29,
      "sadr": "مَحاسِنُ مِن مَجدٍ مَتى تَقرِنوا بِها",
      "ajuz": "مَحاسِنَ أَقوامٍ تَكُن كَالمَعايِبِ"
    },
    {
      "n": 30,
      "sadr": "مَكارِمُ لَجَّت في عُلُوٍّ كَأَنَّها",
      "ajuz": "تُحاوِلُ ثَأراً عِندَ بَعضِ الكَواكِبِ"
    },
    {
      "n": 31,
      "sadr": "وَقَد عَلِمَ الأَفشينُ وَهوَ الَّذي بِهِ",
      "ajuz": "يُصانُ رِداءُ المُلكِ عَن كُلِّ جاذِبِ"
    },
    {
      "n": 32,
      "sadr": "بِأَنَّكَ لَمّا اِسحَنكَكَ الأَمرُ وَاِكتَسى",
      "ajuz": "أَهابِيَ تَسفي في وُجوهِ التَّجارِبِ"
    },
    {
      "n": 33,
      "sadr": "تَجَلَّلتَهُ بِالرَّأيِ حَتّى أَرَيتَهُ",
      "ajuz": "بِهِ مِلءَ عَينَيهِ مَكانَ العَواقِبِ"
    },
    {
      "n": 34,
      "sadr": "بِأَرشَقَ إِذ سالَت عَلَيهِم غَمامَةٌ",
      "ajuz": "جَرَت بِالعَوالي وَالعِتاقِ الشَّوازِبِ"
    },
    {
      "n": 35,
      "sadr": "نَضَوتَ لَهُ رَأيَينِ سَيفاً وَمُنصُلاً",
      "ajuz": "وَكُلٌّ كَنَجمٍ في الدُّجُنَّةِ ثاقِبِ"
    },
    {
      "n": 36,
      "sadr": "وَكُنتَ مَتى تُهزَز لِخَطبٍ تُغَشِّهِ",
      "ajuz": "ضَرائِبَ أَمضى مِن رِقاقِ المَضارِبِ"
    },
    {
      "n": 37,
      "sadr": "فَذِكرُكَ في قَلبِ الخَليفَةِ بَعدَها",
      "ajuz": "خَليفَتُكَ المُقَفّى بِأَعلى المَراتِبِ"
    },
    {
      "n": 38,
      "sadr": "فَإِن تَنسَ يَذكُر أَو يَقُل فيكَ حاسِدٌ",
      "ajuz": "يَفِل قَولُهُ أَو تَنأَ دارٌ تُصاقِبِ"
    },
    {
      "n": 39,
      "sadr": "فَأَنتَ لَدَيهِ حاضِرٌ غَيرُ حاضِرٍ",
      "ajuz": "جَميعاً وَعَنهُ غائِبٌ غَيرُ غائِبِ"
    },
    {
      "n": 40,
      "sadr": "إِلَيكَ أَرَحنا عازِبَ الشِّعرِ بَعدَما",
      "ajuz": "تَمَهَّلَ في رَوضِ المَعاني العَجائِبِ"
    },
    {
      "n": 41,
      "sadr": "غَرائِبُ لاقَت في فِنائِكَ أُنسَها",
      "ajuz": "مِنَ المَجدِ فَهيَ الآنَ غَيرُ غَرائِبِ"
    },
    {
      "n": 42,
      "sadr": "وَلَو كانَ يَفنى الشِّعرُ أَفناهُ ما قَرَت",
      "ajuz": "حِياضُكَ مِنهُ في العُصورِ الذَّواهِبِ"
    },
    {
      "n": 43,
      "sadr": "وَلَكِنَّهُ صَوبُ العُقولِ إِذا اِنجَلَت",
      "ajuz": "سَحائِبُ مِنهُ أُعقِبَت بِسَحائِبِ"
    },
    {
      "n": 44,
      "sadr": "أَقولُ لِأَصحابي هُوَ القاسِمُ الَّذي",
      "ajuz": "بِهِ شَرَحَ الجودُ اِلتِباسَ المَذاهِبِ"
    },
    {
      "n": 45,
      "sadr": "وَإِنّي لَأَرجو أَن تَرُدَّ رَكائِبي",
      "ajuz": "مَواهِبُهُ بَحراً تُرَجّى مَواهِبي"
    }
  ]
}
