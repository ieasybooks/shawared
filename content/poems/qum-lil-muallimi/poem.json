{
  "id": "qum-lil-muallimi",
  "poet": "ahmad-shawqi",
  "title": "العِلمُ وَالتَّعليمُ وَواجِبُ المُعَلِّمِ",
  "meter": "kamil",
  "themes": ["madh", "advice", "watani"],
  "rawiy": "ل",
  "abyat_in_full": 68,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "قُم لِلمُعَلِّمِ وَفِّهِ التَّبجيلا",
      "ajuz": "كادَ المُعَلِّمُ أَن يَكونَ رَسولا"
    },
    {
      "n": 2,
      "sadr": "أَعَلِمتَ أَشرَفَ أَو أَجَلَّ مِنَ الَّذي",
      "ajuz": "يَبني وَيُنشِئُ أَنفُساً وَعُقولا"
    },
    {
      "n": 3,
      "sadr": "سُبحانَكَ اللَّهُمَّ خَيرَ مُعَلِّمٍ",
      "ajuz": "عَلَّمتَ بِالقَلَمِ القُرونَ الأولى"
    },
    {
      "n": 4,
      "sadr": "أَخرَجتَ هَذا العَقلَ مِن ظُلُماتِهِ",
      "ajuz": "وَهَدَيتَهُ النّورَ المُبينَ سَبيلا"
    },
    {
      "n": 5,
      "sadr": "وَطَبَعتَهُ بِيَدِ المُعَلِّمِ تارَةً",
      "ajuz": "صَدِئَ الحَديدِ وَتارَةً مَصقولا"
    },
    {
      "n": 6,
      "sadr": "أَرسَلتَ بِالتَّوراةِ موسى مُرشِداً",
      "ajuz": "وَابنَ البَتولِ فَعَلَّمَ الإِنجيلا"
    },
    {
      "n": 7,
      "sadr": "وَفَجَرتَ يَنبوعَ البَيانِ مُحَمَّداً",
      "ajuz": "فَسَقى الحَديثَ وَناوَلَ التَّنزيلا"
    },
    {
      "n": 8,
      "sadr": "عَلَّمتَ يوناناً وَمِصرَ فَزالَتا",
      "ajuz": "عَن كُلِّ شَمسٍ ما تُريدُ أُفولا"
    },
    {
      "n": 9,
      "sadr": "وَاليَومَ أَصبَحَتا بِحالِ طُفولَةٍ",
      "ajuz": "في العِلمِ تَلتَمِسانِهِ تَطفيلا"
    },
    {
      "n": 10,
      "sadr": "مِن مَشرِقِ الأَرضِ الشَّموسُ تَظاهَرَت",
      "ajuz": "ما بالُ مَغرِبِها عَلَيهِ أُديلا"
    },
    {
      "n": 11,
      "sadr": "يا أَرضُ مُذ فَقَدَ المُعَلِّمُ نَفسَهُ",
      "ajuz": "بَينَ الشُّموسِ وَبَينَ شَرقِكِ حيلا"
    },
    {
      "n": 12,
      "sadr": "ذَهَبَ الَّذينَ حَمَوا حَقيقَةَ عِلمِهِم",
      "ajuz": "وَاِستَعذَبوا فيها العَذابَ وَبيلا"
    },
    {
      "n": 13,
      "sadr": "في عالَمٍ صَحِبَ الحَياةَ مُقَيَّداً",
      "ajuz": "بِالفَردِ مَخزوماً بِهِ مَغلولا"
    },
    {
      "n": 14,
      "sadr": "صَرَعَتهُ دُنيا المُستَبِدِّ كَما هَوَت",
      "ajuz": "مِن ضَربَةِ الشَّمسِ الرُّؤوسُ ذُهولا"
    },
    {
      "n": 15,
      "sadr": "سُقراطُ أَعطى الكَأسَ وَهيَ مَنِيَّةٌ",
      "ajuz": "شَفَتَي مُحِبٍّ يَشتَهي التَّقبيلا"
    },
    {
      "n": 16,
      "sadr": "عَرَضوا الحَياةَ عَلَيهِ وَهيَ غَباوَةٌ",
      "ajuz": "فَأَبى وَآثَرَ أَن يَموتَ نَبيلا"
    },
    {
      "n": 17,
      "sadr": "إِنَّ الشَّجاعَةَ في القُلوبِ كَثيرَةٌ",
      "ajuz": "وَوَجَدتُ شُجعانَ العُقولِ قَليلا"
    },
    {
      "n": 18,
      "sadr": "إِنَّ الَّذي خَلَقَ الحَقيقَةَ عَلقَماً",
      "ajuz": "لَم يُخلِ مِن أَهلِ الحَقيقَةِ جيلا"
    },
    {
      "n": 19,
      "sadr": "وَلَرُبَّما قَتَلَ الغَرامُ رِجالَها",
      "ajuz": "قُتِلَ الغَرامُ كَمِ اِستَباحَ قَتيلا"
    },
    {
      "n": 20,
      "sadr": "أَوَكُلُّ مَن حامى عَنِ الحَقِّ اِقتَنى",
      "ajuz": "عِندَ السَّوادِ ضَغائِناً وَذُحولا"
    },
    {
      "n": 21,
      "sadr": "لَو كُنتُ أَعتَقِدُ الصَّليبَ وَخَطبَهُ",
      "ajuz": "لَأَقَمتُ مِن صَلبِ المَسيحِ دَليلا"
    },
    {
      "n": 22,
      "sadr": "أَمُعَلِّمي الوادي وَساسَةَ نَشئِهِ",
      "ajuz": "وَالطّابِعينَ شَبابَهُ المَأمولا"
    },
    {
      "n": 23,
      "sadr": "وَالحامِلينَ إِذا دُعوا لِيُعَلِّموا",
      "ajuz": "عِبءَ الأَمانَةِ فادِحاً مَسؤولا"
    },
    {
      "n": 24,
      "sadr": "كانَت لَنا قَدَمٌ إِلَيهِ خَفيفَةٌ",
      "ajuz": "وَرِمَت بِدَنلوبٍ فَكانَ الفيلا"
    },
    {
      "n": 25,
      "sadr": "حَتّى رَأَينا مِصرَ تَخطو إِصبَعاً",
      "ajuz": "في العِلمِ إِن مَشَتِ المَمالِكُ ميلا"
    },
    {
      "n": 26,
      "sadr": "تِلكَ الكُفورُ وَحَشوُها أُمِّيَّةٌ",
      "ajuz": "مِن عَهدِ خوفو لَم تَرَ القِنديلا"
    },
    {
      "n": 27,
      "sadr": "تَجِدُ الَّذينَ بَنى المِسَلَّةَ جَدُّهُمُ",
      "ajuz": "لا يُحسِنونَ لِإِبرَةٍ تَشكيلا"
    },
    {
      "n": 28,
      "sadr": "وَيُدَلَّلونَ إِذا أُريدَ قِيادُهُم",
      "ajuz": "كَالبُهمِ تَأنَسُ إِذ تَرى التَّدليلا"
    },
    {
      "n": 29,
      "sadr": "يَتلو الرِّجالُ عَلَيهُمُ شَهَواتِهِم",
      "ajuz": "فَالنّاجِحونَ أَلَدُّهُم تَرتيلا"
    },
    {
      "n": 30,
      "sadr": "الجَهلُ لا تَحيا عَلَيهِ جَماعَةٌ",
      "ajuz": "كَيفَ الحَياةُ عَلى يَدَي عِزريلا"
    },
    {
      "n": 31,
      "sadr": "وَاللَّهِ لَولا أَلسُنٌ وَقَرائِحٌ",
      "ajuz": "دارَت عَلى فِطَنِ الشَّبابِ شَمولا"
    },
    {
      "n": 32,
      "sadr": "وَتَعَهَّدَت مِن أَربَعينَ نُفوسَهُم",
      "ajuz": "تَغزو القُنوطَ وَتَغرِسُ التَّأميلا"
    },
    {
      "n": 33,
      "sadr": "عَرَفَت مَواضِعَ جَدبِهِم فَتَتابَعَت",
      "ajuz": "كَالعَينِ فَيضاً وَالغَمامِ مَسيلا"
    },
    {
      "n": 34,
      "sadr": "تُسدي الجَميلَ إِلى البِلادِ وَتَستَحي",
      "ajuz": "مِن أَن تُكافَأَ بِالثَّناءِ جَميلا"
    },
    {
      "n": 35,
      "sadr": "ما كانَ دَنلوبٌ وَلا تَعليمُهُ",
      "ajuz": "عِندَ الشَّدائِدِ يُغنِيانِ فَتيلا"
    },
    {
      "n": 36,
      "sadr": "رَبّوا عَلى الإِنصافِ فِتيانَ الحِمى",
      "ajuz": "تَجِدوهُمُ كَهفَ الحُقوقِ كُهولا"
    },
    {
      "n": 37,
      "sadr": "فَهوَ الَّذي يَبني الطِّباعَ قَويمَةً",
      "ajuz": "وَهوَ الَّذي يَبني النُّفوسَ عُدولا"
    },
    {
      "n": 38,
      "sadr": "وَيُقيمُ مَنطِقَ كُلِّ أَعوَجِ مَنطِقٍ",
      "ajuz": "وَيُريهِ رَأياً في الأُمورِ أَصيلا"
    },
    {
      "n": 39,
      "sadr": "وَإِذا المُعَلِّمُ لَم يَكُن عَدلاً مَشى",
      "ajuz": "روحُ العَدالَةِ في الشَّبابِ ضَئيلا"
    },
    {
      "n": 40,
      "sadr": "وَإِذا المُعَلِّمُ ساءَ لَحظَ بَصيرَةٍ",
      "ajuz": "جاءَت عَلى يَدِهِ البَصائِرُ حولا"
    },
    {
      "n": 41,
      "sadr": "وَإِذا أَتى الإِرشادُ مِن سَبَبِ الهَوى",
      "ajuz": "وَمِنَ الغُرورِ فَسَمِّهِ التَّضليلا"
    },
    {
      "n": 42,
      "sadr": "وَإِذا أُصيبَ القَومُ في أَخلاقِهِم",
      "ajuz": "فَأَقِم عَلَيهِم مَأتَماً وَعَويلا"
    },
    {
      "n": 43,
      "sadr": "إِنّي لَأَعذُرُكُم وَأَحسَبُ عِبءَكُم",
      "ajuz": "مِن بَينِ أَعباءِ الرِّجالِ ثَقيلا"
    },
    {
      "n": 44,
      "sadr": "وَجَدَ المُساعِدَ غَيرُكُم وَحُرِمتُمُ",
      "ajuz": "في مِصرَ عَونَ الأُمَّهاتِ جَليلا"
    },
    {
      "n": 45,
      "sadr": "وَإِذا النِّساءُ نَشَأنَ في أُمِّيَّةٍ",
      "ajuz": "رَضَعَ الرِّجالُ جَهالَةً وَخُمولا"
    },
    {
      "n": 46,
      "sadr": "لَيسَ اليَتيمُ مَنِ اِنتَهى أَبَواهُ مِن",
      "ajuz": "هَمِّ الحَياةِ وَخَلَّفاهُ ذَليلا"
    },
    {
      "n": 47,
      "sadr": "فَأَصابَ بِالدُّنيا الحَكيمَةِ مِنهُما",
      "ajuz": "وَبِحُسنِ تَربِيَةِ الزَّمانِ بَديلا"
    },
    {
      "n": 48,
      "sadr": "إِنَّ اليَتيمَ هُوَ الَّذي تَلقى لَهُ",
      "ajuz": "أُمّاً تَخَلَّت أَو أَباً مَشغولا"
    },
    {
      "n": 49,
      "sadr": "مِصرٌ إِذا ما راجَعَت أَيّامَها",
      "ajuz": "لَم تَلقَ لِلسَّبتِ العَظيمِ مَثيلا"
    },
    {
      "n": 50,
      "sadr": "البَرلَمانُ غَداً يَمُدُّ رُواقَهُ",
      "ajuz": "ظِلّاً عَلى الوادي السَّعيدِ ظَليلا"
    },
    {
      "n": 51,
      "sadr": "نَرجو إِذا التَّعليمُ حَرَّكَ شَجوَهُ",
      "ajuz": "أَلّا يَكونَ عَلى البِلادِ بَخيلا"
    },
    {
      "n": 52,
      "sadr": "قُل لِلشَّبابِ اليَومَ بورِكَ غَرسُكُم",
      "ajuz": "دَنَتِ القُطوفُ وَذُلِّلَت تَذليلا"
    },
    {
      "n": 53,
      "sadr": "حَيّوا مِنَ الشُّهَداءِ كُلَّ مُغَيَّبٍ",
      "ajuz": "وَضَعوا عَلى أَحجارِهِ إِكليلا"
    },
    {
      "n": 54,
      "sadr": "لِيَكونَ حَظُّ الحَيِّ مِن شُكرانِكُم",
      "ajuz": "جَمّاً وَحَظُّ المَيتِ مِنهُ جَزيلا"
    },
    {
      "n": 55,
      "sadr": "لا يَلمَسُ الدُّستورُ فيكُم روحَهُ",
      "ajuz": "حَتّى يَرى جُندِيَّهُ المَجهولا"
    },
    {
      "n": 56,
      "sadr": "ناشَدتُكُم تِلكَ الدِّماءَ زَكِيَّةً",
      "ajuz": "لا تَبعَثوا لِلبَرلَمانِ جَهولا"
    },
    {
      "n": 57,
      "sadr": "فَليَسأَلَنَّ عَنِ الأَرائِكِ سائِلٌ",
      "ajuz": "أَحَمَلنَ فَضلاً أَم حَمَلنَ فُضولا"
    },
    {
      "n": 58,
      "sadr": "إِن أَنتَ أَطلَعتَ المُمَثِّلَ ناقِصاً",
      "ajuz": "لَم تَلقَ عِندَ كَمالِهِ التَّمثيلا"
    },
    {
      "n": 59,
      "sadr": "فَاِدعوا لَها أَهلَ الأَمانَةِ وَاِجعَلوا",
      "ajuz": "لِأُولي البَصائِرِ مِنهُمُ التَّفضيلا"
    },
    {
      "n": 60,
      "sadr": "إِنَّ المُقَصِّرَ قَد يَحولُ وَلَن تَرى",
      "ajuz": "لِجَهالَةِ الطَّبعِ الغَبِيِّ مُحيلا"
    },
    {
      "n": 61,
      "sadr": "فَلَرُبَّ قَولٍ في الرِّجالِ سَمِعتُمُ",
      "ajuz": "ثُمَّ اِنقَضى فَكَأَنَّهُ ما قيلا"
    },
    {
      "n": 62,
      "sadr": "وَلَكَم نَصَرتُم بِالكَرامَةِ وَالهَوى",
      "ajuz": "مَن كانَ عِندَكُمُ هُوَ المَخذولا"
    },
    {
      "n": 63,
      "sadr": "كَرَمٌ وَصَفحٌ في الشَّبابِ وَطالَما",
      "ajuz": "كَرُمَ الشَّبابُ شَمائِلاً وَمُيولا"
    },
    {
      "n": 64,
      "sadr": "قوموا اِجمَعوا شَعبَ الأُبُوَّةِ وَارفَعوا",
      "ajuz": "صَوتَ الشَّبابِ مُحَبَّباً مَقبولا"
    },
    {
      "n": 65,
      "sadr": "ما أَبعَدَ الغاياتِ إِلّا أَنَّني",
      "ajuz": "أَجِدُ الثَّباتَ لَكُم بِهِنَّ كَفيلا"
    },
    {
      "n": 66,
      "sadr": "فَكِلوا إِلى اللَّهِ النَّجاحَ وَثابِروا",
      "ajuz": "فَاللَّهُ خَيرٌ كافِلاً وَوَكيلا"
    }
  ]
}
