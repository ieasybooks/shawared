{
  "id": "lamiyyat-ibn-al-wardi",
  "poet": "ibn-al-wardi",
  "title": "لامِيَّةُ اِبنِ الوَردِيِّ",
  "meter": "ramal",
  "themes": ["advice", "hikma"],
  "rawiy": "ل",
  "abyat_in_full": 80,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "اِعتَزِل ذِكرَ الأَغاني وَالغَزَل", "ajuz": "وَقُلِ الفَصلَ وَجانِب مَن هَزَل" },
    { "n": 2,  "sadr": "وَدَعِ الذِّكرى لِأَيّامِ الصِّبا", "ajuz": "فَلِأَيّامِ الصِّبا نَجمٌ أَفَل" },
    { "n": 3,  "sadr": "إِنَّ أَهنا عيشَةٍ قَضَّيتُها", "ajuz": "ذَهَبَت لَذّاتُها وَالإِثمُ حَل" },
    { "n": 4,  "sadr": "وَاترُكِ الغادَةَ لا تَحفِل بِها", "ajuz": "تُمسِ في عِزٍّ رَفيعٍ وَتُجَل" },
    { "n": 5,  "sadr": "وَالهَ عَن آلَةِ لَهوٍ أَطرَبَت", "ajuz": "وَعَنِ الأَمرَدِ مُرتَجِّ الكَفَل" },
    { "n": 6,  "sadr": "وَافتَكِر في مُنتَهى حُسنِ الَّذي", "ajuz": "أَنتَ تَهواهُ تَجِد أَمراً جَلَل" },
    { "n": 7,  "sadr": "وَاتَّقِ اللَّهَ فَتَقوى اللَّهِ ما", "ajuz": "جاوَرَت قَلبَ اِمرِئٍ إِلّا وَصَل" },
    { "n": 8,  "sadr": "وَاهجُرِ الخَمرَةَ إِن كُنتَ فَتىً", "ajuz": "كَيفَ يَسعى في جُنونٍ مَن عَقَل" },
    { "n": 9,  "sadr": "لَيسَ مَن يَقطَعُ طُرقاً بَطَلاً", "ajuz": "إِنَّما مَن يَتَّقي اللَّهَ البَطَل" },
    { "n": 10, "sadr": "صَدِّقِ الشَّرعَ وَلا تَركَن إِلى", "ajuz": "رَجُلٍ يَرصُدُ في اللَّيلِ زُحَل" },
    { "n": 11, "sadr": "حارَتِ الأَفكارُ في حِكمَةِ مَن", "ajuz": "قَد هَدانا سُبلَنا عَزَّ وَجَل" },
    { "n": 12, "sadr": "كُتِبَ المَوتُ عَلى الخَلقِ فَكَم", "ajuz": "فَلَّ مِن جَمعٍ وَأَفنى مِن دُوَل" },
    { "n": 13, "sadr": "أَينَ نُمرودُ وَكَنعانُ وَمَن", "ajuz": "مَلَكَ الأَرضَ وَوَلّى وَعَزَل" },
    { "n": 14, "sadr": "أَينَ عادٌ أَينَ فِرعَونُ وَمَن", "ajuz": "رَفَعَ الأَهرامَ مَن يَسمَع يَخَل" },
    { "n": 15, "sadr": "أَينَ مَن سادوا وَشادوا وَبَنَوا", "ajuz": "هَلَكَ الكُلُّ فَلَم تُغنِ القُلَل" },
    { "n": 16, "sadr": "أَينَ أَربابُ الحِجا أَهلُ النُّهى", "ajuz": "أَينَ أَهلُ العِلمِ وَالقَومُ الأُوَل" },
    { "n": 17, "sadr": "سَيُعيدُ اللَّهُ كُلّاً مِنهُمُ", "ajuz": "وَسَيَجزي فاعِلاً ما قَد فَعَل" },
    { "n": 18, "sadr": "أَي بُنَيَّ اِسمَع وَصايا جُمِعَت", "ajuz": "حِكَماً خُصَّت بِها خَيرُ المِلَل" },
    { "n": 19, "sadr": "اُطلُبِ العِلمَ وَلا تَكسَل فَما", "ajuz": "أَبعَدَ الخَيرَ عَلى أَهلِ الكَسَل" },
    { "n": 20, "sadr": "وَاهجُرِ النَّومَ وَحَصِّلهُ فَمَن", "ajuz": "يَعرِفِ المَطلوبَ يَحقِر ما بَذَل" },
    { "n": 21, "sadr": "وَاحتَفِل لِلفِقهِ في الدّينِ وَلا", "ajuz": "تَشتَغِل عَنهُ بِمالٍ وَخَوَل" },
    { "n": 22, "sadr": "لا تَقُل قَد ذَهَبَت أَربابُهُ", "ajuz": "كُلُّ مَن سارَ عَلى الدَّربِ وَصَل" },
    { "n": 23, "sadr": "في اِزدِيادِ العِلمِ إِرغامُ العِدا", "ajuz": "وَجَمالُ العِلمِ إِصلاحُ العَمَل" },
    { "n": 24, "sadr": "جَمِّلِ المَنطِقَ بِالنَّحوِ فَمَن", "ajuz": "يُحرَمِ الإِعرابَ بِالنُّطقِ اِختَبَل" },
    { "n": 25, "sadr": "وَانظِمِ الشِّعرَ وَلازِم مَذهَبي", "ajuz": "في اِطِّراحِ الرِّفدِ فَالدُّنيا أَقَل" },
    { "n": 26, "sadr": "فَهوَ عُنوانٌ عَلى الفَضلِ وَما", "ajuz": "أَحسَنَ الشِّعرَ إِذا لَم يُبتَذَل" },
    { "n": 27, "sadr": "ماتَ أَهلُ الفَضلِ لَم يَبقَ سِوى", "ajuz": "مُقرِفٍ أَو مَن عَلى الأَصلِ اِتَّكَل" },
    { "n": 28, "sadr": "أَنا لا أَختارُ تَقبيلَ يَدٍ", "ajuz": "قَطعُها أَجمَلُ مِن تِلكَ القُبَل" },
    { "n": 29, "sadr": "إِن جَزَتني عَن مَديحي صِرتُ في", "ajuz": "رِقِّها أَو لا فَيَكفيني الخَجَل" },
    { "n": 30, "sadr": "أَعذَبُ الأَلفاظِ قَولي لَكَ خُذ", "ajuz": "وَأَمَرُّ اللَّفظِ نُطقي بِلَعَل" },
    { "n": 31, "sadr": "مُلكُ كِسرى تُغنِ عَنهُ كِسرَةٌ", "ajuz": "وَعَنِ البَحرِ اِجتِزاءٌ بِالوَشَل" },
    { "n": 32, "sadr": "اِعتَبِر نَحنُ قَسَمنا بَينَهُم", "ajuz": "تَلقَهُ حَقّاً وَبِالحَقِّ نَزَل" },
    { "n": 33, "sadr": "لَيسَ ما يَحوي الفَتى مِن عَزمِهِ", "ajuz": "لا وَلا ما فاتَ يَوماً بِالكَسَل" },
    { "n": 34, "sadr": "اِطرَحِ الدُّنيا فَمِن عاداتِها", "ajuz": "تَخفِضُ العالي وَتُعلي مَن سَفَل" },
    { "n": 35, "sadr": "عيشَةُ الزّاهِدِ في تَحصيلِها", "ajuz": "عيشَةُ الجاهِدِ بَل هَذا أَذَل" },
    { "n": 36, "sadr": "كَم جَهولٍ وَهوَ مُثرٍ مُكثِرٌ", "ajuz": "وَحَكيمٍ ماتَ مِنها بِالعِلَل" },
    { "n": 37, "sadr": "كَم شُجاعٍ لَم يَنَل فيها المُنى", "ajuz": "وَجَبانٍ نالَ غاياتِ الأَمَل" },
    { "n": 38, "sadr": "فَاترُكِ الحيلَةَ فيها وَاتَّئِد", "ajuz": "إِنَّما الحيلَةُ في تَركِ الحِيَل" },
    { "n": 39, "sadr": "أَيُّ كَفٍّ لَم تُفِد مِمّا تُفِد", "ajuz": "فَرَماها اللَّهُ مِنها بِالشَّلَل" },
    { "n": 40, "sadr": "لا تَقُل أَصلي وَفَصلي أَبَداً", "ajuz": "إِنَّما أَصلُ الفَتى ما قَد حَصَل" },
    { "n": 41, "sadr": "قَد يَسودُ المَرءُ مِن غَيرِ أَبٍ", "ajuz": "وَبِحُسنِ السَّبكِ قَد يُنفى الزَّغَل" },
    { "n": 42, "sadr": "وَكَذا الوَردُ مِنَ الشَّوكِ وَما", "ajuz": "يَنبُتُ النَّرجِسُ إِلّا مِن بَصَل" },
    { "n": 43, "sadr": "غَيرَ أَنّي أَحمَدُ اللَّهَ عَلى", "ajuz": "نَسَبي إِذ بِأَبي بَكرِ اِتَّصَل" },
    { "n": 44, "sadr": "قيمَةُ الإِنسانِ ما يُحسِنُهُ", "ajuz": "أَكثَرَ الإِنسانُ مِنهُ أَو أَقَل" },
    { "n": 45, "sadr": "اُكتُمِ الأَمرَينِ فَقراً وَغِنىً", "ajuz": "وَاكسِبِ الفَلسَ وَحاسِب مَن بَطَل" },
    { "n": 46, "sadr": "وَادَّرِع جِدّاً وَكَدّاً وَاجتَنِب", "ajuz": "صُحبَةَ الحَمقى وَأَربابِ الخَلَل" },
    { "n": 47, "sadr": "بَينَ تَبذيرٍ وَبُخلٍ رُتبَةٌ", "ajuz": "فَكِلا هَذَينِ إِن دامَ قَتَل" },
    { "n": 48, "sadr": "لا تَخُض في سَبِّ ساداتٍ مَضَوا", "ajuz": "إِنَّهُم لَيسوا بِأَهلٍ لِلزَّلَل" },
    { "n": 49, "sadr": "وَتَغافَل عَن أُمورٍ إِنَّهُ", "ajuz": "لَم يَفُز بِالحَمدِ إِلّا مَن غَفَل" },
    { "n": 50, "sadr": "لَيسَ يَخلو المَرءُ مِن ضِدٍّ وَإِن", "ajuz": "حاوَلَ العُزلَةَ في رَأسِ جَبَل" },
    { "n": 51, "sadr": "مِل عَنِ النَّمّامِ وَاهجُرهُ فَما", "ajuz": "بَلَّغَ المَكروهَ إِلّا مَن نَقَل" },
    { "n": 52, "sadr": "دارِ جارَ السّوءِ بِالصَّبرِ وَإِن", "ajuz": "لَم تَجِد صَبراً فَما أَحلى النَّقَل" },
    { "n": 53, "sadr": "جانِبِ السُّلطانَ وَاحذَر بَطشَهُ", "ajuz": "لا تُعانِد مَن إِذا قالَ فَعَل" },
    { "n": 54, "sadr": "لا تَلِ الحُكمَ وَإِن هُم سَأَلوا", "ajuz": "رَغبَةً فيكَ وَخالِف مَن عَذَل" },
    { "n": 55, "sadr": "إِنَّ نِصفَ النّاسِ أَعداءٌ لِمَن", "ajuz": "وَلِيَ الأَحكامَ هَذا إِن عَدَل" },
    { "n": 56, "sadr": "فَهوَ كَالمَحبوسِ عَن لَذّاتِهِ", "ajuz": "وَكِلا كَفَّيهِ في الحَشرِ تُغَل" },
    { "n": 57, "sadr": "إِنَّ لِلنَّقصِ وَالاِستِثقالِ في", "ajuz": "لَفظَةِ القاضي لَوَعظاً وَمَثَل" },
    { "n": 58, "sadr": "لا تُساوي لَذَّةُ الحُكمِ بِما", "ajuz": "ذاقَهُ المَرءُ إِذا المَرءُ اِنعَزَل" },
    { "n": 59, "sadr": "فَالوِلاياتُ وَإِن طابَت لِمَن", "ajuz": "ذاقَها فَالسُّمُّ في ذاكَ العَسَل" },
    { "n": 60, "sadr": "نَصَبُ المَنصِبِ أَوهى جَسَدي", "ajuz": "وَعَنائي مِن مُداراةِ السَّفَل" },
    { "n": 61, "sadr": "قَصِّرِ الآمالَ في الدُّنيا تَفُز", "ajuz": "فَدَليلُ العَقلِ تَقصيرُ الأَمَل" },
    { "n": 62, "sadr": "إِنَّ مَن يَطلُبُهُ المَوتُ عَلى", "ajuz": "غِرَّةٍ مِنهُ جَديرٌ بِالوَجَل" },
    { "n": 63, "sadr": "غِب وَزُر غِبّاً تَزِد حُبّاً فَمَن", "ajuz": "أَكثَرَ التَّردادَ أَضناهُ المَلَل" },
    { "n": 64, "sadr": "خُذ بِحَدِّ السَّيفِ وَاترُك غِمدَهُ", "ajuz": "وَاعتَبِر فَضلَ الفَتى دونَ الحُلَل" },
    { "n": 65, "sadr": "لا يَضُرُّ الفَضلَ إِقلالٌ كَما", "ajuz": "لا يَضُرُّ الشَّمسَ إِطباقُ الطَّفَل" },
    { "n": 66, "sadr": "حُبُّكَ الأَوطانَ عَجزٌ ظاهِرٌ", "ajuz": "فَاغتَرِب تَلقَ عَنِ الأَهلِ بَدَل" },
    { "n": 67, "sadr": "فَبِمُكثِ الماءِ يَبقى آسِناً", "ajuz": "وَسُرى البَدرِ بِهِ البَدرُ اِكتَمَل" },
    { "n": 68, "sadr": "أَيُّها العائِبُ قَولي عَبَثاً", "ajuz": "إِنَّ طيبَ الوَردِ مُؤذٍ بِالجُعَل" },
    { "n": 69, "sadr": "عَدِّ عَن أَسهُمِ لَفظي وَاستَتِر", "ajuz": "لا يُصيبَنَّكَ سَهمٌ مِن ثُعَل" },
    { "n": 70, "sadr": "لا يَغُرَّنَّكَ لينٌ مِن فَتىً", "ajuz": "إِنَّ لِلحَيّاتِ ليناً يُعتَزَل" },
    { "n": 71, "sadr": "أَنا مِثلُ الماءِ سَهلٌ سائِغٌ", "ajuz": "وَمَتى سُخِّنَ آذى وَقَتَل" },
    { "n": 72, "sadr": "أَنا كَالخَيزورِ صَعبٌ كَسرُهُ", "ajuz": "وَهوَ لَينٌ كَيفَما شِئتَ اِنفَتَل" },
    { "n": 73, "sadr": "غَيرَ أَنّي في زَمانٍ مَن يَكُن", "ajuz": "فيهِ ذا مالٍ هُوَ المَولى الأَجَل" },
    { "n": 74, "sadr": "واجِبٌ عِندَ الوَرى إِكرامُهُ", "ajuz": "وَقَليلُ المالِ فيهِم يُستَقَل" },
    { "n": 75, "sadr": "كُلُّ أَهلِ العَصرِ غُمرٌ وَأَنا", "ajuz": "مِنهُمُ فَاترُك تَفاصيلَ الجُمَل" },
    { "n": 76, "sadr": "وَصَلاةُ اللَّهِ رَبّي كُلَّما", "ajuz": "طَلَعَ الشَّمسُ نَهاراً وَأَفَل" },
    { "n": 77, "sadr": "لِلَّذي حازَ العُلا مِن هاشِمٍ", "ajuz": "أَحمَدَ المُختارِ مَن سادَ الأُوَل" },
    { "n": 78, "sadr": "وَعَلى آلٍ وَصَحبٍ سادَةٍ", "ajuz": "لَيسَ فيهِم عاجِزٌ إِلّا بَطَل" }
  ]
}
