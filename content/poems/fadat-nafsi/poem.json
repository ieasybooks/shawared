{
  "id": "fadat-nafsi",
  "poet": "abu-al-ghul-al-tuhawi",
  "title": "فَدَت نَفسي وَما مَلَكَت يَميني",
  "meter": "wafir",
  "themes": ["hamasa", "madh"],
  "rawiy": "ن",
  "abyat_in_full": 7,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "فَدَت نَفسي وَما مَلَكَت يَميني",
      "ajuz": "فَوارِسَ صَدَّقوا فيهِم ظُنوني"
    },
    {
      "n": 2,
      "sadr": "فَوارِسَ لا يَمَلّونَ المَنايا",
      "ajuz": "إِذا دارَت رَحى الحَربِ الزَّبونِ"
    },
    {
      "n": 3,
      "sadr": "وَلا يَجزونَ مِن حَسَنٍ بِسَيءٍ",
      "ajuz": "وَلا يَجزونَ مِن غِلَظٍ بِلينِ"
    },
    {
      "n": 4,
      "sadr": "وَلا تَبلى بَسالَتُهُم وَإِن هُم",
      "ajuz": "صَلوا بِالحَربِ حيناً بَعدَ حينِ"
    },
    {
      "n": 5,
      "sadr": "هُمُ مَنَعوا حِمى الوَقبى بِضَربٍ",
      "ajuz": "يُؤَلِّفُ بَينَ أَشتاتِ المَنونِ"
    },
    {
      "n": 6,
      "sadr": "فَنَكَّبَ عَنهُمُ دَرءَ الأَعادي",
      "ajuz": "وَداوَوا بِالجُنونِ مِنَ الجُنونِ"
    },
    {
      "n": 7,
      "sadr": "وَلا يَرعَونَ أَكنافَ الهُوَينى",
      "ajuz": "إِذا حَلّوا وَلا رَوضَ الهُدونِ"
    }
  ]
}
