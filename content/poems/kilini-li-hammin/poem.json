{
  "id": "kilini-li-hammin",
  "poet": "al-nabigha-al-dhubyani",
  "title": "كِليني لِهَمٍّ يا أُمَيمَةَ ناصِبِ",
  "meter": "tawil",
  "themes": ["madh", "hamasa"],
  "rawiy": "ب",
  "abyat_in_full": 29,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "كِليني لِهَمٍّ يا أُمَيمَةَ ناصِبِ",
      "ajuz": "وَلَيلٍ أُقاسيهِ بَطيءِ الكَواكِبِ"
    },
    {
      "n": 2,
      "sadr": "تَطاوَلَ حَتّى قُلتُ لَيسَ بِمُنقَضٍ",
      "ajuz": "وَلَيسَ الَّذي يَرعى النُّجومَ بِآئِبِ"
    },
    {
      "n": 3,
      "sadr": "وَصَدرٍ أَراحَ اللَّيلُ عازِبَ هَمِّهِ",
      "ajuz": "تَضاعَفَ فيهِ الحُزنُ مِن كُلِّ جانِبِ"
    },
    {
      "n": 4,
      "sadr": "عَلَيَّ لِعَمرٍو نِعمَةٌ بَعدَ نِعمَةٍ",
      "ajuz": "لِوالِدِهِ لَيسَت بِذاتِ عَقارِبِ"
    },
    {
      "n": 5,
      "sadr": "حَلَفتُ يَميناً غَيرَ ذي مَثنَوِيَّةٍ",
      "ajuz": "وَلا عِلمَ إِلّا حُسنُ ظَنٍّ بِصاحِبِ"
    },
    {
      "n": 6,
      "sadr": "لَئِن كانَ لِلقَبرَينِ قَبرٍ بِجِلَّقٍ",
      "ajuz": "وَقَبرٍ بِصَيداءَ الَّذي عِندَ حارِبِ"
    },
    {
      "n": 7,
      "sadr": "وَلِلحارِثِ الجَفنِيِّ سَيِّدِ قَومِهِ",
      "ajuz": "لَيَلتَمِسَن بِالجَيشِ دارَ المُحارِبِ"
    },
    {
      "n": 8,
      "sadr": "وَثِقتُ لَهُ بِالنَّصرِ إِذ قيلَ قَد غَزَت",
      "ajuz": "كَتائِبُ مِن غَسّانَ غَيرُ أَشائِبِ"
    },
    {
      "n": 9,
      "sadr": "بَنو عَمِّهِ دُنيا وَعَمرو اِبنُ عامِرٍ",
      "ajuz": "أُولَئِكَ قَومٌ بَأسُهُم غَيرُ كاذِبِ"
    },
    {
      "n": 10,
      "sadr": "إِذا ما غَزَوا بِالجَيشِ حَلَّقَ فَوقَهُم",
      "ajuz": "عَصائِبُ طَيرٍ تَهتَدي بِعَصائِبِ"
    },
    {
      "n": 11,
      "sadr": "يُصاحِبنَهُم حَتّى يُغِرنَ مُغارَهُم",
      "ajuz": "مِنَ الضّارِياتِ بِالدِّماءِ الدَّوارِبِ"
    },
    {
      "n": 12,
      "sadr": "تَراهُنَّ خَلفَ القَومِ خُزراً عُيونُها",
      "ajuz": "جُلوسَ الشُّيوخِ في ثِيابِ المَرانِبِ"
    },
    {
      "n": 13,
      "sadr": "جَوانِحَ قَد أَيقَنَّ أَنَّ قَبيلَهُ",
      "ajuz": "إِذا ما اِلتَقى الجَمعانِ أَوَّلُ غالِبِ"
    },
    {
      "n": 14,
      "sadr": "لَهُنَّ عَلَيهِم عادَةٌ قَد عَرَفنَها",
      "ajuz": "إِذا عُرِّضَ الخَطِّيُّ فَوقَ الكَواثِبِ"
    },
    {
      "n": 15,
      "sadr": "عَلى عارِفاتٍ لِلطِّعانِ عَوابِسٍ",
      "ajuz": "بِهِنَّ كُلومٌ بَينَ دامٍ وَجالِبِ"
    },
    {
      "n": 16,
      "sadr": "إِذا اُستُنزِلوا عَنهُنَّ لِلطَّعنِ أَرقَلوا",
      "ajuz": "إِلى المَوتِ إِرقالَ الجِمالِ المَصاعِبِ"
    },
    {
      "n": 17,
      "sadr": "فَهُم يَتَساقَونَ المَنِيّاتِ بَينَهُم",
      "ajuz": "بِأَيديهِمُ بيضٌ رِقاقُ المَضارِبِ"
    },
    {
      "n": 18,
      "sadr": "يَطيرُ فُضاضاً بَينَها كُلُّ قَونَسٍ",
      "ajuz": "وَيَتبَعُها مِنهُم فَراشُ الحَواجِبِ"
    },
    {
      "n": 19,
      "sadr": "وَلا عَيبَ فيهِم غَيرَ أَنَّ سُيوفَهُم",
      "ajuz": "بِهِنَّ فُلولٌ مِن قِراعِ الكَتائِبِ"
    },
    {
      "n": 20,
      "sadr": "تُوُرِّثنَ مِن أَزمانِ يَومِ حَليمَةٍ",
      "ajuz": "إِلى اليَومِ قَد جُرِّبنَ كُلَّ التَّجارِبِ"
    },
    {
      "n": 21,
      "sadr": "تَقُدُّ السَّلوقِيَّ المُضاعَفَ نَسجُهُ",
      "ajuz": "وَتوقِدُ بِالصِّفاحِ نارَ الحُباحِبِ"
    },
    {
      "n": 22,
      "sadr": "بِضَربٍ يُزيلُ الهامَ عَن سَكِناتِهِ",
      "ajuz": "وَطَعنٍ كَإيزاغِ المَخاضِ الضَّوارِبِ"
    },
    {
      "n": 23,
      "sadr": "لَهُم شيمَةٌ لَم يُعطِها اللَّهُ غَيرَهُم",
      "ajuz": "مِنَ النّاسِ وَالأَحلامُ غَيرُ عَوازِبِ"
    },
    {
      "n": 24,
      "sadr": "مَحَلَّتُهُم ذاتُ الإِلَهِ وَدينُهُم",
      "ajuz": "قَويمٌ فَما يَرجونَ غَيرَ العَواقِبِ"
    },
    {
      "n": 25,
      "sadr": "رِقاقُ النِّعالِ طَيِّبٌ حُجُزاتُهُم",
      "ajuz": "يُحَيَّونَ بِالرَّيحانِ يَومَ السَّباسِبِ"
    },
    {
      "n": 26,
      "sadr": "تُحَيّيهِمُ بيضُ الوَلائِدِ بَينَهُم",
      "ajuz": "وَأَكسِيَةُ الإِضريجِ فَوقَ المَشاجِبِ"
    },
    {
      "n": 27,
      "sadr": "يَصونونَ أَجساداً قَديماً نَعيمُها",
      "ajuz": "بِخالِصَةِ الأَردانِ خُضرِ المَناكِبِ"
    },
    {
      "n": 28,
      "sadr": "وَلا يَحسَبونَ الخَيرَ لا شَرَّ بَعدَهُ",
      "ajuz": "وَلا يَحسَبونَ الشَّرَّ ضَربَةَ لازِبِ"
    },
    {
      "n": 29,
      "sadr": "حَبَوتُ بِها غَسّانَ إِذ كُنتُ لاحِقاً",
      "ajuz": "بِقَومي وَإِذ أَعيَت عَلَيَّ مَذاهِبي"
    }
  ]
}
