{
  "id": "sakana-al-zalamu",
  "poet": "hafiz-ibrahim",
  "title": "سَكَنَ الظَّلامُ وَباتَ قَلبُكَ يَخفِقُ",
  "meter": "kamil",
  "themes": ["ghazal"],
  "rawiy": "ق",
  "abyat_in_full": 35,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1, "sadr": "سَكَنَ الظَّلامُ وَباتَ قَلبُكَ يَخفِقُ", "ajuz": "وَسَطا عَلى جَنبَيكَ هَمٌّ مُقلِقُ" },
    { "n": 2, "sadr": "حارَ الفِراشُ وَحِرتَ فيهِ فَأَنتُما", "ajuz": "تَحتَ الظَّلامِ مُعَذَّبٌ وَمُؤَرَّقُ" },
    { "n": 3, "sadr": "دَرَجَ الزَّمانُ وَأَنتَ مَفتونُ المُنى", "ajuz": "وَمَضى الشَّبابُ وَأَنتَ ساهٍ مُطرِقُ" },
    { "n": 4, "sadr": "عَجَباً يَلَذُّ لَكَ السُّكوتُ مَعَ الهَوى", "ajuz": "وَسِواكَ يَبعَثُهُ الغَرامُ فَيَنطِقُ" },
    { "n": 5, "sadr": "خُلِقَ الغَرامُ لِأَصغَرَيكَ وَطالَما", "ajuz": "ظَنّوا الظُّنونَ بِأَصغَرَيكَ وَأَغرَقوا" },
    { "n": 6, "sadr": "وَرَمَوكَ بِالسَّلوى وَلَو شَهِدوا الَّذي", "ajuz": "تَطويهِ في تِلكَ الضُّلوعِ لَأَشفَقوا" },
    { "n": 7, "sadr": "أَخفَيتَ أَسرارَ الفُؤادِ وَإِنَّما", "ajuz": "سِرُّ الفُؤادِ مِنَ النَّواظِرِ يُسرَقُ" },
    { "n": 8, "sadr": "نَفِّس بِرَبِّكَ عَن فُؤادِكَ كَربَهُ", "ajuz": "وَارحَم حَشاكَ فَإِنَّها تَتَمَزَّقُ" },
    { "n": 9, "sadr": "وَاذكُر لَنا عَهدَ الَّذينَ بِنَأيِهِم", "ajuz": "جَمَعوا عَلَيكَ هُمومَهُم وَتَفَرَّقوا" },
    { "n": 10, "sadr": "ما لِلقَوافي أَنكَرَتكَ وَلَم تَكُن", "ajuz": "لِكَسادِها في غَيرِ سوقِكَ تَنفُقُ" },
    { "n": 11, "sadr": "ما لِلبَيانِ بِغَيرِ بابِكَ واقِفاً", "ajuz": "يَبكي وَيُعجِلُهُ البُكاءُ فَيَشرَقُ" },
    { "n": 12, "sadr": "إِنّي كَهَمِّكَ في الصَّبابَةِ لَم أَزَل", "ajuz": "أَلهو وَأَرتَجِلُ القَريضَ وَأَعشَقُ" },
    { "n": 13, "sadr": "نَفسي بِرَغمِ الحادِثاتِ فَتِيَّةٌ", "ajuz": "عودي عَلى رَغمِ الكَوارِثِ مورِقُ" },
    { "n": 14, "sadr": "إِنَّ الَّذي أَغرى السُّهادَ بِمُقلَتي", "ajuz": "مُتَعَنِّتٌ قَلبي بِهِ مُتَعَلِّقُ" },
    { "n": 15, "sadr": "واثَقتُهُ أَلّا أَبوحَ وَإِنَّما", "ajuz": "يَومَ الحِسابِ يُحَلُّ ذاكَ المَوثِقُ" },
    { "n": 16, "sadr": "وَشَقيتُ مِنهُ بِقُربِهِ وَبِعادِهِ", "ajuz": "وَأَخو الشَّقاءِ إِلى الشَّقاءِ مُوَفَّقُ" },
    { "n": 17, "sadr": "صاحَبتُ أَسبابَ الرِّضا لِرُكوبِهِ", "ajuz": "مَتنَ الخِلافِ لِما بِهِ أَتَخَلَّقُ" },
    { "n": 18, "sadr": "وَصَبَرتُ مِنهُ عَلى الَّذي يَعيا بِهِ", "ajuz": "حِلمُ الحَليمِ وَيَتَّقيهِ الأَحمَقُ" },
    { "n": 19, "sadr": "وَغَدَوتُ أَنظِمُ مِن ثَنايا ثَغرِهِ", "ajuz": "دُرَراً أُقَلِّدُها المَها وَأُطَوِّقُ" }
  ]
}
