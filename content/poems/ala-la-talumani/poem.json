{
  "id": "ala-la-talumani",
  "poet": "abd-yaghuth-al-harithi",
  "title": "أَلا لا تَلوماني كَفى اللَّومَ ما بِيا",
  "meter": "tawil",
  "themes": ["ritha", "fakhr"],
  "rawiy": "ي",
  "abyat_in_full": 20,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1,  "sadr": "أَلا لا تَلوماني كَفى اللَّومَ ما بِيا", "ajuz": "وَما لَكُما في اللَّومِ خَيرٌ وَلا لِيا" },
    { "n": 2,  "sadr": "أَلَم تَعلَما أَنَّ المَلامَةَ نَفعُها", "ajuz": "قَليلٌ وَما لَومي أَخي مِن شِمالِيا" },
    { "n": 3,  "sadr": "فَيا راكِباً إِمّا عَرَضتَ فَبَلِّغَن", "ajuz": "نَدامايَ مِن نَجرانَ أَن لا تَلاقِيا" },
    { "n": 4,  "sadr": "أَبا كَرِبٍ وَالأَيهَمَينِ كِلَيهِما", "ajuz": "وَقَيساً بِأَعلى حَضرَمَوتَ اليَمانِيا" },
    { "n": 5,  "sadr": "جَزى اللَّهُ قَومي بِالكُلابِ مَلامَةً", "ajuz": "صَريحَهُمُ وَالآخَرينَ المَوالِيا" },
    { "n": 6,  "sadr": "وَلَو شِئتُ نَجَّتني مِنَ الخَيلِ نَهدَةٌ", "ajuz": "تَرى خَلفَها الحُوَّ الجِيادَ تَوالِيا" },
    { "n": 7,  "sadr": "وَلَكِنَّني أَحمي ذِمارَ أَبيكُمُ", "ajuz": "وَكانَ الرِّماحُ يَختَطِفنَ المُحامِيا" },
    { "n": 8,  "sadr": "أَقولُ وَقَد شَدّوا لِساني بِنِسعَةٍ", "ajuz": "أَمَعشَرَ تَيمٍ أَطلِقوا عَن لِسانِيا" },
    { "n": 9,  "sadr": "أَمَعشَرَ تَيمٍ قَد مَلَكتُم فَأَسجِحوا", "ajuz": "فَإِنَّ أَخاكُم لَم يَكُن مِن بَوائِيا" },
    { "n": 10, "sadr": "فَإِن تَقتُلوني تَقتُلوا بِيَ سَيِّداً", "ajuz": "وَإِن تُطلِقوني تَحرُبوني بِمالِيا" },
    { "n": 11, "sadr": "أَحَقّاً عِبادَ اللَّهِ أَن لَستُ سامِعاً", "ajuz": "نَشيدَ الرُّعاءِ المُعزِبينَ المَتالِيا" },
    { "n": 12, "sadr": "وَتَضحَكُ مِنّي شَيخَةٌ عَبشَمِيَّةٌ", "ajuz": "كَأَن لَم تَرى قَبلي أَسيراً يَمانِيا" },
    { "n": 13, "sadr": "وَظَلَّ نِساءُ الحَيِّ حَولِيَ رُكَّداً", "ajuz": "يُراوِدنَ مِنّي ما تُريدُ نِسائِيا" },
    { "n": 14, "sadr": "وَقَد عَلِمَت عِرسي مُلَيكَةُ أَنَّني", "ajuz": "أَنا اللَّيثُ مَعدُوّاً عَلَيَّ وَعادِيا" },
    { "n": 15, "sadr": "وَقَد كُنتُ نَحّارَ الجَزورِ وَمُعمِلَ ال", "ajuz": "مَطِيِّ وَأَمضي حَيثُ لا حَيَّ ماضِيا" },
    { "n": 16, "sadr": "وَأَنحَرُ لِلشَّربِ الكِرامِ مَطِيَّتي", "ajuz": "وَأَصدَعُ بَينَ القَينَتَينِ رِدائِيا" },
    { "n": 17, "sadr": "وَكُنتُ إِذا ما الخَيلُ شَمَّصَها القَنا", "ajuz": "لَبيقاً بِتَصريفِ القَناةِ بَنانِيا" },
    { "n": 18, "sadr": "وَعادِيَةٍ سَومَ الجَرادِ وَزَعتُها", "ajuz": "بِكَفّي وَقَد أَنحَوا إِلَيَّ العَوالِيا" },
    { "n": 19, "sadr": "كَأَنِّيَ لَم أَركَب جَواداً وَلَم أَقُل", "ajuz": "لِخَيلِيَ كُرّي نَفِّسي عَن رِجالِيا" },
    { "n": 20, "sadr": "وَلَم أَسبَإِ الزِّقَّ الرَّوِيَّ وَلَم أَقُل", "ajuz": "لِأَيسارِ صِدقٍ أَعظِموا ضَوءَ نارِيا" }
  ]
}
