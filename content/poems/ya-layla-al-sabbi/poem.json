{
  "id": "ya-layla-al-sabbi",
  "poet": "al-husri-al-qayrawani",
  "title": "يا لَيلُ الصَّبُّ مَتى غَدُهُ",
  "meter": "mutadarik",
  "themes": ["ghazal", "shawq"],
  "rawiy": "د",
  "abyat_in_full": 99,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "يا لَيلُ الصَّبُّ مَتى غَدُهُ", "ajuz": "أَقِيامُ السّاعَةِ مَوعِدُهُ" },
    { "n": 2,  "sadr": "رَقَدَ السُّمّارُ فَأَرَّقَهُ", "ajuz": "أَسَفٌ لِلبَينِ يُرَدِّدُهُ" },
    { "n": 3,  "sadr": "فَبَكاهُ النَّجمُ وَرَقَّ لَهُ", "ajuz": "مِمّا يَرعاهُ وَيَرصُدُهُ" },
    { "n": 4,  "sadr": "كَلِفٌ بِغَزالٍ ذي هَيَفٍ", "ajuz": "خَوفُ الواشينَ يُشَرِّدُهُ" },
    { "n": 5,  "sadr": "نَصَبَت عَينايَ لَهُ شَرَكاً", "ajuz": "في النَّومِ فَعَزَّ تَصَيُّدُهُ" },
    { "n": 6,  "sadr": "وَكَفى عَجَباً أَنّي قَنِصٌ", "ajuz": "لِلسِّربِ سَباني أَغيَدُهُ" },
    { "n": 7,  "sadr": "صَنَمٌ لِلفِتنَةِ مُنتَصِبٌ", "ajuz": "أَهواهُ وَلا أَتَعَبَّدُهُ" },
    { "n": 8,  "sadr": "صاحٍ وَالخَمرُ جَنى فَمِهِ", "ajuz": "سَكرانُ اللَّحظِ مُعَربِدُهُ" },
    { "n": 9,  "sadr": "يَنضو مِن مُقلَتِهِ سَيفاً", "ajuz": "وَكَأَنَّ نُعاساً يُغمِدُهُ" },
    { "n": 10, "sadr": "فَيُريقُ دَمَ العُشّاقِ بِهِ", "ajuz": "وَالوَيلُ لِمَن يَتَقَلَّدُهُ" },
    { "n": 11, "sadr": "كَلّا لا ذَنبَ لِمَن قَتَلَت", "ajuz": "عَيناهُ وَلَم تَقتُل يَدُهُ" },
    { "n": 12, "sadr": "يا مَن جَحَدَت عَيناهُ دَمي", "ajuz": "وَعَلى خَدَّيهِ تَوَرُّدُهُ" },
    { "n": 13, "sadr": "خَدّاكَ قَدِ اِعتَرَفا بِدَمي", "ajuz": "فَعَلامَ جُفونُكَ تَجحَدُهُ" },
    { "n": 14, "sadr": "إِنّي لَأُعيذُكَ مِن قَتلي", "ajuz": "وَأَظُنُّكَ لا تَتَعَمَّدُهُ" },
    { "n": 15, "sadr": "بِاللَّهِ هَبِ المُشتاقَ كَرىً", "ajuz": "فَلَعَلَّ خَيالَكَ يُسعِدُهُ" },
    { "n": 16, "sadr": "ما ضَرَّكَ لَو داوَيتَ ضَنى", "ajuz": "صَبٍّ يُدنيكَ وَتُبعِدُهُ" },
    { "n": 17, "sadr": "لَم يُبقِ هَواكَ لَهُ رَمَقاً", "ajuz": "فَليَبكِ عَلَيهِ عُوَّدُهُ" },
    { "n": 18, "sadr": "وَغَداً يَقضي أَو بَعدَ غَدٍ", "ajuz": "هَل مِن نَظَرٍ يَتَزَوَّدُهُ" },
    { "n": 19, "sadr": "يا أَهلَ الشَّوقِ لَنا شَرَقٌ", "ajuz": "بِالدَّمعِ يَفيضُ مُوَرَّدُهُ" },
    { "n": 20, "sadr": "يَهوى المُشتاقُ لِقاءَكُمُ", "ajuz": "وَظُروفُ الدَّهرِ تُبَعِّدُهُ" },
    { "n": 21, "sadr": "ما أَحلى الوَصلَ وَأَعذَبَهُ", "ajuz": "لَولا الأَيّامُ تُنَكِّدُهُ" },
    { "n": 22, "sadr": "بِالبَينِ وَبِالهِجرانِ فَيا", "ajuz": "لِفُؤادي كَيفَ تَجَلُّدُهُ" },
    { "n": 23, "sadr": "الحُبُّ أَعَفُّ ذَويهِ أَنا", "ajuz": "غَيري بِالباطِلِ يُفسِدُهُ" }
  ]
}
