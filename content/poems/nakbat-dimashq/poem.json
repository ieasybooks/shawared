{
  "id": "nakbat-dimashq",
  "poet": "ahmad-shawqi",
  "title": "نَكبَةُ دِمَشقَ",
  "meter": "wafir",
  "rawiy": "ق",
  "abyat_in_full": 55,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "سَلامٌ مِن صَبا بَرَدى أَرَقُّ", "ajuz": "وَدَمعٌ لا يُكَفكَفُ يا دِمَشقُ" },
    { "n": 2,  "sadr": "وَمَعذِرَةُ اليَراعَةِ وَالقَوافي", "ajuz": "جَلالُ الرُّزءِ عَن وَصفٍ يَدِقُّ" },
    { "n": 3,  "sadr": "وَذِكرى عَن خَواطِرِها لِقَلبي", "ajuz": "إِلَيكِ تَلَفُّتٌ أَبَداً وَخَفقُ" },
    { "n": 4,  "sadr": "وَبي مِمّا رَمَتكِ بِهِ اللَّيالي", "ajuz": "جِراحاتٌ لَها في القَلبِ عُمقُ" },
    { "n": 5,  "sadr": "دَخَلتُكِ وَالأَصيلُ لَهُ اِئتِلاقٌ", "ajuz": "وَوَجهُكِ ضاحِكُ القَسَماتِ طَلقُ" },
    { "n": 6,  "sadr": "وَتَحتَ جِنانِكِ الأَنهارُ تَجري", "ajuz": "وَمِلءُ رُباكِ أَوراقٌ وَوُرقُ" },
    { "n": 7,  "sadr": "وَحَولي فِتيَةٌ غُرٌّ صِباحٌ", "ajuz": "لَهُم في الفَضلِ غاياتٌ وَسَبقُ" },
    { "n": 8,  "sadr": "عَلى لَهَواتِهِم شُعَراءُ لُسنٌ", "ajuz": "وَفي أَعطافِهِم خُطَباءُ شُدقُ" },
    { "n": 9,  "sadr": "رُواةُ قَصائِدي فَاعجَب لِشِعرٍ", "ajuz": "بِكُلِّ مَحَلَّةٍ يَرويهِ خَلقُ" },
    { "n": 10, "sadr": "غَمَزتُ إِباءَهُم حَتّى تَلَظَّت", "ajuz": "أُنوفُ الأُسدِ وَاضطَرَمَ المَدَقُّ" },
    { "n": 11, "sadr": "وَضَجَّ مِنَ الشَّكيمَةِ كُلُّ حُرٍّ", "ajuz": "أَبِيٍّ مِن أُمَيَّةَ فيهِ عِتقُ" },
    { "n": 12, "sadr": "لَحاها اللَّهُ أَنباءً تَوالَت", "ajuz": "عَلى سَمعِ الوَلِيِّ بِما يَشُقُّ" },
    { "n": 13, "sadr": "يُفَصِّلُها إِلى الدُّنيا بَريدٌ", "ajuz": "وَيُجمِلُها إِلى الآفاقِ بَرقُ" },
    { "n": 14, "sadr": "تَكادُ لِرَوعَةِ الأَحداثِ فيها", "ajuz": "تُخالُ مِنَ الخُرافَةِ وَهيَ صِدقُ" },
    { "n": 15, "sadr": "وَقيلَ مَعالِمُ التّاريخِ دُكَّت", "ajuz": "وَقيلَ أَصابَها تَلَفٌ وَحَرقُ" },
    { "n": 16, "sadr": "أَلَستِ دِمَشقُ لِلإِسلامِ ظِئراً", "ajuz": "وَمُرضِعَةُ الأُبُوَّةِ لا تُعَقُّ" },
    { "n": 17, "sadr": "صَلاحُ الدّينِ تاجُكَ لَم يُجَمَّل", "ajuz": "وَلَم يوسَم بِأَزيَنَ مِنهُ فَرقُ" },
    { "n": 18, "sadr": "وَكُلُّ حَضارَةٍ في الأَرضِ طالَت", "ajuz": "لَها مِن سَرحِكِ العُلوِيِّ عِرقُ" },
    { "n": 19, "sadr": "سَماؤُكِ مِن حُلى الماضي كِتابٌ", "ajuz": "وَأَرضُكِ مِن حُلى التّاريخِ رَقُّ" },
    { "n": 20, "sadr": "بَنَيتِ الدَّولَةَ الكُبرى وَمُلكاً", "ajuz": "غُبارُ حَضارَتَيهِ لا يُشَقُّ" },
    { "n": 21, "sadr": "لَهُ بِالشّامِ أَعلامٌ وَعُرسٌ", "ajuz": "بَشائِرُهُ بِأَندَلُسٍ تُدَقُّ" },
    { "n": 22, "sadr": "رِباعُ الخُلدِ وَيحَكِ ما دَهاها", "ajuz": "أَحَقٌّ أَنَّها دَرَسَت أَحَقُّ" },
    { "n": 23, "sadr": "وَهَل غُرَفُ الجِنانِ مُنَضَّداتٌ", "ajuz": "وَهَل لِنَعيمِهِنَّ كَأَمسِ نَسقُ" },
    { "n": 24, "sadr": "وَأَينَ دُمى المَقاصِرِ مِن حِجالٍ", "ajuz": "مُهَتَّكَةٍ وَأَستارٍ تُشَقُّ" },
    { "n": 25, "sadr": "بَرَزنَ وَفي نَواحي الأَيكِ نارٌ", "ajuz": "وَخَلفَ الأَيكِ أَفراخٌ تُزَقُّ" },
    { "n": 26, "sadr": "إِذا رُمنَ السَّلامَةَ مِن طَريقٍ", "ajuz": "أَتَت مِن دونِهِ لِلمَوتِ طُرقُ" },
    { "n": 27, "sadr": "بِلَيلٍ لِلقَذائِفِ وَالمَنايا", "ajuz": "وَراءَ سَمائِهِ خَطفٌ وَصَعقُ" },
    { "n": 28, "sadr": "إِذا عَصَفَ الحَديدُ اِحمَرَّ أُفقٌ", "ajuz": "عَلى جَنَباتِهِ وَاسوَدَّ أُفقُ" },
    { "n": 29, "sadr": "سَلي مَن راعَ غيدَكِ بَعدَ وَهنٍ", "ajuz": "أَبَينَ فُؤادِهِ وَالصَّخرِ فَرقُ" },
    { "n": 30, "sadr": "وَلِلمُستَعمِرينَ وَإِن أَلانوا", "ajuz": "قُلوبٌ كَالحِجارَةِ لا تَرِقُّ" },
    { "n": 31, "sadr": "رَماكِ بِطَيشِهِ وَرَمى فَرَنسا", "ajuz": "أَخو حَربٍ بِهِ صَلَفٌ وَحُمقُ" },
    { "n": 32, "sadr": "إِذا ما جاءَهُ طُلّابُ حَقٍّ", "ajuz": "يَقولُ عِصابَةٌ خَرَجوا وَشَقّوا" },
    { "n": 33, "sadr": "دَمُ الثُّوّارِ تَعرِفُهُ فَرَنسا", "ajuz": "وَتَعلَمُ أَنَّهُ نورٌ وَحَقُّ" },
    { "n": 34, "sadr": "جَرى في أَرضِها فيهِ حَياةٌ", "ajuz": "كَمُنهَلِّ السَّماءِ وَفيهِ رِزقُ" },
    { "n": 35, "sadr": "بِلادٌ ماتَ فِتيَتُها لِتَحيا", "ajuz": "وَزالوا دونَ قَومِهِمُ لِيَبقوا" },
    { "n": 36, "sadr": "وَحُرِّرَتِ الشُّعوبُ عَلى قَناها", "ajuz": "فَكَيفَ عَلى قَناها تُستَرَقُّ" },
    { "n": 37, "sadr": "بَني سورِيَّةَ اِطَّرِحوا الأَماني", "ajuz": "وَأَلقوا عَنكُمُ الأَحلامَ أَلقوا" },
    { "n": 38, "sadr": "فَمِن خِدَعِ السِّياسَةِ أَن تُغَرّوا", "ajuz": "بِأَلقابِ الإِمارَةِ وَهيَ رِقُّ" },
    { "n": 39, "sadr": "وَكَم صَيَدٍ بَدا لَكَ مِن ذَليلٍ", "ajuz": "كَما مالَت مِنَ المَصلوبِ عُنقُ" },
    { "n": 40, "sadr": "فُتوقُ المُلكِ تَحدُثُ ثُمَّ تَمضي", "ajuz": "وَلا يَمضي لِمُختَلِفينَ فَتقُ" },
    { "n": 41, "sadr": "نَصَحتُ وَنَحنُ مُختَلِفونَ داراً", "ajuz": "وَلَكِن كُلُّنا في الهَمِّ شَرقُ" },
    { "n": 42, "sadr": "وَيَجمَعُنا إِذا اِختَلَفَت بِلادٌ", "ajuz": "بَيانٌ غَيرُ مُختَلِفٍ وَنُطقُ" },
    { "n": 43, "sadr": "وَقَفتُم بَينَ مَوتٍ أَو حَياةٍ", "ajuz": "فَإِن رُمتُم نَعيمَ الدَّهرِ فَاشقوا" },
    { "n": 44, "sadr": "وَلِلأَوطانِ في دَمِ كُلِّ حُرٍّ", "ajuz": "يَدٌ سَلَفَت وَدَينٌ مُستَحَقُّ" },
    { "n": 45, "sadr": "وَمَن يَسقي وَيَشرَبُ بِالمَنايا", "ajuz": "إِذا الأَحرارُ لَم يُسقَوا وَيَسقوا" },
    { "n": 46, "sadr": "وَلا يَبني المَمالِكَ كَالضَّحايا", "ajuz": "وَلا يُدني الحُقوقَ وَلا يُحِقُّ" },
    { "n": 47, "sadr": "فَفي القَتلى لِأَجيالٍ حَياةٌ", "ajuz": "وَفي الأَسرى فِدىً لَهُمُ وَعِتقُ" },
    { "n": 48, "sadr": "وَلِلحُرِّيَّةِ الحَمراءِ بابٌ", "ajuz": "بِكُلِّ يَدٍ مُضَرَّجَةٍ يُدَقُّ" },
    { "n": 49, "sadr": "جَزاكُم ذو الجَلالِ بَني دِمَشقٍ", "ajuz": "وَعِزُّ الشَّرقِ أَوَّلُهُ دِمَشقُ" },
    { "n": 50, "sadr": "نَصَرتُم يَومَ مِحنَتِهِ أَخاكُم", "ajuz": "وَكُلُّ أَخٍ بِنَصرِ أَخيهِ حَقُّ" }
  ]
}
