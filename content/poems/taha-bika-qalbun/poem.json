{
  "id": "taha-bika-qalbun",
  "poet": "alqama-al-fahl",
  "title": "طَحا بِكَ قَلبٌ في الحِسانِ طَروبُ",
  "meter": "tawil",
  "rawiy": "ب",
  "abyat_in_full": 43,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "طَحا بِكَ قَلبٌ في الحِسانِ طَروبُ",
      "ajuz": "بُعَيدَ الشَّبابِ عَصرَ حانَ مَشيبُ"
    },
    {
      "n": 2,
      "sadr": "يُكَلِّفُني لَيلى وَقَد شَطَّ وَليُها",
      "ajuz": "وَعادَت عَوادٍ بَينَنا وَخُطوبُ"
    },
    {
      "n": 3,
      "sadr": "مُنَعَّمَةٌ لا يُستَطاعُ كِلامُها",
      "ajuz": "عَلى بابِها مِن أَن تُزارَ رَقيبُ"
    },
    {
      "n": 4,
      "sadr": "إِذا غابَ عَنها البَعلُ لَم تُفشِ سِرَّهُ",
      "ajuz": "وَتُرضي إِيابَ البَعلِ حينَ يَؤوبُ"
    },
    {
      "n": 5,
      "sadr": "فَلا تَعدِلي بَيني وَبَينَ مُغَمَّرٍ",
      "ajuz": "سَقَتكِ رَوايا المُزنِ حَيثُ تَصوبُ"
    },
    {
      "n": 6,
      "sadr": "سَقاكِ يَمانٍ ذو حَبِيٍّ وَعارِضٌ",
      "ajuz": "تَروحُ بِهِ جُنحَ العَشِيِّ جَنوبُ"
    },
    {
      "n": 7,
      "sadr": "وَما أَنتَ أَم ما ذِكرُها رَبَعِيَّةً",
      "ajuz": "يُخَطُّ لَها مِن ثَرمَداءَ قَليبُ"
    },
    {
      "n": 8,
      "sadr": "فَإِن تَسأَلوني بِالنِّساءِ فَإِنَّني",
      "ajuz": "بَصيرٌ بِأَدواءِ النِّساءِ طَبيبُ"
    },
    {
      "n": 9,
      "sadr": "إِذا شابَ رَأسُ المَرءِ أَو قَلَّ مالُهُ",
      "ajuz": "فَلَيسَ لَهُ مِن وُدِّهِنَّ نَصيبُ"
    },
    {
      "n": 10,
      "sadr": "يُرِدنَ ثَراءَ المالِ حَيثُ عَلِمنَهُ",
      "ajuz": "وَشَرخُ الشَّبابِ عِندَهُنَّ عَجيبُ"
    },
    {
      "n": 11,
      "sadr": "فَدَعها وَسَلِّ الهَمَّ عَنكَ بِجَسرَةٍ",
      "ajuz": "كَهَمِّكَ فيها بِالرِّدافِ خَبيبُ"
    },
    {
      "n": 12,
      "sadr": "وَناجِيَةٍ أَفنى رَكيبَ ضُلوعِها",
      "ajuz": "وَحارِكَها تَهَجُّرٌ فَدُؤوبُ"
    },
    {
      "n": 13,
      "sadr": "وَتُصبِحُ عَن غِبِّ السُّرى وَكَأَنَّها",
      "ajuz": "مُوَلَّعَةٌ تَخشى القَنيصَ شَبوبُ"
    },
    {
      "n": 14,
      "sadr": "تَعَفَّقَ بِالأَرطى لَها وَأَرادَها",
      "ajuz": "رِجالٌ فَبَذَّت نَبلَهُم وَكَليبُ"
    },
    {
      "n": 15,
      "sadr": "إِلى الحارِثِ الوَهّابِ أَعمَلتُ ناقَتي",
      "ajuz": "لِكَلكَلِها وَالقُصرَيَينِ وَجيبُ"
    },
    {
      "n": 16,
      "sadr": "لِتُبلِغَني دارَ اِمرِئٍ كانَ نائِياً",
      "ajuz": "فَقَد قَرَّبَتني مِن نَداكَ قَروبُ"
    },
    {
      "n": 17,
      "sadr": "إِلَيكَ أَبَيتَ اللَّعنَ كانَ وَجيفُها",
      "ajuz": "بِمُشتَبِهاتٍ هَولُهُنَّ مَهيبُ"
    },
    {
      "n": 18,
      "sadr": "تَتَبَّعُ أَفياءَ الظِّلالِ عَشِيَّةً",
      "ajuz": "عَلى طُرُقٍ كَأَنَّهُنَّ سُبوبُ"
    },
    {
      "n": 19,
      "sadr": "هَداني إِلَيكَ الفَرقَدانِ وَلاحِبٌ",
      "ajuz": "لَهُ فَوقَ أَصواءِ المِتانِ عُلوبُ"
    },
    {
      "n": 20,
      "sadr": "بِها جِيَفُ الحَسرى فَأَمّا عِظامُها",
      "ajuz": "فَبيضٌ وَأَمّا جِلدُها فَصَليبُ"
    },
    {
      "n": 21,
      "sadr": "فَأَورَدتُها ماءً كَأَنَّ جِمامَهُ",
      "ajuz": "مِنَ الأَجنِ حِنّاءٌ مَعاً وَصَبيبُ"
    },
    {
      "n": 22,
      "sadr": "تُرادُ عَلى دِمنِ الحِياضِ فَإِن تَعَف",
      "ajuz": "فَإِنَّ المُنَدّى رِحلَةٌ فَرُكوبُ"
    },
    {
      "n": 23,
      "sadr": "وَأَنتَ اِمرُؤٌ أَفضَت إِلَيكَ أَمانَتي",
      "ajuz": "وَقَبلَكَ رَبَّتني فَضِعتُ رُبوبُ"
    },
    {
      "n": 24,
      "sadr": "فَأَدَّت بَنو كَعبِ بنِ عَوفٍ رَبيبَها",
      "ajuz": "وَغودِرَ في بَعضِ الجُنودِ رَبيبُ"
    },
    {
      "n": 25,
      "sadr": "فَوَاللَّهِ لَولا فارِسُ الجَونِ مِنهُمُ",
      "ajuz": "لَآبوا خَزايا وَالإِيابُ حَبيبُ"
    },
    {
      "n": 26,
      "sadr": "تُقَدِّمُهُ حَتّى تَغيبَ حُجولُهُ",
      "ajuz": "وَأَنتَ لِبَيضِ الدّارِعينَ ضَروبُ"
    },
    {
      "n": 27,
      "sadr": "مُظاهِرُ سِربالَي حَديدٍ عَلَيهِما",
      "ajuz": "عَقيلا سُيوفٍ مِخذَمٌ وَرَسوبُ"
    },
    {
      "n": 28,
      "sadr": "فَجالَدتَهُم حَتّى اِتَّقَوكَ بِكَبشِهِم",
      "ajuz": "وَقَد حانَ مِن شَمسِ النَّهارِ غُروبُ"
    },
    {
      "n": 29,
      "sadr": "وَقاتَلَ مِن غَسّانَ أَهلُ حِفاظِها",
      "ajuz": "وَهِنبٌ وَقاسٌ جالَدَت وَشَبيبُ"
    },
    {
      "n": 30,
      "sadr": "تَخَشخَشُ أَبدانُ الحَديدِ عَلَيهِمُ",
      "ajuz": "كَما خَشخَشَت يَبسَ الحَصادِ جَنوبُ"
    },
    {
      "n": 31,
      "sadr": "تَجودُ بِنَفسٍ لا يُجادُ بِمِثلِها",
      "ajuz": "وَأَنتَ بِها يَومَ اللِّقاءِ تَطيبُ"
    },
    {
      "n": 32,
      "sadr": "كَأَنَّ رِجالَ الأَوسِ تَحتَ لَبانِهِ",
      "ajuz": "وَما جَمَعَت جَلٌّ مَعاً وَعَتيبُ"
    },
    {
      "n": 33,
      "sadr": "رَغا فَوقَهُم سَقبُ السَّماءِ فَداحِصٌ",
      "ajuz": "بِشِكَّتِهِ لَم يُستَلَب وَسَليبُ"
    },
    {
      "n": 34,
      "sadr": "كَأَنَّهُمُ صابَت عَلَيهِم سَحابَةٌ",
      "ajuz": "صَواعِقُها لِطَيرِهِنَّ دَبيبُ"
    },
    {
      "n": 35,
      "sadr": "فَلَم تَنجُ إِلّا شَطبَةٌ بِلِجامِها",
      "ajuz": "وَإِلّا طِمِرٌّ كَالقَناةِ نَجيبُ"
    },
    {
      "n": 36,
      "sadr": "وَإِلّا كَمِيٌّ ذو حِفاظٍ كَأَنَّهُ",
      "ajuz": "بِما اِبتَلَّ مِن حَدِّ الظُّباتِ خَضيبُ"
    },
    {
      "n": 37,
      "sadr": "وَفي كُلِّ حَيٍّ قَد خَبَطتَ بِنِعمَةٍ",
      "ajuz": "فَحُقَّ لِشَأسٍ مِن نَداكَ ذَنوبُ"
    },
    {
      "n": 38,
      "sadr": "وَما مِثلُهُ في النّاسِ إِلّا قَبيلُهُ",
      "ajuz": "مُساوٍ وَلا دانٍ لِذاكَ قَريبُ"
    },
    {
      "n": 39,
      "sadr": "فَلا تَحرِمَنّي نائِلاً عَن جَنابَةٍ",
      "ajuz": "فَإِنّي اِمرُؤٌ وَسطَ القِبابِ غَريبُ"
    }
  ]
}
