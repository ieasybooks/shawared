{
  "id": "hadha-alladhi-tarifu-al-bathau",
  "poet": "al-farazdaq",
  "title": "هَذا الَّذي تَعرِفُ البَطحاءُ وَطأَتَهُ",
  "meter": "basit",
  "rawiy": "م",
  "abyat_in_full": 27,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "هَذا الَّذي تَعرِفُ البَطحاءُ وَطأَتَهُ",
      "ajuz": "وَالبَيتُ يَعرِفُهُ وَالحِلُّ وَالحَرَمُ"
    },
    {
      "n": 2,
      "sadr": "هَذا اِبنُ خَيرِ عِبادِ اللَّهِ كُلِّهِمُ",
      "ajuz": "هَذا التَّقِيُّ النَّقِيُّ الطّاهِرُ العَلَمُ"
    },
    {
      "n": 3,
      "sadr": "هَذا اِبنُ فاطِمَةٍ إِن كُنتَ جاهِلَهُ",
      "ajuz": "بِجَدِّهِ أَنبِياءُ اللَّهِ قَد خُتِموا"
    },
    {
      "n": 4,
      "sadr": "وَلَيسَ قَولُكَ مَن هَذا بِضائِرِهِ",
      "ajuz": "العُربُ تَعرِفُ مَن أَنكَرتَ وَالعَجَمُ"
    },
    {
      "n": 5,
      "sadr": "كِلتا يَدَيهِ غِياثٌ عَمَّ نَفعُهُما",
      "ajuz": "يُستَوكَفانِ وَلا يَعروهُما عَدَمُ"
    },
    {
      "n": 6,
      "sadr": "سَهلُ الخَليقَةِ لا تُخشى بَوادِرُهُ",
      "ajuz": "يَزينُهُ اِثنانِ حُسنُ الخَلقِ وَالشِّيَمُ"
    },
    {
      "n": 7,
      "sadr": "حَمّالُ أَثقالِ أَقوامٍ إِذا اُفتُدِحوا",
      "ajuz": "حُلوُ الشَّمائِلِ تَحلو عِندَهُ نَعَمُ"
    },
    {
      "n": 8,
      "sadr": "ما قالَ لا قَطُّ إِلّا في تَشَهُّدِهِ",
      "ajuz": "لَولا التَّشَهُّدُ كانَت لاءَهُ نَعَمُ"
    },
    {
      "n": 9,
      "sadr": "عَمَّ البَرِيَّةَ بِالإِحسانِ فَانقَشَعَت",
      "ajuz": "عَنها الغَياهِبُ وَالإِملاقُ وَالعَدَمُ"
    },
    {
      "n": 10,
      "sadr": "إِذا رَأَتهُ قُرَيشٌ قالَ قائِلُها",
      "ajuz": "إِلى مَكارِمِ هَذا يَنتَهي الكَرَمُ"
    },
    {
      "n": 11,
      "sadr": "يُغضي حَياءً وَيُغضى مِن مَهابَتِهِ",
      "ajuz": "فَما يُكَلَّمُ إِلّا حينَ يَبتَسِمُ"
    },
    {
      "n": 12,
      "sadr": "بِكَفِّهِ خَيزُرانٌ ريحُهُ عَبِقٌ",
      "ajuz": "مِن كَفِّ أَروَعَ في عِرنينِهِ شَمَمُ"
    },
    {
      "n": 13,
      "sadr": "يَكادُ يُمسِكُهُ عِرفانَ راحَتِهِ",
      "ajuz": "رُكنُ الحَطيمِ إِذا ما جاءَ يَستَلِمُ"
    },
    {
      "n": 14,
      "sadr": "اللَّهُ شَرَّفَهُ قِدماً وَعَظَّمَهُ",
      "ajuz": "جَرى بِذاكَ لَهُ في لَوحِهِ القَلَمُ"
    },
    {
      "n": 15,
      "sadr": "أَيُّ الخَلائِقِ لَيسَت في رِقابِهِمُ",
      "ajuz": "لِأَوَّلِيَّةِ هَذا أَو لَهُ نِعَمُ"
    },
    {
      "n": 16,
      "sadr": "مَن يَشكُرِ اللَّهَ يَشكُر أَوَّلِيَّةَ ذا",
      "ajuz": "فَالدّينُ مِن بَيتِ هَذا نالَهُ الأُمَمُ"
    },
    {
      "n": 17,
      "sadr": "يُنمى إِلى ذِروَةِ الدّينِ الَّتي قَصُرَت",
      "ajuz": "عَنها الأَكُفُّ وَعَن إِدراكِها القَدَمُ"
    },
    {
      "n": 18,
      "sadr": "مَن جَدُّهُ دانَ فَضلُ الأَنبِياءِ لَهُ",
      "ajuz": "وَفَضلُ أُمَّتِهِ دانَت لَهُ الأُمَمُ"
    },
    {
      "n": 19,
      "sadr": "مُشتَقَّةٌ مِن رَسولِ اللَّهِ نَبعَتُهُ",
      "ajuz": "طابَت مَغارِسُهُ وَالخيمُ وَالشِّيَمُ"
    },
    {
      "n": 20,
      "sadr": "يَنشَقُّ ثَوبُ الدُّجى عَن نورِ غُرَّتِهِ",
      "ajuz": "كَالشَّمسِ تَنجابُ عَن إِشراقِها الظُّلَمُ"
    },
    {
      "n": 21,
      "sadr": "مِن مَعشَرٍ حُبُّهُم دينٌ وَبُغضُهُمُ",
      "ajuz": "كُفرٌ وَقُربُهُمُ مَنجىً وَمُعتَصَمُ"
    },
    {
      "n": 22,
      "sadr": "مُقَدَّمٌ بَعدَ ذِكرِ اللَّهِ ذِكرُهُمُ",
      "ajuz": "في كُلِّ بَدءٍ وَمَختومٌ بِهِ الكَلِمُ"
    },
    {
      "n": 23,
      "sadr": "إِن عُدَّ أَهلُ التُّقى كانوا أَئِمَّتَهُم",
      "ajuz": "أَو قيلَ مَن خَيرُ أَهلِ الأَرضِ قيلَ هُمُ"
    },
    {
      "n": 24,
      "sadr": "لا يَستَطيعُ جَوادٌ بَعدَ جودِهِمُ",
      "ajuz": "وَلا يُدانيهِمُ قَومٌ وَإِن كَرُموا"
    },
    {
      "n": 25,
      "sadr": "هُمُ الغُيوثُ إِذا ما أَزمَةٌ أَزَمَت",
      "ajuz": "وَالأُسدُ أُسدُ الشَّرى وَالبَأسُ مُحتَدِمُ"
    },
    {
      "n": 26,
      "sadr": "لا يَنقُصُ العُسرُ بَسطاً مِن أَكُفِّهِمُ",
      "ajuz": "سِيّانِ ذَلِكَ إِن أَثرَوا وَإِن عَدِموا"
    },
    {
      "n": 27,
      "sadr": "يُستَدفَعُ الشَّرُّ وَالبَلوى بِحُبِّهِمُ",
      "ajuz": "وَيُستَرَبُّ بِهِ الإِحسانُ وَالنِّعَمُ"
    }
  ]
}
