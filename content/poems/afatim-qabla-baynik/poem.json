{
  "id": "afatim-qabla-baynik",
  "poet": "al-muthaqqib-al-abdi",
  "title": "أَفاطِمَ قَبلَ بَينِكِ مَتِّعيني",
  "meter": "wafir",
  "rawiy": "ن",
  "abyat_in_full": 45,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَفاطِمَ قَبلَ بَينِكِ مَتِّعيني",
      "ajuz": "وَمَنعُكِ ما سَأَلتُ كَأَن تَبيني"
    },
    {
      "n": 2,
      "sadr": "فَلا تَعِدي مَواعِدَ كاذِباتٍ",
      "ajuz": "تَمُرُّ بِها رِياحُ الصَّيفِ دوني"
    },
    {
      "n": 3,
      "sadr": "فَإِنّي لَو تُخالِفُني شِمالي",
      "ajuz": "خِلافَكِ ما وَصَلتُ بِها يَميني"
    },
    {
      "n": 4,
      "sadr": "إِذاً لَقَطَعتُها وَلَقُلتُ بيني",
      "ajuz": "كَذَلِكَ أَجتَوي مَن يَجتَويني"
    },
    {
      "n": 5,
      "sadr": "لِمَن ظُعُنٌ تُطالِعُ مِن صُبَيبٍ",
      "ajuz": "فَما خَرَجَت مِنَ الوادي لِحينِ"
    },
    {
      "n": 6,
      "sadr": "مَرَرنَ عَلى شَرافِ فَذاتِ رَجلٍ",
      "ajuz": "وَنَكَّبنَ الذَّرانِحَ بِاليَمينِ"
    },
    {
      "n": 7,
      "sadr": "وَهُنَّ كَذاكَ حينَ قَطَعنَ فَلجاً",
      "ajuz": "كَأَنَّ حُمولَهُنَّ عَلى سَفينِ"
    },
    {
      "n": 8,
      "sadr": "يُشَبَّهنَ السَّفينَ وَهُنَّ بُختٌ",
      "ajuz": "عُراضاتُ الأَباهِرِ وَالشُّؤونِ"
    },
    {
      "n": 9,
      "sadr": "وَهُنَّ عَلى الرَّجائِزِ واكِناتٌ",
      "ajuz": "قَواتِلُ كُلِّ أَشجَعَ مُستَكينِ"
    },
    {
      "n": 10,
      "sadr": "كَغِزلانٍ خَذَلنَ بِذاتِ ضالٍ",
      "ajuz": "تَنوشُ الدّانِياتِ مِنَ الغُصونِ"
    },
    {
      "n": 11,
      "sadr": "ظَهَرنَ بِكِلَّةٍ وَسَدَلنَ أُخرى",
      "ajuz": "وَثَقَّبنَ الوَصاوِصَ لِلعُيونِ"
    },
    {
      "n": 12,
      "sadr": "وَهُنَّ عَلى الظِّلامِ مُطَلَّباتٌ",
      "ajuz": "طَويلاتُ الذَّوائِبِ وَالقُرونِ"
    },
    {
      "n": 13,
      "sadr": "وَمِن ذَهَبٍ يَلوحُ عَلى تَريبٍ",
      "ajuz": "كَلَونِ العاجِ لَيسَ بِذي غُضونِ"
    },
    {
      "n": 14,
      "sadr": "إِذا ما فُتنَهُ يَوماً بِرَهنٍ",
      "ajuz": "يَعِزُّ عَلَيهِ لَم يَرجِع بِحينِ"
    },
    {
      "n": 15,
      "sadr": "بِتَلهِيَةٍ أَريشُ بِها سِهامي",
      "ajuz": "تَبُذُّ المُرشِقاتِ مِنَ القَطينِ"
    },
    {
      "n": 16,
      "sadr": "عَلَونَ رُباوَةً وَهَبَطنَ غَيباً",
      "ajuz": "فَلَم يَرجِعنَ قائِلَةً لِحينِ"
    },
    {
      "n": 17,
      "sadr": "فَقُلتُ لِبَعضِهِنَّ وَشُدَّ رَحلي",
      "ajuz": "لِهاجِرَةٍ نَصَبتُ لَها جَبيني"
    },
    {
      "n": 18,
      "sadr": "لَعَلَّكِ إِن صَرَمتِ الحَبلَ مِنّي",
      "ajuz": "كَذاكِ أَكونُ مُصحِبَتي قُروني"
    },
    {
      "n": 19,
      "sadr": "فَسَلِّ الهَمَّ عَنكَ بِذاتِ لَوثٍ",
      "ajuz": "عُذافِرَةٍ كَمِطرَقَةِ القُيونِ"
    },
    {
      "n": 20,
      "sadr": "بِصادِقَةِ الوَجيفِ كَأَنَّ هِرّاً",
      "ajuz": "يُباريها وَيَأخُذُ بِالوَضينِ"
    },
    {
      "n": 21,
      "sadr": "كَساها تامِكاً قَرِداً عَلَيها",
      "ajuz": "سَوادِيُّ الرَّضيحِ مَعَ اللَّجينِ"
    },
    {
      "n": 22,
      "sadr": "إِذا قَلِقَت أَشُدُّ لَها سِنافاً",
      "ajuz": "أَمامَ الزَّورِ مِن قَلَقِ الوَضينِ"
    },
    {
      "n": 23,
      "sadr": "كَأَنَّ مَواقِعَ الثَّفِناتِ مِنها",
      "ajuz": "مُعَرَّسُ باكِراتِ الوِردِ جونِ"
    },
    {
      "n": 24,
      "sadr": "يَجُذُّ تَنَفُّسُ الصُّعَداءِ مِنها",
      "ajuz": "قُوى النِّسعِ المُحَرَّمِ ذي المُتونِ"
    },
    {
      "n": 25,
      "sadr": "تَصُكُّ الحالِبَينِ بِمُشفَتِرٍّ",
      "ajuz": "لَهُ صَوتٌ أَبَحُّ مِنَ الرَّنينِ"
    },
    {
      "n": 26,
      "sadr": "كَأَنَّ نَفِيَّ ما تَنفي يَداها",
      "ajuz": "قِذافُ غَريبَةٍ بِيَدَي مُعينِ"
    },
    {
      "n": 27,
      "sadr": "تَسُدُّ بِدائِمِ الخَطَرانِ جَثلٍ",
      "ajuz": "خَوايَةَ فَرجِ مِقلاتٍ دَهينِ"
    },
    {
      "n": 28,
      "sadr": "وَتَسمَعُ لِلذُّبابِ إِذا تَغَنّى",
      "ajuz": "كَتَغريدِ الحَمامِ عَلى الوُكونِ"
    },
    {
      "n": 29,
      "sadr": "فَأَلقَيتُ الزِّمامَ لَها فَنامَت",
      "ajuz": "لِعادَتِها مِنَ السَّدَفِ المُبينِ"
    },
    {
      "n": 30,
      "sadr": "كَأَنَّ مُناخَها مُلقى لِجامٍ",
      "ajuz": "عَلى مَعزائِها وَعَلى الوَجينِ"
    },
    {
      "n": 31,
      "sadr": "كَأَنَّ الكورَ وَالأَنساعَ مِنها",
      "ajuz": "عَلى قَرواءَ ماهِرَةٍ دَهينِ"
    },
    {
      "n": 32,
      "sadr": "يَشُقُّ الماءَ جُؤجُؤُها وَيَعلو",
      "ajuz": "غَوارِبَ كُلِّ ذي حَدَبٍ بَطينِ"
    },
    {
      "n": 33,
      "sadr": "غَدَت قَوداءَ مُنشَقّاً نَساها",
      "ajuz": "تَجاسَرُ بِالنُّخاعِ وَبِالوَتينِ"
    },
    {
      "n": 34,
      "sadr": "إِذا ما قُمتُ أَرحَلُها بِلَيلٍ",
      "ajuz": "تَأَوَّهُ آهَةَ الرَّجُلِ الحَزينِ"
    },
    {
      "n": 35,
      "sadr": "تَقولُ إِذا دَرَأتُ لَها وَضيني",
      "ajuz": "أَهَذا دينُهُ أَبَداً وَديني"
    },
    {
      "n": 36,
      "sadr": "أَكُلَّ الدَّهرِ حَلٌّ وَاِرتِحالٌ",
      "ajuz": "أَما يُبقي عَلَيَّ وَما يَقيني"
    },
    {
      "n": 37,
      "sadr": "فَأَبقى باطِلي وَالجِدُّ مِنها",
      "ajuz": "كَدُكّانِ الدَّرابِنَةِ المَطينِ"
    },
    {
      "n": 38,
      "sadr": "ثَنَيتُ زِمامَها وَوَضَعتُ رَحلي",
      "ajuz": "وَنُمرُقَةً رَفَدتُ بِها يَميني"
    },
    {
      "n": 39,
      "sadr": "فَرُحتُ بِها تُعارِضُ مُسبَطِرّاً",
      "ajuz": "عَلى صَحصاحِهِ وَعَلى المُتونِ"
    },
    {
      "n": 40,
      "sadr": "إِلى عَمرٍو وَمِن عَمرٍو أَتَتني",
      "ajuz": "أَخي النَّجَداتِ وَالحِلمِ الرَّصينِ"
    },
    {
      "n": 41,
      "sadr": "فَإِمّا أَن تَكونَ أَخي بِحَقٍّ",
      "ajuz": "فَأَعرِفَ مِنكَ غَثّي أَو سَميني"
    },
    {
      "n": 42,
      "sadr": "وَإِلّا فَاِطَّرِحني وَاِتَّخِذني",
      "ajuz": "عَدُوّاً أَتَّقيكَ وَتَتَّقيني"
    },
    {
      "n": 43,
      "sadr": "وَما أَدري إِذا يَمَّمتُ أَمراً",
      "ajuz": "أُريدُ الخَيرَ أَيُّهُما يَليني"
    },
    {
      "n": 44,
      "sadr": "أَأَلخَيرُ الَّذي أَنا أَبتَغيهِ",
      "ajuz": "أَمِ الشَّرُّ الَّذي هُوَ يَبتَغيني"
    }
  ]
}
