{
  "id": "hal-tadhkuruna-ghariban",
  "poet": "ibn-zaydun",
  "title": "هَل تَذكُرونَ غَريباً عادَهُ شَجَنُ",
  "meter": "basit",
  "rawiy": "ن",
  "abyat_in_full": 10,
  "added": "2026-11-18",
  "abyat": [
    { "n": 1,  "sadr": "هَل تَذكُرونَ غَريباً عادَهُ شَجَنُ", "ajuz": "مِن ذِكرِكُم وَجَفا أَجفانَهُ الوَسَنُ" },
    { "n": 2,  "sadr": "يُخفي لَواعِجَهُ وَالشَّوقُ يَفضَحُهُ", "ajuz": "فَقَد تَساوى لَدَيهِ السِّرُّ وَالعَلَنُ" },
    { "n": 3,  "sadr": "يا وَيلَتاهُ أَيَبقى في جَوانِحِهِ", "ajuz": "فُؤادُهُ وَهوَ بِالأَطلالِ مُرتَهَنُ" },
    { "n": 4,  "sadr": "وَأَرَّقَ العَينَ وَالظَّلماءُ عاكِفَةٌ", "ajuz": "وَرقاءُ قَد شَفَّها إِذ شَفَّني حَزَنُ" },
    { "n": 5,  "sadr": "فَبِتُّ أَشكو وَتَشكو فَوقَ أَيكَتِها", "ajuz": "وَباتَ يَهفو اِرتِياحاً بَينَنا الغُصُنُ" },
    { "n": 6,  "sadr": "يا هَل أُجالِسُ أَقواماً أُحِبُّهُمُ", "ajuz": "كُنّا وَكانوا عَلى عَهدٍ فَقَد ظَعَنوا" },
    { "n": 7,  "sadr": "أَو تَحفَظونَ عُهوداً لا أُضَيِّعُها", "ajuz": "إِنَّ الكِرامَ بِحِفظِ العَهدِ تُمتَحَنُ" },
    { "n": 8,  "sadr": "إِن كانَ عادَكُمُ عيدٌ فَرُبَّ فَتىً", "ajuz": "بِالشَّوقِ قَد عادَهُ مِن ذِكرِكُم حَزَنُ" },
    { "n": 9,  "sadr": "وَأَفرَدَتهُ اللَّيالي مِن أَحِبَّتِهِ", "ajuz": "فَباتَ يُنشِدُها مِمّا جَنى الزَّمَنُ" },
    { "n": 10, "sadr": "بِمَ التَّعَلُّلُ لا أَهلٌ وَلا وَطَنُ", "ajuz": "وَلا نَديمٌ وَلا كَأسٌ وَلا سَكَنُ" }
  ]
}
