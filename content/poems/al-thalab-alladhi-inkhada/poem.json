{
  "id": "al-thalab-alladhi-inkhada",
  "poet": "ahmad-shawqi",
  "title": "الثَّعلَبُ الَّذي اِنخَدَعَ",
  "meter": "sari",
  "themes": ["fables"],
  "rawiy": "ب",
  "abyat_in_full": 8,
  "added": "2026-11-24",
  "abyat": [
    {"n": 1, "sadr": "قَد سَمِعَ الثَّعلَبُ أَهلَ القُرى", "ajuz": "يَدعونَ مُحتالاً بِيا ثَعلَبُ"},
    {"n": 2, "sadr": "فَقالَ حَقّاً هَذِهِ غايَةٌ", "ajuz": "في الفَخرِ لا تُؤتى وَلا تُطلَبُ"},
    {"n": 3, "sadr": "مَن في النُّهى مِثلي حَتّى الوَرى", "ajuz": "أَصبَحتُ فيهِم مَثَلاً يُضرَبُ"},
    {"n": 4, "sadr": "ما ضَرَّ لَو وافَيتُهُم زائِراً", "ajuz": "أُريهِمُ فَوقَ الَّذي اِستَغرَبوا"},
    {"n": 5, "sadr": "لَعَلَّهُم يُحيونَ لي زينَةً", "ajuz": "يَحضُرُها الدّيكُ أَوِ الأَرنَبُ"},
    {"n": 6, "sadr": "وَقَصَدَ القَومَ وَحَيّاهُمُ", "ajuz": "وَقامَ فيما بَينَهُم يَخطُبُ"},
    {"n": 7, "sadr": "فَأُخِذَ الزّائِرُ مِن أُذنِهِ", "ajuz": "وَأُعطِيَ الكَلبَ بِهِ يَلعَبُ"},
    {"n": 8, "sadr": "فَلا تَثِق يَوماً بِذي حيلَةٍ", "ajuz": "إِذ رُبَّما يَنخَدِعُ الثَّعلَبُ"}
  ]
}
