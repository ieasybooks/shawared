{
  "id": "kullu-hayyin-laqi-al-himami",
  "poet": "ibn-munadhir",
  "title": "كُلُّ حَيٍّ لاقي الحِمامِ فَمودي",
  "meter": "khafif",
  "rawiy": "د",
  "abyat_in_full": 47,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "كُلُّ حَيٍّ لاقي الحِمامِ فَمودي",
      "ajuz": "ما لِحَيٍّ مُؤَمِّلٍ مِن خُلودِ"
    },
    {
      "n": 2,
      "sadr": "لا تَهابُ المَنونُ شَيئاً وَلا تَر",
      "ajuz": "عى عَلى والِدٍ وَلا مَولودِ"
    },
    {
      "n": 3,
      "sadr": "يَقدَحُ الدَّهرُ في شَماريخِ رَضوى",
      "ajuz": "وَيَحُطُّ الصُّخورَ مِن هَبّودِ"
    },
    {
      "n": 4,
      "sadr": "وَلَقَد تَترُكُ الحَوادِثُ وَالأَي",
      "ajuz": "يامُ وَهياً في الصَّخرَةِ الصَّيخودِ"
    },
    {
      "n": 5,
      "sadr": "يَفعَلُ اللَّهُ ما يَشاءُ فَيَمضي",
      "ajuz": "ما لِفِعلِ الإِلَهِ مِن مَردودِ"
    },
    {
      "n": 6,
      "sadr": "وَأَرانا كَالزَّرعِ يَحصُدُهُ الدَّه",
      "ajuz": "رُ فَمِن بَينِ قائِمٍ وَحَصيدِ"
    },
    {
      "n": 7,
      "sadr": "وَكَأَنّا لِلمَوتِ رَكبٌ مُخِبّو",
      "ajuz": "نَ سِراعاً لِمَنهَلٍ مَورودِ"
    },
    {
      "n": 8,
      "sadr": "أَينَ رَبُّ الحِصنِ الحَصينِ بِسورا",
      "ajuz": "ءَ وَرَبُّ القَصرِ المُنيفِ المَشيدِ"
    },
    {
      "n": 9,
      "sadr": "شادَ أَركانَهُ وَبَوَّبَهُ با",
      "ajuz": "بَي حَديدٍ وَحَفَّهُ بِجُنودِ"
    },
    {
      "n": 10,
      "sadr": "كانَ يُجبى إِلَيهِ ما بَينَ صَنعا",
      "ajuz": "ءَ فَمِصرٍ إِلى قُرى بَيرودِ"
    },
    {
      "n": 11,
      "sadr": "وَتَرى خَلفَهُ زَرافاتِ خَيلٍ",
      "ajuz": "جافِلاتٍ تَعدو بِمِثلِ الأُسودِ"
    },
    {
      "n": 12,
      "sadr": "فَرَمى شَخصَهُ فَأَقصَدَهُ الدَّه",
      "ajuz": "رُ بِسَهمٍ مِنَ المَنايا سَديدِ"
    },
    {
      "n": 13,
      "sadr": "ثُمَّ لَم يُنجِهِ مِنَ المَوتِ حِصنٌ",
      "ajuz": "دونَهُ خَندَقٌ وَبابا حَديدِ"
    },
    {
      "n": 14,
      "sadr": "وَمُلوكٌ مِن قَبلِهِ عَمَروا الأَر",
      "ajuz": "ضَ أُعينوا بِالنَّصرِ وَالتَّأييدِ"
    },
    {
      "n": 15,
      "sadr": "وَعَزيزٌ بِالتّاجِ مُعتَصِبٌ أَش",
      "ajuz": "وَسُ يَحمي الذِّمارَ جَمُّ العَديدِ"
    },
    {
      "n": 16,
      "sadr": "فَلَو أَنَّ الأَيّامَ أَخلَدنَ حَيّاً",
      "ajuz": "لِعَلاءٍ أَخلَدنَ عَبدَ المَجيدِ"
    },
    {
      "n": 17,
      "sadr": "إِنَّ عَبدَ المَجيدِ يَومَ تَوَلّى",
      "ajuz": "هَدَّ رُكناً ما كانَ بِالمَهدودِ"
    },
    {
      "n": 18,
      "sadr": "ما دَرى نَعشُهُ وَلا حامِلوهُ",
      "ajuz": "ما عَلى النَّعشِ مِن عَفافٍ وَجودِ"
    },
    {
      "n": 19,
      "sadr": "غَيَّبوا في الصَّعيدِ حَزماً وَعَزماً",
      "ajuz": "وَلِزازَ الخَصمِ الأَلَدِّ العَنيدِ"
    },
    {
      "n": 20,
      "sadr": "وَيحَ أَيدٍ حَثَت عَلَيهِ وَأَيدٍ",
      "ajuz": "دَفَنَتهُ ما غَيَّبَت في الصَّعيدِ"
    },
    {
      "n": 21,
      "sadr": "هَدَّ رُكني عَبدُ المَجيدِ وَقَد كُن",
      "ajuz": "تُ بِرُكنٍ أَبوءُ مِنهُ شَديدِ"
    },
    {
      "n": 22,
      "sadr": "كادَتِ النَّفسُ أَن تَفيضَ عَلَيهِ",
      "ajuz": "إِذ غَدا حَشوَ رَبطَةٍ وَبُرودِ"
    },
    {
      "n": 23,
      "sadr": "فَبِعَبدِ المَجيدِ تَأمورُ نَفسي",
      "ajuz": "عَثَرَت بي بَعدَ اِنتِعاشٍ جُدودي"
    },
    {
      "n": 24,
      "sadr": "وَبِعَبدِ المَجيدِ شُلَّت يَدِيَ اليُم",
      "ajuz": "نى وَشُلَّت بِهِ يَمينُ الجودِ"
    },
    {
      "n": 25,
      "sadr": "وَسَقاهُ ماءُ الشَّبيبَةِ فَاهتَز",
      "ajuz": "زَ اِهتِزازَ الغُصنِ النَّدِيِّ الأُملودِ"
    },
    {
      "n": 26,
      "sadr": "وَسَمَت نَحوَهُ العُيونُ وَما كا",
      "ajuz": "نَ عَلَيهِ لِزائِدٍ مِن مَزيدِ"
    },
    {
      "n": 27,
      "sadr": "فَإِذا ما ذَكَرتُهُ عَرَضَت لي",
      "ajuz": "غُصَّةٌ في اللَّها وَحَبلِ الوَريدِ"
    },
    {
      "n": 28,
      "sadr": "وَكَأَنّي أَدعوهُ وَهوَ قَريبٌ",
      "ajuz": "حينَ أَدعوهُ مِن مَكانٍ بَعيدِ"
    },
    {
      "n": 29,
      "sadr": "فَلَئِن صارَ لا يُجيبُ لَقَد كا",
      "ajuz": "نَ سَميعاً هَشّاً إِذا هُوَ نودي"
    },
    {
      "n": 30,
      "sadr": "كانَ لي عِصمَةً فَأَودى بِهِ الدَّه",
      "ajuz": "رُ فَيا حَسرَةَ الفَريدِ الوَحيدِ"
    },
    {
      "n": 31,
      "sadr": "يا فَتىً كانَ لِلمَقاماتِ زَيناً",
      "ajuz": "لا أَراهُ في المَحفِلِ المَشهودِ"
    },
    {
      "n": 32,
      "sadr": "خُنتُكَ الوُدَّ لَم أَمُت كَمَداً بَع",
      "ajuz": "دَكَ إِنّي عَلَيكَ حَقُّ جَليدِ"
    },
    {
      "n": 33,
      "sadr": "غَيرَ أَنّي أَبكيكَ ما حَنَّتِ النّي",
      "ajuz": "بُ وَحُثَّت عَيرانَةٌ بِقُيودِ"
    },
    {
      "n": 34,
      "sadr": "لَو فَدى الحَيُّ مَيِّتاً لَفَدَت نَف",
      "ajuz": "سَكَ نَفسي بِطارِفي وَتَليدي"
    },
    {
      "n": 35,
      "sadr": "فَبِرَغمي كُنتَ المُقَدَّمَ قَبلي",
      "ajuz": "وَبِكُرهي دُلّيتَ في مَلحودِ"
    },
    {
      "n": 36,
      "sadr": "كُنتَ لي عِصمَةً وَكُنتَ سَماءً",
      "ajuz": "بِكَ تَحيا أَرضي وَيَخضَرُّ عودي"
    },
    {
      "n": 37,
      "sadr": "تُبلِسُ الكاشِحَ العَدُوَّ عَلى الضِّغ",
      "ajuz": "نِ وَتَجزي بِضِعفِ وُدِّ الوَدودِ"
    },
    {
      "n": 38,
      "sadr": "عادَ عَبدُ المَجيدِ رُزءاً وَقَد كا",
      "ajuz": "نَ رَجاءً لِرَيبِ دَهرٍ كَنودِ"
    },
    {
      "n": 39,
      "sadr": "حينَ تَمَّت آدابُهُ وَتَرَدّى",
      "ajuz": "بِرِداءٍ مِنَ الشَّبابِ جَديدِ"
    },
    {
      "n": 40,
      "sadr": "لَهفَ نَفسي أَما أَراكَ وَما عِن",
      "ajuz": "دَكَ لي إِن دَعَوتُ مِن مَردودِ"
    },
    {
      "n": 41,
      "sadr": "وَلَئِن كُنتُ لَم أَمُت مِن جَوى الحُز",
      "ajuz": "نِ عَلَيهِ لَأَبلُغَنَّ مَجهودي"
    },
    {
      "n": 42,
      "sadr": "لَأُقيمَنَّ مَأتَماً كَنُجومِ اللَّي",
      "ajuz": "لِ زُهراً يَلطِمنَ حُرَّ الخُدودِ"
    },
    {
      "n": 43,
      "sadr": "موجَعاتٍ يَبكينَ لِلكَبِدِ الحَر",
      "ajuz": "رى عَلَيهِ وَلِلفُؤادِ العَميدِ"
    },
    {
      "n": 44,
      "sadr": "وَلِعَينٍ مَطروفَةٍ أَبَداً قا",
      "ajuz": "لَ لَها الدَّهرُ لا تَقَرّي وَجودي"
    },
    {
      "n": 45,
      "sadr": "كُلَّما عَزَّكِ البُكاءُ فَأَنفَد",
      "ajuz": "تِ لِعَبدِ المَجيدِ سَجلاً فَعودي"
    },
    {
      "n": 46,
      "sadr": "لِفَتىً يَحسُنُ البُكاءُ عَلَيهِ",
      "ajuz": "وَفَتىً كانَ لِامتِداحِ القَصيدِ"
    }
  ]
}
