{
  "id": "taiyyat-al-ilbiri",
  "poet": "abu-ishaq-al-ilbiri",
  "title": "تائِيَّةُ الإِلبيرِيِّ",
  "meter": "wafir",
  "rawiy": "ت",
  "abyat_in_full": 115,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,   "sadr": "تَفُتُّ فُؤادَكَ الأَيّامُ فَتّا",        "ajuz": "وَتَنحِتُ جِسمَكَ السّاعاتُ نَحتا" },
    { "n": 2,   "sadr": "وَتَدعوكَ المَنونُ دُعاءَ صِدقٍ",       "ajuz": "أَلا يا صاحِ أَنتَ أُريدُ أَنتا" },
    { "n": 3,   "sadr": "أَراكَ تُحِبُّ عِرساً ذاتَ غَدرٍ",       "ajuz": "أَبَتَّ طَلاقَها الأَكياسُ بَتّا" },
    { "n": 4,   "sadr": "تَنامُ الدَّهرَ وَيحَكَ في غَطيطٍ",     "ajuz": "بِها حَتّى إِذا مِتَّ اِنتَبَهتا" },
    { "n": 5,   "sadr": "فَكَم ذا أَنتَ مَخدوعٌ وَحَتّى",       "ajuz": "مَتى لا تَرعَوي عَنها وَحَتّى" },
    { "n": 6,   "sadr": "أَبا بَكرٍ دَعَوتُكَ لَو أَجَبتا",     "ajuz": "إِلى ما فيهِ حَظُّكَ إِن عَقَلتا" },
    { "n": 7,   "sadr": "إِلى عِلمٍ تَكونُ بِهِ إِماماً",         "ajuz": "مُطاعاً إِن نَهَيتَ وَإِن أَمَرتا" },
    { "n": 8,   "sadr": "وَيَجلو ما بِعَينِكَ مِن غَشاها",     "ajuz": "وَيَهديكَ السَّبيلَ إِذا ضَلَلتا" },
    { "n": 9,   "sadr": "وَتَحمِلُ مِنهُ في ناديكَ تاجاً",      "ajuz": "وَيَكسوكَ الجَمالَ إِذا اِغتَرَبتا" },
    { "n": 10,  "sadr": "يَنالُكَ نَفعُهُ ما دُمتَ حَيّاً",       "ajuz": "وَيَبقى ذُخرُهُ لَكَ إِن ذَهَبتا" },
    { "n": 11,  "sadr": "هُوَ العَضبُ المُهَنَّدُ لَيسَ يَنبو",   "ajuz": "تُصيبُ بِهِ مَقاتِلَ مَن ضَرَبتا" },
    { "n": 12,  "sadr": "وَكَنزٌ لا تَخافُ عَلَيهِ لِصّاً",       "ajuz": "خَفيفُ الحَملِ يوجَدُ حَيثُ كُنتا" },
    { "n": 13,  "sadr": "يَزيدُ بِكَثرَةِ الإِنفاقِ مِنهُ",      "ajuz": "وَيَنقُصُ إِن بِهِ كَفّاً شَدَدتا" },
    { "n": 14,  "sadr": "فَلَو قَد ذُقتَ مِن حَلواهُ طَعماً",  "ajuz": "لَآثَرتَ التَّعَلُّمَ وَاجتَهَدتا" },
    { "n": 15,  "sadr": "وَلَم يَشغَلكَ عَنهُ هَوىً مُطاعٌ",     "ajuz": "وَلا دُنيا بِزُخرُفِها فُتِنتا" },
    { "n": 16,  "sadr": "وَلا أَلهاكَ عَنهُ أَنيقُ رَوضٍ",      "ajuz": "وَلا خِدرٌ بِرَبرَبِهِ كَلِفتا" },
    { "n": 17,  "sadr": "فَقوتُ الرّوحِ أَرواحُ المَعاني",      "ajuz": "وَلَيسَ بِأَن طَعِمتَ وَأَن شَرِبتا" },
    { "n": 18,  "sadr": "فَواظِبهُ وَخُذ بِالجِدِّ فيهِ",         "ajuz": "فَإِن أَعطاكَهُ اللَّهُ أَخَذتا" },
    { "n": 19,  "sadr": "وَإِن أوتيتَ فيهِ طولَ باعٍ",          "ajuz": "وَقالَ النّاسُ إِنَّكَ قَد سَبَقتا" },
    { "n": 20,  "sadr": "فَلا تَأمَن سُؤالَ اللَّهِ عَنهُ",      "ajuz": "بِتَوبيخٍ عَلِمتَ فَهَل عَمِلتا" },
    { "n": 21,  "sadr": "فَرَأسُ العِلمِ تَقوى اللَّهِ حَقّاً",   "ajuz": "وَلَيسَ بِأَن يُقالَ لَقَد رَأَستا" },
    { "n": 22,  "sadr": "وَضافي ثَوبِكَ الإِحسانُ لا أَن",     "ajuz": "تُرى ثَوبَ الإِساءَةِ قَد لَبِستا" },
    { "n": 23,  "sadr": "إِذا ما لَم يُفِدكَ العِلمُ خَيراً",   "ajuz": "فَخَيرٌ مِنهُ أَن لَو قَد جَهِلتا" },
    { "n": 24,  "sadr": "وَإِن أَلقاكَ فَهمُكَ في مَهاوٍ",      "ajuz": "فَلَيتَكَ ثُمَّ لَيتَكَ ما فَهِمتا" },
    { "n": 25,  "sadr": "سَتَجني مِن ثِمارِ العَجزِ جَهلاً",    "ajuz": "وَتَصغُرُ في العُيونِ وَإِن كَبِرتا" },
    { "n": 26,  "sadr": "وَتُفقَدُ إِن جَهِلتَ وَأَنتَ باقٍ",    "ajuz": "وَتوجَدُ إِن عَلِمتَ وَإِن فُقِدتا" },
    { "n": 27,  "sadr": "وَتَذكُرُ قَولَتي لَكَ بَعدَ حينٍ",     "ajuz": "وَتَغبِطُها إِذا عَنها شُغِلتا" },
    { "n": 28,  "sadr": "لَسَوفَ تَعَضُّ مِن نَدَمٍ عَلَيها",     "ajuz": "وَما تُغني النَّدامَةُ إِن نَدِمتا" },
    { "n": 29,  "sadr": "إِذا أَبصَرتَ صَحبَكَ في سَماءٍ",      "ajuz": "قَدِ اِرتَفَعوا عَلَيكَ وَقَد سَفُلتا" },
    { "n": 30,  "sadr": "وَلا تَحفِل بِمالِكَ وَالهُ عَنهُ",    "ajuz": "فَلَيسَ المالُ إِلّا ما عَلِمتا" },
    { "n": 31,  "sadr": "وَلَيسَ لِجاهِلٍ في النّاسِ مَعنىً",    "ajuz": "وَلَو مُلكُ العِراقِ لَهُ تَأَتّى" },
    { "n": 32,  "sadr": "سَيَنطِقُ عَنكَ عِلمُكَ في نَدِيٍّ",     "ajuz": "وَيُكتَبُ عَنكَ يَوماً إِن كَتَبتا" },
    { "n": 33,  "sadr": "وَما يُغنيكَ تَشييدُ المَباني",       "ajuz": "إِذا بِالجَهلِ نَفسَكَ قَد هَدَمتا" },
    { "n": 34,  "sadr": "جَعَلتَ المالَ فَوقَ العِلمِ جَهلاً",   "ajuz": "لَعَمرُكَ في القَضِيَّةِ ما عَدَلتا" },
    { "n": 35,  "sadr": "وَبَينَهُما بِنَصِّ الوَحيِ بَونٌ",      "ajuz": "سَتَعلَمُهُ إِذا طَهَ قَرَأتا" },
    { "n": 36,  "sadr": "لَئِن رَفَعَ الغَنِيُّ لِواءَ مالٍ",      "ajuz": "لَأَنتَ لِواءَ عِلمِكَ قَد رَفَعتا" },
    { "n": 37,  "sadr": "وَإِن جَلَسَ الغَنِيُّ عَلى الحَشايا",   "ajuz": "لَأَنتَ عَلى الكَواكِبِ قَد جَلَستا" },
    { "n": 38,  "sadr": "وَإِن رَكِبَ الجِيادَ مُسَوَّماتٍ",       "ajuz": "لَأَنتَ مَناهِجَ التَّقوى رَكِبتا" },
    { "n": 39,  "sadr": "وَمَهما اِفتَضَّ أَبكارَ الغَواني",    "ajuz": "فَكَم بِكرٍ مِنَ الحِكَمِ اِفتَضَضتا" },
    { "n": 40,  "sadr": "وَلَيسَ يَضُرُّكَ الإِقتارُ شَيئاً",     "ajuz": "إِذا ما أَنتَ رَبَّكَ قَد عَرَفتا" },
    { "n": 41,  "sadr": "فَماذا عِندَهُ لَكَ مِن جَميلٍ",        "ajuz": "إِذا بِفِناءِ طاعَتِهِ أَنَختا" },
    { "n": 42,  "sadr": "فَقابِل بِالقَبولِ صَحيحَ نُصحي",      "ajuz": "فَإِن أَعرَضتَ عَنهُ فَقَد خَسِرتا" },
    { "n": 43,  "sadr": "وَإِن راعَيتَهُ قَولاً وَفِعلاً",       "ajuz": "وَتاجَرتَ الإِلَهَ بِهِ رَبِحتا" },
    { "n": 44,  "sadr": "فَلَيسَت هَذِهِ الدُّنيا بِشَيءٍ",      "ajuz": "تَسوؤُكَ حِقبَةً وَتَسُرُّ وَقتا" },
    { "n": 45,  "sadr": "وَغايَتُها إِذا فَكَّرتَ فيها",        "ajuz": "كَفَيئِكَ أَو كَحُلمِكَ إِن حَلَمتا" },
    { "n": 46,  "sadr": "سُجِنتَ بِها وَأَنتَ لَها مُحِبٌّ",      "ajuz": "فَكَيفَ تُحِبُّ ما فيهِ سُجِنتا" },
    { "n": 47,  "sadr": "وَتُطعِمُكَ الطَّعامَ وَعَن قَريبٍ",     "ajuz": "سَتَطعَمُ مِنكَ ما مِنها طَعِمتا" },
    { "n": 48,  "sadr": "وَتَعرى إِن لَبِستَ لَها ثِياباً",     "ajuz": "وَتُكسى إِن مَلابِسَها خَلَعتا" },
    { "n": 49,  "sadr": "وَتَشهَدُ كُلَّ يَومٍ دَفنَ خِلٍّ",       "ajuz": "كَأَنَّكَ لا تُرادُ بِما شَهِدتا" },
    { "n": 50,  "sadr": "وَلَم تُخلَق لِتَعمُرَها وَلَكِن",     "ajuz": "لِتَعبُرَها فَجِدَّ لِما خُلِقتا" },
    { "n": 51,  "sadr": "وَإِن هُدِمَت فَزِدها أَنتَ هَدماً",   "ajuz": "وَحَصِّن أَمرَ دينِكَ ما اِستَطَعتا" },
    { "n": 52,  "sadr": "وَلا تَحزَن عَلى ما فاتَ مِنها",     "ajuz": "إِذا ما أَنتَ في أُخراكَ فُزتا" },
    { "n": 53,  "sadr": "فَلَيسَ بِنافِعٍ ما نِلتَ مِنها",      "ajuz": "مِنَ الفاني إِذا الباقي حُرِمتا" },
    { "n": 54,  "sadr": "وَلا تَضحَك مَعَ السُّفَهاءِ لَهواً",   "ajuz": "فَإِنَّكَ سَوفَ تَبكي إِن ضَحِكتا" },
    { "n": 55,  "sadr": "وَكَيفَ لَكَ السُّرورُ وَأَنتَ رَهنٌ",   "ajuz": "وَلا تَدري أَتُفدى أَم غَلِقتا" },
    { "n": 56,  "sadr": "وَسَل مِن رَبِّكَ التَّوفيقَ فيها",    "ajuz": "وَأَخلِص في السُّؤالِ إِذا سَأَلتا" },
    { "n": 57,  "sadr": "وَنادِ إِذا سَجَدتَ لَهُ اِعتِرافاً",    "ajuz": "بِما ناداهُ ذو النّونِ اِبنُ مَتّى" },
    { "n": 58,  "sadr": "وَلازِم بابَهُ قَرعاً عَساهُ",          "ajuz": "سَيَفتَحُ بابَهُ لَكَ إِن قَرَعتا" },
    { "n": 59,  "sadr": "وَأَكثِر ذِكرَهُ في الأَرضِ دَأباً",   "ajuz": "لِتُذكَرَ في السَّماءِ إِذا ذَكَرتا" },
    { "n": 60,  "sadr": "وَلا تَقُلِ الصِّبا فيهِ مَجالٌ",        "ajuz": "وَفَكِّر كَم صَغيرٍ قَد دَفَنتا" },
    { "n": 61,  "sadr": "وَقُل لي يا نَصيحُ لَأَنتَ أَولى",    "ajuz": "بِنُصحِكَ لَو بِعَقلِكَ قَد نَظَرتا" },
    { "n": 62,  "sadr": "تُقَطِّعُني عَلى التَّفريطِ لَوماً",    "ajuz": "وَبِالتَّفريطِ دَهرَكَ قَد قَطَعتا" },
    { "n": 63,  "sadr": "وَفي صِغَري تُخَوِّفُني المَنايا",      "ajuz": "وَما تَجري بِبالِكَ حينَ شِختا" },
    { "n": 64,  "sadr": "وَكُنتَ مَعَ الصِّبا أَهدى سَبيلاً",    "ajuz": "فَما لَكَ بَعدَ شَيبِكَ قَد نُكِستا" },
    { "n": 65,  "sadr": "وَها أَنا لَم أَخُض بَحرَ الخَطايا",  "ajuz": "كَما قَد خُضتَهُ حَتّى غَرِقتا" },
    { "n": 66,  "sadr": "وَلَم أَشرَب حُمَيّا أُمِّ دَفرٍ",      "ajuz": "وَأَنتَ شَرِبتَها حَتّى سَكِرتا" },
    { "n": 67,  "sadr": "وَلَم أَحلُل بِوادٍ فيهِ ظُلمٌ",       "ajuz": "وَأَنتَ حَلَلتَ فيهِ وَانهَمَلتا" },
    { "n": 68,  "sadr": "وَلَم أَنشَأ بِعَصرٍ فيهِ نَفعٌ",      "ajuz": "وَأَنتَ نَشَأتَ فيهِ وَما اِنتَفَعتا" },
    { "n": 69,  "sadr": "وَقَد صاحَبتَ أَعلاماً كِباراً",       "ajuz": "وَلَم أَرَكَ اِقتَدَيتَ بِمَن صَحِبتا" },
    { "n": 70,  "sadr": "وَناداكَ الكِتابُ فَلَم تُجِبهُ",       "ajuz": "وَنَهنَهَكَ المَشيبُ فَما اِنتَبَهتا" },
    { "n": 71,  "sadr": "لَيَقبُحُ بِالفَتى فِعلُ التَّصابي",    "ajuz": "وَأَقبَحُ مِنهُ شَيخٌ قَد تَفَتّى" },
    { "n": 72,  "sadr": "فَأَنتَ أَحَقُّ بِالتَّفنيدِ مِنّي",     "ajuz": "وَلَو سَكَتَ المُسيءُ لَما نَطَقتا" },
    { "n": 73,  "sadr": "وَنَفسَكَ ذُمَّ لا تَذمُم سِواها",     "ajuz": "بِعَيبٍ فَهيَ أَجدَرُ مَن ذَمَمتا" },
    { "n": 74,  "sadr": "فَلَو بَكَتِ الدِّما عَيناكَ خَوفاً",   "ajuz": "لِذَنبِكَ لَم أَقُل لَكَ قَد أَمِنتا" },
    { "n": 75,  "sadr": "وَمَن لَكَ بِالأَمانِ وَأَنتَ عَبدٌ",    "ajuz": "أُمِرتَ فَما اِئتَمَرتَ وَلا أَطَعتا" },
    { "n": 76,  "sadr": "ثَقُلتَ مِنَ الذُّنوبِ وَلَستَ تَخشى",  "ajuz": "لِجَهلِكَ أَن تَخِفَّ إِذا وُزِنتا" },
    { "n": 77,  "sadr": "وَتُشفِقُ لِلمُصِرِّ عَلى المَعاصي",    "ajuz": "وَتَرحَمُهُ وَنَفسَكَ ما رَحِمتا" },
    { "n": 78,  "sadr": "رَجَعتَ القَهقَرى وَخَبَطتَ عَشوا",    "ajuz": "لَعَمرُكَ لَو وَصَلتَ لَما رَجَعتا" },
    { "n": 79,  "sadr": "وَلَو وافَيتَ رَبَّكَ دونَ ذَنبٍ",      "ajuz": "وَناقَشَكَ الحِسابَ إِذاً هَلَكتا" },
    { "n": 80,  "sadr": "وَلَم يَظلِمكَ في عَمَلٍ وَلَكِن",      "ajuz": "عَسيرٌ أَن تَقومَ بِما حَمَلتا" },
    { "n": 81,  "sadr": "وَلَو قَد جِئتَ يَومَ الفَصلِ فَرداً", "ajuz": "وَأَبصَرتَ المَنازِلَ فيهِ شَتّى" },
    { "n": 82,  "sadr": "لَأَعظَمتَ النَّدامَةَ فيهِ لَهفاً",    "ajuz": "عَلى ما في حَياتِكَ قَد أَضَعتا" },
    { "n": 83,  "sadr": "تَفِرُّ مِنَ الهَجيرِ وَتَتَّقيهِ",        "ajuz": "فَهَلّا عَن جَهَنَّمَ قَد فَرَرتا" },
    { "n": 84,  "sadr": "وَلَستَ تُطيقُ أَهوَنَها عَذاباً",      "ajuz": "وَلَو كُنتَ الحَديدَ بِها لَذُبتا" },
    { "n": 85,  "sadr": "فَلا تُكذَب فَإِنَّ الأَمرَ جِدٌّ",      "ajuz": "وَلَيسَ كَما اِحتَسَبتَ وَلا ظَنَنتا" },
    { "n": 86,  "sadr": "أَبا بَكرٍ كَشَفتَ أَقَلَّ عَيبي",      "ajuz": "وَأَكثَرَهُ وَمُعظَمَهُ سَتَرتا" },
    { "n": 87,  "sadr": "فَقُل ما شِئتَ فِيَّ مِنَ المَخازي",    "ajuz": "وَضاعِفها فَإِنَّكَ قَد صَدَقتا" },
    { "n": 88,  "sadr": "وَمَهما عِبتَني فَلِفَرطِ عِلمي",     "ajuz": "بِباطِنَتي كَأَنَّكَ قَد مَدَحتا" },
    { "n": 89,  "sadr": "فَلا تَرضَ المَعايِبَ فَهيَ عارٌ",      "ajuz": "عَظيمٌ يورِثُ الإِنسانَ مَقتا" },
    { "n": 90,  "sadr": "وَتَهوي بِالوَجيهِ مِنَ الثُّرَيّا",     "ajuz": "وَتُبدِلُهُ مَكانَ الفَوقِ تَحتا" },
    { "n": 91,  "sadr": "كَما الطّاعاتُ تَنعَلُكَ الدَّراري",   "ajuz": "وَتَجعَلُكَ القَريبَ وَإِن بَعُدتا" },
