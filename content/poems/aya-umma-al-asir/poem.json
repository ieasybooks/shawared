{
  "id": "aya-umma-al-asir",
  "poet": "abu-firas-al-hamdani",
  "title": "أَيا أُمَّ الأَسيرِ سَقاكِ غَيثٌ",
  "meter": "wafir",
  "themes": ["ritha"],
  "rawiy": "ر",
  "abyat_in_full": 19,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَيا أُمَّ الأَسيرِ سَقاكِ غَيثٌ",
      "ajuz": "بِكُرهٍ مِنكِ ما لَقِيَ الأَسيرُ"
    },
    {
      "n": 2,
      "sadr": "أَيا أُمَّ الأَسيرِ سَقاكِ غَيثٌ",
      "ajuz": "تَحَيَّرَ لا يُقيمُ وَلا يَسيرُ"
    },
    {
      "n": 3,
      "sadr": "أَيا أُمَّ الأَسيرِ سَقاكِ غَيثٌ",
      "ajuz": "إِلى مَن بِالفِدا يَأتي البَشيرُ"
    },
    {
      "n": 4,
      "sadr": "أَيا أُمَّ الأَسيرِ لِمَن تُرَبّى",
      "ajuz": "وَقَد مُتِّ الذَّوائِبُ وَالشُّعورُ"
    },
    {
      "n": 5,
      "sadr": "إِذا اِبنُكِ سارَ في بَرٍّ وَبَحرٍ",
      "ajuz": "فَمَن يَدعو لَهُ أَو يَستَجيرُ"
    },
    {
      "n": 6,
      "sadr": "حَرامٌ أَن يَبيتَ قَريرَ عَينٍ",
      "ajuz": "وَلُؤمٌ أَن يُلِمَّ بِهِ السُّرورُ"
    },
    {
      "n": 7,
      "sadr": "وَقَد ذُقتِ الرَّزايا وَالمَنايا",
      "ajuz": "وَلا وَلَدٌ لَدَيكِ وَلا عَشيرُ"
    },
    {
      "n": 8,
      "sadr": "وَغابَ حَبيبُ قَلبِكِ عَن مَكانٍ",
      "ajuz": "مَلائِكَةُ السَّماءِ بِهِ حُضورُ"
    },
    {
      "n": 9,
      "sadr": "لِيَبكِكِ كُلُّ يَومٍ صُمتِ فيهِ",
      "ajuz": "مُصابَرَةً وَقَد حَمِيَ الهَجيرُ"
    },
    {
      "n": 10,
      "sadr": "لِيَبكِكِ كُلُّ لَيلٍ قُمتِ فيهِ",
      "ajuz": "إِلى أَن يَبتَدي الفَجرُ المُنيرُ"
    },
    {
      "n": 11,
      "sadr": "لِيَبكِكِ كُلُّ مُضطَهَدٍ مَخوفٍ",
      "ajuz": "أَجَرتيهِ وَقَد عَزَّ المُجيرُ"
    },
    {
      "n": 12,
      "sadr": "لِيَبكِكِ كُلُّ مِسكينٍ فَقيرٍ",
      "ajuz": "أَغَثتيهِ وَما في العَظمِ ريرُ"
    },
    {
      "n": 13,
      "sadr": "أَيا أُمّاهُ كَم هَمٍّ طَويلٍ",
      "ajuz": "مَضى بِكِ لَم يَكُن مِنهُ نَصيرُ"
    },
    {
      "n": 14,
      "sadr": "أَيا أُمّاهُ كَم سِرٍّ مَصونٍ",
      "ajuz": "بِقَلبِكِ ماتَ لَيسَ لَهُ ظُهورُ"
    },
    {
      "n": 15,
      "sadr": "أَيا أُمّاهُ كَم بُشرى بِقُربي",
      "ajuz": "أَتَتكِ وَدونَها الأَجَلُ القَصيرُ"
    },
    {
      "n": 16,
      "sadr": "إِلى مَن أَشتَكي وَلِمَن أُناجي",
      "ajuz": "إِذا ضاقَت بِما فيها الصُّدورُ"
    },
    {
      "n": 17,
      "sadr": "بِأَيِّ دُعاءِ داعِيَةٍ أُوَقّى",
      "ajuz": "بِأَيِّ ضِياءِ وَجهٍ أَستَنيرُ"
    },
    {
      "n": 18,
      "sadr": "بِمَن يُستَدفَعُ القَدَرُ المُوَفّى",
      "ajuz": "بِمَن يُستَفتَحُ الأَمرُ العَسيرُ"
    },
    {
      "n": 19,
      "sadr": "نُسَلّى عَنكِ أَنّا عَن قَليلٍ",
      "ajuz": "إِلى ما صِرتِ في الأُخرى نَصيرُ"
    }
  ]
}
