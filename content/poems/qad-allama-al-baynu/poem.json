{
  "id": "qad-allama-al-baynu",
  "poet": "al-mutanabbi",
  "title": "قَد عَلَّمَ البَينُ مِنّا البَينَ أَجفانا",
  "meter": "basit",
  "rawiy": "ن",
  "abyat_in_full": 41,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "قَد عَلَّمَ البَينُ مِنّا البَينَ أَجفانا",
      "ajuz": "تَدمى وَأَلَّفَ في ذا القَلبِ أَحزانا"
    },
    {
      "n": 2,
      "sadr": "أَمَّلتُ ساعَةَ ساروا كَشفَ مِعصَمِها",
      "ajuz": "لِيَلبَثَ الحَيُّ دونَ السَّيرِ حَيرانا"
    },
    {
      "n": 3,
      "sadr": "وَلَو بَدَت لَأَتاهَتهُم فَحَجَّبَها",
      "ajuz": "صَونٌ عُقولَهُمُ مِن لَحظِها صانا"
    },
    {
      "n": 4,
      "sadr": "بِالواخِداتِ وَحاديها وَبي قَمَرٌ",
      "ajuz": "يَظَلُّ مِن وَخدِها في الخِدرِ حَشيانا"
    },
    {
      "n": 5,
      "sadr": "أَمّا الثِّيابُ فَتَعرى مِن مَحاسِنِهِ",
      "ajuz": "إِذا نَضاها وَيُكسى الحُسنَ عُريانا"
    },
    {
      "n": 6,
      "sadr": "يَضُمُّهُ المِسكُ ضَمَّ المُستَهامِ بِهِ",
      "ajuz": "حَتّى يَصيرَ عَلى الأَعكانِ أَعكانا"
    },
    {
      "n": 7,
      "sadr": "قَد كُنتُ أُشفِقُ مِن دَمعي عَلى بَصَري",
      "ajuz": "فَاليَومَ كُلُّ عَزيزٍ بَعدَكُم هانا"
    },
    {
      "n": 8,
      "sadr": "تُهدي البَوارِقُ أَخلافَ المِياهِ لَكُم",
      "ajuz": "وَلِلمُحِبِّ مِنَ التَّذكارِ نيرانا"
    },
    {
      "n": 9,
      "sadr": "إِذا قَدِمتُ عَلى الأَهوالِ شَيَّعَني",
      "ajuz": "قَلبٌ إِذا شِئتُ أَن يَسلاكُمُ خانا"
    },
    {
      "n": 10,
      "sadr": "أَبدو فَيَسجُدُ مَن بِالسّوءِ يَذكُرُني",
      "ajuz": "وَلا أُعاتِبُهُ صَفحاً وَإِهوانا"
    },
    {
      "n": 11,
      "sadr": "وَهَكَذا كُنتُ في أَهلي وَفي وَطَني",
      "ajuz": "إِنَّ النَّفيسَ غَريبٌ حَيثُما كانا"
    },
    {
      "n": 12,
      "sadr": "مُحَسَّدُ الفَضلِ مَكذوبٌ عَلى أَثَري",
      "ajuz": "أَلقى الكَمِيَّ وَيَلقاني إِذا حانا"
    },
    {
      "n": 13,
      "sadr": "لا أَشرَئِبُّ إِلى ما لَم يَفُت طَمَعاً",
      "ajuz": "وَلا أَبيتُ عَلى ما فاتَ حَسرانا"
    },
    {
      "n": 14,
      "sadr": "وَلا أُسَرُّ بِما غَيري الحَميدُ بِهِ",
      "ajuz": "وَلَو حَمَلتَ إِلَيَّ الدَّهرَ مَلآنا"
    }
  ]
}
