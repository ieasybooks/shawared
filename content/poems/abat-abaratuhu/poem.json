{
  "id": "abat-abaratuhu",
  "poet": "abu-firas-al-hamdani",
  "title": "أَبَت عَبَراتُهُ إِلّا اِنسِكابا",
  "meter": "wafir",
  "themes": ["hamasa", "fakhr", "madh"],
  "rawiy": "ب",
  "abyat_in_full": 55,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "أَبَت عَبَراتُهُ إِلّا اِنسِكابا",
      "ajuz": "وَنارُ ضُلوعِهِ إِلّا اِلتِهابا"
    },
    {
      "n": 2,
      "sadr": "وَمِن حَقِّ الطُّلولِ عَلَيَّ أَلّا",
      "ajuz": "أُغِبَّ مِنَ الدُّموعِ لَها سَحابا"
    },
    {
      "n": 3,
      "sadr": "وَما قَصَّرتُ عَن تَسآلِ رَبعٍ",
      "ajuz": "وَلَكِنّي سَأَلتُ فَما أَجابا"
    },
    {
      "n": 4,
      "sadr": "رَأَيتُ الشَّيبَ لاحَ فَقُلتُ أَهلاً",
      "ajuz": "وَوَدَّعتُ الغَوايَةَ وَالشَّبابا"
    },
    {
      "n": 5,
      "sadr": "وَما إِن شِبتُ مِن كِبَرٍ وَلَكِن",
      "ajuz": "رَأَيتُ مِنَ الأَحِبَّةِ ما أَشابا"
    },
    {
      "n": 6,
      "sadr": "بَعَثنَ مِنَ الصُّدودِ إِلَيَّ رَكباً",
      "ajuz": "وَصَيَّرنَ الهُمومَ لَهُ رِكابا"
    },
    {
      "n": 7,
      "sadr": "أَلَم تَرَنا أَعَزَّ النّاسِ جاراً",
      "ajuz": "وَأَمنَعَهُم وَأَمرَعَهُم جَنابا"
    },
    {
      "n": 8,
      "sadr": "لَنا الجَبَلُ المُطِلُّ عَلى نِزارٍ",
      "ajuz": "حَلَلنا النَّجدَ مِنهُ وَالهِضابا"
    },
    {
      "n": 9,
      "sadr": "تُفَضِّلُنا الأَنامُ وَلا نُحاشى",
      "ajuz": "وَنوصَفُ بِالجَميلِ وَلا نُحابى"
    },
    {
      "n": 10,
      "sadr": "وَقَد عَلِمَت رَبيعَةُ بَل مَعَدٌّ",
      "ajuz": "بِأَنّا الرَّأسُ وَالنّاسُ الذُّنابى"
    },
    {
      "n": 11,
      "sadr": "وَلَمّا أَن طَغَت سُفَهاءُ كَعبٍ",
      "ajuz": "فَتَحنا بَينَنا لِلحَربِ بابا"
    },
    {
      "n": 12,
      "sadr": "مَنَحناها الحَرائِبَ غَيرَ أَنّا",
      "ajuz": "إِذا جارَت مَنَحناها الحِرابا"
    },
    {
      "n": 13,
      "sadr": "وَلَمّا ثارَ سَيفُ الدّينِ ثُرنا",
      "ajuz": "كَما هَيَّجتَ آساداً غِضابا"
    },
    {
      "n": 14,
      "sadr": "أَسِنَّتُهُ إِذا لاقى طِعاناً",
      "ajuz": "صَوارِمُهُ إِذا لاقى ضِرابا"
    },
    {
      "n": 15,
      "sadr": "دَعانا وَالأَسِنَّةُ مُشرَعاتٌ",
      "ajuz": "فَكُنّا عِندَ دَعوَتِهِ الجَوابا"
    },
    {
      "n": 16,
      "sadr": "صَنائِعُ فاقَ صانِعُها فَفاقَت",
      "ajuz": "وَغَرسٌ طابَ غارِسُهُ فَطابا"
    },
    {
      "n": 17,
      "sadr": "وَكُنّا كَالسِّهامِ إِذا أَصابَت",
      "ajuz": "مَراميها فَراميها أَصابا"
    },
    {
      "n": 18,
      "sadr": "قَطَعنَ إِلى الجِباةِ بِنا مَعاناً",
      "ajuz": "وَنَكَّبنَ الصُّبَيرَةَ وَالقِبابا"
    },
    {
      "n": 19,
      "sadr": "وَجاوَزنَ البَدِيَّةَ صادِياتٍ",
      "ajuz": "يُلاحِظنَ السَّرابَ وَلا سَرابا"
    },
    {
      "n": 20,
      "sadr": "عَبَرنَ بِماسِجٍ وَاللَّيلُ طِفلٌ",
      "ajuz": "وَجِئنَ إِلى سَلَمِيَّةَ حينَ شابا"
    },
    {
      "n": 21,
      "sadr": "فَما شَعَروا بِها إِلّا ثَباتاً",
      "ajuz": "دُوَينَ الشَّدِّ تَصطَخِبُ اِصطِخابا"
    },
    {
      "n": 22,
      "sadr": "تَناهَبنَ الثَّناءَ بِصَبرِ يَومٍ",
      "ajuz": "بِهِ الأَرواحُ تُنتَهَبُ اِنتِهابا"
    },
    {
      "n": 23,
      "sadr": "تَنادَوا فَانبَرَت مِن كُلِّ فَجٍّ",
      "ajuz": "سَوابِقُ يُنتَجَبنَ لَهُ اِنتِجابا"
    },
    {
      "n": 24,
      "sadr": "وَقادَ نَدى اِبنُ جَعفَرٍ مِن عُقَيلٍ",
      "ajuz": "شُعوباً قَد أَسَلنَ بِهِ الشِّعابا"
    },
    {
      "n": 25,
      "sadr": "فَما كانوا لَنا إِلّا أُسارى",
      "ajuz": "وَما كانَت لَنا إِلّا نِهابا"
    },
    {
      "n": 26,
      "sadr": "كَأَنَّ نَدى اِبنَ جَعفَرٍ قادَ مِنهُم",
      "ajuz": "هَدايا لَم يَرُغ عَنها ثَوابا"
    },
    {
      "n": 27,
      "sadr": "وَشَدّوا رَأيَهُم بِبَني قُرَيعٍ",
      "ajuz": "فَخابوا لا أَبا لَهُمُ وَخابا"
    },
    {
      "n": 28,
      "sadr": "فَلَمّا اِشتَدَّتِ الهَيجاءُ كُنّا",
      "ajuz": "أَشَدَّ مَخالِباً وَأَحَدَّ نابا"
    },
    {
      "n": 29,
      "sadr": "وَأَمنَعَ جانِباً وَأَعَزَّ جاراً",
      "ajuz": "وَأَوفى ذِمَّةً وَأَقَلَّ عابا"
    },
    {
      "n": 30,
      "sadr": "سَقَينا بِالرِّماحِ بَني قُشَيرٍ",
      "ajuz": "بِبَطنِ العُثَيرِ السَّمَّ المُذابا"
    },
    {
      "n": 31,
      "sadr": "وَسُقناهُم إِلى الحَيرانِ سَوقاً",
      "ajuz": "كَما نَستاقُ آبالاً صِعابا"
    },
    {
      "n": 32,
      "sadr": "وَنَكَّبنا الفُرُقلُسَ لَم نَرِدهُ",
      "ajuz": "كَأَنَّ بِنا عَنِ الماءِ اِجتِنابا"
    },
    {
      "n": 33,
      "sadr": "وَمِلنَ عَنِ الغُوَيرِ وَسِرنَ حَتّى",
      "ajuz": "وَرَدنَ عُيونَ تَدمُرَ وَالجِبابا"
    },
    {
      "n": 34,
      "sadr": "وَأَمطَرنَ الجِباهَ بِمُرجَحِنٍّ",
      "ajuz": "وَلَكِن بِالطِّعانِ المُرِّ صابا"
    },
    {
      "n": 35,
      "sadr": "وَجُزنَ الصَّحصَحانَ يَخِدنَ وَخداً",
      "ajuz": "وَيَجتَبنَ الفَلاةَ بِنا اِجتِيابا"
    },
    {
      "n": 36,
      "sadr": "قَرَينا بِالسَّماوَةِ مِن عُقَيلٍ",
      "ajuz": "سِباعَ الأَرضِ وَالطَّيرَ السِّغابا"
    },
    {
      "n": 37,
      "sadr": "وَبِالصَّبّاحِ وَالصَّبّاحُ عَبدٌ",
      "ajuz": "قَتَلنا مِن لُبابِهِمُ اللُّبابا"
    },
    {
      "n": 38,
      "sadr": "تَرَكنا في بُيوتِ بَني المُهَنّا",
      "ajuz": "نَوادِبَ يَنتَحِبنَ بِها اِنتِحابا"
    },
    {
      "n": 39,
      "sadr": "تَشَفَّت مِن أَبي بَكرٍ حُقوداً",
      "ajuz": "وَأَبرَزَتِ الضِّبابُ بِهِ ضِبابا"
    },
    {
      "n": 40,
      "sadr": "وَأَبعَدنا لِسوءِ الفِعلِ كَعباً",
      "ajuz": "وَأَدنَينا لِطاعَتِها كِلابا"
    },
    {
      "n": 41,
      "sadr": "وَشَرَّدنا إِلى الجَولانِ طَيِّئاً",
      "ajuz": "وَجَنَّبنا سَماوَتَها جَنابا"
    },
    {
      "n": 42,
      "sadr": "سَحابٌ قَد أَناخَ عَلى عُقَيلٍ",
      "ajuz": "وَجَرَّ عَلى جِوارِهِمُ ذُنابا"
    },
    {
      "n": 43,
      "sadr": "وَسِرنا بِالخُيولِ إِلى نُمَيرٍ",
      "ajuz": "تُجاذِبُنا أَعِنَّتَها جِذابا"
    },
    {
      "n": 44,
      "sadr": "بِكُلِّ مُشَيَّعٍ سَمحٍ بِنَفسٍ",
      "ajuz": "يَعِزُّ عَلى العَشيرَةِ أَن يُصابا"
    },
    {
      "n": 45,
      "sadr": "وَما ضاقَت مَذاهِبُهُ وَلَكِن",
      "ajuz": "يَهابُ مِنَ الحَمِيَّةِ أَن يُهابا"
    },
    {
      "n": 46,
      "sadr": "وَيَأمُرُنا فَنَكفيهِ الأَعادي",
      "ajuz": "هُمامٌ لَو يَشاءُ كَفى وَنابا"
    },
    {
      "n": 47,
      "sadr": "فَلَمّا أَيقَنوا أَن لا غِياثٌ",
      "ajuz": "دَعَوهُ لِلمَغوثَةِ فَاستَجابا"
    },
    {
      "n": 48,
      "sadr": "وَعادَ إِلى الجَميلِ لَهُم فَعادوا",
      "ajuz": "وَقَد مَدّوا لِما يَهوى الرِّقابا"
    },
    {
      "n": 49,
      "sadr": "أَمَرَّ عَلَيهِمُ خَوفاً وَأَمناً",
      "ajuz": "أَذاقَهُمُ بِهِ أَرياً وَصابا"
    },
    {
      "n": 50,
      "sadr": "أَحَلَّهُمُ الجَزيرَةَ بَعدَ يَأسٍ",
      "ajuz": "أَخو حِلمٍ إِذا مَلَكَ العِقابا"
    },
    {
      "n": 51,
      "sadr": "دِيارَهُمُ اِنتَزَعناها اِنتِزاعاً",
      "ajuz": "وَأَرضَهُمُ اِغتَصَبناها اِغتِصابا"
    },
    {
      "n": 52,
      "sadr": "وَلَو شِئنا حَمَيناها البَوادي",
      "ajuz": "كَما تَحمي أُسودُ الغابِ غابا"
    },
    {
      "n": 53,
      "sadr": "إِذا ما أَنفَذَ الأُمَراءُ جَيشاً",
      "ajuz": "إِلى الأَعداءِ أَنفَذنا كِتابا"
    },
    {
      "n": 54,
      "sadr": "أَنا اِبنُ الضّارِبينَ الهامَ قِدماً",
      "ajuz": "إِذا كَرِهَ المُحامونَ الضِّرابا"
    },
    {
      "n": 55,
      "sadr": "أَلَم تَعلَم وَمِثلُكَ قالَ حَقّاً",
      "ajuz": "بِأَنّي كُنتُ أَبعَثُها شِهابا"
    }
  ]
}
