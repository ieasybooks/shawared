{
  "id": "ya-baghiya-al-ihsan",
  "poet": "ibn-qayyim-al-jawziyya",
  "title": "يا باغِيَ الإِحسانِ يَطلُبُ رَبَّهُ",
  "meter": "kamil",
  "rawiy": "ل",
  "abyat_in_full": 130,
  "added": "2026-11-19",
  "abyat": [
    {"n": 1, "sadr": "يا باغِيَ الإِحسانِ يَطلُبُ رَبَّهُ", "ajuz": "لِيَفوزَ مِنهُ بِغايَةِ الآمالِ"},
    {"n": 2, "sadr": "اُنظُر إِلى هَديِ الصَّحابَةِ وَالَّذي", "ajuz": "كانوا عَلَيهِ في الزَّمانِ الخالي"},
    {"n": 3, "sadr": "وَاسلُك طَريقَ القَومِ أَينَ تَيَمَّموا", "ajuz": "خُذ يَمنَةً ما الدَّربُ ذاتَ شِمالِ"},
    {"n": 4, "sadr": "تَاللَّهِ ما اِختاروا لِأَنفُسِهِم سِوى", "ajuz": "سُبُلِ الهُدى في القَولِ وَالأَفعالِ"},
    {"n": 5, "sadr": "دَرَجوا عَلى نَهجِ الرَّسولِ وَهَديِهِ", "ajuz": "وَبِهِ اِقتَدَوا في سائِرِ الأَحوالِ"},
    {"n": 6, "sadr": "نِعمَ الرَّفيقُ لِطالِبٍ يَبغي الهُدى", "ajuz": "فَمَآلُهُ في الحَشرِ خَيرُ مَآلِ"},
    {"n": 7, "sadr": "القانِتينَ المُخبِتينَ لِرَبِّهِم", "ajuz": "النّاطِقينَ بِأَصدَقِ الأَقوالِ"},
    {"n": 8, "sadr": "التّارِكينَ لِكُلِّ فِعلٍ سَيِّئٍ", "ajuz": "وَالعامِلينَ بِأَحسَنِ الأَعمالِ"},
    {"n": 9, "sadr": "أَهواؤُهُم تَبَعٌ لِدينِ نَبِيِّهِم", "ajuz": "وَسِواهُمُ بِالضِّدِّ مِن ذي الحالِ"},
    {"n": 10, "sadr": "ما شابَهُم في دينِهِم نَقصٌ وَلا", "ajuz": "في قَولِهِم شَطحُ الجَهولِ الغالي"},
    {"n": 11, "sadr": "عَمِلوا بِما عَلِموا وَلَم يَتَكَلَّفوا", "ajuz": "فَلِذاكَ ما شابوا الهُدى بِضَلالِ"},
    {"n": 12, "sadr": "وَسِواهُمُ بِالضِّدِّ حَتّى إِنَّهُم", "ajuz": "تَرَكوا الهُدى وَدَعَوا إِلى الإِضلالِ"},
    {"n": 13, "sadr": "فَهُمُ الأَدِلَّةُ لِلحَيارى مَن يَسِر", "ajuz": "بِهُداهُمُ لَم يَخشَ مِن إِضلالِ"},
    {"n": 14, "sadr": "وَهُمُ النُّجومُ هِدايَةً وَإِضاءَةً", "ajuz": "وَعُلُوَّ مَنزِلَةٍ وَبُعدَ مَنالِ"},
    {"n": 15, "sadr": "يَمشونَ بَينَ النّاسِ هَوناً نُطقُهُم", "ajuz": "بِالحَقِّ لا بِجَهالَةِ الجُهّالِ"},
    {"n": 16, "sadr": "حِلماً وَعِلماً مَع تُقىً وَتَواضُعٍ", "ajuz": "وَنَصيحَةٍ مَعَ رُتبَةِ الإِفضالِ"},
    {"n": 17, "sadr": "يُحيونَ لَيلَهُمُ بِطاعَةِ رَبِّهِم", "ajuz": "بِتِلاوَةٍ وَتَضَرُّعٍ وَسُؤالِ"},
    {"n": 18, "sadr": "وَعُيونُهُم تَجري بِفَيضِ دُموعِهِم", "ajuz": "مِثلَ اِنهِمالِ الوابِلِ الهَطّالِ"},
    {"n": 19, "sadr": "في اللَّيلِ رُهبانٌ وَعِندَ جِهادِهِم", "ajuz": "لِعَدُوِّهِم مِن أَشجَعِ الأَبطالِ"},
    {"n": 20, "sadr": "وَإِذا بَدا عَلَمُ الرِّهانِ رَأَيتَهُم", "ajuz": "يَتَسابَقونَ بِصالِحِ الأَعمالِ"},
    {"n": 21, "sadr": "بِوُجوهِهِم أَثَرُ السُّجودِ لِرَبِّهِم", "ajuz": "وَبِها أَشِعَّةُ نورِهِ المُتَلالي"},
    {"n": 22, "sadr": "وَلَقَد أَبانَ لَكَ الكِتابُ صِفاتِهِم", "ajuz": "في سورَةِ الفَتحِ المُبينِ العالي"},
    {"n": 23, "sadr": "وَبِرابِعِ السَّبعِ الطِّوالِ صِفاتُهُم", "ajuz": "قَومٌ يُحِبُّهُمُ ذَوو إِذلالِ"},
    {"n": 24, "sadr": "وَبَراءَةٌ وَالحَشرُ فيها وَصفُهُم", "ajuz": "وَبِهَل أَتى وَبِسورَةِ الأَنفالِ"}
  ]
}
