{
  "id": "laqad-jamaa-al-ahzabu",
  "poet": "khubayb-ibn-adi",
  "title": "لَقَد جَمَّعَ الأَحزابُ حَولي وَأَلَّبوا",
  "meter": "tawil",
  "themes": ["religion", "sabr"],
  "rawiy": "ع",
  "abyat_in_full": 10,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "لَقَد جَمَّعَ الأَحزابُ حَولي وَأَلَّبوا",
      "ajuz": "قَبائِلَهُم وَاستَجمَعوا كُلَّ مَجمَعِ"
    },
    {
      "n": 2,
      "sadr": "وَكُلُّهُمُ مُبدي العَداوَةِ جاهِدٌ",
      "ajuz": "عَلَيَّ لِأَنّي في وَثاقٍ بِمَضيَعِ"
    },
    {
      "n": 3,
      "sadr": "وَقَد جَمَعوا أَبناءَهُم وَنِساءَهُم",
      "ajuz": "وَقُرِّبتُ مِن جِذعٍ طَويلٍ مُمَنَّعِ"
    },
    {
      "n": 4,
      "sadr": "إِلى اللَّهِ أَشكو غُربَتي ثُمَّ كُربَتي",
      "ajuz": "وَما أَرصَدَ الأَحزابُ لي عِندَ مَصرَعي"
    },
    {
      "n": 5,
      "sadr": "فَذا العَرشِ صَبِّرني عَلى ما يُرادُ بي",
      "ajuz": "فَقَد بَضَّعوا لَحمي وَقَد ياسَ مَطمَعي"
    },
    {
      "n": 6,
      "sadr": "وَذَلِكَ في ذاتِ الإِلَهِ وَإِن يَشَأ",
      "ajuz": "يُبارِك عَلى أَوصالِ شِلوٍ مُمَزَّعِ"
    },
    {
      "n": 7,
      "sadr": "وَقَد خَيَّروني الكُفرَ وَالمَوتُ دونَهُ",
      "ajuz": "وَقَد هَمَلَت عَينايَ مِن غَيرِ مَجزَعِ"
    },
    {
      "n": 8,
      "sadr": "وَما بي حِذارُ المَوتِ إِنّي لَمَيِّتٌ",
      "ajuz": "وَلَكِن حِذاري جَحمُ نارٍ مُلَفَّعِ"
    },
    {
      "n": 9,
      "sadr": "فَلَستُ أُبالي حينَ أُقتَلُ مُسلِماً",
      "ajuz": "عَلى أَيِّ جَنبٍ كانَ في اللَّهِ مَصرَعي"
    },
    {
      "n": 10,
      "sadr": "وَلَستُ بِمُبدٍ لِلعَدُوِّ تَخَشُّعاً",
      "ajuz": "وَلا جَزَعاً إِنّي إِلى اللَّهِ مَرجِعي"
    }
  ]
}
