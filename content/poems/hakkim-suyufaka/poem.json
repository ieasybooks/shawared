{
  "id": "hakkim-suyufaka",
  "poet": "antara",
  "title": "حَكِّم سُيوفَكَ في رِقابِ العُذَّلِ",
  "meter": "kamil",
  "rawiy": "ل",
  "abyat_in_full": 22,
  "added": "2026-11-17",
  "abyat": [
    { "n": 1,  "sadr": "حَكِّم سُيوفَكَ في رِقابِ العُذَّلِ", "ajuz": "وَإِذا نَزَلتَ بِدارِ ذُلٍّ فَارحَلِ" },
    { "n": 2,  "sadr": "وَإِذا بُليتَ بِظالِمٍ كُن ظالِماً", "ajuz": "وَإِذا لَقيتَ ذَوي الجَهالَةِ فَاجهَلِ" },
    { "n": 3,  "sadr": "وَإِذا الجَبانُ نَهاكَ يَومَ كَريهَةٍ", "ajuz": "خَوفاً عَلَيكَ مِنَ اِزدِحامِ الجَحفَلِ" },
    { "n": 4,  "sadr": "فَاعصِ مَقالَتَهُ وَلا تَحفِل بِهِ", "ajuz": "وَاقدِم إِذا حَقَّ اللِّقا في الأَوَّلِ" },
    { "n": 5,  "sadr": "وَاختَر لِنَفسِكَ مَنزِلاً تَعلو بِهِ", "ajuz": "أَو مُت كَريماً تَحتَ ظِلِّ القَسطَلِ" },
    { "n": 6,  "sadr": "فَالمَوتُ لا يُنجيكَ مِن آفاتِهِ", "ajuz": "حِصنٌ وَلَو شَيَّدتَهُ بِالجَندَلِ" },
    { "n": 7,  "sadr": "مَوتُ الفَتى في عِزَّةٍ خَيرٌ لَهُ", "ajuz": "مِن أَن يَبيتَ أَسيرَ طَرفٍ أَكحَلِ" },
    { "n": 8,  "sadr": "إِن كُنتُ في عَدَدِ العَبيدِ فَهِمَّتي", "ajuz": "فَوقَ الثُّرَيّا وَالسِّماكِ الأَعزَلِ" },
    { "n": 9,  "sadr": "أَو أَنكَرَت فُرسانُ عَبسٍ نِسبَتي", "ajuz": "فَسِنانُ رُمحي وَالحُسامُ يُقِرُّ لي" },
    { "n": 10, "sadr": "وَبِذابِلي وَمُهَنَّدي نِلتُ العُلا", "ajuz": "لا بِالقَرابَةِ وَالعَديدِ الأَجزَلِ" },
    { "n": 11, "sadr": "وَرَمَيتُ مُهري في العَجاجِ فَخاضَهُ", "ajuz": "وَالنّارُ تَقدَحُ مِن شِفارِ الأَنصُلِ" },
    { "n": 12, "sadr": "خاضَ العَجاجَ مُحَجَّلاً حَتّى إِذا", "ajuz": "شَهِدَ الوَقيعَةَ عادَ غَيرَ مُحَجَّلِ" },
    { "n": 13, "sadr": "وَلَقَد نَكَبتُ بَني حُرَيقَةَ نَكبَةً", "ajuz": "لَمّا طَعَنتُ صَميمَ قَلبِ الأَخيَلِ" },
    { "n": 14, "sadr": "وَقَتَلتُ فارِسَهُم رَبيعَةَ عَنوَةً", "ajuz": "وَالهَيذُبانَ وَجابِرَ اِبنَ مُهَلهَلِ" },
    { "n": 15, "sadr": "وَابنَي رَبيعَةَ وَالحَريشَ وَمالِكٍ", "ajuz": "وَالزِّبرِقانُ غَدا طَريحَ الجَندَلِ" },
    { "n": 16, "sadr": "وَأَنا اِبنُ سَوداءِ الجَبينِ كَأَنَّهُ", "ajuz": "ضَبُعٌ تَرَعرَعَ في رُسومِ المَنزِلِ" },
    { "n": 17, "sadr": "السّاقُ مِنها مِثلُ ساقِ نَعامَةٍ", "ajuz": "وَالشَّعرُ مِنها مِثلُ حَبِّ الفُلفُلِ" },
    { "n": 18, "sadr": "وَالثَّغرُ مِن تَحتِ اللِّثامِ كَأَنَّهُ", "ajuz": "بَرقٌ تَلَألَأَ في الظَّلامِ المُسدَلِ" },
    { "n": 19, "sadr": "يا نازِلينَ عَلى الحِمى وَدِيارِهِ", "ajuz": "هَلّا رَأَيتُم في الدِّيارِ تَقَلقُلي" },
    { "n": 20, "sadr": "قَد طالَ عِزُّكُمُ وَذُلّي في الهَوى", "ajuz": "وَمِنَ العَجائِبِ عِزُّكُم وَتَذَلُّلي" },
    { "n": 21, "sadr": "لا تَسقِني ماءَ الحَياةِ بِذِلَّةٍ", "ajuz": "بَل فَاسقِني بِالعِزِّ كَأسَ الحَنظَلِ" },
    { "n": 22, "sadr": "ماءُ الحَياةِ بِذِلَّةٍ كَجَهَنَّمٍ", "ajuz": "وَجَهَنَّمٌ بِالعِزِّ أَطيَبُ مَنزِلِ" }
  ]
}
