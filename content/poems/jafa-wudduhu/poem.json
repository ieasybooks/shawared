{
  "id": "jafa-wudduhu",
  "poet": "bashshar-ibn-burd",
  "title": "جَفا وُدُّهُ فَازوَرَّ أَو مَلَّ صاحِبُهُ",
  "meter": "tawil",
  "rawiy": "ب",
  "abyat_in_full": 86,
  "added": "2026-11-19",
  "abyat": [
    {"n": 1, "sadr": "جَفا وُدُّهُ فَازوَرَّ أَو مَلَّ صاحِبُهُ", "ajuz": "وَأَزرى بِهِ أَن لا يَزالَ يُعاتِبُهُ"},
    {"n": 2, "sadr": "خَليلَيَّ لا تَستَنكِرا لَوعَةَ الهَوى", "ajuz": "وَلا سَلوَةَ المَحزونِ شَطَّت حَبائِبُهُ"},
    {"n": 3, "sadr": "شَفى النَّفسَ ما يَلقى بِعَبدَةَ عَينُهُ", "ajuz": "وَما كانَ يَلقى قَلبُهُ وَطَبائِبُهُ"},
    {"n": 4, "sadr": "فَأَقصَرَ عِرزامُ الفُؤادِ وَإِنَّما", "ajuz": "يَميلُ بِهِ مَسُّ الهَوى فَيُطالِبُهُ"},
    {"n": 5, "sadr": "إِذا كانَ ذَوّاقاً أَخوكَ مِنَ الهَوى", "ajuz": "مُوَجَّهَةً في كُلِّ أَوبٍ رَكائِبُهُ"},
    {"n": 6, "sadr": "فَخَلِّ لَهُ وَجهَ الفِراقِ وَلا تَكُن", "ajuz": "مَطِيَّةَ رَحّالٍ كَثيرٍ مَذاهِبُهُ"},
    {"n": 7, "sadr": "أَخوكَ الَّذي إِن رِبتَهُ قالَ إِنَّما", "ajuz": "أَرَبتُ وَإِن عاتَبتَهُ لانَ جانِبُهُ"},
    {"n": 8, "sadr": "إِذا كُنتَ في كُلِّ الذُّنوبِ مُعاتِباً", "ajuz": "صَديقَكَ لَم تَلقَ الَّذي لا تُعاتِبُهُ"},
    {"n": 9, "sadr": "فَعِش واحِداً أَو صِل أَخاكَ فَإِنَّهُ", "ajuz": "مُقارِفُ ذَنبٍ مَرَّةً وَمُجانِبُهُ"},
    {"n": 10, "sadr": "إِذا أَنتَ لَم تَشرَب مِراراً عَلى القَذى", "ajuz": "ظَمِئتَ وَأَيُّ النّاسِ تَصفو مَشارِبُهُ"},
    {"n": 11, "sadr": "وَلَيلٍ دَجوجِيٍّ تَنامُ بَناتُهُ", "ajuz": "وَأَبناؤُهُ مِن هَولِهِ وَرَبائِبُهُ"},
    {"n": 12, "sadr": "حَمَيتُ بِهِ عَيني وَعَينَ مَطِيَّتي", "ajuz": "لَذيذَ الكَرى حَتّى تَجَلَّت عَصائِبُهُ"},
    {"n": 13, "sadr": "وَماءٍ تَرى ريشَ الغَطاطِ بِجَوِّهِ", "ajuz": "خَفِيِّ الحَيا ما إِن تَلينُ نَصائِبُهُ"},
    {"n": 14, "sadr": "قَريبٍ مِنَ التَّغريرِ ناءٍ عَنِ القُرى", "ajuz": "سَقاني بِهِ مُستَعمِلُ اللَّيلِ دائِبُهُ"},
    {"n": 15, "sadr": "حَليفُ السُّرى لا يَلتَوي بِمَفازَةٍ", "ajuz": "نَساهُ وَلا تَعتَلُّ مِنها حَوالِبُهُ"},
    {"n": 16, "sadr": "أَمَقُّ غُرَيرِيٌّ كَأَنَّ قُتودَهُ", "ajuz": "عَلى مُثلَثٍ يَدمى مِنَ الحُقبِ حاجِبُهُ"},
    {"n": 17, "sadr": "غَيورٍ عَلى أَصحابِهِ لا يَرومُهُ", "ajuz": "خَليطٌ وَلا يَرجو سِواهُ صَواحِبُهُ"},
    {"n": 18, "sadr": "إِذا ما رَعى سَنَّينِ حاوَلَ مِسحَلاً", "ajuz": "يَجِدُّ بِهِ تَعذامُهُ وَيُلاعِبُهُ"},
    {"n": 19, "sadr": "أَقَبَّ نَفى أَبناءَهُ عَن بَناتِهِ", "ajuz": "بِذي الرَّضمِ حَتّى ما تُحَسُّ ثَوالِبُهُ"},
    {"n": 20, "sadr": "رَعى وَرَعَينَ الرَّطبَ تِسعينَ لَيلَةً", "ajuz": "عَلى أَبَقٍ وَالرَّوضُ تَجري مَذانِبُهُ"},
    {"n": 21, "sadr": "فَلَمّا تَوَلّى الحَرُّ وَاعتَصَرَ الثَّرى", "ajuz": "لَظى الصَّيفِ مِن نَجمٍ تَوَقَّدَ لاهِبُهُ"},
    {"n": 22, "sadr": "وَطارَت عَصافيرُ الشَّقائِقِ وَاكتَسى", "ajuz": "مِنَ الآلِ أَمثالَ المُلاءِ مَسارِبُهُ"},
    {"n": 23, "sadr": "وَصَدَّ عَنِ الشَّولِ القَريعُ وَأَقفَرَت", "ajuz": "ذُرى الصَّمدِ مِمّا اِستَودَعَتهُ مَواهِبُهُ"},
    {"n": 24, "sadr": "وَلاذَ المَها بِالظِّلِّ وَاستَوفَضَ السَّفا", "ajuz": "مِنَ الصَّيفِ نَئّاجٌ تَخُبُّ مَواكِبُهُ"},
    {"n": 25, "sadr": "غَدَت عانَةٌ تَشكو بِأَبصارِها الصَّدى", "ajuz": "إِلى الجَأبِ إِلّا أَنَّها لا تُخاطِبُهُ"},
    {"n": 26, "sadr": "وَظَلَّ عَلى عَلياءَ يَقسِمُ أَمرَهُ", "ajuz": "أَيَمضي لِوِردٍ باكِراً أَم يُواتِبُهُ"},
    {"n": 27, "sadr": "فَلَمّا بَدا وَجهُ الزِّماعِ وَراعَهُ", "ajuz": "مِنَ اللَّيلِ وَجهٌ يَمَّمَ الماءَ قارِبُهُ"},
    {"n": 28, "sadr": "فَباتَ وَقَد أَخفى الظَّلامُ شُخوصَها", "ajuz": "يُناهِبُها أُمَّ الهُدى وَتُناهِبُهُ"},
    {"n": 29, "sadr": "إِذا رَقَصَت في مَهمَهِ اللَّيلِ ضَمَّها", "ajuz": "إِلى نَهَجٍ مِثلُ المَجَرَّةِ لاحِبُهُ"},
    {"n": 30, "sadr": "إِلى أَن أَصابَت في الغَطاطِ شَريعَةً", "ajuz": "مِنَ الماءِ بِالأَهوالِ حُفَّت جَوانِبُهُ"},
    {"n": 31, "sadr": "بِها صَخَبُ المُستَوفِضاتِ عَلى الوَلى", "ajuz": "كَما صَخِبَت في يَومِ قَيظٍ جَنادِبُهُ"},
    {"n": 32, "sadr": "فَأَقبَلَها عُرضَ السَّرِيِّ وَعَينُهُ", "ajuz": "تَرودُ وَفي النّاموسِ مَن هُوَ راقِبُهُ"},
    {"n": 33, "sadr": "أَخو صيغَةٍ زُرقٍ وَصَفراءَ سَمحَةٍ", "ajuz": "يُجاذِبُها مُستَحصِدٌ وَتُجاذِبُهُ"},
    {"n": 34, "sadr": "إِذا رَزَمَت أَنَّت وَأَنَّ لَها الصَّدى", "ajuz": "أَنينَ المَريضِ لِلمَريضِ يُجاوِبُهُ"},
    {"n": 35, "sadr": "كَأَنَّ الغِنى آلى يَميناً غَليظَةً", "ajuz": "عَلَيهِ خَلا ما قَرَّبَت لا يُقارِبُهُ"},
    {"n": 36, "sadr": "يَؤولُ إِلى أُمِّ اِبنَتَينِ يَؤودُهُ", "ajuz": "إِذا ما أَتاها مُخفِقاً أَو تُصاخِبُهُ"},
    {"n": 37, "sadr": "فَلَمّا تَدَلّى في السَّرِيِّ وَغَرَّهُ", "ajuz": "غَليلُ الحَشا مِن قانِصٍ لا يُواثِبُهُ"},
    {"n": 38, "sadr": "رَمى فَأَمَرَّ السَّهمُ يَمسَحُ بَطنَهُ", "ajuz": "وَلَبّاتِهِ فَانصاعَ وَالمَوتُ كارِبُهُ"},
    {"n": 39, "sadr": "وَوافَقَ أَحجاراً رَدَعنَ نَضِيَّهُ", "ajuz": "فَأَصبَحَ مِنها عامِراهُ وَشاخِبُهُ"},
    {"n": 40, "sadr": "يَخافُ المَنايا إِن تَرَحَّلتُ صاحِبي", "ajuz": "كَأَنَّ المَنايا في المَقامِ تُناسِبُهُ"},
    {"n": 41, "sadr": "فَقُلتُ لَهُ إِنَّ العِراقَ مُقامُهُ", "ajuz": "وَخيمٌ إِذا هَبَّت عَلَيكَ جَنائِبُهُ"},
    {"n": 42, "sadr": "لَعَلَّكَ تَستَدني بِسَيرِكَ في الدُّجا", "ajuz": "أَخا ثِقَةٍ تُجدي عَلَيكَ مَناقِبُهُ"},
    {"n": 43, "sadr": "مِنَ الحَيِّ قَيسٍ قَيسِ عَيلانَ إِنَّهُم", "ajuz": "عُيونُ النَّدى مِنهُم تُرَوّى سَحائِبُهُ"},
    {"n": 44, "sadr": "إِذا المُجحِدُ المَحرومُ ضَمَّت حِبالَهُ", "ajuz": "حَبائِلُهُم سيقَت إِلَيهِ رَغائِبُهُ"},
    {"n": 45, "sadr": "وَيَومٍ عَبورِيٍّ طَغا أَو طَغا بِهِ", "ajuz": "لَظاهُ فَما يَروى مِنَ الماءِ شارِبُهُ"},
    {"n": 46, "sadr": "رَفَعتُ بِهِ رَحلي عَلى مُتَخَطرِفٍ", "ajuz": "يَزِفُّ وَقَد أَوفى عَلى الجَذلِ راكِبُهُ"},
    {"n": 47, "sadr": "بِأَغبَرَ رَقّاصِ الشُّخوصِ مَضِلَّةٍ", "ajuz": "مَوارِدُهُ مَجهولَةٌ وَسَباسِبُهُ"},
    {"n": 48, "sadr": "لِأَلقى بَني عَيلانَ إِنَّ فَعالَهُم", "ajuz": "تَزيدُ عَلى كُلِّ الفَعالِ مَراكِبُهُ"},
    {"n": 49, "sadr": "أُلاكَ الأُلى شَقّوا العَمى بِسُيوفِهِم", "ajuz": "عَنِ الغَيِّ حَتّى أَبصَرَ الحَقَّ طالِبُهُ"},
    {"n": 50, "sadr": "إِذا رَكِبوا بِالمَشرَفِيَّةِ وَالقَنا", "ajuz": "وَأَصبَحَ مَروانٌ تُعَدُّ مَواكِبُهُ"},
    {"n": 51, "sadr": "فَأَيُّ اِمرِئٍ عاصٍ وَأَيُّ قَبيلَةٍ", "ajuz": "وَأَرعَنَ لا تَبكي عَلَيهِ قَرائِبُهُ"},
    {"n": 52, "sadr": "رُوَيداً تَصاهَلُ بِالعِراقِ جِيادُنا", "ajuz": "كَأَنَّكَ بِالضَّحّاكِ قَد قامَ نادِبُهُ"},
    {"n": 53, "sadr": "وَسامٍ لِمَروانٍ وَمِن دونِهِ الشَّجا", "ajuz": "وَهَولٌ كَلُجِّ البَحرِ جاشَت غَوارِبُهُ"},
    {"n": 54, "sadr": "أَحَلَّت بِهِ أُمُّ المَنايا بَناتِها", "ajuz": "بِأَسيافِنا إِنّا رَدى مَن نُحارِبُهُ"},
    {"n": 55, "sadr": "وَما زالَ مِنّا مُمسِكٌ بِمَدينَةٍ", "ajuz": "يُراقِبُ أَو ثَغرٍ تُخافُ مَرازِبُهُ"},
    {"n": 56, "sadr": "إِذا المَلِكُ الجَبّارُ صَعَّرَ خَدَّهُ", "ajuz": "مَشَينا إِلَيهِ بِالسُّيوفِ نُعاتِبُهُ"},
    {"n": 57, "sadr": "وَكُنّا إِذا دَبَّ العَدُوُّ لِسُخطِنا", "ajuz": "وَراقَبَنا في ظاهِرٍ لا نُراقِبُهُ"},
    {"n": 58, "sadr": "رَكِبنا لَهُ جَهراً بِكُلِّ مُثَقَّفٍ", "ajuz": "وَأَبيَضَ تَستَسقي الدِّماءَ مَضارِبُهُ"},
    {"n": 59, "sadr": "وَجَيشٍ كَجُنحِ اللَّيلِ يَرجُفُ بِالحَصى", "ajuz": "وَبِالشَّولِ وَالخَطِّيِّ حُمرٍ ثَعالِبُهُ"},
    {"n": 60, "sadr": "غَدَونا لَهُ وَالشَّمسُ في خِدرِ أُمِّها", "ajuz": "تُطالِعُنا وَالطَّلُّ لَم يَجرِ ذائِبُهُ"},
    {"n": 61, "sadr": "بِضَربٍ يَذوقُ المَوتَ مَن ذاقَ طَعمَهُ", "ajuz": "وَتُدرِكُ مَن نَجّى الفِرارُ مَثالِبُهُ"},
    {"n": 62, "sadr": "كَأَنَّ مُثارَ النَّقعِ فَوقَ رُؤوسِهِم", "ajuz": "وَأَسيافَنا لَيلٌ تَهاوى كَواكِبُهُ"},
    {"n": 63, "sadr": "بَعَثنا لَهُم مَوتَ الفُجاءَةِ إِنَّنا", "ajuz": "بَنو المُلكِ خَفّاقٌ عَلَينا سَبائِبُهُ"},
    {"n": 64, "sadr": "فَراحوا فَريقٌ في الإِسارِ وَمِثلُهُ", "ajuz": "قَتيلٌ وَمِثلٌ لاذَ بِالبَحرِ هارِبُهُ"},
    {"n": 65, "sadr": "وَأَرعَنَ يَغشى الشَّمسَ لَونُ حَديدِهِ", "ajuz": "وَتَخلِسُ أَبصارَ الكُماةِ كَتائِبُهُ"},
    {"n": 66, "sadr": "تَغَصُّ بِهِ الأَرضُ الفَضاءُ إِذا غَدا", "ajuz": "تُزاحِمُ أَركانَ الجِبالِ مَناكِبُهُ"},
    {"n": 67, "sadr": "كَأَنَّ جَناباوَيهِ مِن خَمِسِ الوَغى", "ajuz": "شَمامٌ وَسَلمى أَو أَجاً وَكَواكِبُهُ"},
    {"n": 68, "sadr": "تَرَكنا بِهِ كَلباً وَقَحطانَ تَبتَغي", "ajuz": "مُجيراً مِنَ القَتلِ المُطِلِّ مَقانِبُهُ"},
    {"n": 69, "sadr": "أَباحَت دِمَشقاً خَيلُنا حينَ أُلجِمَت", "ajuz": "وَآبَت بِها مَغرورَ حِمصٍ نَوائِبُهُ"},
    {"n": 70, "sadr": "وَنالَت فِلِسطيناً فَعَرَّدَ جَمعُها", "ajuz": "عَنِ العارِضِ المُستَنِّ بِالمَوتِ حاصِبُهُ"},
    {"n": 71, "sadr": "وَقَد نَزَلَت مِنّا بِتَدمُرَ نَوبَةٌ", "ajuz": "كَذاكَ عُروضُ الشَّرِّ تَعرو نَوائِبُهُ"},
    {"n": 72, "sadr": "تَعودُ بِنَفسٍ لا تَزِلُّ عَنِ الهُدى", "ajuz": "كَما زاغَ عَنهُ ثابِتٌ وَأَقارِبُهُ"},
    {"n": 73, "sadr": "دَعا اِبنَ سِماكٍ لِلغَوايَةِ ثابِتٌ", "ajuz": "جِهاراً وَلَم يُرشِد بَنيهِ تَجارِبُهُ"},
    {"n": 74, "sadr": "وَنادى سَعيداً فَاستَصَبَّ مِنَ الشَّقا", "ajuz": "ذَنوباً كَما صُبَّت عَلَيهِ ذَنائِبُهُ"},
    {"n": 75, "sadr": "وَمِن عَجَبٍ سَعيُ اِبنِ أَغنَمَ فيهِمُ", "ajuz": "وَعُثمانَ إِنَّ الدَّهرَ جَمٌّ عَجائِبُهُ"},
    {"n": 76, "sadr": "وَما مِنهُما إِلّا وَطارَ بِشَخصِهِ", "ajuz": "نَجيبٌ وَطارَت لِلكِلابِ رَواجِبُهُ"},
    {"n": 77, "sadr": "أَمَرنا بِهِم صَدرَ النَّهارِ فَصُلِّبوا", "ajuz": "وَأَمسى حَميدٌ يَنحِتُ الجِذعَ صالِبُهُ"},
    {"n": 78, "sadr": "وَباطَ اِبنُ رَوحٍ لِلجَماعَةِ إِنَّهُ", "ajuz": "زَأَرنا إِلَيهِ فَاقشَعَرَّت ذَوائِبُهُ"},
    {"n": 79, "sadr": "وَبِالكوفَةِ الحُبلى جَلَبنا بِخَيلِنا", "ajuz": "عَلَيهِم رَعيلَ المَوتِ إِنّا جَوالِبُهُ"},
    {"n": 80, "sadr": "أَقَمنا عَلى هَذا وَذاكَ نِساءَها", "ajuz": "مَآتِمَ تَدعو لِلبُكا فَتُجاوِبُهُ"},
    {"n": 81, "sadr": "أَيامى وَزَوجاتٍ كَأَنَّ نِهاءَها", "ajuz": "عَلى الحُزنِ أَرآمُ المَلا وَرَبارِبُهُ"},
    {"n": 82, "sadr": "بَكَينَ عَلى مِثلِ السِّنانِ أَصابَهُ", "ajuz": "حِمامٌ بِأَيدينا فَهُنَّ نَوادِبُهُ"},
    {"n": 83, "sadr": "فَلَمّا اِشتَفَينا بِالخَليفَةِ مِنهُمو", "ajuz": "وَصالَ بِنا حَتّى تَقَضَّت مَآرِبُهُ"},
    {"n": 84, "sadr": "دَلَفنا إِلى الضَّحّاكِ نَصرِفُ بِالرَّدى", "ajuz": "وَمَروانُ تَدمى مِن جُذامَ مَخالِبُهُ"},
    {"n": 85, "sadr": "مُعِدّينَ ضِرغاماً وَأَسوَدَ سالِخاً", "ajuz": "حُتوفاً لِمَن دَبَّت إِلَينا عَقارِبُهُ"},
    {"n": 86, "sadr": "وَما أَصبَحَ الضَّحّاكُ إِلّا كَثابِتٍ", "ajuz": "عَصانا فَأَرسَلنا المَنِيَّةَ تَأدِبُهُ"}
  ]
