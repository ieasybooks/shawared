{
  "id": "fi-al-shaybi-zajrun",
  "poet": "al-buhturi",
  "title": "في الشَّيبِ زَجرٌ لَهُ لَو كانَ يَنزَجِرُ",
  "meter": "basit",
  "themes": ["madh", "karam"],
  "rawiy": "ر",
  "abyat_in_full": 41,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "في الشَّيبِ زَجرٌ لَهُ لَو كانَ يَنزَجِرُ",
      "ajuz": "وَواعِظٌ مِنهُ لَولا أَنَّهُ حَجَرُ"
    },
    {
      "n": 2,
      "sadr": "اِبيَضَّ ما اِسوَدَّ مِن فَودَيهِ وَاِرتَجَعَت",
      "ajuz": "جَلِيَّةُ الصُّبحِ ما قَد أَغفَلَ السَّحَرُ"
    },
    {
      "n": 3,
      "sadr": "وَلِلفَتى مُهلَةٌ في الحُبِّ واسِعَةٌ",
      "ajuz": "ما لَم يَمُت في نَواحي رَأسِهِ الشَّعرُ"
    },
    {
      "n": 4,
      "sadr": "قالَت مَشيبٌ وَعِشقٌ رُحتَ بَينَهُما",
      "ajuz": "وَذاكَ في ذاكَ ذَنبٌ لَيسَ يُغتَفَرُ"
    },
    {
      "n": 5,
      "sadr": "وَعَيَّرَتني سِجالَ العُدمِ جاهِلَةً",
      "ajuz": "وَالنَّبعُ عُريانُ ما في فَرعِهِ ثَمَرُ"
    },
    {
      "n": 6,
      "sadr": "وَما الفَقيرُ الَّذي عَيَّرتِ آوِنَةً",
      "ajuz": "بَلِ الزَّمانُ إِلى الأَحرارِ مُفتَقِرُ"
    },
    {
      "n": 7,
      "sadr": "عَزّى عَنِ الحَظِّ أَنَّ العَجزَ يُدرِكُهُ",
      "ajuz": "وَهَوَّنَ العُسرَ عِلمي في مَنِ اليُسُرُ"
    },
    {
      "n": 8,
      "sadr": "لَم يَبقَ مِن جُلِّ هَذا النّاسِ باقِيَةٌ",
      "ajuz": "يَنالُها الوَهمُ إِلّا هَذِهِ الصُّوَرُ"
    },
    {
      "n": 9,
      "sadr": "بُخلٌ وَجَهلٌ وَحَسبُ المَرءِ واحِدَةٌ",
      "ajuz": "مِن تينِ حَتّى يُعَفّى خَلفَهُ الأَثَرُ"
    },
    {
      "n": 10,
      "sadr": "إِذا مَحاسِنِيَ الَّتي أُدِلُّ بِها",
      "ajuz": "كانَت ذُنوبي فَقُل لي كَيفَ أَعتَذِرُ"
    },
    {
      "n": 11,
      "sadr": "أَهُزُّ بِالشِّعرِ أَقواماً ذَوي وَسَنٍ",
      "ajuz": "في الجَهلِ لَو ضُرِبوا بِالسَّيفِ ما شَعَروا"
    },
    {
      "n": 12,
      "sadr": "عَلَيَّ نَحتُ القَوافي مِن مَقاطِعِها",
      "ajuz": "وَما عَلَيَّ إِذا لَم تَفهَمِ البَقَرُ"
    },
    {
      "n": 13,
      "sadr": "لَأَرحَلَنَّ وَآمالي مُطَرَّحَةٌ",
      "ajuz": "بِسُرَّ مَن رَأى مُستَبطَأٌ لَها القَدَرُ"
    },
    {
      "n": 14,
      "sadr": "أَبَعدَ عِشرينَ شَهراً لا جَداً فَيُرى",
      "ajuz": "بِهِ اِنصِرافٌ وَلا وَعدٌ فَيُنتَظَرُ"
    },
    {
      "n": 15,
      "sadr": "لَولا عَلِيُّ بنُ مُرٍّ لَاستَمَرَّ بِنا",
      "ajuz": "خِلفٌ مِنَ العَيشِ فيهِ الصّابُ وَالصَّبِرُ"
    },
    {
      "n": 16,
      "sadr": "عُذنا بِأَروَعَ أَقصى نَيلِهِ كَثَبٌ",
      "ajuz": "عَلى العُفاةِ وَأَدنى سَعيِهِ سَفَرُ"
    },
    {
      "n": 17,
      "sadr": "أَلَحَّ جوداً وَلَم تَضرُر سَحائِبُهُ",
      "ajuz": "وَرُبَّما ضَرَّ في إِلحاحِهِ المَطَرُ"
    },
    {
      "n": 18,
      "sadr": "لا يُتعِبُ النّائِلُ المَبذولُ هِمَّتَهُ",
      "ajuz": "وَكَيفَ يُتعِبُ عَينَ النّاظِرِ النَّظَرُ"
    },
    {
      "n": 19,
      "sadr": "بَدَت عَلى البَدوِ نُعمى مِنهُ سابِغَةٌ",
      "ajuz": "وَفراءُ يَحضُرُ أُخرى مِثلَها الحَضَرُ"
    },
    {
      "n": 20,
      "sadr": "مَواهِبٌ ما تَجَشَّمنا السُّؤالَ لَها",
      "ajuz": "إِنَّ الغَمامَ قَليبٌ لَيسَ يُحتَفَرُ"
    },
    {
      "n": 21,
      "sadr": "يُهابُ فينا وَما في لَحظِهِ شَرَرٌ",
      "ajuz": "وَسطَ النَّدِيِّ وَلا في خَدِّهِ صَعَرُ"
    },
    {
      "n": 22,
      "sadr": "بَردُ الحَشا وَهَجيرُ الرَّوعِ مُحتَفِلٌ",
      "ajuz": "وَمِسعَرٌ وَشِهابُ الحَربِ مُستَعِرُ"
    },
    {
      "n": 23,
      "sadr": "إِذا اِرتَقى في أَعالي الرَّأيِ لاحَ لَهُ",
      "ajuz": "ما في الغُيوبِ الَّتي تَخفى فَتَستَتِرُ"
    },
    {
      "n": 24,
      "sadr": "تَوَسَّطَ الدَّهرَ أَحوالاً فَلا صِغَرٌ",
      "ajuz": "عَنِ الخُطوبِ الَّتي تَعرو وَلا كِبَرُ"
    },
    {
      "n": 25,
      "sadr": "كَالرُّمحِ أَذرُعُهُ عَشرٌ وَواحِدَةٌ",
      "ajuz": "فَلَيسَ يُزرى بِهِ طولٌ وَلا قِصَرُ"
    },
    {
      "n": 26,
      "sadr": "مُجَرَّبٌ طالَما أَشجَت عَزائِمُهُ",
      "ajuz": "ذَوي الحِجى وَهُوَ غِرٌّ بَينَهُم غُمُرُ"
    },
    {
      "n": 27,
      "sadr": "آراؤُهُ اليَومَ أَسيافٌ مُهَنَّدَةٌ",
      "ajuz": "وَكانَ كَالسَّيفِ إِذ آراؤُهُ زُبَرُ"
    },
    {
      "n": 28,
      "sadr": "وَمُصعِدٌ في هِضابِ المَجدِ يَطلَعُها",
      "ajuz": "كَأَنَّهُ لِسِكونِ الجَأشِ مُنحَدِرُ"
    },
    {
      "n": 29,
      "sadr": "ما زالَ يَسبِقُ حَتّى قالَ حاسِدُهُ",
      "ajuz": "لَهُ طَريقٌ إِلى العَلياءِ مُختَصَرُ"
    },
    {
      "n": 30,
      "sadr": "حُلوٌ حَميتٌ مَتى تَجنِ الرَّضا خُلُقاً",
      "ajuz": "مِنهُ وَمُرٌّ إِذا أَحفَظتَهُ مَقِرُ"
    },
    {
      "n": 31,
      "sadr": "نَهَيتُ حُسّادَهُ عَنهُ وَقُلتُ لَهُم",
      "ajuz": "السَّيلُ بِاللَّيلِ لا يُبقي وَلا يَذَرُ"
    },
    {
      "n": 32,
      "sadr": "كُفّوا وَإِلّا كُفِفتُم مُضمِري أَسَفٍ",
      "ajuz": "إِذا تَنَمَّرَ في إِقدامِهِ النَّمِرُ"
    },
    {
      "n": 33,
      "sadr": "أَلوى إِذا شابَكَ الأَعداءَ كَدَّهُمُ",
      "ajuz": "حَتّى يَروحُ وَفي أَظفارِهِ الظَّفَرُ"
    },
    {
      "n": 34,
      "sadr": "وَاللُّؤمُ أَن تَدخُلوا في حَدِّ سَخطَتِهِ",
      "ajuz": "عِلماً بِأَن سَوفَ يَعفو حينَ يَقتَدِرُ"
    },
    {
      "n": 35,
      "sadr": "جافي المَضاجِعِ لا يَنفَكُّ في لَجَبٍ",
      "ajuz": "يَكادُ يُقمِرُ مِن لَألائِهِ القَمَرُ"
    },
    {
      "n": 36,
      "sadr": "إِذا خُطامَةُ سارَت فيهِ آخِذَةٌ",
      "ajuz": "خِطامَ نَبهانَ وَهيَ الشَّوكُ وَالشَّجَرُ"
    },
    {
      "n": 37,
      "sadr": "رَأَيتَ مَجداً عِياناً في بَني أُدَدٍ",
      "ajuz": "إِذ مَجدُ كُلِّ قَبيلٍ دونَهُم خَبَرُ"
    },
    {
      "n": 38,
      "sadr": "أَحسِن أَبا حَسَنٍ بِالشِّعرِ إِذ جَعَلَت",
      "ajuz": "عَلَيكَ أَنجُمُهُ بِالمَدحِ تَنتَثِرُ"
    },
    {
      "n": 39,
      "sadr": "فَقَد أَتَتكَ القَوافي غِبَّ فائِدَةٍ",
      "ajuz": "كَما تَفَتَّحُ غِبَّ الوابِلِ الزَّهَرُ"
    },
    {
      "n": 40,
      "sadr": "فيها العَقائِقُ وَالعِقيانُ إِن لُبِسَت",
      "ajuz": "يَومَ التَّباهي وَفيها الوَشيُ وَالحِبَرُ"
    },
    {
      "n": 41,
      "sadr": "وَمَن يَكُن فاخِراً بِالشِّعرِ يُمدَحُ في",
      "ajuz": "أَضعافِهِ فَبِكَ الأَشعارُ تَفتَخِرُ"
    }
  ]
}
