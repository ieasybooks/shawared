{
  "id": "wa-kam-sahibin",
  "poet": "al-sharif-al-radi",
  "title": "وَكَم صاحِبٍ كَالرُّمحِ زاغَت كُعوبُهُ",
  "meter": "tawil",
  "rawiy": "م",
  "abyat_in_full": 14,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "وَكَم صاحِبٍ كَالرُّمحِ زاغَت كُعوبُهُ",
      "ajuz": "أَبى بَعدَ طولِ الغَمزِ أَن يَتَقَوَّما"
    },
    {
      "n": 2,
      "sadr": "تَقَبَّلتُ مِنهُ ظاهِراً مُتَبَلِّجاً",
      "ajuz": "وَأَدمَجَ دوني باطِناً مُتَجَهِّما"
    },
    {
      "n": 3,
      "sadr": "فَأَبدى كَرَوضِ الحَزنِ رَقَّت فُروعُهُ",
      "ajuz": "وَأَضمَرَ كَاللَّيلِ الخُدارِيِّ مُظلِما"
    },
    {
      "n": 4,
      "sadr": "وَلَو أَنَّني كَشَّفتُهُ عَن ضَميرِهِ",
      "ajuz": "أَقَمتُ عَلى ما بَينَنا اليَومَ مَأتَما"
    },
    {
      "n": 5,
      "sadr": "فَلا باسِطاً بِالسّوءِ إِن ساءَني يَداً",
      "ajuz": "وَلا فاغِراً بِالذَّمِّ إِن رابَني فَما"
    },
    {
      "n": 6,
      "sadr": "كَعُضوٍ رَمَت فيهِ اللَّيالي بِفادِحٍ",
      "ajuz": "وَمَن حَمَلَ العُضوَ الأَليمَ تَأَلَّما"
    },
    {
      "n": 7,
      "sadr": "إِذا أَمَرَ الطِّبُّ اللَّبيبُ بِقَطعِهِ",
      "ajuz": "أَقولُ عَسى ضَنّاً بِهِ وَلَعَلَّما"
    },
    {
      "n": 8,
      "sadr": "صَبَرتُ عَلى إيلامِهِ خَوفَ نَقصِهِ",
      "ajuz": "وَمَن لامَ مَن لا يَرعَوي كانَ أَلوَما"
    },
    {
      "n": 9,
      "sadr": "هِيَ الكَفُّ مَضٌّ تَركُها بَعدَ دائِها",
      "ajuz": "وَإِن قُطِعَت شانَت ذِراعاً وَمِعصَما"
    },
    {
      "n": 10,
      "sadr": "أَراكَ عَلى قَلبي وَإِن كُنتَ عاصِياً",
      "ajuz": "أَعَزَّ مِنَ القَلبِ المُطيعِ وَأَكرَما"
    },
    {
      "n": 11,
      "sadr": "حَمَلتُكَ حَملَ العَينِ لَجَّ بِها القَذى",
      "ajuz": "وَلا تَنجَلي يَوماً وَلا تَبلُغُ العَمى"
    },
    {
      "n": 12,
      "sadr": "دَعِ المَرءَ مَطوِيّاً عَلى ما ذَمَمتَهُ",
      "ajuz": "وَلا تَنشُرِ الدّاءَ العُضالَ فَتَندَما"
    },
    {
      "n": 13,
      "sadr": "إِذا العُضوُ لَم يُؤلِمكَ إِلّا قَطَعتَهُ",
      "ajuz": "عَلى مَضَضٍ لَم تُبقِ لَحماً وَلا دَما"
    },
    {
      "n": 14,
      "sadr": "وَمَن لَم يُوَطِّن لِلصَّغيرِ مِنَ الأَذى",
      "ajuz": "تَعَرَّضَ أَن يَلقى أَجَلَّ وَأَعظَما"
    }
  ]
}
