{
  "id": "taallam-anna-khayra",
  "poet": "qays-ibn-zuhayr",
  "title": "تَعَلَّم أَنَّ خَيرَ النّاسِ مَيتٌ",
  "meter": "wafir",
  "themes": ["ritha", "hikma"],
  "rawiy": "م",
  "abyat_in_full": 9,
  "added": "2026-11-24",
  "abyat": [
    {
      "n": 1,
      "sadr": "تَعَلَّم أَنَّ خَيرَ النّاسِ مَيتٌ",
      "ajuz": "عَلى جَفرِ الهَباءَةِ ما يَريمُ"
    },
    {
      "n": 2,
      "sadr": "وَلَولا ظُلمُهُ ما زِلتُ أَبكي",
      "ajuz": "عَلَيهِ الدَّهرَ ما طَلَعَ النُّجومُ"
    },
    {
      "n": 3,
      "sadr": "وَلَكِنَّ الفَتى حَمَلَ اِبنَ بَدرٍ",
      "ajuz": "بَغى وَالبَغيُ مَرتَعُهُ وَخيمُ"
    },
    {
      "n": 4,
      "sadr": "أَظُنُّ الحِلمَ دَلَّ عَلَيَّ قَومي",
      "ajuz": "وَقَد يُستَجهَلُ الرَّجُلُ الحَليمُ"
    },
    {
      "n": 5,
      "sadr": "فَلا تَغشَ المَظالِمَ أَن تَراهُ",
      "ajuz": "يُمَتَّعُ بِالغِنى الرَّجُلُ الظَّلومُ"
    },
    {
      "n": 6,
      "sadr": "وَلا تَعجَل بِأَمرِكَ وَاستَدِمهُ",
      "ajuz": "فَما صَلّى عَصاكَ كَمُستَديمِ"
    },
    {
      "n": 7,
      "sadr": "أُلاقي مِن رِجالٍ مُنكَراتٍ",
      "ajuz": "فَأُنكِرُها وَما أَنا بِالغَشومِ"
    },
    {
      "n": 8,
      "sadr": "وَلا يُعييكَ عُرقوبٌ لِلَأيٍ",
      "ajuz": "إِذا لَم يُعطِكَ النَّصَفَ الخَصيمُ"
    },
    {
      "n": 9,
      "sadr": "وَمارَستُ الرِّجالَ وَمارَسوني",
      "ajuz": "فَمُعوَجٌّ عَلَيَّ وَمُستَقيمُ"
    }
  ]
}
