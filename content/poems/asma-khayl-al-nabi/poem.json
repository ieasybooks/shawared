{
  "id": "asma-khayl-al-nabi",
  "poet": "muhammad-abu-raqaba",
  "title": "أَسماءُ خَيلِ النَّبِيِّ",
  "meter": "rajaz",
  "themes": ["didactic", "religion"],
  "abyat_in_full": 10,
  "added": "2026-11-19",
  "abyat": [
    {"n": 1, "sadr": "أَسماءُ خَيلِ المُصطَفى كَما تَرى", "ajuz": "وَبَعضُها فيهِ الخِلافُ قَد جَرى"},
    {"n": 2, "sadr": "أَوَّلُها السَّكبُ وَقَد غَزا بِهِ", "ajuz": "في أُحُدٍ كَالماءِ عِندَ صَبِّهِ"},
    {"n": 3, "sadr": "وَالثّاني أَبيَضُ لَهُ صَهيلُ", "ajuz": "مُرتَجِزٌ شاهِدُهُ جَليلُ"},
    {"n": 4, "sadr": "أَعني بِهِ خُزَيمَةَ بنَ ثابِتِ", "ajuz": "شاهِدَ بَيعِهِ الصَّحيحِ الثّابِتِ"},
    {"n": 5, "sadr": "ثُمَّ اللَّحيفُ وَزنُهُ فَعيلُ", "ajuz": "كانَ لَهُ ذَيلٌ يُرى طَويلُ"},
    {"n": 6, "sadr": "وَمِن جُهَينَةَ اِشتَراهُ أَشقَرا", "ajuz": "سُمِّيَ سَبحَةً فَنِعمَ المُشتَرى"},
    {"n": 7, "sadr": "وَأَكثَرُ الغَزوِ عَلى اللِّزازِ", "ajuz": "وَبَشِّرِ المُؤمِنَ بِالمَفازِ"},
    {"n": 8, "sadr": "وَبَعدَ هَذا الظَّرِبُ الكَريمُ", "ajuz": "وَفي المُرَيسيعِ لَهُ التَّقديمُ"},
    {"n": 9, "sadr": "وَالسّابِعُ الوَردُ الَّذي أَهداهُ", "ajuz": "تَميمٌ الدّارِيُّ وَانتَقاهُ"},
    {"n": 10, "sadr": "وَهَذِهِ السَّبعَةُ بِاتِّفاقِ", "ajuz": "وَغَيرُها تُروى بِلا وِفاقِ"}
  ]
}
